    @page "/Testreport-editor"

@inject IHttpClientFactory HttpClientFactory
@inject ReportDataService ReportService
@using System.Text
@using System.Text.Json
@using DevExpress.Blazor
@using DevExpress.Blazor.Reporting
@using FreightBKShippingWebApp.Components.Pages
@using FreightBKShippingWebApp.Model
@using FreightBKShippingWebApp.Models
@using FreightBKShippingWebApp.ReportDesignServices
@using FreightBKShippingWebApp.Services
@using FreightBKShippingWebApp.ReportDesign
@inject NavigationManager NavigationManager
@inject LoadingService LoadingService
@inject DataStateService DataStateService
@inject ReportContextService ReportContext
@inject ConfirmationDialogService ConfirmDialogService
@inject ToasteService ToastService
<br />
<div class="report-designer-container">
    <!-- Header Section -->
    <div class="header-section">
        <div class="header-content">
            <div class="header-left">
                <i class="bi bi-file-earmark-text-fill header-icon"></i>
                <div>
                    <h4 class="header-title">Report Designer</h4>
                    <p class="header-subtitle">Create and customize your reports</p>
                </div>
            </div>
            <div class="header-right">
                <DxButton Click="@RedirectToDesigner" 
                          RenderStyle="ButtonRenderStyle.Secondary"
                          IconCssClass="bi bi-box-arrow-up-right"
                          CssClass="btn-header">
                    Full Screen
                </DxButton>
            </div>
        </div>
    </div>

    <!-- Main Content Card -->
    <div class="content-card">
        <!-- Format Selection Section -->
        <div class="section-block">
            <div class="section-header">
                <i class="bi bi-grid-3x3-gap-fill section-icon"></i>
                <h5 class="section-title">Report Configuration</h5>
            </div>
            
            <DxFormLayout Data="reportData1" CssClass="modern-form">
                <DxFormLayoutGroup ColSpanMd="12">
                    <!-- Format Selector -->
                    <DxFormLayoutItem Caption="Select Format" ColSpanMd="12" CssClass="form-item-featured">
                        <Template>
                            <label class="form-label-modern">
                                <i class="bi bi-layout-text-window-reverse"></i> Select Format
                            </label>
                            <DxComboBox TData="ReportData" 
                                        TValue="string"
                                        Data="@reportDataList"
                                        Value="@reportData1.FormatName"
                                        ValueFieldName="FormatName"
                                        TextFieldName="FormatName"
                                        ValueChanged="@OnFormatChanged"
                                        CssClass="modern-combo"
                                        NullText="Choose a report format...">
                                <ItemTemplate Context="item">
                                    <div class="combo-item">
                                        <i class="bi bi-file-earmark"></i>
                                        <span>@item.FormatName</span>
                                    </div>
                                </ItemTemplate>
                            </DxComboBox>
                        </Template>
                    </DxFormLayoutItem>
                </DxFormLayoutGroup>

                <!-- Two Column Layout for Details -->
                <DxFormLayoutGroup ColSpanMd="6">
                    <DxFormLayoutItem Caption="Format Name" ColSpanMd="12">
                        <Template>
                            <label class="form-label-modern">
                                <i class="bi bi-tag"></i> Format Name
                            </label>
                            <DxTextBox Text="@reportData1.FormatName"
                                       TextChanged="@(val => OnFieldChanged(nameof(reportData1.FormatName), val))"
                                       CssClass="modern-input" />
                        </Template>
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="Document Type" ColSpanMd="12">
                        <Template>
                            <label class="form-label-modern">
                                <i class="bi bi-file-text"></i> Document Type
                            </label>
                            <DxTextBox Text="@reportData1.DocType"
                                       TextChanged="@(val => OnFieldChanged(nameof(reportData1.DocType), val))"
                                       CssClass="modern-input" />
                        </Template>
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="Copy Format" ColSpanMd="12">
                        <Template>
                            <label class="form-label-modern">
                                <i class="bi bi-files"></i> Copy Format
                            </label>
                            <DxTextBox Text="@reportData1.CopyFormat"
                                       TextChanged="@(val => OnFieldChanged(nameof(reportData1.CopyFormat), val))"
                                       CssClass="modern-input" />
                        </Template>
                    </DxFormLayoutItem>
                </DxFormLayoutGroup>

                <DxFormLayoutGroup ColSpanMd="6">
                    <DxFormLayoutItem Caption="Next Format" ColSpanMd="12">
                        <Template>
                            <label class="form-label-modern">
                                <i class="bi bi-arrow-right-circle"></i> Next Format
                            </label>
                            <DxTextBox Text="@reportData1.NextFormat"
                                       TextChanged="@(val => OnFieldChanged(nameof(reportData1.NextFormat), val))"
                                       CssClass="modern-input" />
                        </Template>
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="Voucher ID" ColSpanMd="12">
                        <Template>
                            <label class="form-label-modern">
                                <i class="bi bi-hash"></i> Voucher ID
                            </label>
                            <DxSpinEdit Value="@reportData1.VchId"
                                        ValueChanged="@((int? val) => OnFieldChanged(nameof(reportData1.VchId), val))"
                                        CssClass="modern-input" />
                        </Template>
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="Company ID" ColSpanMd="12">
                        <Template>
                            <label class="form-label-modern">
                                <i class="bi bi-building"></i> Company ID
                            </label>
                            <DxSpinEdit Value="@reportData1.CompanyId"
                                        ValueChanged="@((int? val) => OnFieldChanged(nameof(reportData1.CompanyId), val))"
                                        CssClass="modern-input" />
                        </Template>
                    </DxFormLayoutItem>
                </DxFormLayoutGroup>
            </DxFormLayout>
        </div>

        <!-- Action Buttons Section -->
        <div class="action-section">
            <div class="action-group">
                <DxButton Click="@ClearForm" 
                          RenderStyle="ButtonRenderStyle.Secondary"
                          IconCssClass="bi bi-eraser"
                          CssClass="btn-action btn-clear">
                    <DxHint Text="Clear all form fields and close report designer" />
                    Clear Form
                </DxButton>

                <DxButton Click="@LoadExistingReport"
                          RenderStyle="ButtonRenderStyle.Info"
                          IconCssClass="bi bi-folder-open"
                          CssClass="btn-action btn-load">
                    <DxHint Text="Load an existing report" />
                    Load Existing
                </DxButton>

                <DxButton Click="@OpenNewReport" 
                          Enabled="IsNewReportEnabled"
                          RenderStyle="ButtonRenderStyle.Success"
                          IconCssClass="bi bi-plus-circle"
                          CssClass="btn-action btn-new">
                    <DxHint Text="Create new report when ready" />
                    Create New Report
                </DxButton>
            </div>
        </div>
    </div>

    <!-- Designer Section -->
    @if (ShowDesigner)
    {
        <div class="designer-card">
            <div class="designer-header">
                <div class="designer-header-left">
                    <i class="bi bi-palette-fill"></i>
                    <span>Design Canvas</span>
                </div>
                <div class="designer-header-right">
                    <span class="status-badge">
                        <i class="bi bi-circle-fill status-active"></i> Active
                    </span>
                </div>
            </div>
            <div class="designer-wrapper">
                <DxReportDesigner ReportName="@ReportUrl" Width="100%" Height="100%" />
            </div>
        </div>
    }
</div>

