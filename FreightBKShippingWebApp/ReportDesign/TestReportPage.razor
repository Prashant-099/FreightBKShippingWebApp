    //     BuildReportUrl();
    //         ShowDesigner = true;

    //         StateHasChanged();
    // }

        void OnInputChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e) => StateHasChanged();

        void BuildReportUrl()
        {
        var json = JsonSerializer.Serialize(reportData1);
        ReportUrl = Convert.ToBase64String(Encoding.UTF8.GetBytes(json));
        // ✅ Send only ID as string to DxReportDesigner
        // ReportUrl = reportData1.ReportDataId.ToString();
        }

          private bool IsNewReportEnabled =>
                // !string.IsNullOrWhiteSpace(reportData1.ReportDataFormatName) &&
                !string.IsNullOrWhiteSpace(reportData1.CopyFormat) &&
                !string.IsNullOrWhiteSpace(reportData1.NextFormat) &&
                !string.IsNullOrWhiteSpace(reportData1.DocType) &&
                reportData1.VchId > 0;

        Task ShowMessage(string msg)
        {
            Console.WriteLine(msg); // replace with toast/modal
            return Task.CompletedTask;
        }
}
