@code {
    private string SelectedCopyFormat = "";
    private bool IsCopyMode = false;

    private List<string> doctype = new() { "bill", "Job", "Quotation", "ReceiptPayment", "Journal", "Contra", "LR", "Transport Invoice", "ENVELOPE", "SALARY" };

    async Task CopyExistingReport()
    {
        try
        {
            if (reportData1.ReportDataId <= 0)
            {
                ToastService.Warning("Select Formate first.");
                return;
            }

            if (string.IsNullOrWhiteSpace(reportData1.NextFormat))
            {
                ToastService.Warning("Enter new Formate Name.");
                return;
            }

            LoadingService.Show();

            var newId = await ReportService.CopyReportAsync(
     reportData1.ReportDataId,
            reportData1.NextFormat
       );
            ToastService.Success("Report copied successfully.");
            NavigationManager.NavigateTo($"/report-designer/{newId}", true);
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            ToastService.Error("Copy failed.");
        }
        finally
        {
            LoadingService.Hide();
        }
    }
    async Task DeleteReport()
    {
        try
        {
            if (reportData1.ReportDataId <= 0)
            {
                ToastService.Warning("Select Formate first.");
                return;
            }

            var confirm = await ConfirmDialogService.ShowAsync(
        $"Are you sure you want to delete {reportData1.FormatName}?");
            if (!confirm)
                return;

            LoadingService.Show();

            var success = await ReportService.DeleteAsync(reportData1.ReportDataId);

            if (success)
            {
                ToastService.Success("Report deleted successfully.");

                // remove from local lists
                reportDataList.RemoveAll(x => x.ReportDataId == reportData1.ReportDataId);
                FilteredReportDatalist.RemoveAll(x => x.ReportDataId == reportData1.ReportDataId);

                await ClearForm();

                StateHasChanged();
            }
            else
            {
                ToastService.Error("Delete failed.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            ToastService.Error("Error deleting report.");
        }
        finally
        {
            LoadingService.Hide();
        }
    }
    void OnFieldChanged(int? val)
    {
        reportData1.VchId = val;
        BuildReportUrl();
    }


    private ReportData reportData1 = new ReportData();
    private List<ReportData> reportDataList { get; set; }
    private List<ReportData> FilteredReportDatalist = new();
    private string ReportUrl = "";
    private bool ShowDesigner = false;

    private HttpClient HttpClient => HttpClientFactory.CreateClient();

    protected override async Task OnInitializedAsync()
    {
        // Register the component's InvokeAsync so LoadingService can marshal to the UI thread
        LoadingService.SetInvoker(InvokeAsync);

        DataStateService.OnChange += RefreshReportpage;
        await RefreshReportpage();
        FilteredReportDatalist = new();
    }

    private async Task RefreshReportpage()
    {
        LoadingService.Show();
        reportDataList = await ReportService.GetAllAsync();
        await ClearForm();
        LoadingService.Hide();
    }
    async Task OnDocTypeChanged(string value)
    {
        reportData1.DocType = value;

        // Clear selected format
        reportData1.FormatName = null;

        // Filter reports
        FilteredReportDatalist = reportDataList
            .Where(x => x.DocType != null &&
                        x.DocType.Equals(value, StringComparison.OrdinalIgnoreCase))
            .ToList();

        await InvokeAsync(StateHasChanged);
    }
    void RedirectToDesigner()
    {

        if (reportData1.ReportDataId > 0)
        {
            LoadingService.Show();
            ReportContext.CurrentReportData = reportData1;
            var url = $"/report-designer/{reportData1.ReportDataId}";
            NavigationManager.NavigateTo(url);
            LoadingService.Hide();
        }
    }

    void OpenNewReport()
    {
        if (string.IsNullOrWhiteSpace(reportData1.DocType))
        {
            ToastService.Warning("Please Select the Document Type.");
            return;
        }

        if (string.IsNullOrWhiteSpace(reportData1.NextFormat))
        {
            ToastService.Warning("Enter new Formate Name.");
            return;
        }
        LoadingService.Show();
        // Naya object banao aur form data copy karo
        var newReport = new ReportData
        {
            ReportDataId = 0, // New hai, so ID = 0
            FormatName = reportData1.NextFormat ?? $"NewReport_{DateTime.Now:yyyyMMdd_HHmmss}",
            DocType = reportData1.DocType,
            CopyFormat = reportData1.CopyFormat,
            NextFormat = "",
            VchId = reportData1.VchId,
            CompanyId = reportData1.CompanyId,
            Status = 1,
            LayoutData = "" // Blank XML for new report
        };

        // Context me daal do
        ReportContext.CurrentReportData = newReport;

        // Designer ko bhejne ke liye Base64 JSON banao
        var json = JsonSerializer.Serialize(newReport);
        var base64 = Convert.ToBase64String(Encoding.UTF8.GetBytes(json));

        ReportUrl = base64;
        ShowDesigner = true;
         LoadingService.Hide();
    }

    async Task ClearForm()
    {
        reportData1 = new ReportData(); // Reset all form fields
        ReportUrl = ""; // Clear the report URL
        ShowDesigner = false; // Set this to control the visibility of your Report Designer
    }

    async Task LoadExistingReport()
    {
        if (reportData1.ReportDataId <= 0)  
        {
            ToastService.Warning("Please select a Formate.");
            return;
        }

        LoadingService.Show();
        try
        {
            var cts = new CancellationTokenSource(5000); // 5s timeout
            var reportData = await HttpClient.GetFromJsonAsync<ReportData>($"api/ReportData/{reportData1.ReportDataId}", cts.Token);
            if (reportData != null)
            {
                reportData1 = reportData;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"⚠️ Temporary network / server error: {ex.Message}");
        }
        finally
        {
            LoadingService.Hide(); // spinner hide even on exception
        }

        ReportContext.CurrentReportData = reportData1;
        BuildReportUrl();
        ShowDesigner = true;
    }

    ///---------------------------------------------------
    private async Task OnFormatChanged(string newValue)
    {
        LoadingService.Show();
        if (string.IsNullOrWhiteSpace(newValue))
        {
            ToastService.Warning("⚠️ Please select a valid format.");
            return;
        }
        var selected = reportDataList.FirstOrDefault(x => x.FormatName == newValue);
        if (selected == null)
        {
            ToastService.Error("⚠️ Format not found.");
            return;

        }

        reportData1 = selected;

        BuildReportUrl();

        // ShowDesigner = true;
        LoadingService.Hide();
        StateHasChanged();
    }

    void OnFieldChanged(string fieldName, object? value)
    {
        if (value == null) return;

        var prop = typeof(ReportData).GetProperty(fieldName);
        if (prop == null) return;

        var targetType = Nullable.GetUnderlyingType(prop.PropertyType) ?? prop.PropertyType;

        // 🧠 Special Handling for numeric conversion
        if (targetType == typeof(int) || targetType == typeof(int?))
        {
            if (int.TryParse(value.ToString(), out var intVal))
            {
                prop.SetValue(reportData1, intVal);
            }
        }
        else
        {
            // ✅ For string and other simple types
            var convertedValue = Convert.ChangeType(value, targetType);
            prop.SetValue(reportData1, convertedValue);
        }

        BuildReportUrl();
    }

