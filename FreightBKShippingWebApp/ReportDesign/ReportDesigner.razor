@page "/report-designer"

@using DevExpress.Blazor.Reporting
@using DevExpress.DataAccess.Json
@using System.Text
@using Devexpress.Blazor
@using FreightBKShippingWebApp.Model
@using FreightBKShippingWebApp.Models
@using FreightBKShippingWebApp.ReportDesignServices
@using FreightBKShippingWebApp.Services
@using Microsoft.JSInterop
@using System.Text.Json
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject ReportService ReportService
@inject LoadingService LoadingService

@inject ReportContextService ReportContext
<div class="challan-page-container">
     <div class="scrollable-form-content">
        
            <DxReportDesigner @key="ReportUrl" 
                      ReportName="@ReportUrl"
                              Width="100%" Height="100vh" @ref="reportDesigner" />
       
    </div>
</div>


@code {
    private DxReportDesigner? reportDesigner;
    private List<ReportData> reportDataList = new();
    private bool showFormatPopup = false;
    private int selectedReportDataId;
    private ReportData? selectedReportData;
    private string reportDesignerKey = Guid.NewGuid().ToString(); // Unique key for component refresh

    //
    [Parameter] public int reportId { get; set; }

    private string ReportUrl;

    protected override void OnInitialized()
    {
        // Register the component's InvokeAsync so LoadingService can marshal to the UI thread
        LoadingService.SetInvoker(InvokeAsync);

        // ReportUrl = reportId.ToString();
        // LoadingService.Show(); // ✅ Trigger global loader
        // LoadingService.OnChange += StateHasChanged;
        var current = ReportContext.CurrentReportData;

        if (current != null)
        {
            var json = JsonSerializer.Serialize(current);

            ReportUrl = Convert.ToBase64String(
                Encoding.UTF8.GetBytes(json));
        }
        else
        {
            ReportUrl = reportId.ToString();
        }

        LoadingService.Show();
        LoadingService.OnChange += StateHasChanged;
    }
  

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Task.Delay(500); // Simulate load
            LoadingService.Hide(); // ✅ Hide global loader
        }
    }

    public void Dispose()
    {
        LoadingService.OnChange -= StateHasChanged;
    }

   
 
}
