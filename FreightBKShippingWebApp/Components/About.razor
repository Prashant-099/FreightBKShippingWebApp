@page "/about"

<style>
    /* ── Same design tokens as the rest of FreightBook ── */
    .about-page {
        padding: 20px 20px 40px;
        background: var(--clr-bg, #f4f6fb);
        font-family: var(--font-main, 'Sora', 'Segoe UI', sans-serif);
        color: var(--clr-text, #1e293b);
        min-height: 100%;
    }

    /* ══ HEADER BANNER ══ */
    .about-banner {
        background: var(--clr-surface, #fff);
        border: 1px solid var(--clr-border, #e2e8f0);
        border-top: 4px solid var(--clr-primary, #2563eb);
        border-radius: var(--radius-card, 12px);
        box-shadow: var(--shadow-card, 0 1px 3px rgba(0,0,0,.08), 0 4px 16px rgba(0,0,0,.06));
        padding: 24px 28px;
        display: flex;
        align-items: center;
        gap: 20px;
        margin-bottom: 16px;
        flex-wrap: wrap;
    }

    .about-banner-logo {
        width: 56px;
        height: 56px;
        border-radius: 10px;
        background: #eff4ff;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--clr-primary, #2563eb);
        flex-shrink: 0;
    }

    .about-banner-divider {
        width: 1px;
        height: 38px;
        background: var(--clr-border, #e2e8f0);
        flex-shrink: 0;
    }

    .about-banner-text h1 {
        font-size: 1.1rem;
        font-weight: 700;
        letter-spacing: -.02em;
        margin: 0 0 2px;
        color: var(--clr-text, #1e293b);
        line-height: 1.2;
    }

    .about-banner-text p {
        font-size: .75rem;
        color: var(--clr-muted, #64748b);
        margin: 0;
    }

    .about-banner-badge {
        margin-left: auto;
        background: #eff4ff;
        color: var(--clr-primary, #2563eb);
        font-size: 0.6rem;
        font-weight: 600;
        letter-spacing: .08em;
        padding: 3px 10px;
        border-radius: 3px;
        text-transform: uppercase;
        white-space: nowrap;
    }

    /* ══ TWO-COL GRID ══ */
    .about-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    @@media (max-width: 768px) {
        .about-grid

    {
        grid-template-columns: 1fr;
    }

    .about-banner {
        gap: 12px;
    }

    .about-banner-divider {
        display: none;
    }

    .about-banner-badge {
        display: none;
    }

    }

    /* ══ CARD — same as lr-card / pb-card ══ */
    .about-card {
        background: var(--clr-surface, #fff);
        border: 1px solid var(--clr-border, #e2e8f0);
        border-radius: var(--radius-card, 12px);
        box-shadow: var(--shadow-card, 0 1px 3px rgba(0,0,0,.08), 0 4px 16px rgba(0,0,0,.06));
        overflow: hidden;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .about-card-header {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px 16px;
        border-bottom: 1px solid var(--clr-border, #e2e8f0);
        background: linear-gradient(90deg, #f8faff 0%, #fff 100%);
        flex-shrink: 0;
    }

        .about-card-header h2 {
            font-size: .8rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: .06em;
            color: var(--clr-primary, #2563eb);
            margin: 0;
        }

    .about-card-body {
        padding: 18px 20px;
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    /* ══ LOGO AREA ══ */
    .about-logo-wrap {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 8px 0 20px;
    }

        .about-logo-wrap img {
            max-height: 90px;
            max-width: 100%;
            object-fit: contain;
        }

    /* ══ MODULE LIST ══ */
    .module-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .module-item {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 10px 14px;
        background: #f8faff;
        border: 1px solid var(--clr-border, #e2e8f0);
        border-radius: var(--radius-inner, 8px);
        font-size: .8rem;
        color: var(--clr-text, #1e293b);
        line-height: 1.4;
        transition: background .15s, border-color .15s;
    }

        .module-item:hover {
            background: #eff4ff;
            border-color: #bfdbfe;
        }

    .module-icon {
        width: 42px;
        height: 42px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .module-icon.blue {
            background: #eff4ff;
            color: #2563eb;
        }

        .module-icon.amber {
            background: #fffbeb;
            color: #d97706;
        }

        .module-icon.violet {
            background: #f5f3ff;
            color: #7c3aed;
        }

        .module-icon.green {
            background: #ecfdf5;
            color: #059669;
        }

        .module-icon svg {
            width: 22px;
            height: 22px;
            flex-shrink: 0;
        }

    .module-item strong {
        font-weight: 600;
        color: var(--clr-primary, #2563eb);
        display: block;
        font-size: .78rem;
    }

    .module-item span {
        color: var(--clr-muted, #64748b);
        font-size: .73rem;
    }

    /* ══ CONTACT ROWS ══ */
    .contact-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
        flex: 1;
    }

    .contact-row {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 14px;
        background: #f8faff;
        border: 1px solid var(--clr-border, #e2e8f0);
        border-radius: var(--radius-inner, 8px);
        text-decoration: none;
        color: var(--clr-text, #1e293b);
        font-size: .82rem;
        font-weight: 600;
        transition: background .15s, border-color .15s;
    }

        .contact-row:hover {
            background: #eff4ff;
            border-color: #bfdbfe;
            color: var(--clr-primary, #2563eb);
        }

    .contact-row-icon {
        width: 38px;
        height: 38px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.15rem;
        flex-shrink: 0;
    }

        .contact-row-icon.blue {
            background: #eff4ff;
            color: #2563eb;
        }

        .contact-row-icon.green {
            background: #ecfdf5;
            color: #059669;
        }

        .contact-row-icon.red {
            background: #fef2f2;
            color: #ef4444;
        }

        .contact-row-icon.orange {
            background: #fff7ed;
            color: #ea580c;
        }

    .contact-row-label {
        display: flex;
        flex-direction: column;
        gap: 0;
        min-width: 0;
    }

        .contact-row-label small {
            font-size: .62rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: .06em;
            color: var(--clr-muted, #64748b);
            line-height: 1.1;
        }

        .contact-row-label strong {
            font-size: .82rem;
            font-weight: 600;
            color: var(--clr-text, #1e293b);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

    /* ══ SOCIAL BUTTONS ══ */
    .social-row {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-top: 2px;
    }

    .social-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        border-radius: 6px;
        font-size: .75rem;
        font-weight: 600;
        text-decoration: none;
        border: 1px solid var(--clr-border, #e2e8f0);
        background: #f8faff;
        color: var(--clr-text, #1e293b);
        transition: all .15s;
        white-space: nowrap;
    }

        .social-btn:hover {
            opacity: .85;
            transform: translateY(-1px);
        }

        .social-btn.fb {
            background: #eff6ff;
            border-color: #bfdbfe;
            color: #1d4ed8;
        }

        .social-btn.ig {
            background: #fdf2f8;
            border-color: #f9a8d4;
            color: #be185d;
        }

        .social-btn.li {
            background: #eff6ff;
            border-color: #bae6fd;
            color: #0369a1;
        }

        .social-btn.wa {
            background: #f0fdf4;
            border-color: #bbf7d0;
            color: #15803d;
        }

    /* ══ VERSION BADGE ══ */
    .version-row {
        margin-top: auto;
        padding-top: 14px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-top: 1px solid var(--clr-border, #e2e8f0);
    }

    .version-badge {
        font-size: .68rem;
        font-weight: 600;
        letter-spacing: .06em;
        color: var(--clr-muted, #64748b);
        text-transform: uppercase;
    }

        .version-badge span {
            color: var(--clr-primary, #2563eb);
            font-weight: 700;
        }

    .powered-by {
        font-size: .65rem;
        color: var(--clr-muted, #64748b);
        font-weight: 500;
    }

        .powered-by strong {
            color: var(--clr-primary, #2563eb);
            font-weight: 700;
        }
</style>

