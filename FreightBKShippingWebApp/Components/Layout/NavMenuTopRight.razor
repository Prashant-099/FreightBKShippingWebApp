@* NavMenuTopRight.razor — Top header ke right side mein: notifications + user profile *@

@using FreightBKShippingWebApp.Authentication
@using FreightBKShippingWebApp.Model
@using FreightBKShippingWebApp.Services
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject AuthenticationStateProvider AuthStateProvider
@inject AuthService AuthService
@inject YearStatechangeService YearStatechangeService
@inject AuditLogService AuditLogService

<style>
    .top-right-actions {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-shrink: 0;
    }

    .user-profile-popup-modern {
        width: 250px;
        max-width: 90vw;
        padding: 16px;
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.15);
        display: flex;
        flex-direction: column;
    }

    .profile-header { display: flex; align-items: center; gap: 12px; }
    .profile-avatar { font-size: 2.5rem; color: #6f42c1; }
    .profile-name   { font-weight: 600; font-size: 1rem; color: #212529; }
    .profile-email  { font-size: 0.82rem; color: #6c757d; word-break: break-word; }
    .profile-divider { margin: 12px 0; border: 0; border-top: 1px solid #e9ecef; }
    .profile-section { margin-bottom: 10px; }
    .logout-btn { width: 100%; border-radius: 10px !important; font-weight: 500; }

    .activity-item {
        border-left: 4px solid #667eea;
        margin: 4px 0;
        background: #f8f9fa;
        border-radius: 0 10px 10px 0;
        padding: 8px 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    }
    .activity-time { font-size: 0.8rem; color: #6c757d; }
    .status-badge  { padding: 3px 8px; border-radius: 20px; font-size: 0.78rem; font-weight: 600; }
    .badge-insert  { background: #d1e7dd; color: #0f5132; }
    .badge-update  { background: #cff4fc; color: #055160; }
    .badge-delete  { background: #f8d7da; color: #842029; }
    .badge-approve { background: #e2e3ff; color: #383d7a; }
    .badge-cancel  { background: #fff3cd; color: #664d03; }
</style>

<div class="top-right-actions">

    <!-- Notifications bell (Admin only) -->
    @if (IsAdmin)
    {
        <DxMenu DisplayMode="MenuDisplayMode.Desktop" CssClass="top-icon-menu">
            <Items>
                <DxMenuItem IconCssClass="bi bi-bell-fill" CssClass="notoggle" Position="ItemPosition.End">
                    <SubMenuTemplate>
                        <div style="max-height: 280px; overflow-y: auto; min-width: 280px;">
                            @if (recentActivities.Any())
                            {
                                @foreach (var activity in recentActivities)
                                {
                                    <div class="activity-item">
                                        <div class="d-flex justify-content-between align-items-start gap-2">
                                            <div class="flex-grow-1">
                                                <strong>@activity.Title</strong>
                                                <p class="mb-1 text-muted small">@activity.Description</p>
                                                <span class="status-badge badge-@activity.Status.ToLower()">
                                                    @activity.Status — @activity.Time.ToString("dd MMM, hh:mm tt")
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="text-center text-muted py-4">
                                    <i class="bi bi-inbox" style="font-size: 2.5rem; opacity: 0.4;"></i>
                                    <p class="mt-2">No recent activity</p>
                                </div>
                            }
                        </div>
                    </SubMenuTemplate>
                </DxMenuItem>
            </Items>
        </DxMenu>
    }

    <!-- User profile -->
    <DxMenu DisplayMode="MenuDisplayMode.Desktop" CssClass="top-icon-menu">
        <Items>
            <DxMenuItem IconCssClass="bi bi-person-circle" Position="ItemPosition.End" CssClass="notoggle">
                <SubMenuTemplate>
                    <div class="user-profile-popup-modern">
                        <div class="profile-header">
                            <i class="bi bi-person-circle profile-avatar"></i>
                            <div>
                                <div class="profile-name">@UserName</div>
                                <div class="profile-email">@UserEmail</div>
                            </div>
                        </div>
                        <hr class="profile-divider" />
                        <div class="profile-section">
                            <label class="form-label small mb-1">Active Year</label>
                            <DxComboBox Data="@(YearStatechangeService.Years ?? new List<YearModel>())"
                                        TextFieldName="YearName"
                                        ValueFieldName="YearId"
                                        Value="@YearStatechangeService.SelectedYearId"
                                        ValueChanged="@((int? v) => YearStatechangeService.ChangeYear(v ?? 0))"
                                        CssClass="w-100" />
                        </div>
                        <div class="profile-section">
                            <label class="form-label small mb-1">Branch</label>
                            <BranchSelection />
                        </div>
                        <div class="profile-section">
                            <DxButton Text="Log Off"
                                      RenderStyle="@ButtonRenderStyle.Danger"
                                      CssClass="logout-btn"
                                      Click="Logout" />
                        </div>
                    </div>
                </SubMenuTemplate>
            </DxMenuItem>
        </Items>
    </DxMenu>

</div>

@code {
    private string UserName = "User";
    private string UserEmail = "";
    private bool IsAdmin = false;
    private List<ActivityItem> recentActivities = new();

    public class ActivityItem
    {
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public string Status { get; set; } = "";
        public DateTime Time { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            UserName = user.FindFirst(ClaimTypes.GivenName)?.Value
                       ?? user.Identity.Name ?? "User";
            UserEmail = user.FindFirst(c =>
                c.Type == "email" || c.Type == ClaimTypes.Email)?.Value ?? "";
            IsAdmin = user.IsInRole("Admin");

            if (IsAdmin)
                await LoadRecentActivities();
        }
    }

    private async Task LoadRecentActivities()
    {
        var currentYearId = YearStatechangeService.SelectedYearId;
        var logs = (await AuditLogService.GetLatestAsync())
            .Where(a => a.YearId == currentYearId)
            .OrderByDescending(l => l.DateTime)
            .Take(10)
            .ToList();

        recentActivities = logs.Select(l => new ActivityItem
        {
            Title       = l.TableName,
            Description = l.Remarks ?? "",
            Status      = l.Operations,
            Time        = l.DateTime
        }).ToList();
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
    }
}
