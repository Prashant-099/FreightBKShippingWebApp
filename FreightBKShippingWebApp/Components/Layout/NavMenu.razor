@using FreightBKShippingWebApp.Authentication
@using FreightBKShippingWebApp.Model
@using FreightBKShippingWebApp.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@inject YearStatechangeService YearStatechangeService
<div class="sb-inner">

    <!-- Search -->
    <div class="sb-search-wrap">
        <i class="bi bi-search sb-search-icon"></i>
        <input class="sb-search-input"
               type="text"
               placeholder="Find menu by keyword"
               @bind="_q"
               @bind:event="oninput" />
    </div>

    <!-- Nav -->
    <nav class="sb-nav">

        <!-- Home -->
        <NavLink class="sb-item" href="/dashboard" Match="NavLinkMatch.All"
                 ActiveClass="sb-item-active" @onclick="NavClicked">
            <i class="bi bi-house-door-fill sb-icon" style="color:#3b82f6"></i>
            <span>Home</span>
        </NavLink>

        <!-- -- ADMINISTRATION ------------------- -->
        @if (ShowGroup("Administration", adminItems))
        {
            <div class="sb-label">Administration</div>
            <div class="sb-group">
                <button class="sb-group-btn" @onclick="@(() => Toggle(ref _admin))">
                    <i class="bi bi-shield-lock-fill sb-icon" style="color:#f59e0b"></i>
                    <span>Admin</span>
                    <i class="bi bi-chevron-right sb-chevron @(_admin ? "sb-chevron-open" : "")"></i>
                </button>
                @if (_admin)
                {
                    <div class="sb-sub">
                        @foreach (var x in Filter(adminItems))
                        {
                            <NavLink class="sb-sub-item" href="@x.Url"
                                     ActiveClass="sb-sub-active" @onclick="NavClicked">
                                <i class="@x.Icon sb-sub-icon"></i>
                                <span>@x.Label</span>
                            </NavLink>
                        }
                    </div>
                }
            </div>
        }

        <!-- -- MASTERS ------------------------- -->
        @if (ShowGroup("Masters", masterItems))
        {
            <div class="sb-label">Masters</div>
            <div class="sb-group">
                <button class="sb-group-btn" @onclick="@(() => Toggle(ref _masters))">
                    <i class="bi bi-collection-fill sb-icon" style="color:#06b6d4"></i>
                    <span>Masters</span>
                    <i class="bi bi-chevron-right sb-chevron @(_masters ? "sb-chevron-open" : "")"></i>
                </button>
                @if (_masters)
                {
                    <div class="sb-sub">
                        @foreach (var x in Filter(masterItems))
                        {
                            <NavLink class="sb-sub-item" href="@x.Url"
                                     ActiveClass="sb-sub-active" @onclick="NavClicked">
                                <i class="@x.Icon sb-sub-icon"></i>
                                <span>@x.Label</span>
                            </NavLink>
                        }
                    </div>
                }
            </div>
        }

        <!-- -- OPERATIONS ---------------------- -->
        @if (ShowGroup("Operations", shipItems) || ShowGroup("Transport", transportItems))
        {
            <div class="sb-label">Operations</div>

            <NavLink class="sb-item" href="/quotation" Match="NavLinkMatch.All"
                     ActiveClass="sb-item-active" @onclick="NavClicked">
                <i class="bi bi-file-earmark-text sb-icon" style="color:#8b5cf6"></i>
                <span>Quotation</span>
            </NavLink>

            @if (ShowGroup("Shipments", shipItems))
            {
                <div class="sb-group">
                    <button class="sb-group-btn" @onclick="@(() => Toggle(ref _ship))">
                        <i class="bi bi-truck-front-fill sb-icon" style="color:#3b82f6"></i>
                        <span>Shipments</span>
                        <i class="bi bi-chevron-right sb-chevron @(_ship ? "sb-chevron-open" : "")"></i>
                    </button>
                    @if (_ship)
                    {
                        <div class="sb-sub">
                            @foreach (var x in Filter(shipItems))
                            {
                                <NavLink class="sb-sub-item" href="@x.Url"
                                         ActiveClass="sb-sub-active" @onclick="NavClicked">
                                    <i class="@x.Icon sb-sub-icon"></i>
                                    <span>@x.Label</span>
                                </NavLink>
                            }
                        </div>
                    }
                </div>
            }

            @if (ShowGroup("Transport", transportItems))
            {
                <div class="sb-group">
                    <button class="sb-group-btn" @onclick="@(() => Toggle(ref _transport))">
                        <i class="bi bi-truck sb-icon" style="color:#3b82f6"></i>
                        <span>Transport</span>
                        <i class="bi bi-chevron-right sb-chevron @(_transport ? "sb-chevron-open" : "")"></i>
                    </button>
                    @if (_transport)
                    {
                        <div class="sb-sub">
                            @foreach (var x in Filter(transportItems))
                            {
                                <NavLink class="sb-sub-item" href="@x.Url"
                                         ActiveClass="sb-sub-active" @onclick="NavClicked">
                                    <i class="@x.Icon sb-sub-icon"></i>
                                    <span>@x.Label</span>
                                </NavLink>
                            }
                        </div>
                    }
                </div>
            }
        }

        <!-- -- ACCOUNTING ---------------------- -->
        @if (ShowGroup("Accounting", voucherItems))
        {
            <div class="sb-label">Accounting</div>
            <div class="sb-group">
                <button class="sb-group-btn" @onclick="@(() => Toggle(ref _voucher))">
                    <i class="bi bi-journal-bookmark-fill sb-icon" style="color:#10b981"></i>
                    <span>Voucher</span>
                    <i class="bi bi-chevron-right sb-chevron @(_voucher ? "sb-chevron-open" : "")"></i>
                </button>
                @if (_voucher)
                {
                    <div class="sb-sub">
                        @foreach (var x in Filter(voucherItems))
                        {
                            <NavLink class="sb-sub-item" href="@x.Url"
                                     ActiveClass="sb-sub-active" @onclick="NavClicked">
                                <i class="@x.Icon sb-sub-icon"></i>
                                <span>@x.Label</span>
                            </NavLink>
                        }
                    </div>
                }
            </div>
        }

        <!-- -- ANALYTICS ----------------------- -->
        @if (ShowGroup("Analytics", reportItems))
        {
            <div class="sb-label">Analytics</div>
            <div class="sb-group">
                <button class="sb-group-btn" @onclick="@(() => Toggle(ref _reports))">
                    <i class="bi bi-bar-chart-line-fill sb-icon" style="color:#ef4444"></i>
                    <span>Reports</span>
                    <i class="bi bi-chevron-right sb-chevron @(_reports ? "sb-chevron-open" : "")"></i>
                </button>
                @if (_reports)
                {
                    <div class="sb-sub">
                        @foreach (var x in Filter(reportItems))
                        {
                            <NavLink class="sb-sub-item" href="@x.Url"
                                     ActiveClass="sb-sub-active" @onclick="NavClicked">
                                <i class="@x.Icon sb-sub-icon"></i>
                                <span>@x.Label</span>
                            </NavLink>
                        }

                        <!-- GSTR sub-group -->
                        <button class="sb-group-btn sb-sub-group-btn"
                                @onclick="@(() => Toggle(ref _gstr))">
                            <i class="bi bi-receipt sb-sub-icon"></i>
                            <span>GSTR Reports</span>
                            <i class="bi bi-chevron-right sb-chevron @(_gstr ? "sb-chevron-open" : "")"></i>
                        </button>
                        @if (_gstr)
                        {
                            <div class="sb-sub sb-nested">
                                <NavLink class="sb-sub-item" href="/gstr1" ActiveClass="sb-sub-active" @onclick="NavClicked">
                                    <i class="bi bi-file-earmark-text sb-sub-icon"></i><span>GSTR-1</span>
                                </NavLink>
                                <NavLink class="sb-sub-item" href="/gstr2" ActiveClass="sb-sub-active" @onclick="NavClicked">
                                    <i class="bi bi-file-earmark-text sb-sub-icon"></i><span>GSTR-2</span>
                                </NavLink>
                                <NavLink class="sb-sub-item" href="/gstr3b" ActiveClass="sb-sub-active" @onclick="NavClicked">
                                    <i class="bi bi-file-earmark-text sb-sub-icon"></i><span>GSTR-3B</span>
                                </NavLink>
                            </div>
                        }
                    </div>
                }
            </div>
        }

        <!-- About -->
        <NavLink class="sb-item" href="/about"
                 ActiveClass="sb-item-active" @onclick="NavClicked">
            <i class="bi bi-info-square-fill sb-icon" style="color:#64748b"></i>
            <span>About</span>
        </NavLink>

    </nav>

    <!-- Footer -->
    <div class="sb-footer">
        <i class="bi bi-headset"></i>&nbsp;Support: 9409309616
    </div>

</div>

@code {
    [Parameter] public EventCallback OnNavClick { get; set; }

    private string _q = "";

    private bool _admin = false;
    private bool _masters = false;
    private bool _ship = false;
    private bool _transport = false;
    private bool _voucher = false;
    private bool _reports = false;
    private bool _gstr = false;
    private bool _quotation;

    private void Toggle(ref bool val) => val = !val;

    private record M(string Label, string Url, string Icon);

    private List<M> adminItems = new()
    {
        new("Company",        "/company",    "bi bi-buildings"),
        new("Branch",         "/branch",     "bi bi-diagram-3"),
        new("Year",           "/year",       "bi bi-calendar3"),
        new("Voucher Type",   "/voucher",    "bi bi-receipt"),
        new("User",           "/user",       "bi bi-person-circle"),
        new("GST Slab",       "/gstslabs",   "bi bi-cash-coin"),
        new("Users Activity", "/audit-logs", "bi bi-person-video2"),
    };

    private List<M> masterItems = new()
    {
        new("Accounts",      "/account",      "bi bi-journal-text"),
        new("Service",       "/service",      "bi bi-gear"),
        new("Service Group", "/servicegroup", "bi bi-diagram-3"),
        new("HSN/SAC",       "/hsnsac",       "bi bi-card-list"),
        new("Cargo",         "/cargo",        "bi bi-box-seam"),
        new("Station/Port",  "/location",     "bi bi-geo"),
        new("Miscellaneous", "/notify",       "bi bi-grid"),
        new("Vessel",        "/vessels",      "bi bi-truck"),
        new("Currency",      "/currency",     "bi bi-currency-exchange"),
        new("Country",       "/country",      "bi bi-globe"),
        new("Unit",          "/Unit",         "bi bi-rulers"),
        new("Rate",          "/ratemaster",   "bi bi-currency-exchange"),
        new("Status",        "/status",       "bi bi-flag"),
        new("Vehicle",       "/vehicle",      "bi bi-truck-front"),
    };

    private List<M> shipItems = new()
    {      
        new("Import Job", "/jobimport", "bi bi-box-arrow-in-down"),
        new("Export Job", "/jobexport", "bi bi-box-arrow-up"),
    };

    private List<M> quotationItems = new()
    {
        new("Quotation", "/quotation", "bi bi-file-earmark-text"),
    };

    private List<M> transportItems = new()
    {
        new("Party Bill", "/partybill", "bi bi-box-arrow-in-down"),
        new("Lr Entry",   "/lrentry",   "bi bi-box-arrow-in-down"),
        new("tickets",   "/tickets",   "bi bi-box-arrow-in-down"),
    };

    private List<M> voucherItems = new()
    {
        new("Sale Invoice",     "/bill",         "bi bi-receipt"),
        new("Purchase Invoice", "/purchase",     "bi bi-bag-check"),
        new("Receipt",          "/Receipt",      "bi bi-cash-coin"),
        new("Payment",          "/Payment",      "bi bi-credit-card-2-front"),
        new("Contra",           "/Contra",       "bi bi-arrow-left-right"),
        new("JournalEntry",     "/JournalEntry", "bi bi-journal-text"),
    };

    private List<M> reportItems = new()
    {
        new("Job Register",       "/jobregister",         "bi bi-book"),
        new("Invoice Register",   "/invoiceregister",     "bi bi-file-earmark-spreadsheet"),
        new("Invoice Tally",      "/InvoiceExporttally",  "bi bi-arrow-left-right"),
        new("Outstanding Report", "/outstandingregister", "bi bi-hourglass-split"),
        new("Profit & Loss",      "/jobprofitloss",       "bi bi-graph-up"),
        new("TDS Report",         "/TdsReport",           "bi bi-receipt-cutoff"),
    };

    private bool ShowGroup(string groupName, List<M> items)
    {
        if (string.IsNullOrWhiteSpace(_q)) return true;
        var q = _q.ToLower();
        return groupName.ToLower().Contains(q) || items.Any(i => i.Label.ToLower().Contains(q));
    }

    private IEnumerable<M> Filter(List<M> items)
    {
        if (string.IsNullOrWhiteSpace(_q)) return items;
        return items.Where(i => i.Label.ToLower().Contains(_q.ToLower()));
    }

    private async Task NavClicked() => await OnNavClick.InvokeAsync();
}

