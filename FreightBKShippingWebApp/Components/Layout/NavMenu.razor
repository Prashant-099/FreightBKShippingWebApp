    private List<ActivityItem> recentActivities = new();
    public class ActivityItem
    {
        public string Title { get; set; }
        public string Description { get; set; }
        public string Status { get; set; }
        public DateTime Time { get; set; }
    }
    private async Task LoadRecentActivities()
    {

        var CurrentYearId = YearStatechangeService.SelectedYearId;
        var logs = (await AuditLogService.GetLatestAsync())
            .Where(a => a.YearId == CurrentYearId)
            .Take(10)
            .ToList();
       
        recentActivities = MapAuditLogsToActivities(logs);
    }
    private List<ActivityItem> MapAuditLogsToActivities(List<AuditLog> logs)
    {
        logs ??= new();

        return logs
            .OrderByDescending(l => l.DateTime)
            .Select(l => new ActivityItem
            {
                Title = $"{l.TableName}",

                Description = $"{(!string.IsNullOrEmpty(l.Remarks) ? $"  {l.Remarks}" : "")}",

                Status = l.Operations, // INSERT / UPDATE / DELETE
                Time = l.DateTime
            })
            .Take(10)
            .ToList();
    }

