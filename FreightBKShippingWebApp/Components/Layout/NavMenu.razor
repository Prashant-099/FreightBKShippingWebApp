<style>
    .user-profile-popup-modern {
        width: 250px;
        max-width: 90vw;
        padding: 16px;
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
