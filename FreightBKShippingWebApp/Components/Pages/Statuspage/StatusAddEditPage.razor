@using FreightBKShippingWebApp.Model
@using FreightBKShippingWebApp.Services
@using System.Text.Json
@inject StatusService StatusService
@inject ToasteService ToastService
@inject LoadingService LoadingService
@inject AuditLogService AuditLogService
<DxPopup @bind-Visible="Visible"
         ShowCloseButton="true"
         HeaderText="@Title"
         MaxWidth="500"
         CloseOnOutsideClick="false"
         HorizontalAlignment="HorizontalAlignment.Center"
         VerticalAlignment="VerticalAlignment.Center"
         ShowFooter="true"
         Scrollable="true">

    <BodyContentTemplate Context="cts">
        <EditForm Model="@EditModel"
                  OnValidSubmit="HandleValidSubmit"
                  id="statusForm">

            <DataAnnotationsValidator />

            <DxFormLayout>

                <DxFormLayoutItem Caption="Status Name" Context="gts" ColSpanMd="12">

                    <DxTextBox @bind-Text="EditModel.StatusName"
                               ShowValidationIcon="true"
                               ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />

                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="Status Code" Context="gts2" ColSpanMd="12">
                    <DxComboBox @bind-Value="EditModel.Status_code" Data="@statusCodeList" TextFieldName="Text" ValueFieldName="Value" SearchFilterCondition="ListSearchFilterCondition.Default" SearchMode="ListSearchMode.Default" AllowUserInput></DxComboBox>

                    </DxFormLayoutItem>

            </DxFormLayout>
        </EditForm>
    </BodyContentTemplate>

    <FooterContentTemplate Context="cts">
        <div class="mt-3 text-end">
            <DxButton Text="Save"
                      RenderStyle="ButtonRenderStyle.Primary"
                      SubmitFormOnClick="true"
                      Form="statusForm" />

            <DxButton Text="Cancel"
                      RenderStyle="ButtonRenderStyle.Secondary"
                      Click="Hide" />
        </div>
    </FooterContentTemplate>

</DxPopup>

@code {

    private bool Visible { get; set; }
    private string Title { get; set; } = "Add Status";

    private Status EditModel { get; set; } = new();

    // List<Status> statusCodeList;
    [Parameter] public EventCallback OnSaved { get; set; }
    public class SelectItem
    {
        public string Text { get; set; }
        public string Value { get; set; }
    }
    List<SelectItem> statusCodeList = new()
{
    new SelectItem { Text = "PENDING", Value = "PENDING" },
    new SelectItem { Text = "COMPLETED", Value = "COMPLETED" },
     new SelectItem { Text = "CANCELLED", Value = "CANCELLED" }
};

    protected override async Task OnInitializedAsync()
    {
        // statusCodeList = await StatusService.GetAllAsync();
    }

    public void Show(Status status)
    {
        if (status.StatusId > 0)
        {
            // Edit mode
            //EditModel = status;
            var json = JsonSerializer.Serialize(status);
            EditModel = JsonSerializer.Deserialize<Status>(json) ?? new Status();
            Title = "Edit Status";
        }
        else
        {
            // Add mode
            EditModel = new Status();
            Title = "Add Status";
        }


        Visible = true;
    }

    private void Hide()
    {
        Visible = false;
    }

    private async Task HandleValidSubmit()
    {
        LoadingService.Show();
        try
        {
            bool result;

            if (EditModel.StatusId == 0)
            {
                result = await StatusService.CreateAsync(EditModel);
                if (result)
                {
                    ToastService.Success("Status created successfully!");
                    AuditLogService.NotifyAuditChanged();
                }
                else
                {
                    ToastService.Error(StatusService.LastError??"Failed to create status!");
                    return;
                }
            }
            else
            {
                result = await StatusService.UpdateAsync(EditModel);
                if (result)
                {
                    ToastService.Success("Status updated successfully!");
                    AuditLogService.NotifyAuditChanged();
                }
                else
                {
                    ToastService.Error(StatusService.LastError ?? "Failed to update status!");
                    return;
                }
            }

            Visible = false;
            await OnSaved.InvokeAsync();
        }
        catch (Exception ex)
        {
            ToastService.Error($"Error saving status: {ex.Message}");
        }
        finally
        {
            LoadingService.Hide();
        }
    }
}