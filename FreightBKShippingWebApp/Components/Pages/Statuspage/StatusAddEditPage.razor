@using FreightBKShippingWebApp.Model
@using FreightBKShippingWebApp.Services
@inject StatusService StatusService
@inject ToasteService ToastService
@inject LoadingService LoadingService

<DxPopup @bind-Visible="Visible"
         ShowCloseButton="true"
         HeaderText="@Title"
         MaxWidth="500"
         CloseOnOutsideClick="false"
         HorizontalAlignment="HorizontalAlignment.Center"
         VerticalAlignment="VerticalAlignment.Center"
         ShowFooter="true"
         Scrollable="true">

    <BodyContentTemplate Context="cts">
        <EditForm Model="@EditModel"
                  OnValidSubmit="HandleValidSubmit"
                  id="statusForm">

            <DataAnnotationsValidator />

            <DxFormLayout>

                <DxFormLayoutItem Caption="Status Name" Context="gts" ColSpanMd="12">

                    <DxTextBox @bind-Text="EditModel.StatusName"
                               ShowValidationIcon="true"
                               ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />

                </DxFormLayoutItem>

            </DxFormLayout>
        </EditForm>
    </BodyContentTemplate>

    <FooterContentTemplate Context="cts">
        <div class="mt-3 text-end">
            <DxButton Text="Save"
                      RenderStyle="ButtonRenderStyle.Primary"
                      SubmitFormOnClick="true"
                      Form="statusForm" />

            <DxButton Text="Cancel"
                      RenderStyle="ButtonRenderStyle.Secondary"
                      Click="Hide" />
        </div>
    </FooterContentTemplate>

</DxPopup>

@code {

    private bool Visible { get; set; }
    private string Title { get; set; } = "Add Status";

    private Status EditModel { get; set; } = new();


    [Parameter] public EventCallback OnSaved { get; set; }

    public void Show(Status status)
    {
        if (status.StatusId > 0)
        {
            // Edit mode
            EditModel = status;
            Title = "Edit Status";
        }
        else
        {
            // Add mode
            EditModel = new Status();
            Title = "Add Status";
        }


        Visible = true;
    }

    private void Hide()
    {
        Visible = false;
    }

    private async Task HandleValidSubmit()
    {
        LoadingService.Show();
        try
        {
            bool result;

            if (EditModel.StatusId == 0)
            {
                result = await StatusService.CreateAsync(EditModel);
                if (result)
                    ToastService.Success("Status created successfully!");
                else
                {
                    ToastService.Error("Failed to create status!");
                    return;
                }
            }
            else
            {
                result = await StatusService.UpdateAsync(EditModel);
                if (result)
                    ToastService.Success("Status updated successfully!");
                else
                {
                    ToastService.Error("Failed to update status!");
                    return;
                }
            }

            Visible = false;
            await OnSaved.InvokeAsync();
        }
        catch (Exception ex)
        {
            ToastService.Error($"Error saving status: {ex.Message}");
        }
        finally
        {
            LoadingService.Hide();
        }
    }
}