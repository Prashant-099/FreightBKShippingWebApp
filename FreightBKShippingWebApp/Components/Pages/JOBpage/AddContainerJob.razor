    // }

    //========================================
    bool popupVisible = false;
    Job job = new();
    DxGrid Grid;
    DxGrid GridTwo;

    List<Lr> Rows = new();
    // List<Lr> secondgrid2 = new();
    private Lr EditModel { get; set; } = new();
    private Dictionary<Lr, DataChange> UnsavedChanges { get; } = new();
    private bool BatchItemsEnabled => UnsavedChanges.Count > 0 || (Grid?.IsEditing() ?? false);
    record DataChange(DataChangeType Type, HashSet<string> ChangedFields);

    bool nonTransportExpanded = true;   // Non-Transport open by default
    bool detailsExpanded = false;
    enum DataChangeType { Modification, Addition, Delete }

    Lr SelectedRow;
    private int? nextSNo = 1;
    public enum PopupOpenMode
    {
        Import,
        Export
    }
    PopupOpenMode popupMode;
    bool suppressExpandEvents;

    public async Task OpenPopup(Job selected, PopupOpenMode PopupMode)
    {
        if (selected == null || selected.JobId == 0)
        {
            ToastService.Error("Job not passed correctly to AddContainer popup");
            return;
        }

        job = selected;
        popupMode = PopupMode;

        // Immediately start loading data but don't await yet
        var loadDataTask = LoadPopupDataFastAsync();

        // Show popup at once
        popupVisible = true;

        suppressExpandEvents = true;
        nonTransportExpanded = PopupMode == PopupOpenMode.Import;
        detailsExpanded = PopupMode == PopupOpenMode.Export && job.IsTransportaion == true;
        suppressExpandEvents = false;

        StateHasChanged();   // show popup immediately

        // Now await the data load
        await loadDataTask;

        await InvokeAsync(StateHasChanged);  // update grid
    }


    private async Task LoadPopupDataFastAsync()
    {
        try
        {
            var dbRows = await ContainerAddServices.GetByJobIdAsync(job.JobId) ?? new List<Lr>();

            if (popupMode == PopupOpenMode.Import)
            {
                // import mode
                if (dbRows.Count > 0)
                  await  AssignImportRows(dbRows);
                else
                    AssignDefaultImportRows();
            }
            else
            {
                // export mode
             await AssignExportRows(dbRows);
            }

            // load report templates
            await LoadReportList();
        }
        catch (Exception ex)
        {
            ToastService.Error($"Popup load failed: {ex.Message}");
        }
    }

    private async Task AssignImportRows(List<Lr> dbRows)
    {
        if (Rows == null)
            Rows = new List<Lr>(dbRows.Count);
        else
            Rows.Clear();

        int i = 0;
        foreach (var r in dbRows)
        {
            r.SrNo = ++i;
            r.LrJobId = job.JobId;
            r.LrJobNo ??= job.JobNo;
            r.LrStatus = 1;
            Rows.Add(r);
        }
    }

    private void AssignDefaultImportRows()
    {
        Rows = new List<Lr>(5);
        for (int i = 1; i <= 5; i++)
            Rows.Add(new Lr { SrNo = i });
    }
    private async Task AssignExportRows(List<Lr> dbRows)
    {
        // Always show db rows (even if empty)
        listofcontainer = new List<Lr>(dbRows.Count);

        int i = 0;
        foreach (var r in dbRows.OrderBy(x => x.LrId))
        {
            r.SrNo = ++i;
            r.LrJobId = job.JobId;
            r.LrJobNo ??= job.JobNo;
            r.LrStatus = 1;
            listofcontainer.Add(r);
        }
    }

    //==========================
    void Grid_CustomizeElement(GridCustomizeElementEventArgs ea)
    {

    }

    void Grid_CustomizeEditModel(GridCustomizeEditModelEventArgs e)
    {
        EditModel = e.DataItem as Lr;
    }

    void Grid_EditModelSaving(GridEditModelSavingEventArgs e)
    {
        var row = (Lr)e.DataItem;

        e.CopyChangesToDataItem();

        if (!row.IsNew)
            row.IsDirty = true;
    }

    private async Task SaveNT_Click()
    {
        if (Grid.IsEditing())
            await Grid.CancelEditAsync();

        // 🗑️ STEP 1: Handle Deleted Rows
        var deletedRows = Rows
            .Where(r => r.IsDeleted && r.LrId > 0)
            .ToList();

        foreach (var row in deletedRows)
        {
            await ContainerAddServices.DeleteAsync(row.LrId);
            Rows.Remove(row); // remove from UI
        }

        // ✅ STEP 2: Only NEW or MODIFIED rows
        var rowsToSave = Rows.Where(r =>
            !r.IsDeleted &&
            (r.IsNew || r.IsDirty) &&
            (
                !string.IsNullOrWhiteSpace(r.LrContainer1) ||
                r.LrNtDate != null ||
                !string.IsNullOrWhiteSpace(r.LrNtRfidSeal) ||
                (r.LrNtQty ?? 0) > 0 ||
                !string.IsNullOrWhiteSpace(r.LrNtInvNo) ||
                (r.LrNtNetWt ?? 0) > 0 ||
                !string.IsNullOrWhiteSpace(r.LrNtUnit) ||
                !string.IsNullOrWhiteSpace(r.LrRemarks)
            )
        ).ToList();

        if (!rowsToSave.Any() && !deletedRows.Any())
        {
            ToastService.Warning("No changes to save");
            return;
        }

        int successCount = 0;
        int failCount = 0;

        // 🧮 JOB LEVEL COLLECTION
        var container20 = new List<string>();
        var container40 = new List<string>();

        try
        {
            foreach (var row in rowsToSave)
            {
                // 🛑 container mandatory
                if (string.IsNullOrWhiteSpace(row.LrContainer1))
                {
                    ToastService.Warning("Container number required");
                    continue;
                }

                row.LrJobId = job.JobId;
                row.LrJobNo = job.JobNo;
                row.LrVoucherId = job.JobId;
                row.LrStatus = 1;

                row.LrPartyAccountId = row.LrPartyAccountId == 0 ? 1 : row.LrPartyAccountId;
                row.LrSupplierAccountId = row.LrSupplierAccountId == 0 ? 1 : row.LrSupplierAccountId;

                Lr? result = row.IsNew
                    ? await ContainerAddServices.CreateAsync(row)
                    : await ContainerAddServices.UpdateAsync(row);

                if (result != null)
                {
                    row.LrId = result.LrId;
                    row.IsNew = false;
                    row.IsDirty = false;
                    successCount++;
                }
                else
                {
                    failCount++;
                }
            }

            // ✅ STEP 3: Job Container Summary (only active rows)
            var activeRows = Rows.Where(r => !r.IsDeleted).ToList();

            foreach (var r in activeRows)
            {
                if (r.LrNtSize == "20")
                    container20.Add(r.LrContainer1);

                if (r.LrNtSize == "40")
                    container40.Add(r.LrContainer1);
            }

            job.Job20Ft = container20.Any() ? container20.Distinct().Count().ToString() : null;
            job.Job40Ft = container40.Any() ? container40.Distinct().Count().ToString() : null;

            job.JobContainer20Ft = container20.Any()
                ? string.Join(", ", container20.Distinct())
                : null;

            job.JobContainer40Ft = container40.Any()
                ? string.Join(", ", container40.Distinct())
                : null;

            await JobService.UpdateAsync(job);

            if (successCount > 0)
                ToastService.Success($"Saved {successCount} row(s)");

            if (failCount > 0)
                ToastService.Warning($"{failCount} row(s) failed");
        }
        catch (Exception ex)
        {
            ToastService.Error($"Error while saving: {ex.Message}");
        }
    }



