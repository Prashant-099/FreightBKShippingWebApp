    // Updated Save_Click method with all new fields
    private async Task Save_Click()
    {
        if (Grid.IsEditing())
            await Grid.CancelEditAsync();

        // Filter rows that have meaningful data
        var validRows = Rows
            .Where(r => r.LrVehicleId > 0 ||
                       r.LrFromLocationId > 0 ||
                       r.LrToLocationId > 0 ||
                       r.LrDate.HasValue ||
                       r.LrNtDate.HasValue ||
                       (r.LrGrossWt ?? 0) > 0 ||
                       r.LrLoadWt > 0 ||
                       r.LrUnloadWt > 0 ||
                       r.LrRateBill > 0 ||
                       r.LrNetFreightBill > 0 ||
                       !string.IsNullOrWhiteSpace(r.LrPaymentType) ||
                       !string.IsNullOrWhiteSpace(r.LrRemarks) ||
                       !string.IsNullOrWhiteSpace(r.LrNoStr) ||
                       !string.IsNullOrWhiteSpace(r.LrContainer1) ||
                       !string.IsNullOrWhiteSpace(r.LrContainer2) ||
                       !string.IsNullOrWhiteSpace(r.LrNtSize) ||
                       !string.IsNullOrWhiteSpace(r.LrNtSealNo) ||
                       !string.IsNullOrWhiteSpace(r.LrNtInvNo) ||
                       !string.IsNullOrWhiteSpace(r.LrNtVehicleNo) ||
                       (r.LrNtQty ?? 0) > 0)
            .ToList();

        if (!validRows.Any())
        {
            Console.WriteLine("No data to save");
            return;
        }

        try
        {
            // Set required fields for valid rows
            foreach (var row in validRows)
            {
                if (row.LrCompanyId == 0) row.LrCompanyId = 1;
                // if (row.LrAddedByUserId == 0) row.LrAddedByUserId = 1;
                if (row.LrVoucherId == 0) row.LrVoucherId = job.JobId;
                if (row.LrPartyAccountId == 0) row.LrPartyAccountId = 1;
                if (row.LrSupplierAccountId == 0) row.LrSupplierAccountId = 1;

                if (row.LrId == 0)
                {
                    row.LrCreated = DateTime.UtcNow;
                }
                row.LrUpdated = DateTime.UtcNow;
            }

            // await LrService.SaveAsync(validRows);
            Console.WriteLine($"Saved {validRows.Count} rows out of {Rows.Count} total rows");

        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving data: {ex.Message}");
        }
    }

