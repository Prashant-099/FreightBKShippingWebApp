    async Task DeleteDataItem(object dataItem)
    {
        var row = (Lr)dataItem;

        if (Grid.IsEditing())
            await Grid.CancelEditAsync();

        // 🗄️ DB se delete (sirf saved rows)
        if (row.LrId > 0)
            await ContainerAddServices.DeleteAsync(row.LrId);

        Rows.Remove(row);

        int sr = 1;
        foreach (var r in Rows)
            r.SrNo = sr++;

        await InvokeAsync(StateHasChanged);
    }


