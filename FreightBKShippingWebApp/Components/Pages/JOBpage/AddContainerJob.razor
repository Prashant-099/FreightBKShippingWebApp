<Addcontainertransportpopup @ref="addPopup" OnSave="Loaddata" />

@code {
    private List<ReportData> ReportDataList { get; set; } = new();
    private int? SelectedReportId { get; set; } = 1;
    private async Task LoadReportList()
    {
        try
        {
            var allReports = await ReportDataService.GetAllAsync();

            ReportDataList = allReports
                .Where(r => string.Equals(r.DocType, "lr", StringComparison.OrdinalIgnoreCase))
                .ToList();

            if (ReportDataList.Any())
            {
                SelectedReportId = ReportDataList.First().ReportDataId;
            }
        }
        catch (Exception ex)
        {
            ToastService.Error($"Failed to load reports: {ex.Message}");
        }
    }

    Lr selectedExportRow;

    void ExportGrid_RowDoubleClick(GridRowClickEventArgs e)
    {
        // Get the clicked row’s key value
        var row = (Lr)e.Grid.GetDataItem(e.VisibleIndex);

        if (row != null)
        {
            // Open your popup with this row
            addPopup.ShowPopup(row, job);
        }
    }



    Addcontainertransportpopup addPopup;

    List<Lr> listofcontainer = new();
    public void AddNew()
