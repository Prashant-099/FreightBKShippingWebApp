        addPopup.ShowPopup(null, job);
    }

    public void Edit(Lr selected)
    {

        addPopup.ShowPopup(selected, job);
    }
    async Task RevertGridtransport_Click()
    {
        await Grid.CancelEditAsync();
        // await ClearUnsavedChangesAsync();
        InitializeInvoiceDetails();
    }

    async Task Loaddata()
    {
        if (job == null || job.JobId == 0)
            return;

        listofcontainer =
            await ContainerAddServices.GetByJobIdAsync(job.JobId);
    }

    // protected override async Task OnInitializedAsync()
