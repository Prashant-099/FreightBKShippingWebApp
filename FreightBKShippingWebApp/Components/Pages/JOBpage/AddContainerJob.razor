    DxGrid Grid;

    List<Lr> Rows = new();
    private Lr EditModel { get; set; } = new();
    private Dictionary<Lr, DataChange> UnsavedChanges { get; } = new();
    private bool BatchItemsEnabled => UnsavedChanges.Count > 0 || (Grid?.IsEditing() ?? false);
    record DataChange(DataChangeType Type, HashSet<string> ChangedFields);
    bool nonTransportExpanded = true;   // Non-Transport open by default
    bool detailsExpanded = false;
    enum DataChangeType { Modification, Addition, Delete }

    Lr SelectedRow;
    private int? nextSNo = 1;

    public async Task OpenPopup(Job selected)
    {
        job = selected;
        popupVisible = true;
        // nonTransportExpanded = true;
        // detailsExpanded = false;
        InitializeInvoiceDetails();

        await InvokeAsync(StateHasChanged);
    }


    void Grid_CustomizeElement(GridCustomizeElementEventArgs ea)
    {
       
    }

    void Grid_CustomizeEditModel(GridCustomizeEditModelEventArgs e)
    {
        EditModel = e.DataItem as Lr;
    }


    void Grid_EditModelSaving(GridEditModelSavingEventArgs e)
    {
        // var edited = (Lr)e.EditModel;
        // var original = Rows.First(x => x.SrNo == edited.SrNo);

        // Copy edited values back
        // original.LrDate = edited.LrDate;
        // original.LrVehicleId = edited.LrVehicleId;
        // original.LrFromLocationId = edited.LrFromLocationId;
        // original.LrToLocationId = edited.LrToLocationId;
        // original.LrGrossWt = edited.LrGrossWt;
        // original.LrLoadWt = edited.LrLoadWt;
        // original.LrUnloadWt = edited.LrUnloadWt;
        // original.LrRateBill = edited.LrRateBill;
        // original.LrNetFreightBill = edited.LrNetFreightBill;
        // original.LrPaymentType = edited.LrPaymentType;
        // original.LrRemarks = edited.LrRemarks;

        e.CopyChangesToDataItem();


        // e.Cancel = true; prevent auto replace
    }

    private async Task SaveNT_Click()
    {
        // Agar edit mode chal raha hai to pehle usko cancel karo
        if (Grid.IsEditing())
            await Grid.CancelEditAsync();

        // Filter rows that have any meaningful value filled
        var validRows = Rows.Where(r =>
            !string.IsNullOrWhiteSpace(r.LrContainer1) ||
            r.LrNtDate != null ||
            !string.IsNullOrWhiteSpace(r.LrNtRfidSeal) ||
            (r.LrNtQty > 0) ||
            !string.IsNullOrWhiteSpace(r.LrNtInvNo) ||
            (r.LrNtNetWt > 0) ||
            !string.IsNullOrWhiteSpace(r.LrNtUnit) ||
            !string.IsNullOrWhiteSpace(r.LrRemarks)
        ).ToList();

        // Agar koi valid row nahi hai to warning do
        if (!validRows.Any())
        {
            Console.WriteLine("No valid data to save.");
            return;
        }

        try
        {
            foreach (var row in validRows)
            {
                // Required/Default field values set karo (agar nahi set hai to)
                if (row.LrCompanyId == 0)
                    row.LrCompanyId = 1;

                if (row.LrAddedByUserId == 0)
                    row.LrAddedByUserId = 1;

                if (row.LrVoucherId == 0)
                    row.LrVoucherId = job.JobId;

                if (row.LrPartyAccountId == 0)
                    row.LrPartyAccountId = 1;

                if (row.LrSupplierAccountId == 0)
                    row.LrSupplierAccountId = 1;

                // Created/Updated timestamps
                if (row.LrId == 0)
                    row.LrCreated = DateTime.UtcNow;

                row.LrUpdated = DateTime.UtcNow;
            }

            // API call ya service call to save rows
            // await LrService.SaveAsync(validRows);

            Console.WriteLine($"Saved {validRows.Count} valid rows out of {Rows.Count} total.");

            // Optional: success message popup / toast
            // await ShowToast("Data saved successfully!");

            // Popup close if required
            // popupVisible = false;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error while saving: {ex.Message}");
            // Toast for error
            // await ShowToast("Error saving data.");
        }
    }


    private async Task New_Click()
    {
        if (Grid.IsEditing())
            await Grid.CancelEditAsync();

        int nextSrNo = Rows.Any() ? Rows.Max(x => x.SrNo) + 1 : 1;

        Rows.Add(new Lr { SrNo = nextSrNo });

        await InvokeAsync(StateHasChanged);
    }



    async Task Revert_Click()
    {
        await Grid.CancelEditAsync();
        // await ClearUnsavedChangesAsync();
        InitializeInvoiceDetails();
    }

    private void InitializeInvoiceDetails()
    {
        Rows = Enumerable.Range(1, 5)
            .Select(i => new Lr { SrNo = i })
            .ToList();
    }



    async Task DeleteDataItem(object dataItem)
    {
        var detail = (Lr)dataItem;
        Rows.Remove(detail);

        // Re-assign SrNo sequentially
        int i = 1;
        foreach (var row in Rows)
            row.SrNo = i++;

        nextSNo = i;

        await InvokeAsync(StateHasChanged);
    }

    // Payment type options
    List<string> PaymentTypes = new() { "To Pay", "Paid", "To be Billed" };

    // Updated Save_Click method with all new fields
    private async Task Save_Click()
    {
        if (Grid.IsEditing())
            await Grid.CancelEditAsync();

        // Filter rows that have meaningful data
        var validRows = Rows
            .Where(r => r.LrVehicleId > 0 ||
                       r.LrFromLocationId > 0 ||
                       r.LrToLocationId > 0 ||
                       r.LrDate.HasValue ||
                       r.LrNtDate.HasValue ||
                       (r.LrGrossWt ?? 0) > 0 ||
                       r.LrLoadWt > 0 ||
                       r.LrUnloadWt > 0 ||
                       r.LrRateBill > 0 ||
                       r.LrNetFreightBill > 0 ||
                       !string.IsNullOrWhiteSpace(r.LrPaymentType) ||
                       !string.IsNullOrWhiteSpace(r.LrRemarks) ||
                       !string.IsNullOrWhiteSpace(r.LrNoStr) ||
                       !string.IsNullOrWhiteSpace(r.LrContainer1) ||
                       !string.IsNullOrWhiteSpace(r.LrContainer2) ||
                       !string.IsNullOrWhiteSpace(r.LrNtSize) ||
                       !string.IsNullOrWhiteSpace(r.LrNtSealNo) ||
                       !string.IsNullOrWhiteSpace(r.LrNtInvNo) ||
                       !string.IsNullOrWhiteSpace(r.LrNtVehicleNo) ||
                       (r.LrNtQty ?? 0) > 0)
            .ToList();

        if (!validRows.Any())
        {
            Console.WriteLine("No data to save");
            return;
        }

        try
        {
            // Set required fields for valid rows
            foreach (var row in validRows)
            {
                if (row.LrCompanyId == 0) row.LrCompanyId = 1;
                if (row.LrAddedByUserId == 0) row.LrAddedByUserId = 1;
                if (row.LrVoucherId == 0) row.LrVoucherId = job.JobId;
                if (row.LrPartyAccountId == 0) row.LrPartyAccountId = 1;
                if (row.LrSupplierAccountId == 0) row.LrSupplierAccountId = 1;

                if (row.LrId == 0)
                {
                    row.LrCreated = DateTime.UtcNow;
                }
                row.LrUpdated = DateTime.UtcNow;
            }

            // await LrService.SaveAsync(validRows);
            Console.WriteLine($"Saved {validRows.Count} rows out of {Rows.Count} total rows");

        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving data: {ex.Message}");
        }
    }

    private async Task CancelDetails_Click()
    {
        // Reset to original values or clear
        EditModel = new Lr();

        // Optional: Show confirmation dialog before canceling
        // var result = await ShowConfirmDialog("Are you sure you want to cancel? All changes will be lost.");
        // if (result) EditModel = new Lr();

        await InvokeAsync(StateHasChanged);
    }

    private async Task ClearDetails_Click()
    {
        // Clear all form fields
        EditModel = new Lr();
        await InvokeAsync(StateHasChanged);

        Console.WriteLine("Form cleared");
    }

    private void OnNonTransportExpandedChanged(bool expanded)
    {
        nonTransportExpanded = expanded;
        if (expanded)
            detailsExpanded = false; // Close Details when Non-Transport opens
    }

    private void OnDetailsExpandedChanged(bool expanded)
    {
        detailsExpanded = expanded;
        if (expanded)
            nonTransportExpanded = false; // Close Non-Transport when Details opens
    }
}

