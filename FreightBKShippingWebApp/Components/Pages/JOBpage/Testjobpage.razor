        width: 185px;
    }
</style>

    <!-- Grid Component -->
<DxGrid TItem="Job"
        Data="@jobList"
        @ref="MyGrid"
        KeyFieldName="JobId"
        ShowSearchBox="true"
        ShowFilterRow="true"
        AllowSort="false"
        PageSize="100"
        PageSizeSelectorVisible="false"
        ShowGroupPanel="true"
        FilterMenuButtonDisplayMode="GridFilterMenuButtonDisplayMode.Always"
        FocusedRowEnabled="true"
        SelectionMode="GridSelectionMode.Multiple"
        SelectedDataItems="@SelectedJobs"
        SelectedDataItemsChanged="OnSelectedJobsChanged"
        ColumnResizeMode="GridColumnResizeMode.NextColumn"
        CssClass="grid-size"
        AllowSelectRowByClick="true">

    <ToolbarTemplate>
        <DxToolbar>
            <TitleTemplate Context="ctxjob">
                <div class="d-flex align-items-center">
                    <i class="bi bi-briefcase-fill me-2"></i>
                    <span class="fs-5"> Import Job</span>
                </div>
            </TitleTemplate>
            <Items>
                <DxToolbarItem Text="Add" IconCssClass="bi bi-plus-circle" Click="OnCreateNew" />
                <DxToolbarItem Text="Edit" IconCssClass="bi bi-pencil-square" Click="OnEdit" />
                <DxToolbarItem Text="Delete" IconCssClass="bi bi-trash" Click="OnDelete" />
                <DxToolbarItem Text="Import PDF" IconCssClass="bi bi-file-pdf-fill" Click="OnImportPDF" />
                <DxToolbarItem Text="Refresh" IconCssClass="bi bi-arrow-clockwise" Click="LoadJobsAsync" />
                <DxToolbarItem Context="cfdr"
                               Text="Print"
                               RenderStyleMode="ToolbarItemRenderStyleMode.Contained"
                               RenderStyle="ButtonRenderStyle.Secondary"
                               IconCssClass="bi bi-printer">
                    <Items>
                        @* <DxToolbarItem Text="Send WhatsApp" IconCssClass="bi bi-whatsapp" Click="@(async () => await DownloadReport(true))" /> *@
                        <DxToolbarItem Text="Download PDF" IconCssClass="bi bi-printer" Click="@(async () => await PrintReports(false))" />
                        <DxToolbarItem Text="Preview" IconCssClass="bi bi-printer" Click="@((_) => PreviewReport())"></DxToolbarItem>
                    </Items>
                </DxToolbarItem>
                <DxToolbarItem Alignment="ToolbarItemAlignment.Right"
                               RenderStyle="ButtonRenderStyle.Secondary"
                               IconCssClass="bi bi-gear-wide-connected"
                               Click="ShowLayoutPopup" />

            </Items>
        </DxToolbar>
    </ToolbarTemplate>

    <Columns>
        <DxGridSelectionColumn Width="30" FixedPosition="GridColumnFixedPosition.Left" />

        <DxGridCommandColumn CancelButtonVisible="false" Name="Action" Caption="Action"
                             DeleteButtonVisible="false"
                             EditButtonVisible="false"
                             SaveButtonVisible="false"
                             NewButtonVisible="false" Width="120">

            <CellDisplayTemplate Context="cellContext">
                  <div style="display: flex; align-items: center;">
                <DxButton RenderStyle="ButtonRenderStyle.Link"
                          IconCssClass="bi bi-file-earmark-diff-fill"
                          SizeMode="SizeMode.Medium"
                              Click="@(() => OpenAddContainerPopup((Job)cellContext.DataItem))" />

                    <DxButton RenderStyle="ButtonRenderStyle.Link"
                              IconCssClass="bi bi-three-dots"
                              SizeMode="SizeMode.Medium"
                              Click="@(e => ShowVoucherMenu(e, (Job)cellContext.DataItem))" />
                </div>
            </CellDisplayTemplate>
        </DxGridCommandColumn>

        <DxGridDataColumn FieldName="JobStatus" Caption="Status" TextAlignment="GridTextAlignment.Right" MinWidth="100"
                          Visible="@(layoutManager?.GetColumnVisibility("JobStatus") ?? true)"
                          Width="@(layoutManager?.GetColumnWidth("JobStatus") ?? "120px")">
            <CellDisplayTemplate Context="cellContext">
                @{
                    var statusId = (int?)cellContext.Value;
                    var statusText = statuslist.FirstOrDefault(s => s.StatusId == statusId)?.StatusName ?? "-";

                    // Normalize case
                    var normalized = statusText?.Trim().ToLower();

                    // Decide cell background color
                    var bgColor = normalized switch
                    {
                        "pending" => "lightcoral",
                        "complete" => "lightgreen",
                        "completed" => "lightgreen",
                        "cancel" => "orange",
                        "cancelled" => "orange",
                        _ => ""
                    };
                }

                <div style="width:100%; height:100%; background-color:@bgColor; display:flex; align-items:center; justify-content:center; font-weight:bold;">
                    @statusText
                </div>
                    </CellDisplayTemplate>

        </DxGridDataColumn>

        <DxGridDataColumn FieldName="BranchName"
                          Caption="Branch"
                          Width="@(layoutManager?.GetColumnWidth("BranchName") ?? "120px")"
                          Visible="@(layoutManager?.GetColumnVisibility("BranchName") ?? true)" />

        <DxGridDataColumn FieldName="JobNo"
                          Caption="Job No"
                          Width="@(layoutManager?.GetColumnWidth("JobNo") ?? "120px")"
                          Visible="@(layoutManager?.GetColumnVisibility("JobNo") ?? true)" />

        <DxGridDataColumn FieldName="JobDate"
                          Caption="Job Date"
                          DisplayFormat="dd/MM/yyyy"
                          Width="@(layoutManager?.GetColumnWidth("JobDate") ?? "130px")"
                          Visible="@(layoutManager?.GetColumnVisibility("JobDate") ?? true)" />

        <DxGridDataColumn FieldName="JobType"
                          Caption="Job Type"
                          Width="@(layoutManager?.GetColumnWidth("JobType") ?? "130px")"
                          Visible="@(layoutManager?.GetColumnVisibility("JobType") ?? true)" />

        <DxGridDataColumn FieldName="Partyname"
                          Caption="Importer"
                          Width="@(layoutManager?.GetColumnWidth("Partyname") ?? "330px")"
                          Visible="@(layoutManager?.GetColumnVisibility("Partyname") ?? true)" />

        <DxGridDataColumn FieldName="JobBlNo"
                          Caption="BE No"
                          Width="@(layoutManager?.GetColumnWidth("JobBlNo") ?? "90px")"
                          Visible="@(layoutManager?.GetColumnVisibility("JobBlNo") ?? true)" />

        <DxGridDataColumn FieldName="JobBlDate"
                          Caption="BE Date"
                          DisplayFormat="dd/MM/yyyy"
                          Width="@(layoutManager?.GetColumnWidth("JobBlDate") ?? "90px")"
                          Visible="@(layoutManager?.GetColumnVisibility("JobBlDate") ?? true)" />

        <DxGridDataColumn FieldName="VesselName"
                          Caption="Vessel"
                          Width="@(layoutManager?.GetColumnWidth("VesselName") ?? "250px")"
                          Visible="@(layoutManager?.GetColumnVisibility("VesselName") ?? true)" />

        <DxGridDataColumn FieldName="Job20Ft"
                          Caption="20ft Count"
                          Width="@(layoutManager?.GetColumnWidth("Job20Ft") ?? "100px")"
                          Visible="@(layoutManager?.GetColumnVisibility("Job20Ft") ?? true)" />

        <DxGridDataColumn FieldName="Job40Ft"
                          Caption="40ft Count"
                          Width="@(layoutManager?.GetColumnWidth("Job40Ft") ?? "100px")"
                          Visible="@(layoutManager?.GetColumnVisibility("Job40Ft") ?? true)" />

        <DxGridDataColumn FieldName="PolName"
                          Caption="POL"
                          Width="@(layoutManager?.GetColumnWidth("PolName") ?? "210px")"
                          Visible="@(layoutManager?.GetColumnVisibility("PolName") ?? true)" />

        <DxGridDataColumn FieldName="PodName"
                          Caption="POD"
                          Width="@(layoutManager?.GetColumnWidth("PodName") ?? "210px")"
                          Visible="@(layoutManager?.GetColumnVisibility("PodName") ?? true)" />

        <DxGridDataColumn FieldName="JobGrossWt"
                          Caption="Gross Weight"
                          Width="@(layoutManager?.GetColumnWidth("JobGrossWt") ?? "100px")"
                          Visible="@(layoutManager?.GetColumnVisibility("JobGrossWt") ?? true)" />

        <DxGridDataColumn FieldName="JobVolume"
                          Caption="Volume / CBM"
                          Width="@(layoutManager?.GetColumnWidth("JobVolume") ?? "100px")"
                          Visible="@(layoutManager?.GetColumnVisibility("JobVolume") ?? true)" />

        <DxGridDataColumn FieldName="JobQty"
                          Caption="Quantity"
                          Width="@(layoutManager?.GetColumnWidth("JobQty") ?? "100px")"
                          Visible="@(layoutManager?.GetColumnVisibility("JobQty") ?? true)" />

        <DxGridDataColumn FieldName="JobRemarks"
                          Caption="Remarks"
                          Width="@(layoutManager?.GetColumnWidth("JobRemarks") ?? "220px")"
                          Visible="@(layoutManager?.GetColumnVisibility("JobRemarks") ?? true)" />


    </Columns>
</DxGrid>

      
<JobAddEditPage @ref="popup" OnSaved="LoadJobsAsync" JobType="@JobType" />

<ConfirmationDialog />

<!-- ✅ REUSABLE PDF IMPORT MODAL -->
<PdfImportModal ShowModal="@showPdfImportDialog"
                OnModalClose="ClosePdfDialog"
                OnDataExtracted="OnPdfDataExtracted"
                JobType="@JobType"
                ModalTitle="Import Jobs from PDF"
                ProcessButtonText="Import & Create Job"
                HeaderClass="bg-primary"
                ButtonClass="btn-primary"
                SpinnerClass="text-primary"
                SuccessCardClass="border-success" />

<AddContainerJob @ref="addContainerJob"></AddContainerJob>

<FreightBKShippingWebApp.Components.Pages.TestPage.BillAddEditPage2 @ref="billAddEditPage" />

<FreightBKShippingWebApp.Components.Pages.PurchasePage.PurchaseAddEditPage @ref="purchasaddedit"></FreightBKShippingWebApp.Components.Pages.PurchasePage.PurchaseAddEditPage>

<DxContextMenu @ref="voucherMenu" ItemClick="@OnMenuItemClick">
    <Items>
        @foreach (var voucher in VoucherList)
        {
            <DxContextMenuItem Text="@voucher.VoucherName"
                               Name="@voucher.VoucherId.ToString()" />
        }
    </Items>
</DxContextMenu>

<GridLayoutpPopup @ref="layoutManager"
                  VoucherType="ImportJob"
                  Columns="@allColumns"
                  OnLayoutChanged="HandleLayoutChanged" />

@code {
    private void InitializeColumns()
    {
        allColumns = new List<GridColumnLayout>
        {
             new(){ FieldName = "JobStatus", Caption = "Status", Visible = true, Width = 120, DisplayIndex = 0 },
             new(){ FieldName = "BranchName", Caption = "Branch", Visible = true, Width = 120, DisplayIndex = 1},
    new() { FieldName = "JobNo", Caption = "Job No", Visible = true, Width = 120, DisplayIndex = 2 },
        new() { FieldName = "JobDate", Caption = "Job Date", Visible = true, Width = 130, DisplayIndex = 3 },
        new() { FieldName = "JobType", Caption = "Job Type", Visible = true, Width = 130, DisplayIndex = 4},
        new() { FieldName = "Partyname", Caption = "Importer", Visible = true, Width = 330, DisplayIndex = 5 },
        new() { FieldName = "JobBlNo", Caption = "BE No", Visible = true, Width = 90, DisplayIndex = 6 },
        new() { FieldName = "JobBlDate", Caption = "BE Date", Visible = true, Width = 90, DisplayIndex = 7 },
        new() { FieldName = "VesselName", Caption = "Vessel", Visible = true, Width = 250, DisplayIndex = 8 },
        new() { FieldName = "Job20Ft", Caption = "20ft Count", Visible = true, Width = 100, DisplayIndex = 9 },
        new() { FieldName = "Job40Ft", Caption = "40ft Count", Visible = true, Width = 100, DisplayIndex = 10},
         new() { FieldName = "PolName", Caption = "POL", Visible = true, Width = 210, DisplayIndex = 11 },
          new() { FieldName = "PodName", Caption = "POD", Visible = true, Width = 210, DisplayIndex = 12 },
           new() { FieldName = "JobGrossWt", Caption = "Gross Weight", Visible = true, Width = 100, DisplayIndex = 13 },
            new() { FieldName = "JobVolume", Caption = "Volume / CBM", Visible = true, Width = 100, DisplayIndex = 14 },
             new() { FieldName = "JobQty", Caption = "Quantity", Visible = true, Width = 100, DisplayIndex = 15 },
              new() { FieldName = "JobRemarks", Caption = "Remarks", Visible = true, Width = 220, DisplayIndex = 16 }
    };


    }
    // Grid Layout Manager Reference
    private GridLayoutpPopup? layoutManager;
    private List<GridColumnLayout> allColumns = [];
    private async void ShowLayoutPopup()
    {
        await InvokeAsync(() =>
        {
            layoutManager?.ShowPopup();
        });
    }
    private async Task HandleLayoutChanged(List<GridColumnLayout> updatedLayout)
    {
        allColumns = updatedLayout;
        // Force the grid to re-render with new layout
        await InvokeAsync(StateHasChanged);

    }

    DxContextMenu voucherMenu;
    async Task ShowVoucherMenu(MouseEventArgs e, Job job)
    {
        selectedJob = job; // store clicked job
        await voucherMenu.ShowAsync(e); // show at mouse coords
    }
    private Job selectedJob;

    private List<Voucher> VoucherList = new();
    // void OnMenuItemClick(ContextMenuItemClickEventArgs args)
    // {

    //     var id = int.Parse(args.ItemInfo.Name);
    //     var selectedVoucher = VoucherList.FirstOrDefault(v => v.VoucherId == id);

    //     if (selectedVoucher != null)
    //     {
    //         OpenBilleditPopup(selectedJob, selectedVoucher);
    //     }
    // }

    void OnMenuItemClick(ContextMenuItemClickEventArgs args)
    {
        var id = int.Parse(args.ItemInfo.Name);
        var selectedVoucher = VoucherList.FirstOrDefault(v => v.VoucherId == id);

        if (selectedVoucher == null)
            return;

        // 👇 YAHI MAIN LOGIC HAI
        if (selectedVoucher.VoucherGroup
                .Equals("PURCHASE", StringComparison.OrdinalIgnoreCase) ||
    selectedVoucher.VoucherGroup.Equals("DEBIT NOTE", StringComparison.OrdinalIgnoreCase))
        {
            // 👉 Purchase hai → Purchase popup
            Openpurchaseadddedit(selectedJob, selectedVoucher);
        }
        else
        {
            // 👉 baki sab → normal bill popup
            OpenBilleditPopup(selectedJob, selectedVoucher);
        }
    }

    //===================================================================================

    PurchaseAddEditPage purchasaddedit;
    async Task Openpurchaseadddedit(Job job, Voucher voucher)
    {
        var bill = new Bill
        {
            BillJobId = job.JobId,
            BillJobNo = job.JobNo,
            BillJobType = job.JobType,
            BillPartyId = job.JobPartyId ?? 0,
            BillBranchId = job.JobBranchId ?? 0,
            BillVoucherId = voucher.VoucherId
        };

        purchasaddedit.Show(bill);
    }

    //===================================================================================
    BillAddEditPage2 billAddEditPage;
    async Task OpenBilleditPopup(Job job, Voucher voucher)
    {
        var bill = new Bill
        {
            BillJobId = job.JobId,
            BillJobNo = job.JobNo,
            BillJobType = job.JobType,
            BillPartyId = job.JobPartyId ?? 0,
            BillBranchId = job.JobBranchId ?? 0,
            BillVoucherId = voucher.VoucherId
        };

        billAddEditPage.Show(bill);
    }

    AddContainerJob addContainerJob;
    Job job = new();

    void OpenAddContainerPopup(Job selectedJob)
    {
        job = selectedJob;
        addContainerJob?.OpenPopup(selectedJob, PopupOpenMode.Import);
    }

    // ./
    private List<Job> jobList = new();
    // private List<Job> SelectedJobs = new();
    private IReadOnlyList<object> SelectedJobs { get; set; } = new List<object>();

    private IGrid MyGrid { get; set; }
    private JobAddEditPage popup { get; set; }
    private string JobType { get; set; } = "IMPORT";
    private int? CurrentYearId { get; set; }

    private bool showPdfImportDialog = false;



    protected override async Task OnInitializedAsync()
    {
        try
        {
            InitializeColumns();
            await LoadJobsAsync();


            var voucherTask = await VoucherService.GetAllAsync(); // ya jo bhi tumhara method hai

            VoucherList = voucherTask.Where(v =>
                !string.IsNullOrWhiteSpace(v.VoucherGroup) &&
                (
                    v.VoucherGroup.Trim().Equals("SALES", StringComparison.OrdinalIgnoreCase) ||
                    v.VoucherGroup.Trim().Equals("CREDIT NOTE", StringComparison.OrdinalIgnoreCase) ||
                    v.VoucherGroup.Trim().Equals("DEBIT NOTE", StringComparison.OrdinalIgnoreCase) ||
                    v.VoucherGroup.Trim().Equals("PURCHASE", StringComparison.OrdinalIgnoreCase)
                ))
                .ToList();


        }
        catch (Exception ex)
        {
            ToastService.Error("Failed to load jobs");
        }
    }

    List<Status> statuslist;
    private async Task LoadJobsAsync()
    {
        LoadingService.Show();
        try
        {
            CurrentYearId = YearStatechangeService.SelectedYearId;
            statuslist =await StatusService.GetAllAsync();


            var allJobs = await JobService.GetAllAsync();
            jobList = allJobs.Where(j => j.JobType == JobType &&
        j.JobYearId == YearStatechangeService.SelectedYearId.ToString()).ToList();
        }
        catch (Exception ex)
        {
            ToastService.Error("Failed to load jobs");
        }
        finally
        {
            LoadingService.Hide();
        }
    }

    // ==================== PDF MODAL HANDLERS ====================

    private async Task OnImportPDF()
    {
        showPdfImportDialog = true;
        await Task.CompletedTask;
    }

    private async Task ClosePdfDialog()
    {
        showPdfImportDialog = false;
        await Task.CompletedTask;
    }

    /// <summary>
    /// ✅ Called when PDF data is extracted and user clicks "Import & Create Job"
    /// </summary>
    private async Task OnPdfDataExtracted(Dictionary<string, string> extractedData)
    {
        try
        {
            LoadingService.Show();

            // Build job from extracted data
            var job = await JobBuilder.BuildJobFromExtractedDataAsync(
                extractedData,
                JobType,
                CurrentYearId);

            if (job == null)
            {
                ToastService.Error("Failed to build job from extracted data");
                return;
            }

            // Save job
            var created = await JobService.CreateAsync(job);

            if (created.Success)
            {
                ToastService.Success("Job imported successfully!");
                await LoadJobsAsync();
            }
            else
            {
                ToastService.Error("Failed to save job");
            }
        }
        catch (Exception ex)
        {
            ToastService.Error($"Processing failed: {ex.Message}");
        }
        finally
        {
            LoadingService.Hide();
        }
    }

    // ==================== GRID HANDLERS ====================
    private async Task OnSelectedJobsChanged(IReadOnlyList<object> jobs)
    {
        SelectedJobs = jobs ?? new List<object>();
        await InvokeAsync(StateHasChanged);
    }
    // ✅ FIXED: Reliable clear selection method
    private async Task ClearSelectionManual()
    {
        try
        {
            if (MyGrid != null)
            {
                MyGrid.ClearSelection(); // ✅ Synchronous method
            }
            SelectedJobs = new List<Job>();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Clear selection error: {ex.Message}");
        }
    }

    // ✅ FIXED: Auto-clear after operations
    private async Task ClearSelection()
    {
        await Task.Delay(100); // Small delay for UI update
        await ClearSelectionManual();
    }

    private void OnCreateNew(ToolbarItemClickEventArgs e) => popup.Show(new Job());

    private async Task OnEdit(ToolbarItemClickEventArgs e)
    {
        var job = MyGrid.GetFocusedDataItem() as Job;
        if (job != null)
        {
            var freshData = jobList
               .FirstOrDefault(x => x.JobId == job.JobId);

            if (freshData != null)
                popup.Show(freshData);
        }
        else ToastService.Warning("Please select a job to edit.");
        await ClearSelection();
    }

    private async Task OnDelete(ToolbarItemClickEventArgs e)
    {
        if (!SelectedJobs.Any())
        {
            ToastService.Warning("Please select at least one job to delete.");
            return;
        }
        var selectedList = SelectedJobs.Cast<Job>().ToList();

        var confirm = await ConfirmDialogService.ShowAsync($"Are you sure you want to delete {SelectedJobs.Count} job(s)?");
        if (!confirm)
        {
            await ClearSelection(); // ✅ Clear on cancel
            return;
        }

       
        try
        {
            LoadingService.Show("Deleting...");
            int successCount = 0, failCount = 0;
            List<string> errorMessages = new();
            foreach (var job in selectedList)
            {
                var result = await JobService.DeleteAsync(job.JobId);
                if (result.Success)
                {
                    AuditLogService.NotifyAuditChanged();

                    successCount++;
                }
                else
                {
                    failCount++;
                    errorMessages.Add(result.Error);   // 🎉 show real API message
                }
            }
            if (successCount > 0) ToastService.Success($"{successCount} job(s) Deleted Successfully.");
            if (failCount > 0) ToastService.Error($"{failCount} job(s) Failed To Delete.\nDetails: {string.Join("\n", errorMessages.Distinct())}");
            await LoadJobsAsync();
        }
        finally
        {

            LoadingService.Hide(); 
            await ClearSelection();
        }
    }

    private async Task PrintReports(bool sendViaWhatsapp)
    {
        if (!SelectedJobs.Any())
        {
            ToastService.Warning("Please select at least one job.");
            return;
        }

        var Jobs = SelectedJobs.Cast<Job>().ToList();
        var jobNumbers = Jobs
          .Select(b => b.JobNo) // Make sure this property exists
          .Where(x => !string.IsNullOrWhiteSpace(x))
          .Select(x => x.Replace("/", "-").Replace("\\", "-")) // sanitize filename
          .ToList();

        var fileName = jobNumbers.Count == 1
         ? $"{jobNumbers.First()}.pdf"
         : $"Job_{DateTime.Now:yyyyMMddHHmmss}.pdf";

        await ReportManager.DownloadAsync<Job, JobreportDto>(
            SelectedJobs.Cast<Job>().ToList(),

            // Get ReportId from Job
            job => Task.FromResult(job.JobReportId ?? 0),

            // Get DTO
            job => JobService.GetJobWithContainerAsync(job.JobId),
            job => "Job",
           fileName
        );

        await ClearSelection();
    }

    private async Task PreviewReport()
    {
        if (!SelectedJobs.Any())
        {
            ToastService.Warning("Please select at least one certificate.");
            return;
        }
        var jobsNumbers = SelectedJobs
           .Cast<Job>()
           .Select(b => b.JobNo)   // Make sure BillNumber property exists
           .Where(x => !string.IsNullOrWhiteSpace(x))
           .Select(x => x.Replace("/", "-").Replace("\\", "-")) // sanitize filename
           .ToList();

        // Dynamic file name
        var fileName = jobsNumbers.Count == 1
            ? $"{jobsNumbers.First()}.pdf"
            : $"Jobs_{DateTime.Now:yyyyMMddHHmmss}.pdf";
        await ReportManager.PreviewAsync<Job, JobreportDto>(
            SelectedJobs.Cast<Job>().ToList(),

            c => Task.FromResult(c.JobReportId ?? 0),

            c => JobService.GetJobWithContainerAsync(c.JobId),
            c => "Job", 
            fileName

        );

        await ClearSelection();
    }


}