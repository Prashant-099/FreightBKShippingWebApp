    BillAddEditPage2 billAddEditPage;

    async Task OpenBilleditPopup(Job job, Voucher voucher)
    {
        var bill = new Bill
        {
            BillJobId = job.JobId,
            BillJobNo = job.JobNo,
            BillJobType = job.JobType,
