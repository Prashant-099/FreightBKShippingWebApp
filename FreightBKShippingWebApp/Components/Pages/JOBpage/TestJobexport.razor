    // ./
    DxGrid MyGrid;
    private List<Job> jobList = new();
    // private List<Job> SelectedJobs = new();
    private IReadOnlyList<object> SelectedJobs { get; set; } = new List<object>();

    private JobAddEditPage popup;
    private string JobType = "EXPORT";
    private int? CurrentYearId { get; set; }

    private bool showPdfImportDialog = false;

    // Grid Layout Management Variables
    private List<GridLayoutDto> availableLayouts = [];
    private int? selectedLayoutId;
    private bool showLayoutDialog = false;
    private string newLayoutName = "";
    private string dialogTitle = "";
    private bool isEditMode = false;
    private bool isDefaultLayout = false;
    private const string VOUCHER_TYPE = "ExportJob";

    // All possible columns
    private List<GridColumnLayout> allColumns = [];
    private List<GridColumnLayout> currentLayout = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            CurrentYearId = YearStatechangeService.SelectedYearId;
            await LoadJobsAsync();
            InitializeColumns();
            await LoadAvailableLayouts();
            await LoadDefaultLayout();

            var voucherTask = await VoucherService.GetAllAsync(); // ya jo bhi tumhara method hai

            VoucherList = voucherTask.Where(v =>
                !string.IsNullOrWhiteSpace(v.VoucherGroup) &&
                (
                    v.VoucherGroup.Trim().Equals("SALES", StringComparison.OrdinalIgnoreCase) ||
                    v.VoucherGroup.Trim().Equals("CREDIT NOTE", StringComparison.OrdinalIgnoreCase) ||
                    v.VoucherGroup.Trim().Equals("DEBIT NOTE", StringComparison.OrdinalIgnoreCase) ||
                    v.VoucherGroup.Trim().Equals("PURCHASE", StringComparison.OrdinalIgnoreCase)
                ))
                .ToList();

        }
        catch (Exception ex)
        {
            ToastService.Error("Failed to load export jobs");
        }
    }
    private void InitializeColumns()
    {
        allColumns = new List<GridColumnLayout>
        {
             new(){ FieldName = "JobStatus", Caption = "Status", Visible = true, Width = 120, DisplayIndex = 0 },
             new(){ FieldName = "BranchName", Caption = "Branch", Visible = true, Width = 120, DisplayIndex = 1},
    new() { FieldName = "JobNo", Caption = "Job No", Visible = true, Width = 120, DisplayIndex = 2 },
        new() { FieldName = "JobDate", Caption = "Job Date", Visible = true, Width = 130, DisplayIndex = 3 },
        new() { FieldName = "JobType", Caption = "Job Type", Visible = true, Width = 130, DisplayIndex = 4},
        new() { FieldName = "Partyname", Caption = "Exporter", Visible = true, Width = 130, DisplayIndex = 5 },
        new() { FieldName = "JobBlNo", Caption = "B/L No", Visible = true, Width = 150, DisplayIndex = 6 },
        new() { FieldName = "JobBlDate", Caption = "B/L Date", Visible = true, Width = 130, DisplayIndex = 7 },
        new() { FieldName = "VesselName", Caption = "Vessel", Visible = true, Width = 160, DisplayIndex = 8 },
        new() { FieldName = "Job20Ft", Caption = "20ft Count", Visible = true, Width = 100, DisplayIndex = 9 },
        new() { FieldName = "Job40Ft", Caption = "40ft Count", Visible = true, Width = 100, DisplayIndex = 10},
         new() { FieldName = "PolName", Caption = "POL", Visible = true, Width = 100, DisplayIndex = 11 },
          new() { FieldName = "PodName", Caption = "POD", Visible = true, Width = 100, DisplayIndex = 12 },
           new() { FieldName = "JobGrossWt", Caption = "Gross Weight", Visible = true, Width = 100, DisplayIndex = 13 },
            new() { FieldName = "JobVolume", Caption = "Volume / CBM", Visible = true, Width = 100, DisplayIndex = 14 },
             new() { FieldName = "JobQty", Caption = "Quantity", Visible = true, Width = 100, DisplayIndex = 15 },
              new() { FieldName = "Job20Ft", Caption = "Remarks", Visible = true, Width = 100, DisplayIndex = 16 }
    };
        currentLayout = allColumns.Select(c => new GridColumnLayout
        {
            FieldName = c.FieldName,
            Caption = c.Caption,
            Visible = c.Visible,
            Width = c.Width,
            DisplayIndex = c.DisplayIndex
        }).ToList();
    }

    private int ParseWidth(string width)
    {
        if (string.IsNullOrEmpty(width))
            return 100;

        width = width.Replace("px", "").Trim();

        if (int.TryParse(width, out int result))
            return result;

        return 100;
    }

    private string GetColumnWidth(string fieldName)
    {
        if (currentLayout == null || !currentLayout.Any())
        {
            var defaultCol = allColumns.FirstOrDefault(x => x.FieldName == fieldName);
            return $"{defaultCol?.Width ?? 100}px";
        }

        var col = currentLayout.FirstOrDefault(x => x.FieldName == fieldName);
        return $"{col?.Width ?? 100}px";
    }

    private bool GetColumnVisibility(string fieldName)
    {
        if (currentLayout == null || !currentLayout.Any())
        {
            return true;
        }

        var col = currentLayout.FirstOrDefault(x => x.FieldName == fieldName);
        return col?.Visible ?? true;
    }

