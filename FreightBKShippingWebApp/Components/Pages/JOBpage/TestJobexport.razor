    // ./
    DxGrid MyGrid;
    private List<Job> jobList = new();
    // private List<Job> SelectedJobs = new();
    private IReadOnlyList<object> SelectedJobs { get; set; } = new List<object>();

    private JobAddEditPage popup;
    private string JobType = "EXPORT";
    private int? CurrentYearId { get; set; }

    private bool showPdfImportDialog = false;

 

    protected override async Task OnInitializedAsync()
    {
        try
        {
            CurrentYearId = YearStatechangeService.SelectedYearId;
            await LoadJobsAsync();
            InitializeColumns();
           

            var voucherTask = await VoucherService.GetAllAsync(); // ya jo bhi tumhara method hai

            VoucherList = voucherTask.Where(v =>
                !string.IsNullOrWhiteSpace(v.VoucherGroup) &&
                (
                    v.VoucherGroup.Trim().Equals("SALES", StringComparison.OrdinalIgnoreCase) ||
                    v.VoucherGroup.Trim().Equals("CREDIT NOTE", StringComparison.OrdinalIgnoreCase) ||
                    v.VoucherGroup.Trim().Equals("DEBIT NOTE", StringComparison.OrdinalIgnoreCase) ||
                    v.VoucherGroup.Trim().Equals("PURCHASE", StringComparison.OrdinalIgnoreCase)
                ))
                .ToList();

        }
        catch (Exception ex)
        {
            ToastService.Error("Failed to load export jobs");
        }
    }
    

    private int ParseWidth(string width)
    {
        if (string.IsNullOrEmpty(width))
            return 100;

        width = width.Replace("px", "").Trim();

        if (int.TryParse(width, out int result))
            return result;

        return 100;
    }

  

    List<Status> statuslist;

    private async Task LoadJobsAsync()
    {
       
        try
        { LoadingService.Show();
            var allJobs = await JobService.GetAllAsync();
            statuslist = await StatusService.GetAllAsync();

            jobList = allJobs
                .Where(j => j.JobType != null && j.JobType.Equals(JobType, StringComparison.OrdinalIgnoreCase) &&
        j.JobYearId == YearStatechangeService.SelectedYearId.ToString())
                .ToList();
        }
        catch (Exception ex)
        {
            ToastService.Error("Failed to load export jobs");
        }
        finally
        {
            LoadingService.Hide();
        }
    }

    // ==================== PDF MODAL HANDLERS ====================

    private async Task OnImportPDF()
    {
        showPdfImportDialog = true;
        await Task.CompletedTask;
    }

    private async Task ClosePdfDialog()
    {
        showPdfImportDialog = false;
        await Task.CompletedTask;
    }

    /// <summary>
    /// ✅ Called when PDF data is extracted and user clicks "Import & Create Export Job"
    /// 
    /// Flow:
    /// 1. ExportPdfExtractorService extracts 72 fields from PDF
    /// 2. ExportJobBuilderService builds Job object from extracted data
    /// 3. Job is saved to database
    /// </summary>
    private async Task OnPdfDataExtracted(Dictionary<string, string> extractedData)
    {
        try
        {
            LoadingService.Show();

            // ==================== STEP 1: EXTRACT PDF DATA ====================
            // ExportPdfExtractorService already extracted the data in PdfImportModal
            // extractedData contains all 72 fields
            

            // ==================== STEP 2: BUILD JOB FROM EXTRACTED DATA ====================
            // Use ExportJobBuilderService to map all extracted fields to Job model
            var job = await ExportJobBuilder.BuildExportJobAsync(
                extractedData,
                CurrentYearId);

            if (job == null)
            {
                ToastService.Error("Failed to build export job from extracted data");
                return;
            }


            // ==================== STEP 3: SAVE JOB TO DATABASE ====================
            var created = await JobService.CreateAsync(job);

            if (created.Success)
            {
                ToastService.Success($"✅ Export job '{job.JobNo}' created successfully!");
                
                // Refresh grid
                await LoadJobsAsync();
                
                // Close modal
                showPdfImportDialog = false;
            }
            else
            {
                ToastService.Error("Failed to save export job to database");
            }
        }
        catch (Exception ex)
        {
            ToastService.Error($"Processing failed: {ex.Message}");
        }
        finally
        {
            LoadingService.Hide();
        }
    }

    // ==================== GRID HANDLERS ====================

    private async Task OnSelectedJobsChanged(IReadOnlyList<object> jobs)
    {
        SelectedJobs = jobs ?? new List<object>();
        await InvokeAsync(StateHasChanged);
    }
    // ✅ FIXED: Reliable clear selection method
    private async Task ClearSelectionManual()
    {
        try
        {
            if (MyGrid != null)
            {
                MyGrid.ClearSelection(); // ✅ Synchronous method
            }
            SelectedJobs = new List<Job>();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Clear selection error: {ex.Message}");
        }
    }

    // ✅ FIXED: Auto-clear after operations
    private async Task ClearSelection()
    {
        await Task.Delay(100); // Small delay for UI update
        await ClearSelectionManual();
    }

    private void OnCreateNew(ToolbarItemClickEventArgs e)
    {
        popup.Show(new Job());
    }

    private async Task OnEdit(ToolbarItemClickEventArgs e)
    {
        var job = MyGrid.GetFocusedDataItem() as Job;
        if (job != null)
            popup.Show(job);
        else
            ToastService.Warning("Please select a job to edit.");
        await ClearSelection();
    }

    private async Task OnDelete(ToolbarItemClickEventArgs e)
    {
        if (SelectedJobs == null || SelectedJobs.Count == 0)
        {
            ToastService.Warning("Please select at least one job to delete.");
            return;
        }
        var selectedList = SelectedJobs.Cast<Job>().ToList();

        var confirm = await ConfirmDialogService.ShowAsync(
            $"Are you sure you want to delete {SelectedJobs.Count} selected job(s)?");

        if (!confirm)
        {
            await ClearSelection(); // ✅ Clear on cancel
            return;
        }
        try
        {
            LoadingService.Show("Deleting...");
            int successCount = 0, failCount = 0;

                foreach (var job in selectedList)
                {
                var result = await JobService.DeleteAsync(job.JobId);
              if (result.Success)
                    {
                        successCount++;
                    }
                    else
                    {
                        failCount++;
                        ToastService.Error(result.Error);   // 🎉 show real API message
                    }
                }
            if (successCount > 0) ToastService.Success($"{successCount} job(s) Deleted Successfully.");
            // if (failCount > 0) ToastService.Error($"{failCount} job(s) Failed To Delete.");
                await LoadJobsAsync();
            }
            finally
            {
                LoadingService.Hide();
            await ClearSelection();
            }
        }



    private async Task PrintReports(bool sendViaWhatsapp)
    {
        if (!SelectedJobs.Any())
        {
            ToastService.Warning("Please select at least one job.");
            return;
        }
        var Jobs = SelectedJobs.Cast<Job>().ToList();
        var jobNumbers = Jobs
          .Select(b => b.JobNo) // Make sure this property exists
          .Where(x => !string.IsNullOrWhiteSpace(x))
          .Select(x => x.Replace("/", "-").Replace("\\", "-")) // sanitize filename
          .ToList();

        var fileName = jobNumbers.Count == 1
         ? $"{jobNumbers.First()}.pdf"
         : $"Job_{DateTime.Now:yyyyMMddHHmmss}.pdf";
        await ReportManager.DownloadAsync<Job, JobreportDto>(
            SelectedJobs.Cast<Job>().ToList(),

            // Get ReportId from Job
            job => Task.FromResult(job.JobReportId ?? 0),

            // Get DTO
            job => JobService.GetJobWithContainerAsync(job.JobId), job => "Job", fileName);

        await ClearSelection();
    }

    private async Task PreviewReport()
    {
        if (!SelectedJobs.Any())
        {
            ToastService.Warning("Please select at least one certificate.");
            return;
        }
        var jobsNumbers = SelectedJobs
         .Cast<Job>()
         .Select(b => b.JobNo)   // Make sure BillNumber property exists
         .Where(x => !string.IsNullOrWhiteSpace(x))
         .Select(x => x.Replace("/", "-").Replace("\\", "-")) // sanitize filename
         .ToList();

        // Dynamic file name
        var fileName = jobsNumbers.Count == 1
            ? $"{jobsNumbers.First()}.pdf"
            : $"Jobs_{DateTime.Now:yyyyMMddHHmmss}.pdf";
        await ReportManager.PreviewAsync<Job, JobreportDto>(
            SelectedJobs.Cast<Job>().ToList(),

            c => Task.FromResult(c.JobReportId ?? 0),

            c => JobService.GetJobWithContainerAsync(c.JobId),
            c => "Job",
            fileName

        );

        await ClearSelection();
    }


    }
