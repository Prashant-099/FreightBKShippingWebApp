        // ==================== REMARKS & NOTES ====================
        if (d.TryGetValue("Remarks", out var remarks))
            j.JobRemarks = CleanValue(remarks);

        if (d.TryGetValue("CHA Name", out var chaText))
        {
            var chaId = await GetOrCreateChaIdAsync(CleanValue(chaText));
            if (chaId.HasValue)
                j.JobChaId = chaId.Value;
        }

        return j;

    }

    private async Task SaveExtractedJobs()
    {
        if (!extractedPdfData.Any())
        {
            ToastService.Warning("Nothing to import.");
            return;
        }

        LoadingService.Show();
        try
        {
            var job = await BuildJobFromExtractedDataAsync(extractedPdfData);
            await JobService.CreateAsync(job);
            ToastService.Success("Job imported successfully!");
            await LoadJobsAsync();
            ClosePdfDialog();
        }
        catch (Exception ex)
        {
            ToastService.Error($"Import failed: {ex.Message}");
        }
        finally { LoadingService.Hide(); }
    }

    private string GetMappingInfo(string pdfField) => pdfField switch
    {
        "Job No" => "→ JobNo",
        "CHA Name" => "→ JobChaId",
        "Importer Name" => "→ JobPartyId",
        "Supplier Name" => "→ JobSupplierId",
        "Container Numbers" => "→ Containers",
        _ => "→ Mapped"
    };

    private string GetFieldCategory(string fieldName) => fieldName switch
    {
        "Job No" or "Job Date" => "Basic Info",
        "MBL/MAWB" or "HBL/HAWB" => "B/L Info",
        "Gross Weight" or "No of Pkgs" => "Weight/Qty",
        "Port Origin" or "Port Shipment" => "Locations",
        "Importer Name" or "CHA Name" or "Supplier Name" => "Parties",
        "Container Numbers" or "Count 20 Ft" or "Count 40 Ft" => "Containers",
        _ => "Other"
    };

    private string GetRowClass(string fieldName) => GetFieldCategory(fieldName) switch
    {
        "Parties" => "table-warning",
        "Containers" => "table-info",
        "Basic Info" => "table-success",
        _ => ""
    };

    private int GetMappedFieldsCount() => extractedPdfData.Count(x => !GetMappingInfo(x.Key).Contains("Mapped"));
    private int GetPartyCount() => extractedPdfData.Count(x => GetFieldCategory(x.Key) == "Parties");
    private int GetContainerCount()
    {
        if (extractedPdfData.TryGetValue("Container Numbers", out var containers))
            return containers.Split(new[] { ',', ';', ' ' }, StringSplitOptions.RemoveEmptyEntries).Length;
        return 0;
    }

    private async Task CopyToClipboard(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return;
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);
        ToastService.Info("Copied!");
    }

    private string? CleanValue(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return null;

        var v = value;

        // Remove control chars and normalize
        v = v.Replace("\r", "")
             .Replace("\n", "")
             .Replace("\u000C", "")
             .Replace("\u000B", "")
             .Replace("–", "-")
             .Replace("—", "-")
             .Trim();

        // Collapse multiple spaces
        v = Regex.Replace(v, @"\s+", " ");

        // Remove very long dash sequences
        v = Regex.Replace(v, @"-{3,}", "-");

        // Remove trailing/leading dashes
        v = v.Trim('-', ' ');

        // If only dashes or underscores
        if (Regex.IsMatch(v, @"^[-_]+$")) return null;

        // ⚡ Handle cases like: "AS PER BL ---- INVOICE DETAILS"
        if (Regex.IsMatch(v, @"-{2,}") && Regex.IsMatch(v, @"INVOICE|DETAIL|NUMBER|TOTAL", RegexOptions.IgnoreCase))
        {
            // keep only first part before long dashes
            v = Regex.Replace(v, @"-{2,}.*", "").Trim();
        }

        // Remove leftover junk
        v = Regex.Replace(v, @"-{2,}", "-");

        // Trim again
        v = v.Trim();

        // If it becomes empty after cleanup, return null
        if (string.IsNullOrEmpty(v)) return null;

        // Prevent too long value
        if (v.Length > 100) v = v.Substring(0, 100);

        return v;
    }

