    private async Task<int?> GetOrCreateLineIdAsync(string name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return null;

        try
        {
            // Check if already exists
            var all = await NotifyService.GetAllAsync();
            var existing = all.FirstOrDefault(x =>
                string.Equals(x.NotifyName?.Trim(), name.Trim(), StringComparison.OrdinalIgnoreCase));

            if (existing != null)
                return existing.NotifyId;

            // Create new line
            var newLine = new Notify
                {
                    NotifyName = name.Trim(),
                    NotifyType = "LINE"
                };

            // Create via API (returns Notify object now)
            var created = await NotifyService.CreateAsync(newLine);

            if (created != null)
                return created.NotifyId;

            // Fallback: force refresh and find again (rarely needed)
            var refreshed = await NotifyService.GetAllAsync();
            return refreshed.FirstOrDefault(x =>
                string.Equals(x.NotifyName?.Trim(), name.Trim(), StringComparison.OrdinalIgnoreCase))?.NotifyId;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"⚠️ Error creating line '{name}': {ex.Message}");
            // fallback to Account if Notify creation fails
            return await GetOrCreateAccountIdAsync(name);
        }
    }


    private async Task<Job> BuildJobFromExtractedDataAsync(Dictionary<string, string> d)
    {
        var j = new Job { JobType = JobType, JobDate = DateTime.Now, JobYearId = YearStatechangeService.SelectedYearId.ToString() };

        // ==================== BASIC JOB INFO ====================
        if (d.TryGetValue("Job No", out var jobNo))
            j.JobNo = CleanValue(jobNo);

        if (d.TryGetValue("Job Date", out var jdt) && DateTime.TryParse(CleanValue(jdt), out var parsed))
            j.JobDate = parsed;

        // ==================== BILL OF LADING INFO ====================
        if (d.TryGetValue("MBL/MAWB", out var mbl))
            j.JobBlNo = CleanValue(mbl);

        if (d.TryGetValue("HBL/HAWB", out var hbl))
            j.JobHblNo = CleanValue(hbl);

        if (d.TryGetValue("BL Date", out var bldt) && DateTime.TryParse(CleanValue(bldt), out var blParsed))
            j.JobBlDate = blParsed;

        if (d.TryGetValue("HBL Date", out var hbldt) && DateTime.TryParse(CleanValue(hbldt), out var hblParsed))
            j.JobHblDate = hblParsed;

        if (d.TryGetValue("BL Type", out var blType))
            j.JobBlType = CleanValue(blType);

        if (d.TryGetValue("Voyage", out var voyage))
            j.JobVoy = CleanValue(voyage);

        if (d.TryGetValue("Booking No", out var bookingNo))
            j.JobBookingNo = CleanValue(bookingNo);

        // ==================== INVOICE INFO ====================
        if (d.TryGetValue("Invoice No", out var invNo))
            j.JobShipperInvNo = CleanValue(invNo);

        if (d.TryGetValue("Invoice Date", out var invDt) && DateTime.TryParse(CleanValue(invDt), out var invParsed))
            j.JobShipperInvDate = invParsed;

        // ==================== WEIGHT & QUANTITY ====================
        if (d.TryGetValue("Gross Weight", out var gw) && double.TryParse(CleanValue(gw)?.Replace(",", ""), out var grossWt))
            j.JobGrossWt = grossWt;

        if (d.TryGetValue("Net Weight", out var nw) && double.TryParse(CleanValue(nw)?.Replace(",", ""), out var netWt))
            j.JobNetWt = netWt;

        if (d.TryGetValue("No of Pkgs", out var pkgs) && double.TryParse(CleanValue(pkgs)?.Replace(",", ""), out var qty))
            j.JobQty = qty;

        if (d.TryGetValue("Gross Unit", out var grossUnit))
            j.JobGrossUnit = CleanValue(grossUnit);

        if (d.TryGetValue("Net Unit", out var netUnit))
            j.JobNetUnit = CleanValue(netUnit);

        if (d.TryGetValue("Qty Unit", out var qtyUnit))
            j.JobQtyUnit = CleanValue(qtyUnit);

        if (d.TryGetValue("CBM", out var cbm) && float.TryParse(CleanValue(cbm)?.Replace(",", ""), out var cbmVal))
            j.JobCbm = cbmVal;

        if (d.TryGetValue("Volume", out var volume))
            j.JobVolume = CleanValue(volume);

        if (d.TryGetValue("Exchange Rate", out var exchRate) && double.TryParse(CleanValue(exchRate)?.Replace(",", ""), out var exRate))
            j.JobExchRate = exRate;

        // ==================== LOCATION/PORT INFO ====================
        if (d.TryGetValue("Port Origin", out var portOrigin))
        {
            string countryOrigin = null;
            d.TryGetValue("Country Origin", out countryOrigin);

            var locId = await GetOrCreateLocationWithCountryAsync(CleanValue(portOrigin), CleanValue(countryOrigin));
            if (locId.HasValue)
                j.JobPolId = locId.Value;
        }

        if (d.TryGetValue("Port Shipment", out var portShipment))
        {
            string countryShip = null;
            d.TryGetValue("Country Consignment", out countryShip);

            var locId = await GetOrCreateLocationWithCountryAsync(CleanValue(portShipment), CleanValue(countryShip));
            if (locId.HasValue)
                j.JobPodId = locId.Value;
        }

        if (d.TryGetValue("Country Origin", out var country))
            j.JobCountryOrigin = CleanValue(country);

        if (d.TryGetValue("Country Discharge", out var countryDisch))
            j.JobCountryDischarge = CleanValue(countryDisch);

        if (d.TryGetValue("Place of Receipt", out var por))
            j.JobPlaceOfReceipt = CleanValue(por);

        if (d.TryGetValue("Place of Delivery", out var pod))
            j.JobPlaceOfDelivery = CleanValue(pod);

        if (d.TryGetValue("ICD", out var icd))
            j.JobIcd = CleanValue(icd);

        if (d.TryGetValue("CFS", out var cfs))
            j.JobCfs = CleanValue(cfs);

        if (d.TryGetValue("Terminal", out var terminal))
            j.JobTerminal = CleanValue(terminal);

        if (d.TryGetValue("Empty Yard", out var emptyYard))
            j.JobEmptyYard = CleanValue(emptyYard);

        // ==================== SHIPPING PARTIES ====================
        if (d.TryGetValue("Shipper Name", out var shipper))
        {
            var shipperId = await GetOrCreateAccountIdAsync(CleanValue(shipper));
            if (shipperId.HasValue)
                j.JobShipperId = shipperId.Value;
        }

        if (d.TryGetValue("Shipper Address", out var shipperAddr))
            j.JobShipperAddress = CleanValue(shipperAddr);

        if (d.TryGetValue("Importer Name", out var importer))
        {
            var aid = await GetOrCreateAccountIdAsync(CleanValue(importer));
            if (aid.HasValue)
                j.JobPartyId = aid.Value;
        }

        if (d.TryGetValue("Consignee Name", out var consignee))
        {
            var consigneeId = await GetOrCreateAccountIdAsync(CleanValue(consignee));
            if (consigneeId.HasValue)
                j.JobConsigneeId = consigneeId.Value;
        }

        if (d.TryGetValue("Consignee Address", out var consigneeAddr))
            j.JobConsigneeAddress = CleanValue(consigneeAddr);

        if (d.TryGetValue("Notify Party", out var notify))
            j.JobNotifyAddress = CleanValue(notify);

        if (d.TryGetValue("Agent Name", out var agent))
            j.JobAgent = CleanValue(agent);

        if (d.TryGetValue("Agent Address", out var agentAddr))
            j.JobAgentAddress = CleanValue(agentAddr);

        if (d.TryGetValue("Supplier Name", out var supplier))
        {
            var aid = await GetOrCreateAccountIdAsync(CleanValue(supplier));
            if (aid.HasValue)
                j.JobSupplierId = aid.Value;
        }

        if (d.TryGetValue("Forwarder Name", out var forwarder))
            j.JobForwarder = CleanValue(forwarder);

        if (d.TryGetValue("Forwarder Address", out var forwarderAddr))
            j.JobForwarderAddress = CleanValue(forwarderAddr);

