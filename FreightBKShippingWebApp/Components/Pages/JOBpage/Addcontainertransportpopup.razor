    <FooterContentTemplate>
        <div class="d-flex justify-content-end gap-2 p-2">
            <DxButton Text="Save"
                      IconCssClass="dx-icon-save"
                      RenderStyle="ButtonRenderStyle.Primary"
                      Click="SaveData" />

            <DxButton Text="Clear"
                      IconCssClass="dx-icon-clear"
                      RenderStyle="ButtonRenderStyle.Light"
                      Click="ClearForm" />

            <DxButton Text="Close"
                      IconCssClass="dx-icon-close"
                      RenderStyle="ButtonRenderStyle.Secondary"
                      Click="ClosePopup" />
        </div>
    </FooterContentTemplate>


</DxPopup>

@code {
    [Parameter] public bool PopupVisible { get; set; }
    [Parameter] public EventCallback<bool> PopupVisibleChanged { get; set; }
    [Parameter] public EventCallback<Lr> OnSave { get; set; }

    private bool detailsExpanded = true;
    private Lr EditModel = new Lr();

    // Sample data for dropdowns
    List<Notify> notifylist = new();
    List<Account> accountpartylist = new();
    List<Account> accountSupplierlist = new();
    List<Account> DriverList = new();
    List<Location> LocationList = new();
    List<Location> StationLocationList = new();
    List<PayType> paytypeList = new();

    private List<Cargo> ProductList = new();
    public class SelectItem
    {
        public string Text { get; set; }
        public string Value { get; set; }
    }
    private List<SelectItem> PaymethodList = new List<SelectItem>
{
    new SelectItem { Text = "To be Billed", Value = "To be Billed" },
    new SelectItem { Text = "To Pay",     Value = "To Pay" },
    new SelectItem { Text = "Paid",      Value ="Paid" }
};

    List<PayType> paytypelist = new();

    protected override async Task OnInitializedAsync()
    {
        paytypelist = await PayTypeService.GetAllAsync();
        notifylist = await NotifyService.GetAllAsync();
        LocationList = await LocationService.GetAllAsync();

        // 🔍 Sirf Station type
        StationLocationList = LocationList
            .Where(x => string.Equals(x.LocationType, "STATION", StringComparison.OrdinalIgnoreCase))
            .ToList();

        accountpartylist = await AccountService.GetAllAsync();
        accountSupplierlist = accountpartylist.Where(x => x.AccountTypeId == 14).ToList();
        DriverList = accountpartylist.Where(x => x.AccountTypeId == 16).ToList();
        paytypeList = await PayTypeService.GetAllAsync();
        ProductList = await CargoService.GetAllAsync();
    }
    protected override void OnInitialized()
    {
        InitializeModel();
    }

    private void OnConsignorChanged(int? notifyId)
    {
        EditModel.LrConsignorNotifyId = notifyId;

        var selectedNotify = notifylist
            .FirstOrDefault(x => x.NotifyId == notifyId);

        EditModel.LrConsignorNotifyAddress =
            selectedNotify == null
            ? string.Empty
            : $"{selectedNotify.NotifyAddress1} {selectedNotify.NotifyAddress2} {selectedNotify.NotifyAddress3}".Trim();
       
         EditModel.LrConsignorNotifyGst = selectedNotify?.GstNo;
        EditModel.LrConsignorNotifyState = selectedNotify?.NotifyState;
    }
    private void OnConsigneeChanged(int? notifyId)
    {
        EditModel.LrConsigneeNotifyId = notifyId;

        var selectedNotify = notifylist
            .FirstOrDefault(x => x.NotifyId == notifyId);

        EditModel.LrConsigneeNotifyAddress =
            selectedNotify == null
                ? string.Empty
                : $"{selectedNotify.NotifyAddress1} {selectedNotify.NotifyAddress2} {selectedNotify.NotifyAddress3}".Trim();

        // Optional: GST & State auto-fill
        EditModel.LrConsigneeNotifyGst = selectedNotify?.GstNo;
        EditModel.LrConsigneeNotifyState = selectedNotify?.NotifyState;
    }

    private void InitializeModel()
    {
        EditModel = new Lr
        {
            LrNtDate = DateTime.Now,
            LrNtPickupDt = DateTime.Now,
            LrGrossWt = 0,
            LrTareWt = 0,
            LrLoadWt = 0,
            LrChargeQty = 0
        };
    }

    private void CalculateLoadWeight()
    {
        if (EditModel.LrGrossWt.HasValue && EditModel.LrTareWt.HasValue)
        {
            EditModel.LrLoadWt = EditModel.LrGrossWt.Value - EditModel.LrTareWt.Value;
        }
    }

    private async Task SaveData()
    {
        if (string.IsNullOrWhiteSpace(EditModel.LrNoStr))
        {
            ToastService.Warning("LR No required");
            return;
        }

        EditModel.LrJobId = job.JobId;
        EditModel.LrJobNo = job.JobNo;
        EditModel.LrVoucherId = job.JobId;
        EditModel.LrStatus = 1;

        var result = EditModel.LrId == 0
            ? await ContainerAddServices.CreateAsync(EditModel)
            : await ContainerAddServices.UpdateAsync(EditModel);

        if (result != null)
        {
            ToastService.Success("LR saved");
            await OnSave.InvokeAsync(result); 
            await ClosePopup();
        }
    }



    private async Task ClearForm()
    {
        InitializeModel();
         ToastService.Info("Form cleared");
    }

    private async Task ClosePopup()
    {
        PopupVisible = false;
        await PopupVisibleChanged.InvokeAsync(PopupVisible);
    }
    private Job job = new();

    public void ShowPopup(Lr model = null, Job currentJob = null)
    {
        if (currentJob != null)
            job = currentJob;

        if (model != null)
        {
            // 🟡 Edit existing — direct assign
            EditModel = model;
        }
        else
        {
            // 🆕 New entry — create new with defaults
            EditModel = new Lr
            {
                IsNew = true,
                LrJobId = job.JobId,
                LrJobNo = job.JobNo,
                LrVoucherId = job.JobId,
                LrStatus = 1,
                LrNtDate = DateTime.Now,
                LrNtPickupDt = DateTime.Now,
                LrGrossWt = 0,
                LrTareWt = 0,
                LrLoadWt = 0,
                LrChargeQty = 0
            };
        }

        PopupVisible = true;
        StateHasChanged();
    }


}