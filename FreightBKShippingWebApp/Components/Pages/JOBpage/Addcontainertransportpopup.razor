                            <DxDateTimeMaskProperties CaretMode="@MaskCaretMode.Advancing" />
                        </DxMaskedInput>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Load Date" ColSpanMd="12">
                            @* <DxDateEdit @bind-Date="EditModel.LrloadDate" DisplayFormat="dd-MM-yyyy" /> *@
                        <DxMaskedInput @bind-Value="EditModel.LrloadDate"
                                       Mask="dd/MM/yyyy"
                                       MaskMode="@MaskMode.DateTime" InputCssClass="editor-focus-green">
                            <DxDateTimeMaskProperties CaretMode="@MaskCaretMode.Advancing" />
                        </DxMaskedInput>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Drop Date" ColSpanMd="12">
                            @* <DxDateEdit @bind-Date="" DisplayFormat="dd-MM-yyyy" /> *@
                        <DxMaskedInput @bind-Value="EditModel.LrReportDate"
