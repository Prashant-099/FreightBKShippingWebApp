                            <DxDateTimeMaskProperties CaretMode="@MaskCaretMode.Advancing" />
                        </DxMaskedInput>
                        </DxFormLayoutItem>
                        
                        <DxFormLayoutItem Caption="Unload Date" ColSpanMd="12">
                            @* <DxDateEdit @bind-Date="" DisplayFormat="dd-MM-yyyy" /> *@
                        <DxMaskedInput @bind-Value="EditModel.LrUnloadDate"
