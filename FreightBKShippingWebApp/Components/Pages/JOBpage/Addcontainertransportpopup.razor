                                    TextFieldName="CargoName"
                                    ValueFieldName="CargoId"
                                    @bind-Value="EditModel.LrProductId"
                                    ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" AllowUserInput="true"
                                    SearchMode="ListSearchMode.AutoSearch"
                                    SearchFilterCondition="ListSearchFilterCondition.Contains" />
                    </DxFormLayoutItem>
                    @* <DxFormLayoutItem Caption="Billing Rate" ColSpanMd="4" CaptionPosition="CaptionPosition.Vertical">
                        <DxSpinEdit @bind-Value="EditModel.LrRateBill" DisplayFormat="n2" ShowSpinButtons=false />
                    </DxFormLayoutItem> *@
                    @* <DxFormLayoutItem Caption="Gross Wt" ColSpanMd="2" CaptionPosition="CaptionPosition.Vertical">
                        <DxSpinEdit @bind-Value="EditModel.LrGrossWt"
                                    DisplayFormat="n2" ShowSpinButtons=false />
                    </DxFormLayoutItem> *@
                    @* row-7                    *@
             
                   
               
                    @* -- *@

                    
                  
                    @* <DxFormLayoutItem Caption="Charg Qty" ColSpanMd="4" CaptionPosition="CaptionPosition.Vertical">
                        <DxSpinEdit @bind-Value="EditModel.LrChargeQty" DisplayFormat="n2" ShowSpinButtons=false />
                    </DxFormLayoutItem> *@

                    @* row-8         *@
                 

                    <DxFormLayoutItem Caption="Cont#1" ColSpanMd="2" CaptionPosition="CaptionPosition.Vertical">
                        <DxTextBox @bind-Text="EditModel.LrContainer1"></DxTextBox>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Cont#2" ColSpanMd="2" CaptionPosition="CaptionPosition.Vertical">
                        <DxTextBox @bind-Text="EditModel.LrContainer2"></DxTextBox>
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Custom 1" ColSpanMd="2" CaptionPosition="CaptionPosition.Vertical">
                        <DxTextBox @bind-Text="EditModel.LrCustom1" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="Custom 2" ColSpanMd="2" CaptionPosition="CaptionPosition.Vertical">
                        <DxTextBox @bind-Text="EditModel.LrCustom2" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Custom 3" ColSpanMd="2" CaptionPosition="CaptionPosition.Vertical">
                        <DxTextBox @bind-Text="EditModel.LrCustom3" />
                    </DxFormLayoutItem>
                    <DxFormLayoutItem Caption="Custom 4" ColSpanMd="2" CaptionPosition="CaptionPosition.Vertical">
                        <DxTextBox @bind-Text="EditModel.LrCustom4" />
                    </DxFormLayoutItem>
     
                    </DxFormLayoutGroup>
                @* group-2 right side group-last Colume *@
                    <DxFormLayoutGroup ColSpanMd="2" Decoration="FormLayoutGroupDecoration.None">
                    <DxFormLayoutItem Caption="Billing Type" ColSpanMd="12" CaptionPosition="CaptionPosition.Vertical">
                        <DxComboBox Data="paytypeList"
                                    @bind-Value="EditModel.LrBillTypeBill"
                                    ValueFieldName="PayTypeName"
                                    TextFieldName="PayTypeName"></DxComboBox>
                    </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Inv No" ColSpanMd="12">
                            <DxTextBox @bind-Text="EditModel.LrNtInvNo" />
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Inv Value" ColSpanMd="12">
                            <DxTextBox @bind-Text="EditModel.LrNtInvNo" />
                        </DxFormLayoutItem>


                        <DxFormLayoutItem Caption="Pickup Date" ColSpanMd="12">
                            @* <DxDateEdit @bind-Date="EditModel.LrPickupDate" DisplayFormat="dd-MM-yyyy" /> *@
                        <DxMaskedInput @bind-Value="EditModel.LrPickupDate"
                                       Mask="dd/MM/yyyy"
