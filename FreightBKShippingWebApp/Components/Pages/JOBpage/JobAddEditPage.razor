    // Class level variable

    private string shipmentType = "";
    private string fileExtension = "";
    private async Task HandleUpload(InputFileChangeEventArgs e)
    {
        try
        {
            LoadingService.Show();
            var file = e.File;

            // ✅ STEP 1: Get file extension
            fileExtension = Path.GetExtension(file.Name).ToLower();

            using var reader = new StreamReader(file.OpenReadStream());
            string content = await reader.ReadToEndAsync();

            uploadedFileLines = content.Split(
                new[] { "\r\n", "\r", "\n" },
                StringSplitOptions.None
            ).ToList();

            rows.Clear();
            extractedData.Clear();

            // ✅ STEP 2: Check file type and call appropriate function
            if (fileExtension == ".be" || fileExtension == ".dat")
            {
                // BE (Import) File Processing

                ReadDataBE(uploadedFileLines);  // Read BE sections

                var beRow = rows.FirstOrDefault(x => x.Section == "BE");
                if (beRow == null)
                {
                    UploadMessage = "⚠ BE section not found in import file!";
                    return;
                }

                BuildDataDictionaryBE();  // Build BE dictionary
                await MapBEMain(beRow.Fields);  // Map BE data

                shipmentType = "Import";
                UploadMessage = $"✔ Import file uploaded! BE No: {EditModel.JobSbNo} | Rows: {rows.Count}";
                await Refresh();
            }
            else if (fileExtension == ".sb")
            {
                // SB (Export) File Processing
                Console.WriteLine("🟢 Processing SB (Export) file...");

                ReadDataSB(uploadedFileLines);  // Read SB sections

                var sbRow = rows.FirstOrDefault(x => x.Section == "SB");
                if (sbRow == null)
                {
                    UploadMessage = "⚠ SB section not found in export file!";
                    return;
                }

                BuildDataDictionary();  // Build SB dictionary
                await MapSBMain(sbRow.Fields);  // Map SB data

                shipmentType = "Export";
                UploadMessage = $"✔ Export file uploaded! SB No: {EditModel.JobSbNo} | Rows: {rows.Count}";
                await Refresh();
            }
            else
            {
                UploadMessage = $"❌ Unsupported file type: {fileExtension}. Please upload .be, .dat or .sb file.";
                return;
            }
            await Refresh();
        }
        catch (Exception ex)
        {
            UploadMessage = $"❌ ERROR: {ex.Message}";
            Console.WriteLine($"Error Stack: {ex.StackTrace}");
        }
        finally
        {
            LoadingService.Hide();
        }


    }

    // Detection method
    private string DetectShipmentType()
    {
        // Method 2 (Most reliable for your case)
        bool hasIGM = rows.Any(x => x.Section == "IGM");
        bool hasEGM = rows.Any(x => x.Section == "EGM");

        if (hasIGM) return "Import";
        if (hasEGM) return "Export";

        return "Unknown";
    }

