    /// <summary>
    ///
    public class FlatFileRow
    {
        public string Section { get; set; }
        public List<string> Fields { get; set; }
    }

    private string GetField(List<string> fields, params int[] indexes)
    {
        var values = new List<string>();

        foreach (var index in indexes)
        {
            if (fields != null && fields.Count > index && !string.IsNullOrWhiteSpace(fields[index]))
                values.Add(fields[index].Trim());
        }

        return string.Join(" ", values);
    }

    private DateTime? ParseDate(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return null;

        if (DateTime.TryParse(value, out var dt))
            return dt;

        if (DateTime.TryParseExact(value, "yyyyMMdd", null,
            System.Globalization.DateTimeStyles.None, out dt))
            return dt;

        return null;
    }

    private double SafeParseDouble(string value)
    {
        if (double.TryParse(value, out var d)) return d;
        return 0;
    }

    private decimal? SafeParseDecimal(string value)
    {
        if (decimal.TryParse(value, out var d)) return d;
        return null;
    }
    private int SafeParseInt(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return 0;

        if (int.TryParse(value.Trim(), out int result))
            return result;

        return 0;
    }

    private List<FlatFileRow> rows = new();
    private List<string> uploadedFileLines = new();
    private Dictionary<string, string> extractedData = new();  // Global dictionary
    private string UploadMessage = "";
    private string DebugInfo = "";

    //be
    private readonly HashSet<string> AllowedTablesBE = new()
{
    "BE", "INVOICE", "ITEMS", "CONTAINER", "EXCHANGE", "IGMS",
    "DEPB", "BOND", "CERT", "SBEDUTY", "CTX", "BE_ITEM_SW_INFO_TYPE",
    "STATEMENT", "SUPPORTINGDOCS"
};

    private void ReadDataBE(List<string> fileContent)
    {
        string currentTable = "";

        foreach (var line in fileContent)
        {
            if (string.IsNullOrWhiteSpace(line))
                continue;

            if (line.StartsWith("<TABLE>"))
            {
                currentTable = line.Replace("<TABLE>", "").Trim();

                if (!AllowedTablesBE.Contains(currentTable))
                    currentTable = "";

                continue;
            }

            if (line.StartsWith("<END-") ||
                line.StartsWith("HREC") ||  // BE files start with HREC instead of TREC
                line.StartsWith("<START-SIGNATURE>") ||
                line.StartsWith("<START-CERTIFICATE>"))
            {
                currentTable = "";
                continue;
            }

            if (string.IsNullOrEmpty(currentTable))
                continue;

            var fields = line.Split('\x1D').ToList();

            rows.Add(new FlatFileRow
                {
                    Section = currentTable,
                    Fields = fields
                });
        }

        Console.WriteLine($"📊 ReadDataBE: Parsed {rows.Count} rows from BE file");
    }

