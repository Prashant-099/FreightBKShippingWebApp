    @using FreightBKShippingWebApp.Model
    @using FreightBKShippingWebApp.Models
    @using FreightBKShippingWebApp.Services

    @inject JobService JobService
    @inject AccountService AccountService
    @inject VesselService VesselService
    @inject CargoService CargoService
    @inject ToasteService ToastService
    @inject NotifyService NotifyService
    @inject LocationService LocationService
    @inject CountryService CountryService
    @inject CurrencyService CurrencyService
    @inject YearStatechangeService YearStatechangeService
    @inject NavigationManager NavigationManager

<DxPopup @bind-Visible="Visible"
ShowCloseButton="true"
HeaderText="@PopupTitle"
Scrollable="true"
CloseOnOutsideClick="false"
MaxWidth="1150px" Width="90%"
         CssClass="popup-elevated" BodyCssClass="my-popup-body"
      >

    <EditForm Model="@EditModel" OnValidSubmit="HandleValidSubmit" Context="ctxjobaddedit">

        <DataAnnotationsValidator />
        <ValidationSummary />

        <DxFormLayout>

            <!-- Basic Info -->
            <DxFormLayoutItem Caption="Job No" ColSpanMd="4">
                <div class="d-flex gap-1">
                    <DxTextBox @bind-Text="EditModel.JobPrefix" ></DxTextBox>
                    <DxTextBox @bind-Text="EditModel.JobNo" />
                    <DxTextBox @bind-Text="EditModel.JobSufix" />
                </div>
            </DxFormLayoutItem>
 
            <DxFormLayoutItem Caption="Job Date" ColSpanMd="4">
                <DxDateEdit @bind-Date="EditModel.JobDate" Format="dd-MM-yyyy" />
            </DxFormLayoutItem>


            <DxFormLayoutTabPages >
                <DxFormLayoutTabPage Caption="Job Info" >
                    <DxFormLayoutGroup Decoration="FormLayoutGroupDecoration.None">
                        <DxFormLayoutGroup ColSpanMd="6" Decoration="FormLayoutGroupDecoration.None">
                   
                            <DxFormLayoutItem Caption="@PartyCaption" ColSpanMd="12"  CaptionCssClass="caption-bold">
                                <DxComboBox Data="@party"
                                TextFieldName="AccountName"
                                ValueFieldName="AccountId"
                                Value="@EditModel.JobPartyId"
                                ValueChanged="@((int? value) => OnImporterChanged(value))"
                                ValueExpression="@(() => EditModel.JobPartyId)"
                                NullText="Select Importer.."
                                AllowUserInput="true"
                                SearchMode="ListSearchMode.AutoSearch"
                                            SearchFilterCondition="ListSearchFilterCondition.StartsWith" ShowDropDownButton="true"
                                            CssClass="editor-smooth"
                                            InputCssClass="input-smooth"
                                           />
                            </DxFormLayoutItem>

                            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="@AddressCaption" ColSpanMd="12" >
                                <DxMemo @bind-Text="EditModel.JobPartyAddress" Rows="3"   CssClass="editor-smooth"></DxMemo>
                            </DxFormLayoutItem>

                            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="High Seas" ColSpanMd="12">
                                <DxComboBox Data="@party"
                                TextFieldName="AccountName"
                                ValueFieldName="AccountId"
                                Value="@EditModel.JobHighSeas1"
                                ValueChanged="@((int? value) => OnHighSeasChanged(value))"
                                ValueExpression="@(() => EditModel.JobHighSeas1)"
                                NullText="Select High Seas.."
                                AllowUserInput="true"
                                SearchMode="ListSearchMode.AutoSearch"
                                            SearchFilterCondition="ListSearchFilterCondition.StartsWith" CssClass="editor-smooth" />
                            </DxFormLayoutItem>

                            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="High Seas Address" ColSpanMd="12">
                                <DxMemo @bind-Text="EditModel.JobHighseas1Address" Rows="3" CssClass="editor-smooth"></DxMemo>
                            </DxFormLayoutItem>

                            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="Agent" ColSpanMd="12">
                                <DxTextBox @bind-Text="EditModel.JobAgent" CssClass="editor-smooth"></DxTextBox>
                            </DxFormLayoutItem>

                            <DxFormLayoutItem  CaptionCssClass="caption-bold" Caption="Agent Address" ColSpanMd="12">
                                <DxMemo @bind-Text="EditModel.JobAgentAddress" Rows="3" CssClass="editor-smooth"></DxMemo>
                            </DxFormLayoutItem>

                            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="Cargo" ColSpanMd="12">
                                <DxComboBox Data="@cargos"
                                TextFieldName="CargoName"
                                ValueFieldName="CargoId"
                                Value="@EditModel.JobCargoId"
                                ValueChanged="@((int? value) => OnCargoChanged(value))"
                                ValueExpression="@(() => EditModel.JobCargoId)"
                                NullText="Select Cargo..."
                                AllowUserInput="true"
                                SearchMode="ListSearchMode.AutoSearch"
                                            SearchFilterCondition="ListSearchFilterCondition.StartsWith" CssClass="editor-smooth" />
                            </DxFormLayoutItem>

                            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="Cargo Desc" ColSpanMd="12">
                                <DxMemo @bind-Text="EditModel.JobGoodsDesc" Rows="3" CssClass="editor-smooth"></DxMemo>
                            </DxFormLayoutItem>


                            <DxFormLayoutItem  CaptionCssClass="caption-bold" Caption="Prd. Brand" ColSpanMd="12">
                                <DxTextBox @bind-Text="EditModel.JobBrand" CssClass="editor-smooth" />
                            </DxFormLayoutItem>
                            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="HSN" ColSpanMd="12">
                                <DxTextBox @bind-Text="EditModel.JobHsnCode" CssClass="editor-smooth" />
                            </DxFormLayoutItem>




                            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="Vessel" ColSpanMd="12">
                                <DxComboBox Data="@vessels"
                                TextFieldName="VesselName"
                                ValueFieldName="VesselId"
                                @bind-Value="EditModel.JobVesselId"
                                NullText="Select Importer.." AllowUserInput="true"
                                SearchMode="ListSearchMode.AutoSearch"
                                            SearchFilterCondition="ListSearchFilterCondition.StartsWith" CssClass="editor-smooth" />
                            </DxFormLayoutItem>



                            <DxFormLayoutItem CaptionCssClass="caption-bold"  Caption="Line" ColSpanMd="12">
                                <DxComboBox Data="@lines" TextFieldName="NotifyName"
                                ValueFieldName="NotifyId" @bind-Value="EditModel.JobLineId"
                                NullText="Select Line..." AllowUserInput="true"
                                SearchMode="ListSearchMode.AutoSearch"
                                            SearchFilterCondition="ListSearchFilterCondition.StartsWith" CssClass="editor-smooth" />
                            </DxFormLayoutItem>
                            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="Default Currency " ColSpanMd="12">
                                <DxComboBox Data="@Currencies" @bind-Value="EditModel.JobDefCurrId"
                                TextFieldName="CurrencyName" ValueFieldName="CurrencyId" AllowUserInput="true"
                                SearchMode="ListSearchMode.AutoSearch"
                                            SearchFilterCondition="ListSearchFilterCondition.StartsWith" CssClass="editor-smooth"></DxComboBox>
                            </DxFormLayoutItem>


                        </DxFormLayoutGroup>


                        <DxFormLayoutGroup  ColSpanMd="6" Decoration="FormLayoutGroupDecoration.None">
                            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="BL No" ColSpanMd="6">
                                <DxTextBox @bind-Text="EditModel.JobBlNo" CssClass="editor-smooth" />
                            </DxFormLayoutItem>

                            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="BL Date" ColSpanMd="6">
                                <DxDateEdit @bind-Date="EditModel.JobBlDate" DisplayFormat="dd/MM/yyyy" CssClass="editor-smooth" />
                            </DxFormLayoutItem>
                            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="HBL No" ColSpanMd="6">
                                <DxTextBox @bind-Text="EditModel.JobHblNo" CssClass="editor-smooth" />
                            </DxFormLayoutItem>

                            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="HBL Date" ColSpanMd="6">
                                <DxDateEdit @bind-Date="EditModel.JobHblDate" DisplayFormat="dd/MM/yyyy" CssClass="editor-smooth" />
                            </DxFormLayoutItem>
                            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="BE No" ColSpanMd="6">
                                <DxTextBox @bind-Text="EditModel.JobBeNo" CssClass="editor-smooth" />
                            </DxFormLayoutItem>

                            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="BE Date" ColSpanMd="6">
                                <DxDateEdit @bind-Date="EditModel.JobBeDate" DisplayFormat="dd/MM/yyyy" CssClass="editor-smooth" />
                            </DxFormLayoutItem>

                            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="Shipper Inv No" ColSpanMd="6">
                                <DxTextBox @bind-Text="EditModel.JobShipperInvNo" CssClass="editor-smooth" />
                            </DxFormLayoutItem>

                            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="Shipper Inv Date" ColSpanMd="6">
                                <DxDateEdit @bind-Date="EditModel.JobShipperInvDate" DisplayFormat="dd/MM/yyyy" CssClass="editor-smooth" />
                            </DxFormLayoutItem>


                            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="Gross Weight" ColSpanMd="6">
                                <DxSpinEdit @bind-Value="EditModel.JobGrossWt" ShowSpinButtons=false CssClass="editor-smooth" />
                            </DxFormLayoutItem>

                            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="Unit" ColSpanMd="6">
                                <DxComboBox Data="@weightUnits" @bind-Value="EditModel.JobGrossUnit" AllowUserInput="true"
                                SearchMode="ListSearchMode.AutoSearch"
                                            SearchFilterCondition="ListSearchFilterCondition.StartsWith" CssClass="editor-smooth"></DxComboBox>
                            </DxFormLayoutItem>


                            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="Net Weight" ColSpanMd="6">
                                <DxSpinEdit @bind-Value="EditModel.JobNetWt" ShowSpinButtons=false CssClass="editor-smooth" />
                            </DxFormLayoutItem>
                            <DxFormLayoutItem  CaptionCssClass="caption-bold" Caption="Unit" ColSpanMd="6">
                                <DxComboBox Data="@weightUnits" @bind-Value="EditModel.JobNetUnit" AllowUserInput="true"
                                SearchMode="ListSearchMode.AutoSearch"
                                            SearchFilterCondition="ListSearchFilterCondition.StartsWith" CssClass="editor-smooth"></DxComboBox>
                            </DxFormLayoutItem>


                            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="Quantity" ColSpanMd="6">
                                <DxSpinEdit @bind-Value="EditModel.JobQty" ShowSpinButtons=false CssClass="editor-smooth" />

                            </DxFormLayoutItem>

                            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="Unit" ColSpanMd="6">
                                <DxComboBox Data="@weightUnits" @bind-Value="EditModel.JobQtyUnit" AllowUserInput="true"
                                SearchMode="ListSearchMode.AutoSearch"
                                            SearchFilterCondition="ListSearchFilterCondition.StartsWith" CssClass="editor-smooth"></DxComboBox>

                            </DxFormLayoutItem>

                            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="CBM" ColSpanMd="12">
                                <DxSpinEdit @bind-Value="EditModel.JobCbm" ShowSpinButtons=false CssClass="editor-smooth" />
                            </DxFormLayoutItem>
                            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="POL" ColSpanMd="12">
                                <DxComboBox Data="@locationList"
                                @bind-Value="EditModel.JobPolId" TextFieldName="LocationName"
                                ValueFieldName="LocationId" AllowUserInput="true"
                                SearchMode="ListSearchMode.AutoSearch"
                                            SearchFilterCondition="ListSearchFilterCondition.StartsWith" CssClass="editor-smooth"></DxComboBox>
                            </DxFormLayoutItem>

                            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="POD" ColSpanMd="12">
                                <DxComboBox Data="@locationList" @bind-Value="EditModel.JobPodId"
                                TextFieldName="LocationName" ValueFieldName="LocationId" AllowUserInput="true"
                                SearchMode="ListSearchMode.AutoSearch"
                                            SearchFilterCondition="ListSearchFilterCondition.StartsWith" CssClass="editor-smooth"></DxComboBox>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="Place of Delivery" ColSpanMd="12">
                                <DxTextBox @bind-Text="EditModel.JobPlaceOfDelivery"  CssClass="editor-smooth"/>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="Place of Receipt" ColSpanMd="12">
                                <DxTextBox @bind-Text="EditModel.JobPlaceOfReceipt" CssClass="editor-smooth" />
                            </DxFormLayoutItem>
                            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="Country of Origin" ColSpanMd="12">
                                <DxComboBox Data="@countryList"
                                @bind-Value="EditModel.JobCountryOrigin"
                                TextFieldName="CountryName" ValueFieldName="CountryName" AllowUserInput="true"
                                SearchMode="ListSearchMode.AutoSearch"
                                            SearchFilterCondition="ListSearchFilterCondition.StartsWith" CssClass="editor-smooth" />
                            </DxFormLayoutItem>


                            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="Certificate Origin" ColSpanMd="12">
                                <DxTextBox @bind-Text="EditModel.JobCertiOrigin" CssClass="editor-smooth" ></DxTextBox>
                            </DxFormLayoutItem>

                            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="Consignee" ColSpanMd="12">
                                <DxComboBox Data="@consignees" TextFieldName="NotifyName"
                                ValueFieldName="NotifyId" @bind-Value="EditModel.JobConsigneeId"
                                NullText="Select Consignor..." AllowUserInput="true"
                                SearchMode="ListSearchMode.AutoSearch"
                                            SearchFilterCondition="ListSearchFilterCondition.StartsWith" CssClass="editor-smooth" />
                            </DxFormLayoutItem>
                            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="Supplier/Consignor" ColSpanMd="12">
                                <DxComboBox Data="@consignor"
                                @bind-Value="EditModel.JobSupplierId" TextFieldName="NotifyName"
                                ValueFieldName="NotifyId" AllowUserInput="true"
                                SearchMode="ListSearchMode.AutoSearch"
                                            SearchFilterCondition="ListSearchFilterCondition.StartsWith" CssClass="editor-smooth" />
                            </DxFormLayoutItem>
                        </DxFormLayoutGroup>






                        <DxFormLayoutGroup Decoration="FormLayoutGroupDecoration.None">

                            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="CHA" ColSpanMd="6">
                                <DxComboBox Data="@chaList"
                                @bind-Value="EditModel.JobChaId" TextFieldName="NotifyName"
                                ValueFieldName="NotifyId" AllowUserInput="true"
                                SearchMode="ListSearchMode.AutoSearch"
                                            SearchFilterCondition="ListSearchFilterCondition.StartsWith" CssClass="editor-smooth" />
                            </DxFormLayoutItem>
                            <DxFormLayoutItem  CaptionCssClass="caption-bold" Caption="Shipper" ColSpanMd="6">
                                <DxComboBox Data="@shippers"
                                TextFieldName="NotifyName" ValueFieldName="NotifyId"
                                @bind-Value="EditModel.JobShipperId"
                                NullText="Select Shipper..." AllowUserInput="true"
                                SearchMode="ListSearchMode.AutoSearch"
                                            SearchFilterCondition="ListSearchFilterCondition.StartsWith" CssClass="editor-smooth" />
                            </DxFormLayoutItem>





                            <DxFormLayoutItem  CaptionCssClass="caption-bold" Caption="Booking No." ColSpanMd="6">
                                <DxTextBox @bind-Text="EditModel.JobBookingNo" CssClass="editor-smooth" />
                            </DxFormLayoutItem>
                            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="Exchange Rate" ColSpanMd="6">
                                <DxSpinEdit @bind-Value="EditModel.JobExchRate" ShowSpinButtons=false CssClass="editor-smooth" />
                            </DxFormLayoutItem>
                            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="CFS" ColSpanMd="6">
                                <DxTextBox @bind-Text="EditModel.JobCfs" CssClass="editor-smooth" />
                            </DxFormLayoutItem>    


                            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="Status" ColSpanMd="6">
                                <DxComboBox Data="@stuslist"
                                @bind-Value="EditModel.JobState" AllowUserInput="true"
                                SearchMode="ListSearchMode.AutoSearch"
                                            SearchFilterCondition="ListSearchFilterCondition.StartsWith" CssClass="editor-smooth"></DxComboBox>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem CaptionCssClass="caption-bold"  Caption="Remarks" ColSpanMd="12">
                                <DxMemo @bind-Text="EditModel.JobRemarks" Rows="3" CssClass="editor-smooth" />
                            </DxFormLayoutItem>

                        </DxFormLayoutGroup>
                    </DxFormLayoutGroup>
                </DxFormLayoutTabPage >

                <DxFormLayoutTabPage Caption="Extra details">
                    <DxFormLayoutGroup Decoration="FormLayoutGroupDecoration.None">
                        <DxFormLayoutItem Caption="ETA">
                            <DxDateEdit @bind-Date="EditModel.JobEta" DisplayFormat="dd/MM/yyyy" CssClass="editor-smooth" />
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="ETD">
                            <DxDateEdit @bind-Date="EditModel.JobEtd" DisplayFormat="dd/MM/yyyy" CssClass="editor-smooth" />
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="CFS">
                            <DxMemo @bind-Text="EditModel.JobCfs" CssClass="editor-smooth" />
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="ICD">
                            <DxTextBox @bind-Text="EditModel.JobIcd" CssClass="editor-smooth"></DxTextBox>
                        </DxFormLayoutItem>


                        <DxFormLayoutItem Caption="DO NO">
                            <DxTextBox @bind-Text="EditModel.JobDoNo" CssClass="editor-smooth" />
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="DO Date">
                            <DxDateEdit @bind-Date="EditModel.JobDoDate" DisplayFormat="dd/MM/yyyy"  CssClass="editor-smooth"/>
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="DO (%)">
                            <DxSpinEdit @bind-value="EditModel.JobDoPer" ShowSpinButtons=false CssClass="editor-smooth" />
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="ETD">
                            <DxTextBox @bind-Text="EditModel.JobDoType" CssClass="editor-smooth" />
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="DO Valid Date">
                            <DxDateEdit @bind-Date="EditModel.JobDoValid" DisplayFormat="dd/MM/yyyy"  CssClass="editor-smooth"/>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Terminal">
                            <DxTextBox @bind-Text="EditModel.JobTerminal"  CssClass="editor-smooth"/>
                        </DxFormLayoutItem> 
                        <DxFormLayoutItem Caption="IGM No">
                            <DxTextBox @bind-Text="EditModel.JobIgmNo" CssClass="editor-smooth" />
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="IGM Date">
                            <DxDateEdit @bind-Date="EditModel.JobIgmDate" DisplayFormat="dd/MM/yyyy" CssClass="editor-smooth" />
                        </DxFormLayoutItem>


                        <DxFormLayoutItem Caption="Marks & No" ColSpanMd="12">
                            <DxMemo @bind-Text="EditModel.JobMarks" Rows="2"  CssClass="editor-smooth"/>
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="Empty Yard">
                            <DxMemo @bind-Text="EditModel.JobEmptyYard"  CssClass="editor-smooth"/>
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="Forwarder">
                            <DxTextBox @bind-Text="EditModel.JobForwarder"  CssClass="editor-smooth"/>
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="Surveyor">
                            <DxTextBox @bind-Text="EditModel.Surveyor" CssClass="editor-smooth" />
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="Surveyor Address">
                            <DxMemo @bind-Text="EditModel.SurveyorAddress" Rows="2" CssClass="editor-smooth" />
                        </DxFormLayoutItem>


                        <DxFormLayoutItem Caption="Free Days">
                            <DxSpinEdit @bind-Value="EditModel.JobFreeDays" ShowSpinButtons=false CssClass="editor-smooth" />
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="Volume">
                            <DxTextBox @bind-Text="EditModel.JobVolume" CssClass="editor-smooth" />
                        </DxFormLayoutItem>


                        <DxFormLayoutItem Caption="Out of Charge Date">
                            <DxDateEdit @bind-Date="EditModel.JobOutOfChargeDate" DisplayFormat="dd/MM/yyyy" CssClass="editor-smooth" />
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="Remarks 2">
                            <DxMemo @bind-Text="EditModel.JobGoodsDesc1" Rows="2"  CssClass="editor-smooth"/>
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="Custom#2">
                            <DxTextBox @bind-Text="EditModel.JobCust2"  CssClass="editor-smooth"/>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Custom#3">
                            <DxTextBox @bind-Text="EditModel.JobCust3" CssClass="editor-smooth" />
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Custom#4">
                            <DxTextBox @bind-Text="EditModel.JobCust4"  CssClass="editor-smooth"/>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Custom#5">
                            <DxTextBox @bind-Text="EditModel.JobCust5"  CssClass="editor-smooth"/>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Custom#6">
                            <DxTextBox @bind-Text="EditModel.JobCust6"  CssClass="editor-smooth"/>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Custom#7">
                            <DxTextBox @bind-Text="EditModel.JobCust7" CssClass="editor-smooth" />
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Custom#8">
                            <DxTextBox @bind-Text="EditModel.JobCust8"  CssClass="editor-smooth"/>
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Custom#9">
                            <DxTextBox @bind-Text="EditModel.JobCust9" CssClass="editor-smooth" />
                        </DxFormLayoutItem>
                    </DxFormLayoutGroup>


                </DxFormLayoutTabPage>

                <DxFormLayoutTabPage Caption="Container">
                    <DxFormLayoutGroup Decoration="FormLayoutGroupDecoration.None">
                        <DxFormLayoutItem Caption="20FT Container">
                            <DxMemo @bind-Text="EditModel.JobContainer20Ft" Rows="3" CssClass="editor-smooth" />
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="40FT Container">
                            <DxMemo @bind-Text="EditModel.JobContainer40Ft" Rows="3" CssClass="editor-smooth" />
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="Count(20 Ft)"> 
                            <DxTextBox @bind-Text="EditModel.Job20Ft" CssClass="editor-smooth"></DxTextBox>
                        </DxFormLayoutItem>                     
                        <DxFormLayoutItem Caption="Count(40 Ft)"> 
                            <DxTextBox @bind-Text="EditModel.Job40Ft" CssClass="editor-smooth"></DxTextBox>
                        </DxFormLayoutItem>
                    </DxFormLayoutGroup>
                </DxFormLayoutTabPage>
                <DxFormLayoutTabPage Caption="Import Details">
                    @* <DxFormLayoutItem Caption="Upload Files" ColSpanMd="4"> *@
                    @*     <div class="upload-wrapper"> *@
                    @*         <DxUpload Name="jobFiles" *@
                    @*                   AllowMultiFileUpload="true" *@
                    @*                   SelectedFilesChanged="OnSelectedFilesChanged" *@
                    @*                   MaxFileSize="15000000" *@
                    @*                   ShowFileList="true" *@
                    @*                   CssClass="upload-component" /> *@
                    @*         <div class="info-text"> *@
                    @*             Upload "Multiple Files",Max Size 15 MB. *@
                    @*         </div> *@
                    @*     </div> *@
                    @* </DxFormLayoutItem> *@
                    <DxFormLayoutItem ColSpanMd="12">
                        <DxUpload Name="jobFiles" AllowMultiFileUpload="true" ></DxUpload>
                    </DxFormLayoutItem>
                </DxFormLayoutTabPage>
            </DxFormLayoutTabPages>

        </DxFormLayout>

        <div class="mt-3 text-end">
            <DxButton RenderStyle="ButtonRenderStyle.Primary" Text="Save" SubmitFormOnClick="true" />
            <DxButton Text="Cancel" Click="Cancel" CssClass="ms-2" />
        </div>
    </EditForm>
</DxPopup>

@code {

    int SelectedFilesCount { get; set; }

    void OnSelectedFilesChanged(IEnumerable<UploadFileInfo> files)
    {
        SelectedFilesCount = files.Count();
        StateHasChanged();
    }
    private bool Visible { get; set; }
    private Job EditModel = new();
    private bool IsEdit = false;
    private string UploadUrl => NavigationManager.ToAbsoluteUri("/api/job/upload").AbsoluteUri;

    private bool IsImport => string.Equals(JobType, "IMPORT", StringComparison.OrdinalIgnoreCase);
    private string PartyCaption => IsImport ? "Importer" : "Exporter";
    private string AddressCaption => $"{PartyCaption} Address";

    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public string JobType { get; set; } = "IMPORT";

    private string PopupTitle => IsEdit ? "Edit Job" : "Add Job";
    string[] weightUnits = new string[] { "NOS", "KGS", "MTS", "PKG", "BOX", "CTN" };
    string[] stuslist = new string[] { "Complete", "Cancel", "Pending" };

    // private List<Account> parties = new();
    private List<Account> party = new();
    private List<Vessel> vessels = new();
    private List<Cargo> cargos = new();
    private List<Notify> shippers = new();
    private List<Notify> lines = new();
    private List<Notify> consignees = new();
    private List<Notify> consignor = new();
    private List<Notify> agent = new();
    private List<Notify> chaList = new();
    private List<Location> locationList = new(); 
    private List<Country> countryList = new();
    public List<Currency> Currencies { get; set; } = new List<Currency>();

    public void Show(Job model)
    {
        IsEdit = model.JobId > 0;
        EditModel = model;
        Visible = true;
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
                var parties = await AccountService.GetAllAsync();
             party = parties.Where(a => a.AccountTypeId == 18).ToList();

               cargos = await CargoService.GetAllAsync();
             vessels = await VesselService.GetAllAsync();
            countryList = await CountryService.GetAllAsync();
            Currencies = await CurrencyService.GetAllAsync();
            if (Currencies.Any())
            {
                EditModel.JobDefCurrId = Currencies.FirstOrDefault().CurrencyId;
            }
            var locationlist = await LocationService.GetAllAsync();
            locationList = locationlist.Where(l => l.LocationType == "PORT").ToList();


            var allNotify = await NotifyService.GetAllAsync();

            // Separate lists by type
            shippers = allNotify.Where(n => n.NotifyType == "SHIPPER").ToList();
            lines = allNotify.Where(n => n.NotifyType == "LINE").ToList();
            consignees = allNotify.Where(n => n.NotifyType == "CONSIGNEE").ToList();
            consignor = allNotify.Where(n => n.NotifyType == "CONSIGNOR").ToList();
            agent = allNotify.Where(n => n.NotifyType == "AGENT").ToList();
            chaList = allNotify.Where(n => n.NotifyType == "CHA").ToList();


            StateHasChanged();
        }

        private async Task HandleValidSubmit()

         {
        EditModel.JobType = JobType;
        EditModel.JobYearId = YearStatechangeService.SelectedYearId.ToString();
            if (!IsEdit)
            {
                await JobService.CreateAsync(EditModel);
                ToastService.Success("Import Job created successfully.");
            }
            else
            {
                await JobService.UpdateAsync(EditModel);
                ToastService.Success("Import Job updated successfully.");
            }

            Visible = false;
            await OnSaved.InvokeAsync();
        }

        private void Cancel()
        {
            Visible = false;
        }

    private void OnImporterChanged(int? value)
    {
        EditModel.JobPartyId = value;

        if (value.HasValue)
        {
            // Find the selected party from the parties list
            var selectedParty = party?.FirstOrDefault(p => p.AccountId == value.Value);

            if (selectedParty != null)
            {
                // Auto-fill the address if it exists
                EditModel.JobPartyAddress = selectedParty.AccountAddress1+selectedParty.AccountAddress2 +selectedParty.AccountAddress3 ?? string.Empty;
            }
        }
        else
        {
            // Clear the address if no importer is selected
            EditModel.JobPartyAddress = string.Empty;
        }
    }

    private void OnHighSeasChanged(int? value)
    {
        EditModel.JobHighSeas1 = value;

        if (value.HasValue)
        {
            // Find the selected party from the party list
            var selectedParty = party?.FirstOrDefault(p => p.AccountId == value.Value);

            if (selectedParty != null)
            {
                // Auto-fill the address if it exists
                EditModel.JobHighseas1Address = selectedParty.AccountAddress1 + selectedParty.AccountAddress2 + selectedParty.AccountAddress3 ?? string.Empty;
            }
        }
        else
        {
            // Clear the address if no high seas is selected
            EditModel.JobHighseas1Address = string.Empty;
        }
    }

    private void OnCargoChanged(int? value)
    {
        EditModel.JobCargoId = value;

        if (value.HasValue)
        {
            // Find the selected cargo from the cargos list
            var selectedCargo = cargos?.FirstOrDefault(c => c.CargoId == value.Value);

            if (selectedCargo != null)
            {
                // Auto-fill the cargo description if it exists
                EditModel.JobGoodsDesc = selectedCargo.CargoRemarks ?? string.Empty;
                EditModel.JobHsnCode = selectedCargo.CargoHsn.ToString() ?? string.Empty;

                // Or use whatever property name contains the description
                // EditModel.JobGoodsDesc = selectedCargo.Description ?? string.Empty;
            }
        }
        else
        {
            // Clear the description if no cargo is selected
            EditModel.JobGoodsDesc = string.Empty;
        }
    }

