    private async Task LoadVoucherAndGenerateJobNo(int branchId)
{

        VoucherList = (await VoucherService.GetAllAsync())
.Where(v => v.VoucherName != null &&
            v.VoucherName.Equals(JobType, StringComparison.OrdinalIgnoreCase)
&& v.VoucherBranchId == branchId)
.ToList();
        // Check if VoucherList is empty
        if (VoucherList == null || !VoucherList.Any())
        {
            ToastService.Warning($"Voucher not found for {JobType}. Please configure voucher in master settings.");
            return;
        }
        var VoucherId = VoucherList.FirstOrDefault()?.VoucherId;
        if (VoucherId == null || VoucherId == 0)
        {
            ToastService.Warning($"Voucher not configured for {JobType}. Please add voucher in master settings.");
            return;
        }

        var finYearId = YearStatechangeService.SelectedYearId;
        if (finYearId == 0)
        {
            ToastService.Error(" Financial year not selected. Please select a year.");
            return;
        }
        try
        {
            var result = await YearStatechangeService.GeneratebillNoAsync(VoucherId, finYearId, EditModel.JobBranchId);
            var fulljobno = result.prefix + result.number + result.suffix;
            if (!string.IsNullOrEmpty(result.number))
            {
                var existingJob = jobList?.FirstOrDefault(j => j.JobNo == fulljobno && j.JobBranchId == branchId);

                if (existingJob != null)
                {
                    ToastService.Warning($" Job number '{result.prefix}{result.number}{result.suffix}' already exists!");
                }
            }
            EditModel.JobPrefix = result.prefix;
            EditModel.JobNo = result.prefix + result.number + result.suffix;
            EditModel.JobSufix = result.suffix;
            EditModel.JobVchNo = int.Parse(result.number);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            ToastService.Error("Error: " + ex.Message);
        }


}
