                                    SearchFilterCondition="ListSearchFilterCondition.Contains" CssClass="editor-smooth" />
                                </div>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="Supplier/Consignor" ColSpanMd="12">
