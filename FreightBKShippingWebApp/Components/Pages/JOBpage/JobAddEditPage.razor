    private void BuildDataDictionary()
    {
        extractedData.Clear();

        var sbRow = rows.FirstOrDefault(x => x.Section == "SB");
        if (sbRow == null) return;

        var f = sbRow.Fields;

        // ---------------------------
        // EXPORTER DETAILS
        // ---------------------------
        extractedData["ExporterName"] = GetField(f, 9);
        extractedData["ExporterAddress1"] = GetField(f, 10);
        extractedData["ExporterAddress2"] = GetField(f, 11);
        extractedData["ExporterAddress3"] = GetField(f, 12);
        extractedData["ExporterAddress4"] = GetField(f, 13);
        extractedData["ExporterAddress5"] = GetField(f, 14);
        extractedData["GSTIN"] = GetField(f, 16);
        extractedData["Phone"] = GetField(f, 17);
        extractedData["Email"] = GetField(f, 18);
        extractedData["PAN"] = GetField(f, 19);
        // ---------------------------
        // CONSIGNEE DETAILS
        // ---------------------------
        extractedData["ConsigneeName"] = GetField(f, 20);
        extractedData["ConsigneeAddress1"] = GetField(f, 21);
        extractedData["ConsigneeAddress2"] = GetField(f, 22);
        extractedData["ConsigneeAddress3"] = GetField(f, 23);
        extractedData["ConsigneeAddress4"] = GetField(f, 24);
        // ---------------------------
        // CHA + IEC + AGENT
        // ---------------------------
        extractedData["CHA"] = GetField(f, 6);
        extractedData["IEC"] = GetField(f, 7);
        extractedData["BranchSNo"] = GetField(f, 8);
        // ---------------------------
        // SHIPPING BILL CORE VALUES
        // ---------------------------
        extractedData["SBNo"] = GetField(f, 4);
        extractedData["SBDate"] = GetField(f, 5);
        // ---------------------------
        // PORT + VESSEL DETAILS
        // ---------------------------
        // From TABLESB (SB Main - Indices 0-49)
        extractedData["PortCode"] = GetField(f, 1);              // Custom House Code
        extractedData["POL"] = GetField(f, 29);                  // Port of Loading
        extractedData["POD"] = GetField(f, 33);                  // Port of Discharge
        extractedData["DestinationCountry"] = GetField(f, 31);   // Country of final destination
        extractedData["GrossWeight"] = GetField(f, 36);          // Gross weight
        extractedData["NetWeight"] = GetField(f, 37);            // Net weight
        extractedData["MarksNumbers"] = GetField(f, 40);         // Marks Numbers
        extractedData["GSTIN"] = GetField(f, 49);      

        extractedData["PartyAddress1"] = GetField(f, 10);
        extractedData["PartyAddress2"] = GetField(f, 11);
        extractedData["PartyAddress3"] = GetField(f, 12);
        extractedData["PartyAddress4"] = GetField(f, 13);

    }


    private async Task MapSBMain(List<string> fields)
    {
        try
        {

            EditModel.JobNo = GetField(fields, 2);
            EditModel.JobSbNo = GetField(fields, 4);          // Field 5: SB Number (1902025)
            EditModel.JobSbDate = ParseDate(GetField(fields, 5)); // Field 6: SB Date (20251106)

            // ========================= EXPORTER / PARTY =========================

            string exporterName = GetField(fields, 9);

            var exporterDict = new Dictionary<string, string>
{
    { "Exporter Address Line 1", extractedData["ExporterAddress1"] },
    { "Exporter Address Line 2", extractedData["ExporterAddress2"] },
    { "Exporter Address Line 3", extractedData["ExporterAddress3"] },
    { "Exporter Address Line 4", extractedData["ExporterAddress4"] },

    { "Exporter Phone", extractedData.GetValueOrDefault("ExporterPhone") },
    { "Exporter Email", extractedData.GetValueOrDefault("ExporterEmail") },
    { "Exporter GSTIN", extractedData.GetValueOrDefault("ExporterGSTIN") },
    { "Exporter PAN", extractedData.GetValueOrDefault("ExporterPAN") }
};


            if (!string.IsNullOrWhiteSpace(exporterName))
            {
                EditModel.JobPartyId = await JobDataCreationService.GetOrCreateAccountIdAsync(
     exporterName,
     exporterDict,
     "Exporter"
     );

            }
            EditModel.JobPartyAddress =
            $"{extractedData["ExporterAddress1"]} {extractedData["ExporterAddress2"]} " +
            $"{extractedData["ExporterAddress3"]} {extractedData["ExporterAddress4"]}";

            // =============== CONSIGNEE (SB) ==================
            string consigneeName = extractedData.GetValueOrDefault("ConsigneeName");

            var consigneeDict = new Dictionary<string, string>
{
    { "Consignee Address Line 1", extractedData.GetValueOrDefault("ConsigneeAddress1") },
    { "Consignee Address Line 2", extractedData.GetValueOrDefault("ConsigneeAddress2") },
    { "Consignee Address Line 3", extractedData.GetValueOrDefault("ConsigneeAddress3") },

    { "Consignee Phone", extractedData.GetValueOrDefault("ConsigneePhone") },
    { "Consignee Email", extractedData.GetValueOrDefault("ConsigneeEmail") }
};

            if (!string.IsNullOrWhiteSpace(consigneeName))
            {
                EditModel.JobConsigneeId = await JobDataCreationService.GetOrCreateConsigneeIdAsync(
                    consigneeName,
                    consigneeDict
                );
            }

            EditModel.JobConsigneeAddress =
                $"{consigneeDict["Consignee Address Line 1"]} {consigneeDict["Consignee Address Line 2"]} {consigneeDict["Consignee Address Line 3"]}"
                .Trim();


            // Port of Loading
            var polName = GetField(fields, 29);
            var polCountry = GetField(fields, 31);  
            EditModel.JobPolId = await JobDataCreationService.GetOrCreateLocationWithCountryAsync(polName, polCountry, "PORT");

            // Port of Discharge
            var podName = GetField(fields, 33);
            var podCountry = GetField(fields, 32);  
            EditModel.JobPodId = await JobDataCreationService.GetOrCreateLocationWithCountryAsync(podName, podCountry, "PORT");
            // Weights
            EditModel.JobGrossWt = SafeParseDouble(GetField(fields, 36));  // Index 36: Gross Weight (27000)
            EditModel.JobGrossUnit = GetField(fields, 38);                 // Index 38: Unit of Measurement (KGS/MTS)
            EditModel.JobNetWt = SafeParseDouble(GetField(fields, 37));    // Index 37: Net Weight (27000)
            EditModel.JobNetUnit = GetField(fields, 38);                   // Index 38: Unit of Measurement (same as gross unit)
            string qtyString = GetField(fields, 39);              // "1080"

            EditModel.JobQty = SafeParseInt(qtyString);           // 1080
            EditModel.JobQtyUnit = "PKG";                                 
            var itemRow = rows.FirstOrDefault(x => x.Section == "ITEM");
            if (itemRow != null)
            {
                var itemFields = itemRow.Fields;

                // ✅ GOODS DESCRIPTION
                EditModel.JobGoodsDesc = GetField(itemFields, 8);         // Index 8: Description
                // "QUARTZ POWDER S325 (BATCH NO.0515-QD)"

                // HSN Code
                EditModel.JobHsnCode = GetField(itemFields, 9);           // Index 9: HSN/HS Code

                // Item Quantity & Unit Price
                // EditModel.JobItemQty = SafeParseDouble(GetField(itemFields, 11));    Index 11: Quantity
                // EditModel.JobItemUnit = GetField(itemFields, 10);         Index 10: Unit (MTS/KGS)
                // EditModel.JobUnitPrice = SafeParseDouble(GetField(itemFields, 12));  Index 12: Unit Price
            }

            var invoiceRow = rows.FirstOrDefault(x => x.Section == "INVOICE");
            if (invoiceRow != null)
            {
                var invoiceFields = invoiceRow.Fields;

                // ✅ SHIPPER INVOICE NUMBER
                EditModel.JobShipperInvNo = GetField(invoiceFields, 4);    // Index 4: Invoice Number
                // "WMA/009/OVW/06"

                // Invoice Date & Value
                EditModel.JobShipperInvDate = ParseDate(GetField(invoiceFields, 5));    // Index 5: Invoice Date
            }
            // ==========================================
            // CONTAINER PARSING - DEBUGGING VERSION
            // ==========================================
            var containerRows = rows.Where(x => x.Section == "CONTAINER").ToList();

            int count20 = 0, count40 = 0;
            var numbers20 = new List<string>();
            var numbers40 = new List<string>();

            foreach (var row in containerRows)
            {
                var f = row.Fields;

                if (f.Count >= 6)
                {
                    // f[4] mein Type + Number dono hain
                    string typeAndNumber = GetField(f, 4);     // "CBHU5685814"

                    // Pehle 2 characters = Type, baaki = Number
                    string type = typeAndNumber.Substring(0, 2);           // "CB"
                    string number = typeAndNumber.Substring(2).Trim();     // "HU5685814"

                    // f[5] = Size
                    string size = GetField(f, 5);              // "20"

                    Console.WriteLine($"Type: {type}, Number: {number}, Size: {size}");

                    // Store Container Type
                    if (string.IsNullOrEmpty(EditModel.JobContainerType))
                        EditModel.JobContainerType = type;

                    // Count by size
                    if (size.Contains("20") || size == "20")
                    {
                        count20++;
                        numbers20.Add(number);
                    }
                    else if (size.Contains("40") || size == "40")
                    {
                        count40++;
                        numbers40.Add(number);
                    }
                }
            }

            // STORE RESULTS
            EditModel.Job20Ft = count20.ToString();
            EditModel.Job40Ft = count40.ToString();
            EditModel.JobContainer20Ft = string.Join(", ", numbers20);
            EditModel.JobContainer40Ft = string.Join(", ", numbers40);
            EditModel.JobContainerType = GetField(fields, 53); 


            // EditModel.JobMarks = GetField();
            // EditModel.Job20Ft = GetField();
            // EditModel.Job40Ft = GetField();
            // EditModel.JobHsnCode = GetField();

        }
        catch (Exception ex)
        {
            Console.WriteLine("SB_MAIN ERROR → " + ex.Message);
        }
    }

    private async Task MapBEMain(List<string> fields)
    {
        try
        {

            // ==========================================
            // BE MAIN TABLE FIELDS
            // ==========================================
            EditModel.JobNo = GetField(fields, 2);
            EditModel.JobSbNo = GetField(fields, 4);  // BE Number
            EditModel.JobSbDate = ParseDate(GetField(fields, 5));


            // Importer Details
            string importerName = GetField(fields, 9);

            extractedData["Importer Address Line 1"] = GetField(fields, 10);
            extractedData["Importer Address Line 2"] = GetField(fields, 11);
            extractedData["Importer Address Line 3"] = GetField(fields, 12);
            extractedData["Importer Address Line 4"] = GetField(fields, 13);

            // Also add old-format keys for compatibility
            extractedData["ImporterAddress1"] = extractedData["Importer Address Line 1"];
            extractedData["ImporterAddress2"] = extractedData["Importer Address Line 2"];
            extractedData["ImporterAddress3"] = extractedData["Importer Address Line 3"];
            extractedData["ImporterAddress4"] = extractedData["Importer Address Line 4"];

            if (!string.IsNullOrWhiteSpace(importerName))
            {
                EditModel.JobPartyId = await JobDataCreationService.GetOrCreateAccountIdAsync(
                    importerName,
                    extractedData,
                    "Importer"
                );
            }

            EditModel.JobPartyAddress =
                $"{extractedData["Importer Address Line 1"]} " +
                $"{extractedData["Importer Address Line 2"]} " +
                $"{extractedData["Importer Address Line 3"]} " +
                $"{extractedData["Importer Address Line 4"]}".Trim();


            // Ports and Countries
            var polName = GetField(fields, 20);
            var polCountry = GetField(fields, 22);
            if (!string.IsNullOrWhiteSpace(polName))
            {
                EditModel.JobPolId = await JobDataCreationService.GetOrCreateLocationWithCountryAsync(
                    polName, polCountry, "PORT");
            }

            var podName = GetField(fields, 24);
            var podCountry = GetField(fields, 23);
            if (!string.IsNullOrWhiteSpace(podName))
            {
                EditModel.JobPodId = await JobDataCreationService.GetOrCreateLocationWithCountryAsync(
                    podName, podCountry, "PORT");
            }

            // ==========================================
            // INVOICE TABLE PARSING
            // ==========================================
            var invoiceRow = rows.FirstOrDefault(x => x.Section == "INVOICE");
            if (invoiceRow != null)
            {
                var invFields = invoiceRow.Fields;

                EditModel.JobShipperInvNo = GetField(invFields, 73);
                EditModel.JobShipperInvDate = ParseDate(GetField(invFields, 7));

                // =============== CONSIGNEE / SUPPLIER (BE) ==================
                string supplierName = GetField(invFields, 22);

                var consigneeDict = new Dictionary<string, string>
{
    { "Consignee Address Line 1", GetField(invFields, 23) },
    { "Consignee Address Line 2", GetField(invFields, 24) },
    { "Consignee Address Line 3", GetField(invFields, 25) },

    { "Consignee Phone", extractedData.GetValueOrDefault("ConsigneePhone") },
    { "Consignee Email", extractedData.GetValueOrDefault("ConsigneeEmail") }
};

                if (!string.IsNullOrWhiteSpace(supplierName))
                {
                    EditModel.JobConsigneeId = await JobDataCreationService.GetOrCreateConsigneeIdAsync(
                        supplierName,
                        consigneeDict
                    );
                }

                EditModel.JobConsigneeAddress =
                    $"{consigneeDict["Consignee Address Line 1"]} {consigneeDict["Consignee Address Line 2"]} {consigneeDict["Consignee Address Line 3"]}"
                    .Trim();

            }

            // ==========================================
            // ITEMS TABLE PARSING
            // ==========================================
            var itemRow = rows.FirstOrDefault(x => x.Section == "ITEMS");
            if (itemRow != null)
            {
                var itemFields = itemRow.Fields;

                EditModel.JobGoodsDesc = GetField(itemFields, 11);
                EditModel.JobHsnCode = GetField(itemFields, 21);

                // ✅ Item Quantity se total packages milega
                EditModel.JobQty = SafeParseDouble(GetField(itemFields, 8));
                EditModel.JobQtyUnit = GetField(itemFields, 9);

                EditModel.JobBrand = GetField(itemFields, 17);
                EditModel.JobCountryOrigin = GetField(itemFields, 20);
            }

            // ==========================================
            // EXCHANGE TABLE PARSING
            // ==========================================
            var exchangeRow = rows.FirstOrDefault(x => x.Section == "EXCHANGE");
            if (exchangeRow != null)
            {
                var exFields = exchangeRow.Fields;
                EditModel.JobExchRate = SafeParseDouble(GetField(exFields, 9));
            }

            // ==========================================
            // ✅ IGMS TABLE - YAHA SE SAHI DATA MILEGA
            // ==========================================
            var igmsRow = rows.FirstOrDefault(x => x.Section == "IGMS");
            if (igmsRow != null)
            {
                var igmsFields = igmsRow.Fields;
                Console.WriteLine($"🔍 IGMS Fields Count: {igmsFields.Count}");

                // Print all fields for debugging


                // ✅ BL Number - Field 12 (Position 13)
                EditModel.JobBlNo = GetField(igmsFields, 12);

                // ✅ BL Date - Field 13 (Position 14)
                string blDateStr = GetField(igmsFields, 13);
                EditModel.JobBlDate = ParseDate(blDateStr);

                // ✅ No of Packages - Field 16 (Position 17)
                string packagesStr = GetField(igmsFields, 16);
                EditModel.JobQty = SafeParseInt(packagesStr);
                EditModel.JobQtyUnit = GetField(igmsFields, 17);  // Package Type
                Console.WriteLine($"📦 Packages: {packagesStr} {EditModel.JobQtyUnit}");

                // ✅ Gross Weight - Field 18 (Position 19)
                string grossWtStr = GetField(igmsFields, 18);
                EditModel.JobGrossWt = SafeParseDouble(grossWtStr);
                EditModel.JobGrossUnit = GetField(igmsFields, 19);  // Unit
                Console.WriteLine($"⚖️ Gross Weight: {grossWtStr} {EditModel.JobGrossUnit}");

                // ✅ Marks and Numbers - Fields 20, 21, 22 (Positions 21, 22, 23)
                EditModel.JobMarks = GetField(igmsFields, 20, 21, 22);
                Console.WriteLine($"📝 Marks: {EditModel.JobMarks}");
            }
            else
            {
                Console.WriteLine("⚠️ IGMS section not found!");
            }

            // ==========================================
            // ✅ CONTAINER TABLE - CORRECT PARSING
            // ==========================================
            var containerRows = rows.Where(x => x.Section == "CONTAINER").ToList();
            Console.WriteLine($"📦 Found {containerRows.Count} containers");

            int count20 = 0, count40 = 0;
            var numbers20 = new List<string>();
            var numbers40 = new List<string>();

            foreach (var row in containerRows)
            {
                var f = row.Fields;

                Console.WriteLine($"Container Fields Count: {f.Count}");
                for (int i = 0; i < f.Count && i < 12; i++)  // Print first 12 fields
                {
                    Console.WriteLine($"CONTAINER[{i}] = '{f[i]}'");
                }

                if (f.Count >= 10)
                {
                    // ✅ METHOD 1: Use Field[4] - has type indicator
                    // Format: "FTTNU9840812074" or "TTNU9840812"
                    // F = 20ft FCL, other = check by length/pattern
                    string field4 = GetField(f, 4);

                    // ✅ METHOD 2: Pure container number from Field[9]
                    string containerNumber = GetField(f, 9);  // "TTNU9840812"

                    Console.WriteLine($"📦 Field[4]: {field4}");
                    Console.WriteLine($"📦 Field[9]: {containerNumber}");

                    // Skip if empty
                    if (string.IsNullOrWhiteSpace(containerNumber))
                        continue;

                    // ✅ Determine size from Field[4] pattern
                    bool is20ft = false;
                    bool is40ft = false;

                    if (field4.StartsWith("F"))
                    {
                        // "F" prefix usually indicates 20ft FCL
                        is20ft = true;
                    }
                    else if (field4.Length > 11)
                    {
                        // Longer format might be 40ft
                        // Check if it has specific 40ft indicators
                        string sizeCode = field4.Length >= 13 ? field4.Substring(11, 2) : "";

                        if (sizeCode == "45" || sizeCode == "42" || sizeCode == "40")
                            is40ft = true;
                        else
                            is20ft = true;  // Default to 20ft
                    }
                    else
                    {
                        // Standard 11-char container = typically 20ft
                        is20ft = true;
                    }

                    // ✅ Alternative: Check container number prefix patterns
                    // Common 20ft: TTNU, TCLU, TEMU, etc. (standard containers)
                    // Common 40ft: Usually same prefixes but with HC suffix
                    string prefix = containerNumber.Length >= 4 ? containerNumber.Substring(0, 4) : "";

                    // Store container type from prefix
                    if (string.IsNullOrEmpty(EditModel.JobContainerType))
                        EditModel.JobContainerType = prefix;

                    Console.WriteLine($"📏 Detected: 20ft={is20ft}, 40ft={is40ft}");

                    // Count and store
                    if (is20ft)
                    {
                        count20++;
                        numbers20.Add(containerNumber);
                    }
                    else if (is40ft)
                    {
                        count40++;
                        numbers40.Add(containerNumber);
                    }
                }
            }

            EditModel.Job20Ft = count20.ToString();
            EditModel.Job40Ft = count40.ToString();
            EditModel.JobContainer20Ft = string.Join(", ", numbers20);
            EditModel.JobContainer40Ft = string.Join(", ", numbers40);


        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ BE_MAIN ERROR → {ex.Message}");
            Console.WriteLine($"Stack Trace: {ex.StackTrace}");
            throw;
        }
    }



