@using FreightBKShippingWebApp.Components.Pages.Account
@using FreightBKShippingWebApp.Components.Pages.CargoPage
@using FreightBKShippingWebApp.Components.Pages.CountryPage
@using FreightBKShippingWebApp.Components.Pages.CurrencyPage
@using FreightBKShippingWebApp.Components.Pages.NotifyPage
@using FreightBKShippingWebApp.Components.Pages.StationPort
@using FreightBKShippingWebApp.Components.Pages.Statuspage
@using FreightBKShippingWebApp.Components.Pages.VesselPage
@using FreightBKShippingWebApp.Model
@using FreightBKShippingWebApp.Models
@using FreightBKShippingWebApp.Services

    @inject JobService JobService
    @inject AccountService AccountService
    @inject VesselService VesselService
    @inject CargoService CargoService
    @inject ToasteService ToastService
    @inject NotifyService NotifyService
    @inject LocationService LocationService
    @inject CountryService CountryService
    @inject CurrencyService CurrencyService
    @inject YearStatechangeService YearStatechangeService
    @inject NavigationManager NavigationManager
    @inject PdfDetailedExtractorService PdfExtractor
    @inject JobDataCreationService JobDataCreationService
    @inject LoadingService LoadingService
@inject BranchService BranchService
@inject StatusService StatusService
@inject VoucherService VoucherService
<DxPopup @bind-Visible="Visible"
ShowCloseButton="true"
HeaderText="@PopupTitle"
Scrollable="true"
MaxWidth="1360" 
MinWidth="200"
 BodyCssClass="my-popup-body"
         CloseOnOutsideClick="false" horizontalAlignment="HorizontalAlignment.Center"
         verticalAlignment="VerticalAlignment.Center" ShowFooter="true" >
         <BodyContentTemplate Context="bdy">
        <EditForm Model="@EditModel" OnValidSubmit="HandleValidSubmit" Context="ctxjobaddedit" id="jobForm">

        <DataAnnotationsValidator />
       @*  <ValidationSummary /> *@

        <DxFormLayout>
                <DxFormLayoutItem Caption="Branch" ColSpanMd="3">
                <DxComboBox Data="@branchList" TData="Branch" TValue="int?"
                                TextFieldName="BranchName"
                                ValueFieldName="BranchId"
                                 Value="@EditModel.JobBranchId"
                                ValueChanged="@((int? voucherId) => OnBranchChanged(voucherId))"
                    ValueExpression="@( () => EditModel.JobBranchId )"
                                AllowUserInput="true"
                                SearchMode="ListSearchMode.AutoSearch"
                                SearchFilterCondition="ListSearchFilterCondition.Contains"
                                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" CssClass="editor-smooth" />
                  
                </DxFormLayoutItem>
            <!-- Basic Info -->
            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="Job No" ColSpanMd="3">
                <div class="d-flex gap-1">
                     @*    <DxTextBox @bind-Text="EditModel.JobPrefix" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"></DxTextBox> *@
                    <DxTextBox @bind-Text="EditModel.JobNo"   ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" ShowValidationIcon="true"/>
                       @*  <DxTextBox @bind-Text="EditModel.JobSufix" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" /> *@
                </div>
            </DxFormLayoutItem>

            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="Job Date" ColSpanMd="3">
                    <DxDateEdit @bind-Date="EditModel.JobDate" Format="dd-MM-yyyy" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
            </DxFormLayoutItem>

            <DxFormLayoutItem CaptionCssClass="caption-bold"
            Caption="@($"Import {(JobType == "IMPORT" ? ".be file" : ".sb file")}")"
            ColSpanMd="3">
                <Template>
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-cloud-upload"></i>
                        <InputFile OnChange="HandleUpload"
                        accept=".sb,.dat,.be"
                        class="form-control" />
                    </div>
                </Template>
            </DxFormLayoutItem>


            <DxFormLayoutTabPages >
                <DxFormLayoutTabPage Caption="Job Info" >
                    <DxFormLayoutGroup Decoration="FormLayoutGroupDecoration.None">
                        <DxFormLayoutGroup ColSpanMd="6" Decoration="FormLayoutGroupDecoration.None">

                            <DxFormLayoutItem Caption="@PartyCaption" ColSpanMd="12"  CaptionCssClass="caption-bold">
                                <div style="position: relative; display: inline-block; width: 100%;">
                                    <DxButton Click="@(() => ShowAccountPopup())"
                                    Text="+"
                                    CssClass="custom-plus-button" />
                                    <DxComboBox Data="@party"
                                    TextFieldName="AccountName"
                                    ValueFieldName="AccountId"
                                    Value="@EditModel.JobPartyId"
                                    ValueChanged="@((int? value) => OnImporterChanged(value))"
                                    ValueExpression="@(() => EditModel.JobPartyId)"
                                    NullText="Select Importer.."
                                    AllowUserInput="true"
                                    ShowValidationIcon="true"
                                    ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                    SearchMode="ListSearchMode.AutoSearch"
                                    SearchFilterCondition="ListSearchFilterCondition.Contains" ShowDropDownButton="true"
                                    CssClass="editor-smooth"
                                    InputCssClass="input-smooth"
                                    />

                                </div>
                            </DxFormLayoutItem>

                            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="@AddressCaption" ColSpanMd="12" >
                                <DxMemo @bind-Text="EditModel.JobPartyAddress" Rows="3"   ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" CssClass="editor-smooth"></DxMemo>
                            </DxFormLayoutItem>

                            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="High Seas" ColSpanMd="12">
                                <div style="position: relative; display: inline-block; width: 100%;">
                                    <DxButton Click="@(() => ShowAccountPopup())"
                                    Text="+"
                                    CssClass="custom-plus-button" />
                                    <DxComboBox Data="@party"
                                    TextFieldName="AccountName"
                                    ValueFieldName="AccountId"
                                    Value="@EditModel.JobHighSeas1"
                                    ValueChanged="@((int? value) => OnHighSeasChanged(value))"
                                    ValueExpression="@(() => EditModel.JobHighSeas1)"
                                    NullText="Select High Seas.."
                                                    AllowUserInput="true" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                    SearchMode="ListSearchMode.AutoSearch"
                                    SearchFilterCondition="ListSearchFilterCondition.Contains" CssClass="editor-smooth" />
                                </div>
                            </DxFormLayoutItem>

                            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="High Seas Address" ColSpanMd="12">
                                <DxMemo @bind-Text="EditModel.JobHighseas1Address" Rows="3"  ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" CssClass="editor-smooth"></DxMemo>
                            </DxFormLayoutItem>

                            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="Agent" ColSpanMd="12">
                                <DxTextBox @bind-Text="EditModel.JobAgent"  ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" CssClass="editor-smooth"></DxTextBox>
                            </DxFormLayoutItem>

                            <DxFormLayoutItem  CaptionCssClass="caption-bold" Caption="Agent Address" ColSpanMd="12">
                                <DxMemo @bind-Text="EditModel.JobAgentAddress"   ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" Rows="3" CssClass="editor-smooth"></DxMemo>
                            </DxFormLayoutItem>

                            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="Cargo" ColSpanMd="12">
                                <div style="position: relative; display: inline-block; width: 100%;">
                                    <DxButton Click="@(() => newpopupcargo())"
                                    Text="+"
                                    CssClass="custom-plus-button" />
                                    <DxComboBox Data="@cargos"
                                    TextFieldName="CargoName"
                                    ValueFieldName="CargoId"
                                    Value="@EditModel.JobCargoId"
                                    ValueChanged="@((int? value) => OnCargoChanged(value))"
                                    ValueExpression="@(() => EditModel.JobCargoId)"
                                    NullText="Select Cargo..."
                                    AllowUserInput="true"
                                                    ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                    SearchMode="ListSearchMode.AutoSearch"
                                    SearchFilterCondition="ListSearchFilterCondition.Contains" CssClass="editor-smooth" />
                                </div>
                            </DxFormLayoutItem>

                            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="Cargo Desc" ColSpanMd="12">
                                <DxMemo @bind-Text="EditModel.JobGoodsDesc" Rows="3"  ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"CssClass="editor-smooth"></DxMemo>
                            </DxFormLayoutItem>


                            <DxFormLayoutItem  CaptionCssClass="caption-bold" Caption="Prd. Brand" ColSpanMd="12">
                                <DxTextBox @bind-Text="EditModel.JobBrand"  ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" CssClass="editor-smooth" />
                            </DxFormLayoutItem>
                            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="HSN" ColSpanMd="12">
                                <DxTextBox @bind-Text="EditModel.JobHsnCode"  ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" CssClass="editor-smooth" />
                            </DxFormLayoutItem>

                            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="Vessel" ColSpanMd="12">
                                <div style="position: relative; display: inline-block; width: 100%;">
                                    <DxButton Click="newpopupVessel"
                                    Text="+"
                                    CssClass="custom-plus-button" />
                                    <DxComboBox Data="@vessels"
                                    TextFieldName="VesselName"
                                    ValueFieldName="VesselId"
                                    @bind-Value="EditModel.JobVesselId"
                                    NullText="Select Importer.." AllowUserInput="true"
                                                    SearchMode="ListSearchMode.AutoSearch" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                    SearchFilterCondition="ListSearchFilterCondition.Contains" CssClass="editor-smooth" />
                                </div>
                            </DxFormLayoutItem>

                            <DxFormLayoutItem CaptionCssClass="caption-bold"  Caption="Line" ColSpanMd="12">
                                <div style="position: relative; display: inline-block; width: 100%;">
                                    <DxButton Click="@(()=>newpopuplines("LINE"))"
                                    Text="+"
                                    CssClass="custom-plus-button" />

                                    <DxComboBox Data="@lines" TextFieldName="NotifyName"
                                    ValueFieldName="NotifyId" @bind-Value="EditModel.JobLineId"
                                    NullText="Select Line..." AllowUserInput="true"
                                                    SearchMode="ListSearchMode.AutoSearch" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                    SearchFilterCondition="ListSearchFilterCondition.Contains" CssClass="editor-smooth" />
                                </div>

                            </DxFormLayoutItem>
                            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="Default Currency " ColSpanMd="12">
                                 <div style="position: relative; display: inline-block; width: 100%;">
                                    <DxButton Click="newpopupcurrency"
                                    Text="+"
                                    CssClass="custom-plus-button" />
                                <DxComboBox Data="@Currencies" @bind-Value="EditModel.JobDefCurrId"
