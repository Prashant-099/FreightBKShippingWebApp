                                    <DxButton Click="@(()=>newpopuplines("CONSIGNOR"))"
                                    Text="+"
                                    CssClass="custom-plus-button" />
                                    <DxComboBox Data="@consignor"
                                    @bind-Value="EditModel.JobSupplierId" TextFieldName="NotifyName"
                                    ValueFieldName="NotifyId" AllowUserInput="true"
                                                    SearchMode="ListSearchMode.AutoSearch" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                    SearchFilterCondition="ListSearchFilterCondition.Contains" CssClass="editor-smooth" />
                                </div>
                            </DxFormLayoutItem>
                        </DxFormLayoutGroup>






                        <DxFormLayoutGroup Decoration="FormLayoutGroupDecoration.None">

                            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="CHA" ColSpanMd="6">
                                <div style="position: relative; display: inline-block; width: 100%;">
                                    <DxButton Click="@(()=>newpopuplines("CHA"))"
                                    Text="+"
                                    CssClass="custom-plus-button" />
                                    <DxComboBox Data="@chaList"
                                    @bind-Value="EditModel.JobChaId" TextFieldName="NotifyName"
                                    ValueFieldName="NotifyId" AllowUserInput="true"
                                                    SearchMode="ListSearchMode.AutoSearch" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                    SearchFilterCondition="ListSearchFilterCondition.Contains" CssClass="editor-smooth" />
                                </div>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem  CaptionCssClass="caption-bold" Caption="Shipper" ColSpanMd="6">
                                <div style="position: relative; display: inline-block; width: 100%;">
                                    <DxButton Click="@(()=>newpopuplines("SHIPPER"))"
                                    Text="+"
                                    CssClass="custom-plus-button" />
                                    <DxComboBox Data="@shippers"
                                    TextFieldName="NotifyName" ValueFieldName="NotifyId"
                                    @bind-Value="EditModel.JobShipperId"
                                    NullText="Select Shipper..." AllowUserInput="true"
                                    SearchMode="ListSearchMode.AutoSearch" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                    SearchFilterCondition="ListSearchFilterCondition.Contains" CssClass="editor-smooth" />
                                </div>
                            </DxFormLayoutItem>





                            <DxFormLayoutItem  CaptionCssClass="caption-bold" Caption="Booking No." ColSpanMd="6">
                                <DxTextBox @bind-Text="EditModel.JobBookingNo"  ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" CssClass="editor-smooth" />
                            </DxFormLayoutItem>
                            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="Exchange Rate" ColSpanMd="6">
                                <DxSpinEdit @bind-Value="EditModel.JobExchRate" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" ShowSpinButtons=false CssClass="editor-smooth" />
                            </DxFormLayoutItem>
                         @*<DxFormLayoutItem CaptionCssClass="caption-bold" Caption="CFS" ColSpanMd="6">
                                <DxTextBox @bind-Text="EditModel.JobCfs"  ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" CssClass="editor-smooth" />
                            </DxFormLayoutItem>*@   


                            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="Status" ColSpanMd="6">
                                <div style="position: relative; display: inline-block; width: 100%;">
                                    <DxButton Click="newpopupstastus"
                                    Text="+"
                                    CssClass="custom-plus-button" />

                                <DxComboBox Data="@statuslist" TData="Status" TValue="String"
                                @bind-Value="EditModel.JobState" 
                                AllowUserInput="true"
                                SearchMode="ListSearchMode.AutoSearch" 
                                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                SearchFilterCondition="ListSearchFilterCondition.Contains"
                                                CssClass="editor-smooth" TextFieldName="StatusName"
                                                ValueFieldName="StatusName"></DxComboBox>
                                                </div>
                            </DxFormLayoutItem>
