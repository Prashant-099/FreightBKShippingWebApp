                                                    SearchMode="ListSearchMode.AutoSearch" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                SearchFilterCondition="ListSearchFilterCondition.Contains" CssClass="editor-smooth"></DxComboBox>
                                </div>
                            </DxFormLayoutItem>


                        </DxFormLayoutGroup>


                        <DxFormLayoutGroup  ColSpanMd="6" Decoration="FormLayoutGroupDecoration.None">
                            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="BL No" ColSpanMd="6">
                                    <DxTextBox @bind-Text="EditModel.JobBlNo" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" CssClass="editor-smooth" />
                            </DxFormLayoutItem>

                            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="Date" ColSpanMd="6">
                                    <DxDateEdit @bind-Date="EditModel.JobBlDate" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" DisplayFormat="dd/MM/yyyy" CssClass="editor-smooth" />
                            </DxFormLayoutItem>
                            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="HBL No" ColSpanMd="6">
                                    <DxTextBox @bind-Text="EditModel.JobHblNo" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" CssClass="editor-smooth" />
                            </DxFormLayoutItem>

                            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="Date" ColSpanMd="6">
                                <DxDateEdit @bind-Date="EditModel.JobHblDate" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" DisplayFormat="dd/MM/yyyy" CssClass="editor-smooth" />
                            </DxFormLayoutItem>
                            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="BE No" ColSpanMd="6">
                                    <DxTextBox @bind-Text="EditModel.JobBeNo" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" CssClass="editor-smooth" />
                            </DxFormLayoutItem>

                            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="Date" ColSpanMd="6">
                                    <DxDateEdit @bind-Date="EditModel.JobBeDate" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" DisplayFormat="dd/MM/yyyy" CssClass="editor-smooth" />
                            </DxFormLayoutItem>

                            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="Shipper Inv No" ColSpanMd="6">
                                <DxTextBox @bind-Text="EditModel.JobShipperInvNo"  ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" CssClass="editor-smooth" />
                            </DxFormLayoutItem>

                            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="Date" ColSpanMd="6">
                                    <DxDateEdit @bind-Date="EditModel.JobShipperInvDate" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" DisplayFormat="dd/MM/yyyy" CssClass="editor-smooth" />
                            </DxFormLayoutItem>


                            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="Gross Weight" ColSpanMd="6">
                                    <DxSpinEdit @bind-Value="EditModel.JobGrossWt" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" ShowSpinButtons=false CssClass="editor-smooth" />
                            </DxFormLayoutItem>

                            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="Unit" ColSpanMd="6">
                                <DxComboBox Data="@weightUnits" @bind-Value="EditModel.JobGrossUnit" AllowUserInput="true"
                                SearchMode="ListSearchMode.AutoSearch" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                SearchFilterCondition="ListSearchFilterCondition.Contains" CssClass="editor-smooth"></DxComboBox>
                            </DxFormLayoutItem>


                            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="Net Weight" ColSpanMd="6">
                                <DxSpinEdit @bind-Value="EditModel.JobNetWt"  ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" ShowSpinButtons=false CssClass="editor-smooth" />
                            </DxFormLayoutItem>
                            <DxFormLayoutItem  CaptionCssClass="caption-bold" Caption="Unit" ColSpanMd="6">
                                <DxComboBox Data="@weightUnits" @bind-Value="EditModel.JobNetUnit" AllowUserInput="true"
                                SearchMode="ListSearchMode.AutoSearch"  ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                SearchFilterCondition="ListSearchFilterCondition.Contains" CssClass="editor-smooth"></DxComboBox>
                            </DxFormLayoutItem>


                            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="Quantity" ColSpanMd="6">
                                <DxSpinEdit @bind-Value="EditModel.JobQty"  ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" ShowSpinButtons=false CssClass="editor-smooth" />

                            </DxFormLayoutItem>

                            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="Unit" ColSpanMd="6">
                                <DxComboBox Data="@weightUnits" @bind-Value="EditModel.JobQtyUnit" AllowUserInput="true"
                                SearchMode="ListSearchMode.AutoSearch" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                SearchFilterCondition="ListSearchFilterCondition.Contains" CssClass="editor-smooth"></DxComboBox>
                            </DxFormLayoutItem>

                            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="CBM" ColSpanMd="12">
                                <DxSpinEdit @bind-Value="EditModel.JobCbm"  ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" ShowSpinButtons=false CssClass="editor-smooth" />
                            </DxFormLayoutItem>
                            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="POL" ColSpanMd="12">
                                <div style="position: relative; display: inline-block; width: 100%;">
                                    <DxButton Click="@(()=>newpopuplocation())"
                                    Text="+"
                                    CssClass="custom-plus-button" />
                                    <DxComboBox Data="@locationList"
                                    @bind-Value="EditModel.JobPolId" TextFieldName="LocationName"
                                    ValueFieldName="LocationId" AllowUserInput="true"
                                                    SearchMode="ListSearchMode.AutoSearch" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                    SearchFilterCondition="ListSearchFilterCondition.Contains" CssClass="editor-smooth"></DxComboBox>
                                </div>
                            </DxFormLayoutItem>

                            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="POD" ColSpanMd="12">
                                <DxComboBox Data="@locationList" @bind-Value="EditModel.JobPodId"
                                TextFieldName="LocationName" ValueFieldName="LocationId" AllowUserInput="true"
                                SearchMode="ListSearchMode.AutoSearch"  ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                SearchFilterCondition="ListSearchFilterCondition.Contains" CssClass="editor-smooth"></DxComboBox>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="Place of Delivery" ColSpanMd="12">
                                <DxTextBox @bind-Text="EditModel.JobPlaceOfDelivery" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"  CssClass="editor-smooth"/>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="Place of Receipt" ColSpanMd="12">
                                <DxTextBox @bind-Text="EditModel.JobPlaceOfReceipt" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" CssClass="editor-smooth" />
                            </DxFormLayoutItem>
                            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="Country of Origin" ColSpanMd="12">
                                <div style="position: relative; display: inline-block; width: 100%;">
                                    <DxButton Click="newpopupcountry"
                                    Text="+"
                                    CssClass="custom-plus-button" />
                                    <DxComboBox Data="@countryList"
                                    @bind-Value="EditModel.JobCountryOrigin"
                                    TextFieldName="CountryName" ValueFieldName="CountryName" AllowUserInput="true"
                                    SearchMode="ListSearchMode.AutoSearch" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                    SearchFilterCondition="ListSearchFilterCondition.Contains" CssClass="editor-smooth" />
                                </div>
                            </DxFormLayoutItem>


                            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="Certificate Origin" ColSpanMd="12">
                                <DxTextBox @bind-Text="EditModel.JobCertiOrigin"  ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" CssClass="editor-smooth" ></DxTextBox>
                            </DxFormLayoutItem>

                            <DxFormLayoutItem CaptionCssClass="caption-bold" Caption="Consignee" ColSpanMd="12">
                                <div style="position: relative; display: inline-block; width: 100%;">
                                    <DxButton Click="@(()=>newpopuplines("CONSIGNEE"))"
                                    Text="+"
                                    CssClass="custom-plus-button" />
                                    <DxComboBox Data="@consignees" TextFieldName="NotifyName"
                                    ValueFieldName="NotifyId" @bind-Value="EditModel.JobConsigneeId"
                                    NullText="Select Consignor..." AllowUserInput="true"
