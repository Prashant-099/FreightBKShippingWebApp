        extractedData["PortCode"] = GetField(f, 1);
        extractedData["PortOfOrigin"] = GetField(f, 20);
        extractedData["PortOfShipment"] = GetField(f, 24);
        extractedData["CountryOfOrigin"] = GetField(f, 22);
        extractedData["CountryOfConsignment"] = GetField(f, 23);

        // ---------------------------
        // WEIGHTS
        // ---------------------------
        extractedData["GrossWeight"] = GetField(f, 36);
        extractedData["UnitOfMeasurement"] = GetField(f, 37);

        // ---------------------------
        // INVOICE DETAILS (from INVOICE table)
