@page "/unit"
@using FreightBKShippingWebApp.Model
@using FreightBKShippingWebApp.Models
@using FreightBKShippingWebApp.Services
@using FreightBKShippingWebApp.Components.Pages
@inject UnitService UnitService
@inject ToasteService ToastService
@inject LoadingService LoadingService
@inject ConfirmationDialogService ConfirmDialogService
@inject GridLayoutService GridLayoutService
<style>
    .grid-size {
        max-height: 600px;
    }


    /* ComboBox Styling */
    .layout-combobox {
        border-radius: 6px;
        width: 185px;
    }
</style>
<DxGrid TItem="Unit"
        Data="@unitList"
        @ref="MyGrid"
        KeyFieldName="UnitId"
        ShowSearchBox="true"
        PageSize="10"
        PageSizeSelectorVisible="true"
        ShowGroupPanel="true"
        FilterMenuButtonDisplayMode="GridFilterMenuButtonDisplayMode.Always"
        FocusedRowEnabled="true"
        SelectionMode="GridSelectionMode.Multiple"
        SelectedDataItems="@SelectedUnits"
        SelectedDataItemsChanged="OnSelectedUnitsChanged"
        ColumnResizeMode="GridColumnResizeMode.NextColumn"
        CssClass="grid-size"
        AllowSelectRowByClick="true">

    <ToolbarTemplate>
        <DxToolbar>
            <TitleTemplate Context="tl">
                <div class="d-flex align-items-center">
                    <i class="bi bi-box"></i>
                    <span class="fs-5 ms-2">Units</span>
                </div>
            </TitleTemplate>
            <Items>
                <DxToolbarItem Text="Add" IconCssClass="bi bi-plus-circle" Click="OnCreateNew" />
                <DxToolbarItem Text="Edit" IconCssClass="bi bi-pencil-square" Click="OnEdit" />
                <DxToolbarItem Text="Delete" IconCssClass="bi bi-trash" Click="OnDelete" />
                <DxToolbarItem Text="Refresh" IconCssClass="bi bi-arrow-clockwise" Click="@(async (_) => await LoadUnitsAsync())" />
                <DxToolbarItem Alignment="ToolbarItemAlignment.Right"
                               RenderStyle="ButtonRenderStyle.Secondary"
                               IconCssClass="bi bi-gear-wide-connected"
                               Click="ShowLayoutPopup" />
            </Items>
        </DxToolbar>

    </ToolbarTemplate>

    <Columns>

        <DxGridSelectionColumn Width="30"
                               FixedPosition="GridColumnFixedPosition.Left" />

        <DxGridDataColumn FieldName="UnitId"
                          Caption="ID"
                          Width="@(layoutManager?.GetColumnWidth("UnitId") ?? "80px")"
                          Visible="@(layoutManager?.GetColumnVisibility("UnitId") ?? false)" />

        <DxGridDataColumn FieldName="UnitName"
                          Caption="Unit Name"
                          Width="@(layoutManager?.GetColumnWidth("UnitName") ?? "320px")"
                          Visible="@(layoutManager?.GetColumnVisibility("UnitName") ?? true)" />

        <DxGridDataColumn FieldName="UnitFormalName"
                          Caption="Formal Name"
                          Width="@(layoutManager?.GetColumnWidth("UnitFormalName") ?? "320px")"
                          Visible="@(layoutManager?.GetColumnVisibility("UnitFormalName") ?? true)" />

        <DxGridDataColumn FieldName="UnitGstUnit"
                          Caption="Group Name"
                          Width="@(layoutManager?.GetColumnWidth("UnitGstUnit") ?? "290px")"
                          Visible="@(layoutManager?.GetColumnVisibility("UnitGstUnit") ?? true)" />

        <DxGridDataColumn FieldName="UnitCreated"
                          Caption="Created"
                          DisplayFormat="dd/MM/yyyy"
                          Width="@(layoutManager?.GetColumnWidth("UnitCreated") ?? "200px")"
                          Visible="@(layoutManager?.GetColumnVisibility("UnitCreated") ?? true)" />

        <DxGridDataColumn FieldName="UnitUpdated"
                          Caption="Updated"
                          DisplayFormat="dd/MM/yyyy"
                          Width="@(layoutManager?.GetColumnWidth("UnitUpdated") ?? "200px")"
                          Visible="@(layoutManager?.GetColumnVisibility("UnitUpdated") ?? true)" />

        <DxGridDataColumn FieldName="UnitStatus"
                          Caption="Active"
                          Width="@(layoutManager?.GetColumnWidth("UnitStatus") ?? "130px")"
                          Visible="@(layoutManager?.GetColumnVisibility("UnitStatus") ?? true)" />

    </Columns>
</DxGrid>

<UnitAddEditPage @ref="popup" OnSaved="LoadUnitsAsync" />

<ConfirmationDialog />
<GridLayoutpPopup @ref="layoutManager"
                  VoucherType="Unit"
                  Columns="@allColumns"
                  OnLayoutChanged="HandleLayoutChanged" />
@code {
    DxGrid MyGrid;
    private List<Unit> unitList = [];
    // private List<Unit> SelectedUnits = new();
    private IReadOnlyList<object> SelectedUnits { get; set; } = new List<object>();

    private UnitAddEditPage popup;

    // All possible columns
    private GridLayoutpPopup? layoutManager;
    private List<GridColumnLayout> allColumns = [];
    private async void ShowLayoutPopup()
    {
        await InvokeAsync(() =>
        {
            layoutManager?.ShowPopup();
        });
    }
    private async Task HandleLayoutChanged(List<GridColumnLayout> updatedLayout)
    {
        allColumns = updatedLayout;
        // Force the grid to re-render with new layout
        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnInitializedAsync()
    {
        InitializeColumns();
        await LoadUnitsAsync();
       
    }
    private void InitializeColumns()
    {
        allColumns = new List<GridColumnLayout>
        {
        new(){ FieldName = "UnitId", Caption = "ID", Visible = false, Width = 80, DisplayIndex = 0 },

        new(){ FieldName = "UnitName", Caption = "Unit Name", Visible = true, Width = 320, DisplayIndex = 1 },

        new(){ FieldName = "UnitFormalName", Caption = "Formal Name", Visible = true, Width = 320, DisplayIndex = 2 },

        new(){ FieldName = "UnitGstUnit", Caption = "Group Name", Visible = true, Width = 290, DisplayIndex = 3 },

         new(){ FieldName = "UnitStatus", Caption = "Active", Visible = true, Width = 130, DisplayIndex = 4 },

        new(){ FieldName = "UnitCreated", Caption = "Created", Visible = true, Width = 200, DisplayIndex = 5},

        new(){ FieldName = "UnitUpdated", Caption = "Updated", Visible = true, Width = 200, DisplayIndex = 6 }
    };
       
    }

   
    private async Task LoadUnitsAsync()
    {
        LoadingService.Show("Loading units...");
        try
        {
            unitList = await UnitService.GetAllAsync();
        }
        finally
        {
            LoadingService.Hide();
        }
    }

    private async Task OnSelectedUnitsChanged(IReadOnlyList<object> units)
    {
        SelectedUnits = units ?? new List<object>();
        await InvokeAsync(StateHasChanged);
    }
    // ✅ FIXED: Reliable clear selection method
    private async Task ClearSelectionManual()
    {
        try
        {
            if (MyGrid != null)
            {
                MyGrid.ClearSelection(); // ✅ Synchronous method
            }
            SelectedUnits = new List<Unit>();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Clear selection error: {ex.Message}");
        }
    }

    // ✅ FIXED: Auto-clear after operations
    private async Task ClearSelection()
    {
        await Task.Delay(100); // Small delay for UI update
        await ClearSelectionManual();
    }
    private void OnCreateNew(ToolbarItemClickEventArgs e)
    {
        popup.Show(new Unit()
        {
            UnitStatus = true,
            UnitCreated = DateTime.Now
        });
    }

    private async Task OnEdit(ToolbarItemClickEventArgs e)
    {
        var unit = MyGrid.GetFocusedDataItem() as Unit;
        if (unit != null)
            popup.Show(unit);
        else
            ToastService.Warning("Please select a unit to edit.");
        await ClearSelection();
    }

    private async Task OnDelete(ToolbarItemClickEventArgs e)
    {
        if (SelectedUnits == null || SelectedUnits.Count == 0)
        {
            ToastService.Warning("Please select at least one unit to delete.");
            return;
        }
        var selectedList = SelectedUnits.Cast<Unit>().ToList();

        var confirm = await ConfirmDialogService.ShowAsync(
            $"Are you sure you want to delete {SelectedUnits.Count} selected unit(s)?");
        if (!confirm)
        {
            await ClearSelection(); // ✅ Clear on cancel
            return;
        }
        try
        {
            LoadingService.Show("Deleting...");
            int successCount = 0, failCount = 0;

        foreach (var unit in selectedList)
        {
            var result = await UnitService.DeleteAsync(unit.UnitId);
            if (result)
                successCount++;
            else
                failCount++;
        }

        if (successCount > 0)
            ToastService.Success($"{successCount} Unit(s) deleted successfully.");

        if (failCount > 0)
            ToastService.Error($"{failCount} Unit(s) failed to delete.");

        await LoadUnitsAsync();
        }
        finally
        {
            LoadingService.Hide();
            await ClearSelection(); // ✅ Clear after delete (success or fail)
        }
    }
}
