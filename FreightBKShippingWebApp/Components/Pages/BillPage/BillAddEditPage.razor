    /// <summary>
    /// STAGE 1: Load ONLY data needed to display the form immediately
    /// This runs FIRST and FAST (2-4 API calls max)
    /// </summary>
    private async Task LoadCriticalDataAsync()
    {
        try
        {
            // ✅ Only load what's ABSOLUTELY needed for initial render
            var jobTask = JobService.GetAllAsync();
            var accountTask = AccountService.GetAllAsync();
            var stateTask = StateService.GetStatesAsync();
            var companyTask = CompanyService.GetAllAsync();
            var branchtask = BranchService.GetAllAsync();
            await Task.WhenAll(jobTask, accountTask, companyTask, stateTask, branchtask);

            // Set critical data
            JobList = jobTask.Result;
            FilteredJobList = JobList;
            branchList = branchtask.Result;
            CompanyList = companyTask.Result;
            var allAccounts = accountTask.Result;
            AccountList = allAccounts.Where(a => a.AccountTypeId == 14 || a.AccountTypeId == 18).ToList();
            BankList = allAccounts.Where(a => a.AccountTypeId == 10).ToList();

            stateList = stateTask.Result;
            StateList = stateTask.Result;

            isCriticalDataLoaded = true;
            StateHasChanged(); // ✅ Form can now render!
        }
        catch (Exception ex)
        {
            ToastService.Error("Error loading critical data: " + ex.Message);
            Console.WriteLine($"❌ LoadCriticalDataAsync error: {ex}");
        }
    }

    // ============================================
    // 🎯 STAGE 2: Load Background Data (Non-Blocking)
    // ============================================
    /// <summary>
    /// STAGE 2: Load remaining dropdown data in BACKGROUND
    /// User can already interact with form while this loads
    /// </summary>
    private async Task LoadBackgroundDataAsync()
    {
        try
        {
            // ✅ Load common dropdowns that might be used soon
            var serviceTask = ServiceService.GetAllAsync();
            var voucherTask = VoucherService.GetAllAsync();
            var currTask = CurrencyService.GetAllAsync();
            var unitTask = UnitService.GetAllAsync();
            var hsnTask = HsnSacService.GetAllAsync();
            var gstTask = GstSlabService.GetAllAsync();
            var notifyTask = NotifyService.GetAllAsync();
            var rateTask = RateMasterService.GetAllAsync();

            var reportTask = ReportDataService.GetAllAsync();
            await Task.WhenAll(
                serviceTask, voucherTask, currTask, unitTask,rateTask,
                hsnTask, gstTask, notifyTask,  reportTask
            );

            // Assign results
            RateMasterList = rateTask.Result;
            ReportDataList  = reportTask.Result;

            ServiceList = serviceTask.Result;
            VoucherList = voucherTask.Result.Where(v =>
        !string.IsNullOrWhiteSpace(v.VoucherGroup) &&
        (
            v.VoucherGroup.Trim().Equals("SALES", StringComparison.OrdinalIgnoreCase) ||
            v.VoucherGroup.Trim().Equals("CREDIT NOTE", StringComparison.OrdinalIgnoreCase) ||
            v.VoucherGroup.Trim().Equals("DEBIT NOTE", StringComparison.OrdinalIgnoreCase) ||
            v.VoucherGroup.Trim().Equals("PURCHASE", StringComparison.OrdinalIgnoreCase)
        ))
    .ToList();
            CurrList = currTask.Result;
            UnitList = unitTask.Result;
            HsnList = hsnTask.Result;
            GstslabList = gstTask.Result;

            var allNotify = notifyTask.Result;
            ConsigneeList = allNotify.Where(n => n.NotifyType == "CONSIGNEE").ToList();
            ShipperList = allNotify.Where(n => n.NotifyType == "SHIPPER").ToList();
            LineList = allNotify.Where(n => n.NotifyType == "LINE").ToList();

            isBackgroundDataLoaded = true;
            StateHasChanged(); // ✅ Dropdowns now populated
        }
        catch (Exception ex)
        {
            ToastService.Error("Error loading background data: " + ex.Message);
            Console.WriteLine($"❌ LoadBackgroundDataAsync error: {ex}");
        }
    }

