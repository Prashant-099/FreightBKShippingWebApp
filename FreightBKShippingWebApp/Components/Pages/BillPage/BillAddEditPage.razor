    // Grid Layout Management Variables
    private List<GridLayoutDto> availableGridLayouts = [];
    private int? selectedGridLayoutId;
    private bool showGridLayoutDialog = false;
    private string newGridLayoutName = "";
    private string gridLayoutDialogTitle = "";
    private bool isEditGridLayoutMode = false;
    private bool isDefaultGridLayout = false;
    private const string GRID_VOUCHER_TYPE = "BillDetail";

    private List<GridColumnLayout> allGridColumns = [];
    private List<GridColumnLayout> currentGridLayout = [];

    private string ConvertNumberToWords(decimal number)
    {
        if (EditModel == null)
            return string.Empty;

        if (number == 0)
        {
            EditModel.BillAmountInWord = "Zero Rupees Only";
            return EditModel.BillAmountInWord;
        }

        string[] unitsMap = { "Zero", "One", "Two", "Three", "Four", "Five", "Six", "Seven", "Eight", "Nine", "Ten", "Eleven", "Twelve", "Thirteen", "Fourteen", "Fifteen", "Sixteen", "Seventeen", "Eighteen", "Nineteen" };
        string[] tensMap = { "Zero", "Ten", "Twenty", "Thirty", "Forty", "Fifty", "Sixty", "Seventy", "Eighty", "Ninety" };

        string ConvertIntPart(long n)
        {
            if (n == 0)
                return "";
            if (n < 20)
                return unitsMap[n];
            if (n < 100)
                return tensMap[n / 10] + (n % 10 > 0 ? " " + unitsMap[n % 10] : "");
            if (n < 1000)
                return unitsMap[n / 100] + " Hundred" + (n % 100 > 0 ? " and " + ConvertIntPart(n % 100) : "");
            if (n < 100000)
                return ConvertIntPart(n / 1000) + " Thousand" + (n % 1000 > 0 ? " " + ConvertIntPart(n % 1000) : "");
            if (n < 10000000)
                return ConvertIntPart(n / 100000) + " Lakh" + (n % 100000 > 0 ? " " + ConvertIntPart(n % 100000) : "");
            return ConvertIntPart(n / 10000000) + " Crore" + (n % 10000000 > 0 ? " " + ConvertIntPart(n % 10000000) : "");
        }

        long intPart = (long)Math.Floor(number);
        int decimalPart = (int)((number - intPart) * 100);

        string words = ConvertIntPart(intPart) + " Rupees";
        if (decimalPart > 0)
            words += " and " + ConvertIntPart(decimalPart) + " Paise";

        EditModel.BillAmountInWord = words + " Only";
        return EditModel.BillAmountInWord;
    }

    // Keep ParseWidth helper for loading saved widths
    private int ParseWidth(string width)
    {
        if (string.IsNullOrEmpty(width))
            return 100;

        // Remove "px" suffix if present
        width = width.Replace("px", "").Trim();

        if (int.TryParse(width, out int result))
            return result;

        return 100; // default
    }

    // Enhanced InitializeGridColumns with proper width values
    private void InitializeGridColumns()
    {
        allGridColumns = new List<GridColumnLayout>
    {
