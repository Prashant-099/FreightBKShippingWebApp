    // ============================================
    // 📝 Show Method (Remains mostly the same)
    // ============================================
    public async void Show(Bill bill)
    {
        // ✅ Show loading only if critical data not loaded
        if (!isCriticalDataLoaded)
        {
            LoadingService.Show("Loading form...");
            await LoadCriticalDataAsync();
            LoadingService.Hide();
        }
        // Create EditContext when showing the form
        // editContext = new EditContext(EditModel);
        if (bill?.BillId > 0)
        {
            EditModel = bill;
            OnJobTypeChanged(EditModel.BillJobType);

            BillDetails = bill.BillDetails?
                .Select(d => CloneBillDetail(d))
                .OrderBy(d => d.BillDetailId)
                .ToList() ?? new List<BillDetail>();

            nextSNo = BillDetails.Any() ? BillDetails.Max(d => d.BillDetailSno) + 1 : 1;

            int existingRowCount = BillDetails.Count;
            int rowsToAdd = Math.Max(0, 5 - existingRowCount);

            for (int i = 0; i < rowsToAdd; i++)
            {
                BillDetails.Add(new BillDetail
                    {
                        BillDetailSno = nextSNo++,
                        BillDetailId = 0,
                        BillDetailExchRate = EditModel?.BillExchRate ?? 1,
                        BillDetailCurrencyId = EditModel.BillDefaultCurrencyId,
                        BillDetailQty = 1,
                        BillDetailRate = 0,
                        BillDetailAmount = 0,
                        BillDetailTaxableAmt = 0,
                        BillDetailGstPer = 0,
                        BillDetailCgstPer = 0,
                        BillDetailSgstPer = 0,
                        BillDetailIgstPer = 0,
                        BillDetailCgst = 0,
                        BillDetailSgst = 0,
                        BillDetailIgst = 0,
                        BillDetailTotal = 0,
                        BillDetailStatus = true
                    });
            }

            Title = "Edit Bill";
        }
        else
        {
            var defaultBranch = branchList.FirstOrDefault(b => b.Branchisdefault);

            var selectedCompany = CompanyList?.FirstOrDefault(c => c.Status == true);
            EditModel = new Bill
                {
                    BillBranchId=defaultBranch.BranchId,
                    BillDate = DateTime.Now,
                    BillStatus = true,
                    BillPlaceOfSupply =selectedCompany.StateId,
                    BillDetails = new List<BillDetail>()
                };
            BillDetails = new List<BillDetail>();
            nextSNo = 1;
            Title = "Add Bill";
            InitializeInvoiceDetails();
        }

        UnsavedChanges.Clear();

        Visible = true;
        StateHasChanged();
        _ =GetLocationListAsync();
        _ =GetCargoListAsync();
        _ =GetVesselListAsync();
    }

