<style>

    /* ComboBox Styling */
    .layout-combobox {
        border-radius: 6px;
        width: 185px;
    }
    .modal-xl {
    max-width: 900px;
    }

    .fixed-height-grid {
    max-height: 300px
    }

    .popup-content-container {
    display: flex;
    flex-direction: column;
    height: 42vh; /* controls popup height */
    }

    /* Scrollable form section */
    .form-scroll-section {
    flex: 1;
    overflow-y: auto;
    padding-right: 8px;
    /*  margin-bottom: 70px; */ /* leave space for sticky footer */
    }

    /* Fixed footer bar inside popup */
    .popup-footer-bar {
    position: sticky;
    bottom: 0;
    background-color: #f8f9fa;
    border-top: 1px solid #ddd;
    /*  padding: 10px 20px; */
    text-align: right;
    z-index: 10;
    box-shadow: 0 -2px 6px rgba(0, 0, 0, 0.1);
    }
    /*  .sticky-top {
    position: sticky;
    top: 0;
    z-index: 10;
    background-color: #f8f9fa;
    } */
    .service-plus-button {
    font-size: 0.9rem;
    width: 28px;
    height: 28px;
    padding: 0;
    border-radius: 50%;
    line-height: 26px;
    text-align: center;
    font-weight: bold;
    background-color: #7976ff;
    color: white;
    box-shadow: 0 0 3px rgba(0,0,0,0.2);
    border: none;
    cursor: pointer;
    flex-shrink: 0;
    }

    .service-plus-button:hover {
    background-color: #5f5ce6;
    }

    .table-responsive {
    border: 1px solid #dee2e6;
    border-radius: 0.25rem;
    }

    .layout-toolbar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px;
    background-color: #f8f9fa;
    border-bottom: 1px solid #dee2e6;
    }

    .layout-toolbar label {
    font-weight: 600;
    margin-right: 4px;
    }
