@page "/bill"
@using FreightBKShippingWebApp.Components.Pages.Eiinvoice_IRN_
@using FreightBKShippingWebApp.Components.Pages.Wp_mail_Configpagess
@using FreightBKShippingWebApp.Model
@using FreightBKShippingWebApp.Services
@using FreightBKShippingWebApp.Components.Pages
@using Microsoft.AspNetCore.Components.Authorization
@inject BillService BillService
@inject ToasteService ToastService
@inject LoadingService LoadingService
@inject ConfirmationDialogService ConfirmDialogService
@inject NavigationManager Navigation
@inject ReportService ReportService
@inject ReportDataService ReportDataService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JSRuntime

<DxGrid @ref="MyGrid"
TItem="Bill"
Data="@billList"
KeyFieldName="BillId"
ShowSearchBox="true"
PageSize="10"
PageSizeSelectorVisible="true"
ShowGroupPanel="true"
FilterMenuButtonDisplayMode="GridFilterMenuButtonDisplayMode.Always"
FocusedRowEnabled="true"
SelectionMode="GridSelectionMode.Multiple"
SelectedDataItems="@SelectedBills"
SelectedDataItemsChanged="OnSelectedBillsChanged"
AllowSelectRowByClick="true">

    <ToolbarTemplate>
        <DxToolbar>
            <TitleTemplate Context="tl">
                <div class="d-flex align-items-center">
                    <i class="bi bi-receipt-cutoff"></i>
                    <span class="fs-5">Sale Invoice</span>
                    @*       @if (SelectedBills?.Count > 0)
                    {
                        <span class="badge bg-primary ms-2">@SelectedBills.Count Selected</span>
                    } *@
                </div>
            </TitleTemplate>
            <Items>
                <DxToolbarItem Text="Add" IconCssClass="bi bi-plus-circle" Click="OnCreateNew" />
                <DxToolbarItem Text="Edit" IconCssClass="bi bi-pencil-square" Click="OnEdit" />
                <DxToolbarItem Text="Delete" IconCssClass="bi bi-trash" Click="OnDelete" />
                <DxToolbarItem Text="E-Invoice" IconCssClass="bi bi-file-earmark-text" Click="OnEInvoiceClick" />
                <DxToolbarItem Text="Cancel E-Invoice" IconCssClass="bi bi-file-earmark-text" Click="OnCancelIrnClick" />
                <DxToolbarItem Text="IRN Details" IconCssClass="bi bi-file-earmark-text" Click="ShowIrnDetails" />
                <DxToolbarItem Text="Send WhatsApp" IconCssClass="bi bi-whatsapp" Click="@(async () => await DownloadReport(true))" />
                <DxToolbarItem Text="Print PDF" IconCssClass="bi bi-printer" Click="@(async () => await PrintReports(false))" />
                <DxToolbarItem Text="Print" IconCssClass="bi bi-printer" Click="@((_) => ShowReportPopup())"></DxToolbarItem>
                <DxToolbarItem Text="Refresh" IconCssClass="bi bi-arrow-clockwise" Click="@(async (_) => await LoadBillsAsync())" />
                @if (IsAdmin)
                {
                    <DxToolbarItem Text="@GetLockButtonText()" IconCssClass="@GetLockButtonIcon()" Click="OnToggleLock" />
                }
                <DxToolbarItem Text="Clear Selection" IconCssClass="bi bi-x-circle" Click="@(async (_) => await ClearSelectionManual())" Visible="@(SelectedBills?.Count > 0)" />
            </Items>
        </DxToolbar>
    </ToolbarTemplate>

    <Columns>
        <DxGridDataColumn FieldName="BillId" Caption="ID" Visible="false" />
        <DxGridSelectionColumn Width="30" />
        <DxGridDataColumn FieldName="BillLockedByUsername" Caption="Locked By" Width="120">
            <CellDisplayTemplate>
                @{
                    var bill = context.DataItem as Bill;
                    if (!string.IsNullOrEmpty(bill?.BillLockedByUsername))
                    {
                        <span class="badge bg-warning text-dark">
                            <i class="bi bi-lock-fill"></i>
                            @bill.BillLockedByUsername
                        </span>
                    }
                    else
                    {
                        <span class="text-muted">—</span>
                    }
                }
            </CellDisplayTemplate>
        </DxGridDataColumn>
        <DxGridDataColumn FieldName="BillAckNo" Caption="AKNO" Width="120" />
        <DxGridDataColumn FieldName="BillNo" Caption="Invoice No" Width="120" />
        <DxGridDataColumn FieldName="BillDate" Caption="Invoice Date" DisplayFormat="d" Width="120" />
        <DxGridDataColumn FieldName="BillDueDate" Caption="Due Date" Width="120" />
        <DxGridDataColumn FieldName="BillJobNo" Caption="Job No" Width="120" />
        <DxGridDataColumn FieldName="BillJobType" Caption="Job Type" Width="120" />
        <DxGridDataColumn FieldName="partyname" Caption="Customer" Width="180" />
        <DxGridDataColumn FieldName="Vouchname" Caption="Voucher Type" Width="120" />
        <DxGridDataColumn FieldName="BillBlNo" Caption="BL_No" Width="120" />
        <DxGridDataColumn FieldName="BillGstNo" Caption="GST No" Width="120" />
        <DxGridDataColumn FieldName="posname" Caption="Place of Supply" Width="120" />
        <DxGridDataColumn FieldName="Bill20Ft" Caption="C_20FT" Width="120" />
        <DxGridDataColumn FieldName="Bill40Ft" Caption="C_40FT" Width="120" />
        <DxGridDataColumn FieldName="BillSbNo" Caption="SB_No" Width="120" />
        <DxGridDataColumn FieldName="BillSbDate" Caption="SB_Date" Width="120" />
        <DxGridDataColumn FieldName="BillTotal" Caption="Basic Amount" Width="120" />
        <DxGridDataColumn FieldName="BillCgst" Caption="CGST" Width="120" />
        <DxGridDataColumn FieldName="BillSgst" Caption="SGST" Width="120" />
        <DxGridDataColumn FieldName="BillIgst" Caption="IGST" Width="120" />
        <DxGridDataColumn FieldName="BillNetAmount" Caption="Total Amount" Width="120" />
        <DxGridDataColumn FieldName="BillSupplyType" Caption="Supply Type" Width="120" />
        <DxGridDataColumn FieldName="BillShipParty" Caption="Ship To" Width="180" />
        <DxGridDataColumn FieldName="BillCreated" Caption="Created At" Width="120" />
        <DxGridDataColumn FieldName="BillUpdated" Caption="Updated At" Width="120" />
        <DxGridDataColumn FieldName="BillStatus" Caption="Status" Width="100" Visible="false" />
    </Columns>
</DxGrid>

<DxPopup @bind-Visible="IsReportPopupVisible"
ShowCloseButton="true"
Width="400px"
HeaderText="Select Report"
CloseOnOutsideClick="true"
CloseOnEscape="true">
    <div class="p-3">
        <DxFormLayout>
            <DxFormLayoutItem Caption="Report" ColSpanMd="12">
                <DxComboBox Data="@ReportDataList"
                TextFieldName="FormatName"
                ValueFieldName="ReportDataId"
                AllowUserInput="true"
                NullText="-- Select Report --"
                @bind-Value="SelectedReportId"
                SearchMode="ListSearchMode.AutoSearch"
                SearchFilterCondition="ListSearchFilterCondition.StartsWith"
                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
            </DxFormLayoutItem>
        </DxFormLayout>
        <div class="mt-3 d-flex justify-content-end gap-2">
            <DxButton Text="OK" RenderStyle="ButtonRenderStyle.Primary" IconCssClass="bi bi-box-arrow-right" Click="@ConfirmReportSelection" />
            <DxButton Text="Cancel" RenderStyle="ButtonRenderStyle.Danger" IconCssClass="bi bi-x-circle" Click="@(() => IsReportPopupVisible = false)" />
        </div>
    </div>
</DxPopup>

<BillAddEditPage @ref="popup" OnSaved="LoadBillsAsync" />
<EInvoicePopUP @ref="EInvoicePopupRef" />
<FreightBKShippingWebApp.Components.Pages.Eiinvoice_IRN_.CancelingEInvoices @ref="EInvoiceCancelPopupRef" OnCancelIRN="HandleIRNCancelled"></FreightBKShippingWebApp.Components.Pages.Eiinvoice_IRN_.CancelingEInvoices>
<SendMsg IsVisible="visiblemsgsendwin"
OnClose="closemsgsendwin"
DefaultNumber="@PendingMobileNo"
DefaultFileUrl="@PendingFileUrl"
DefaultFileName="@PendingFileName"
@ref="sendMsgPopup" />
<ConfirmationDialog />

<script>
    window.downloadFileFromStream = async (fileName, contentStreamReference) => {
    const arrayBuffer = await contentStreamReference.arrayBuffer();
    const blob = new Blob([arrayBuffer]);
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = fileName;
    a.click();
    URL.revokeObjectURL(url);
    };
</script>
<IRNDetailsFetch @ref="irnDetailsPopup" />
@code {
	private IRNDetailsFetch irnDetailsPopup;
    private void ShowIrnDetails(ToolbarItemClickEventArgs e)
    {
        var bills = SelectedBills.Cast<Bill>().ToList();
        irnDetailsPopup.Show(bills);
    }

    /// <summary>
    /// 
    /// </summary>
    /// <param name="e"></param>
    /// <returns></returns>

    // Cancel IRN

    private async Task OnCancelIrnClick(ToolbarItemClickEventArgs e)
    {
        if (SelectedBills == null || SelectedBills.Count == 0)
        {
            ToastService.Warning("Please select at least one bill.");
            return;
        }

        // Cast to Bill objects first
        var bills = SelectedBills.Cast<Bill>().ToList();

        // Check if any selected bills have IRN
        var billsWithIrn = bills.Where(b => !string.IsNullOrWhiteSpace(b.BillIrnNo)).ToList();

        if (!billsWithIrn.Any())
        {
            ToastService.Error("Selected bills don't have any generated IRN.");
            return;
        }

        // Pass the typed list to the popup
        EInvoiceCancelPopupRef.Show(bills);
    }
    // Handle after E-Invoice generation
    private async Task HandleEInvoiceGenerated(List<Bill> bills)
    {
        await LoadBillsAsync();
        await ClearSelection();
    }

    // Handle after IRN cancellation
    private async Task HandleIRNCancelled(List<Bill> bills)
    {
        await LoadBillsAsync();
        await ClearSelection();
    }



    /// <summary>
    /// =====================================================================
    /// </summary>
    private IGrid? MyGrid { get; set; }
    private List<Bill> billList = new();
    private IReadOnlyList<object> SelectedBills { get; set; } = new List<object>();
    private List<ReportData> ReportDataList = new();
    private BillAddEditPage popup;
    private bool IsAdmin = false;
    private string CurrentUserId = string.Empty;
    private EInvoicePopUP EInvoicePopupRef { get; set; }
    private CancelingEInvoices EInvoiceCancelPopupRef { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await CheckUserRole();
        await LoadBillsAsync();
    }

    // ✅ FIXED: Proper selection change handler with immediate state update
    private async Task OnSelectedBillsChanged(IReadOnlyList<object> newSelection)
    {
        SelectedBills = newSelection ?? new List<object>();
        await InvokeAsync(StateHasChanged);
    }

    // ✅ FIXED: Reliable clear selection method
    private async Task ClearSelectionManual()
    {
        try
        {
            if (MyGrid != null)
            {
                MyGrid.ClearSelection(); // ✅ Synchronous method
            }
            SelectedBills = new List<object>();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Clear selection error: {ex.Message}");
        }
    }

    // ✅ FIXED: Auto-clear after operations
    private async Task ClearSelection()
    {
        await Task.Delay(100); // Small delay for UI update
        await ClearSelectionManual();
    }

    private async Task CheckUserRole()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            CurrentUserId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
            IsAdmin = user.IsInRole("Admin");
        }
    }

    private string GetLockButtonText()
    {
        if (SelectedBills == null || SelectedBills.Count == 0)
            return "Lock";

        var selectedBillsList = SelectedBills.Cast<Bill>().ToList();
        return selectedBillsList.Any(b => string.IsNullOrEmpty(b.BillLockedBy)) ? "Lock" : "Unlock";
    }

    private string GetLockButtonIcon()
    {
        if (SelectedBills == null || SelectedBills.Count == 0)
            return "bi bi-lock";

        var selectedBillsList = SelectedBills.Cast<Bill>().ToList();
        return selectedBillsList.Any(b => string.IsNullOrEmpty(b.BillLockedBy)) ? "bi bi-lock" : "bi bi-unlock";
    }

    // ✅ FIXED: Toggle lock with proper cleanup
    private async Task OnToggleLock(ToolbarItemClickEventArgs e)
    {
        if (SelectedBills == null || SelectedBills.Count == 0)
        {
            ToastService.Warning("Please select at least one bill.");
            return;
        }

        try
        {
            LoadingService.Show("Processing...");
            var selectedBillsList = SelectedBills.Cast<Bill>().ToList();
            int locked = 0, unlocked = 0;

            foreach (var bill in selectedBillsList)
            {
                bool isCurrentlyLocked = !string.IsNullOrEmpty(bill.BillLockedBy);
                var result = await BillService.ToggleLockAsync(bill.BillId);

                if (result)
                {
                    if (isCurrentlyLocked)
                    {
                        bill.BillLockedBy = string.Empty;
                        bill.BillLockedByUsername = string.Empty;
                        unlocked++;
                    }
                    else
                    {
                        bill.BillLockedBy = CurrentUserId;
                        bill.BillLockedByUsername = "You";
                        locked++;
                    }
                }
            }

            await LoadBillsAsync();

            if (locked > 0) ToastService.Success($"{locked} bill(s) locked.");
            if (unlocked > 0) ToastService.Success($"{unlocked} bill(s) unlocked.");
        }
        catch (Exception ex)
        {
            ToastService.Error($"Error: {ex.Message}");
        }
        finally
        {
            LoadingService.Hide();
            await ClearSelection();
        }
    }

    private async Task LoadBillsAsync()
    {
        try
        {
            LoadingService.Show();
            billList = await BillService.GetAllAsync();
            LoadingService.Hide();
            await InvokeAsync(StateHasChanged);

            ReportDataList = await ReportDataService.GetAllAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            ToastService.Error($"Error loading bills: {ex.Message}");
            LoadingService.Hide();
        }
    }

    private void OnCreateNew(ToolbarItemClickEventArgs e)
    {
        popup.Show(new Bill
            {
                BillDate = DateTime.Now,
                BillStatus = true
            });
    }

    // ✅ FIXED: Edit with proper cleanup
    private async Task OnEdit(ToolbarItemClickEventArgs e)
    {
        var bill = MyGrid?.GetFocusedDataItem() as Bill;

        if (bill == null)
        {
            ToastService.Warning("Please select a bill to edit.");
            return;
        }

        if (!string.IsNullOrEmpty(bill.BillLockedBy))
        {
            ToastService.Error($"This bill is locked by {bill.BillLockedByUsername} and cannot be edited.");
            return;
        }

        popup.Show(bill);
        await ClearSelection();
    }

    // ✅ FIXED: Delete with proper cleanup (clear selection on cancel/delete)
    private async Task OnDelete(ToolbarItemClickEventArgs e)
    {
        if (SelectedBills == null || SelectedBills.Count == 0)
        {
            ToastService.Warning("Please select at least one bill to delete.");
            return;
        }

        var selectedBillsList = SelectedBills.Cast<Bill>().ToList();
        var lockedBills = selectedBillsList.Where(b => !string.IsNullOrEmpty(b.BillLockedBy)).ToList();

        if (lockedBills.Any())
        {
            ToastService.Error($"{lockedBills.Count} bill(s) are locked and cannot be deleted.");
            await ClearSelection(); // ✅ Clear on locked error
            return;
        }

        var confirm = await ConfirmDialogService.ShowAsync(
            $"Are you sure you want to delete {selectedBillsList.Count} selected bill(s)?");

        if (!confirm)
        {
            await ClearSelection(); // ✅ Clear on cancel
            return;
        }

        try
        {
            LoadingService.Show("Deleting...");
            int successCount = 0, failCount = 0;

            foreach (var bill in selectedBillsList)
            {
                var result = await BillService.DeleteAsync(bill.BillId);
                if (result) successCount++; else failCount++;
            }

            if (successCount > 0) ToastService.Success($"{successCount} Bill(s) Deleted Successfully.");
            if (failCount > 0) ToastService.Error($"{failCount} Bill(s) Failed To Delete.");

            await LoadBillsAsync();
        }
        finally
        {
            LoadingService.Hide();
            await ClearSelection(); // ✅ Clear after delete (success or fail)
        }
    }

    // ✅ FIXED: E-Invoice with proper cleanup   
    private async Task OnEInvoiceClick(ToolbarItemClickEventArgs e)
    {
        if (SelectedBills == null || SelectedBills.Count == 0)
        {
            ToastService.Warning("Please select at least one bill.");
            return;
        }

        EInvoicePopupRef.Show(SelectedBills.Cast<Bill>().ToList());
        await LoadBillsAsync();
        await ClearSelection();
    }

    // ✅ FIXED: WhatsApp send with proper cleanup
    private async Task DownloadReport(bool sendViaWhatsapp = false)
    {
        if (SelectedBills == null || SelectedBills.Count == 0)
        {
            ToastService.Warning("Select at least one bill.");
            return;
        }

        var billList = SelectedBills.Cast<Bill>().ToList();
        var distinctReportIds = billList.Select(b => b.BillReportId).Distinct().ToList();

        if (distinctReportIds.Count > 1)
        {
            ToastService.Warning("Please select bills with the same report format for WhatsApp sending.");
            return;
        }

        int reportId = distinctReportIds.First();
        LoadingService.Show(sendViaWhatsapp ? "Generating PDF for WhatsApp..." : "Generating merged PDF...");

        try
        {
            (byte[] pdfBytes, string fileName, string blobUrl) result =
                await Sentwpcerti.GenerateAndUploadReportAsync(billList, reportId, sendViaWhatsapp);

            if (sendViaWhatsapp)
            {
                if (string.IsNullOrEmpty(result.blobUrl))
                {
                    ToastService.Warning("PDF upload failed. WhatsApp sending may not work.");
                    return;
                }

                var firstBill = billList.First();
                PendingMobileNo = firstBill.BillContactNo;
                PendingFileUrl = result.blobUrl;
                PendingFileName = result.fileName;
                visiblemsgsendwin = true;

                if (string.IsNullOrEmpty(PendingMobileNo))
                {
                    ToastService.Warning("No mobile number found for the selected bill.");
                }

                if (sendMsgPopup != null)
                {
                    await sendMsgPopup.CheckCreditsAsync();
                }
            }
            else
            {
                var base64 = Convert.ToBase64String(result.pdfBytes);
                await JSRuntime.InvokeVoidAsync("downloadFileFromBytes", result.fileName, base64);
                ToastService.Success("Report downloaded successfully.");
            }
        }
        catch (Exception ex)
        {
            ToastService.Error($"Error: {ex.Message}");
        }
        finally
        {
            LoadingService.Hide();
            await ClearSelection();
        }
    }

    // ✅ FIXED: Print PDF with proper cleanup
    private async Task PrintReports(bool sendViaWhatsapp = false)
    {
        if (SelectedBills == null || SelectedBills.Count == 0)
        {
            ToastService.Warning("Select at least one Bill.");
            return;
        }

        var billList = SelectedBills.Cast<Bill>().ToList();
        LoadingService.Show("Building merged PDF...");

        try
        {
            var billsByReportId = billList.GroupBy(b => b.BillReportId).ToList();
            var allReports = new List<DevExpress.XtraReports.UI.XtraReport>();

            foreach (var group in billsByReportId)
            {
                var reportId = group.Key;
                var groupBills = group.ToList();
                var layoutBytes = await ReportDataService.GetLayoutBytesAsync(reportId);

                if (layoutBytes == null || layoutBytes.Length == 0)
                {
                    ToastService.Error($"Failed to load report layout for Report ID: {reportId}");
                    continue;
                }

                var dtoList = new List<PrintBillFullDto?>();
                foreach (var bill in groupBills)
                {
                    var dto = await BillService.GetPrintableBillAsync(bill.BillId);
                    dtoList.Add(dto);
                }

                var dtoDict = groupBills.Select((bill, i) => new { bill, dto = dtoList[i] })
                                        .ToDictionary(x => x.bill, x => x.dto);

                try
                {
                    await ReportService.CreateMergedReportAsync(
                        groupBills,
                        bill => dtoDict.ContainsKey(bill) ? dtoDict[bill] : null,
                        layoutBytes);
                }
                catch (InvalidOperationException ex) when (ex.Message.Contains("CodeDOM"))
                {
                    ToastService.Error("Report format incompatible. Please contact administrator to update report template.");
                    LoadingService.Hide();
                    return;
                }

                if (ReportService.MergedReport != null)
                {
                    allReports.Add(ReportService.MergedReport);
                }
            }

            if (!allReports.Any())
            {
                ToastService.Error("Failed to generate any reports.");
                return;
            }

            using var pdfStream = new MemoryStream();

            if (allReports.Count == 1)
            {
                allReports[0].ExportToPdf(pdfStream);
            }
            else
            {
                var combinedReport = new DevExpress.XtraReports.UI.XtraReport();
                foreach (var report in allReports)
                {
                    if (report.Pages.Count == 0) report.CreateDocument();
                    foreach (DevExpress.XtraPrinting.Page page in report.Pages)
                    {
                        combinedReport.Pages.Add(page);
                    }
                }
                combinedReport.ExportToPdf(pdfStream);
            }

            pdfStream.Position = 0;

            string fileName = billList.Count == 1
                ? $"{billList.First().BillNo?.Replace("/", "_") ?? "Bill"}.pdf"
                : $"Bills_{billList.First().BillNo?.Replace("/", "_")}_to_{billList.Last().BillNo?.Replace("/", "_")}.pdf";

            using var streamRef = new Microsoft.JSInterop.DotNetStreamReference(pdfStream);
            await JSRuntime.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);

            ToastService.Success("PDF downloaded successfully.");
        }
        catch (Exception ex)
        {
            ToastService.Error($"Failed to generate report: {ex.Message}");
        }
        finally
        {
            LoadingService.Hide();
            await ClearSelection();
        }
    }

    private bool IsReportPopupVisible = false;
    private int? SelectedReportId;

    private async Task ShowReportPopup()
    {
        if (ReportDataList?.Any() != true)
        {
            ToastService.Warning("No reports available.");
            return;
        }
        SelectedReportId = null;
        IsReportPopupVisible = true;
    }

    private async Task ConfirmReportSelection()
    {
        if (SelectedReportId == null)
        {
            ToastService.Warning("Please select a report first.");
            return;
        }
        IsReportPopupVisible = false;
        await PreviewMergedReports();
    }

    private async Task PreviewMergedReports()
    {
        if (SelectedBills == null || SelectedBills.Count == 0)
        {
            ToastService.Warning("Select at least one Bill.");
            return;
        }

        var billList = SelectedBills.Cast<Bill>().ToList();
        LoadingService.Show("Building merged report...");

        try
        {
            // Your existing preview logic here
            Navigation.NavigateTo("/reportviewer");
        }
        catch (Exception ex)
        {
            ToastService.Error($"Failed to generate report: {ex.Message}");
        }
        finally
        {
            LoadingService.Hide();
            await ClearSelection();
        }
    }

    [Inject] private Sentwpcerti Sentwpcerti { get; set; } = default!;
