    private Bill CurrentBill; // Current bill being edited

    private async Task ExportReport(string format)
    {
        var billList = SelectedBills.ToList();
        if (!billList.Any())
        {
            ToastService.Warning("Select at least one Bill to export.");
            return;
        }

        LoadingService.Show($"Exporting to {format}...");

        try
        {
            // Group bills by their ReportId
            var billsByReportId = billList.GroupBy(b => b.BillReportId).ToList();

            // Create a list to hold all individual reports
            var allReports = new List<DevExpress.XtraReports.UI.XtraReport>();

            // Process each group of bills with same report layout
            foreach (var group in billsByReportId)
            {
                var reportId = group.Key;
                var groupBills = group.ToList();

                // Load layout for this group
                var layoutBytes = await ReportDataService.GetLayoutBytesAsync(reportId);
                if (layoutBytes == null || layoutBytes.Length == 0)
                {
                    ToastService.Error($"Failed to load report layout for Report ID: {reportId}");
                    continue;
                }

                // Load bill data for bills in this group
                var dtoList = new List<PrintBillFullDto?>();
                foreach (var bill in groupBills)
                {
                    var dto = await BillService.GetPrintableBillAsync(bill.BillId);
                    dtoList.Add(dto);
                }

                var dtoDict = groupBills.Select((bill, i) => new { bill, dto = dtoList[i] })
                                        .ToDictionary(x => x.bill, x => x.dto);

                // Create report for this group
                await ReportService.CreateMergedReportAsync(
                    groupBills,
                    bill => dtoDict.ContainsKey(bill) ? dtoDict[bill] : null,
                    layoutBytes);

                if (ReportService.MergedReport != null)
                {
                    allReports.Add(ReportService.MergedReport);
                }
            }

            if (!allReports.Any())
            {
                ToastService.Error("Failed to generate any reports.");
                return;
            }

            // Create final merged report
            DevExpress.XtraReports.UI.XtraReport finalReport;

            if (allReports.Count == 1)
            {
                finalReport = allReports[0];
            }
            else
            {
                // Merge multiple reports into one
                finalReport = new DevExpress.XtraReports.UI.XtraReport();

                foreach (var report in allReports)
                {
                    // Create the report document if not already created
                    if (report.Pages.Count == 0)
                    {
                        report.CreateDocument();
                    }

                    // Add pages from each report to the final report
                    foreach (DevExpress.XtraPrinting.Page page in report.Pages)
                    {
                        finalReport.Pages.Add(page);
                    }
                }
            }

            // Generate filename
            string fileName;
            if (billList.Count == 1)
            {
                var billNo = billList.First().BillNo?.Replace("/", "_") ?? "Bill";
                fileName = $"{billNo}";
            }
            else
            {
                var firstBill = billList.First().BillNo?.Replace("/", "_") ?? "Bill";
                var lastBill = billList.Last().BillNo?.Replace("/", "_") ?? "Bill";
                fileName = $"Bills_{firstBill}_to_{lastBill}";
            }

            // Export based on selected format
            using var exportStream = new MemoryStream();

            switch (format.ToUpper())
            {
                case "PDF":
                    finalReport.ExportToPdf(exportStream);
                    fileName += ".pdf";
                    break;

                case "XLS":
                    var xlsOptions = new DevExpress.XtraPrinting.XlsExportOptions
                    {
                        ExportMode = DevExpress.XtraPrinting.XlsExportMode.SingleFile,
                        SheetName = "Bills"
                    };
                    finalReport.ExportToXls(exportStream, xlsOptions);
                    fileName += ".xls";
                    break;

                case "XLSX":
                    var xlsxOptions = new DevExpress.XtraPrinting.XlsxExportOptions
                    {
                        ExportMode = DevExpress.XtraPrinting.XlsxExportMode.SingleFile,
                        SheetName = "Bills"
                    };
                    finalReport.ExportToXlsx(exportStream, xlsxOptions);
                    fileName += ".xlsx";
                    break;

                case "RTF":
                    var rtfOptions = new DevExpress.XtraPrinting.RtfExportOptions
                    {
                        ExportMode = DevExpress.XtraPrinting.RtfExportMode.SingleFile
                    };
                    finalReport.ExportToRtf(exportStream, rtfOptions);
                    fileName += ".rtf";
                    break;

                case "MHT":
                    var mhtOptions = new DevExpress.XtraPrinting.MhtExportOptions
                    {
                        ExportMode = DevExpress.XtraPrinting.HtmlExportMode.SingleFile
                    };
                    finalReport.ExportToMht(exportStream, mhtOptions);
                    fileName += ".mht";
                    break;

                case "HTML":
                    var htmlOptions = new DevExpress.XtraPrinting.HtmlExportOptions
                    {
                        ExportMode = DevExpress.XtraPrinting.HtmlExportMode.SingleFile
                    };
                    finalReport.ExportToHtml(exportStream, htmlOptions);
                    fileName += ".html";
                    break;

                case "TEXT":
                    var textOptions = new DevExpress.XtraPrinting.TextExportOptions
                    {
                        TextExportMode = DevExpress.XtraPrinting.TextExportMode.Text
                    };
                    finalReport.ExportToText(exportStream, textOptions);
                    fileName += ".txt";
                    break;

                case "CSV":
                    var csvOptions = new DevExpress.XtraPrinting.CsvExportOptions
                    {
                        Separator = ","
                    };
                    finalReport.ExportToCsv(exportStream, csvOptions);
                    fileName += ".csv";
                    break;

                case "IMAGE":
                    var imageOptions = new DevExpress.XtraPrinting.ImageExportOptions
                    {
                        ExportMode = DevExpress.XtraPrinting.ImageExportMode.SingleFile,
                        Format = System.Drawing.Imaging.ImageFormat.Png,
                        PageRange = finalReport.Pages.Count > 0
                            ? $"1-{finalReport.Pages.Count}"
                            : "1"
                    };
                    finalReport.ExportToImage(exportStream, imageOptions);
                    fileName += ".png";
                    break;

                case "DOCX":
                    var docxOptions = new DevExpress.XtraPrinting.DocxExportOptions
                    {
                        ExportMode = DevExpress.XtraPrinting.DocxExportMode.SingleFile
                    };
                    finalReport.ExportToDocx(exportStream, docxOptions);
                    fileName += ".docx";
                    break;

                default:
                    ToastService.Error($"Unsupported format: {format}");
                    return;
            }

            exportStream.Position = 0;

            // Download file
            using var streamRef = new Microsoft.JSInterop.DotNetStreamReference(exportStream);
            await JSRuntime.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);

            ToastService.Success($"{format} exported successfully.");
        }
        catch (Exception ex)
        {
            ToastService.Error($"Failed to export: {ex.Message}");
        }
        finally
        {
            LoadingService.Hide();
        }
    }
}