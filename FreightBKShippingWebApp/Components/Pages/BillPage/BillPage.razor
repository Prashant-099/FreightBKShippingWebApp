    private ReceiptAddEditPage? Popup;
    private void OnReceiptAdd(Bill bill)
    {
        if (bill == null)
            return;

        if (string.Equals(bill.BillType, "SALES", StringComparison.OrdinalIgnoreCase))
        {
            if (bill.Bill_due_amt <= 0)
            {
                ToastService.Warning(" Invoices is Already Settaled.");
                return;
            }

            Popup?.Show(new Journal
                    {
                        JournalDate = DateTime.Now,
                        JournalPartyId = bill.BillPartyId,
                        JournalBillId = bill.BillId,
                        JournalAmount= bill.BillNetAmount
                    }, bill.BillId);



        }

        else
        {
            ToastService.Warning("It is  Not Sale Invoices.");
        }
    }

