            {
                BillDate = DateTime.Now,
                BillStatus = true
            });
    }

    // ✅ FIXED: Edit with proper cleanup
    private async Task OnEdit(ToolbarItemClickEventArgs e)
    {
        var bill = MyGrid?.GetFocusedDataItem() as Bill;

        if (bill == null)
        {
            ToastService.Warning("Please select a bill to edit.");
            return;
        }

        if (!string.IsNullOrEmpty(bill.BillLockedBy))
        {
            ToastService.Error($"This bill is locked by {bill.BillLockedByUsername} and cannot be edited.");
            return;
        }

        popup.Show(bill);
        await ClearSelection();
    }

    // ✅ FIXED: Delete with proper cleanup (clear selection on cancel/delete)
    private async Task OnDelete(ToolbarItemClickEventArgs e)
    {
        if (SelectedBills == null || SelectedBills.Count == 0)
        {
            ToastService.Warning("Please select at least one bill to delete.");
            return;
        }

        var selectedBillsList = SelectedBills.Cast<Bill>().ToList();
        var lockedBills = selectedBillsList.Where(b => !string.IsNullOrEmpty(b.BillLockedBy)).ToList();

        // if (lockedBills.Any())
        // {
        //     ToastService.Error($"{lockedBills.Count} bill(s) are locked and cannot be deleted.");
        //     await ClearSelection(); // ✅ Clear on locked error
        //     return;
        // }

        var confirm = await ConfirmDialogService.ShowAsync(
            $"Are you sure you want to delete {selectedBillsList.Count} selected bill(s)?");

        if (!confirm)
        {
            await ClearSelection(); // ✅ Clear on cancel
            return;
        }

        try
        {
            LoadingService.Show("Deleting...");
            int successCount = 0, failCount = 0;

            foreach (var bill in selectedBillsList)
            {
                var result = await BillService.DeleteAsync(bill.BillId);
                if (result.Success) successCount++;
                else
                { failCount++; 
                    failCount++;
                    ToastService.Error(result.Error);
                }
            }

            if (successCount > 0) ToastService.Success($"{successCount} Bill(s) Deleted Successfully.");
            // if (failCount > 0) ToastService.Error($"{failCount} Bill(s) Failed To Delete.");

            await LoadBillsAsync();
        }
        finally
        {
            LoadingService.Hide();
            await ClearSelection(); // ✅ Clear after delete (success or fail)
        }
    }

    // ✅ FIXED: E-Invoice with proper cleanup   
    private async Task OnEInvoiceClick(ToolbarItemClickEventArgs e)
    {
        if (SelectedBills == null || SelectedBills.Count == 0)
        {
            ToastService.Warning("Please select at least one bill.");
            return;
        }

        EInvoicePopupRef.Show(SelectedBills.Cast<Bill>().ToList());
        await LoadBillsAsync();
        await ClearSelection();
    }

    // ✅ FIXED: WhatsApp send with proper cleanup
    private async Task DownloadReport(bool sendViaWhatsapp = false)
    {
        if (SelectedBills == null || SelectedBills.Count == 0)
        {
            ToastService.Warning("Select at least one bill.");
            return;
        }

        var billList = SelectedBills.Cast<Bill>().ToList();
        var distinctReportIds = billList.Select(b => b.BillReportId).Distinct().ToList();

        if (distinctReportIds.Count > 1)
        {
            ToastService.Warning("Please select bills with the same report format for WhatsApp sending.");
            return;
        }

        int reportId = distinctReportIds.First();
        LoadingService.Show(sendViaWhatsapp ? "Generating PDF for WhatsApp..." : "Generating merged PDF...");

        try
        {
            (byte[] pdfBytes, string fileName, string blobUrl) result =
                await Sentwpcerti.GenerateAndUploadReportAsync(billList, reportId, sendViaWhatsapp);

            if (sendViaWhatsapp)
            {
                if (string.IsNullOrEmpty(result.blobUrl))
                {
                    ToastService.Warning("PDF upload failed. WhatsApp sending may not work.");
                    return;
                }

                var firstBill = billList.First();
                PendingMobileNo = firstBill.BillContactNo;
                PendingFileUrl = result.blobUrl;
                PendingFileName = result.fileName;
                visiblemsgsendwin = true;

                if (string.IsNullOrEmpty(PendingMobileNo))
                {
                    ToastService.Warning("No mobile number found for the selected bill.");
                }

                if (sendMsgPopup != null)
                {
                    await sendMsgPopup.CheckCreditsAsync();
                }
            }
            else
            {
                var base64 = Convert.ToBase64String(result.pdfBytes);
                await JSRuntime.InvokeVoidAsync("downloadFileFromBytes", result.fileName, base64);
                ToastService.Success("Report downloaded successfully.");
            }
        }
        catch (Exception ex)
        {
            ToastService.Error($"Error: {ex.Message}");
        }
        finally
        {
            LoadingService.Hide();
            await ClearSelection();
        }
    }

    // ✅ FIXED: Print PDF with proper cleanup
    private async Task PrintReports(bool sendViaWhatsapp = false)
    {
        if (SelectedBills == null || SelectedBills.Count == 0)
        {
            ToastService.Warning("Select at least one Bill.");
            return;
        }

        var billList = SelectedBills.Cast<Bill>().ToList();
        LoadingService.Show("Building merged PDF...");

        try
        {
            var billsByReportId = billList.GroupBy(b => b.BillReportId).ToList();
            var allReports = new List<DevExpress.XtraReports.UI.XtraReport>();

            foreach (var group in billsByReportId)
            {
                var reportId = group.Key;
                var groupBills = group.ToList();
                var layoutBytes = await ReportDataService.GetLayoutBytesAsync(reportId);

                if (layoutBytes == null || layoutBytes.Length == 0)
                {
                    ToastService.Error($"Failed to load report layout for Report ID: {reportId}");
                    continue;
                }

                var dtoList = new List<PrintBillFullDto?>();
                foreach (var bill in groupBills)
                {
                    var dto = await BillService.GetPrintableBillAsync(bill.BillId);
                    dtoList.Add(dto);
                }

                var dtoDict = groupBills.Select((bill, i) => new { bill, dto = dtoList[i] })
                                        .ToDictionary(x => x.bill, x => x.dto);

                try
                {
                    await ReportService.CreateMergedReportAsync(
                        groupBills,
                        bill => dtoDict.ContainsKey(bill) ? dtoDict[bill] : null,
                        layoutBytes);
                }
                catch (InvalidOperationException ex) when (ex.Message.Contains("CodeDOM"))
                {
                    ToastService.Error("Report format incompatible. Please contact administrator to update report template.");
                    LoadingService.Hide();
                    return;
                }

                if (ReportService.MergedReport != null)
                {
                    allReports.Add(ReportService.MergedReport);
                }
            }

            if (!allReports.Any())
            {
                ToastService.Error("Failed to generate any reports.");
                return;
            }

            using var pdfStream = new MemoryStream();

            if (allReports.Count == 1)
            {
                allReports[0].ExportToPdf(pdfStream);
            }
            else
            {
                var combinedReport = new DevExpress.XtraReports.UI.XtraReport();
                foreach (var report in allReports)
                {
                    if (report.Pages.Count == 0) report.CreateDocument();
                    foreach (DevExpress.XtraPrinting.Page page in report.Pages)
                    {
                        combinedReport.Pages.Add(page);
                    }
                }
                combinedReport.ExportToPdf(pdfStream);
            }

            pdfStream.Position = 0;

            string fileName = billList.Count == 1
                ? $"{billList.First().BillNo?.Replace("/", "_") ?? "Bill"}.pdf"
                : $"Bills_{billList.First().BillNo?.Replace("/", "_")}_to_{billList.Last().BillNo?.Replace("/", "_")}.pdf";

            using var streamRef = new Microsoft.JSInterop.DotNetStreamReference(pdfStream);
            await JSRuntime.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);

            ToastService.Success("PDF downloaded successfully.");
        }
        catch (Exception ex)
        {
            ToastService.Error($"Failed to generate report: {ex.Message}");
        }
        finally
        {
            LoadingService.Hide();
            await ClearSelection();
        }
    }

