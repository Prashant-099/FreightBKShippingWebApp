@page "/bill"
@using FreightBKShippingWebApp.Components.Pages.Eiinvoice_IRN_
@using FreightBKShippingWebApp.Components.Pages.Wp_mail_Configpagess
@using FreightBKShippingWebApp.Model
@using FreightBKShippingWebApp.Services
@using FreightBKShippingWebApp.Components.Pages
@using Microsoft.AspNetCore.Components.Authorization
@inject BillService BillService
@inject ToasteService ToastService
@inject LoadingService LoadingService
@inject ConfirmationDialogService ConfirmDialogService
@inject NavigationManager Navigation
@inject ReportService ReportService
@inject ReportDataService ReportDataService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject YearStatechangeService YearStatechangeService
@inject IJSRuntime JSRuntime
@inject GridLayoutService GridLayoutService
<style>
    .grid-size {
        max-height: 600px;
    }


    /* ComboBox Styling */
    .layout-combobox {
        border-radius: 6px;
        width: 185px;
    }
</style>
<DxGrid @ref="MyGrid"
TItem="Bill"
Data="@billList"
KeyFieldName="BillId"
ShowSearchBox="true"
PageSize="10"
PageSizeSelectorVisible="true"
ShowGroupPanel="true"
FilterMenuButtonDisplayMode="GridFilterMenuButtonDisplayMode.Always"
FocusedRowEnabled="true"
SelectionMode="GridSelectionMode.Multiple"
SelectedDataItems="@SelectedBills"
SelectedDataItemsChanged="OnSelectedBillsChanged"
        ColumnResizeMode="GridColumnResizeMode.NextColumn"
        CssClass="grid-size"
        AllowSelectRowByClick="true">

    <ToolbarTemplate>
        <DxToolbar>
            <TitleTemplate Context="tl">
                <div class="d-flex align-items-center">
                    <i class="bi bi-receipt-cutoff me-2"></i>
                    <span class="fs-5">Sale Invoice</span>
                    @*       @if (SelectedBills?.Count > 0)
                    {
                        <span class="badge bg-primary ms-2">@SelectedBills.Count Selected</span>
                    } *@
                </div>
            </TitleTemplate>
            <Items>
                <DxToolbarItem Text="Add" IconCssClass="bi bi-plus-circle" Click="OnCreateNew" />
                <DxToolbarItem Text="Edit" IconCssClass="bi bi-pencil-square" Click="OnEdit" />
                <DxToolbarItem Text="Delete" IconCssClass="bi bi-trash" Click="OnDelete" />
                @if (IsAdmin)
                {
                    <DxToolbarItem Text="@GetLockButtonText()" Alignment="ToolbarItemAlignment.Left" IconCssClass="@GetLockButtonIcon()" Click="OnToggleLock" />
                }
                <DxToolbarItem  Context="cfdr"
                               Text="Print"
                               RenderStyleMode="ToolbarItemRenderStyleMode.Contained"
                               RenderStyle="ButtonRenderStyle.Secondary"
                               IconCssClass="bi bi-printer">
                    <Items>
                        <DxToolbarItem Text="Send WhatsApp" IconCssClass="bi bi-whatsapp" Click="@(async () => await DownloadReport(true))" />
                        <DxToolbarItem Text="Print PDF" IconCssClass="bi bi-printer" Click="@(async () => await PrintReports(false))" />
                        <DxToolbarItem Text="Print Preview" IconCssClass="bi bi-printer" Click="@((_) => ShowReportPopup())"></DxToolbarItem>

                    </Items>
                </DxToolbarItem>
                <DxToolbarItem  Context="cfdr"
                               Text="E-Invoice"
                               RenderStyleMode="ToolbarItemRenderStyleMode.Contained"
                               RenderStyle="ButtonRenderStyle.Secondary"
                               IconCssClass="bi bi-file-earmark-text">
                    <Items>
                        <DxToolbarItem Text="E-Invoice" IconCssClass="bi bi-file-earmark-text" Click="OnEInvoiceClick" />
                         @if (IsAdmin)
                {
                        <DxToolbarItem Text="Cancel E-Invoice" IconCssClass="bi bi-file-earmark-text" Click="OnCancelIrnClick" />
                }
                        <DxToolbarItem Text="IRN Details" IconCssClass="bi bi-file-earmark-text" Click="ShowIrnDetails" />
                    </Items>
                </DxToolbarItem>
                
                  <DxToolbarItem Text="Refresh" IconCssClass="bi bi-arrow-clockwise" Click="@(async (_) => await LoadBillsAsync())" />
             
                <DxToolbarItem Text="Clear Selection" IconCssClass="bi bi-x-circle" Click="@(async (_) => await ClearSelectionManual())" Visible="@(SelectedBills?.Count > 0)" />
       
                    <DxToolbarItem   IconCssClass="bi bi-gear-wide-connected" Alignment="ToolbarItemAlignment.Right">
                    <Template Context="ctx">
                        
                                <DxComboBox Data="@availableLayouts"
                                            Value="@selectedLayoutId"
                                            ValueExpression="@(() => selectedLayoutId)"
                                            ValueChanged="@((int? value) => OnLayoutSelectedAsync(value))"
                                            ValueFieldName="GridLayoutId"
                                            TextFieldName="GridLayoutName"
                                            NullText="Default View"
                                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                            CssClass="layout-combobox" />
                           
                    </Template>
                    
                </DxToolbarItem>
               
                <DxToolbarItem  Context="cfdr"
                               Alignment="ToolbarItemAlignment.Right"
                               RenderStyleMode="ToolbarItemRenderStyleMode.Contained"
                               RenderStyle="ButtonRenderStyle.Secondary"
                               IconCssClass="bi bi-gear-wide-connected">
                    <Items>
                        <DxToolbarItem Text="Save Current Layout"
                                       RenderStyle="ButtonRenderStyle.Primary"
                                       IconCssClass="bi bi-floppy"
                                       Click="ShowSaveLayoutDialog" />

                        <DxToolbarItem Text="Create New Layout"
                                       RenderStyle="ButtonRenderStyle.Success"
                                       IconCssClass="bi bi-plus-square"
                                       Click="ShowNewLayoutDialog" />

                        @if (selectedLayoutId.HasValue)
                        {
                            <DxToolbarItem Text="Delete Current Layout"
                                           RenderStyle="ButtonRenderStyle.Danger"
                                           IconCssClass="bi bi-trash"
                                           Click="DeleteCurrentLayout" />
                        }

                    </Items>
                </DxToolbarItem>
               
                   
               


            </Items>
        </DxToolbar>
    </ToolbarTemplate>

    <Columns>
        <DxGridSelectionColumn Width="30"
                               FixedPosition="GridColumnFixedPosition.Left" />

        <DxGridDataColumn FieldName="BillId"
                          Caption="ID"
                          Visible="@GetColumnVisibility("BillId")"
                          Width="@GetColumnWidth("BillId")" />

        <DxGridDataColumn FieldName="BillLockedByUsername"
                          Caption="Locked By"
                          Visible="@GetColumnVisibility("BillLockedByUsername")"
                          Width="@GetColumnWidth("BillLockedByUsername")">
            <CellDisplayTemplate>
                @{
                    var bill = context.DataItem as Bill;
                    if (!string.IsNullOrEmpty(bill?.BillLockedByUsername))
                    {
                        <span class="badge bg-warning text-dark">
                            <i class="bi bi-lock-fill"></i>
                            @bill.BillLockedByUsername
                        </span>
                    }
                    else
                    {
                        <span class="text-muted">—</span>
                    }
                }
            </CellDisplayTemplate>
        </DxGridDataColumn>

        <DxGridDataColumn FieldName="BillAckNo"
                          Caption="AKNO"
                          Visible="@GetColumnVisibility("BillAckNo")"
                          Width="@GetColumnWidth("BillAckNo")" />

        <DxGridDataColumn FieldName="branchname"
                          Caption="Branch"
                          Visible="@GetColumnVisibility("branchname")"
                          Width="@GetColumnWidth("branchname")" />
        <DxGridDataColumn FieldName="BillNo"
                          Caption="Invoice No"
                          Visible="@GetColumnVisibility("BillNo")"
                          Width="@GetColumnWidth("BillNo")" />

        <DxGridDataColumn FieldName="BillDate"
                          Caption="Invoice Date"
                          DisplayFormat="d"
                          Visible="@GetColumnVisibility("BillDate")"
                          Width="@GetColumnWidth("BillDate")" />

        <DxGridDataColumn FieldName="BillDueDate"
                          Caption="Due Date"
                          Visible="@GetColumnVisibility("BillDueDate")"
                          Width="@GetColumnWidth("BillDueDate")" />

        <DxGridDataColumn FieldName="BillJobNo"
                          Caption="Job No"
                          Visible="@GetColumnVisibility("BillJobNo")"
                          Width="@GetColumnWidth("BillJobNo")" />

        <DxGridDataColumn FieldName="BillJobType"
                          Caption="Job Type"
                          Visible="@GetColumnVisibility("BillJobType")"
                          Width="@GetColumnWidth("BillJobType")" />

        <DxGridDataColumn FieldName="partyname"
                          Caption="Customer"
                          Visible="@GetColumnVisibility("partyname")"
                          Width="@GetColumnWidth("partyname")" />

        <DxGridDataColumn FieldName="Vouchname"
                          Caption="Voucher Type"
                          Visible="@GetColumnVisibility("Vouchname")"
                          Width="@GetColumnWidth("Vouchname")" />

        <DxGridDataColumn FieldName="BillBlNo"
                          Caption="BL No"
                          Visible="@GetColumnVisibility("BillBlNo")"
                          Width="@GetColumnWidth("BillBlNo")" />

        <DxGridDataColumn FieldName="BillGstNo"
                          Caption="GST No"
                          Visible="@GetColumnVisibility("BillGstNo")"
                          Width="@GetColumnWidth("BillGstNo")" />

        <DxGridDataColumn FieldName="posname"
                          Caption="Place of Supply"
                          Visible="@GetColumnVisibility("posname")"
                          Width="@GetColumnWidth("posname")" />

        <DxGridDataColumn FieldName="Bill20Ft"
                          Caption="C_20FT"
                          Visible="@GetColumnVisibility("Bill20Ft")"
                          Width="@GetColumnWidth("Bill20Ft")" />

        <DxGridDataColumn FieldName="Bill40Ft"
                          Caption="C_40FT"
                          Visible="@GetColumnVisibility("Bill40Ft")"
                          Width="@GetColumnWidth("Bill40Ft")" />

        <DxGridDataColumn FieldName="BillTotal"
                          Caption="Basic Amount"
                          Visible="@GetColumnVisibility("BillTotal")"
                          Width="@GetColumnWidth("BillTotal")" />

        <DxGridDataColumn FieldName="BillNetAmount"
                          Caption="Total Amount"
                          Visible="@GetColumnVisibility("BillNetAmount")"
                          Width="@GetColumnWidth("BillNetAmount")" />

        <DxGridDataColumn FieldName="BillCreated"
                          Caption="Created At"
                          Visible="@GetColumnVisibility("BillCreated")"
                          Width="@GetColumnWidth("BillCreated")" />

        <DxGridDataColumn FieldName="BillUpdated" Caption="Updated At"
                          Visible="@GetColumnVisibility("BillUpdated")"
                          Width="@GetColumnWidth("BillUpdated")" />
        <DxGridDataColumn FieldName="BillStatus" Caption="Status" />
    </Columns>
</DxGrid>
@if (showLayoutDialog)
{
    <div class="modal fade show d-block"
         style="background-color: rgba(0, 0, 0, 0.5); z-index: 1050;"
         @onclick="@(() => { })">

        <div class="modal-dialog modal-lg" @onclick:stopPropagation="true">
            <div class="modal-content">

                <!-- Header -->
                <div class="modal-header">
                    <h5 class="modal-title">@dialogTitle</h5>
                    <button type="button"
                            class="btn-close"
                            @onclick="CloseLayoutDialog"
                            aria-label="Close">
                    </button>
                </div>

                <!-- Body -->
                <div class="modal-body">

                    <!-- Layout Name -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">Layout Name:</label>
                        <input type="text"
                               class="form-control"
                               @bind="newLayoutName"
                               @bind:event="oninput"
                               placeholder="Enter layout name..."
                               maxlength="100" />
                    </div>

                    <!-- Default Layout Checkbox -->
                    <div class="mb-3">
                        <div class="form-check">
                            <input class="form-check-input"
                                   type="checkbox"
                                   @bind="isDefaultLayout"
                                   id="defaultLayoutCheck" />

                            <label class="form-check-label" for="defaultLayoutCheck">
                                Set as Default Layout
                            </label>
                        </div>
                    </div>

                    <!-- Column Configuration -->
                    <div class="mt-3">
                        <label class="form-label fw-bold mb-2">Column Configuration:</label>

                        <div class="table-responsive"
                             style="max-height: 400px; overflow-y: auto;">

                            <table class="table table-sm table-bordered">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th style="width: 50px;">Visible</th>
                                        <th style="width: 200px;">Column Name</th>
                                        <th style="width: 150px;">Width (px)</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var col in allColumns)
                                    {
                                        <tr>
                                            <td class="text-center">
                                                <input class="form-check-input"
                                                       type="checkbox"
                                                       @bind="col.Visible"
                                                       id="col_@col.FieldName" />
                                            </td>

                                            <td>
                                                <label class="mb-0" for="col_@col.FieldName">
                                                    @col.Caption
                                                </label>
                                            </td>

                                            <td>
                                                <input type="number"
                                                       class="form-control form-control-sm"
                                                       @bind="col.Width"
                                                       @bind:event="oninput"
                                                       min="50"
                                                       max="500"
                                                       step="10"
                                                       placeholder="Width" />
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>

                        </div>
                    </div>

                    <!-- Info Note -->
                    <div class="alert alert-info mt-3">
                        <i class="bi bi-info-circle me-2"></i>
                        <strong>Note:</strong>
                        Adjust column widths here manually. The widths will be saved and applied when you load this layout.
                    </div>

                </div>

                <!-- Footer -->
                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            @onclick="CloseLayoutDialog">
                        Cancel
                    </button>

                    <button type="button"
                            class="btn btn-primary"
                            @onclick="SaveCurrentLayout">
                        <i class="bi bi-floppy me-1"></i>
                        @(isEditMode ? "Update" : "Create") Layout
                    </button>
                </div>

            </div>
        </div>

    </div>
}
<DxPopup @bind-Visible="IsReportPopupVisible"
ShowCloseButton="true"
Width="400px"
HeaderText="Select Report"
CloseOnOutsideClick="true"
CloseOnEscape="true">
