    private async Task PrintReports(bool sendViaWhatsapp)
    {
        if (!SelectedBills.Any())
        {
            ToastService.Warning("Please select at least one job.");
            return;
        }

        // Get bill numbers safely
        var bills = SelectedBills.Cast<Bill>().ToList();

        var billNumbers = bills
            .Select(b => b.BillNo) // Make sure this property exists
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Select(x => x.Replace("/", "-").Replace("\\", "-")) // sanitize filename
            .ToList();

        // Generate proper file name
        var fileName = billNumbers.Count == 1
            ? $"{billNumbers.First()}.pdf"
            : $"Bills_{DateTime.Now:yyyyMMddHHmmss}.pdf";

        await ReportManager.DownloadAsync<Bill, PrintBillFullDto>(
            bills,

            // Get ReportId from Bill
            bill => Task.FromResult(bill.BillReportId),

            // Get DTO
            bill => BillService.GetPrintableBillAsync(bill.BillId),
               bill => "Bill",
            fileName
        );

        await ClearSelection();
    }

