    private async Task OnCancelIrnClick(ToolbarItemClickEventArgs e)
    {
        if (SelectedBills == null || SelectedBills.Count == 0)
        {
            ToastService.Warning("Please select at least one bill.");
            return;
        }

        // Cast to Bill objects first
        var bills = SelectedBills.Cast<Bill>().ToList();

        // Check if any selected bills have IRN
        var billsWithIrn = bills.Where(b => !string.IsNullOrWhiteSpace(b.BillIrnNo)).ToList();

