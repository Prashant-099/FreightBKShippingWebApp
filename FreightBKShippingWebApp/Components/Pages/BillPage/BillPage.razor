    // ✅ FIXED: Proper selection change handler with immediate state update


    private async Task OnSelectedBillsChanged(IReadOnlyList<object> newSelection)
    {
        SelectedBills = newSelection ?? new List<object>();
        await InvokeAsync(StateHasChanged);
    }

    // ✅ FIXED: Reliable clear selection method
    private async Task ClearSelectionManual()
    {
        try
        {
            if (MyGrid != null)
            {
                MyGrid.ClearSelection(); // ✅ Synchronous method
            }
            SelectedBills = new List<object>();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Clear selection error: {ex.Message}");
        }
    }

    // ✅ FIXED: Auto-clear after operations
    private async Task ClearSelection()
    {
        await Task.Delay(100); // Small delay for UI update
        await ClearSelectionManual();
    }

    private async Task CheckUserRole()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            CurrentUserId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
            IsAdmin = user.IsInRole("Admin");
        }
    }

    private string GetLockButtonText()
    {
        if (SelectedBills == null || SelectedBills.Count == 0)
            return "Lock";

        var selectedBillsList = SelectedBills.Cast<Bill>().ToList();
        return selectedBillsList.Any(b => string.IsNullOrEmpty(b.BillLockedBy)) ? "Lock" : "Unlock";
    }

    private string GetLockButtonIcon()
    {
        if (SelectedBills == null || SelectedBills.Count == 0)
            return "bi bi-lock";

        var selectedBillsList = SelectedBills.Cast<Bill>().ToList();
        return selectedBillsList.Any(b => string.IsNullOrEmpty(b.BillLockedBy)) ? "bi bi-lock" : "bi bi-unlock";
    }

    // ✅ FIXED: Toggle lock with proper cleanup
    private async Task OnToggleLock(ToolbarItemClickEventArgs e)
    {
        if (SelectedBills == null || SelectedBills.Count == 0)
        {
            ToastService.Warning("Please select at least one bill.");
            return;
        }

        try
        {
            LoadingService.Show("Processing...");
            var selectedBillsList = SelectedBills.Cast<Bill>().ToList();
            int locked = 0, unlocked = 0;

            foreach (var bill in selectedBillsList)
            {
                bool isCurrentlyLocked = !string.IsNullOrEmpty(bill.BillLockedBy);
                var result = await BillService.ToggleLockAsync(bill.BillId);

                if (result)
                {
                    if (isCurrentlyLocked)
                    {
                        bill.BillLockedBy = string.Empty;
                        bill.BillLockedByUsername = string.Empty;
                        unlocked++;
                    }
                    else
                    {
                        bill.BillLockedBy = CurrentUserId;
                        bill.BillLockedByUsername = "You";
                        locked++;
                    }
                }
            }


            await ClearSelection();
            if (locked > 0) ToastService.Success($"{locked} bill(s) locked.");
            if (unlocked > 0) ToastService.Success($"{unlocked} bill(s) unlocked.");

            await LoadBillsAsync();
        }
        catch (Exception ex)
        {
            ToastService.Error($"Error: {ex.Message}");
        }
        finally
        {
            LoadingService.Hide();

        }
    }

    private async Task LoadBillsAsync()
    {
        try
        {
            LoadingService.Show();
            billList = (await BillService.GetAllAsync()).Where(j => j.BillYearId == YearStatechangeService.SelectedYearId).ToList();
            LoadingService.Hide();
            await InvokeAsync(StateHasChanged);

            ReportDataList = await ReportDataService.GetAllAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            ToastService.Error($"Error loading bills: {ex.Message}");
            LoadingService.Hide();
        }
    }

    private async Task OnCreateNew(ToolbarItemClickEventArgs e)
    {
