    private EInvoicePopUP EInvoicePopupRef { get; set; }

    private async Task OnEInvoiceClick(ToolbarItemClickEventArgs e)
    {
        if (SelectedBills == null || SelectedBills.Count == 0)
        {
            ToastService.Warning("Please select at least one bill.");
            return;
        }

        // ✔ Pass selected bills to popup
        EInvoicePopupRef.Show(SelectedBills.ToList());
    }


    //==============================================================
    DxGrid MyGrid;
    private List<Bill> billList = [];
    private List<Bill> SelectedBills = new();
    private List<ReportData> ReportDataList = new();
    private BillAddEditPage popup;
    // ✅ Admin check
    private bool IsAdmin = false;
    private string CurrentUserId = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await CheckUserRole();
        _ = LoadBillsAsync();

    }

    // ✅ Check if user is admin
    private async Task CheckUserRole()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            CurrentUserId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
            IsAdmin = user.IsInRole("Admin");
        }
    }

    // ✅ Get lock button text based on selection
    private string GetLockButtonText()
    {
        var selectedBill = MyGrid?.GetFocusedDataItem() as Bill;

        if (selectedBill != null && !string.IsNullOrEmpty(selectedBill.BillLockedBy))
        {
            return "Unlock";
        }

        return "Lock";
    }

    // ✅ Get lock button icon
    private string GetLockButtonIcon()
    {
        var selectedBill = MyGrid?.GetFocusedDataItem() as Bill;

        if (selectedBill != null && !string.IsNullOrEmpty(selectedBill.BillLockedBy))
        {
            return "bi bi-unlock";
        }

        return "bi bi-lock";
    }

    // ✅ Toggle lock/unlock
    private async Task OnToggleLock(ToolbarItemClickEventArgs e)
    {
        var bill = MyGrid.GetFocusedDataItem() as Bill;

        if (bill == null)
        {
            ToastService.Warning("Please select a bill to lock/unlock.");
            return;
        }

        try
        {
            LoadingService.Show("Processing...");
            // Store the current state
            bool isCurrentlyLocked = !string.IsNullOrEmpty(bill.BillLockedBy);

            // Call the API first
            var result = await BillService.ToggleLockAsync(bill.BillId);

            if (result)
            {
                // Update local state after successful API call
                bill.BillLockedBy = isCurrentlyLocked ? string.Empty : CurrentUserId;
                bill.BillLockedByUsername = isCurrentlyLocked ? string.Empty : "You";

                var action = isCurrentlyLocked ? "unlocked" : "locked";
                ToastService.Success($"Bill {action} successfully.");

                await LoadBillsAsync();
            }
            else
            {

                ToastService.Error("Failed to toggle bill lock.");
            }
        }
        catch (Exception ex)
        {
            ToastService.Error($"Error: {ex.Message}");
        }
        finally
        {
            LoadingService.Hide();
            await InvokeAsync(StateHasChanged);
        }
    }


    private async Task LoadBillsAsync()
    {

        try
        {
            LoadingService.Show();
            // ✅ Load bills first (most important)
            billList = await BillService.GetAllAsync();
            LoadingService.Hide();
            await InvokeAsync(StateHasChanged); // ✅ Update UI immediately

            // ✅ Load report data in background (less critical)
            ReportDataList = await ReportDataService.GetAllAsync();
            await InvokeAsync(StateHasChanged);

        }
        catch (Exception ex)
        {
            ToastService.Error($"Error loading bills: {ex.Message}");
        }

    }

    private void OnSelectedBillsChanged(IEnumerable<object> bills)
    {
        SelectedBills = bills.Cast<Bill>().ToList();
    }

    private void OnCreateNew(ToolbarItemClickEventArgs e)
    {
        popup.Show(new Bill
        {
            BillDate = DateTime.Now,
            BillStatus = true
        });
    }

    private void OnEdit(ToolbarItemClickEventArgs e)
    {
        var bill = MyGrid.GetFocusedDataItem() as Bill;

        if (bill == null)
        {
            ToastService.Warning("Please select a bill to edit.");
            return;
        }

        // ✅ Check if bill is locked by another user
        if (!string.IsNullOrEmpty(bill.BillLockedBy) )
        {
            ToastService.Error($"This bill is locked by {bill.BillLockedByUsername} and cannot be edited.");
            return;
        }

        popup.Show(bill);
    }
    private async Task OnDelete(ToolbarItemClickEventArgs e)
    {
        if (SelectedBills == null || SelectedBills.Count == 0)
        {
            ToastService.Warning("Please select at least one bill to delete.");
            return;
        }
        // ✅ Check if any selected bill is locked
        var lockedBills = SelectedBills
            .Where(b => !string.IsNullOrEmpty(b.BillLockedBy))
            .ToList();

        if (lockedBills.Any())
        {
            ToastService.Error($"{lockedBills.Count} bill(s) are locked and cannot be deleted.");
            return;
        }

        var confirm = await ConfirmDialogService.ShowAsync(
            $"Are you sure you want to delete {SelectedBills.Count} selected bill(s)?");

        if (!confirm)
            return;

        int successCount = 0;
        int failCount = 0;

        foreach (var bill in SelectedBills)
        {
            var result = await BillService.DeleteAsync(bill.BillId);

            if (result)
                successCount++;
            else
                failCount++;
        }

        if (successCount > 0)
            ToastService.Success($"{successCount} Bill(s) Deleted Successfully.");

        if (failCount > 0)
            ToastService.Error($"{failCount} Bill(s) Failed To Delete.");

        await LoadBillsAsync();
    }



   // private int ReportId = 1;  // Har page mein isko change kar dena: 1, 2, 3

    private async Task PreviewMergedReports()
    {
        var billList = SelectedBills.ToList();
        if (!billList.Any())
        {
            ToastService.Warning("Select at least one Bill.");
            return;
        }

        LoadingService.Show("Building merged report...");
        try
        {
            // Group bills by their ReportId
            var billsByReportId = billList.GroupBy(b => b.BillReportId).ToList();

            // Create a list to hold all individual reports
            var allReports = new List<DevExpress.XtraReports.UI.XtraReport>();

            // Process each group of bills with same report layout
            foreach (var group in billsByReportId)
            {
                var reportId = group.Key;
                var groupBills = group.ToList();

                // Load layout for this group
                var layoutBytes = await ReportDataService.GetLayoutBytesAsync(reportId);
                if (layoutBytes == null || layoutBytes.Length == 0)
                {
                    ToastService.Error($"Failed to load report layout for Report ID: {reportId}");
                    continue;
                }

                // Load bill data for bills in this group
                var dtoList = new List<PrintBillFullDto?>();
                foreach (var bill in groupBills)
                {
                    var dto = await BillService.GetPrintableBillAsync(bill.BillId);
                    dtoList.Add(dto);
                }

                var dtoDict = groupBills.Select((bill, i) => new { bill, dto = dtoList[i] })
                                        .ToDictionary(x => x.bill, x => x.dto);

                // Create report for this group
                await ReportService.CreateMergedReportAsync(
                    groupBills,
                    bill => dtoDict.ContainsKey(bill) ? dtoDict[bill] : null,
                    layoutBytes);

                if (ReportService.MergedReport != null)
                {
                    allReports.Add(ReportService.MergedReport);
                }
            }

            if (!allReports.Any())
            {
                ToastService.Error("Failed to generate any reports.");
                return;
            }

            // If we have multiple report layouts, merge them into one
            if (allReports.Count > 1)
            {
                var finalReport = new DevExpress.XtraReports.UI.XtraReport();

                foreach (var report in allReports)
                {
                    // Create the report document if not already created
                    if (report.Pages.Count == 0)
                    {
                        report.CreateDocument();
                    }

                    // Add pages from each report to the final report
                    foreach (DevExpress.XtraPrinting.Page page in report.Pages)
                    {
                        finalReport.Pages.Add(page);
                    }
                }

                ReportService.MergedReport = finalReport;
            }
            // else: single report layout, already in ReportService.MergedReport

            Navigation.NavigateTo("/reportviewer");
        }
        catch (Exception ex)
        {
            ToastService.Error($"Failed to generate report: {ex.Message}");
        }
        finally
        {
            LoadingService.Hide();
        }
    }

    //FOR PRINT PDF 
    private async Task PrintReports()
    {
        var billList = SelectedBills.ToList();
        if (!billList.Any())
        {
            ToastService.Warning("Select at least one Bill.");
            return;
        }

        LoadingService.Show("Building merged PDF...");
        try
        {
            // Group bills by their ReportId
            var billsByReportId = billList.GroupBy(b => b.BillReportId).ToList();

            // Create a list to hold all individual reports
            var allReports = new List<DevExpress.XtraReports.UI.XtraReport>();

            // Process each group of bills with same report layout
            foreach (var group in billsByReportId)
            {
                var reportId = group.Key;
                var groupBills = group.ToList();

                // Load layout for this group
                var layoutBytes = await ReportDataService.GetLayoutBytesAsync(reportId);
                if (layoutBytes == null || layoutBytes.Length == 0)
                {
                    ToastService.Error($"Failed to load report layout for Report ID: {reportId}");
                    continue;
                }

                // Load bill data for bills in this group
                var dtoList = new List<PrintBillFullDto?>();
                foreach (var bill in groupBills)
                {
                    var dto = await BillService.GetPrintableBillAsync(bill.BillId);
                    dtoList.Add(dto);
                }

                var dtoDict = groupBills.Select((bill, i) => new { bill, dto = dtoList[i] })
                                        .ToDictionary(x => x.bill, x => x.dto);

                // Create report for this group
                await ReportService.CreateMergedReportAsync(
                    groupBills,
                    bill => dtoDict.ContainsKey(bill) ? dtoDict[bill] : null,
                    layoutBytes);

                if (ReportService.MergedReport != null)
                {
                    allReports.Add(ReportService.MergedReport);
                }
            }

            if (!allReports.Any())
            {
                ToastService.Error("Failed to generate any reports.");
                return;
            }

            // Merge all PDFs into one stream
            using var pdfStream = new MemoryStream();

            if (allReports.Count == 1)
            {
                // Single report layout - export directly
                allReports[0].ExportToPdf(pdfStream);
            }
            else
            {
                // Multiple report layouts - merge PDFs
                var pdfStreams = new List<MemoryStream>();

                // Combine pages from each report into a single XtraReport and export once
                var combinedReport = new DevExpress.XtraReports.UI.XtraReport();

                foreach (var report in allReports)
                {
                    if (report.Pages.Count == 0)
                        report.CreateDocument();

                    foreach (DevExpress.XtraPrinting.Page page in report.Pages)
                    {
                        combinedReport.Pages.Add(page);
                    }
                }

                combinedReport.ExportToPdf(pdfStream);
            
            }

            pdfStream.Position = 0;

            string fileName;
            if (billList.Count == 1)
            {
                var billNo = billList.First().BillNo?.Replace("/", "_") ?? "Bill";
                fileName = $"{billNo}.pdf";
            }
            else
            {
                var firstBill = billList.First().BillNo?.Replace("/", "_") ?? "Bill";
                var lastBill = billList.Last().BillNo?.Replace("/", "_") ?? "Bill";
                fileName = $"Bills_{firstBill}_to_{lastBill}.pdf";
            }

            // Download via JS (Blazor)
            using var streamRef = new Microsoft.JSInterop.DotNetStreamReference(pdfStream);
            await JSRuntime.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);

            ToastService.Success("PDF downloaded successfully.");
        }
        catch (Exception ex)
        {
            ToastService.Error($"Failed to generate report: {ex.Message}");
        }
        finally
        {
            LoadingService.Hide();
        }
    }


