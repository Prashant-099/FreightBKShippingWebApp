    private async Task PreviewReport()
    {
        if (!SelectedBills.Any())
        {
            ToastService.Warning("Please select at least one certificate.");
            return;
        }

        if (SelectedReportId == null)
        {
            ToastService.Warning("Please select a report first.");
            return;
        }

        // Get bill numbers safely
        var billNumbers = SelectedBills
            .Cast<Bill>()
            .Select(b => b.BillNo)   // Make sure BillNumber property exists
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Select(x => x.Replace("/", "-").Replace("\\", "-")) // sanitize filename
            .ToList();

        // Dynamic file name
        var fileName = billNumbers.Count == 1
            ? $"{billNumbers.First()}.pdf"
            : $"Bills_{DateTime.Now:yyyyMMddHHmmss}.pdf";

        var reportId = SelectedReportId.Value;

        await ReportManager.PreviewAsync<Bill, PrintBillFullDto>(
            SelectedBills.Cast<Bill>().ToList(),
            _ => Task.FromResult(reportId),
            c => BillService.GetPrintableBillAsync(c.BillId),
            c => "Bill",
            fileName
        );

        await ClearSelection();
    }

