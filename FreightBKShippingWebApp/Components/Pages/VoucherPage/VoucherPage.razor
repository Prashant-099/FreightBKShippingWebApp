@page "/voucher"
@using FreightBKShippingWebApp.Model
@using FreightBKShippingWebApp.Services
@inject VoucherService VoucherService
@inject ToasteService ToastService
@inject LoadingService LoadingService
@inject ConfirmationDialogService ConfirmDialogService
@inject GridLayoutService GridLayoutService

<style>
    .grid-size {
        max-height: 600px;
    }


    /* ComboBox Styling */
    .layout-combobox {
        border-radius: 6px;
        width: 185px;
    }
</style>
<DxGrid TItem="Voucher"
        Data="@voucherList"
        @ref="MyGrid"
        KeyFieldName="VoucherId"
        ShowSearchBox="true"
        PageSize="10"
        PageSizeSelectorVisible="true"
        ShowGroupPanel="true"
        FilterMenuButtonDisplayMode="GridFilterMenuButtonDisplayMode.Always"
        FocusedRowEnabled="true"
        SelectionMode="GridSelectionMode.Multiple"
        SelectedDataItems="@SelectedVouchers"
        SelectedDataItemsChanged="OnSelectedVouchersChanged"
        ColumnResizeMode="GridColumnResizeMode.NextColumn"
        CssClass="grid-size"
        AllowSelectRowByClick="true">

    <ToolbarTemplate>
        <DxToolbar>
            <TitleTemplate Context="tl">
                <div class="d-flex align-items-center">
                    <i class="bi bi-receipt  me-2"></i>
                    <span class="fs-5">Vouchers</span>
                </div>
            </TitleTemplate>
            <Items>
                <DxToolbarItem Text="Add" IconCssClass="bi bi-plus-circle" Click="OnCreateNew" />
                <DxToolbarItem Text="Edit" IconCssClass="bi bi-pencil-square" Click="OnEdit" />
                <DxToolbarItem Text="Delete" IconCssClass="bi bi-trash" Click="OnDelete" />
                <DxToolbarItem Text="Refresh" IconCssClass="bi bi-arrow-clockwise" Click="@LoadVouchersAsync" />
                <DxToolbarItem Alignment="ToolbarItemAlignment.Right"
                               RenderStyle="ButtonRenderStyle.Secondary"
                               IconCssClass="bi bi-gear-wide-connected"
                               Click="ShowLayoutPopup" />
            </Items>
        </DxToolbar>
    </ToolbarTemplate>

    <Columns>
        <DxGridSelectionColumn Width="30" FixedPosition="GridColumnFixedPosition.Left" />

        <DxGridDataColumn FieldName="VoucherId" Caption="ID"
                          Width="@(layoutManager?.GetColumnWidth("VoucherId") ?? "80px")"
                          Visible="@(layoutManager?.GetColumnVisibility("VoucherId") ?? false)" />

        <DxGridDataColumn FieldName="VoucherName" Caption="Name"
                          Width="@(layoutManager?.GetColumnWidth("VoucherName") ?? "400px")"
                          Visible="@(layoutManager?.GetColumnVisibility("VoucherName") ?? true)" />

        <DxGridDataColumn FieldName="VoucherGroup" Caption="Group"
                          Width="@(layoutManager?.GetColumnWidth("VoucherGroup") ?? "300px")"
                          Visible="@(layoutManager?.GetColumnVisibility("VoucherGroup") ?? true)" />

        <DxGridDataColumn FieldName="VoucherBranchName" Caption="Branch"
                          Width="@(layoutManager?.GetColumnWidth("VoucherBranchName") ?? "250px")"
                          Visible="@(layoutManager?.GetColumnVisibility("VoucherBranchName") ?? true)" />

        <DxGridDataColumn FieldName="VoucherMethod" Caption="Method"
                          Width="@(layoutManager?.GetColumnWidth("VoucherMethod") ?? "239px")"
                          Visible="@(layoutManager?.GetColumnVisibility("VoucherMethod") ?? true)" />

        <DxGridDataColumn FieldName="VoucherCreated" Caption="Created On"
                          DisplayFormat="dd/MM/yyyy"
                          Width="@(layoutManager?.GetColumnWidth("VoucherCreated") ?? "150px")"
                          Visible="@(layoutManager?.GetColumnVisibility("VoucherCreated") ?? true)" />

        <DxGridDataColumn FieldName="VoucherStatus" Caption="Active"
                          Width="@(layoutManager?.GetColumnWidth("VoucherStatus") ?? "120px")"
                          Visible="@(layoutManager?.GetColumnVisibility("VoucherStatus") ?? true)" />
    </Columns>
</DxGrid>

<VoucherAddEditPage @ref="popup" OnSaved="LoadVouchersAsync" />

<ConfirmationDialog />

<GridLayoutpPopup @ref="layoutManager"
                  VoucherType="Voucher"
                  Columns="@allColumns"
                  OnLayoutChanged="HandleLayoutChanged" />

@code {
    DxGrid MyGrid;
    private List<Voucher> voucherList = new();
    // private List<Voucher> SelectedVouchers = new();
    private IReadOnlyList<object> SelectedVouchers { get; set; } = new List<object>();
    private VoucherAddEditPage popup;

    // All possible columns
    private GridLayoutpPopup? layoutManager;
    private List<GridColumnLayout> allColumns = [];
    private async void ShowLayoutPopup()
    {
        await InvokeAsync(() =>
        {
            layoutManager?.ShowPopup();
        });
    }
    private async Task HandleLayoutChanged(List<GridColumnLayout> updatedLayout)
    {
        allColumns = updatedLayout;
        // Force the grid to re-render with new layout
        await InvokeAsync(StateHasChanged);
    }
    protected override async Task OnInitializedAsync()
    {
        InitializeColumns();
        await LoadVouchersAsync();
        
      
    }

    private async Task LoadVouchersAsync()
    {
        LoadingService.Show();
        try
        {
            voucherList = await VoucherService.GetAllAsync();
        }
        finally
        {
            LoadingService.Hide();
        }
    }
    private async Task InitializeColumns()
    {
        allColumns = new List<GridColumnLayout>
        {
        new() { FieldName = "VoucherId", Caption = "ID", Visible = false, Width = 80, DisplayIndex = 0 },
        new() { FieldName = "VoucherName", Caption = "Name", Visible = true, Width = 400, DisplayIndex = 1 },
        new() { FieldName = "VoucherGroup", Caption = "Group", Visible = true, Width = 300, DisplayIndex = 2 },
         new() { FieldName = "VoucherBranchName", Caption = "Branch", Visible = true, Width = 250, DisplayIndex = 3 },
        new() { FieldName = "VoucherMethod", Caption = "Method", Visible = true, Width = 239, DisplayIndex = 4 },
        new() { FieldName = "VoucherCreated", Caption = "Created On", Visible = true, Width = 150, DisplayIndex = 5 },
        new() { FieldName = "VoucherStatus", Caption = "Active", Visible = true, Width = 120, DisplayIndex = 6 }

   };
        
    }

    
   
    private async Task OnSelectedVouchersChanged(IReadOnlyList<object> vouchers)
    {
        SelectedVouchers = vouchers ?? new List<object>();
        await InvokeAsync(StateHasChanged);
    }
      // ✅ FIXED: Reliable clear selection method
    private async Task ClearSelectionManual()
    {
        try
        {
            if (MyGrid != null)
            {
                MyGrid.ClearSelection(); // ✅ Synchronous method
            }
            SelectedVouchers = new List<Voucher>();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Clear selection error: {ex.Message}");
        }
    }

    // ✅ FIXED: Auto-clear after operations
    private async Task ClearSelection()
    {
        await Task.Delay(100); // Small delay for UI update
        await ClearSelectionManual();
    }

    private void OnCreateNew(ToolbarItemClickEventArgs e)
    {
        popup.Show(new Voucher());
    }

    private async Task OnEdit(ToolbarItemClickEventArgs e)
    {
        var voucher = MyGrid.GetFocusedDataItem() as Voucher;
        if (voucher != null)
            popup.Show(voucher);
        else
            ToastService.Warning("Please select a voucher to edit.");
        await ClearSelection();
    }

    private async Task OnDelete(ToolbarItemClickEventArgs e)
    {
        if (SelectedVouchers == null || SelectedVouchers.Count == 0)
        {
            ToastService.Warning("Please select at least one voucher to delete.");
            return;
        }
        var selectedList = SelectedVouchers.Cast<Voucher>().ToList();
        var confirm = await ConfirmDialogService.ShowAsync(
            $"Are you sure you want to delete {SelectedVouchers.Count} selected voucher(s)?");

        if (!confirm)
        {
            await ClearSelection(); // ✅ Clear on cancel
            return;
        }
        try
        {
            LoadingService.Show("Deleting...");
            int successCount = 0, failCount = 0;
            foreach (var voucher in selectedList)
            {
                var result = await VoucherService.DeleteAsync(voucher.VoucherId);
                if (result) successCount++; else failCount++;
            }

            if (successCount > 0) ToastService.Success($"{successCount} Voucher(s) Deleted Successfully.");
            if (failCount > 0) ToastService.Error($"{failCount} Voucher(s) Failed To Delete.");

            await LoadVouchersAsync();
        }
        finally
        {
            LoadingService.Hide();
            await ClearSelection(); // ✅ Clear after delete (success or fail)
        }
    }
}
