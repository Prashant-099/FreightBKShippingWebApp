@page "/tickets"
@attribute [Authorize]

@using FreightBKShippingWebApp.Model
@using FreightBKShippingWebApp.Services
@using Microsoft.AspNetCore.Authorization

@inject TicketService TicketService
@inject NavigationManager Nav

<div class="tl-page">
    <div class="tl-shell">
        <div class="tl-header">
            <div class="tl-header-left">
                <div class="tl-icon" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z" />
                    </svg>
                </div>
                <div>
                    <h1 class="tl-title">Support Tickets</h1>
                    <p class="tl-sub">Manage and track your support requests</p>
                </div>
            </div>
            <button class="tl-btn-new" @onclick="CreateTicket">
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                </svg>
                New Ticket
            </button>
        </div>

        <div class="tl-stats">
            <button class="tl-stat @(activeFilter == "" ? "active" : "")" @onclick='() => SetFilter("")'>
                <span class="tl-stat-n">@allTickets.Count</span>
                <span class="tl-stat-l">All</span>
            </button>
            <button class="tl-stat st-open @(activeFilter == "1" ? "active" : "")" @onclick='() => SetFilter("1")'>
                <span class="tl-stat-n">@allTickets.Count(t => t.StatusId == 1)</span>
                <span class="tl-stat-l">Open</span>
            </button>
            <button class="tl-stat st-prog @(activeFilter == "2" ? "active" : "")" @onclick='() => SetFilter("2")'>
                <span class="tl-stat-n">@allTickets.Count(t => t.StatusId == 2)</span>
                <span class="tl-stat-l">In Progress</span>
            </button>
            <button class="tl-stat st-res @(activeFilter == "4" ? "active" : "")" @onclick='() => SetFilter("4")'>
                <span class="tl-stat-n">@allTickets.Count(t => t.StatusId == 4)</span>
                <span class="tl-stat-l">Resolved</span>
            </button>
            <button class="tl-stat st-closed @(activeFilter == "5" ? "active" : "")" @onclick='() => SetFilter("5")'>
                <span class="tl-stat-n">@allTickets.Count(t => t.StatusId == 5)</span>
                <span class="tl-stat-l">Closed</span>
            </button>
            <button class="tl-stat st-unread @(activeFilter == "unread" ? "active" : "")" @onclick='() => SetFilter("unread")'>
                <span class="tl-stat-n">@allTickets.Sum(t => t.UnreadCount)</span>
                <span class="tl-stat-l">Unread</span>
            </button>
        </div>

        @if (isLoading)
        {
            <div class="tl-state">
                <div class="tl-spinner"></div>
                <p>Loading tickets...</p>
            </div>
        }
        else if (!filteredTickets.Any())
        {
            <div class="tl-state tl-empty">
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="none" viewBox="0 0 24 24" stroke="#cbd5e1" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                <h3>No tickets found</h3>
                <p>@(activeFilter == "" ? "Create your first support ticket." : "No tickets match this filter.")</p>
                @if (activeFilter == "")
                {
                    <button class="tl-btn-new" @onclick="CreateTicket">Create Ticket</button>
                }
                else
                {
                    <button class="tl-btn-clear" @onclick='() => SetFilter("")'>Show All</button>
                }
            </div>
        }
        else
        {
            <div class="tl-list-card">
                <div class="tl-list-head">
                    <p>@filteredTickets.Count ticket(s)</p>
                    <span>Page size: @pageSize</span>
                </div>

                <div class="tl-table-wrap">
                    <table class="tl-table">
                        <thead>
                            <tr>
                                <th>Ticket No</th>
                                <th>Subject</th>
                                <th>Priority</th>
                                <th>Status</th>
                                <th>Unread</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in PagedTickets)
                            {
                                <tr class="tl-row @(item.UnreadCount > 0 ? "row-unread" : "")" @onclick="() => OpenTicket(item.TicketId)">
                                    <td><span class="tl-tno">#@item.TicketNo</span></td>
                                    <td><span class="tl-subj">@item.Subject</span></td>
                                    <td><span class="badge pri-@GetPriorityClass(item.PriorityId)">@GetPriorityLabel(item.PriorityId)</span></td>
                                    <td><span class="badge sta-@GetStatusClass(item.StatusId)">@GetStatusLabel(item.StatusId)</span></td>
                                    <td class="tc">
                                        @if (item.UnreadCount > 0)
                                        {
                                            <span class="tl-udot">@item.UnreadCount</span>
                                        }
                                        else
                                        {
                                            <span class="tl-dash">--</span>
                                        }
                                    </td>
                                    <td>
                                        <button class="tl-btn-open" @onclick:stopPropagation="true" @onclick="() => OpenTicket(item.TicketId)">
                                            Open
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="tl-cards">
                    @foreach (var item in PagedTickets)
                    {
                        <div class="tl-card @(item.UnreadCount > 0 ? "card-unread" : "")" @onclick="() => OpenTicket(item.TicketId)">
                            <div class="tl-card-top">
                                <span class="tl-tno">#@item.TicketNo</span>
                                <div class="tl-card-badges">
                                    <span class="badge pri-@GetPriorityClass(item.PriorityId)">@GetPriorityLabel(item.PriorityId)</span>
                                    <span class="badge sta-@GetStatusClass(item.StatusId)">@GetStatusLabel(item.StatusId)</span>
                                </div>
                                @if (item.UnreadCount > 0)
                                {
                                    <span class="tl-udot">@item.UnreadCount</span>
                                }
                            </div>
                            <div class="tl-card-subj">@item.Subject</div>
                        </div>
                    }
                </div>

                @if (TotalPages > 1)
                {
                    <div class="tl-pagination">
                        <button class="tl-pg-btn" disabled="@(currentPage == 1)" @onclick="PrevPage" aria-label="Previous page">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                            </svg>
                        </button>
                        @for (int i = 1; i <= TotalPages; i++)
                        {
                            var page = i;
                            <button class="tl-pg-btn @(page == currentPage ? "pg-active" : "")" @onclick="() => GoToPage(page)">@(page)</button>
                        }
                        <button class="tl-pg-btn" disabled="@(currentPage == TotalPages)" @onclick="NextPage" aria-label="Next page">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                            </svg>
                        </button>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    List<Ticket> allTickets = new();
    List<Ticket> filteredTickets = new();
    bool isLoading = true;
    string activeFilter = "";

    int currentPage = 1;
    int pageSize = 10;

    int TotalPages => Math.Max(1, (int)Math.Ceiling((double)filteredTickets.Count / pageSize));
    IEnumerable<Ticket> PagedTickets => filteredTickets.Skip((currentPage - 1) * pageSize).Take(pageSize);

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        allTickets = await TicketService.GetAllAsync();
        ApplyFilter();
        isLoading = false;
    }

    void SetFilter(string filter)
    {
        activeFilter = activeFilter == filter ? "" : filter;
        currentPage = 1;
        ApplyFilter();
    }

    void ApplyFilter()
    {
        filteredTickets = activeFilter switch
        {
            "unread" => allTickets.Where(t => t.UnreadCount > 0).ToList(),
            "" => allTickets,
            _ => allTickets.Where(t => t.StatusId.ToString() == activeFilter).ToList()
        };

        if (currentPage > TotalPages)
            currentPage = TotalPages;

        if (currentPage < 1)
            currentPage = 1;
    }

    void OpenTicket(int id) => Nav.NavigateTo($"/tickets/{id}");
    void CreateTicket() => Nav.NavigateTo("/tickets/create");

    void PrevPage() { if (currentPage > 1) currentPage--; }
    void NextPage() { if (currentPage < TotalPages) currentPage++; }
    void GoToPage(int page) => currentPage = page;

    string GetPriorityLabel(int id) => id switch { 1 => "Low", 2 => "Medium", 3 => "High", 4 => "Critical", _ => "Unknown" };
    string GetPriorityClass(int id) => id switch { 1 => "low", 2 => "medium", 3 => "high", 4 => "critical", _ => "low" };
    string GetStatusLabel(int id) => id switch { 1 => "Open", 2 => "In Progress", 3 => "Waiting User", 4 => "Resolved", 5 => "Closed", _ => "Unknown" };
    string GetStatusClass(int id) => id switch { 1 => "open", 2 => "inprogress", 3 => "waiting", 4 => "resolved", 5 => "closed", _ => "open" };
}
