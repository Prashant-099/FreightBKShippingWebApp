@page "/superadmin/support"
@attribute [Authorize]
@using FreightBKShippingWebApp.Model
@using FreightBKShippingWebApp.Services
@using Microsoft.AspNetCore.Authorization
@inject DashboardService AdminService
@inject NavigationManager Nav

<div class="sa-page">
    <div class="sa-shell">
        <div class="sa-header">
            <div class="sa-header-left">
                <div class="sa-icon" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z" />
                    </svg>
                </div>
                <div>
                    <h1 class="sa-title">Support Inbox</h1>
                    <p class="sa-sub">All tickets across all companies</p>
                </div>
            </div>
        </div>

        <div class="sa-stats">
            <button class="sa-stat @(activeFilter == "" ? "active" : "")" @onclick='() => SetFilter("")'>
                <span class="sa-stat-n">@allTickets.Count</span>
                <span class="sa-stat-l">All</span>
            </button>
            <button class="sa-stat st-open @(activeFilter == "1" ? "active" : "")" @onclick='() => SetFilter("1")'>
                <span class="sa-stat-n">@allTickets.Count(t => t.StatusId == 1)</span>
                <span class="sa-stat-l">Open</span>
            </button>
            <button class="sa-stat st-prog @(activeFilter == "2" ? "active" : "")" @onclick='() => SetFilter("2")'>
                <span class="sa-stat-n">@allTickets.Count(t => t.StatusId == 2)</span>
                <span class="sa-stat-l">In Progress</span>
            </button>
            <button class="sa-stat st-wait @(activeFilter == "3" ? "active" : "")" @onclick='() => SetFilter("3")'>
                <span class="sa-stat-n">@allTickets.Count(t => t.StatusId == 3)</span>
                <span class="sa-stat-l">Waiting</span>
            </button>
            <button class="sa-stat st-res @(activeFilter == "4" ? "active" : "")" @onclick='() => SetFilter("4")'>
                <span class="sa-stat-n">@allTickets.Count(t => t.StatusId == 4)</span>
                <span class="sa-stat-l">Resolved</span>
            </button>
            <button class="sa-stat st-closed @(activeFilter == "5" ? "active" : "")" @onclick='() => SetFilter("5")'>
                <span class="sa-stat-n">@allTickets.Count(t => t.StatusId == 5)</span>
                <span class="sa-stat-l">Closed</span>
            </button>
            <button class="sa-stat st-unread @(activeFilter == "unread" ? "active" : "")" @onclick='() => SetFilter("unread")'>
                <span class="sa-stat-n">@allTickets.Sum(t => t.UnreadByAdmin)</span>
                <span class="sa-stat-l">Unread</span>
            </button>
        </div>

        <div class="sa-filters">
            <div class="sa-fgroup">
                <select @bind="filterCompany" @bind:after="OnFilterChanged">
                    <option value="">All Companies</option>
                    @foreach (var c in companies)
                    {
                        <option value="@c.Key">@c.Value</option>
                    }
                </select>
            </div>
            <div class="sa-fgroup">
                <select @bind="filterPriority" @bind:after="OnFilterChanged">
                    <option value="">All Priority</option>
                    <option value="1">Low</option>
                    <option value="2">Medium</option>
                    <option value="3">High</option>
                    <option value="4">Critical</option>
                </select>
            </div>
            @if (filterCompany != "" || filterPriority != "" || activeFilter != "")
            {
                <button class="sa-btn-clear" @onclick="ClearFilters">Clear</button>
            }
        </div>

        @if (isLoading)
        {
            <div class="sa-state">
                <div class="sa-spinner"></div>
                <p>Loading tickets...</p>
            </div>
        }
        else if (!tickets.Any())
        {
            <div class="sa-state">
                <svg xmlns="http://www.w3.org/2000/svg" width="44" height="44" fill="none" viewBox="0 0 24 24" stroke="#cbd5e1" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                <p>No tickets found</p>
            </div>
        }
        else
        {
            <div class="sa-list-card">
                <div class="sa-list-head">
                    <p>@tickets.Count ticket(s)</p>
                    <span>Page size: @pageSize</span>
                </div>

                <div class="sa-table-wrap">
                    <table class="sa-table">
                        <thead>
                            <tr>
                                <th>Ticket</th>
                                <th>Company</th>
                                <th>Subject</th>
                                <th>Priority</th>
                                <th>Status</th>
                                <th>Assigned</th>
                                <th>Msgs</th>
                                <th>Unread</th>
                                <th>Created</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in PagedTickets)
                            {
                                <tr class="sa-row @(t.UnreadByAdmin > 0 ? "row-unread" : "")" @onclick="() => OpenTicket(t.TicketId)">
                                    <td><span class="sa-tno">#@t.TicketNo</span></td>
                                    <td><span class="sa-co">@t.CompanyName</span></td>
                                    <td><span class="sa-subj">@t.Subject</span></td>
                                    <td><span class="badge pri-@GetPriorityClass(t.PriorityId)">@GetPriorityLabel(t.PriorityId)</span></td>
                                    <td><span class="badge sta-@GetStatusClass(t.StatusId)">@GetStatusLabel(t.StatusId)</span></td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(t.AssignedToName))
                                        {
                                            <span class="sa-asgn">@t.AssignedToName</span>
                                        }
                                        else
                                        {
                                            <span class="sa-unasgn">--</span>
                                        }
                                    </td>
                                    <td class="tc">@t.MessageCount</td>
                                    <td class="tc">
                                        @if (t.UnreadByAdmin > 0)
                                        {
                                            <span class="sa-udot">@t.UnreadByAdmin</span>
                                        }
                                        else
                                        {
                                            <span class="sa-dash">--</span>
                                        }
                                    </td>
                                    <td class="sa-dt">@t.CreatedAt.ToLocalTime().ToString("dd MMM, HH:mm")</td>
                                    <td>
                                        <button class="sa-btn-open" @onclick:stopPropagation="true" @onclick="() => OpenTicket(t.TicketId)">
                                            Open
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="sa-cards">
                    @foreach (var t in PagedTickets)
                    {
                        <div class="sa-card @(t.UnreadByAdmin > 0 ? "card-unread" : "")" @onclick="() => OpenTicket(t.TicketId)">
                            <div class="sa-card-top">
                                <span class="sa-tno">#@t.TicketNo</span>
                                <div class="sa-card-badges">
                                    <span class="badge pri-@GetPriorityClass(t.PriorityId)">@GetPriorityLabel(t.PriorityId)</span>
                                    <span class="badge sta-@GetStatusClass(t.StatusId)">@GetStatusLabel(t.StatusId)</span>
                                </div>
                                @if (t.UnreadByAdmin > 0)
                                {
                                    <span class="sa-udot">@t.UnreadByAdmin</span>
                                }
                            </div>
                            <div class="sa-card-subj">@t.Subject</div>
                            <div class="sa-card-meta">
                                <span class="sa-co">@t.CompanyName</span>
                                <span class="sa-dt">@t.CreatedAt.ToLocalTime().ToString("dd MMM, HH:mm")</span>
                            </div>
                            @if (!string.IsNullOrEmpty(t.AssignedToName))
                            {
                                <div class="sa-card-asgn">Assigned: @t.AssignedToName</div>
                            }
                        </div>
                    }
                </div>

                @if (TotalPages > 1)
                {
                    <div class="sa-pagination">
                        <button class="sa-pg-btn" disabled="@(currentPage == 1)" @onclick="PrevPage" aria-label="Previous page">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                            </svg>
                        </button>
                        @for (int i = 1; i <= TotalPages; i++)
                        {
                            var page = i;
                            <button class="sa-pg-btn @(page == currentPage ? "pg-active" : "")" @onclick="() => GoToPage(page)">@(page)</button>
                        }
                        <button class="sa-pg-btn" disabled="@(currentPage == TotalPages)" @onclick="NextPage" aria-label="Next page">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                            </svg>
                        </button>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    List<SupportTicketAdminDto> allTickets = new();
    List<SupportTicketAdminDto> tickets = new();
    Dictionary<int, string> companies = new();
    bool isLoading = true;

    string filterCompany = "";
    string filterPriority = "";
    string activeFilter = "";

    int currentPage = 1;
    int pageSize = 10;

    int TotalPages => Math.Max(1, (int)Math.Ceiling((double)tickets.Count / pageSize));
    IEnumerable<SupportTicketAdminDto> PagedTickets => tickets.Skip((currentPage - 1) * pageSize).Take(pageSize);

    protected override async Task OnInitializedAsync()
    {
        await LoadTickets();
    }

    async Task LoadTickets()
    {
        isLoading = true;

        allTickets = (await AdminService.GetAllTicketsAsync(null, null, null))
            .OrderByDescending(t => t.CreatedAt)
            .ToList();

        companies = allTickets
            .GroupBy(t => t.CompanyId)
            .ToDictionary(g => g.Key, g => g.First().CompanyName);

        ApplyFilters();
        isLoading = false;
    }

    void SetFilter(string filter)
    {
        activeFilter = activeFilter == filter ? "" : filter;
        currentPage = 1;
        ApplyFilters();
    }

    void OnFilterChanged()
    {
        currentPage = 1;
        ApplyFilters();
    }

    void ApplyFilters()
    {
        IEnumerable<SupportTicketAdminDto> query = allTickets;

        if (activeFilter == "unread")
            query = query.Where(t => t.UnreadByAdmin > 0);
        else if (!string.IsNullOrEmpty(activeFilter))
            query = query.Where(t => t.StatusId.ToString() == activeFilter);

        if (!string.IsNullOrEmpty(filterCompany))
            query = query.Where(t => t.CompanyId.ToString() == filterCompany);

        if (!string.IsNullOrEmpty(filterPriority))
            query = query.Where(t => t.PriorityId.ToString() == filterPriority);

        tickets = query.ToList();

        if (currentPage > TotalPages)
            currentPage = TotalPages;

        if (currentPage < 1)
            currentPage = 1;
    }

    void ClearFilters()
    {
        filterCompany = "";
        filterPriority = "";
        activeFilter = "";
        currentPage = 1;
        ApplyFilters();
    }

    void OpenTicket(int id) => Nav.NavigateTo($"/superadmin/support/{id}");

    void PrevPage() { if (currentPage > 1) currentPage--; }
    void NextPage() { if (currentPage < TotalPages) currentPage++; }
    void GoToPage(int page) => currentPage = page;

    string GetPriorityLabel(int id) => id switch { 1 => "Low", 2 => "Medium", 3 => "High", 4 => "Critical", _ => "?" };
    string GetPriorityClass(int id) => id switch { 1 => "low", 2 => "medium", 3 => "high", 4 => "critical", _ => "low" };
    string GetStatusLabel(int id) => id switch { 1 => "Open", 2 => "In Progress", 3 => "Waiting", 4 => "Resolved", 5 => "Closed", _ => "?" };
    string GetStatusClass(int id) => id switch { 1 => "open", 2 => "inprogress", 3 => "waiting", 4 => "resolved", 5 => "closed", _ => "open" };
}
