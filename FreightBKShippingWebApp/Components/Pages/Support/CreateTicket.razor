@page "/tickets/create"
@attribute [Authorize]

@using FreightBKShipping.DTOs
@using FreightBKShippingWebApp.Model
@using FreightBKShippingWebApp.Services
@using Microsoft.AspNetCore.Authorization

@inject TicketService TicketService
@inject NavigationManager Nav

<div class="support-page">

    <!-- Header -->
    <div class="page-header">
        <button class="btn-back" @onclick="GoBack">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
            </svg>
            Back
        </button>
        <div class="header-left">
            <div class="header-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                </svg>
            </div>
            <div>
                <h1 class="page-title">Create Support Ticket</h1>
                <p class="page-subtitle">Describe your issue and we'll get back to you soon</p>
            </div>
        </div>
    </div>

    <!-- Form Card -->
    <div class="form-card">

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-error">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
                @errorMessage
            </div>
        }

        <div class="form-row">
            <!-- Subject -->
            <div class="form-group full">
                <label class="form-label">
                    Subject <span class="required">*</span>
                </label>
                <input class="form-input @(subjectError ? "input-error" : "")"
                       @bind="ticket.Subject"
                       @bind:event="oninput"
                       placeholder="Brief summary of your issue..." />
                @if (subjectError)
                {
                    <span class="field-error">Subject is required.</span>
                }
            </div>

            <!-- Priority -->
            <div class="form-group half">
                <label class="form-label">Priority</label>
                <div class="select-wrapper">
                    <select class="form-select" @bind="ticket.PriorityId">
                        <option value="1">🟢 Low</option>
                        <option value="2">🟡 Medium</option>
                        <option value="3">🟠 High</option>
                        <option value="4">🔴 Critical</option>
                    </select>
                    <svg class="select-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                    </svg>
                </div>
            </div>

            <!-- Category (optional UX improvement) -->
            @* <div class="form-group half">
                <label class="form-label">Category</label>
                <div class="select-wrapper">
                    <select class="form-select" @bind="ticket.CategoryId">
                        <option value="0">Select category...</option>
                        <option value="1">Billing</option>
                        <option value="2">Shipment Issue</option>
                        <option value="3">Technical Support</option>
                        <option value="4">Account</option>
                        <option value="5">Other</option>
                    </select>
                    <svg class="select-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                    </svg>
                </div>
            </div> *@

            <!-- Message -->
            <div class="form-group full">
                <label class="form-label">
                    Message <span class="required">*</span>
                </label>
                <textarea class="form-textarea @(messageError ? "input-error" : "")"
                          rows="6"
                          @bind="message"
                          @bind:event="oninput"
                          placeholder="Please describe your issue in detail. Include any relevant order numbers, dates, or error messages..."></textarea>
                @if (messageError)
                {
                    <span class="field-error">Please enter a message.</span>
                }
                <span class="char-count">@message.Length characters</span>
            </div>
        </div>

        <!-- Actions -->
        <div class="form-actions">
            <button class="btn-cancel" @onclick="GoBack" disabled="@isSubmitting">Cancel</button>
            <button class="btn-submit" @onclick="SubmitTicket" disabled="@isSubmitting">
                @if (isSubmitting)
                {
                    <span class="btn-spinner"></span>
                    <span>Submitting...</span>
                }
                else
                {
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                    </svg>
                    <span>Submit Ticket</span>
                }
            </button>
        </div>
    </div>
</div>

<style>
    .support-page {
        padding: 28px 32px;
        background: #f8fafc;
        min-height: 100vh;
        font-family: 'Segoe UI', system-ui, sans-serif;
        max-width: 780px;
    }

    .page-header {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 24px;
        flex-wrap: wrap;
    }

    .header-left {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .header-icon {
        width: 42px;
        height: 42px;
        background: #e0f2fe;
        border-radius: 11px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #0284c7;
    }

    .page-title {
        font-size: 20px;
        font-weight: 700;
        color: #0f172a;
        margin: 0;
    }

    .page-subtitle {
        font-size: 13px;
        color: #64748b;
        margin: 2px 0 0;
    }

    .btn-back {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 8px 14px;
        font-size: 13px;
        font-weight: 600;
        color: #64748b;
        cursor: pointer;
        transition: all 0.15s;
    }

        .btn-back:hover {
            background: #f1f5f9;
            color: #334155;
        }

    /* Form Card */
    .form-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 32px;
        box-shadow: 0 1px 4px rgba(0,0,0,0.06);
    }

    .form-row {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

        .form-group.full {
            width: 100%;
        }

        .form-group.half {
            flex: 1;
            min-width: 180px;
        }

    .form-label {
        font-size: 13px;
        font-weight: 600;
        color: #374151;
    }

    .required {
        color: #dc2626;
    }

    .form-input, .form-select, .form-textarea {
        width: 100%;
        padding: 10px 14px;
        border: 1.5px solid #e2e8f0;
        border-radius: 9px;
        font-size: 14px;
        color: #0f172a;
        background: #fff;
        transition: border-color 0.15s, box-shadow 0.15s;
        font-family: inherit;
        box-sizing: border-box;
    }

        .form-input:focus, .form-select:focus, .form-textarea:focus {
            outline: none;
            border-color: #0284c7;
            box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.12);
        }

    .form-textarea {
        resize: vertical;
        min-height: 120px;
    }

    .input-error {
        border-color: #dc2626 !important;
    }

    .field-error {
        font-size: 12px;
        color: #dc2626;
    }

    .char-count {
        font-size: 11px;
        color: #94a3b8;
        text-align: right;
    }

    .select-wrapper {
        position: relative;
    }

    .form-select {
        appearance: none;
        padding-right: 36px;
        cursor: pointer;
    }

    .select-icon {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: #94a3b8;
        pointer-events: none;
    }

    /* Alerts */
    .alert {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 16px;
        border-radius: 10px;
        font-size: 14px;
        margin-bottom: 20px;
    }

    .alert-error {
        background: #fef2f2;
        color: #dc2626;
        border: 1px solid #fecaca;
    }

    /* Actions */
    .form-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 28px;
        padding-top: 20px;
        border-top: 1px solid #f1f5f9;
    }

    .btn-cancel {
        padding: 10px 20px;
        border: 1.5px solid #e2e8f0;
        background: #fff;
        border-radius: 9px;
        font-size: 14px;
        font-weight: 600;
        color: #64748b;
        cursor: pointer;
        transition: all 0.15s;
    }

        .btn-cancel:hover {
            background: #f1f5f9;
        }

    .btn-submit {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 22px;
        background: #0284c7;
        border: none;
        border-radius: 9px;
        font-size: 14px;
        font-weight: 600;
        color: #fff;
        cursor: pointer;
        transition: background 0.18s;
    }

        .btn-submit:hover:not(:disabled) {
            background: #0369a1;
        }

        .btn-submit:disabled {
            opacity: 0.65;
            cursor: not-allowed;
        }

    .btn-spinner {
        width: 15px;
        height: 15px;
        border: 2px solid rgba(255,255,255,0.4);
        border-top-color: #fff;
        border-radius: 50%;
        animation: spin 0.7s linear infinite;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }
</style>

@code {
    Ticket ticket = new() { PriorityId = 2 };
    string message = string.Empty;
    string errorMessage = string.Empty;
    bool isSubmitting = false;
    bool subjectError = false;
    bool messageError = false;

    async Task SubmitTicket()
    {
        subjectError = string.IsNullOrWhiteSpace(ticket.Subject);
        messageError = string.IsNullOrWhiteSpace(message);
        if (subjectError || messageError) return;

        isSubmitting = true;
        errorMessage = string.Empty;

        try
        {
            ticket.MessageText = message; // ✅ message set karo

            var created = await TicketService.CreateAsync(ticket);
            if (created != null)
                Nav.NavigateTo("/tickets");
            else
                errorMessage = "Failed to create ticket. Please try again.";
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    void GoBack() => Nav.NavigateTo("/tickets");
}
