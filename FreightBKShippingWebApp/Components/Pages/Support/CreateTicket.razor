@page "/tickets/create"
@attribute [Authorize]

@using FreightBKShipping.DTOs
@using FreightBKShippingWebApp.Model
@using FreightBKShippingWebApp.Services
@using Microsoft.AspNetCore.Authorization

@inject TicketService TicketService
@inject NavigationManager Nav
@inject FileUploadService FileUploadService

<div class="ct-page">

    <div class="ct-header">
        <button class="ct-back" @onclick="GoBack">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
            </svg>
            Back
        </button>
        <div class="ct-header-left">
            <div class="ct-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                </svg>
            </div>
            <div>
                <h1 class="ct-title">Create Support Ticket</h1>
                <p class="ct-sub">Describe your issue and we'll get back to you soon</p>
            </div>
        </div>
    </div>

    <div class="ct-card">

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="ct-alert">
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
                @errorMessage
            </div>
        }

        <!-- Subject -->
        <div class="ct-group">
            <label class="ct-label">Subject <span class="ct-req">*</span></label>
            <input class="ct-input @(subjectError ? "ct-err-input" : "")"
                   @bind="ticket.Subject"
                   @bind:event="oninput"
                   placeholder="Brief summary of your issue..." />
            @if (subjectError)
            {
                <span class="ct-err-msg">Subject is required.</span>
            }
        </div>

        <!-- Priority -->
        <div class="ct-group">
            <label class="ct-label">Priority</label>
            <select class="ct-select" @bind="ticket.PriorityId">
                <option value="1">🟢 Low</option>
                <option value="2">🟡 Medium</option>
                <option value="3">🟠 High</option>
                <option value="4">🔴 Critical</option>
            </select>
        </div>

        <!-- Message -->
        <div class="ct-group">
            <label class="ct-label">Message <span class="ct-req">*</span></label>
            <textarea class="ct-textarea @(messageError ? "ct-err-input" : "")"
                      rows="5"
                      @bind="message"
                      @bind:event="oninput"
                      placeholder="Describe your issue in detail..."></textarea>
            @if (messageError)
            {
                <span class="ct-err-msg">Please enter a message.</span>
            }
            <span class="ct-char">@message.Length characters</span>
        </div>

        <!-- Image Attach -->
        <div class="ct-group">
            <label class="ct-label">Attach Image <span class="ct-opt">(optional)</span></label>
            <InputFile accept="image/*" capture="environment" OnChange="OnImageSelected" id="ctImgInput" style="display:none" />
            @if (selectedImagePreview != null)
            {
                <div class="ct-img-wrap">
                    <img src="@selectedImagePreview" class="ct-img-preview" />
                    <button type="button" class="ct-img-remove" @onclick="RemoveImage">✕</button>
                </div>
            }
            else
            {
                <label for="ctImgInput" class="ct-img-label">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                    Camera / Gallery se image attach karo
                </label>
            }
        </div>

        <!-- Actions -->
        <div class="ct-actions">
            <button class="ct-btn-cancel" @onclick="GoBack" disabled="@isSubmitting">Cancel</button>
            <button class="ct-btn-submit" @onclick="SubmitTicket" disabled="@isSubmitting">
                @if (isSubmitting)
                {
                    <span class="ct-spin"></span>
                    <span>Submitting...</span>
                }
                else
                {
                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                    </svg>
                    <span>Submit Ticket</span>
                }
            </button>
        </div>
    </div>
</div>

<style>
    .ct-page {
        padding: 20px 24px;
        background: #f8fafc;
        min-height: 100vh;
        font-family: 'Segoe UI', system-ui, sans-serif;
        max-width: 680px;
    }

    .ct-header {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 22px;
        flex-wrap: wrap;
    }

    .ct-header-left {
        display: flex;
        align-items: center;
        gap: 12px;
        flex: 1;
    }

    .ct-icon {
        width: 38px;
        height: 38px;
        background: #e0f2fe;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #0284c7;
        flex-shrink: 0;
    }

    .ct-title {
        font-size: 18px;
        font-weight: 700;
        color: #0f172a;
        margin: 0;
    }

    .ct-sub {
        font-size: 12px;
        color: #64748b;
        margin: 2px 0 0;
    }

    .ct-back {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 8px 13px;
        font-size: 12px;
        font-weight: 600;
        color: #64748b;
        cursor: pointer;
        transition: all 0.15s;
        white-space: nowrap;
    }

        .ct-back:hover {
            background: #f1f5f9;
        }

    .ct-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 1px 4px rgba(0,0,0,0.05);
    }

    .ct-alert {
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 11px 14px;
        background: #fef2f2;
        color: #dc2626;
        border: 1px solid #fecaca;
        border-radius: 9px;
        font-size: 13px;
        margin-bottom: 18px;
    }

    .ct-group {
        margin-bottom: 18px;
    }

    .ct-label {
        display: block;
        font-size: 13px;
        font-weight: 600;
        color: #374151;
        margin-bottom: 6px;
    }

    .ct-req {
        color: #dc2626;
    }

    .ct-opt {
        font-weight: 400;
        color: #94a3b8;
        font-size: 11px;
    }

    .ct-input, .ct-select, .ct-textarea {
        width: 100%;
        padding: 10px 13px;
        border: 1.5px solid #e2e8f0;
        border-radius: 9px;
        font-size: 14px;
        color: #0f172a;
        background: #fff;
        font-family: inherit;
        box-sizing: border-box;
        transition: border-color 0.15s;
    }

        .ct-input:focus, .ct-select:focus, .ct-textarea:focus {
            outline: none;
            border-color: #0284c7;
            box-shadow: 0 0 0 3px rgba(2,132,199,0.1);
        }

    .ct-textarea {
        resize: vertical;
        min-height: 110px;
    }

    .ct-select {
        appearance: none;
        cursor: pointer;
    }

    .ct-err-input {
        border-color: #dc2626 !important;
    }

    .ct-err-msg {
        font-size: 12px;
        color: #dc2626;
        display: block;
        margin-top: 4px;
    }

    .ct-char {
        font-size: 11px;
        color: #94a3b8;
        display: block;
        text-align: right;
        margin-top: 4px;
    }

    .ct-img-label {
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 11px 16px;
        border: 1.5px dashed #cbd5e1;
        border-radius: 10px;
        cursor: pointer;
        font-size: 13px;
        color: #64748b;
        transition: all 0.15s;
    }

        .ct-img-label:hover {
            border-color: #0284c7;
            color: #0284c7;
            background: #f0f9ff;
        }

    .ct-img-wrap {
        position: relative;
        display: inline-block;
    }

    .ct-img-preview {
        max-height: 140px;
        max-width: 100%;
        border-radius: 10px;
        border: 1px solid #e2e8f0;
        display: block;
    }

    .ct-img-remove {
        position: absolute;
        top: -8px;
        right: -8px;
        background: #ef4444;
        color: #fff;
        border: none;
        border-radius: 50%;
        width: 22px;
        height: 22px;
        font-size: 11px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .ct-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 24px;
        padding-top: 18px;
        border-top: 1px solid #f1f5f9;
    }

    .ct-btn-cancel {
        padding: 10px 20px;
        border: 1.5px solid #e2e8f0;
        background: #fff;
        border-radius: 9px;
        font-size: 13px;
        font-weight: 600;
        color: #64748b;
        cursor: pointer;
        transition: all 0.15s;
    }

        .ct-btn-cancel:hover {
            background: #f1f5f9;
        }

    .ct-btn-submit {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 10px 20px;
        background: #0284c7;
        border: none;
        border-radius: 9px;
        font-size: 13px;
        font-weight: 600;
        color: #fff;
        cursor: pointer;
        transition: background 0.15s;
    }

        .ct-btn-submit:hover:not(:disabled) {
            background: #0369a1;
        }

        .ct-btn-submit:disabled {
            opacity: 0.65;
            cursor: not-allowed;
        }

    .ct-spin {
        width: 14px;
        height: 14px;
        border: 2px solid rgba(255,255,255,0.4);
        border-top-color: #fff;
        border-radius: 50%;
        animation: ctspin 0.7s linear infinite;
        display: inline-block;
    }

    @@keyframes ctspin {
        to {
            transform: rotate(360deg);
        }
    }

    @@media (max-width: 600px) {
        .ct-page {
            padding: 14px 16px;
        }

        .ct-card {
            padding: 18px;
        }

        .ct-title {
            font-size: 16px;
        }

        .ct-actions {
            flex-wrap: wrap;
        }

        .ct-btn-cancel, .ct-btn-submit {
            flex: 1;
            justify-content: center;
        }
    }
</style>

@code {
    Ticket ticket = new() { PriorityId = 2 };
    string message = string.Empty;
    string errorMessage = string.Empty;
    bool isSubmitting = false;
    bool subjectError = false;
    bool messageError = false;

    async Task SubmitTicket()
    {
        subjectError = string.IsNullOrWhiteSpace(ticket.Subject);
        messageError = string.IsNullOrWhiteSpace(message);
        if (subjectError || messageError) return;

        isSubmitting = true;
        errorMessage = string.Empty;

        try
        {
            ticket.MessageText = message;
            var created = await TicketService.CreateAsync(ticket);

            if (created != null)
            {
                if (selectedImage != null)
                {
                    using var ms = new MemoryStream();
                    await selectedImage.OpenReadStream(5 * 1024 * 1024).CopyToAsync(ms);
                    var replies = await TicketService.GetRepliesAsync(created.TicketId);
                    var firstMsg = replies?.FirstOrDefault();
                    if (firstMsg != null)
                    {
                        await FileUploadService.UploadFileAsync(ms.ToArray(), selectedImage.Name,
                            category: "TicketMessage",
                            subCategory: firstMsg.MessageId.ToString(),
                            referenceId: created.TicketId.ToString());
                    }
                }
                Nav.NavigateTo("/tickets");
            }
            else
            {
                errorMessage = "Failed to create ticket. Please try again.";
            }
        }
        catch (Exception ex) { errorMessage = $"An error occurred: {ex.Message}"; }
        finally { isSubmitting = false; }
    }

    void GoBack() => Nav.NavigateTo("/tickets");

    IBrowserFile? selectedImage;
    string? selectedImagePreview;

    async Task OnImageSelected(InputFileChangeEventArgs e)
    {
        selectedImage = e.File;
        using var ms = new MemoryStream();
        await selectedImage.OpenReadStream(5 * 1024 * 1024).CopyToAsync(ms);
        selectedImagePreview = $"data:{selectedImage.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}";
    }

    void RemoveImage() { selectedImage = null; selectedImagePreview = null; }
}
