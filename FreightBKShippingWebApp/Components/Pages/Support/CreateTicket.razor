@page "/tickets/create"
@attribute [Authorize]

@using FreightBKShipping.DTOs
@using FreightBKShippingWebApp.Model
@using FreightBKShippingWebApp.Services
@using Microsoft.AspNetCore.Authorization

@inject TicketService TicketService
@inject NavigationManager Nav
@inject FileUploadService FileUploadService

<div class="ct-page">
    <div class="ct-shell">
        <div class="ct-header">
            <button class="ct-back" @onclick="GoBack">
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                </svg>
                Back
            </button>
            <div class="ct-header-left">
                <div class="ct-icon" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                    </svg>
                </div>
                <div>
                    <h1 class="ct-title">Create Support Ticket</h1>
                    <p class="ct-sub">Describe your issue and our team will respond quickly.</p>
                </div>
            </div>
        </div>

        <div class="ct-card">
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="ct-alert">
                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                    </svg>
                    @errorMessage
                </div>
            }

            <div class="ct-group">
                <label class="ct-label">Subject <span class="ct-req">*</span></label>
                <input class="ct-input @(subjectError ? "ct-err-input" : "")"
                       @bind="ticket.Subject"
                       @bind:event="oninput"
                       placeholder="Brief summary of your issue" />
                @if (subjectError)
                {
                    <span class="ct-err-msg">Subject is required.</span>
                }
            </div>

            <div class="ct-group">
                <label class="ct-label">Priority</label>
                <select class="ct-select" @bind="ticket.PriorityId">
                    <option value="1">Low</option>
                    <option value="2">Medium</option>
                    <option value="3">High</option>
                    <option value="4">Critical</option>
                </select>
            </div>

            <div class="ct-group">
                <label class="ct-label">Message <span class="ct-req">*</span></label>
                <textarea class="ct-textarea @(messageError ? "ct-err-input" : "")"
                          rows="5"
                          @bind="message"
                          @bind:event="oninput"
                          placeholder="Describe your issue in detail"></textarea>
                @if (messageError)
                {
                    <span class="ct-err-msg">Please enter a message.</span>
                }
                <span class="ct-char">@message.Length characters</span>
            </div>

            <div class="ct-group">
                <label class="ct-label">Attach Image <span class="ct-opt">(optional)</span></label>
                <InputFile accept="image/*" capture="environment" OnChange="OnImageSelected" id="ctImgInput" style="display:none" />
                @if (selectedImagePreview != null)
                {
                    <div class="ct-img-wrap">
                        <img src="@selectedImagePreview" class="ct-img-preview" alt="Preview" />
                        <button type="button" class="ct-img-remove" @onclick="RemoveImage">x</button>
                    </div>
                }
                else
                {
                    <label for="ctImgInput" class="ct-img-label">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
                        </svg>
                        Attach image from camera or gallery
                    </label>
                }
            </div>

            <div class="ct-actions">
                <button class="ct-btn-cancel" @onclick="GoBack" disabled="@isSubmitting">Cancel</button>
                <button class="ct-btn-submit" @onclick="SubmitTicket" disabled="@isSubmitting">
                    @if (isSubmitting)
                    {
                        <span class="ct-spin"></span>
                        <span>Submitting...</span>
                    }
                    else
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                        </svg>
                        <span>Submit Ticket</span>
                    }
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    Ticket ticket = new() { PriorityId = 2 };
    string message = string.Empty;
    string errorMessage = string.Empty;
    bool isSubmitting = false;
    bool subjectError = false;
    bool messageError = false;

    async Task SubmitTicket()
    {
        subjectError = string.IsNullOrWhiteSpace(ticket.Subject);
        messageError = string.IsNullOrWhiteSpace(message);
        if (subjectError || messageError) return;

        isSubmitting = true;
        errorMessage = string.Empty;

        try
        {
            ticket.MessageText = message;
            var created = await TicketService.CreateAsync(ticket);

            if (created != null)
            {
                if (selectedImage != null)
                {
                    using var ms = new MemoryStream();
                    await selectedImage.OpenReadStream(5 * 1024 * 1024).CopyToAsync(ms);
                    var replies = await TicketService.GetRepliesAsync(created.TicketId);
                    var firstMsg = replies?.FirstOrDefault();
                    if (firstMsg != null)
                    {
                        await FileUploadService.UploadFileAsync(ms.ToArray(), selectedImage.Name,
                            category: "TicketMessage",
                            subCategory: firstMsg.MessageId.ToString(),
                            referenceId: created.TicketId.ToString());
                    }
                }
                Nav.NavigateTo("/tickets");
            }
            else
            {
                errorMessage = "Failed to create ticket. Please try again.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    void GoBack() => Nav.NavigateTo("/tickets");

    IBrowserFile? selectedImage;
    string? selectedImagePreview;

    async Task OnImageSelected(InputFileChangeEventArgs e)
    {
        selectedImage = e.File;
        using var ms = new MemoryStream();
        await selectedImage.OpenReadStream(5 * 1024 * 1024).CopyToAsync(ms);
        selectedImagePreview = $"data:{selectedImage.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}";
    }

    void RemoveImage()
    {
        selectedImage = null;
        selectedImagePreview = null;
    }
}
