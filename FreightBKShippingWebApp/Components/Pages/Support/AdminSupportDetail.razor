@code {
    [Parameter] public int TicketId { get; set; }

    SupportTicketAdminDto? ticket;
    List<AdminUserDto> adminUsers = new();
    string replyMessage = string.Empty;
    string replyError = string.Empty;
    string selectedAssignee = string.Empty;

    bool isLoading = true;
    bool isSending = false;
    bool isUpdating = false;
    bool isAssigning = false;
    bool isClosing = false;
    bool updateSuccess = false;
    bool assignSuccess = false;
    bool isConnected = false;

    int editStatus;
    int editPriority;

    private HubConnection? _hub;
    private string? _hubToken;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        adminUsers = await AdminService.GetAdminUsersAsync();
        isLoading = false;
    }

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            isLoading = true;
            _hubToken = await AdminService.GetAuthTokenAsync();
            ticket = await AdminService.GetTicketDetailAsync(TicketId);

            if (ticket != null)
            {
                editStatus = ticket.StatusId;
                editPriority = ticket.PriorityId;
                ticket.Messages ??= new List<TicketMessageAdminDto>();

                var attachments = await FileUploadService.GetAdminDocumentsAsync("TicketMessage", TicketId.ToString());
                foreach (var msg in ticket.Messages)
                {
                    var doc = attachments.FirstOrDefault(a =>
                        a.CompanyId == ticket.CompanyId &&
                        (a.SubCategory == msg.MessageId.ToString() ||
                        (a.SubCategory == "image" && a.ReferenceId == TicketId.ToString()))
                    );
                    if (doc != null)
                        msg.ImageUrl = (await FileUploadService.GetAdminSasUrlAsync(doc.DocumentId, 60))?.Trim();
                }
                await InvokeAsync(StateHasChanged);
            }

            await StartHub();
            isLoading = false;
            await InvokeAsync(ScrollToBottom);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[AdminPage] ERROR: {ex.Message}");
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task StartHub()
    {
        if (_hub != null)
        {
            try { if (_hub.State == HubConnectionState.Connected) { await _hub.InvokeAsync("LeaveTicket", TicketId); await _hub.StopAsync(); } await _hub.DisposeAsync(); }
            catch { }
            _hub = null;
        }

        try
        {
            var apiBase = AdminService.GetApiBaseUrl().TrimEnd('/');
            var capturedToken = _hubToken;

            _hub = new HubConnectionBuilder()
                .WithUrl($"{apiBase}/tickethub", options =>
                {
                    options.AccessTokenProvider = () => Task.FromResult<string?>(capturedToken);
                    options.Transports = HttpTransportType.WebSockets | HttpTransportType.ServerSentEvents | HttpTransportType.LongPolling;
                })
                .WithAutomaticReconnect()
                .Build();

            _hub.Closed += async (ex) => { isConnected = false; await InvokeAsync(StateHasChanged); };
            _hub.Reconnecting += (ex) => { isConnected = false; InvokeAsync(StateHasChanged); return Task.CompletedTask; };
            _hub.Reconnected += async (_) =>
            {
                try { await _hub.InvokeAsync("JoinTicket", TicketId); } catch { }
                isConnected = true;
                await InvokeAsync(StateHasChanged);
            };

            _hub.On<string, string, DateTime, int>("ReceiveMessage",
                async (senderType, messageText, createdAt, messageId) =>
                {
                    await InvokeAsync(async () =>
                    {
                        if (ticket == null) return;
                        ticket.Messages ??= new List<TicketMessageAdminDto>();
                        if (ticket.Messages.Any(m => m.MessageId == messageId)) return;
                        ticket.Messages.Add(new TicketMessageAdminDto { MessageId = messageId, TicketId = TicketId, MessageText = messageText, SenderType = senderType, CreatedAt = createdAt });
                        await InvokeAsync(StateHasChanged);
                        await ScrollToBottom();
                    });
                });

            _hub.On<int>("TicketClosed", async (ticketId) =>
            {
                if (ticketId == TicketId && ticket != null) { ticket.StatusId = 5; await InvokeAsync(StateHasChanged); }
            });

            await _hub.StartAsync();
            await _hub.InvokeAsync("JoinTicket", TicketId);
            isConnected = true;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex) { Console.WriteLine($"[AdminHub] ERROR: {ex.Message}"); isConnected = false; await InvokeAsync(StateHasChanged); }
    }

    private async Task ScrollToBottom()
    {
        try { await JS.InvokeVoidAsync("scrollToBottom", "sad-messages"); } catch { }
    }

    async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.CtrlKey && e.Key == "Enter") await SendReply();
    }

    async Task SendReply()
    {
        if (string.IsNullOrWhiteSpace(replyMessage) && replyImage == null) return;
        isSending = true;
        replyError = string.Empty;
        var msgText = replyMessage;
        try
        {
            var savedMsg = await AdminService.ReplyAsync(TicketId, msgText);
            if (savedMsg != null && ticket != null)
            {
                ticket.Messages ??= new List<TicketMessageAdminDto>();
                var newMsg = new TicketMessageAdminDto
                {
                    MessageId = savedMsg.MessageId,
                    TicketId = TicketId,
                    MessageText = string.IsNullOrWhiteSpace(msgText) ? null : msgText,
                    SenderType = "Support",
                    CreatedAt = savedMsg.CreatedAt
                };
                if (replyImage != null)
                {
                    using var ms = new MemoryStream();
                    await replyImage.OpenReadStream(5 * 1024 * 1024).CopyToAsync(ms);
                    await FileUploadService.AdminUploadFileAsync(ms.ToArray(), replyImage.Name,
                        category: "TicketMessage",
                        subCategory: savedMsg.MessageId.ToString(),
                        referenceId: TicketId.ToString(),
                        ticketCompanyId: ticket.CompanyId);
                    newMsg.ImageUrl = replyImagePreview;
                    replyImage = null;
                    replyImagePreview = null;
                }
                ticket.Messages.Add(newMsg);
                replyMessage = string.Empty;
                await InvokeAsync(StateHasChanged);
                await ScrollToBottom();
            }
            else { replyError = "Failed to send reply."; }
        }
        catch (Exception ex) { replyError = ex.Message; }
        finally { isSending = false; }
    }

    public async ValueTask DisposeAsync()
    {
        if (_hub != null)
        {
            try { if (_hub.State == HubConnectionState.Connected) { await _hub.InvokeAsync("LeaveTicket", TicketId); await _hub.StopAsync(); } await _hub.DisposeAsync(); }
            catch { }
        }
    }

    void GoBack() => Nav.NavigateTo("/superadmin/support");

    string GetPriorityLabel(int id) => id switch { 1 => "Low", 2 => "Medium", 3 => "High", 4 => "Critical", _ => "Unknown" };
    string GetPriorityClass(int id) => id switch { 1 => "low", 2 => "medium", 3 => "high", 4 => "critical", _ => "low" };
    string GetStatusLabel(int id) => id switch { 1 => "Open", 2 => "In Progress", 3 => "Waiting User", 4 => "Resolved", 5 => "Closed", _ => "Unknown" };
    string GetStatusClass(int id) => id switch { 1 => "open", 2 => "inprogress", 3 => "waiting", 4 => "resolved", 5 => "closed", _ => "open" };

    async Task UpdateStatus()
    {
        isUpdating = true; updateSuccess = false;
        try { var ok = await AdminService.UpdateStatusAsync(TicketId, editStatus, editPriority); if (ok && ticket != null) { ticket.StatusId = editStatus; ticket.PriorityId = editPriority; updateSuccess = true; } }
        finally { isUpdating = false; }
        await Task.Delay(2000); updateSuccess = false; await InvokeAsync(StateHasChanged);
    }

    async Task AssignTicket()
    {
        if (string.IsNullOrEmpty(selectedAssignee)) return;
        isAssigning = true; assignSuccess = false;
        try { var ok = await AdminService.AssignTicketAsync(TicketId, selectedAssignee); if (ok && ticket != null) { var dev = adminUsers.FirstOrDefault(u => u.UserId == selectedAssignee); ticket.AssignedToUserId = selectedAssignee; ticket.AssignedToName = dev?.UserName ?? selectedAssignee; assignSuccess = true; } }
        finally { isAssigning = false; }
        await Task.Delay(2000); assignSuccess = false; await InvokeAsync(StateHasChanged);
    }

    async Task CloseTicket()
    {
        isClosing = true;
        try { var ok = await AdminService.CloseTicketAsync(TicketId); if (ok && ticket != null) { ticket.StatusId = 5; await InvokeAsync(StateHasChanged); } }
        finally { isClosing = false; }
    }

    IBrowserFile? replyImage;
    string? replyImagePreview;

    async Task OnReplyImageSelected(InputFileChangeEventArgs e)
    {
        replyImage = e.File;
        using var ms = new MemoryStream();
        await replyImage.OpenReadStream(5 * 1024 * 1024).CopyToAsync(ms);
        replyImagePreview = $"data:{replyImage.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}";
    }

    void RemoveReplyImage() { replyImage = null; replyImagePreview = null; }
}
