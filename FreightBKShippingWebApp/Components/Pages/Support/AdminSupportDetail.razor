    async Task AssignTicket()
    {
        if (string.IsNullOrEmpty(selectedAssignee)) return;
        isAssigning = true; assignSuccess = false;
        try
        {
            var ok = await AdminService.AssignTicketAsync(TicketId, selectedAssignee);
            if (ok && ticket != null)
            {
                var dev = adminUsers.FirstOrDefault(u => u.UserId == selectedAssignee);
                ticket.AssignedToUserId = selectedAssignee;
                ticket.AssignedToName = dev?.UserName ?? selectedAssignee;
                assignSuccess = true;
