@code {
    [Parameter] public int TicketId { get; set; }

    SupportTicketAdminDto? ticket;
    List<AdminUserDto> adminUsers = new();
    string replyMessage = string.Empty;
    string replyError = string.Empty;
    string selectedAssignee = string.Empty;

    bool isLoading = true;
    bool isSending = false;
    bool isUpdating = false;
    bool isAssigning = false;
    bool isClosing = false;
    bool updateSuccess = false;
    bool assignSuccess = false;
    bool isConnected = false;

    int editStatus;
    int editPriority;

    private HubConnection? _hub;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        // ticket = await AdminService.GetTicketDetailAsync(TicketId);
        // if (ticket != null)
        // {
        //     editStatus = ticket.StatusId;
        //     editPriority = ticket.PriorityId;
        // }
        adminUsers = await AdminService.GetAdminUsersAsync();
        isLoading = false;
    }

    protected override async Task OnParametersSetAsync()
    {
        ticket = await AdminService.GetTicketDetailAsync(TicketId);

        if (ticket != null)
        {
            editStatus = ticket.StatusId;
            editPriority = ticket.PriorityId;
        }
        await InvokeAsync(ScrollToBottom);
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await StartHub();
            await ScrollToBottom();
           
        }
    }

    private async Task StartHub()
    {
        if (_hub != null)
            return;
        try
        {
        //     var token = await AdminService.GetAuthTokenAsync();
        //     if (string.IsNullOrEmpty(token))
        //     {
        //         Console.WriteLine("[AdminSupportDetail] No token, skipping SignalR.");
        //         return;
        //     }

          string? token = null;
        for (int i = 0; i < 5; i++)
        {
            await Task.Delay(300);
            try
            {
                token = await AdminService.GetAuthTokenAsync();
                if (!string.IsNullOrEmpty(token)) break;
            }
            catch (TaskCanceledException)
            {
                Console.WriteLine($"[StartHub] Token read attempt {i + 1} cancelled, retrying...");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[StartHub] Token read attempt {i + 1} failed: {ex.Message}");
            }
        }

            var apiBase = AdminService.GetApiBaseUrl().TrimEnd('/');

            _hub = new HubConnectionBuilder()
                 .WithUrl($"{apiBase}/signalr/ticket", options =>
                 {
                     options.AccessTokenProvider = () => Task.FromResult<string?>(token);
                     options.Transports = HttpTransportType.WebSockets;
                 })
                .WithAutomaticReconnect()
                .Build();

            _hub.Closed += async (_) =>
            {
                isConnected = false;
                await InvokeAsync(StateHasChanged);
            };

            _hub.Reconnecting += _ =>
            {
                isConnected = false;
                InvokeAsync(StateHasChanged);
                return Task.CompletedTask;
            };

            _hub.Reconnected += async _ =>
            {
                isConnected = true;
                await _hub.InvokeAsync("JoinTicket", TicketId);
                await InvokeAsync(StateHasChanged);
            };

            // ✅ Live message from user side — add to admin view instantly
            _hub.On<string, string, DateTime, int>("ReceiveMessage",
async (senderType, messageText, createdAt, messageId) =>
{
    await InvokeAsync(async () =>
    {
        if (ticket?.Messages.Any(m => m.MessageId == messageId) == true)
            return;

        ticket?.Messages.Add(new TicketMessageAdminDto
        {
            MessageId = messageId,
            TicketId = TicketId,
            MessageText = messageText,
            SenderType = senderType,
            CreatedAt = createdAt
        });

        StateHasChanged();
        await ScrollToBottom();
    });
});

            _hub.On<int>("TicketClosed", async ticketId =>  // ✅ async added
            {
                if (ticketId == TicketId && ticket != null)
                {
                    ticket.StatusId = 5;
                    await InvokeAsync(StateHasChanged);  // ✅ await added
                }
            });
            _hub.On<string>("DebugMessage", msg =>
{
    Console.WriteLine("Hub debug: " + msg);
});
            await _hub.StartAsync();
            Console.WriteLine($"SignalR State: {_hub.State}");
            if (_hub.State == HubConnectionState.Connected)
            {
                await _hub.InvokeAsync("JoinTicket", TicketId);
                isConnected = true;
            }

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[AdminSupportDetail] StartHub ERROR: {ex.Message}");
            isConnected = false;
        }
    }

    private async Task ScrollToBottom()
    {
        try { await JS.InvokeVoidAsync("scrollToBottom", "sad-messages"); }
        catch { }
    }

    async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.CtrlKey && e.Key == "Enter") await SendReply();
    }

    async Task SendReply()
    {
        if (string.IsNullOrWhiteSpace(replyMessage)) return;
        isSending = true;
        replyError = string.Empty;
        var msgText = replyMessage;

        try
        {
            var savedMsg = await AdminService.ReplyAsync(TicketId, msgText);

            if (savedMsg != null)
            {
                // ✅ Add locally with real MessageId — SignalR push will be skipped (duplicate check)
                ticket?.Messages.Add(new TicketMessageAdminDto
                {
                    MessageId = savedMsg.MessageId,
                    TicketId = TicketId,
                    MessageText = msgText,
                    SenderType = "Support",
                    CreatedAt = savedMsg.CreatedAt
                });

                replyMessage = string.Empty;
                StateHasChanged();
                await ScrollToBottom();
            }
            else
            {
                replyError = "Failed to send reply.";
            }
        }
        catch (Exception ex)
        {
            replyError = $"Error: {ex.Message}";
        }
        finally { isSending = false; }
    }

    async Task UpdateStatus()
    {
        isUpdating = true;
        updateSuccess = false;
        try
        {
            var ok = await AdminService.UpdateStatusAsync(TicketId, editStatus, editPriority);
            if (ok)
            {
                ticket!.StatusId = editStatus;
                ticket!.PriorityId = editPriority;
                updateSuccess = true;
            }
        }
        finally { isUpdating = false; }
        await Task.Delay(2500);
        updateSuccess = false;
        StateHasChanged();
    }

    async Task AssignTicket()
    {
        if (string.IsNullOrEmpty(selectedAssignee)) return;
        isAssigning = true;
        assignSuccess = false;
        try
        {
            var ok = await AdminService.AssignTicketAsync(TicketId, selectedAssignee);
            if (ok)
            {
                var dev = adminUsers.FirstOrDefault(u => u.UserId == selectedAssignee);
                ticket!.AssignedToUserId = selectedAssignee;
                ticket!.AssignedToName = dev?.UserName ?? selectedAssignee;
                assignSuccess = true;
            }
        }
        finally { isAssigning = false; }
        await Task.Delay(2500);
        assignSuccess = false;
        StateHasChanged();
    }

    async Task CloseTicket()
    {
        isClosing = true;
        try
        {
            var ok = await AdminService.CloseTicketAsync(TicketId);
            if (ok) ticket!.StatusId = 5;
        }
        finally { isClosing = false; }
    }

    void GoBack() => Nav.NavigateTo("/superadmin/support");

    public async ValueTask DisposeAsync()
    {
        if (_hub == null)
            return;

        try
        {
            if (_hub.State == HubConnectionState.Connected)
            {
                await _hub.InvokeAsync("LeaveTicket", TicketId);
                await _hub.StopAsync();
            }

            await _hub.DisposeAsync();
        }
        catch { }
    }
    string GetPriorityLabel(int id) => id switch { 1 => "Low", 2 => "Medium", 3 => "High", 4 => "Critical", _ => "Unknown" };
    string GetPriorityClass(int id) => id switch { 1 => "low", 2 => "medium", 3 => "high", 4 => "critical", _ => "low" };
    string GetStatusLabel(int id) => id switch { 1 => "Open", 2 => "In Progress", 3 => "Waiting User", 4 => "Resolved", 5 => "Closed", _ => "Unknown" };
    string GetStatusClass(int id) => id switch { 1 => "open", 2 => "inprogress", 3 => "waiting", 4 => "resolved", 5 => "closed", _ => "open" };
}
