@code {
    [Parameter] public int TicketId { get; set; }

    Ticket? ticket;
    List<TicketReply> messages = new();
    string replyMessage = string.Empty;
    string replyError = string.Empty;

    bool isLoading = true;
    bool isSending = false;
    bool isClosing = false;
    bool isConnected = false;

    IBrowserFile? replyImage;
    string? replyImagePreview;

    private HubConnection? _hub;
    private string? _hubToken;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            isLoading = true;
            _hubToken = await TicketService.GetAuthTokenAsync();
            ticket = await TicketService.GetByIdAsync(TicketId) ?? new Ticket();
            messages = await TicketService.GetRepliesAsync(TicketId) ?? new List<TicketReply>();

            var attachments = await FileUploadService.GetDocumentsAsync("TicketMessage", TicketId.ToString());
            foreach (var msg in messages)
            {
                var doc = attachments.FirstOrDefault(a =>
                    a.SubCategory == msg.MessageId.ToString() ||
                    (a.SubCategory == "image" && a.ReferenceId == TicketId.ToString())
                );
                if (doc != null)
                    msg.ImageUrl = (await FileUploadService.GetSasUrlAsync(doc.DocumentId, 60))?.Trim();
            }

            await InvokeAsync(StateHasChanged);
            await StartHub();
            isLoading = false;
            await InvokeAsync(ScrollToBottom);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[TicketDetail] ERROR: {ex.Message}");
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task StartHub()
    {
        if (_hub != null)
        {
            try { if (_hub.State == HubConnectionState.Connected) { await _hub.InvokeAsync("LeaveTicket", TicketId); await _hub.StopAsync(); } await _hub.DisposeAsync(); }
            catch { }
            _hub = null;
        }

        try
        {
            var apiBase = TicketService.GetApiBaseUrl().TrimEnd('/');
            var capturedToken = _hubToken;

            _hub = new HubConnectionBuilder()
                .WithUrl($"{apiBase}/tickethub", options =>
                {
                    options.AccessTokenProvider = () => Task.FromResult<string?>(capturedToken);
                    options.Transports = HttpTransportType.WebSockets | HttpTransportType.ServerSentEvents | HttpTransportType.LongPolling;
                })
                .WithAutomaticReconnect()
                .Build();

            _hub.Closed += async (ex) => { isConnected = false; await InvokeAsync(StateHasChanged); };
            _hub.Reconnecting += (ex) => { isConnected = false; InvokeAsync(StateHasChanged); return Task.CompletedTask; };
            _hub.Reconnected += async (_) =>
            {
                try { await _hub.InvokeAsync("JoinTicket", TicketId); } catch { }
                isConnected = true;
                await InvokeAsync(StateHasChanged);
            };

            _hub.On<string, string, DateTime, int>("ReceiveMessage",
                async (senderType, messageText, createdAt, messageId) =>
                {
                    await InvokeAsync(async () =>
                    {
                        if (messages.Any(m => m.MessageId == messageId)) return;
                        messages.Add(new TicketReply { MessageId = messageId, TicketId = TicketId, MessageText = messageText, SenderType = senderType, CreatedAt = createdAt });
                        await InvokeAsync(StateHasChanged);
                        await ScrollToBottom();
                    });
                });

            _hub.On<int>("TicketClosed", async (ticketId) =>
            {
                if (ticketId == TicketId && ticket != null) { ticket.StatusId = 5; await InvokeAsync(StateHasChanged); }
            });

            await _hub.StartAsync();
            await _hub.InvokeAsync("JoinTicket", TicketId);
            isConnected = true;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[SignalR] ERROR: {ex.Message}");
            isConnected = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ScrollToBottom()
    {
        try { await JS.InvokeVoidAsync("scrollToBottom", "chat-messages"); } catch { }
    }

    async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.CtrlKey && e.Key == "Enter") await SendReply();
    }

    async Task OnReplyImageSelected(InputFileChangeEventArgs e)
    {
        replyImage = e.File;
        using var ms = new MemoryStream();
        await replyImage.OpenReadStream(5 * 1024 * 1024).CopyToAsync(ms);
        replyImagePreview = $"data:{replyImage.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}";
        await InvokeAsync(StateHasChanged);
    }

    void RemoveReplyImage() { replyImage = null; replyImagePreview = null; }

    async Task SendReply()
    {
        if (string.IsNullOrWhiteSpace(replyMessage) && replyImage == null) return;
        isSending = true;
        replyError = string.Empty;
        var msgText = replyMessage;
        try
        {
            var reply = new TicketReply
            {
                TicketId = TicketId,
                MessageText = string.IsNullOrWhiteSpace(msgText) ? null : msgText,
                SenderType = "User",
                CreatedAt = DateTime.UtcNow
            };
            var result = await TicketService.ReplyAsync(reply);
            if (result != null)
            {
                if (replyImage != null)
                {
                    using var ms = new MemoryStream();
                    await replyImage.OpenReadStream(5 * 1024 * 1024).CopyToAsync(ms);
                    await FileUploadService.UploadFileAsync(ms.ToArray(), replyImage.Name,
                        category: "TicketMessage",
                        subCategory: result.MessageId.ToString(),
                        referenceId: TicketId.ToString());
                    reply.ImageUrl = replyImagePreview;
                    replyImage = null;
                    replyImagePreview = null;
                }
                reply.MessageId = result.MessageId;
                messages.Add(reply);
                replyMessage = string.Empty;
                await InvokeAsync(StateHasChanged);
                await ScrollToBottom();
            }
            else { replyError = "Failed to send message."; }
        }
        catch (Exception ex) { replyError = ex.Message; }
        finally { isSending = false; }
    }

    async Task CloseTicket()
    {
        isClosing = true;
        try
        {
            var ok = await TicketService.CloseAsync(TicketId);
            if (ok && ticket != null) { ticket.StatusId = 5; await InvokeAsync(StateHasChanged); }
        }
        finally { isClosing = false; }
    }

    void GoBack() => Nav.NavigateTo("/tickets");

    public async ValueTask DisposeAsync()
    {
        if (_hub != null)
        {
            try { if (_hub.State == HubConnectionState.Connected) { await _hub.InvokeAsync("LeaveTicket", TicketId); await _hub.StopAsync(); } await _hub.DisposeAsync(); }
            catch { }
        }
    }

    string GetPriorityLabel(int id) => id switch { 1 => "Low", 2 => "Medium", 3 => "High", 4 => "Critical", _ => "Unknown" };
    string GetPriorityClass(int id) => id switch { 1 => "low", 2 => "medium", 3 => "high", 4 => "critical", _ => "low" };
    string GetStatusLabel(int id) => id switch { 1 => "Open", 2 => "In Progress", 3 => "Waiting User", 4 => "Resolved", 5 => "Closed", _ => "Unknown" };
    string GetStatusClass(int id) => id switch { 1 => "open", 2 => "inprogress", 3 => "waiting", 4 => "resolved", 5 => "closed", _ => "open" };
}
