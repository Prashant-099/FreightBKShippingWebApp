        align-items: center;
        gap: 6px;
        font-size: 12px;
        color: #16a34a;
        margin-top: 8px;
        justify-content: center;
    }

    .danger-card {
        border-color: #fecaca;
    }

    .danger-text {
        font-size: 12px;
        color: #64748b;
        line-height: 1.5;
        margin: 0 0 14px;
    }

    .btn-close-ticket {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        width: 100%;
        padding: 9px;
        background: #fff;
        border: 1.5px solid #dc2626;
        border-radius: 9px;
        font-size: 13px;
        font-weight: 600;
        color: #dc2626;
        cursor: pointer;
        transition: all 0.15s;
    }

        .btn-close-ticket:hover:not(:disabled) {
            background: #dc2626;
            color: #fff;
        }

        .btn-close-ticket:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

    /* Loaders */
    .loading-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 60px;
        color: #64748b;
        gap: 12px;
    }

    .spinner {
        width: 30px;
        height: 30px;
        border: 3px solid #e2e8f0;
        border-top-color: #0284c7;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }

    .btn-spinner {
        width: 14px;
        height: 14px;
        border: 2px solid rgba(255,255,255,0.4);
        border-top-color: #fff;
        border-radius: 50%;
        animation: spin 0.7s linear infinite;
        display: inline-block;
    }

        .btn-spinner.dark {
            border-color: rgba(0,0,0,0.15);
            border-top-color: #fff;
        }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }
</style>

@code {
    [Parameter] public int TicketId { get; set; }

    Ticket ticket = new();
    List<TicketReply> messages = new();
    string replyMessage = string.Empty;
    string replyError = string.Empty;

    bool isLoading = true;
    bool isSending = false;
    bool isUpdating = false;
    bool isClosing = false;
    bool updateSuccess = false;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        ticket = await TicketService.GetByIdAsync(TicketId) ?? new Ticket();
        messages = await TicketService.GetRepliesAsync(TicketId);
        isLoading = false;
    }

    async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.CtrlKey && e.Key == "Enter")
            await SendReply();
    }

    async Task SendReply()
    {
        if (string.IsNullOrWhiteSpace(replyMessage)) return;

        isSending = true;
        replyError = string.Empty;

        try
        {
            var reply = new TicketReply
            {
                TicketId = TicketId,
                MessageText = replyMessage,
                SenderType = "User",
                CreatedAt = DateTime.UtcNow
            };

            var success = await TicketService.ReplyAsync(reply);
            if (success)
            {
                messages = await TicketService.GetRepliesAsync(TicketId);
                replyMessage = string.Empty;
            }
            else
            {
                replyError = "Failed to send message. Please try again.";
            }
        }
        catch (Exception ex)
        {
            replyError = $"Error: {ex.Message}";
        }
        finally
        {
            isSending = false;
        }
    }

    async Task UpdateTicket()
    {
        isUpdating = true;
        updateSuccess = false;

        try
        {
            var success = await TicketService.UpdateAsync(ticket);
            if (success) updateSuccess = true;
        }
        finally
        {
            isUpdating = false;
        }

        // Auto-hide success message
        await Task.Delay(3000);
        updateSuccess = false;
        StateHasChanged();
    }

    async Task CloseTicket()
    {
        isClosing = true;
        try
        {
            var success = await TicketService.CloseAsync(TicketId);
            if (success)
            {
                ticket.StatusId = 5;
                StateHasChanged();
            }
        }
        finally
        {
            isClosing = false;
        }
    }

    void GoBack() => Nav.NavigateTo("/tickets");

