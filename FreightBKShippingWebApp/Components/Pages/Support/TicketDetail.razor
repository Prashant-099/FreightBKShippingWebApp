    .btn-update {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        width: 100%;
        padding: 10px;
        background: #0f172a;
        border: none;
        border-radius: 9px;
        font-size: 13px;
        font-weight: 600;
        color: #fff;
        cursor: pointer;
        margin-top: 4px;
        transition: background 0.18s;
    }

        .btn-update:hover:not(:disabled) {
