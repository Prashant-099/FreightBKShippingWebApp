@page "/tickets/{TicketId:int}"
@attribute [Authorize]
@implements IAsyncDisposable
@using FreightBKShippingWebApp.Model
@using FreightBKShippingWebApp.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.AspNetCore.Http.Connections;
@inject TicketService TicketService
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject FileUploadService FileUploadService

<div class="td-page">
    <div class="td-shell">
        <div class="td-header">
            <button class="td-back" @onclick="GoBack">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                </svg>
                <span class="td-back-text">All Tickets</span>
            </button>
            @if (ticket != null)
            {
                <div class="td-header-info">
                    <h1 class="td-title">
                        <span class="td-tno">#@ticket.TicketNo</span>
                        @ticket.Subject
                    </h1>
                    <div class="td-badges">
                        <span class="badge pri-@GetPriorityClass(ticket.PriorityId)">@GetPriorityLabel(ticket.PriorityId)</span>
                        <span class="badge sta-@GetStatusClass(ticket.StatusId)">@GetStatusLabel(ticket.StatusId)</span>
                    </div>
                </div>
            }
        </div>

        @if (isLoading)
        {
            <div class="td-loading"><div class="td-spinner"></div><p>Loading ticket...</p></div>
        }
        else if (ticket != null)
        {
            <div class="td-layout">
                <div class="td-chat">
                    <div class="td-chat-hdr">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
                        </svg>
                        Conversation
                        <span class="td-msg-cnt">@messages.Count messages</span>
                        @if (isConnected)
                        {
                            <span class="td-live" title="Live"></span>
                        }
                    </div>

                    <div class="td-msgs" id="chat-messages">
                        @if (!messages.Any())
                        {
                            <div class="td-empty-msgs">
                                <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" fill="none" viewBox="0 0 24 24" stroke="#cbd5e1" stroke-width="1.5">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
                                </svg>
                                <p>No messages yet. Send the first message below.</p>
                            </div>
                        }
                        else
                        {
                            @foreach (var msg in messages.OrderBy(x => x.CreatedAt))
                            {
                                var mediaUrl = msg.ImageUrl?.Trim();
                                var mediaType = GetMessageContentType(msg);
                                <div class="td-msg @(msg.SenderType == "User" ? "msg-me" : "msg-them")">
                                    <div class="td-av @(msg.SenderType == "User" ? "av-me" : "av-them")">
                                        @if (msg.SenderType == "User")
                                        {
                                            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="currentColor" viewBox="0 0 24 24">
                                                <path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z" />
                                            </svg>
                                        }
                                        else
                                        {
                                            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="currentColor" viewBox="0 0 24 24">
                                                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14H9V8h2v8zm4 0h-2V8h2v8z" />
                                            </svg>
                                        }
                                    </div>
                                    <div class="td-msg-body">
                                        <div class="td-msg-meta">
                                            <span class="td-sender">@(msg.SenderType == "User" ? "You" : "Support Team")</span>
                                            <span class="td-time">@msg.CreatedAt.ToLocalTime().ToString("MMM dd, HH:mm")</span>
                                        </div>
                                        <div class="td-bubble @(msg.SenderType == "User" ? "bbl-me" : "bbl-them")">
                                            @if (!string.IsNullOrEmpty(msg.MessageText))
                                            {
                                                <div class="td-msg-text">@msg.MessageText</div>
                                            }
                                            @if (!string.IsNullOrEmpty(mediaUrl))
                                            {
                                                @if (IsVideoMessage(msg))
                                                {
                                                    <video class="td-video" controls playsinline preload="metadata"
                                                           @onerror="() => OnVideoLoadError(msg)"
                                                           @onloadedmetadata="() => OnVideoLoaded(msg.MessageId)">
                                                        <source src="@mediaUrl" type="@mediaType" />
                                                        Your browser does not support this video format.
                                                    </video>
                                                    @if (videoPlaybackFailed.Contains(msg.MessageId))
                                                    {
                                                        <a class="td-media-link" href="@mediaUrl" target="_blank" rel="noopener noreferrer">Open Video</a>
                                                    }
                                                }
                                                else
                                                {
                                                    <img src="@mediaUrl" class="td-img" alt="attachment" />
                                                }
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>

                    @if (ticket.StatusId != 5)
                    {
                        <div class="td-reply">
                            @if (!string.IsNullOrEmpty(replyError))
                            {
                                <div class="td-reply-err">@replyError</div>
                            }
                            <InputFile accept=".jpg,.jpeg,.png,.gif,.webp,.mp4,.webm,.mov,image/*,video/*"
                                       OnChange="OnReplyMediaSelected" id="replyMediaInput" style="display:none" />

                            @if (replyMedia != null)
                            {
                                <div class="td-img-wrap">
                                    @if (!string.IsNullOrEmpty(replyMediaPreview))
                                    {
                                        <img src="@replyMediaPreview" class="td-img-prev" alt="Preview" />
                                    }
                                    else
                                    {
                                        <div class="td-media-chip">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14v-4z" />
                                                <rect x="3" y="6" width="12" height="12" rx="2" />
                                            </svg>
                                            <span class="td-media-name">@replyMediaFileName</span>
                                            <span class="td-media-size">@FormatFileSize(replyMediaSizeBytes)</span>
                                        </div>
                                    }
                                    <button type="button" class="td-img-rm" @onclick="RemoveReplyMedia">x</button>
                                </div>
                            }

                            <div class="td-compose-box">
                                <textarea class="td-textarea" rows="3" @bind="replyMessage" @bind:event="oninput"
                                          maxlength="@MaxMessageChars" placeholder="Type your message here"
                                          @onkeydown="HandleKeyDown"></textarea>
                                <div class="td-reply-bottom">
                                    <label for="replyMediaInput" class="td-img-lbl" title="Attach image/video">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
                                        </svg>
                                        <span class="td-img-lbl-text">Attach Media</span>
                                    </label>
                                    <button class="td-btn-send" @onclick="SendReply"
                                            disabled="@(isSending || (string.IsNullOrWhiteSpace(replyMessage) && replyMedia == null))" title="Send">
                                        @if (isSending)
                                        {
                                            <span class="td-spin"></span>
                                        }
                                        else
                                        {
                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                                            </svg>
                                        }
                                        <span class="td-send-text">Send</span>
                                    </button>
                                </div>
                            </div>
                            <span class="td-hint">Ctrl+Enter to send. Images up to 5 MB, videos up to 25 MB.</span>
                        </div>
                    }
                    else
                    {

                        <div class="td-closed">Ticket is closed. Replies are disabled.</div>
                    }
                </div>

                <div class="td-info">
                    <div class="td-card">
                        <h3 class="td-card-title">Ticket Info</h3>
                        <div class="td-info-row"><span class="td-lbl">Ticket No</span><span class="td-val tno-val">#@ticket.TicketNo</span></div>
                        <div class="td-info-row"><span class="td-lbl">Subject</span><span class="td-val">@ticket.Subject</span></div>
                        <div class="td-info-row"><span class="td-lbl">Priority</span><span class="badge pri-@GetPriorityClass(ticket.PriorityId)">@GetPriorityLabel(ticket.PriorityId)</span></div>
                        <div class="td-info-row"><span class="td-lbl">Status</span><span class="badge sta-@GetStatusClass(ticket.StatusId)">@GetStatusLabel(ticket.StatusId)</span></div>
                        <div class="td-info-row"><span class="td-lbl">Created</span><span class="td-val">@ticket.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</span></div>
                    </div>
                    @if (ticket.StatusId != 5)
                    {
                        <div class="td-card td-danger-card">
                            <h3 class="td-card-title">Close Ticket</h3>
                            <p class="td-danger-txt">Once closed, replies will be disabled. Close only after your issue is fully resolved.</p>
                            <button class="td-btn-close" @onclick="CloseTicket" disabled="@isClosing">
                                @if (isClosing)
                                {
                                    <span class="td-spin"></span>
                                    <span>Closing...</span>
         }
                                else
                                {
                                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                                    </svg>
                                    <span>Close Ticket</span>
                                }
                            </button>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public int TicketId { get; set; }

    Ticket? ticket;
    List<TicketReply> messages = new();
    string replyMessage = string.Empty, replyError = string.Empty;
    bool isLoading = true, isSending = false, isClosing = false, isConnected = false;

    const int MaxMessageChars = 2000;
    const long MaxImageBytes = 5L * 1024 * 1024;
    const long MaxVideoBytes = 25L * 1024 * 1024;

    static readonly HashSet<string> AllowedImageExtensions = new(StringComparer.OrdinalIgnoreCase)
        { ".jpg", ".jpeg", ".png", ".gif", ".webp" };
    static readonly HashSet<string> AllowedVideoExtensions = new(StringComparer.OrdinalIgnoreCase)
        { ".mp4", ".webm", ".mov" };

    readonly Dictionary<int, string> messageContentTypes = new();
    readonly Dictionary<int, long> messageDocumentIds = new();
    readonly HashSet<int> videoPlaybackFailed = new();

    IBrowserFile? replyMedia;
    string? replyMediaPreview, replyMediaFileName, replyMediaContentType;
    long replyMediaSizeBytes;
    HubConnection? _hub;
    string? _hubToken;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            isLoading = true;
            _hubToken = await TicketService.GetAuthTokenAsync();
            ticket = await TicketService.GetByIdAsync(TicketId) ?? new Ticket();
            messages = await TicketService.GetRepliesAsync(TicketId) ?? new();
            messageContentTypes.Clear(); messageDocumentIds.Clear(); videoPlaybackFailed.Clear();

            var attachments = await FileUploadService.GetDocumentsAsync("TicketMessage", TicketId.ToString());
            var sasTasks = messages.Select(async msg =>
            {
                var doc = attachments.FirstOrDefault(a =>
                    a.SubCategory == msg.MessageId.ToString()
                    || (a.SubCategory == "pending"
                        && a.ReferenceId == TicketId.ToString()
                        && Math.Abs((a.UploadedAt - msg.CreatedAt).TotalMinutes) < 3));
                if (doc != null)
                {
                    msg.ImageUrl = (await FileUploadService.GetSasUrlAsync(doc.DocumentId, 120))?.Trim();
                    SetMessageContentType(msg.MessageId, doc.ContentType, doc.OriginalFileName);
                    messageDocumentIds[msg.MessageId] = doc.DocumentId;
                }
            }).ToList();
            await Task.WhenAll(sasTasks);

            await InvokeAsync(StateHasChanged);
            await StartHub();
            isLoading = false;
            await InvokeAsync(ScrollToBottom);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[TicketDetail] ERROR: {ex.Message}");
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    async Task StartHub()
    {
        if (_hub != null)
        {
            try
            {
                if (_hub.State == HubConnectionState.Connected)
                { await _hub.InvokeAsync("LeaveTicket", TicketId); await _hub.StopAsync(); }
                await _hub.DisposeAsync();
            }
            catch { }
            _hub = null;
        }

        try
        {
            var apiBase = TicketService.GetApiBaseUrl().TrimEnd('/');
            var capturedToken = _hubToken;

            _hub = new HubConnectionBuilder()
                .WithUrl($"{apiBase}/tickethub", options =>
                {
                    options.AccessTokenProvider = () => Task.FromResult<string?>(capturedToken);
                    options.Transports = HttpTransportType.WebSockets | HttpTransportType.ServerSentEvents | HttpTransportType.LongPolling;
                })
                .WithAutomaticReconnect()
                .Build();

            _hub.Closed += async _ => { isConnected = false; await InvokeAsync(StateHasChanged); };
            _hub.Reconnecting += _ => { isConnected = false; InvokeAsync(StateHasChanged); return Task.CompletedTask; };
            _hub.Reconnected += async _ =>
            {
                try { await _hub.InvokeAsync("JoinTicket", TicketId); } catch { }
                isConnected = true; await InvokeAsync(StateHasChanged);
            };

            _hub.On<string, string, DateTime, int, long>("ReceiveMessage",
                async (senderType, messageText, createdAt, messageId, mediaDocumentId) =>
                {
                    await InvokeAsync(async () =>
                    {
                        // ✅ FIX: Agar message already exist karta hai (sender ne khud bheja)
                        // aur mediaDocumentId hai toh ImageUrl update karo — skip mat karo
                        var existing = messages.FirstOrDefault(m => m.MessageId == messageId);
                        if (existing != null)
                        {
                            // Message exist karta hai — sirf ImageUrl update karo agar missing hai
                            if (mediaDocumentId > 0 && string.IsNullOrWhiteSpace(existing.ImageUrl))
                            {
                                try
                                {
                                    var sasUrl = (await FileUploadService.GetSasUrlAsync(mediaDocumentId, 120))?.Trim();
                                    existing.ImageUrl = sasUrl;
                                    messageDocumentIds[messageId] = mediaDocumentId;
                                    if (!string.IsNullOrWhiteSpace(sasUrl))
                                        SetMessageContentType(messageId, null, sasUrl.Split('?')[0]);
                                    await InvokeAsync(StateHasChanged);
                                }
                                catch (Exception ex) { Console.WriteLine($"[SignalR] ImageUrl update failed: {ex.Message}"); }
                            }
                            return; // message already rendered hai
                        }

                        // Naya message — text only duplicate check
                        if (IsProbableDuplicateTextOnly(senderType, messageText, createdAt)) return;

                        var newMsg = new TicketReply
                        {
                            MessageId = messageId,
                            TicketId = TicketId,
                            MessageText = messageText,
                            SenderType = senderType,
                            CreatedAt = createdAt
                        };

                        if (mediaDocumentId > 0)
                        {
                            try
                            {
                                var sasUrl = (await FileUploadService.GetSasUrlAsync(mediaDocumentId, 120))?.Trim();
                                newMsg.ImageUrl = sasUrl;
                                messageDocumentIds[messageId] = mediaDocumentId;
                                if (!string.IsNullOrWhiteSpace(sasUrl))
                                    SetMessageContentType(messageId, null, sasUrl.Split('?')[0]);
                            }
                            catch (Exception ex) { Console.WriteLine($"[SignalR] SAS fetch failed: {ex.Message}"); }
                        }

                        UpsertMessage(newMsg);
                        await InvokeAsync(StateHasChanged);
                        await ScrollToBottom();
                    });
                });

            _hub.On<int>("TicketClosed", async ticketId =>
            {
                if (ticketId == TicketId && ticket != null)
                { ticket.StatusId = 5; await InvokeAsync(StateHasChanged); }
            });

            await _hub.StartAsync();
            await _hub.InvokeAsync("JoinTicket", TicketId);
            isConnected = true;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[SignalR] ERROR: {ex.Message}");
            isConnected = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    async Task ScrollToBottom()
    {
        try
        {
            await Task.Delay(100);
            await JS.InvokeVoidAsync("scrollToBottom", "chat-messages");
        }
        catch { }
    }

    async Task OnReplyMediaSelected(InputFileChangeEventArgs e)
    {
        replyError = string.Empty; ClearReplyMedia();
        var selected = e.File;
        if (selected == null) return;
        var ext = Path.GetExtension(selected.Name);
        var isImage = IsAllowedImage(selected.ContentType, ext);
        var isVideo = IsAllowedVideo(selected.ContentType, ext);
        if (!isImage && !isVideo) { replyError = "Only JPG, JPEG, PNG, GIF, WEBP, MP4, WEBM and MOV files are allowed."; await InvokeAsync(StateHasChanged); return; }
        var maxBytes = isVideo ? MaxVideoBytes : MaxImageBytes;
        if (selected.Size > maxBytes) { replyError = isVideo ? "Video size must be 25 MB or less." : "Image size must be 5 MB or less."; await InvokeAsync(StateHasChanged); return; }
        replyMedia = selected; replyMediaFileName = selected.Name; replyMediaSizeBytes = selected.Size;
        replyMediaContentType = ResolveContentType(selected.ContentType, selected.Name);
        if (isImage)
        {
            using var ms = new MemoryStream();
            await selected.OpenReadStream(MaxImageBytes).CopyToAsync(ms);
            replyMediaPreview = $"data:{replyMediaContentType};base64,{Convert.ToBase64String(ms.ToArray())}";
        }
        await InvokeAsync(StateHasChanged);
    }

    void RemoveReplyMedia() => ClearReplyMedia();

    async Task SendReply()
    {
        if (isSending) return;
        if (string.IsNullOrWhiteSpace(replyMessage) && replyMedia == null) return;
        var msgText = string.IsNullOrWhiteSpace(replyMessage) ? null : replyMessage.Trim();
        if ((msgText?.Length ?? 0) > MaxMessageChars) { replyError = $"Message can have at most {MaxMessageChars} characters."; return; }

        isSending = true; replyError = string.Empty;
        var capturedMedia = replyMedia;
        var capturedMediaName = replyMediaFileName;
        var capturedMediaContentType = replyMediaContentType;
        var capturedPreview = replyMediaPreview;

        try
        {
            long? mediaDocumentId = null;
            if (capturedMedia != null)
            {
                using var ms = new MemoryStream();
                await capturedMedia.OpenReadStream(GetMaxUploadBytes(capturedMedia)).CopyToAsync(ms);
                var upload = await FileUploadService.UploadFileAsync(
                    ms.ToArray(), capturedMediaName!,
                    category: "TicketMessage", subCategory: "pending", referenceId: TicketId.ToString());
                if (upload?.DocumentId > 0) mediaDocumentId = upload.DocumentId;
            }

            var result = await TicketService.ReplyAsync(new TicketReply
            {
                TicketId = TicketId,
                MessageText = msgText,
                SenderType = "User",
                CreatedAt = DateTime.UtcNow,
                MediaDocumentId = mediaDocumentId
            });

            if (result != null)
            {
                if (mediaDocumentId > 0)
                    _ = FileUploadService.UpdateSubCategoryAsync(mediaDocumentId.Value, result.MessageId.ToString());

                var newMsg = new TicketReply
                {
                    MessageId = result.MessageId,
                    TicketId = TicketId,
                    MessageText = msgText,
                    SenderType = "User",
                    CreatedAt = result.CreatedAt
                };

                if (mediaDocumentId > 0)
                {
                    newMsg.ImageUrl = (await FileUploadService.GetSasUrlAsync(mediaDocumentId.Value, 120))?.Trim();
                    SetMessageContentType(result.MessageId, capturedMediaContentType, capturedMediaName);
                    messageDocumentIds[result.MessageId] = mediaDocumentId.Value;
                }
                else if (!string.IsNullOrEmpty(capturedPreview))
                    newMsg.ImageUrl = capturedPreview;

                ClearReplyMedia();
                UpsertMessage(newMsg);
                replyMessage = string.Empty;
                await InvokeAsync(StateHasChanged);
                await ScrollToBottom();
            }
            else replyError = "Failed to send message.";
        }
        catch (Exception ex) { replyError = ex.Message; }
        finally { isSending = false; }
    }

    async Task CloseTicket()
    {
        isClosing = true;
        try { var ok = await TicketService.CloseAsync(TicketId); if (ok && ticket != null) { ticket.StatusId = 5; await InvokeAsync(StateHasChanged); } }
        finally { isClosing = false; }
    }

    void GoBack() => Nav.NavigateTo("/tickets");

    void UpsertMessage(TicketReply incoming)
    {
        var existing = messages.FirstOrDefault(m => m.MessageId == incoming.MessageId);
        if (existing == null) { messages.Add(incoming); return; }
        existing.SenderType = incoming.SenderType;
        existing.CreatedAt = incoming.CreatedAt == default ? existing.CreatedAt : incoming.CreatedAt;
        if (string.IsNullOrWhiteSpace(existing.MessageText) && !string.IsNullOrWhiteSpace(incoming.MessageText)) existing.MessageText = incoming.MessageText;
        if (string.IsNullOrWhiteSpace(existing.ImageUrl) && !string.IsNullOrWhiteSpace(incoming.ImageUrl)) existing.ImageUrl = incoming.ImageUrl;
    }

    // ✅ FIX: Sirf text-based duplicate check — messageId check removed
    // Kyun: Sender side pe message add ho jaata hai pehle (SendReply mein),
    // toh SignalR broadcast ata hai same messageId ke saath — pehle wala check
    // "messageId exist karta hai → return true" karta tha → media kabhi set nahi hoti
    bool IsProbableDuplicateTextOnly(string senderType, string? messageText, DateTime createdAt)
    {
        var t = (messageText ?? string.Empty).Trim();
        if (t.Length == 0) return false;
        return messages.Any(m =>
            string.Equals(m.SenderType, senderType, StringComparison.OrdinalIgnoreCase) &&
            string.Equals((m.MessageText ?? string.Empty).Trim(), t, StringComparison.Ordinal) &&
            Math.Abs((m.CreatedAt - createdAt).TotalSeconds) <= 2);
    }

    bool IsVideoMessage(TicketReply msg)
    {
        if (messageContentTypes.TryGetValue(msg.MessageId, out var ct) && IsVideoContentType(ct)) return true;
        return IsVideoFileName(msg.ImageUrl);
    }

    string GetMessageContentType(TicketReply msg)
    {
        messageContentTypes.TryGetValue(msg.MessageId, out var ct);
        return ResolveContentType(ct, msg.ImageUrl);
    }

    void SetMessageContentType(int messageId, string? ct, string? fallbackFileName)
    {
        if (messageId <= 0) return;
        var resolved = ResolveContentType(ct, fallbackFileName);
        if (!string.IsNullOrWhiteSpace(resolved)) messageContentTypes[messageId] = resolved;
    }

    static bool IsAllowedImage(string? ct, string ext) => AllowedImageExtensions.Contains(ext) || IsImageContentType(ct);
    static bool IsAllowedVideo(string? ct, string ext) => AllowedVideoExtensions.Contains(ext) || IsVideoContentType(ct);
    static bool IsImageContentType(string? ct) => !string.IsNullOrWhiteSpace(ct) && ct.StartsWith("image/", StringComparison.OrdinalIgnoreCase);
    static bool IsVideoContentType(string? ct) => !string.IsNullOrWhiteSpace(ct) && ct.StartsWith("video/", StringComparison.OrdinalIgnoreCase);

    static bool IsVideoFileName(string? p)
    {
        if (string.IsNullOrWhiteSpace(p)) return false;
        return AllowedVideoExtensions.Contains(Path.GetExtension(p.Split('?')[0]));
    }

    static string ResolveContentType(string? ct, string? fileName)
    {
        if (!string.IsNullOrWhiteSpace(ct) && !IsGenericBinaryContentType(ct)) return ct;
        var cleanName = (fileName ?? string.Empty).Split('?')[0];
        return Path.GetExtension(cleanName).ToLowerInvariant() switch
        {
            ".jpg" or ".jpeg" => "image/jpeg",
            ".png" => "image/png",
            ".gif" => "image/gif",
            ".webp" => "image/webp",
            ".mp4" => "video/mp4",
            ".webm" => "video/webm",
            ".mov" => "video/quicktime",
            _ => "application/octet-stream"
        };
    }

    static bool IsGenericBinaryContentType(string ct) =>
        ct.Equals("application/octet-stream", StringComparison.OrdinalIgnoreCase) ||
        ct.Equals("binary/octet-stream", StringComparison.OrdinalIgnoreCase);

    static long GetMaxUploadBytes(IBrowserFile file)
    {
        var ext = Path.GetExtension(file.Name);
        return IsAllowedVideo(file.ContentType, ext) ? MaxVideoBytes : MaxImageBytes;
    }

    static string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024d:0.#} KB";
        return $"{bytes / (1024d * 1024):0.#} MB";
    }

    void ClearReplyMedia() { replyMedia = null; replyMediaPreview = null; replyMediaFileName = null; replyMediaContentType = null; replyMediaSizeBytes = 0; }

    async Task OnVideoLoadError(TicketReply msg)
    {
        if (videoPlaybackFailed.Contains(msg.MessageId)) return;
        if (msg.MessageId <= 0 || !messageDocumentIds.TryGetValue(msg.MessageId, out var docId)) { videoPlaybackFailed.Add(msg.MessageId); return; }
        try
        {
            var freshUrl = (await FileUploadService.GetSasUrlAsync(docId, 120))?.Trim();
            if (!string.IsNullOrWhiteSpace(freshUrl) && !string.Equals(freshUrl, msg.ImageUrl, StringComparison.Ordinal))
            { msg.ImageUrl = freshUrl; videoPlaybackFailed.Remove(msg.MessageId); await InvokeAsync(StateHasChanged); return; }
        }
        catch { }
        videoPlaybackFailed.Add(msg.MessageId);
        await InvokeAsync(StateHasChanged);
    }

    void OnVideoLoaded(int messageId) { if (videoPlaybackFailed.Remove(messageId)) _ = InvokeAsync(StateHasChanged); }

    public async ValueTask DisposeAsync()
    {
        if (_hub != null)
        {
            try { if (_hub.State == HubConnectionState.Connected) { await _hub.InvokeAsync("LeaveTicket", TicketId); await _hub.StopAsync(); } await _hub.DisposeAsync(); }
            catch { }
        }
    }

    string GetPriorityLabel(int id) => id switch { 1 => "Low", 2 => "Medium", 3 => "High", 4 => "Critical", _ => "Unknown" };
    string GetPriorityClass(int id) => id switch { 1 => "low", 2 => "medium", 3 => "high", 4 => "critical", _ => "low" };
    string GetStatusLabel(int id) => id switch { 1 => "Open", 2 => "In Progress", 3 => "Waiting User", 4 => "Resolved", 5 => "Closed", _ => "Unknown" };
    string GetStatusClass(int id) => id switch { 1 => "open", 2 => "inprogress", 3 => "waiting", 4 => "resolved", 5 => "closed", _ => "open" };

    async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.CtrlKey && e.Key == "Enter") await SendReply();
    }
}
