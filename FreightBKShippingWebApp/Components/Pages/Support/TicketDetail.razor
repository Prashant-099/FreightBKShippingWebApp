@page "/tickets/{TicketId:int}"
@attribute [Authorize]

@using FreightBKShippingWebApp.Model
@using FreightBKShippingWebApp.Services
@using Microsoft.AspNetCore.Authorization

@inject TicketService TicketService
@inject NavigationManager Nav

<div class="support-page">

    <!-- Header -->
    <div class="page-header">
        <button class="btn-back" @onclick="GoBack">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
            </svg>
            All Tickets
        </button>
        <div class="header-info">
            <h1 class="page-title">
                <span class="ticket-no-label">#@ticket.TicketNo</span>
                @ticket.Subject
            </h1>
            <div class="header-badges">
                <span class="ticket-badge priority-@GetPriorityClass(ticket.PriorityId)">@GetPriorityLabel(ticket.PriorityId)</span>
                <span class="ticket-badge status-@GetStatusClass(ticket.StatusId)">@GetStatusLabel(ticket.StatusId)</span>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading ticket...</p>
        </div>
    }
    else
    {
        <div class="detail-layout">

            <!-- Left: Chat Panel -->
            <div class="chat-panel">
                <div class="chat-panel-header">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
                    </svg>
                    Conversation
                    <span class="msg-count">@messages.Count messages</span>
                </div>

                <!-- Messages -->
                <div class="chat-messages" id="chat-messages">
                    @if (!messages.Any())
                    {
                        <div class="no-messages">
                            <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" fill="none" viewBox="0 0 24 24" stroke="#cbd5e1" stroke-width="1.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
                            </svg>
                            <p>No messages yet. Send the first message below.</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var m in messages.OrderBy(m => m.CreatedAt))
                        {
                            <div class="message-wrapper @(m.SenderType == "User" ? "from-user" : "from-support")">
                                <div class="message-avatar">
                                    @if (m.SenderType == "User")
                                    {
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 24 24">
                                            <path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z" />
                                        </svg>
                                    }
                                    else
                                    {
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 24 24">
                                            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14H9V8h2v8zm4 0h-2V8h2v8z" />
                                        </svg>
                                    }
                                </div>
                                <div class="message-content">
                                    <div class="message-meta">
                                        <span class="sender-name">@(m.SenderType == "User" ? "You" : "Support Team")</span>
                                        <span class="message-time">@m.CreatedAt.ToLocalTime().ToString("MMM dd, HH:mm")</span>
                                    </div>
                                    <div class="message-bubble">@m.MessageText</div>
                                </div>
                            </div>
                        }
                    }
                </div>

                <!-- Reply Box -->
                @if (ticket.StatusId != 5)
                {
                    <div class="reply-box">
                        @if (!string.IsNullOrEmpty(replyError))
                        {
                            <div class="reply-error">@replyError</div>
                        }
                        <textarea class="reply-textarea"
                                  rows="3"
                                  @bind="replyMessage"
                                  @bind:event="oninput"
                                  placeholder="Type your message here..."
                                  @onkeydown="HandleKeyDown"></textarea>
                        <div class="reply-actions">
                            <span class="reply-hint">
                                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                                Ctrl+Enter to send
                            </span>
                            <button class="btn-send" @onclick="SendReply" disabled="@(isSending || string.IsNullOrWhiteSpace(replyMessage))">
                                @if (isSending)
                                {
                                    <span class="btn-spinner"></span>
                                }
                                else
                                {
                                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                                    </svg>
                                }
                                Send
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="ticket-closed-notice">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                        </svg>
                        This ticket is closed. Replies are disabled.
                    </div>
                }
            </div>

            <!-- Right: Info Panel -->
            <div class="info-panel">

                <!-- Ticket Details -->
                <div class="info-card">
                    <h3 class="info-card-title">Ticket Details</h3>

                    <div class="info-field">
                        <label>Subject</label>
                        <p>@ticket.Subject</p>
                    </div>

                    <div class="info-field">
                        <label>Status</label>
                        <div class="select-wrapper">
                            <select class="form-select" @bind="ticket.StatusId">
                                <option value="1">Open</option>
                                <option value="2">In Progress</option>
                                <option value="3">Waiting User</option>
                                <option value="4">Resolved</option>
                                <option value="5">Closed</option>
                            </select>
                            <svg class="select-icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                            </svg>
                        </div>
                    </div>

                    <div class="info-field">
                        <label>Priority</label>
                        <div class="select-wrapper">
                            <select class="form-select" @bind="ticket.PriorityId">
                                <option value="1">Low</option>
                                <option value="2">Medium</option>
                                <option value="3">High</option>
                                <option value="4">Critical</option>
                            </select>
                            <svg class="select-icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                            </svg>
                        </div>
                    </div>

                    <button class="btn-update" @onclick="UpdateTicket" disabled="@isUpdating">
                        @if (isUpdating)
                        {
                            <span class="btn-spinner dark"></span>
                            <span>Updating...</span>
                        }
                        else
                        {
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                            </svg>
                            <span>Update Ticket</span>
                        }
                    </button>

                    @if (updateSuccess)
                    {
                        <div class="update-success">
                            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                            </svg>
                            Updated successfully!
                        </div>
                    }
                </div>

                <!-- Close Ticket -->
                @if (ticket.StatusId != 5)
                {
                    <div class="info-card danger-card">
                        <h3 class="info-card-title">Close Ticket</h3>
                        <p class="danger-text">Once closed, replies will be disabled. Close only when your issue is fully resolved.</p>
                        <button class="btn-close-ticket" @onclick="CloseTicket" disabled="@isClosing">
                            @if (isClosing)
                            {
                                <span class="btn-spinner"></span>
                                <span>Closing...</span>
                            }
                            else
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                                </svg>
                                <span>Close Ticket</span>
                            }
                        </button>
                    </div>
                }
            </div>
        </div>
    }
</div>

<style>
