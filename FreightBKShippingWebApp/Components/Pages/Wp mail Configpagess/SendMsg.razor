@using FreightBKShippingWebApp.Model
@using FreightBKShippingWebApp.Services

@inject ChatwayService ChatwayService
@inject SendWpMailService SendWpMailService
@inject ToasteService ToasteService
@inject LoadingService LoadingService
@inject WpMailConfigService WpMailConfigService

<style>
    .readonly-value {
        background-color: #f5f5f5;
        border: 1px solid #ccc;
        padding: 8px 10px;
        border-radius: 4px;
        font-size: 1rem;
        color: #333;
        width: 100%;
        box-sizing: border-box;
    }

    .credits-badge {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 5px 10px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-weight: 600;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        margin-bottom: 10px;
    }

        .credits-badge i {
            font-size: 1.2rem;
        }

    .low-credit-warning {
        background-color: #fff3cd;
        border: 1px solid #ffc107;
        border-radius: 8px;
        padding: 15px;
        margin: 20px 0;
        text-align: center;
    }

        .low-credit-warning p {
            margin: 10px 0;
            color: #856404;
        }

        .low-credit-warning b {
            color: #d63384;
            font-size: 1.1rem;
        }

    .popup-footer-buttons {
        display: flex;
        gap: 10px;
        justify-content: flex-end;
    }

    .form-layout-container {
        padding: 10px 0;
    }
</style>

<DxPopup @bind-Visible="IsVisible"
         ShowFooter="true"
         HeaderText="Send File via WhatsApp"
         MaxWidth="700px"
         CloseOnOutsideClick="false"
         ShowCloseButton="true"
         Scrollable="true"
         HorizontalAlignment="HorizontalAlignment.Center"
         VerticalAlignment="VerticalAlignment.Center"
         Closing="OnClose">

    <BodyContentTemplate Context="ctxsent">
        <div class="form-layout-container">
            <!-- Display total credits / balance -->
            <div class="credits-badge">
                <i class="bi bi-wallet2"></i>
                <span>Available Credits: @totalwpcredit</span>
            </div>

            <DxFormLayout>
                <DxFormLayoutItem Caption="Country Code" ColSpanMd="3">
                    <DxTextBox @bind-Text="CountryCode" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="Mobile Numbers" ColSpanMd="9">
                    <DxMemo @bind-Text="PhoneNumbersText" Rows="1"
                            NullText="Enter numbers separated by comma or newline" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="Message" ColSpanMd="12">
                    <DxMemo @bind-Text="Message" Rows="3" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="File Name" ColSpanMd="12">
                    <DxTextBox @bind-Text="FileName" ReadOnly="true" />
                </DxFormLayoutItem>
            </DxFormLayout>
        </div>
    </BodyContentTemplate>

    <FooterContentTemplate>
        <div class="popup-footer-buttons">
            <DxButton Text="Send File" Click="SendFile" RenderStyle="ButtonRenderStyle.Primary"
                      Enabled="@IsSendEnabled" />
            <DxButton Text="Close" Click="OnClose" RenderStyle="ButtonRenderStyle.Secondary" />
        </div>
    </FooterContentTemplate>
</DxPopup>

<DxPopup @bind-Visible="IsVisibleCreditPopup"
         ShowFooter="true"
         HeaderText="⚠️ Low WhatsApp Credits"
         Width="500px"
         CloseOnOutsideClick="false"
         ShowCloseButton="true"
         HorizontalAlignment="HorizontalAlignment.Center"
         VerticalAlignment="VerticalAlignment.Center">

    <BodyContentTemplate>
        <div class="low-credit-warning">
            <i class="bi bi-exclamation-triangle" style="font-size: 3rem; color: #ffc107;"></i>
            <p style="font-size:16px; margin-top: 15px;">
                You have <b>@totalwpcredit</b> WhatsApp credits remaining.<br />
                Please purchase additional credits to continue sending messages.
            </p>
            <p style="margin-top:15px;">
                <i class="bi bi-telephone-fill"></i> Contact us at <b>@SupportNumber</b> to recharge.
            </p>
        </div>
    </BodyContentTemplate>

    <FooterContentTemplate>
        <DxButton Text="Close" RenderStyle="ButtonRenderStyle.Secondary"
                  Click="() => IsVisibleCreditPopup = false" />
    </FooterContentTemplate>
</DxPopup>

@code {
    List<WpMailConfig> Configs = new();

    private bool IsVisibleCreditPopup { get; set; }
    private int RemainingCredits { get; set; }
    private string SupportNumber { get; set; } = "+91-9876543210";
    private string BalnaceToken { get; set; }
    private string totalwpcredit = "Loading...";

    public async Task CheckCreditsAsync()
    {
        try
        {
            Configs = (await WpMailConfigService.GetAllAsync()).ToList();
            var config = (await SendWpMailService.GetByCompanyAsync())?.FirstOrDefault();
            if (config != null)
            {
                UserName = config.SendWpMailUserName;
                BalnaceToken = config.SendWpMailWpBalanceToken;
            }

            if (!string.IsNullOrEmpty(UserName) && !string.IsNullOrEmpty(BalnaceToken))
            {
                var balanceResponse = await ChatwayService.CheckBalanceAsync(UserName, BalnaceToken);

                if (!string.IsNullOrEmpty(balanceResponse))
                {
                    totalwpcredit = balanceResponse;
                }
                else
                {
                    totalwpcredit = "Error";
                }
            }
            else
            {
                totalwpcredit = "No creds";
            }

            if (int.TryParse(totalwpcredit, out var credits) && credits < 100)
            {
                IsVisibleCreditPopup = true;
            }
        }
        catch (Exception ex)
        {
            ToasteService.Warning($"Unable to check WhatsApp credits: {ex.Message}");
        }
    }

    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public string DefaultFileUrl { get; set; }
    [Parameter] public string DefaultFileName { get; set; }
    [Parameter] public string DefaultNumber { get; set; }
    [Parameter] public string DefaultMessage { get; set; }

    private string CountryCode { get; set; } = "91";
    private string PhoneNumbersText { get; set; } = "";
    private string Message { get; set; } = "Here is the document you requested.";
    private string FileUrl { get; set; }
    private string FileName { get; set; }
    private string UserName { get; set; }
    private string Token { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var config = (await SendWpMailService.GetByCompanyAsync())?.FirstOrDefault();
        if (config != null)
        {
            UserName = config.SendWpMailUserName;
            Token = config.SendWpMailWpToken;
        }
    }

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrEmpty(DefaultNumber)) PhoneNumbersText = DefaultNumber;
        if (!string.IsNullOrEmpty(DefaultFileUrl)) FileUrl = DefaultFileUrl;
        if (!string.IsNullOrEmpty(DefaultFileName)) FileName = DefaultFileName;
        if (!string.IsNullOrEmpty(DefaultMessage)) Message = DefaultMessage;
    }

    private List<string> GetPreparedNumbers()
    {
        var numbers = PhoneNumbersText
            .Split(new[] { ',', '\n', ';' }, StringSplitOptions.RemoveEmptyEntries)
            .Select(n => new string(n.Where(char.IsDigit).ToArray()))
            .Where(n => n.Length == 10)
            .Select(n => "91" + n)
            .ToList();

        return numbers;
    }

    private bool IsSendEnabled => GetPreparedNumbers().Count > 0
                                  && !string.IsNullOrEmpty(FileUrl)
                                  && !string.IsNullOrEmpty(FileName);

    private async Task SendFile()
    {
        var numbers = GetPreparedNumbers();

        if (!numbers.Any())
        {
            ToasteService.Warning("Please enter at least one valid 10-digit mobile number.");
            return;
        }

        if (string.IsNullOrEmpty(FileUrl))
        {
            ToasteService.Warning("File URL is required.");
            return;
        }

        if (string.IsNullOrEmpty(FileName))
        {
            ToasteService.Warning("File name is required.");
            return;
        }

        LoadingService.Show();

        try
        {
            var response = await ChatwayService.SendFileAsync(
                username: UserName,
                number: string.Join(",", numbers),
                message: Message,
                token: Token,
                fileUrl: FileUrl,
                fileName: FileName
            );

            if (response.Success)
            {
                ToasteService.Success($"✅ File sent successfully to {numbers.Count} number(s)!");

                // Close popup and reset fields
                IsVisible = false;
                PhoneNumbersText = "";
                Message = "Here is the document you requested.";
                FileUrl = "";
                FileName = "";

                await OnClose.InvokeAsync();
            }
            else
            {
                ToasteService.Error($"❌ Failed to send file: {response.Message ?? "Unknown error"}");
            }
        }
        catch (Exception ex)
        {
            ToasteService.Error($"❌ Error sending file: {ex.Message}");
        }
        finally
        {
            LoadingService.Hide();
        }
    }
}
