    private void UpdateBillBalance(BillSettlement settlement)
    {
        var balance = settlement.DueAmount -
                     settlement.SettledAmount -
                     settlement.DiscountAmount -
                     settlement.TdsAmount -
                     settlement.ShortageAmount;

        settlement.BalanceAmount = Math.Max(balance, 0);


    }

    private void ClampOnAccountAdjustments()
    {
        double maxAllowed = EditModel.JournalAmount;
        double discount = EditModel.JournalTotalDiscount;
        double tds = EditModel.JournalTotalTds;
        double shortage = EditModel.JournalTotalShort;
        double totalAdjustments = discount + tds + shortage;

        if (totalAdjustments > maxAllowed)
        {
            double excess = totalAdjustments - maxAllowed;

            // ✅ Proportional reduction
            if (maxAllowed > 0)
            {
                double factor = maxAllowed / totalAdjustments;
                EditModel.JournalTotalDiscount = (float)(discount * factor);
                EditModel.JournalTotalTds = (float)(tds * factor);
                EditModel.JournalTotalShort = (float)(shortage * factor);
            }
            else
            {
                // ✅ Zero everything if received amount is 0
                EditModel.JournalTotalDiscount = 0;
                EditModel.JournalTotalTds = 0;
                EditModel.JournalTotalShort = 0;
            }

            ToastService.Warning("Adjustments exceeded received amount and were scaled down.");
        }
    }

    private void CalculateTotals()
    {
        if (ShowBillSettlementGrid)
        {
            // ✅ Bill-to-Bill Mode: Grid drives the summary
            var selectedBills = PendingBills.Where(b => b.IsSelected).ToList();

            double totalSettled = selectedBills.Sum(b => b.SettledAmount);
            double totalDiscount = selectedBills.Sum(b => b.DiscountAmount);
            double totalTds = selectedBills.Sum(b => b.TdsAmount);
            double totalShortage = selectedBills.Sum(b => b.ShortageAmount);
          

            EditModel.JournalTotalDiscount = (float)totalDiscount;
            EditModel.JournalTotalTds = (float)totalTds;
            EditModel.JournalTotalShort = (float)totalShortage;

             // EditModel.JournalTotal = (float)(totalSettled);
             // double total = (float)(totalSettled + totalDiscount + totalTds + totalShortage);
            EditModel.JournalTotal = totalSettled + EditModel.JournalTotalDiscount + EditModel.JournalTotalTds + EditModel.JournalTotalShort;
            // EditModel.JournalOnAccount = (float)(EditModel.JournalAmount - total);
            EditModel.JournalOnAccount = (float)(EditModel.JournalAmount -  EditModel.JournalTotal);
        }
        else
        {
            // ✅ On Account Mode: Summary boxes are editable
            ClampOnAccountAdjustments();

            double discount = EditModel.JournalTotalDiscount;
            double tds = EditModel.JournalTotalTds;
            double shortage = EditModel.JournalTotalShort;

            EditModel.JournalTotal = EditModel.JournalAmount;
            EditModel.JournalOnAccount = (float)Math.Max(EditModel.JournalAmount - discount - tds - shortage, 0);
        }
    }

