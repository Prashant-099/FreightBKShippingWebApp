    private async  void OnSettledChanged(double newValue, BillSettlement settlement)
    {
        if (!settlement.IsSelected)
            return;
        var actualBill = PendingBills.FirstOrDefault(b => b.BillId == settlement.BillId);
        if (actualBill == null) return;
        var remaining = GetRemainingAmount(actualBill, b => b.SettledAmount);
        actualBill.SettledAmount = Math.Min(Math.Min(newValue, actualBill.DueAmount), remaining);
        settlement.SettledAmount = actualBill.SettledAmount;
        //AutoSelect(settlement);
        UpdateBillBalance(actualBill);
        CalculateTotals();
        if (ReceiptGrid != null)
        {
            ReceiptGrid.Reload();
        }

        await InvokeAsync(StateHasChanged);
    }

