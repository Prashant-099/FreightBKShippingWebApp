    private async Task HandleValidSubmit()
    {
        try
        {
            LoadingService.Show("Saving receipt...");

            if (EditModel.JournalAmount <= 0)
            {
                ToastService.Warning("Please enter a valid received amount.");
                return;
            }

            if (ShowBillSettlementGrid)
            {
                var selectedBills = PendingBills.Where(b => b.IsSelected).ToList();

                if (!selectedBills.Any())
                {
                    ToastService.Warning("Please select at least one bill for Bill-to-Bill settlement.");
                    return;
                }

                // ✅ Validate each bill
                foreach (var settlement in selectedBills)
                {
                    var totalApplied = settlement.SettledAmount +
                                      settlement.DiscountAmount +
                                      settlement.TdsAmount +
                                      settlement.ShortageAmount;

                    if (totalApplied > settlement.DueAmount)
                    {
                        ToastService.Error($"Bill {settlement.BillNo}: Total applied (₹{totalApplied:N2}) exceeds due amount (₹{settlement.DueAmount:N2})");
                        return;
                    }
                }

                CalculateTotals();

                EditModel.BillRefDetails = new List<BillRefDetail>();

                foreach (var settlement in selectedBills)
                {
                    EditModel.BillRefDetails.Add(new BillRefDetail
                    {
                        BillRefAgainstId = EditModel.JournalId,
                        BillRefVchType = "PAYMENT",
                        BillRefVchNo = settlement.BillNo,
                        BillRefVchId = settlement.BillId,
                        BillRefVchDate = settlement.BillDate,
                        BillRefVchAmount = settlement.SettledAmount,
                        BillRefVchDis = (float)settlement.DiscountAmount,
                        BillRefVchTds = (float)settlement.TdsAmount,
                        BillRefVchShort = (float)settlement.ShortageAmount,
                        BillRefVchBalance = (float)settlement.BalanceAmount,
                        BillRefAccountId = EditModel.JournalAccountId
                    });
                }
            }
            else
            {
                EditModel.BillRefDetails = new List<BillRefDetail>();
            }

            EditModel.JournalYearId = YearStatechangeService.SelectedYearId;
            EditModel.JournalMasterType = "PAYMENT";
             EditModel.JournalRefType = "Dr";
             EditModel.TDSAcccountId = EditModel.JournalTotalTds > 0 ? TdsAccount?.AccountId : 0;
EditModel.DiscountAccountId = EditModel.JournalTotalDiscount > 0 ? DiscountAccount?.AccountId : 0;
EditModel.ShortageAccountId = EditModel.JournalTotalShort > 0 ? ShortageAccount?.AccountId : 0;


            bool result;
            if (EditModel.JournalId == 0)
            {
                result = await JournalService.CreateAsync(EditModel);
               

                if(result==true)
                {
                 ToastService.Success( "Payment Created Successfully!");
                      AuditLogService.NotifyAuditChanged();
                
                }
                else
                {
                 ToastService.Success( JournalService.LastError?? "Failed To Create Payment!");
                return;
                }
            }
            else
            {
                result = await JournalService.UpdateAsync(EditModel);
               if(result==true)
                {
                 ToastService.Success( "Payment Updated Successfully!");
                      AuditLogService.NotifyAuditChanged();
                
                }
                else
                {
                 ToastService.Success( JournalService.LastError?? "Failed To Updated Payment!");
                return;
                }
            }

            if (result)
            {
                Visible = false;
                await OnSaved.InvokeAsync();
            }
        }
        catch (Exception ex)
        {
            ToastService.Error($"Error saving receipt: {ex.Message}");
        }
        finally
        {
            LoadingService.Hide();
        }
    }

