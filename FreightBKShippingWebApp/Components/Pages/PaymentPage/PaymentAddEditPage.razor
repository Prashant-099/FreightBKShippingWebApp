<style>
    .receipt-grid-wrapper {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    .fixed-height-grid {
        height: 300px;
        overflow-y: auto;
    }

    .summary-box {
        background-color: #f8f9fa;
        border-radius: 8px;
       /*  padding: 12px;
        margin-top: 10px */;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 8px;
    }

    .summary-label {
        font-weight: 600;
        color: #495057;
    }

    .summary-value {
        font-size: 1.1rem;
        font-weight: 700;
        color: #212529;
    }

    .total-amount {
        background-color: #e3fcef;
        padding: 8px;
        border-radius: 6px;
        border: 2px solid #28a745;
    }

    @@media (max-width: 768px) {
        .fixed-height-grid {
            height: 220px;
        }
    }
</style>


<DxPopup @bind-Visible="Visible"
         ShowCloseButton="true"
         HeaderText="@Title"
         CloseOnOutsideClick="false"
         MaxWidth="1500"
         Width="70vw"
         MaxHeight="90vh"
         HorizontalAlignment="HorizontalAlignment.Center"
         VerticalAlignment="VerticalAlignment.Center"
         ShowFooter="true"
         Scrollable="true">
    <BodyContentTemplate Context="bdy">
        <EditForm Model="@EditModel" OnValidSubmit="HandleValidSubmit" Context="ctsc" id="recpt">
            <DataAnnotationsValidator />
            <DxFormLayout>
                <!-- Header Section -->
                <DxFormLayoutItem Caption="Voucher" ColSpanMd="5">
                    <DxComboBox TData="Voucher" TValue="int"
                                Data="@VoucherList"
                                TextFieldName="VoucherName"
                                ValueFieldName="VoucherId"
                                AllowUserInput="true"
                                ShowValidationIcon="true"
                                NullText="-- Select Voucher --"
                                Value="@EditModel.JournalVoucherId"
                                ValueChanged="@((int voucherId) => OnVoucherChanged(voucherId))"
                                ValueExpression="@(() => EditModel.JournalVoucherId)"
                                SearchMode="ListSearchMode.AutoSearch"
                                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="Receipt No" ColSpanMd="4">
                    <DxTextBox @bind-Text="EditModel.JournalNoStr" ReadOnly="true" ShowValidationIcon="true" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="Date" ColSpanMd="3">
                    <DxDateEdit @bind-Date="EditModel.JournalDate"
                                ShowValidationIcon="true"
                                Format="dd-MM-yyyy" />
                    <ValidationMessage For="@(() => EditModel.JournalDate)" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="Customer Name" ColSpanMd="5">
                    <div>
                    <DxComboBox TData="Account" TValue="int"
                                Data="@CustomerList"
                                TextFieldName="AccountName"
                                ValueFieldName="AccountId"
                                ShowValidationIcon="true"
                                AllowUserInput="true"
                                NullText="-- Select Customer --"
                                Value="@EditModel.JournalPartyId"
                                ValueChanged="@((int partyId) => OnPartyChanged(partyId))"
                                ValueExpression="@(() => EditModel.JournalPartyId)"
                                SearchMode="ListSearchMode.AutoSearch"
                                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                                <div class="mt-1 text-danger fw-bold">
                Outstanding : @CustomerOutstandingText
            </div>
           </div>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="Cash/Bank" ColSpanMd="4">
                     <div>
                    <DxComboBox TData="Account" TValue="int"
                                Data="@BankAccountList"
                                TextFieldName="AccountName"
                                ShowValidationIcon="true"
                                ValueFieldName="AccountId"
                                AllowUserInput="true"
                                NullText="-- Select Bank/Cash --"
                               Value="@EditModel.JournalAccountId"
                                ValueChanged="@((int accid) => OnCashBankChanged(accid))"
                                ValueExpression="@(() => EditModel.JournalAccountId)"
                                SearchMode="ListSearchMode.AutoSearch"
                                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                                <div class="mt-1 text-primary fw-bold">
            Balance :@CashBankBalanceText
        </div>
    </div>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="Received Amount" ColSpanMd="3">
                    <DxSpinEdit Value="@EditModel.JournalAmount"
                                ValueChanged="@((double val) => OnReceivedAmountChanged(val))"
                                ValueExpression="@(() => EditModel.JournalAmount)"
                                ShowValidationIcon="true"
                                ShowSpinButtons="false"
                                DisplayFormat="N2" />
                </DxFormLayoutItem>
            </DxFormLayout>

            @if (ShowBillSettlementGrid)
            {
                <!-- Bill Settlement Grid -->
                <div class="receipt-grid-wrapper mt-3">
                    <h5 class="mb-2">Settle Against Bills</h5>
                    <DxGrid Data="@PendingBills"
                            TItem="BillSettlement"
                            @ref="ReceiptGrid"
                            KeyFieldName="BillId"
                            EditMode="GridEditMode.EditCell"
                            ShowFilterRow="false"
                            ShowAddNewButton="false"
                            EditModelSaving="OnGridSaving"
                            CustomizeElement="ReceiptGrid_CustomizeElement"
                            Enabled="@(EditModel.JournalAmount > 0 && PendingBills.Any())"
                            AllowSort="false"
                            PageSize="10"
                            CssClass="fixed-height-grid">
                        <Columns>
                            <DxGridCommandColumn Width="60px" CancelButtonVisible="false" FixedPosition="GridColumnFixedPosition.Left"
                                                 SaveButtonVisible="false" NewButtonVisible="false" TextAlignment="GridTextAlignment.Center">
                                <HeaderCaptionTemplate>
                                    <DxButton RenderStyle="ButtonRenderStyle.Link"
                                              IconCssClass="bi bi-three-dots"
                                              SizeMode="SizeMode.Small"
                                              Click="ShowLayoutPopup" />
                                </HeaderCaptionTemplate>
                                <CellDisplayTemplate>
                                    @{
                                        var bill = (BillSettlement)context.DataItem;
                                    }
                                    <DxCheckBox Checked="@bill.IsSelected"
                                                CheckedChanged="@((bool val) => OnBillSelectionChanged(bill, val))"
                                                CheckedExpression="@(() => bill.IsSelected)" />
                                </CellDisplayTemplate>
                                <CellEditTemplate>
                                    @{
                                        var bill = (BillSettlement)context.DataItem;
                                    }
                                    <DxCheckBox Checked="@bill.IsSelected"
                                                CheckedChanged="@((bool val) => OnBillSelectionChanged(bill, val))"
                                                CheckedExpression="@(() => bill.IsSelected)" />
                                </CellEditTemplate>
                            </DxGridCommandColumn>

                            <DxGridDataColumn FieldName="BillNo" Caption="Bill No" ReadOnly="true" 
                                              Width="@(layoutManager?.GetColumnWidth("BillNo") ?? "150px")"
                                              Visible="@(layoutManager?.GetColumnVisibility("BillNo") ?? true)" />
                            <DxGridDataColumn FieldName="BillDate" Caption="Date" ReadOnly="true" DisplayFormat="dd-MM-yyyy" 
                                              Width="@(layoutManager?.GetColumnWidth("BillDate") ?? "120px")"
                                              Visible="@(layoutManager?.GetColumnVisibility("BillDate") ?? true)" />
                            <DxGridDataColumn FieldName="VoucherType" Caption="Type" ReadOnly="true" 
                                              Width="@(layoutManager?.GetColumnWidth("VoucherType") ?? "150px")"
                                              Visible="@(layoutManager?.GetColumnVisibility("VoucherType") ?? true)" />
                            <DxGridDataColumn FieldName="BillTotal" Caption="Bill Total" ReadOnly="true" DisplayFormat="N2" 
                                              Width="@(layoutManager?.GetColumnWidth("BillTotal") ?? "120px")"
                                              Visible="@(layoutManager?.GetColumnVisibility("BillTotal") ?? true)" />
                            <DxGridDataColumn FieldName="DueAmount" Caption="Due Amount" ReadOnly="true" DisplayFormat="N2" 
                                              Width="@(layoutManager?.GetColumnWidth("DueAmount") ?? "120px")"
                                              Visible="@(layoutManager?.GetColumnVisibility("DueAmount") ?? true)" />

                            <DxGridDataColumn FieldName="SettledAmount" Caption="Received" 
                                              Width="@(layoutManager?.GetColumnWidth("SettledAmount") ?? "120px")"
                                              Visible="@(layoutManager?.GetColumnVisibility("SettledAmount") ?? true)">
                                <CellEditTemplate Context="ctx">
                                    @{
                                        var settlement = (BillSettlement)ctx.EditModel;
                                    }
                                    <DxSpinEdit Value="@settlement.SettledAmount"
                                                ValueChanged="@((double newVal) => OnSettledChanged(newVal, settlement))"
                                                ValueExpression="@(() => settlement.SettledAmount)"
                                                ShowSpinButtons="false"
                                                DisplayFormat="N2" />
                                </CellEditTemplate>
                            </DxGridDataColumn>

                            <DxGridDataColumn FieldName="DiscountAmount" Caption="Discount" 
                                              Width="@(layoutManager?.GetColumnWidth("DiscountAmount") ?? "100px")"
                                              Visible="@(layoutManager?.GetColumnVisibility("DiscountAmount") ?? true)">
                                <CellEditTemplate Context="ctx">
                                    @{
                                        var settlement = (BillSettlement)ctx.EditModel;
                                    }
                                    <DxSpinEdit Value="@settlement.DiscountAmount"
                                                ValueChanged="@((double newVal) => OnDiscountChanged(newVal, settlement))"
                                                ValueExpression="@(() => settlement.DiscountAmount)"
                                                ShowSpinButtons="false"
                                                DisplayFormat="N2" />
                                </CellEditTemplate>
                            </DxGridDataColumn>

                            <DxGridDataColumn FieldName="TdsAmount" Caption="TDS" 
                                              Width="@(layoutManager?.GetColumnWidth("TdsAmount") ?? "100px")"
                                              Visible="@(layoutManager?.GetColumnVisibility("TdsAmount") ?? true)">
                                <CellEditTemplate Context="ctx">
                                    @{
                                        var settlement = (BillSettlement)ctx.EditModel;
                                    }
                                    <DxSpinEdit Value="@settlement.TdsAmount"
                                                ValueChanged="@((double newVal) => OnTdsChanged(newVal, settlement))"
                                                ValueExpression="@(() => settlement.TdsAmount)"
                                                ShowSpinButtons="false"
                                                DisplayFormat="N2" />
                                </CellEditTemplate>
                            </DxGridDataColumn>

                            <DxGridDataColumn FieldName="ShortageAmount" Caption="Shortage" 
                                              Width="@(layoutManager?.GetColumnWidth("ShortageAmount") ?? "100px")"
                                              Visible="@(layoutManager?.GetColumnVisibility("ShortageAmount") ?? true)">
                                <CellEditTemplate Context="ctx">
                                    @{
                                        var settlement = (BillSettlement)ctx.EditModel;
                                    }
                                    <DxSpinEdit Value="@settlement.ShortageAmount"
                                                ValueChanged="@((double newVal) => OnShortageChanged(newVal, settlement))"
                                                ValueExpression="@(() => settlement.ShortageAmount)"
                                                ShowSpinButtons="false"
                                                DisplayFormat="N2" />
                                </CellEditTemplate>
                            </DxGridDataColumn>

                            <DxGridDataColumn FieldName="BalanceAmount" Caption="Balance" ReadOnly="true" DisplayFormat="N2" 
                                              Width="@(layoutManager?.GetColumnWidth("BalanceAmount") ?? "120px")"
                                              Visible="@(layoutManager?.GetColumnVisibility("BalanceAmount") ?? true)" />
                        </Columns>

                        <TotalSummary>
                            <DxGridSummaryItem FieldName="BillTotal" SummaryType="GridSummaryItemType.Sum" DisplayText="Total: {0:N2}" />
                            <DxGridSummaryItem FieldName="SettledAmount" SummaryType="GridSummaryItemType.Sum" DisplayText="{0:N2}" />
                             <DxGridSummaryItem FieldName="DiscountAmount" SummaryType="GridSummaryItemType.Sum" DisplayText="{0:N2}" />
                              <DxGridSummaryItem FieldName="TdsAmount" SummaryType="GridSummaryItemType.Sum" DisplayText="{0:N2}" />
                               <DxGridSummaryItem FieldName="ShortageAmount" SummaryType="GridSummaryItemType.Sum" DisplayText="{0:N2}" />
                            <DxGridSummaryItem FieldName="BalanceAmount" SummaryType="GridSummaryItemType.Sum" DisplayText="{0:N2}" />
                        </TotalSummary>
                    </DxGrid>
                </div>
            }

            <div class="row mt-3">
                <!-- Remarks: Left (MD-6) -->
                <div class="col-md-6">
                    <DxFormLayout>
                        <DxFormLayoutItem Caption="Remarks" ColSpanMd="12">
                            <DxMemo @bind-Text="EditModel.JournalRemarks" Rows="3" />
                        </DxFormLayoutItem>
                    </DxFormLayout>
                </div>

                <!-- Summary Box: Right (MD-6) -->
                <div class="col-md-6">
                    <div class="summary-box h-100">
                        @if (ShowBillSettlementGrid)
                        {
                            <div class="summary-row">
                                <span class="summary-label">Settled Amount:</span>
                                <span class="summary-value">₹ @TotalSettled.ToString("N2")</span>
                            </div>
                        }

                        <div class="summary-row">
                            <span class="summary-label">Discount Amount:</span>
                            @if (ShowBillSettlementGrid)
                            {
                                @* Bill-to-Bill: Read-only (calculated from grid) *@
                                <span class="summary-value">₹ @EditModel.JournalTotalDiscount.ToString("N2")</span>
                            }
                            else
                            {
                                @* On Account: Editable *@
                                <DxSpinEdit Value="@EditModel.JournalTotalDiscount"
                                            ValueChanged="@((float v) => {
                                                EditModel.JournalTotalDiscount = v;
                                                OnSummaryAmountChanged();
                                            })"
                                            ValueExpression="@(() => EditModel.JournalTotalDiscount)"
                                            ShowSpinButtons="false"
                                            DisplayFormat="N2" />
                            }
                        </div>

                        <div class="summary-row">
                            <span class="summary-label">Shortage Amount:</span>
                            @if (ShowBillSettlementGrid)
                            {
                                <span class="summary-value">₹ @EditModel.JournalTotalShort.ToString("N2")</span>
                            }
                            else
                            {
                                <DxSpinEdit Value="@EditModel.JournalTotalShort"
                                            ValueChanged="@((float v) => {
                                                EditModel.JournalTotalShort = v;
                                                OnSummaryAmountChanged();
                                            })"
                                            ValueExpression="@(() => EditModel.JournalTotalShort)"
                                            ShowSpinButtons="false"
                                            DisplayFormat="N2" />
                            }
                        </div>

                        <div class="summary-row">
                            <span class="summary-label">TDS Amount:</span>
                            @if (ShowBillSettlementGrid)
                            {
                                <span class="summary-value">₹ @EditModel.JournalTotalTds.ToString("N2")</span>
                            }
                            else
                            {
                                <DxSpinEdit Value="@EditModel.JournalTotalTds"
                                            ValueChanged="@((float v) => {
                                                EditModel.JournalTotalTds = v;
                                                OnSummaryAmountChanged();
                                            })"
                                            ValueExpression="@(() => EditModel.JournalTotalTds)"
                                            ShowSpinButtons="false"
                                            DisplayFormat="N2" />
                            }
                        </div>

                        <div class="summary-row">
                            <span class="summary-label">On Account:</span>
                            <span class="summary-value">₹ @EditModel.JournalOnAccount.ToString("N2")</span>
                        </div>

                        <div class="summary-row total-amount mt-2">
                            <span class="summary-label">Total Amount:</span>
                            <span class="summary-value">₹ @EditModel.JournalTotal.ToString("N2")</span>
                        </div>
                    </div>
                </div>
            </div>
        </EditForm>
    </BodyContentTemplate>

    <FooterContentTemplate>
        <div class="d-flex justify-content-end gap-2">
            <DxButton Text="Save"
                      RenderStyle="ButtonRenderStyle.Primary"
                      SubmitFormOnClick="true"
                      Form="recpt"
                      Enabled="@(!ShowBillSettlementGrid || PendingBills.Any(b => b.IsSelected))"
                      IconCssClass="bi bi-save" />
            <DxButton Text="Cancel"
                      RenderStyle="ButtonRenderStyle.Danger"
                      Click="Hide"
                      IconCssClass="bi bi-x-circle" />
        </div>
    </FooterContentTemplate>
