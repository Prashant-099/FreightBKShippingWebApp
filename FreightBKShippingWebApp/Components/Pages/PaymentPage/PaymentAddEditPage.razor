}
    private string Title { get; set; } = "Payment Entry";
    private Journal EditModel { get; set; } = new();
    private IGrid ReceiptGrid { get; set; }

    private List<Voucher> VoucherList = new();
    private List<Account> AccountList = new();
     private Account? TdsAccount;
private Account? DiscountAccount;
private Account? ShortageAccount;
    private List<Account> CustomerList = new();
    private List<Account> BankAccountList = new();
    private List<BillSettlement> PendingBills = new();

    private double TotalSettled => PendingBills.Where(b => b.IsSelected).Sum(b => b.SettledAmount);
    // private double TotalDiscount => PendingBills.Where(b => b.IsSelected).Sum(b => b.DiscountAmount);
    // private double TotalShortage => PendingBills.Where(b => b.IsSelected).Sum(b => b.ShortageAmount);
    // private double TotalTds => PendingBills.Where(b => b.IsSelected).Sum(b => b.TdsAmount);

    private bool ShowBillSettlementGrid = false;
    private Account? SelectedCustomer = null;

    // Grid Layout Manager Reference
    private GridLayoutpPopup? layoutManager;
    private List<GridColumnLayout> allColumns = [];

    private async void ShowLayoutPopup()
    {
        await InvokeAsync(() =>
        {
            layoutManager?.ShowPopup();
        });
    }

    private async Task HandleLayoutChanged(List<GridColumnLayout> updatedLayout)
    {
        allColumns = updatedLayout;
        await InvokeAsync(StateHasChanged);
    }

    private void InitializeColumns()
    {
        allColumns = new List<GridColumnLayout>
        {
            new() { FieldName = "BillNo", Caption = "Bill No", Visible = true, Width = 150, DisplayIndex = 0 },
            new() { FieldName = "BillDate", Caption = "Date", Visible = true, Width = 120, DisplayIndex = 1 },
            new() { FieldName = "VoucherType", Caption = "Type", Visible = true, Width = 150, DisplayIndex = 2 },
            new() { FieldName = "BillTotal", Caption = "Bill Total", Visible = true, Width = 120, DisplayIndex = 3 },
            new() { FieldName = "DueAmount", Caption = "Due Amount", Visible = true, Width = 120, DisplayIndex = 4 },
            new() { FieldName = "SettledAmount", Caption = "Received", Visible = true, Width = 120, DisplayIndex = 5 },
            new() { FieldName = "DiscountAmount", Caption = "Discount", Visible = true, Width = 100, DisplayIndex = 6 },
            new() { FieldName = "TdsAmount", Caption = "TDS", Visible = true, Width = 100, DisplayIndex = 7 },
            new() { FieldName = "ShortageAmount", Caption = "Shortage", Visible = true, Width = 100, DisplayIndex = 8 },
            new() { FieldName = "BalanceAmount", Caption = "Balance", Visible = true, Width = 120, DisplayIndex = 9 }
        };
    }

    private List<Journal> _allReceiptsCache;

    private async Task<double> GetAlreadySettledAmount(int billId)
    {
        _allReceiptsCache ??= await JournalService.GetAllAsync();

        return _allReceiptsCache
            .Where(j => j.BillRefDetails != null && j.JournalId != EditModel.JournalId)
            .SelectMany(j => j.BillRefDetails)
            .Where(d => d.BillRefVchId == billId)
            .Sum(d => d.BillRefVchAmount + d.BillRefVchDis + d.BillRefVchTds + d.BillRefVchShort);
    }

    private void OnSummaryAmountChanged()
    {
        CalculateTotals();
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadDropdownsAsync();
        InitializeColumns();
    }

    enum DataChangeType
    {
        Addition,
        Modification,
        Delete
    }

    class GridChangeInfo
    {
        public DataChangeType Type { get; set; }
        public HashSet<string> ChangedFields { get; set; }

        public GridChangeInfo(DataChangeType type, HashSet<string> fields)
        {
            Type = type;
            ChangedFields = fields;
        }
    }

    private Dictionary<BillSettlement, GridChangeInfo> ReceiptUnsavedChanges = new();

    void ReceiptGrid_CustomizeElement(GridCustomizeElementEventArgs ea)
    {
        if (ea.ElementType != GridElementType.DataCell)
            return;

        var settlement = (BillSettlement)ReceiptGrid.GetDataItem(ea.VisibleIndex);
        if (settlement == null) return;

        var column = (IGridDataColumn)ea.Column;

        if (ReceiptUnsavedChanges.TryGetValue(settlement, out var changes))
        {
            if (changes.Type == DataChangeType.Addition)
                ea.CssClass = "grid-new-row";
            else if (changes.Type == DataChangeType.Delete)
                ea.CssClass = "grid-deleted-row";
            else if (changes.ChangedFields.Contains(column.FieldName))
                ea.CssClass = "grid-modified-cell";
        }
    }

    void OnGridSaving(GridEditModelSavingEventArgs e)
    {
        var edited = (BillSettlement)e.EditModel;
        var original = (BillSettlement)e.DataItem;

        var changedFields = ApplyReceiptModifiedFields(edited, original);

        if (changedFields.Count > 0)
        {
            if (ReceiptUnsavedChanges.TryGetValue(original, out var info))
                info.ChangedFields.UnionWith(changedFields);
            else
                ReceiptUnsavedChanges.Add(original, new GridChangeInfo(DataChangeType.Modification, changedFields));
        }
    }

    private HashSet<string> ApplyReceiptModifiedFields(BillSettlement source, BillSettlement target)
    {
        var changed = new HashSet<string>();
        var props = typeof(BillSettlement).GetProperties();

        foreach (var prop in props)
        {
            if (prop.Name == nameof(BillSettlement.BillId)) continue;

            var src = prop.GetValue(source);
            var trg = prop.GetValue(target);

            if (!Equals(src, trg))
            {
                prop.SetValue(target, src);
                changed.Add(prop.Name);
            }
        }

        return changed;
    }

    private async Task LoadDropdownsAsync()
    {
        try
        {
            var voucherTask = VoucherService.GetAllAsync();
            var accountTask = AccountService.GetAllAsync();

            await Task.WhenAll(voucherTask, accountTask);

            VoucherList = voucherTask.Result
                .Where(v => v.VoucherGroup?.Equals("PAYMENT", StringComparison.OrdinalIgnoreCase) == true)
                .ToList();

           AccountList = accountTask.Result;

            CustomerList = AccountList.Where(a => a.AccountTypeId == 18).ToList();
            BankAccountList = AccountList.Where(a => a.AccountTypeId == 10 || a.AccountTypeId == 11).ToList();

             TdsAccount = AccountList
    .Where(a => a.AccountGroupId == 3)
    .FirstOrDefault();

DiscountAccount = AccountList
    .Where(a => a.AccountGroupId == 26 && a.AccountName.ToLower().Contains("discount"))
    .FirstOrDefault();

ShortageAccount = AccountList
    .Where(a => a.AccountGroupId == 26 && a.AccountName.ToLower().Contains("shortage"))
    .FirstOrDefault();

        }
        catch (Exception ex)
        {
            ToastService.Error($"Error loading data: {ex.Message}");
        }
    }

    public async Task Show(Journal journal = null, int? specificBillId = null)
    {
        PendingBills.Clear();
        _allReceiptsCache = null;

        EditModel = journal ?? new Journal
            {
                JournalDate = DateTime.Now,
                JournalYearId = YearStatechangeService.SelectedYearId,
                JournalStatus = true,
                JournalMasterType = "PAYMENT"
            };

        if (EditModel.JournalId > 0)
        {
            SelectedCustomer = CustomerList.FirstOrDefault(a => a.AccountId == EditModel.JournalPartyId);
            ShowBillSettlementGrid = SelectedCustomer?.AccountMethod?.Equals("BILL TO BILL", StringComparison.OrdinalIgnoreCase) == true;

            var json = JsonSerializer.Serialize(journal);
            EditModel = JsonSerializer.Deserialize<Journal>(json) ?? new Journal();
            Title = "Edit Payment";
            await LoadJournalDetails();
            if (EditModel.JournalPartyId > 0)
    {
        await LoadCustomerOutstanding(
            EditModel.JournalPartyId);

    }
    if (EditModel.JournalAccountId > 0)
    {
        await LoadCashBankBalance(
            EditModel.JournalAccountId);
    }

        }
        else
        {
            var voucher = VoucherList.FirstOrDefault();
            if (voucher != null)
            {
                await OnVoucherChanged(voucher.VoucherId);
            }
            if (journal.JournalPartyId > 0)
            {
                await OnPartyChanged(journal?.JournalPartyId ?? 0, specificBillId);
            }
            else{ShowBillSettlementGrid = false;}
            Title = "Add Payment";
           

        }

        //ShowBillSettlementGrid = false;
        Visible = true;
        StateHasChanged();
    }

    private async Task OnVoucherChanged(int voucherId)
    {
        EditModel.JournalVoucherId = voucherId;

        if (EditModel.JournalId == 0)
        {
            try
            {
                var result = await YearStatechangeService.GeneratebillNoAsync(
                    voucherId,
                    YearStatechangeService.SelectedYearId,
                    BranchContext.BranchId
                );

                EditModel.JournalNoStr = result.prefix + result.number + result.suffix;
                EditModel.JournalPrefix = result.prefix;
                EditModel.JournalPostfix = result.suffix;
                EditModel.JournalNo = int.Parse(result.number);

                StateHasChanged();
            }
            catch (Exception ex)
            {
                ToastService.Error($"Error generating receipt number: {ex.Message}");
            }
        }
    }

    private async Task OnPartyChanged(int partyId, int? specificBillId = null)
    {
        EditModel.JournalPartyId = partyId;
         await LoadCustomerOutstanding(partyId);

