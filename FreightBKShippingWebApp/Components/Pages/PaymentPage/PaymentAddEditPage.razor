   private double GetRemainingAmount(
    BillSettlement currentBill,
    Func<BillSettlement, double> excludeCurrentValue)
{
    var usedAmount = PendingBills
        .Where(b => b.IsSelected)
        .Sum(b =>
        {
            if (b == currentBill)
            {
                return
                    b.SettledAmount +
                    b.DiscountAmount +
                    b.TdsAmount +
                    b.ShortageAmount
                    - excludeCurrentValue(b); // 👈 subtract current field
            }

            return b.SettledAmount +
                   b.DiscountAmount +
                   b.TdsAmount +
                   b.ShortageAmount;
        });

    return Math.Max(EditModel.JournalAmount - usedAmount, 0);
}


