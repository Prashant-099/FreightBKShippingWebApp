   private async Task LoadCustomerOutstanding(int partyId)
{
    try
    {
        var allBills = await BillService.GetAllAsync();
        var allJournals = await JournalService.GetAllAsync();
       

        var account = AccountList
            .FirstOrDefault(a => a.AccountId == partyId);

        // Opening Balance
        double opening = 0;

        if (account != null)
        {
             float openingFloat = account.AccountOpening ?? 0f;
            opening = account.AccountBalanceType == "Dr"
                ? openingFloat
                : -openingFloat;
        }

        // 1. Total Bill Due
        // double totalBillDue = allBills
        //     .Where(b =>
        //         b.BillPartyId == partyId &&
        //         b.BillStatus)
        //     .Sum(b => b.Bill_due_amt);

        double salesDue = allBills
    .Where(b =>
        b.BillPartyId == partyId &&
        b.BillStatus &&
        b.BillType == "Sales")
    .Sum(b => b.Bill_due_amt);

double purchaseDue = allBills
    .Where(b =>
        b.BillPartyId == partyId &&
        b.BillStatus &&
        b.BillType == "Purchase")
    .Sum(b => b.Bill_due_amt);

        // 2. On Account Receipt
        double onAccountReceipt = allJournals
            .Where(j =>
                j.JournalPartyId == partyId &&
               j.JournalMasterType.Equals("RECEIPT",
    StringComparison.OrdinalIgnoreCase)&&
                j.JournalOnAccount > 0)
            .Sum(j => j.JournalTotal);

        // 3. On Account Payment
        double onAccountPayment = allJournals
            .Where(j =>
                j.JournalPartyId == partyId &&
                j.JournalMasterType.Equals("PAYMENT",
    StringComparison.OrdinalIgnoreCase)&&
                j.JournalOnAccount > 0)
            .Sum(j => j.JournalTotal);

//  journal entry
          var allBillRefs = allJournals
    .Where(j => j.BillRefDetails != null)
    .SelectMany(j => j.BillRefDetails)
    .ToList();

double journalDebit = allBillRefs
    .Where(x =>
        x.BillRefAccountId == partyId &&
        x.BillRefVchType == "DR")
    .Sum(x => x.BillRefVchAmount);

double journalCredit = allBillRefs
    .Where(x =>
        x.BillRefAccountId == partyId &&
        x.BillRefVchType == "CR")
    .Sum(x => x.BillRefVchAmount);

        CustomerOutstanding = opening
    + salesDue
    - purchaseDue
    - onAccountReceipt
    + onAccountPayment + journalDebit
    - journalCredit;

        

        StateHasChanged();
    }
    catch
    {
        CustomerOutstanding = 0;
    }
}
