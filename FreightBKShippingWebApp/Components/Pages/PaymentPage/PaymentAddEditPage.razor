<GridLayoutpPopup @ref="layoutManager"
                  VoucherType="ReceiptDetails"
                  Columns="@allColumns"
                  OnLayoutChanged="HandleLayoutChanged" />

@code {
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public int specificBillId  { get; set; }

   private bool _visible;
private bool Visible
{
    get => _visible;
    set
    {
        if (_visible == value) return;
        
        _visible = value;
        
        // Popup Closed
        if (!value)
        {
            ResetPopupData();
        }
        
        StateHasChanged();
