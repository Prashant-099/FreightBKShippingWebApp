private async Task LoadCashBankBalance(int accountId)
{
    try
    {
        var journals = await JournalService.GetAllAsync();

         var account = AccountList
            .FirstOrDefault(a => a.AccountId == accountId);

        // Opening Balance
        double opening = 0;

        if (account != null)
        {
           // AccountOpening is float? — handle null and convert safely
            float openingFloat = account.AccountOpening ?? 0f;
            opening = account.AccountBalanceType == "Dr"
                ? openingFloat
                : -openingFloat;
        }

        double receiptAmount = journals
            .Where(x =>
                x.JournalAccountId == accountId &&
                x.JournalMasterType.Equals("RECEIPT",
    StringComparison.OrdinalIgnoreCase))
            .Sum(x => x.JournalTotal);

        double paymentAmount = journals
            .Where(x =>
                x.JournalAccountId == accountId &&
                x.JournalMasterType.Equals("PAYMENT",
    StringComparison.OrdinalIgnoreCase))
            .Sum(x => x.JournalTotal);



            // CONTRA IN (+)
        double contraIn = journals
            .Where(x =>
                x.JournalPartyId == accountId &&
                x.JournalMasterType.Equals(
                    "CONTRA",
                    StringComparison.OrdinalIgnoreCase))
            .Sum(x => x.JournalTotal);

        // CONTRA OUT (-)
        double contraOut = journals
            .Where(x =>
                x.JournalAccountId == accountId &&
                x.JournalMasterType.Equals(
                    "CONTRA",
                    StringComparison.OrdinalIgnoreCase))
            .Sum(x => x.JournalTotal);
            var allBillRefs = journals
    .Where(j => j.BillRefDetails != null)
    .SelectMany(j => j.BillRefDetails)
    .ToList();

double journalDebit = allBillRefs
    .Where(x =>
        x.BillRefAccountId == accountId &&
        x.BillRefVchType == "DR")
    .Sum(x => x.BillRefVchAmount);

double journalCredit = allBillRefs
    .Where(x =>
        x.BillRefAccountId == accountId &&
        x.BillRefVchType == "CR")
    .Sum(x => x.BillRefVchAmount);

        CashBankBalance = opening -receiptAmount +paymentAmount+contraIn -contraOut+ journalDebit
    - journalCredit;


        StateHasChanged();
    }
    catch
    {
        CashBankBalance = 0;
    }
}
