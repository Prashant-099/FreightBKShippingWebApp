    // ── Export / Print ──────────────────────────────────────────────────────

    private async Task ExportXlsx()
    {
        if (ledgerEntries == null || !ledgerEntries.Any())
        {
            ToastService.Warning("No data to export.");
            return;
        }
        await MyGrid.ExportToXlsxAsync("AccountLedger.xlsx");
    }

    private async Task PrintLedger()
    {
        if (ledgerEntries == null || !ledgerEntries.Any())
        {
            ToastService.Warning("No data to print.");
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("printElement", "printLedgerSection");
        }
        catch (Exception ex)
        {
            ToastService.Error($"Print error: {ex.Message}");
        }
    }

    // ── Row Double-Click (Voucher Detail) ────────────────────────────────────

    private void OnRowDoubleClick(GridRowClickEventArgs e)
    {
        if (e.VisibleIndex < 0) return;

        var entry = (AccountLedgerEntry)e.Grid.GetDataItem(e.VisibleIndex);
        if (entry == null) return;

        selectedEntry    = entry;
        showVoucherPopup = true;
    }

    private void CloseVoucherPopup()
    {
        showVoucherPopup = false;
        selectedEntry    = null;
    }
    

}
