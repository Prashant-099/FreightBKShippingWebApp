    private async Task LoadAllBills()
    {
        try
        {
            LoadingService.Show("Loading invoices...");
            allBills = (await BillService.GetAllAsync())
                .Where(b => b.BillYearId == YearStatechangeService.SelectedYearId)
                .ToList();
            billList = allBills;

            ServiceList = await ServiceService.GetAllAsync();

        }
        catch (Exception ex)
        {
            ToastService.Error($"Failed to load bills: {ex.Message}");
        }
        finally
        {
            LoadingService.Hide();
        }
    }

    private async Task OnSearch()
    {
        billList = allBills;

        // Apply date filter
        if (FromDate.HasValue)
        {
            billList = billList.Where(b => b.BillDate.Date >= FromDate.Value.Date).ToList();
        }

        if (ToDate.HasValue)
        {
            billList = billList.Where(b => b.BillDate.Date <= ToDate.Value.Date).ToList();
        }

        // Apply voucher type filter
        if (SelectedVoucherType.HasValue)
        {
            billList = billList.Where(b => b.BillVoucherId == SelectedVoucherType.Value).ToList();
        }

        if (billList.Count == 0)
        {
            ToastService.Warning("No invoices found matching the criteria.");
        }
        else
        {
            ToastService.Success($"Found {billList.Count} invoice(s).");
        }
        BuildTallyRows();
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnReset()
    {
        FromDate = null;
        ToDate = null;
        SelectedVoucherType = null;
        billList = allBills;
        ToastService.Info("Filters reset.");
        await InvokeAsync(StateHasChanged);
    }

   
