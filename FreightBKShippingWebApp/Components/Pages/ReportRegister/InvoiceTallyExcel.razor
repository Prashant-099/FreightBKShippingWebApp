<!-- PRINT ONLY SECTION -->
<div class="print-only-section" id="printInvoiceSection">
    <div class="print-header">
        <h2>Invoice Register</h2>
        <div class="print-info">
            <strong>From:</strong> @FromDate?.ToString("dd/MM/yyyy") &nbsp;&nbsp;
            <strong>To:</strong> @ToDate?.ToString("dd/MM/yyyy") &nbsp;&nbsp;
            <strong>Print Date:</strong> @DateTime.Now.ToString("dd/MM/yyyy hh:mm tt")
        </div>
    </div>

    <table class="print-table">
        <thead>
            <tr>
            
                <th>Branch</th>
                <th>Invoice No</th>
                <th>Invoice Date</th>
                <th>Voucher Type</th>
                <th>Customer</th>
                <th>Job No</th>
                <th>Job Type</th>
                <th>Basic Amount</th>
                <th>Total Amount</th>
                <th>GST No</th>
                <th>Place of Supply</th>
              
            </tr>
        </thead>

        <tbody>
            @if (billList != null && billList.Any())
            {
                @foreach (var bill in billList)
                {
                    

                    <tr>
                       
                        <td>@bill.branchname</td>
                        <td>@bill.BillNo</td>
                        <td>@bill.BillDate.ToString("dd/MM/yyyy")</td>
                        <td>@bill.Vouchname</td>
                        <td>@bill.partyname</td>
                        <td>@bill.BillJobNo</td>
                        <td>@bill.BillJobType</td>
                        <td>@bill.BillTotal.ToString("N2")</td>
                        <td>@bill.BillNetAmount.ToString("N2")</td>
                        <td>@bill.BillGstNo</td>
                        <td>@bill.posname</td>
                        
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="13" style="text-align:center">No records available</td>
                </tr>
            }
        </tbody>

        <tfoot>
            <tr>
                <td colspan="7"><strong>Total Invoices:</strong></td>
                <td><strong>@billList?.Sum(b => b.BillTotal).ToString("N2")</strong></td>
                <td><strong>@billList?.Sum(b => b.BillNetAmount).ToString("N2")</strong></td>
                <td colspan="3"></td>
            </tr>
        </tfoot>
    </table>
</div>


<!-- Layout Dialog -->
@if (showLayoutDialog)
{
    <div class="modal fade show d-block"
         style="background-color: rgba(0,0,0,0.5); z-index:1050;">

        <div class="modal-dialog modal-md"
             @onclick:stopPropagation="true">

            <div class="modal-content">

                <!-- Header -->
                <div class="modal-header">
                    <h5 class="modal-title">@dialogTitle</h5>
                    <button type="button"
                            class="btn-close"
                            @onclick="CloseLayoutDialog">
                    </button>
                </div>

                <!-- Body -->
                <div class="modal-body">

                    <!-- Layout Name -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">
                            Layout Name:
                        </label>

                        <input type="text"
                               class="form-control"
                               @bind="newLayoutName"
                               @bind:event="oninput"
                               placeholder="Enter layout name..."
                               maxlength="100" />
                    </div>

                    <!-- Default Layout -->
                    <div class="mb-3">
                        <div class="form-check">
                            <input class="form-check-input"
                                   type="checkbox"
                                   @bind="isDefaultLayout"
                                   id="defaultLayoutCheck" />

                            <label class="form-check-label"
                                   for="defaultLayoutCheck">
                                Set as Default Layout
                            </label>
                        </div>
                    </div>

                    <!-- Column Configuration -->
                    <div class="mt-3">
                        <label class="form-label fw-bold mb-2">
                            Column Configuration:
                        </label>

                        <div class="table-responsive"
                             style="max-height:400px; overflow-y:auto;">

                            <table class="table table-sm table-bordered">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th style="width:50px;">Visible</th>
                                        <th style="width:200px;">Column Name</th>
                                        <th style="width:150px;">Width (px)</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var col in allColumns)
                                    {
                                        <tr>
                                            <td class="text-center">
                                                <input class="form-check-input"
                                                       type="checkbox"
                                                       @bind="col.Visible"
                                                       id="col_@col.FieldName" />
                                            </td>

                                            <td>
                                                <label class="mb-0"
                                                       for="col_@col.FieldName">
                                                    @col.Caption
                                                </label>
                                            </td>

                                            <td>
                                                <input type="number"
                                                       class="form-control form-control-sm"
                                                       @bind="col.Width"
                                                       @bind:event="oninput"
                                                       min="50"
                                                       max="500"
                                                       step="10" />
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>

                        </div>
                    </div>

                </div>

                <!-- Footer -->
                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            @onclick="CloseLayoutDialog">
                        Cancel
                    </button>

                    <button type="button"
                            class="btn btn-primary"
                            @onclick="SaveCurrentLayout">
                        <i class="bi bi-floppy me-1"></i>
                        @(isEditMode ? "Update" : "Create") Layout
                    </button>
                </div>

            </div>
        </div>
    </div>
}
