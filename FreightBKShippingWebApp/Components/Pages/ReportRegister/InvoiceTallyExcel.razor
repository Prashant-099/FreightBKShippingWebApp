    public double CGST_Amt { get; set; }
    public double IGST_Amt { get; set; }
    public float TDS_perc { get; set; }
        public float TDS_Amt { get; set; }
        public double TotalAmount { get; set; }

    public string PlaceOfSupply { get; set; }
    public string PartyGSTIN { get; set; }
    public string PartyAddress { get; set; }

    public string PartyState { get; set; }
    public string Country { get; set; }
    public string RegisterType { get; set; }

        public string ItemName { get; set; }
    public string HSN { get; set; }
    public string Unit { get; set; }
        public double Qty { get; set; }
        public double Rate { get; set; }
        public double Amount { get; set; }

        public double SGST { get; set; }
        public double CGST { get; set; }
        public double IGST { get; set; }

        public int SGST_Ac { get; set; }
        public int CGST_Ac { get; set; }
        public int IGST_Ac { get; set; }

    public string TaxabilityType { get; set; }
        public double Roundoff { get; set; }
    public string Remarks { get; set; }
    }
    private List<TallyExcelRowDto> tallyRows = new();

    private void BuildTallyRows()
    {
        

        tallyRows = billList
            .Where(b => b.BillDetails != null && b.BillDetails.Any())
            .SelectMany(bill =>
            {
                // var basicTotal = bill.BillDetails.Sum(x => (decimal)x.BillDetailAmount);
                // var igstTotal = bill.BillDetails.Sum(x => (decimal)x.BillDetailAmount * gstRate);

                return bill.BillDetails.Select(d => new TallyExcelRowDto
                {
                    BillId = bill.BillId,


                    VoucherDate = bill.BillDate,
                    VoucherNo = bill.BillNo,
                    VoucherType = bill.Vouchname,
                    BuyerSupplier = bill.partyname,

                    BasicAmount = bill.BillTaxableAmt,
                    CGST_Amt = d.BillDetailCgst,
                    SGST_Amt = d.BillDetailSgst,
                    IGST_Amt =d.BillDetailIgst,
                    TDS_perc = bill.BillTdsPer,
                    TDS_Amt = bill.BillTdsAmt,
                    TotalAmount = bill.BillNetAmount,

                    PlaceOfSupply = bill.posname,
                    PartyGSTIN = bill.BillGstNo,
                    PartyAddress = bill.BillAddress1,

                    PartyState = bill.posname,
                    Country = "India",
                    RegisterType = "REGULAR",

                    ItemName = ServiceList.FirstOrDefault(s => s.ServiceId == d.BillDetailProductId)?.ServiceName ?? "",
                    HSN = d.BillDetailHsnCode,
                    Unit = d.BillDetailUnit,
                    Qty = d.BillDetailQty,
                    Rate = d.BillDetailRate??0,
                    Amount = d.BillDetailAmount,

                    SGST = d.BillDetailSgstPer,
                    CGST = d.BillDetailCgstPer,
                    IGST = d.BillDetailIgstPer,

                    SGST_Ac = d.BillDetailSgstAcId ?? 0,
                    CGST_Ac = d.BillDetailCgstAcId ?? 0,
                    IGST_Ac = d.BillDetailIgstAcId ?? 0,

                    TaxabilityType = "Taxable",
                    Roundoff = bill.BillRoundAmt,
                    Remarks =bill.BillRemarks

                  
                   

                  
                });
            })
            .ToList();
    }



    private async Task ExportXlsx()
    {

        if (billList == null || !billList.Any())
        {
            ToastService.Warning("No data to print.");
            return;
        }
        await MyGrid.ExportToXlsxAsync("JobRegister.xlsx");
    }
    // ✅ PRINT - Using JavaScript to print specific section
    private async Task PrintGridPage()
    {
        if (billList == null || !billList.Any())
        {
            ToastService.Warning("No data to print.");
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("window.print");
        }
        catch (Exception ex)
        {
            ToastService.Error($"Print error: {ex.Message}");
        }
    }

