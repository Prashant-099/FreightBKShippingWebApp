@page "/outstandingregister"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using FreightBKShippingWebApp.Model
@using FreightBKShippingWebApp.Services
@using System.Text.Json
@inject BillService BillService
@inject ToasteService ToastService
@inject LoadingService LoadingService
@inject YearStatechangeService YearStatechangeService
@inject GridLayoutService GridLayoutService
@inject VoucherService VoucherService
@inject IJSRuntime JS

<style>
    .grid-size {
        max-height: 570px;
    }

    .layout-combobox {
        border-radius: 6px;
        width: 185px;
    }

    .toolbar-title {
        display: flex;
        align-items: center;
    }
    /* Print section ko hide rakho normally */
    .print-only-section {
        display: none;
    }

    /* Print time pe sirf print section dikhao */
    @@media print {
        body * {
            visibility: hidden;
        }

        .print-only-section,
        .print-only-section * {
            visibility: visible;
        }

        .print-only-section {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            display: block !important;
        }

        @@page {
            size: A4 landscape;
            margin: 1cm;
        }
    }

    /* Print table styling */
    .print-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
        font-size: 12px;
    }

        .print-table th,
        .print-table td {
            border: 1px solid #000;
            padding: 8px;
            text-align: left;
        }

        .print-table th {
            background-color: #f0f0f0;
            font-weight: bold;
        }

        .print-table tfoot td {
            font-weight: bold;
            background-color: #e8e8e8;
        }

    .print-header {
        text-align: center;
        margin-bottom: 20px;
    }

        .print-header h2 {
            margin: 5px 0;
        }

    .print-info {
        margin-bottom: 15px;
        font-size: 14px;
    }
</style>

<div class="px-3 py-3">
    <DxGrid TItem="Bill"
            Data="@billList"
            @ref="MyGrid"
            KeyFieldName="BillId"
            ShowSearchBox="true"
            PageSize="100"
            PageSizeSelectorVisible="false"
            ShowGroupPanel="true"
            FilterMenuButtonDisplayMode="GridFilterMenuButtonDisplayMode.Always"
            FocusedRowEnabled="true"
            ColumnResizeMode="GridColumnResizeMode.NextColumn"
            CssClass="grid-size"
            AllowColumnReorder="true">

        <ToolbarTemplate Context="gridContext">
            <DxToolbar>
                <!-- Title -->
                <DxToolbarItem Alignment="ToolbarItemAlignment.Left">
                    <Template Context="t">
                        <div class="toolbar-title">
                            <i class="bi bi-hourglass-split me-2"></i>
                            <span class="fs-5">Outstanding Report</span>
                        </div>
                    </Template>
                </DxToolbarItem>

                <DxToolbarItem Text="Filter"
                               IconCssClass="bi bi-funnel-fill"
                               Click="OpenDateFilter"
                               RenderStyle="ButtonRenderStyle.None"
                               AdaptivePriority="2" />

                <DxToolbarItem Text="Export"
                               RenderStyle="ButtonRenderStyle.None"
                               AdaptivePriority="2">
                    <Items>
                        <DxToolbarItem Text="Excel"
                                       RenderStyle="ButtonRenderStyle.None"
                                       IconCssClass="bi bi-file-earmark-spreadsheet"
                                       Click="ExportXlsx" />
                        <DxToolbarItem Text="PDF"
                                       RenderStyle="ButtonRenderStyle.None"
                                       IconCssClass="bi bi-printer"
                                       Click="PrintGridPage" />
                    </Items>
                </DxToolbarItem>

                <DxToolbarItem Alignment="ToolbarItemAlignment.Right"
                               RenderStyle="ButtonRenderStyle.Secondary"
                               IconCssClass="bi bi-gear-wide-connected"
                               Click="ShowLayoutPopup" />

            </DxToolbar>
        </ToolbarTemplate>

        <Columns>

            <DxGridDataColumn FieldName="BillId"
                              Caption="ID"
                              SortIndex="0"
                              SortOrder="GridColumnSortOrder.Descending"
                              Width="@(layoutManager?.GetColumnWidth("BillId") ?? "80px")"
                              Visible="@(layoutManager?.GetColumnVisibility("BillId") ?? false)" />

            <DxGridDataColumn FieldName="branchname"
                              Caption="Branch"
                              Width="@(layoutManager?.GetColumnWidth("branchname") ?? "120px")"
                              Visible="@(layoutManager?.GetColumnVisibility("branchname") ?? true)" />

            <DxGridDataColumn FieldName="BillNo"
                              Caption="Invoice No"
                              Width="@(layoutManager?.GetColumnWidth("BillNo") ?? "150px")"
                              Visible="@(layoutManager?.GetColumnVisibility("BillNo") ?? true)" />

            <DxGridDataColumn FieldName="BillDate"
                              Caption="Invoice Date"
                              DisplayFormat="dd/MM/yyyy"
                              Width="@(layoutManager?.GetColumnWidth("BillDate") ?? "130px")"
                              Visible="@(layoutManager?.GetColumnVisibility("BillDate") ?? true)" />

            <DxGridDataColumn FieldName="BillDueDate"
                              Caption="Due Date"
                              DisplayFormat="dd/MM/yyyy"
                              Width="@(layoutManager?.GetColumnWidth("BillDueDate") ?? "130px")"
                              Visible="@(layoutManager?.GetColumnVisibility("BillDueDate") ?? true)" />

            <DxGridDataColumn FieldName="Vouchname"
                              Caption="Voucher Type"
                              Width="@(layoutManager?.GetColumnWidth("Vouchname") ?? "200px")"
                              Visible="@(layoutManager?.GetColumnVisibility("Vouchname") ?? true)" />

            <DxGridDataColumn FieldName="partyname"
                              Caption="Customer"
                              Width="@(layoutManager?.GetColumnWidth("partyname") ?? "300px")"
                              Visible="@(layoutManager?.GetColumnVisibility("partyname") ?? true)" />

            <DxGridDataColumn FieldName="BillJobNo"
                              Caption="Job No"
                              Width="@(layoutManager?.GetColumnWidth("BillJobNo") ?? "120px")"
                              Visible="@(layoutManager?.GetColumnVisibility("BillJobNo") ?? true)" />

            <DxGridDataColumn FieldName="BillJobType"
                              Caption="Job Type"
                              Width="@(layoutManager?.GetColumnWidth("BillJobType") ?? "120px")"
                              Visible="@(layoutManager?.GetColumnVisibility("BillJobType") ?? true)" />

            <DxGridDataColumn FieldName="BillNetAmount"
                              Caption="Total Amount"
                              DisplayFormat="N2"
                              Width="@(layoutManager?.GetColumnWidth("BillNetAmount") ?? "140px")"
                              Visible="@(layoutManager?.GetColumnVisibility("BillNetAmount") ?? true)" />

            <DxGridDataColumn FieldName="Bill_due_amt"
                              Caption="Outstanding Amount"
                              DisplayFormat="N2"
                              Width="@(layoutManager?.GetColumnWidth("Bill_due_amt") ?? "160px")"
                              Visible="@(layoutManager?.GetColumnVisibility("Bill_due_amt") ?? true)" />

            <DxGridDataColumn FieldName="BillContactNo"
                              Caption="Contact No"
                              Width="@(layoutManager?.GetColumnWidth("BillContactNo") ?? "130px")"
                              Visible="@(layoutManager?.GetColumnVisibility("BillContactNo") ?? true)" />

            <DxGridDataColumn FieldName="BillGstNo"
                              Caption="GST No"
                              Width="@(layoutManager?.GetColumnWidth("BillGstNo") ?? "150px")"
                              Visible="@(layoutManager?.GetColumnVisibility("BillGstNo") ?? true)" />

            <DxGridDataColumn FieldName="posname"
                              Caption="Place of Supply"
                              Width="@(layoutManager?.GetColumnWidth("posname") ?? "160px")"
                              Visible="@(layoutManager?.GetColumnVisibility("posname") ?? true)" />

        </Columns>

        <TotalSummary>
            <DxGridSummaryItem SummaryType="GridSummaryItemType.Count" FieldName="BillId" />
            <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum"
                               FieldName="BillNetAmount"
                               DisplayFormat="Total: {0:N2}" />
            <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum"
                               FieldName="Bill_due_amt"
                               DisplayFormat="Outstanding: {0:N2}" />
        </TotalSummary>
    </DxGrid>
</div>

<!-- PRINT ONLY SECTION -->
<div class="print-only-section" id="printOutstandingSection">
    <div class="print-header">
        <h2>Outstanding Report</h2>
        <div class="print-info">
            <strong>From:</strong> @FromDate?.ToString("dd/MM/yyyy") &nbsp;&nbsp;
            <strong>To:</strong> @ToDate?.ToString("dd/MM/yyyy") &nbsp;&nbsp;
            <strong>Print Date:</strong> @DateTime.Now.ToString("dd/MM/yyyy hh:mm tt")
        </div>
    </div>

    <table class="print-table">
        <thead>
            <tr>
                <th>Branch</th>
                <th>Invoice No</th>
                <th>Invoice Date</th>
                <th>Due Date</th>
                <th>Voucher Type</th>
                <th>Customer</th>
                <th>Job No</th>
                <th>Job Type</th>
                <th>Total Amount</th>
                <th>Outstanding Amount</th>
                <th>Contact No</th>
                <th>GST No</th>
            </tr>
        </thead>

        <tbody>
            @if (billList != null && billList.Any())
            {
                @foreach (var bill in billList)
                {
                    <tr>
                        <td>@bill.branchname</td>
                        <td>@bill.BillNo</td>
                        <td>@bill.BillDate.ToString("dd/MM/yyyy")</td>
                        <td>@bill.BillDueDate?.ToString("dd/MM/yyyy")</td>
                        <td>@bill.Vouchname</td>
                        <td>@bill.partyname</td>
                        <td>@bill.BillJobNo</td>
                        <td>@bill.BillJobType</td>
                        <td>@bill.BillNetAmount.ToString("N2")</td>
                        <td>@bill.Bill_due_amt.ToString("N2")</td>
                        <td>@bill.BillContactNo</td>
                        <td>@bill.BillGstNo</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="12" style="text-align:center">No outstanding records available</td>
                </tr>
            }
        </tbody>

        <tfoot>
            <tr>
                <td colspan="8"><strong>Total Outstanding:</strong></td>
                <td><strong>@billList?.Sum(b => b.BillNetAmount).ToString("N2")</strong></td>
                <td><strong>@billList?.Sum(b => b.Bill_due_amt).ToString("N2")</strong></td>
                <td colspan="2"></td>
            </tr>
        </tfoot>
    </table>
</div>


<DateFilterPage @ref="dateFilterPopup" ShowOutstandingTypeFilter="true" OnFilterApplied="HandleFilterApplied" />
<ConfirmationDialog />

<GridLayoutpPopup @ref="layoutManager"
                  VoucherType="OutstandingRegister"
                  Columns="@allColumns"
                  OnLayoutChanged="HandleLayoutChanged" />


@code {
    private async Task ExportXlsx()
    {
        if (billList == null || !billList.Any())
        {
            ToastService.Warning("No data to export.");
            return;
        }
        await MyGrid.ExportToXlsxAsync("OutstandingReport.xlsx");
    }

    private async Task PrintGridPage()
    {
        if (billList == null || !billList.Any())
        {
            ToastService.Warning("No data to print.");
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("window.print");
        }
        catch (Exception ex)
        {
            ToastService.Error($"Print error: {ex.Message}");
        }
    }

    private IGrid MyGrid;
    private List<Bill> billList = new();
    private List<Bill> allBills = new();

    // Filter properties
    private DateTime? FromDate;
    private DateTime? ToDate;
    private string? SelectedOustandingType;

    // Grid Layout Management
    private GridLayoutpPopup? layoutManager;
    private List<GridColumnLayout> allColumns = [];
    private async void ShowLayoutPopup()
    {
        await InvokeAsync(() =>
        {
            layoutManager?.ShowPopup();
        });
    }
    private async Task HandleLayoutChanged(List<GridColumnLayout> updatedLayout)
    {
        allColumns = updatedLayout;
        // Force the grid to re-render with new layout
        await InvokeAsync(StateHasChanged);
    }

    private DateFilterPage dateFilterPopup;

    private void OpenDateFilter()
    {
        dateFilterPopup.Show(FromDate, ToDate, null, null, SelectedOustandingType);
    }

    private async Task HandleFilterApplied((DateTime? FromDate, DateTime? ToDate, string? JobType, int? SelectedVoucherType, string? OutstandingType) f)
    {
        FromDate = f.FromDate;
        ToDate = f.ToDate;
        SelectedOustandingType = f.OutstandingType;
        OnSearch();
    }

    protected override async Task OnInitializedAsync()
    {
        InitializeColumns();
        await LoadAllBills();
    }

    private void InitializeColumns()
    {
        allColumns = new List<GridColumnLayout>
        {
            new() { FieldName = "BillId", Caption = "ID", Visible = false, Width = 80, DisplayIndex = 0 },
            new() { FieldName = "branchname", Caption = "Branch", Visible = true, Width = 120, DisplayIndex = 1 },
            new() { FieldName = "BillNo", Caption = "Invoice No", Visible = true, Width = 150, DisplayIndex = 2 },
            new() { FieldName = "BillDate", Caption = "Invoice Date", Visible = true, Width = 130, DisplayIndex = 3 },
            new() { FieldName = "BillDueDate", Caption = "Due Date", Visible = true, Width = 130, DisplayIndex = 4 },
            new() { FieldName = "Vouchname", Caption = "Voucher Type", Visible = true, Width = 200, DisplayIndex = 5 },
            new() { FieldName = "partyname", Caption = "Customer", Visible = true, Width = 300, DisplayIndex = 6 },
            new() { FieldName = "BillJobNo", Caption = "Job No", Visible = true, Width = 120, DisplayIndex = 7 },
            new() { FieldName = "BillJobType", Caption = "Job Type", Visible = true, Width = 120, DisplayIndex = 8 },
            new() { FieldName = "BillNetAmount", Caption = "Total Amount", Visible = true, Width = 140, DisplayIndex = 9 },
            new() { FieldName = "Bill_due_amt", Caption = "Outstanding Amount", Visible = true, Width = 160, DisplayIndex = 10 },
            new() { FieldName = "BillContactNo", Caption = "Contact No", Visible = true, Width = 130, DisplayIndex = 11 },
            new() { FieldName = "BillGstNo", Caption = "GST No", Visible = true, Width = 150, DisplayIndex = 12 },
            new() { FieldName = "posname", Caption = "Place of Supply", Visible = true, Width = 160, DisplayIndex = 13 }
        };
       
    }

    private async Task LoadAllBills()
    {
        try
        {
            LoadingService.Show("Loading outstanding bills...");
            allBills = (await BillService.GetAllAsync())
     .Where(b =>
         b.BillYearId == YearStatechangeService.SelectedYearId
         && b.Bill_due_amt > 0
         && (
             b.BillType.Equals("SALES", StringComparison.OrdinalIgnoreCase)
             || b.BillType.Equals("PURCHASE", StringComparison.OrdinalIgnoreCase)
             || b.BillType.Equals("DEBIT NOTE", StringComparison.OrdinalIgnoreCase)
             || b.BillType.Equals("CREDIT NOTE", StringComparison.OrdinalIgnoreCase)
         )
     )
     .ToList();

            billList = allBills;
        }
        catch (Exception ex)
        {
            ToastService.Error($"Failed to load outstanding bills: {ex.Message}");
        }
        finally
        {
            LoadingService.Hide();
        }
    }

    private async Task OnSearch()
    {
        billList = allBills;

        // Apply date filter
        if (FromDate.HasValue)
        {
            billList = billList.Where(b => b.BillDate.Date >= FromDate.Value.Date).ToList();
        }

        if (ToDate.HasValue)
        {
            billList = billList.Where(b => b.BillDate.Date <= ToDate.Value.Date).ToList();
        }

      
        // Outstanding Type filter (NULL SAFE)
        if (!string.IsNullOrWhiteSpace(SelectedOustandingType))
        {
            if (SelectedOustandingType.Equals("RECEIVABLE", StringComparison.OrdinalIgnoreCase))
            {
                billList = billList
                    .Where(b =>
                        (b.BillType.Equals("SALES", StringComparison.OrdinalIgnoreCase)
                         || b.BillType.Equals("CREDIT NOTE", StringComparison.OrdinalIgnoreCase))
                        && b.Bill_due_amt > 0
                    )
                    .ToList();
            }
            else if (SelectedOustandingType.Equals("PAYABLE", StringComparison.OrdinalIgnoreCase))
            {
                billList = billList
                    .Where(b =>
                        (b.BillType.Equals("PURCHASE", StringComparison.OrdinalIgnoreCase)
                         || b.BillType.Equals("DEBIT NOTE", StringComparison.OrdinalIgnoreCase))
                        && b.Bill_due_amt > 0
                    )
                    .ToList();
            }
        }
        
        if (billList.Count == 0)
        {
            ToastService.Warning("No outstanding bills found matching the criteria.");
        }
        else
        {
            ToastService.Success($"Found {billList.Count} outstanding bill(s).");
        }

        await InvokeAsync(StateHasChanged);
    }

    

   

    
}
