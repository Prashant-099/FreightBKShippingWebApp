@page "/invoiceregister"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using FreightBKShippingWebApp.Model
@using FreightBKShippingWebApp.Services
@using System.Text.Json
@inject BillService BillService
@inject ToasteService ToastService
@inject LoadingService LoadingService
@inject YearStatechangeService YearStatechangeService
@inject GridLayoutService GridLayoutService
@inject VoucherService VoucherService
@inject IJSRuntime JS

<style>
    .grid-size {
        max-height: 570px;
    }
    .layout-combobox {
        border-radius: 6px;
        width: 185px;
    }
    .toolbar-title {
        display: flex;
        align-items: center;
    }
    /* Print section ko hide rakho normally */
    .print-only-section {
        display: none;
    }

    /* Print time pe sirf print section dikhao */
    @@media print {
        body * {
            visibility: hidden;
        }

        .print-only-section,
        .print-only-section * {
            visibility: visible;
        }

        .print-only-section {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            display: block !important;
        }
        
        @@page {
            size: A4 landscape;
            margin: 1cm;
        }
    }

    /* Print table styling */
    .print-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
        font-size: 12px;
    }

        .print-table th,
        .print-table td {
            border: 1px solid #000;
            padding: 8px;
            text-align: left;
        }

        .print-table th {
            background-color: #f0f0f0;
            font-weight: bold;
        }

        .print-table tfoot td {
            font-weight: bold;
            background-color: #e8e8e8;
        }

    .print-header {
        text-align: center;
        margin-bottom: 20px;
    }

        .print-header h2 {
            margin: 5px 0;
        }

    .print-info {
        margin-bottom: 15px;
        font-size: 14px;
    }
</style>

<div class="px-3 py-3">
    <DxGrid TItem="Bill"
            Data="@billList"
            @ref="MyGrid"
            KeyFieldName="BillId"
            ShowSearchBox="true"
            PageSize="100"
            PageSizeSelectorVisible="false"
            ShowGroupPanel="true"
            FilterMenuButtonDisplayMode="GridFilterMenuButtonDisplayMode.Always"
            FocusedRowEnabled="true"
            ColumnResizeMode="GridColumnResizeMode.NextColumn"
            CssClass="grid-size"
            AllowColumnReorder="true">

        <ToolbarTemplate Context="gridContext">
            <DxToolbar>
                <!-- Title -->
                <DxToolbarItem Alignment="ToolbarItemAlignment.Left">
                    <Template Context="t">
                        <div class="toolbar-title">
                            <i class="bi bi-file-earmark-spreadsheet me-2"></i>
                            <span class="fs-5">Invoice Register</span>
                        </div>
                    </Template>
                </DxToolbarItem>
                <DxToolbarItem Text="Filter"
                               IconCssClass="bi bi-funnel-fill"
                               Click="OpenDateFilter"
                               RenderStyle="ButtonRenderStyle.None"
                               AdaptivePriority="2" />

                <DxToolbarItem Text="Export"
                               RenderStyle="ButtonRenderStyle.None"
                               AdaptivePriority="2">
                    <Items>
                        <DxToolbarItem Text="Excel"
                                       RenderStyle="ButtonRenderStyle.None"
                                       IconCssClass="bi bi-file-earmark-spreadsheet"
                                       Click="ExportXlsx" />
                        <DxToolbarItem Text="PDF"
                                       RenderStyle="ButtonRenderStyle.None"
                                       IconCssClass="bi bi-printer"
                                       Click="PrintGridPage" />
                    </Items>
                </DxToolbarItem>
                <DxToolbarItem Alignment="ToolbarItemAlignment.Right"
                               RenderStyle="ButtonRenderStyle.Secondary"
                               IconCssClass="bi bi-gear-wide-connected"
                               Click="ShowLayoutPopup" />

            </DxToolbar>
        </ToolbarTemplate>

        <Columns>

            <DxGridDataColumn FieldName="BillId"
                              Caption="ID"
                              SortIndex="0"
                              SortOrder="GridColumnSortOrder.Descending"
                              Width="@(layoutManager?.GetColumnWidth("BillId") ?? "80px")"
                              Visible="@(layoutManager?.GetColumnVisibility("BillId") ?? false)" />

            <DxGridDataColumn FieldName="branchname"
                              Caption="Branch"
                              Width="@(layoutManager?.GetColumnWidth("branchname") ?? "120px")"
                              Visible="@(layoutManager?.GetColumnVisibility("branchname") ?? true)" />

            <DxGridDataColumn FieldName="BillNo"
                              Caption="Invoice No"
                              Width="@(layoutManager?.GetColumnWidth("BillNo") ?? "150px")"
                              Visible="@(layoutManager?.GetColumnVisibility("BillNo") ?? true)" />

            <DxGridDataColumn FieldName="BillDate"
                              Caption="Invoice Date"
                              DisplayFormat="dd/MM/yyyy"
                              Width="@(layoutManager?.GetColumnWidth("BillDate") ?? "130px")"
                              Visible="@(layoutManager?.GetColumnVisibility("BillDate") ?? true)" />

            <DxGridDataColumn FieldName="Vouchname"
                              Caption="Voucher Type"
                              Width="@(layoutManager?.GetColumnWidth("Vouchname") ?? "210px")"
                              Visible="@(layoutManager?.GetColumnVisibility("Vouchname") ?? true)" />

            <DxGridDataColumn FieldName="partyname"
                              Caption="Customer"
                              Width="@(layoutManager?.GetColumnWidth("partyname") ?? "300px")"
                              Visible="@(layoutManager?.GetColumnVisibility("partyname") ?? true)" />

            <DxGridDataColumn FieldName="BillJobNo"
                              Caption="Job No"
                              Width="@(layoutManager?.GetColumnWidth("BillJobNo") ?? "120px")"
                              Visible="@(layoutManager?.GetColumnVisibility("BillJobNo") ?? true)" />

            <DxGridDataColumn FieldName="BillJobType"
                              Caption="Job Type"
                              Width="@(layoutManager?.GetColumnWidth("BillJobType") ?? "120px")"
                              Visible="@(layoutManager?.GetColumnVisibility("BillJobType") ?? true)" />

            <DxGridDataColumn FieldName="BillTaxableAmt"
                              Caption="Basic Amount"
                              DisplayFormat="N2"
                              Width="@(layoutManager?.GetColumnWidth("BillTaxableAmt") ?? "200px")"
                              Visible="@(layoutManager?.GetColumnVisibility("BillTaxableAmt") ?? true)" />

            <DxGridDataColumn FieldName="BillCgst"
                              Caption="CGST"
                              DisplayFormat="N2"
                              Width="@(layoutManager?.GetColumnWidth("BillCgst") ?? "120px")"
                              Visible="@(layoutManager?.GetColumnVisibility("BillCgst") ?? true)" />

            <DxGridDataColumn FieldName="BillSgst"
                              Caption="SGST"
                              DisplayFormat="N2"
                              Width="@(layoutManager?.GetColumnWidth("BillSgst") ?? "120px")"
                              Visible="@(layoutManager?.GetColumnVisibility("BillSgst") ?? true)" />

            <DxGridDataColumn FieldName="BillIgst"
                              Caption="IGST"
                              DisplayFormat="N2"
                              Width="@(layoutManager?.GetColumnWidth("BillIgst") ?? "120px")"
                              Visible="@(layoutManager?.GetColumnVisibility("BillIgst") ?? true)" />

            <DxGridDataColumn FieldName="BillTdsPer"
                              Caption="TDS%"
                              DisplayFormat="N2"
                              Width="@(layoutManager?.GetColumnWidth("BillTdsPer") ?? "120px")"
                              Visible="@(layoutManager?.GetColumnVisibility("BillTdsPer") ?? true)" />

            <DxGridDataColumn FieldName="BillTdsAmt"
                              Caption="TDS Amount"
                              DisplayFormat="N2"
                              Width="@(layoutManager?.GetColumnWidth("BillTdsAmt") ?? "200px")"
                              Visible="@(layoutManager?.GetColumnVisibility("BillTdsAmt") ?? true)" />

            <DxGridDataColumn FieldName="BillRoundAmt"
                              Caption="Roundoff"
                              DisplayFormat="N2"
                              Width="@(layoutManager?.GetColumnWidth("BillRoundAmt") ?? "200px")"
                              Visible="@(layoutManager?.GetColumnVisibility("BillRoundAmt") ?? true)" />

            <DxGridDataColumn FieldName="BillNetAmount"
                              Caption="Total Amount"
                              DisplayFormat="N2"
                              Width="@(layoutManager?.GetColumnWidth("BillNetAmount") ?? "170px")"
                              Visible="@(layoutManager?.GetColumnVisibility("BillNetAmount") ?? true)" />

            <DxGridDataColumn FieldName="BillGstNo"
                              Caption="GST No"
                              Width="@(layoutManager?.GetColumnWidth("BillGstNo") ?? "150px")"
                              Visible="@(layoutManager?.GetColumnVisibility("BillGstNo") ?? true)" />

            <DxGridDataColumn FieldName="posname"
                              Caption="Place of Supply"
                              Width="@(layoutManager?.GetColumnWidth("posname") ?? "160px")"
                              Visible="@(layoutManager?.GetColumnVisibility("posname") ?? true)" />

            <DxGridDataColumn FieldName="BillStatus"
                              Caption="Status"
                              Width="@(layoutManager?.GetColumnWidth("BillStatus") ?? "100px")"
                              Visible="@(layoutManager?.GetColumnVisibility("BillStatus") ?? true)" />

        </Columns>

        <TotalSummary>
            <DxGridSummaryItem SummaryType="GridSummaryItemType.Count" FieldName="BillId" />
            <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" 
                               FieldName="BillTotal" 
                               DisplayFormat="Total: {0:N2}" />
            <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" 
                               FieldName="BillNetAmount" 
                               DisplayFormat="Net Total: {0:N2}" />
        </TotalSummary>
    </DxGrid>
</div>
<!-- PRINT ONLY SECTION -->
<div class="print-only-section" id="printInvoiceSection">
    <div class="print-header">
        <h2>Invoice Register</h2>
        <div class="print-info">
            <strong>From:</strong> @FromDate?.ToString("dd/MM/yyyy") &nbsp;&nbsp;
            <strong>To:</strong> @ToDate?.ToString("dd/MM/yyyy") &nbsp;&nbsp;
            <strong>Print Date:</strong> @DateTime.Now.ToString("dd/MM/yyyy hh:mm tt")
        </div>
    </div>

    <table class="print-table">
        <thead>
            <tr>
            
                <th>Branch</th>
                <th>Invoice No</th>
                <th>Invoice Date</th>
                <th>Voucher Type</th>
                <th>Customer</th>
                <th>Job No</th>
                <th>Job Type</th>
                <th>Basic Amount</th>
                <th>Total Amount</th>
                <th>GST No</th>
                <th>Place of Supply</th>
              
            </tr>
        </thead>

        <tbody>
            @if (billList != null && billList.Any())
            {
                @foreach (var bill in billList)
                {
                    

                    <tr>
                       
                        <td>@bill.branchname</td>
                        <td>@bill.BillNo</td>
                        <td>@bill.BillDate.ToString("dd/MM/yyyy")</td>
                        <td>@bill.Vouchname</td>
                        <td>@bill.partyname</td>
                        <td>@bill.BillJobNo</td>
                        <td>@bill.BillJobType</td>
                        <td>@bill.BillTotal.ToString("N2")</td>
                        <td>@bill.BillNetAmount.ToString("N2")</td>
                        <td>@bill.BillGstNo</td>
                        <td>@bill.posname</td>
                        
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="13" style="text-align:center">No records available</td>
                </tr>
            }
        </tbody>

        <tfoot>
            <tr>
                <td colspan="7"><strong>Total Invoices:</strong></td>
                <td><strong>@billList?.Sum(b => b.BillTotal).ToString("N2")</strong></td>
                <td><strong>@billList?.Sum(b => b.BillNetAmount).ToString("N2")</strong></td>
                <td colspan="3"></td>
            </tr>
        </tfoot>
    </table>
</div>

<DateFilterPage @ref="dateFilterPopup" ShowVoucherTypeFilter="true" OnFilterApplied="HandleFilterApplied" />
<ConfirmationDialog />

<GridLayoutpPopup @ref="layoutManager"
                  VoucherType="InvoiceRegister"
                  Columns="@allColumns"
                  OnLayoutChanged="HandleLayoutChanged" />


@code {

    
    private async Task ExportXlsx()
    {

        if (billList == null || !billList.Any())
        {
            ToastService.Warning("No data to print.");
            return;
        }
        await MyGrid.ExportToXlsxAsync("JobRegister.xlsx");
    }
    // ✅ PRINT - Using JavaScript to print specific section
    private async Task PrintGridPage()
    {
        if (billList == null || !billList.Any())
        {
            ToastService.Warning("No data to print.");
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("window.print");
        }
        catch (Exception ex)
        {
            ToastService.Error($"Print error: {ex.Message}");
        }
    }


    private IGrid MyGrid;
    private List<Bill> billList = new();
    private List<Bill> allBills = new();
    private List<Voucher> voucherTypes = new();
    
    // Filter properties
    private DateTime? FromDate;
    private DateTime? ToDate;
    private int? SelectedVoucherType;

    // Grid Layout Management
    private GridLayoutpPopup? layoutManager;
    private List<GridColumnLayout> allColumns = [];
    private async void ShowLayoutPopup()
    {
        await InvokeAsync(() =>
        {
            layoutManager?.ShowPopup();
        });
    }
    private async Task HandleLayoutChanged(List<GridColumnLayout> updatedLayout)
    {
        allColumns = updatedLayout;
        // Force the grid to re-render with new layout
        await InvokeAsync(StateHasChanged);
    }

    private DateFilterPage dateFilterPopup;
    private void OpenDateFilter()
    {
        dateFilterPopup.Show(FromDate, ToDate, null,SelectedVoucherType,null);
    }
    private async Task HandleFilterApplied((DateTime? FromDate, DateTime? ToDate, string? JobType, int? SelectedVoucherType, string? OutstandingType) f)
    {
        FromDate = f.FromDate;
        ToDate = f.ToDate;
        SelectedVoucherType = f.SelectedVoucherType;
        OnSearch();

    }
    protected override async Task OnInitializedAsync()
    {
        InitializeColumns();
        // await LoadVoucherTypes();
        await LoadAllBills();
    }

    private void InitializeColumns()
    {
        allColumns = new List<GridColumnLayout>
        {
            new() { FieldName = "BillId", Caption = "ID", Visible = false, Width = 80, DisplayIndex = 0 },
            new() { FieldName = "branchname", Caption = "Branch", Visible = true, Width = 120, DisplayIndex = 1 },
            new() { FieldName = "BillNo", Caption = "Invoice No", Visible = true, Width = 150, DisplayIndex = 2 },
            new() { FieldName = "BillDate", Caption = "Invoice Date", Visible = true, Width = 130, DisplayIndex = 3 },
            new() { FieldName = "Vouchname", Caption = "Voucher Type", Visible = true, Width = 210, DisplayIndex = 4 },
            new() { FieldName = "partyname", Caption = "Customer", Visible = true, Width = 300, DisplayIndex = 5 },
            new() { FieldName = "BillJobNo", Caption = "Job No", Visible = true, Width = 120, DisplayIndex = 6 },
            new() { FieldName = "BillJobType", Caption = "Job Type", Visible = true, Width = 120, DisplayIndex = 7 },
new() { FieldName = "BillTaxableAmt", Caption = "Basic Amount", Visible = true, Width = 200, DisplayIndex = 8 },
         new() { FieldName = "BillCgst", Caption = "CGST", Visible = true, Width = 120, DisplayIndex = 9 },
          new() { FieldName = "BillSgst", Caption = "SGST", Visible = true, Width = 120, DisplayIndex = 10 },
           new() { FieldName = "BillIgst", Caption = "IGST", Visible = true, Width = 120, DisplayIndex = 11 },
           new() { FieldName = "BillTdsPer", Caption = "TDS%", Visible = true, Width = 120, DisplayIndex = 12 },
             new() { FieldName = "BillTdsAmt", Caption = "TDS Amount", Visible = true, Width = 200, DisplayIndex = 13 },
            new() { FieldName = "BillRoundAmt", Caption = "Roundoff", Visible = true, Width = 200, DisplayIndex = 14 },
               new() { FieldName = "BillNetAmount", Caption = "Total Amount", Visible = true, Width = 170, DisplayIndex = 15 },
            new() { FieldName = "BillGstNo", Caption = "GST No", Visible = true, Width = 150, DisplayIndex = 16 },
            new() { FieldName = "posname", Caption = "Place of Supply", Visible = true, Width = 160, DisplayIndex = 17 },
            new() { FieldName = "BillStatus", Caption = "Status", Visible = true, Width = 100, DisplayIndex = 18 }
        };
      
    }

    // private async Task LoadVoucherTypes()
    // {
    //     try
    //     {
    //         voucherTypes = (await VoucherService.GetAllAsync()).Where(v =>
    //     !string.IsNullOrWhiteSpace(v.VoucherGroup) &&
    //     (
    //         v.VoucherGroup.Trim().Equals("SALES", StringComparison.OrdinalIgnoreCase) ||
    //         v.VoucherGroup.Trim().Equals("CREDIT NOTE", StringComparison.OrdinalIgnoreCase) ||
    //         v.VoucherGroup.Trim().Equals("DEBIT NOTE", StringComparison.OrdinalIgnoreCase) ||
    //         v.VoucherGroup.Trim().Equals("PURCHASE", StringComparison.OrdinalIgnoreCase)
    //     ))
    // .ToList(); 
    //     }
    //     catch (Exception ex)
    //     {
    //         ToastService.Error($"Failed to load voucher types: {ex.Message}");
    //     }
    // }

    private async Task LoadAllBills()
    {
        try
        {
            LoadingService.Show("Loading invoices...");
            allBills = (await BillService.GetAllAsync())
                .Where(b => b.BillYearId == YearStatechangeService.SelectedYearId)
                .ToList();
            billList = allBills;
        }
        catch (Exception ex)
        {
            ToastService.Error($"Failed to load bills: {ex.Message}");
        }
        finally
        {
            LoadingService.Hide();
        }
    }

    private async Task OnSearch()
    {
        billList = allBills;

        // Apply date filter
        if (FromDate.HasValue)
        {
            billList = billList.Where(b => b.BillDate.Date >= FromDate.Value.Date).ToList();
        }

        if (ToDate.HasValue)
        {
            billList = billList.Where(b => b.BillDate.Date <= ToDate.Value.Date).ToList();
        }

        // Apply voucher type filter
        if (SelectedVoucherType.HasValue)
        {
            billList = billList.Where(b => b.BillVoucherId == SelectedVoucherType.Value).ToList();
        }

        if (billList.Count == 0)
        {
            ToastService.Warning("No invoices found matching the criteria.");
        }
        else
        {
            ToastService.Success($"Found {billList.Count} invoice(s).");
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task OnReset()
    {
        FromDate = null;
        ToDate = null;
        SelectedVoucherType = null;
        billList = allBills;
        ToastService.Info("Filters reset.");
        await InvokeAsync(StateHasChanged);
    }

   
}