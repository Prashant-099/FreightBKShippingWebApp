@page "/jobregister"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using FreightBKShippingWebApp.Model
@using FreightBKShippingWebApp.Services
@using System.Text.Json
@inject JobService JobService
@inject ToasteService ToastService
@inject LoadingService LoadingService
@inject YearStatechangeService YearStatechangeService
@inject GridLayoutService GridLayoutService
@inject StatusService StatusService
@inject IJSRuntime JS

<style>
    .grid-size {
        max-height: 570px;
    }

    .layout-combobox {
        border-radius: 6px;
        width: 185px;
    }

    .toolbar-title {
        display: flex;
        align-items: center;
    }

    /* Print section ko hide rakho normally */
    .print-only-section {
        display: none;
    }

    /* Print time pe sirf print section dikhao */
    @@media print {
        body * {
            visibility: hidden;
        }

        .print-only-section,
        .print-only-section * {
            visibility: visible;
        }

        .print-only-section {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            display: block !important;
        }

        @@page {
            size: A4 landscape;
            margin: 1cm;
        }
    }

    /* Print table styling */
    .print-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
        font-size: 12px;
    }

        .print-table th,
        .print-table td {
            border: 1px solid #000;
            padding: 8px;
            text-align: left;
        }

        .print-table th {
            background-color: #f0f0f0;
            font-weight: bold;
        }

        .print-table tfoot td {
            font-weight: bold;
            background-color: #e8e8e8;
        }

    .print-header {
        text-align: center;
        margin-bottom: 20px;
    }

        .print-header h2 {
            margin: 5px 0;
        }

    .print-info {
        margin-bottom: 15px;
        font-size: 14px;
    }
</style>

<div class="px-3 py-3">
    <DxGrid TItem="Job"
        ExportHiddenColumns="true"
            Data="@jobList"
            @ref="MyGrid"
            KeyFieldName="JobId"
            ShowSearchBox="true"
            PageSize="100"
            PageSizeSelectorVisible="false"
            ShowGroupPanel="true"
            FilterMenuButtonDisplayMode="GridFilterMenuButtonDisplayMode.Always"
            FocusedRowEnabled="true"
            ColumnResizeMode="GridColumnResizeMode.NextColumn"
            CssClass="grid-size"
            AllowColumnReorder="true">

        <ToolbarTemplate Context="gridContext">
            <DxToolbar>
                <!-- Title -->
                <DxToolbarItem Alignment="ToolbarItemAlignment.Left">
                    <Template Context="t">
                        <div class="toolbar-title">
                            <i class="bi bi-book me-2"></i>
                            <span class="fs-5">Job Register</span>
                        </div>
                    </Template>
                </DxToolbarItem>
                <DxToolbarItem Text="Filter"
                               IconCssClass="bi bi-funnel-fill"
                               Click="OpenDateFilter"
                               RenderStyle="ButtonRenderStyle.None"
                               AdaptivePriority="2" />


                <DxToolbarItem Text="Export"
                               RenderStyle="ButtonRenderStyle.None"
                               AdaptivePriority="2" >
                            <Items>
                        <DxToolbarItem Text="Excel"
                                       RenderStyle="ButtonRenderStyle.None"
                                       IconCssClass="bi bi-file-earmark-spreadsheet"
                                       Click="ExportXlsx" />
                        <DxToolbarItem Text="PDF"
                                       RenderStyle="ButtonRenderStyle.None"
                                       IconCssClass="bi bi-printer"
                                       Click="PrintGridPage" />
                             </Items>
                           </DxToolbarItem>



                <DxToolbarItem Alignment="ToolbarItemAlignment.Right"
                               RenderStyle="ButtonRenderStyle.Secondary"
                               IconCssClass="bi bi-gear-wide-connected"
                               Click="ShowLayoutPopup" />


            </DxToolbar>
        </ToolbarTemplate>

        <Columns>

            <DxGridDataColumn FieldName="JobId"
                              Caption="ID"
                              SortIndex="0"
                              SortOrder="GridColumnSortOrder.Descending"
                              Width="@(layoutManager?.GetColumnWidth("JobId") ?? "80px")"
                              Visible="@(layoutManager?.GetColumnVisibility("JobId") ?? false)" />

            <DxGridDataColumn FieldName="JobStatus"
                              Caption="Status"
                              Width="@(layoutManager?.GetColumnWidth("JobStatus") ?? "100px")"
                              Visible="@(layoutManager?.GetColumnVisibility("JobStatus") ?? true)">

                <CellDisplayTemplate Context="cellContext">
                    @{
                        var statusId = (int?)cellContext.Value;
                        var statusText = statuslist.FirstOrDefault(s => s.StatusId == statusId)?.StatusName ?? "-";
                        var normalized = statusText?.Trim().ToLower();

                        var bgColor = normalized switch
                        {
                            "pending" => "lightcoral",
                            "complete" => "lightgreen",
                            "completed" => "lightgreen",
                            "cancel" => "orange",
                            "cancelled" => "orange",
                            _ => "white"
                        };
                    }

                    <div style="width:100%; height:100%; background-color:@bgColor;
                        display:flex; align-items:center; justify-content:center;
                        font-weight:bold;">
                        @statusText
                    </div>
                </CellDisplayTemplate>

            </DxGridDataColumn>

            <DxGridDataColumn FieldName="BranchName"
                              Caption="Branch"
                              Width="@(layoutManager?.GetColumnWidth("BranchName") ?? "100px")"
                              Visible="@(layoutManager?.GetColumnVisibility("BranchName") ?? true)" />

            <DxGridDataColumn FieldName="JobNo"
                              Caption="Job No"
                              Width="@(layoutManager?.GetColumnWidth("JobNo") ?? "130px")"
                              Visible="@(layoutManager?.GetColumnVisibility("JobNo") ?? true)" />

            <DxGridDataColumn FieldName="JobDate"
                              Caption="Job Date"
                              DisplayFormat="dd/MM/yyyy"
                              Width="@(layoutManager?.GetColumnWidth("JobDate") ?? "110px")"
                              Visible="@(layoutManager?.GetColumnVisibility("JobDate") ?? true)" />

            <DxGridDataColumn FieldName="JobType"
                              Caption="Job Type"
                              Width="@(layoutManager?.GetColumnWidth("JobType") ?? "130px")"
                              Visible="@(layoutManager?.GetColumnVisibility("JobType") ?? true)" />

            <DxGridDataColumn FieldName="Partyname"
                              Caption="Customer"
                              Width="@(layoutManager?.GetColumnWidth("Partyname") ?? "320px")"
                              Visible="@(layoutManager?.GetColumnVisibility("Partyname") ?? true)" />

            <DxGridDataColumn FieldName="JobBlNo"
                              Caption="B/L No"
                              Width="@(layoutManager?.GetColumnWidth("JobBlNo") ?? "150px")"
                              Visible="@(layoutManager?.GetColumnVisibility("JobBlNo") ?? true)" />

            <DxGridDataColumn FieldName="JobBlDate"
                              Caption="B/L Date"
                              DisplayFormat="dd/MM/yyyy"
                              Width="@(layoutManager?.GetColumnWidth("JobBlDate") ?? "130px")"
                              Visible="@(layoutManager?.GetColumnVisibility("JobBlDate") ?? true)" />

            <DxGridDataColumn FieldName="VesselName"
                              Caption="Vessel"
                              Width="@(layoutManager?.GetColumnWidth("VesselName") ?? "300px")"
                              Visible="@(layoutManager?.GetColumnVisibility("VesselName") ?? true)" />

            <DxGridDataColumn FieldName="PolName"
                              Caption="POL"
                              Width="@(layoutManager?.GetColumnWidth("PolName") ?? "220px")"
                              Visible="@(layoutManager?.GetColumnVisibility("PolName") ?? true)" />

            <DxGridDataColumn FieldName="PodName"
                              Caption="POD"
                              Width="@(layoutManager?.GetColumnWidth("PodName") ?? "220px")"
                              Visible="@(layoutManager?.GetColumnVisibility("PodName") ?? true)" />

            <DxGridDataColumn FieldName="JobFreightBy"
                              Caption="Freight By"
                              Width="@(layoutManager?.GetColumnWidth("JobFreightBy") ?? "130px")"
                              Visible="@(layoutManager?.GetColumnVisibility("JobFreightBy") ?? true)" />

            <DxGridDataColumn FieldName="Job20Ft"
                              Caption="20ft Count"
                              Width="@(layoutManager?.GetColumnWidth("Job20Ft") ?? "130px")"
                              Visible="@(layoutManager?.GetColumnVisibility("Job20Ft") ?? true)" />

            <DxGridDataColumn FieldName="Job40Ft"
                              Caption="40ft Count"
                              Width="@(layoutManager?.GetColumnWidth("Job40Ft") ?? "130px")"
                              Visible="@(layoutManager?.GetColumnVisibility("Job40Ft") ?? true)" />

            <DxGridDataColumn FieldName="JobGrossWt"
                              Caption="Gross Weight"
                              DisplayFormat="N2"
                              Width="@(layoutManager?.GetColumnWidth("JobGrossWt") ?? "160px")"
                              Visible="@(layoutManager?.GetColumnVisibility("JobGrossWt") ?? true)" />

            <DxGridDataColumn FieldName="JobVolume"
                              Caption="Volume (CBM)"
                              DisplayFormat="N2"
                              Width="@(layoutManager?.GetColumnWidth("JobVolume") ?? "160px")"
                              Visible="@(layoutManager?.GetColumnVisibility("JobVolume") ?? true)" />

            <DxGridDataColumn FieldName="JobQty"
                              Caption="Quantity"
                              Width="@(layoutManager?.GetColumnWidth("JobQty") ?? "100px")"
                              Visible="@(layoutManager?.GetColumnVisibility("JobQty") ?? true)" />

            <DxGridDataColumn FieldName="JobChaId"
                              Caption="Customs Agent"
                              Width="@(layoutManager?.GetColumnWidth("JobChaId") ?? "160px")"
                              Visible="@(layoutManager?.GetColumnVisibility("JobChaId") ?? true)" />

            <DxGridDataColumn FieldName="JobRemarks"
                              Caption="Remarks"
                              Width="@(layoutManager?.GetColumnWidth("JobRemarks") ?? "250px")"
                              Visible="@(layoutManager?.GetColumnVisibility("JobRemarks") ?? true)" />

        </Columns>

        <TotalSummary>
            <DxGridSummaryItem SummaryType="GridSummaryItemType.Count" FieldName="JobId" />
            <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum"
                               FieldName="Job20Ft"
                               DisplayFormat="Total 20ft: {0}" />
            <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum"
                               FieldName="Job40Ft"
                               DisplayFormat="Total 40ft: {0}" />
            <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum"
                               FieldName="JobGrossWt"
                               DisplayFormat="Total Weight: {0:N2}" />
        </TotalSummary>

    </DxGrid>
</div>
<!-- PRINT ONLY SECTION -->
<div class="print-only-section" id="printSection">
    <div class="print-header">
        <h2>Job Register</h2>
        <div class="print-info">
            <strong>Job Type:</strong> @SelectedJobType &nbsp;&nbsp;
            <strong>From:</strong> @FromDate?.ToString("dd/MM/yyyy") &nbsp;&nbsp;
            <strong>To:</strong> @ToDate?.ToString("dd/MM/yyyy") &nbsp;&nbsp;
            <strong>Print Date:</strong> @DateTime.Now.ToString("dd/MM/yyyy hh:mm tt")
        </div>
    </div>

    <table class="print-table">
        <thead>
            <tr>
                
                <th>Status</th>
                <th>Branch</th>
                <th>Job No</th>
                <th>Job Date</th>
                <th>Job Type</th>
                <th>Customer</th>
                <th>B/L No</th>
                <th>B/L Date</th>
                <th>Vessel</th>
                <th>POL</th>
                <th>POD</th>
                <th>Freight By</th>
                <th>20ft Count</th>
                <th>40ft Count</th>
                <th>Gross Weight</th>
                <th>Volume (CBM)</th>
                <th>Quantity</th>
                <th>Customs Agent</th>
                <th>Remarks</th>
            </tr>
        </thead>

        <tbody>
            @if (jobList != null && jobList.Any())
            {
                @foreach (var job in jobList)
                {
                    <tr>
                        <td>
                            @{
                                var statusText = statuslist
                                .FirstOrDefault(s => s.StatusId == job.JobStatus)?
                                .StatusName ?? "-";
                            }
                            @statusText
                        </td>
                        <td>@job.BranchName</td>
                        <td>@job.JobNo</td>
                        <td>@job.JobDate.ToString("dd/MM/yyyy")</td>
                        <td>@job.JobType</td>
                        <td>@job.Partyname</td>
                        <td>@job.JobBlNo</td>
                        <td>@job.JobBlDate?.ToString("dd/MM/yyyy")</td>
                        <td>@job.VesselName</td>
                        <td>@job.PolName</td>
                        <td>@job.PodName</td>
                        <td>@job.JobFreightBy</td>
                        <td>@job.Job20Ft</td>
                        <td>@job.Job40Ft</td>
                        <td>@job.JobGrossWt?.ToString("N2")</td>
                        <td>@job.JobVolume</td>
                        <td>@job.JobQty</td>
                        <td>@job.JobChaId</td>
                        <td>@job.JobRemarks</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="20" style="text-align:center">No records available</td>
                </tr>
            }
        </tbody>
    </table>
</div>


<ConfirmationDialog />
<DateFilterPage @ref="dateFilterPopup" ShowJobTypeFilter ="true" OnFilterApplied="HandleFilterApplied" />
<GridLayoutpPopup @ref="layoutManager"
                  VoucherType="JobRegister"
                  Columns="@allColumns"
                  OnLayoutChanged="HandleLayoutChanged" />

@code {

    private async Task ExportXlsx()
    {   
        if (jobList == null || !jobList.Any())
        {
            ToastService.Warning("No data to print.");
            return;
        }
        await MyGrid.ExportToXlsxAsync("JobRegister.xlsx");
    }
    // ✅ PRINT - Using JavaScript to print specific section
    private async Task PrintGridPage()
    {
        if (jobList == null || !jobList.Any())
        {
            ToastService.Warning("No data to print.");
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("window.print");
        }
        catch (Exception ex)
        {
            ToastService.Error($"Print error: {ex.Message}");
        }
    }

    


    private IGrid MyGrid;
    private List<Job> jobList = new();
    private List<Job> allJobs = new();
    List<Status> statuslist;
    // Filter properties
    private DateTime? FromDate;
    private DateTime? ToDate;
    private string? SelectedJobType;
    private List<string> jobTypes = new() { "IMPORT", "EXPORT" };


    private GridLayoutpPopup? layoutManager;
    private List<GridColumnLayout> allColumns = [];
    private async void ShowLayoutPopup()
    {
        await InvokeAsync(() =>
        {
            layoutManager?.ShowPopup();
        });
    }
    private async Task HandleLayoutChanged(List<GridColumnLayout> updatedLayout)
    {
        allColumns = updatedLayout;
        // Force the grid to re-render with new layout
        await InvokeAsync(StateHasChanged);
    }

    private DateFilterPage dateFilterPopup;
    private void OpenDateFilter()
    {
        dateFilterPopup.Show(FromDate, ToDate, SelectedJobType,null,null);
    }
    private async Task HandleFilterApplied((DateTime? FromDate, DateTime? ToDate, string? JobType, int? vouchertype, string? OutstandingType) f)
    {
        FromDate = f.FromDate;
        ToDate = f.ToDate;
        SelectedJobType = f.JobType;
        OnSearch();

    }
    private async Task OnSearch()
    {
        jobList = allJobs;

        // Apply date filter
        if (FromDate.HasValue)
        {
            jobList = jobList.Where(j => j.JobDate.Date >= FromDate.Value.Date).ToList();
        }

        if (ToDate.HasValue)
        {
            jobList = jobList.Where(j => j.JobDate.Date <= ToDate.Value.Date).ToList();
        }

        // Apply job type filter
        if (!string.IsNullOrEmpty(SelectedJobType))
        {
            jobList = jobList.Where(j => j.JobType != null &&
                j.JobType.Equals(SelectedJobType, StringComparison.OrdinalIgnoreCase)).ToList();
        }

        if (jobList.Count == 0)
        {
            ToastService.Warning("No jobs found matching the criteria.");
        }
        else
        {
            ToastService.Success($"Found {jobList.Count} job(s).");
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task OnReset()
    {
        FromDate = null;
        ToDate = null;
        SelectedJobType = null;
        jobList = allJobs;
        ToastService.Info("Filters reset.");
        await InvokeAsync(StateHasChanged);
    }
    protected override async Task OnInitializedAsync()
    {
        InitializeColumns();
        await LoadAllJobs();
    }

    private void InitializeColumns()
    {
        allColumns = new List<GridColumnLayout>
        {
             new() { FieldName = "JobState", Caption = "Status", Visible = true, Width = 100, DisplayIndex = 0 },
            new() { FieldName = "JobId", Caption = "ID", Visible = false, Width = 80, DisplayIndex = 1 },
            new() { FieldName = "BranchName", Caption = "Branch", Visible = true, Width = 100, DisplayIndex = 2 },
            new() { FieldName = "JobNo", Caption = "Job No", Visible = true, Width = 130, DisplayIndex = 3 },
            new() { FieldName = "JobDate", Caption = "Job Date", Visible = true, Width = 110, DisplayIndex = 4 },
            new() { FieldName = "JobType", Caption = "Job Type", Visible = true, Width = 130, DisplayIndex = 5 },
             new() { FieldName = "Partyname", Caption = "Customer", Visible = true, Width = 320, DisplayIndex = 6 },
            new() { FieldName = "JobBlNo", Caption = "B/L No", Visible = true, Width = 150, DisplayIndex = 7 },
            new() { FieldName = "JobBlDate", Caption = "B/L Date", Visible = true, Width = 130, DisplayIndex = 8},
            new() { FieldName = "VesselName", Caption = "Vessel", Visible = true, Width = 300, DisplayIndex = 9 },
            new() { FieldName = "PolName", Caption = "POL", Visible = true, Width = 220, DisplayIndex = 10},
            new() { FieldName = "PodName", Caption = "POD", Visible = true, Width = 220, DisplayIndex = 11 },
            new() { FieldName = "JobFreightBy", Caption = "Freight By", Visible = true, Width = 130, DisplayIndex = 12 },
            new() { FieldName = "Job20Ft", Caption = "20ft Count", Visible = true, Width = 130, DisplayIndex = 13 },
            new() { FieldName = "Job40Ft", Caption = "40ft Count", Visible = true, Width = 130, DisplayIndex = 14 },
            new() { FieldName = "JobGrossWt", Caption = "Gross Weight", Visible = true, Width = 160, DisplayIndex = 15 },
            new() { FieldName = "JobVolume", Caption = "Volume (CBM)", Visible = true, Width = 160, DisplayIndex = 16 },
            new() { FieldName = "JobQty", Caption = "Quantity", Visible = true, Width = 100, DisplayIndex = 17 },
            new() { FieldName = "JobChaId", Caption = "Customs Agent", Visible = true, Width = 160, DisplayIndex = 18 },
            new() { FieldName = "JobRemarks", Caption = "Remarks", Visible = true, Width = 250, DisplayIndex = 19 },
           
        };
       
    }

    private async Task LoadAllJobs()
    {
        try
        {
            LoadingService.Show("Loading jobs...");
            allJobs = (await JobService.GetAllAsync())
                .Where(j => j.JobYearId == YearStatechangeService.SelectedYearId.ToString())
                .ToList();
            jobList = allJobs;
            statuslist = await StatusService.GetAllAsync();
        }
        catch (Exception ex)
        {
            ToastService.Error($"Failed to load jobs: {ex.Message}");
        }
        finally
        {
            LoadingService.Hide();
        }
    }

  

    
}