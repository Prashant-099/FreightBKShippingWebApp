@page "/jobregister"
@using FreightBKShippingWebApp.Model
@using FreightBKShippingWebApp.Services
@using System.Text.Json
@inject JobService JobService
@inject ToasteService ToastService
@inject LoadingService LoadingService
@inject YearStatechangeService YearStatechangeService
@inject GridLayoutService GridLayoutService
@inject IJSRuntime JS

<style>
    .grid-size {
        max-height: 600px;
    }

    .layout-combobox {
        border-radius: 6px;
        width: 185px;
    }

    .toolbar-title {
        display: flex;
        align-items: center;
    }
</style>

<div class="px-3 py-3">
    <DxGrid TItem="Job"
            Data="@jobList"
            @ref="MyGrid"
            KeyFieldName="JobId"
            ShowSearchBox="true"
            PageSize="20"
            PageSizeSelectorVisible="true"
            ShowGroupPanel="true"
            FilterMenuButtonDisplayMode="GridFilterMenuButtonDisplayMode.Always"
            FocusedRowEnabled="true"
            ColumnResizeMode="GridColumnResizeMode.NextColumn"
            CssClass="grid-size"
            AllowColumnReorder="true"
            LayoutAutoSaving="OnLayoutAutoSaving"
            LayoutAutoLoading="OnLayoutAutoLoading">

        <ToolbarTemplate Context="gridContext">
            <DxToolbar>
                <!-- Title -->
                <DxToolbarItem Alignment="ToolbarItemAlignment.Left">
                    <Template Context="t">
                        <div class="toolbar-title">
                            <i class="bi bi-briefcase-fill me-2"></i>
                            <span class="fs-5">Job Register</span>
                        </div>
                    </Template>
                </DxToolbarItem>

                <!-- Job Type Filter -->
                <DxToolbarItem BeginGroup="true"
                               Alignment="ToolbarItemAlignment.Right"
                               AdaptivePriority="3">
                    <Template Context="t">
                        <DxComboBox Data="@jobTypes"
                                    @bind-Value="SelectedJobType"
                                    NullText="All Job Types"
                                    ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                    </Template>
                </DxToolbarItem>

                <!-- From Date -->
                <DxToolbarItem BeginGroup="true"
                               AdaptivePriority="2"
                               Alignment="ToolbarItemAlignment.Right">
                    <Template Context="t">
                        <DxDateEdit @bind-Date="FromDate"
                                    NullText="From Date"
                                    DisplayFormat="dd/MM/yyyy"
                                    ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                    </Template>
                </DxToolbarItem>

                <!-- To Date -->
                <DxToolbarItem BeginGroup="true"
                               AdaptivePriority="2"
                               Alignment="ToolbarItemAlignment.Right">
                    <Template Context="t">
                        <DxDateEdit @bind-Date="ToDate"
                                    NullText="To Date"
                                    DisplayFormat="dd/MM/yyyy"
                                    ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                    </Template>
                </DxToolbarItem>

                <!-- Search Button -->
                <DxToolbarItem Alignment="ToolbarItemAlignment.Right"
                               BeginGroup="true"
                               AdaptivePriority="1">
                    <Template Context="t">
                        <DxButton Text="Search"
                                  IconCssClass="bi bi-search"
                                  RenderStyle="ButtonRenderStyle.Primary"
                                  Click="OnSearch" />
                    </Template>
                </DxToolbarItem>

                <!-- Reset Button -->
                <DxToolbarItem Alignment="ToolbarItemAlignment.Right"
                               AdaptivePriority="1">
                    <Template Context="t">
                        <DxButton Text="Reset"
                                  IconCssClass="bi bi-arrow-counterclockwise"
                                  RenderStyle="ButtonRenderStyle.Secondary"
                                  Click="OnReset" />
                    </Template>
                </DxToolbarItem>

                <!-- Layout Selector -->
                <DxToolbarItem IconCssClass="bi bi-gear-wide-connected"
                               Alignment="ToolbarItemAlignment.Right"
                               AdaptivePriority="1">
                    <Template Context="ctx">
                        <DxComboBox Data="@availableLayouts"
                                    Value="@selectedLayoutId"
                                    ValueExpression="@(() => selectedLayoutId)"
                                    ValueChanged="@((int? value) => OnLayoutSelectedAsync(value))"
                                    ValueFieldName="GridLayoutId"
                                    TextFieldName="GridLayoutName"
                                    NullText="Default View"
                                    ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                    CssClass="layout-combobox" />
                    </Template>
                </DxToolbarItem>

                <!-- Layout Management -->
                <DxToolbarItem Context="cfdr"
                               Alignment="ToolbarItemAlignment.Right"
                               RenderStyleMode="ToolbarItemRenderStyleMode.Contained"
                               RenderStyle="ButtonRenderStyle.Secondary"
                               IconCssClass="bi bi-gear-wide-connected"
                               AdaptivePriority="1">
                    <Items>
                        <DxToolbarItem Text="Save Current Layout"
                                       RenderStyle="ButtonRenderStyle.Primary"
                                       IconCssClass="bi bi-floppy"
                                       Click="ShowSaveLayoutDialog" />

                        <DxToolbarItem Text="Create New Layout"
                                       RenderStyle="ButtonRenderStyle.Success"
                                       IconCssClass="bi bi-plus-square"
                                       Click="ShowNewLayoutDialog" />

                        @if (selectedLayoutId.HasValue)
                        {
                            <DxToolbarItem Text="Delete Current Layout"
                                           RenderStyle="ButtonRenderStyle.Danger"
                                           IconCssClass="bi bi-trash"
                                           Click="DeleteCurrentLayout" />
                        }
                    </Items>
                </DxToolbarItem>
            </DxToolbar>
        </ToolbarTemplate>

        <Columns>
            <DxGridDataColumn FieldName="JobId"
                              Caption="ID"
                              Visible="@GetColumnVisibility("JobId")"
                              Width="@GetColumnWidth("JobId")"
                              SortIndex="0"
                              SortOrder="GridColumnSortOrder.Descending" />

            <DxGridDataColumn FieldName="BranchName"
                              Caption="Branch"
                              Visible="@GetColumnVisibility("BranchName")"
                              Width="@GetColumnWidth("BranchName")" />

            <DxGridDataColumn FieldName="JobNo"
                              Caption="Job No"
                              Visible="@GetColumnVisibility("JobNo")"
                              Width="@GetColumnWidth("JobNo")" />

            <DxGridDataColumn FieldName="JobDate"
                              Caption="Job Date"
                              DisplayFormat="dd/MM/yyyy"
                              Visible="@GetColumnVisibility("JobDate")"
                              Width="@GetColumnWidth("JobDate")" />

            <DxGridDataColumn FieldName="JobType"
                              Caption="Job Type"
                              Visible="@GetColumnVisibility("JobType")"
                              Width="@GetColumnWidth("JobType")" />

            <DxGridDataColumn FieldName="JobBlNo"
                              Caption="B/L No"
                              Visible="@GetColumnVisibility("JobBlNo")"
                              Width="@GetColumnWidth("JobBlNo")" />

            <DxGridDataColumn FieldName="JobBlDate"
                              Caption="B/L Date"
                              DisplayFormat="dd/MM/yyyy"
                              Visible="@GetColumnVisibility("JobBlDate")"
                              Width="@GetColumnWidth("JobBlDate")" />

            <DxGridDataColumn FieldName="VesselName"
                              Caption="Vessel"
                              Visible="@GetColumnVisibility("VesselName")"
                              Width="@GetColumnWidth("VesselName")" />

            <DxGridDataColumn FieldName="PolName"
                              Caption="POL"
                              Visible="@GetColumnVisibility("PolName")"
                              Width="@GetColumnWidth("PolName")" />

            <DxGridDataColumn FieldName="PodName"
                              Caption="POD"
                              Visible="@GetColumnVisibility("PodName")"
                              Width="@GetColumnWidth("PodName")" />

            <DxGridDataColumn FieldName="JobFreightBy"
                              Caption="Freight By"
                              Visible="@GetColumnVisibility("JobFreightBy")"
                              Width="@GetColumnWidth("JobFreightBy")" />

            <DxGridDataColumn FieldName="Job20Ft"
                              Caption="20ft Count"
                              Visible="@GetColumnVisibility("Job20Ft")"
                              Width="@GetColumnWidth("Job20Ft")" />

            <DxGridDataColumn FieldName="Job40Ft"
                              Caption="40ft Count"
                              Visible="@GetColumnVisibility("Job40Ft")"
                              Width="@GetColumnWidth("Job40Ft")" />

            <DxGridDataColumn FieldName="JobGrossWt"
                              Caption="Gross Weight"
                              DisplayFormat="N2"
                              Visible="@GetColumnVisibility("JobGrossWt")"
                              Width="@GetColumnWidth("JobGrossWt")" />

            <DxGridDataColumn FieldName="JobVolume"
                              Caption="Volume (CBM)"
                              DisplayFormat="N2"
                              Visible="@GetColumnVisibility("JobVolume")"
                              Width="@GetColumnWidth("JobVolume")" />

            <DxGridDataColumn FieldName="JobQty"
                              Caption="Quantity"
                              Visible="@GetColumnVisibility("JobQty")"
                              Width="@GetColumnWidth("JobQty")" />

            <DxGridDataColumn FieldName="JobChaId"
                              Caption="Customs Agent"
                              Visible="@GetColumnVisibility("JobChaId")"
                              Width="@GetColumnWidth("JobChaId")" />

            <DxGridDataColumn FieldName="JobRemarks"
                              Caption="Remarks"
                              Visible="@GetColumnVisibility("JobRemarks")"
                              Width="@GetColumnWidth("JobRemarks")" />

            <DxGridDataColumn FieldName="JobState"
                              Caption="Status"
                              Visible="@GetColumnVisibility("JobState")"
                              Width="@GetColumnWidth("JobState")" />
        </Columns>

        <TotalSummary>
            <DxGridSummaryItem SummaryType="GridSummaryItemType.Count" FieldName="JobId" />
            <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum"
                               FieldName="Job20Ft"
                               DisplayFormat="Total 20ft: {0}" />
            <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum"
                               FieldName="Job40Ft"
                               DisplayFormat="Total 40ft: {0}" />
            <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum"
                               FieldName="JobGrossWt"
                               DisplayFormat="Total Weight: {0:N2}" />
        </TotalSummary>
    </DxGrid>
</div>

<!-- Layout Dialog -->
@if (showLayoutDialog)
{
    <div class="modal fade show d-block" style="background-color: rgba(0, 0, 0, 0.5); z-index: 1050;">
        <div class="modal-dialog modal-md" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@dialogTitle</h5>
                    <button type="button" class="btn-close" @onclick="CloseLayoutDialog"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Layout Name:</label>
                        <input type="text" class="form-control" @bind="newLayoutName"
                               @bind:event="oninput" placeholder="Enter layout name..." maxlength="100" />
                    </div>
                    <div class="mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox"
                                   @bind="isDefaultLayout" id="defaultLayoutCheck" />
                            <label class="form-check-label" for="defaultLayoutCheck">
                                Set as Default Layout
                            </label>
                        </div>
                    </div>
                    <div class="mt-3">
                        <label class="form-label fw-bold mb-2">Column Configuration:</label>
                        <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                            <table class="table table-sm table-bordered">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th style="width: 50px;">Visible</th>
                                        <th style="width: 200px;">Column Name</th>
                                        <th style="width: 150px;">Width (px)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var col in allColumns)
                                    {
                                        <tr>
                                            <td class="text-center">
                                                <input class="form-check-input" type="checkbox"
                                                       @bind="col.Visible" id="col_@col.FieldName" />
                                            </td>
                                            <td>
                                                <label class="mb-0" for="col_@col.FieldName">@col.Caption</label>
                                            </td>
                                            <td>
                                                <input type="number" class="form-control form-control-sm"
                                                       @bind="col.Width" @bind:event="oninput"
                                                       min="50" max="500" step="10" />
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseLayoutDialog">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveCurrentLayout">
                        <i class="bi bi-floppy me-1"></i>
                        @(isEditMode ? "Update" : "Create") Layout
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private IGrid MyGrid;
    private List<Job> jobList = new();
    private List<Job> allJobs = new();

    // Filter properties
    private DateTime? FromDate;
    private DateTime? ToDate;
    private string? SelectedJobType;
    private List<string> jobTypes = new() { "IMPORT", "EXPORT" };

    // Grid Layout Management
    private List<GridLayoutDto> availableLayouts = [];
    private int? selectedLayoutId;
    private bool showLayoutDialog = false;
    private string newLayoutName = "";
    private string dialogTitle = "";
    private bool isEditMode = false;
    private bool isDefaultLayout = false;
    private const string VOUCHER_TYPE = "JobRegister";
    private List<GridColumnLayout> allColumns = [];
    private List<GridColumnLayout> currentLayout = [];

    protected override async Task OnInitializedAsync()
    {
        InitializeColumns();
        await LoadAvailableLayouts();
        await LoadDefaultLayout();
        await LoadAllJobs();
    }

    private void InitializeColumns()
    {
        allColumns = new List<GridColumnLayout>
        {
            new() { FieldName = "JobId", Caption = "ID", Visible = false, Width = 80, DisplayIndex = 0 },
            new() { FieldName = "BranchName", Caption = "Branch", Visible = true, Width = 120, DisplayIndex = 1 },
            new() { FieldName = "JobNo", Caption = "Job No", Visible = true, Width = 150, DisplayIndex = 2 },
            new() { FieldName = "JobDate", Caption = "Job Date", Visible = true, Width = 130, DisplayIndex = 3 },
            new() { FieldName = "JobType", Caption = "Job Type", Visible = true, Width = 120, DisplayIndex = 4 },
            new() { FieldName = "JobBlNo", Caption = "B/L No", Visible = true, Width = 150, DisplayIndex = 5 },
            new() { FieldName = "JobBlDate", Caption = "B/L Date", Visible = true, Width = 130, DisplayIndex = 6 },
            new() { FieldName = "VesselName", Caption = "Vessel", Visible = true, Width = 180, DisplayIndex = 7 },
            new() { FieldName = "PolName", Caption = "POL", Visible = true, Width = 150, DisplayIndex = 8 },
            new() { FieldName = "PodName", Caption = "POD", Visible = true, Width = 150, DisplayIndex = 9 },
            new() { FieldName = "JobFreightBy", Caption = "Freight By", Visible = true, Width = 130, DisplayIndex = 10 },
            new() { FieldName = "Job20Ft", Caption = "20ft Count", Visible = true, Width = 100, DisplayIndex = 11 },
            new() { FieldName = "Job40Ft", Caption = "40ft Count", Visible = true, Width = 100, DisplayIndex = 12 },
            new() { FieldName = "JobGrossWt", Caption = "Gross Weight", Visible = true, Width = 130, DisplayIndex = 13 },
            new() { FieldName = "JobVolume", Caption = "Volume (CBM)", Visible = true, Width = 130, DisplayIndex = 14 },
            new() { FieldName = "JobQty", Caption = "Quantity", Visible = true, Width = 100, DisplayIndex = 15 },
            new() { FieldName = "JobChaId", Caption = "Customs Agent", Visible = true, Width = 160, DisplayIndex = 16 },
            new() { FieldName = "JobRemarks", Caption = "Remarks", Visible = true, Width = 200, DisplayIndex = 17 },
            new() { FieldName = "JobState", Caption = "Status", Visible = true, Width = 100, DisplayIndex = 18 }
        };
        currentLayout = allColumns.ToList();
    }

    private async Task LoadAllJobs()
    {
        try
        {
            LoadingService.Show("Loading jobs...");
            allJobs = (await JobService.GetAllAsync())
                .Where(j => j.JobYearId == YearStatechangeService.SelectedYearId.ToString())
                .ToList();
            jobList = allJobs;
        }
        catch (Exception ex)
        {
            ToastService.Error($"Failed to load jobs: {ex.Message}");
        }
        finally
        {
            LoadingService.Hide();
        }
    }

    private async Task OnSearch()
    {
        jobList = allJobs;

        // Apply date filter
        if (FromDate.HasValue)
        {
            jobList = jobList.Where(j => j.JobDate.Date >= FromDate.Value.Date).ToList();
        }

        if (ToDate.HasValue)
        {
            jobList = jobList.Where(j => j.JobDate.Date <= ToDate.Value.Date).ToList();
        }

        // Apply job type filter
        if (!string.IsNullOrEmpty(SelectedJobType))
        {
            jobList = jobList.Where(j => j.JobType != null &&
                j.JobType.Equals(SelectedJobType, StringComparison.OrdinalIgnoreCase)).ToList();
        }

        if (jobList.Count == 0)
        {
            ToastService.Warning("No jobs found matching the criteria.");
        }
        else
        {
            ToastService.Success($"Found {jobList.Count} job(s).");
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task OnReset()
    {
        FromDate = null;
        ToDate = null;
        SelectedJobType = null;
        jobList = allJobs;
        ToastService.Info("Filters reset.");
        await InvokeAsync(StateHasChanged);
    }

    // Layout Management Methods
    private string GetColumnWidth(string fieldName)
    {
        var col = currentLayout.FirstOrDefault(x => x.FieldName == fieldName);
        return $"{col?.Width ?? 100}px";
    }

    private bool GetColumnVisibility(string fieldName)
    {
        var col = currentLayout.FirstOrDefault(x => x.FieldName == fieldName);
        return col?.Visible ?? true;
    }

    private async Task LoadAvailableLayouts()
    {
        availableLayouts = await GridLayoutService.GetLayoutsByVoucherTypeAsync(VOUCHER_TYPE);
    }

    private async Task LoadDefaultLayout()
    {
        var defaultLayout = await GridLayoutService.GetDefaultLayoutAsync(VOUCHER_TYPE);
        if (defaultLayout != null)
        {
            selectedLayoutId = defaultLayout.GridLayoutId;
            await ApplyLayout(defaultLayout);
        }
    }

    private async Task OnLayoutSelectedAsync(int? layoutId)
    {
        selectedLayoutId = layoutId;
        if (layoutId.HasValue)
        {
            var layout = await GridLayoutService.GetByIdAsync(layoutId.Value);
            if (layout != null) await ApplyLayout(layout);
        }
        else
        {
            InitializeColumns();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ApplyLayout(GridLayoutDto layout)
    {
        if (!string.IsNullOrEmpty(layout.GridLayoutData))
        {
            var savedLayout = GridLayoutService.DeserializeColumnLayout(layout.GridLayoutData);
            if (savedLayout != null && savedLayout.Any())
            {
                currentLayout = savedLayout.ToList();
                foreach (var saved in savedLayout)
                {
                    var existing = allColumns.FirstOrDefault(x => x.FieldName == saved.FieldName);
                    if (existing != null)
                    {
                        existing.Visible = saved.Visible;
                        existing.Width = saved.Width;
                        existing.DisplayIndex = saved.DisplayIndex;
                    }
                }
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void ShowSaveLayoutDialog()
    {
        if (selectedLayoutId.HasValue)
        {
            var layout = availableLayouts.FirstOrDefault(x => x.GridLayoutId == selectedLayoutId.Value);
            if (layout != null)
            {
                newLayoutName = layout.GridLayoutName ?? "";
                isDefaultLayout = layout.GridLayoutDefault;
                isEditMode = true;
                dialogTitle = "Update Grid Layout";
                showLayoutDialog = true;
                return;
            }
        }
        ShowNewLayoutDialog();
    }

    private void ShowNewLayoutDialog()
    {
        newLayoutName = "";
        isDefaultLayout = false;
        isEditMode = false;
        dialogTitle = "Create New Grid Layout";
        showLayoutDialog = true;
    }

    private async Task SaveCurrentLayout()
    {
        if (string.IsNullOrWhiteSpace(newLayoutName))
        {
            ToastService.Warning("Please enter a layout name.");
            return;
        }

        LoadingService.Show("Saving layout...");
        try
        {
            foreach (var col in allColumns)
            {
                var current = currentLayout.FirstOrDefault(c => c.FieldName == col.FieldName);
                if (current != null)
                {
                    current.Visible = col.Visible;
                    current.Width = col.Width;
                }
            }

            var configJson = GridLayoutService.SerializeColumnLayout(currentLayout);
            bool success;

            if (isEditMode && selectedLayoutId.HasValue)
            {
                success = await GridLayoutService.UpdateAsync(selectedLayoutId.Value, new SaveGridLayoutRequest
                {
                    GridLayoutName = newLayoutName,
                    GridLayoutVoucherType = VOUCHER_TYPE,
                    GridLayoutData = configJson,
                    GridLayoutDefault = isDefaultLayout
                });
            }
            else
            {
                success = await GridLayoutService.CreateAsync(new SaveGridLayoutRequest
                {
                    GridLayoutName = newLayoutName,
                    GridLayoutVoucherType = VOUCHER_TYPE,
                    GridLayoutData = configJson,
                    GridLayoutDefault = isDefaultLayout
                });
            }

            if (success)
            {
                ToastService.Success($"Layout {(isEditMode ? "updated" : "created")} successfully!");
                await LoadAvailableLayouts();
                CloseLayoutDialog();
            }
            else
            {
                ToastService.Error("Failed to save layout.");
            }
        }
        finally
        {
            LoadingService.Hide();
        }
    }

    private async Task DeleteCurrentLayout()
    {
        if (!selectedLayoutId.HasValue) return;

        LoadingService.Show("Deleting layout...");
        try
        {
            var success = await GridLayoutService.DeleteAsync(selectedLayoutId.Value);
            if (success)
            {
                ToastService.Success("Layout deleted successfully!");
                selectedLayoutId = null;
                InitializeColumns();
                await LoadAvailableLayouts();
            }
        }
        finally
        {
            LoadingService.Hide();
        }
    }

    private void CloseLayoutDialog()
    {
        showLayoutDialog = false;
        newLayoutName = "";
        isDefaultLayout = false;
        isEditMode = false;
    }

    const string LayoutKey = "JobRegisterLayout";

    async Task OnLayoutAutoSaving(GridPersistentLayoutEventArgs e)
    {
        try
        {
            var json = JsonSerializer.Serialize(e.Layout);
            await JS.InvokeVoidAsync("localStorage.setItem", LayoutKey, json);
        }
        catch { }
    }

    async Task OnLayoutAutoLoading(GridPersistentLayoutEventArgs e)
    {
        try
        {
            var json = await JS.InvokeAsync<string>("localStorage.getItem", LayoutKey);
            if (!string.IsNullOrEmpty(json))
            {
                e.Layout = JsonSerializer.Deserialize<GridPersistentLayout>(json);
            }
        }
        catch { }
    }
}