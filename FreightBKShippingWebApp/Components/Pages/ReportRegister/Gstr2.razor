<DateFilterPage @ref="dateFilterPopup" OnFilterApplied="ApplyFilter" />

@code {
    // Grid references
    private IGrid B2BGrid;
    private IGrid B2BURGrid;
    private IGrid IMPSGrid;
    private IGrid IMPGGrid;
    private IGrid CDNRGrid;
    private IGrid CDNURGrid;
    private IGrid HSNSummaryGrid;

    // Filter properties
    private DateTime? filterFromDate;
    private DateTime? filterToDate;
    private int activeTab = 0;
    private DateFilterPage dateFilterPopup;

    // Data lists
    private List<Bill> allPurchaseInvoices = new();
    private List<Bill> b2bPurchases = new();
    private List<Bill> b2burPurchases = new();
    private List<Bill> importServices = new();
    private List<Bill> importGoods = new();
    private List<Bill> creditDebitNotesReg = new();
    private List<Bill> creditDebitNotesUnreg = new();
    private List<Gstr2TemplateService.HSNSummary> hsnSummary = new();
    private GSTR2Summary? summaryData;
    private ValidationStatus validationStatus;



    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

   

    private async Task LoadData()
    {
        try
        {
            LoadingService.Show("Loading GSTR-2 data...");

            // Get purchase voucher IDs
            var purchaseVoucherIds = (await VoucherService.GetAllAsync())
                .Where(v => v.VoucherGroup == "PURCHASE" || v.VoucherGroup == "DEBIT NOTE")
                .Select(v => v.VoucherId)
                .ToList();

            allPurchaseInvoices = (await BillService.GetAllAsync())
                .Where(b => b.BillYearId == YearStatechangeService.SelectedYearId
                         && purchaseVoucherIds.Contains(b.BillVoucherId))
                .ToList();

            await ApplyCurrentFilter();
        }
        catch (Exception ex)
        {
            ToastService.Error($"Error loading data: {ex.Message}");
        }
        finally
        {
            LoadingService.Hide();
        }
    }

    private void OpenFilter()
    {
        dateFilterPopup.Show(filterFromDate, filterToDate, null, null, null);
    }

    private async Task ApplyFilter((DateTime? FromDate, DateTime? ToDate, string? JobType, int? vouchertype, string? OutstandingType) f)
    {
        filterFromDate = f.FromDate;
        filterToDate = f.ToDate;
        await ApplyCurrentFilter();
    }

    private async Task ApplyCurrentFilter()
    {
        try
        {
            var filteredPurchases = allPurchaseInvoices.AsEnumerable();

            if (filterFromDate.HasValue)
                filteredPurchases = filteredPurchases.Where(b => b.BillDate >= filterFromDate.Value);

            if (filterToDate.HasValue)
                filteredPurchases = filteredPurchases.Where(b => b.BillDate <= filterToDate.Value);

            var finalList = filteredPurchases.ToList();

            ClassifyPurchases(finalList);
            CalculateSummary(finalList);

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            ToastService.Error($"Error applying filter: {ex.Message}");
        }
    }

    private void ClassifyPurchases(List<Bill> purchases)
    {
        // B2B: Registered suppliers (with valid GSTIN)
        b2bPurchases = purchases
            .Where(b => !string.IsNullOrWhiteSpace(b.BillGstNo)
                     && b.BillGstNo.Length == 15
                     && (b.Vouchname?.Contains("DEBIT NOTE") != true)
                     && (b.Vouchname?.Contains("CREDIT NOTE") != true))
            .ToList();

        // B2BUR: Unregistered suppliers (without GSTIN or invalid GSTIN)
        b2burPurchases = purchases
            .Where(b => (string.IsNullOrWhiteSpace(b.BillGstNo) || b.BillGstNo.Length != 15)
                     && (b.Vouchname?.Contains("DEBIT NOTE") != true)
                     && (b.Vouchname?.Contains("CREDIT NOTE") != true)
                     && (b.Vouchname?.ToUpper().Contains("IMPORT") != true))
            .ToList();

        // IMPS: Import of Services
        importServices = purchases
            .Where(b => b.Vouchname?.ToUpper().Contains("IMPORT") == true
                     && b.Vouchname?.ToUpper().Contains("SERVICE") == true)
            .ToList();

        // IMPG: Import of Goods
        importGoods = purchases
            .Where(b => b.Vouchname?.ToUpper().Contains("IMPORT") == true
                     && b.Vouchname?.ToUpper().Contains("GOODS") == true)
            .ToList();

        // CDNR: Credit/Debit Notes from Registered Suppliers
        creditDebitNotesReg = purchases
            .Where(b => (b.Vouchname?.Contains("CREDIT NOTE") == true || b.Vouchname?.Contains("DEBIT NOTE") == true)
                     && !string.IsNullOrWhiteSpace(b.BillGstNo)
                     && b.BillGstNo.Length == 15)
            .ToList();

        // CDNUR: Credit/Debit Notes from Unregistered Suppliers
        creditDebitNotesUnreg = purchases
            .Where(b => (b.Vouchname?.Contains("CREDIT NOTE") == true || b.Vouchname?.Contains("DEBIT NOTE") == true)
                     && (string.IsNullOrWhiteSpace(b.BillGstNo) || b.BillGstNo.Length != 15))
            .ToList();

        // Calculate HSN summary combining all purchases
        var allPurchasesForHSN = new List<Bill>();
        allPurchasesForHSN.AddRange(b2bPurchases);
        allPurchasesForHSN.AddRange(b2burPurchases);
        allPurchasesForHSN.AddRange(importServices);
        allPurchasesForHSN.AddRange(importGoods);

        hsnSummary = CalculateHSNSummary(allPurchasesForHSN);
    }

    private void CalculateSummary(List<Bill> purchases)
    {
        var totalITC = (decimal)(purchases.Sum(b => b.BillIgst) + purchases.Sum(b => b.BillCgst) + purchases.Sum(b => b.BillSgst));

        summaryData = new GSTR2Summary
        {
            TotalPurchases = purchases.Count,
            TotalTaxableValue = (decimal)purchases.Sum(b => b.BillTotal),
            TotalCGST = (decimal)purchases.Sum(b => b.BillCgst),
            TotalSGST = (decimal)purchases.Sum(b => b.BillSgst),
            TotalIGST = (decimal)purchases.Sum(b => b.BillIgst),
            TotalITC = totalITC
        };
    }

