    // B2B Layout Management
    private string GetB2BColumnWidth(string fieldName)
    {
        var col = currentB2BLayout.FirstOrDefault(x => x.FieldName == fieldName);
        return $"{col?.Width ?? 100}px";
    }

    private bool GetB2BColumnVisibility(string fieldName)
    {
        var col = currentB2BLayout.FirstOrDefault(x => x.FieldName == fieldName);
        return col?.Visible ?? true;
    }

    private async Task LoadAvailableB2BLayouts()
    {
        availableB2BLayouts = await GridLayoutService.GetLayoutsByVoucherTypeAsync(B2B_VOUCHER_TYPE);
    }

    private async Task LoadDefaultB2BLayout()
    {
        var defaultLayout = await GridLayoutService.GetDefaultLayoutAsync(B2B_VOUCHER_TYPE);
        if (defaultLayout != null)
        {
            selectedB2BLayoutId = defaultLayout.GridLayoutId;
            await ApplyB2BLayout(defaultLayout);
        }
    }

    private async Task OnB2BLayoutSelectedAsync(int? layoutId)
    {
        selectedB2BLayoutId = layoutId;
        if (layoutId.HasValue)
        {
            var layout = await GridLayoutService.GetByIdAsync(layoutId.Value);
            if (layout != null) await ApplyB2BLayout(layout);
        }
        else
        {
            InitializeB2BColumns();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ApplyB2BLayout(GridLayoutDto layout)
    {
        if (!string.IsNullOrEmpty(layout.GridLayoutData))
        {
            var savedLayout = GridLayoutService.DeserializeColumnLayout(layout.GridLayoutData);
            if (savedLayout != null && savedLayout.Any())
            {
                currentB2BLayout = savedLayout.ToList();
                foreach (var saved in savedLayout)
                {
                    var existing = allB2BColumns.FirstOrDefault(x => x.FieldName == saved.FieldName);
                    if (existing != null)
                    {
                        existing.Visible = saved.Visible;
                        existing.Width = saved.Width;
                        existing.DisplayIndex = saved.DisplayIndex;
                    }
                }
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void ShowSaveB2BLayoutDialog()
    {
        if (selectedB2BLayoutId.HasValue)
        {
            var layout = availableB2BLayouts.FirstOrDefault(x => x.GridLayoutId == selectedB2BLayoutId.Value);
            if (layout != null)
            {
                newLayoutName = layout.GridLayoutName ?? "";
                isDefaultLayout = layout.GridLayoutDefault;
                isEditMode = true;
                dialogTitle = "Update Grid Layout";
                showB2BLayoutDialog = true;
                return;
            }
        }
        ShowNewB2BLayoutDialog();
    }

    private void ShowNewB2BLayoutDialog()
    {
        newLayoutName = "";
        isDefaultLayout = false;
        isEditMode = false;
        dialogTitle = "Create New Grid Layout";
        showB2BLayoutDialog = true;
    }

    private async Task SaveCurrentB2BLayout()
    {
        if (string.IsNullOrWhiteSpace(newLayoutName))
        {
            ToastService.Warning("Please enter a layout name.");
            return;
        }

        LoadingService.Show("Saving layout...");
        try
        {
            foreach (var col in allB2BColumns)
            {
                var current = currentB2BLayout.FirstOrDefault(c => c.FieldName == col.FieldName);
                if (current != null)
                {
                    current.Visible = col.Visible;
                    current.Width = col.Width;
                }
            }

            var configJson = GridLayoutService.SerializeColumnLayout(currentB2BLayout);
            bool success;

            if (isEditMode && selectedB2BLayoutId.HasValue)
            {
                success = await GridLayoutService.UpdateAsync(selectedB2BLayoutId.Value, new SaveGridLayoutRequest
                {
                    GridLayoutName = newLayoutName,
                    GridLayoutVoucherType = B2B_VOUCHER_TYPE,
                    GridLayoutData = configJson,
                    GridLayoutDefault = isDefaultLayout
                });
            }
            else
            {
                success = await GridLayoutService.CreateAsync(new SaveGridLayoutRequest
                {
                    GridLayoutName = newLayoutName,
                    GridLayoutVoucherType = B2B_VOUCHER_TYPE,
                    GridLayoutData = configJson,
                    GridLayoutDefault = isDefaultLayout
                });
            }

            if (success)
            {
                ToastService.Success($"Layout {(isEditMode ? "updated" : "created")} successfully!");
                await LoadAvailableB2BLayouts();
                CloseB2BLayoutDialog();
            }
            else
            {
                ToastService.Error("Failed to save layout.");
            }
        }
        finally
        {
            LoadingService.Hide();
        }
    }

    private async Task DeleteCurrentB2BLayout()
    {
        if (!selectedB2BLayoutId.HasValue) return;

        LoadingService.Show("Deleting layout...");
        try
        {
            var success = await GridLayoutService.DeleteAsync(selectedB2BLayoutId.Value);
            if (success)
            {
                ToastService.Success("Layout deleted successfully!");
                selectedB2BLayoutId = null;
                InitializeB2BColumns();
                await LoadAvailableB2BLayouts();
            }
        }
        finally
        {
            LoadingService.Hide();
        }
    }

    private void CloseB2BLayoutDialog()
    {
        showB2BLayoutDialog = false;
        newLayoutName = "";
        isDefaultLayout = false;
        isEditMode = false;
    }

    // Helper methods
    private async Task DownloadFile(string fileName, byte[] bytes, string contentType)
    {
        var base64 = Convert.ToBase64String(bytes);
        await JSRuntime.InvokeVoidAsync("downloadFileFromBase64", fileName, contentType, base64);
    }

    private async Task DownloadJsonFile(string fileName, string jsonContent)
    {
        var bytes = System.Text.Encoding.UTF8.GetBytes(jsonContent);
        await DownloadFile(fileName, bytes, "application/json");
    }

    private List<Gstr2TemplateService.HSNSummary> CalculateHSNSummary(List<Bill> bills)
    {
        if (bills == null || !bills.Any())
            return new List<Gstr2TemplateService.HSNSummary>();

        var allDetails = new List<BillDetailWithParent>();

        foreach (var bill in bills)
        {
            if (bill.BillDetails != null && bill.BillDetails.Any())
            {
                foreach (var detail in bill.BillDetails)
                {
                    allDetails.Add(new BillDetailWithParent
                    {
                        Detail = detail,
                        ParentBill = bill
                    });
                }
            }
            else
            {
                allDetails.Add(new BillDetailWithParent
                {
                    Detail = null,
                    ParentBill = bill
                });
            }
        }

        var summary = allDetails
            .GroupBy(item => new
            {
                HSN = GetHSNCode(item),
                Description = GetDescription(item),
                UQC = GetUQC(item)
            })
            .Select(g => new Gstr2TemplateService.HSNSummary
            {
                HSNCode = g.Key.HSN,
                Description = g.Key.Description,
                UQC = g.Key.UQC,
                TotalQuantity = g.Sum(item => GetQuantity(item)),
                TotalValue = g.Sum(item => GetValue(item)),
                TaxableValue = g.Sum(item => GetTaxableValue(item)),
                IGSTAmount = g.Sum(item => GetIGST(item)),
                CGSTAmount = g.Sum(item => GetCGST(item)),
                SGSTAmount = g.Sum(item => GetSGST(item))
            })
            .OrderBy(h => h.HSNCode)
            .ToList();

        return summary;
    }

    // Helper class for HSN calculation
    private class BillDetailWithParent
    {
        public BillDetail Detail { get; set; }
        public Bill ParentBill { get; set; }
    }

    // HSN extraction helpers
    private string GetHSNCode(BillDetailWithParent item)
    {
        if (item.Detail != null && !string.IsNullOrWhiteSpace(item.Detail.BillDetailHsnCode))
            return item.Detail.BillDetailHsnCode;
        return "9997";
    }

    private string GetDescription(BillDetailWithParent item)
    {
        if (item.Detail != null && !string.IsNullOrWhiteSpace(item.Detail.BillDetailRemarks))
            return item.Detail.BillDetailRemarks;
        return "Freight and Transport Services";
    }

    private string GetUQC(BillDetailWithParent item)
    {
        if (item.Detail != null && !string.IsNullOrWhiteSpace(item.Detail.BillDetailUnit))
            return item.Detail.BillDetailUnit;
        return "NOS";
    }

    private double GetQuantity(BillDetailWithParent item)
    {
        if (item.Detail != null && item.Detail.BillDetailQty > 0)
            return item.Detail.BillDetailQty;
        return 1;
    }

    private double GetValue(BillDetailWithParent item)
    {
        if (item.Detail != null)
            return item.Detail.BillDetailAmount;
        return (double)item.ParentBill.BillNetAmount;
    }

    private double GetTaxableValue(BillDetailWithParent item)
    {
        if (item.Detail != null)
            return item.Detail.BillDetailAmount;
        return (double)item.ParentBill.BillTotal;
    }

    private double GetIGST(BillDetailWithParent item)
    {
        if (item.Detail != null)
            return item.Detail.BillDetailIgst;
        return (double)item.ParentBill.BillIgst;
    }

    private double GetCGST(BillDetailWithParent item)
    {
        if (item.Detail != null)
            return item.Detail.BillDetailCgst;
        return (double)item.ParentBill.BillCgst;
    }

    private double GetSGST(BillDetailWithParent item)
    {
        if (item.Detail != null)
            return item.Detail.BillDetailSgst;
        return (double)item.ParentBill.BillSgst;
    }

