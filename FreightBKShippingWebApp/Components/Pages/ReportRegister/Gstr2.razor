    }

    private void InitializeB2BColumns()
    {
        allB2BColumns = new List<GridColumnLayout>
        {
            new() { FieldName = "BillGstNo", Caption = "Supplier GSTIN", Visible = true, Width = 180, DisplayIndex = 0 },
            new() { FieldName = "partyname", Caption = "Supplier Name", Visible = true, Width = 200, DisplayIndex = 1 },
            new() { FieldName = "BillNo", Caption = "Invoice No", Visible = true, Width = 150, DisplayIndex = 2 },
            new() { FieldName = "BillDate", Caption = "Invoice Date", Visible = true, Width = 120, DisplayIndex = 3 },
            new() { FieldName = "posname", Caption = "Place Of Supply", Visible = true, Width = 150, DisplayIndex = 4 },
            new() { FieldName = "BillTotal", Caption = "Taxable Value", Visible = true, Width = 120, DisplayIndex = 5 },
            new() { FieldName = "BillCgst", Caption = "CGST", Visible = true, Width = 100, DisplayIndex = 6 },
