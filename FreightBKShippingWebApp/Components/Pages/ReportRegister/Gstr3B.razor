                                       Click="OpenFilter"
                                       RenderStyle="ButtonRenderStyle.None"
                                       AdaptivePriority="2" />

                        <DxToolbarItem Text="Actions"
                                       RenderStyle="ButtonRenderStyle.None"
                                       AdaptivePriority="2">
