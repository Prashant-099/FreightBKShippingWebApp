    // ─── ITC & Liability Calculations ────────────────────────────────────────

    private void CalculateNetITC()
    {
        if (gstr3BData == null) return;

        netITC_IGST = gstr3BData.ITC_ImportGoods_IGST + gstr3BData.ITC_ImportServices_IGST +
                      gstr3BData.ITC_ReverseCharge_IGST + gstr3BData.ITC_ISD_IGST + gstr3BData.ITC_Others_IGST -
                      gstr3BData.ITC_Reversed_Rule42_43_IGST - gstr3BData.ITC_Reversed_Others_IGST;

        netITC_CGST = gstr3BData.ITC_ImportGoods_CGST + gstr3BData.ITC_ImportServices_CGST +
                      gstr3BData.ITC_ReverseCharge_CGST + gstr3BData.ITC_ISD_CGST + gstr3BData.ITC_Others_CGST -
                      gstr3BData.ITC_Reversed_Rule42_43_CGST - gstr3BData.ITC_Reversed_Others_CGST;

        netITC_SGST = gstr3BData.ITC_ImportGoods_SGST + gstr3BData.ITC_ImportServices_SGST +
                      gstr3BData.ITC_ReverseCharge_SGST + gstr3BData.ITC_ISD_SGST + gstr3BData.ITC_Others_SGST -
                      gstr3BData.ITC_Reversed_Rule42_43_SGST - gstr3BData.ITC_Reversed_Others_SGST;

        netITC_Cess = gstr3BData.ITC_ImportGoods_Cess + gstr3BData.ITC_ImportServices_Cess +
                      gstr3BData.ITC_ReverseCharge_Cess + gstr3BData.ITC_ISD_Cess + gstr3BData.ITC_Others_Cess -
                      gstr3BData.ITC_Reversed_Rule42_43_Cess - gstr3BData.ITC_Reversed_Others_Cess;
    }

    private void CalculateTaxLiability()
    {
        if (gstr3BData == null) return;

        totalTaxLiability_IGST = gstr3BData.OutwardTaxableSupplies_IGST +
                                  gstr3BData.OutwardZeroRated_IGST + gstr3BData.InwardReverseCharge_IGST;

        totalTaxLiability_CGST = gstr3BData.OutwardTaxableSupplies_CGST +
                                  gstr3BData.OutwardZeroRated_CGST + gstr3BData.InwardReverseCharge_CGST;

        totalTaxLiability_SGST = gstr3BData.OutwardTaxableSupplies_SGST +
                                  gstr3BData.OutwardZeroRated_SGST + gstr3BData.InwardReverseCharge_SGST;

        cashRequired_IGST = Math.Max(0, totalTaxLiability_IGST - netITC_IGST);
        cashRequired_CGST = Math.Max(0, totalTaxLiability_CGST - netITC_CGST);
        cashRequired_SGST = Math.Max(0, totalTaxLiability_SGST - netITC_SGST);

        totalCashRequired = cashRequired_IGST + cashRequired_CGST + cashRequired_SGST;
    }

    // ─── Export ──────────────────────────────────────────────────────────────

    private async Task ExportGSTR3BExcel()
    {
        try
        {
            if (filterFromDate == null || filterToDate == null)
        {
            ToastService.Warning("Please select return period.");
            return;
        }

            LoadingService.Show();

            string templatePath = Path.Combine(Environment.WebRootPath, "templates", "GSTR3B.xlsm");

            var excelBytes = TemplateService.GenerateFromTemplate(
                templatePath,
                gstin,
                legalName,
                filterFromDate?.ToString("dd-MM-yyyy"),
                filterToDate?.ToString("dd-MM-yyyy"),
                gstr3BData
            );

            string fileName = $"GSTR3B_{filterFromDate:yyyyMMdd}_{filterToDate:yyyyMMdd}.xlsm";
            await DownloadFile(fileName, excelBytes, "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
            ToastService.Success("GSTR-3B Excel exported successfully!");
        }
        catch (Exception ex)
        {
            ToastService.Error($"Export error: {ex.Message}");
        }
        finally
        {
            LoadingService.Hide();
        }
    }

    private async Task ExportGSTR3BJson()
    {
        try
        {
            var exportData = new
            {
                GSTIN = gstin,
                LegalName = legalName,
                ReturnPeriod = new { FromDate = filterFromDate, ToDate = filterToDate },
                GeneratedOn = DateTime.Now,
                Summary = new
                {
                    TotalTaxLiability = new { IGST = totalTaxLiability_IGST, CGST = totalTaxLiability_CGST, SGST = totalTaxLiability_SGST },
                    NetITC = new { IGST = netITC_IGST, CGST = netITC_CGST, SGST = netITC_SGST },
                    CashRequired = new { IGST = cashRequired_IGST, CGST = cashRequired_CGST, SGST = cashRequired_SGST, Total = totalCashRequired }
                },
                Data = gstr3BData
            };

            var json = System.Text.Json.JsonSerializer.Serialize(exportData,
                new System.Text.Json.JsonSerializerOptions { WriteIndented = true });

            string fileName = $"GSTR3B_{filterFromDate:yyyyMMdd}_{filterToDate:yyyyMMdd}.json";
            await DownloadJsonFile(fileName, json);
            ToastService.Success("JSON exported successfully!");
        }
        catch (Exception ex)
        {
            ToastService.Error($"JSON export error: {ex.Message}");
        }
    }

    private async Task DownloadFile(string fileName, byte[] bytes, string contentType)
    {
        var base64 = Convert.ToBase64String(bytes);
        await JSRuntime.InvokeVoidAsync("downloadFileFromBase64", fileName, contentType, base64);
    }

    private async Task DownloadJsonFile(string fileName, string jsonContent)
    {
        var bytes = System.Text.Encoding.UTF8.GetBytes(jsonContent);
        await DownloadFile(fileName, bytes, "application/json");
    }
