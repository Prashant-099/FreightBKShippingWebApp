<DateFilterPage @ref="dateFilterPopup" OnFilterApplied="ConfirmPeriod" />

@code {
    // Configuration
    private string gstin = "27AAAAA0000A1Z5";
    private string legalName = "Your Company Name";

    private bool showPeriodSelector = false;
    private int activeTab = 0;

    // Data
    private Gstr3BTemplateService.Gstr3BData gstr3BData;
    private List<Bill> salesInvoices = new();
    private List<Bill> purchaseInvoices = new();

    // Calculated values
    private decimal netITC_IGST = 0;
    private decimal netITC_CGST = 0;
    private decimal netITC_SGST = 0;
    private decimal netITC_Cess = 0;

    private decimal totalTaxLiability_IGST = 0;
    private decimal totalTaxLiability_CGST = 0;
    private decimal totalTaxLiability_SGST = 0;

    private decimal cashRequired_IGST = 0;
    private decimal cashRequired_CGST = 0;
    private decimal cashRequired_SGST = 0;
    private decimal totalCashRequired = 0;

    private DateTime? filterFromDate;
    private DateTime? filterToDate;
    private DateFilterPage dateFilterPopup;

    // Display data lists for grids
    private List<OutwardSupplyRow> outwardSuppliesDisplay = new();
    private List<EligibleItcRow> eligibleItcDisplay = new();
    private List<ExemptSupplyRow> exemptSuppliesDisplay = new();
    private List<TaxPaymentRow> taxPaymentDisplay = new();
    private List<InterestLateFeeRow> interestLateFeeDisplay = new();

    // ─── Row model classes ───────────────────────────────────────────────────

    public class OutwardSupplyRow
    {
        public string Key { get; set; }
        public string Nature { get; set; }
        public decimal TaxableValue { get; set; }
        public decimal IGST { get; set; }
        public decimal CGST { get; set; }
        public decimal SGST { get; set; }
        public decimal Cess { get; set; }
    }

    public class EligibleItcRow
    {
        public string Key { get; set; }
        public string Detail { get; set; }
        public decimal IGST { get; set; }
        public decimal CGST { get; set; }
        public decimal SGST { get; set; }
        public decimal Cess { get; set; }
    }

    public class ExemptSupplyRow
    {
        public string Key { get; set; }
        public string Nature { get; set; }
        public decimal Value { get; set; }
    }

    public class TaxPaymentRow
    {
        public string Key { get; set; }
        public string TaxType { get; set; }
        public decimal TaxLiability { get; set; }
        public decimal ITCAvailable { get; set; }
        public decimal CashRequired { get; set; }
    }

    public class InterestLateFeeRow
    {
        public string Key { get; set; }
        public string TaxType { get; set; }
        public decimal Interest { get; set; }
        public decimal LateFee { get; set; }
    }

    // ─── Lifecycle ───────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        // Load company details from settings if available
        var companies = await CompanyService.GetAllAsync();

        var company = companies.FirstOrDefault();

        if (company != null)
        {
            gstin = company.Gstin ?? ""; ;
            legalName = company.Name ?? ""; ;
        }
    }

    // ─── Filter ──────────────────────────────────────────────────────────────

    private void OpenFilter()
    {
        dateFilterPopup.Show(filterFromDate, filterToDate, null, null, null);
    }

    private async Task  ConfirmPeriod((DateTime? FromDate, DateTime? ToDate, string? JobType, int? vouchertype, string? OutstandingType) f)
    {
        filterFromDate = f.FromDate;
        filterToDate = f.ToDate;
        showPeriodSelector = false;
        await CalculateGSTR3B();
        StateHasChanged();
    }

    // ─── Calculate ───────────────────────────────────────────────────────────

    private async Task CalculateGSTR3B()
    {
        try
        {
            LoadingService.Show("Calculating GSTR-3B...");

            if (filterFromDate == null || filterToDate == null)
            {
                ToastService.Warning("Please select a date range first.");
                return;
            }

            var fromDate = filterFromDate.Value.Date;
            var toDate = filterToDate.Value.Date;

            var allVouchers = await VoucherService.GetAllAsync();

            var salesVoucherIds = allVouchers
                .Where(v => v.VoucherGroup == "SALES" || v.VoucherGroup == "CREDIT NOTE")
                .Select(v => v.VoucherId)
                .ToList();

            var purchaseVoucherIds = allVouchers
                .Where(v => v.VoucherGroup == "PURCHASE" || v.VoucherGroup == "DEBIT NOTE")
                .Select(v => v.VoucherId)
                .ToList();

            var allBills = await BillService.GetAllAsync();

            salesInvoices = allBills
                .Where(b =>
                    b.BillYearId == YearStatechangeService.SelectedYearId &&
                    salesVoucherIds.Contains(b.BillVoucherId) &&
                    b.BillDate.Date >= fromDate &&
                    b.BillDate.Date <= toDate)
                .ToList();

            purchaseInvoices = allBills
                .Where(b =>
                    b.BillYearId == YearStatechangeService.SelectedYearId &&
                    purchaseVoucherIds.Contains(b.BillVoucherId) &&
                    b.BillDate.Date >= fromDate &&
                    b.BillDate.Date <= toDate)
                .ToList();

            gstr3BData = TemplateService.CalculateFromGSTR1And2(salesInvoices, purchaseInvoices);

            CalculateNetITC();
            CalculateTaxLiability();
            BuildDisplayData();

            ToastService.Success($"GSTR-3B calculated from {fromDate:dd-MMM-yyyy} to {toDate:dd-MMM-yyyy}");
            StateHasChanged();
        }
        catch (Exception ex)
        {
            ToastService.Error($"Error calculating GSTR-3B: {ex.Message}");
        }
        finally
        {
            LoadingService.Hide();
        }
    }

    // ─── Build grid display data ──────────────────────────────────────────────

    private void BuildDisplayData()
    {
        if (gstr3BData == null) return;

        // 3.1 Outward Supplies
        outwardSuppliesDisplay = new List<OutwardSupplyRow>
        {
            new() { Key = "a", Nature = "(a) Outward taxable supplies (other than zero rated, nil rated and exempted)",
                    TaxableValue = gstr3BData.OutwardTaxableSupplies_TaxableValue,
                    IGST = gstr3BData.OutwardTaxableSupplies_IGST,
                    CGST = gstr3BData.OutwardTaxableSupplies_CGST,
                    SGST = gstr3BData.OutwardTaxableSupplies_SGST,
                    Cess = gstr3BData.OutwardTaxableSupplies_Cess },
            new() { Key = "b", Nature = "(b) Outward taxable supplies (zero rated)",
                    TaxableValue = gstr3BData.OutwardZeroRated_TaxableValue,
                    IGST = gstr3BData.OutwardZeroRated_IGST,
                    CGST = gstr3BData.OutwardZeroRated_CGST,
                    SGST = gstr3BData.OutwardZeroRated_SGST,
                    Cess = gstr3BData.OutwardZeroRated_Cess },
            new() { Key = "c", Nature = "(c) Other outward supplies (Nil rated, exempted)",
                    TaxableValue = gstr3BData.OutwardNilRated_TaxableValue },
            new() { Key = "d", Nature = "(d) Inward supplies liable to reverse charge",
                    TaxableValue = gstr3BData.InwardReverseCharge_TaxableValue,
