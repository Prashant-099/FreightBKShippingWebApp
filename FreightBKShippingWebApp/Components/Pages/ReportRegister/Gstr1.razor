    private async Task ValidateGSTR1Data()
    {
        try
        {
            LoadingService.Show("Validating data...");

            var errors = new List<string>();

            foreach (var inv in b2bInvoices)
            {
                if (string.IsNullOrWhiteSpace(inv.BillGstNo) || inv.BillGstNo.Length != 15)
                    errors.Add($"Invalid GSTIN for invoice {inv.BillNo}");
            }

            if (errors.Any())
            {
                validationStatus = new ValidationStatus
                {
                    CssClass = "error",
                    Icon = "x-circle",
                    Message = $"{errors.Count} errors"
                };
                ToastService.Error($"Validation failed: {errors.Count} errors");
            }
            else
            {
                validationStatus = new ValidationStatus
                {
                    CssClass = "success",
                    Icon = "check-circle",
                    Message = "Validated"
                };
                ToastService.Success("Data validation passed!");
            }

            await InvokeAsync(StateHasChanged);
        }
        finally
        {
            LoadingService.Hide();
        }
    }

    
