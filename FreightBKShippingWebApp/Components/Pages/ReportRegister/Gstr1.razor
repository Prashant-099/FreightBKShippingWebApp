<DateFilterPage @ref="dateFilterPopup" OnFilterApplied="ApplyFilter" />

@code {
    // Grid references
    private IGrid B2BGrid;
    private IGrid B2CLargeGrid;
    private IGrid B2CSmallGrid;
    private IGrid CreditDebitGrid;
    private IGrid HSNSummaryB2BGrid;
    private IGrid HSNSummaryB2CGrid;

    // Filter properties
    private DateTime? filterFromDate;
    private DateTime? filterToDate;
    private int activeTab = 0;
    private DateFilterPage dateFilterPopup;

    // Data lists
    private List<Bill> allSalesInvoices = new();
    private List<Bill> b2bInvoices = new();
    private List<Bill> b2cLargeInvoices = new();
    private List<Bill> b2cSmallInvoices = new();  // Added to store actual small invoices
    private List<Bill> creditDebitNotes = new();
    private List<GstTemplateService.B2CSmallSummary> b2cSmallSummary = new();
    private List<GstTemplateService.HSNSummary> hsnSummaryB2B = new();
    private List<GstTemplateService.HSNSummary> hsnSummaryB2C = new();
    private GSTR1Summary? summaryData;
    private ValidationStatus validationStatus;



    protected override async Task OnInitializedAsync()
    {
     
        await LoadData();
    }

   
    private async Task LoadData()
    {
        try
        {
            LoadingService.Show("Loading GSTR-1 data...");

            var salesVoucherIds = (await VoucherService.GetAllAsync())
                .Where(v => v.VoucherGroup == "SALES" || v.VoucherGroup == "CREDIT NOTE")
                .Select(v => v.VoucherId)
                .ToList();

            allSalesInvoices = (await BillService.GetAllAsync())
                .Where(b => b.BillYearId == YearStatechangeService.SelectedYearId
                         && salesVoucherIds.Contains(b.BillVoucherId))
                .ToList();

            await ApplyCurrentFilter();
        }
        catch (Exception ex)
        {
            ToastService.Error($"Error loading data: {ex.Message}");
        }
        finally
        {
            LoadingService.Hide();
        }
    }

    private void OpenFilter()
    {
        dateFilterPopup.Show(filterFromDate, filterToDate, null, null, null,null);
    }

    private async Task ApplyFilter((DateTime? FromDate, DateTime? ToDate, string? JobType, int? vouchertype, string? OutstandingType, int? Account) f)
    {
        filterFromDate = f.FromDate;
        filterToDate = f.ToDate;
        await ApplyCurrentFilter();
    }

    private async Task ApplyCurrentFilter()
    {
        try
        {
            var filteredInvoices = allSalesInvoices.AsEnumerable();

            if (filterFromDate.HasValue)
                filteredInvoices = filteredInvoices.Where(b => b.BillDate >= filterFromDate.Value);

            if (filterToDate.HasValue)
                filteredInvoices = filteredInvoices.Where(b => b.BillDate <= filterToDate.Value);

            var finalList = filteredInvoices.ToList();

            ClassifyInvoices(finalList);
            CalculateSummary(finalList);

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            ToastService.Error($"Error applying filter: {ex.Message}");
        }
    }

    private void ClassifyInvoices(List<Bill> invoices)
    {
        b2bInvoices = invoices
            .Where(b => !string.IsNullOrWhiteSpace(b.BillGstNo)
                     && b.BillGstNo.Length == 15
                     && (b.Vouchname?.Contains("CREDIT NOTE") != true))
            .ToList();

        b2cLargeInvoices = invoices
            .Where(b => (string.IsNullOrWhiteSpace(b.BillGstNo) || b.BillGstNo.Length != 15)
                     && b.BillNetAmount >= 250000
                     && (b.Vouchname?.Contains("CREDIT NOTE") != true))
            .ToList();

        b2cSmallInvoices = invoices
            .Where(b => (string.IsNullOrWhiteSpace(b.BillGstNo) || b.BillGstNo.Length != 15)
                     && b.BillNetAmount < 250000
                     && (b.Vouchname?.Contains("CREDIT NOTE") != true))
            .ToList();

        b2cSmallSummary = b2cSmallInvoices
            .GroupBy(b => b.posname ?? "Unknown")
            .Select(g => new GstTemplateService.B2CSmallSummary
            {
                PlaceOfSupply = g.Key,
                TaxableValue = (decimal)g.Sum(b => b.BillTotal),
                CGST = (decimal)g.Sum(b => b.BillCgst),
                SGST = (decimal)g.Sum(b => b.BillSgst),
                InvoiceValue = (decimal)g.Sum(b => b.BillNetAmount)
            })
            .ToList();

        creditDebitNotes = invoices
            .Where(b => b.Vouchname?.Contains("CREDIT NOTE") == true || b.Vouchname?.Contains("DEBIT NOTE") == true)
            .ToList();

        // Calculate HSN summaries
        hsnSummaryB2B = CalculateHSNSummary(b2bInvoices);
        hsnSummaryB2C = CalculateHSNSummary(b2cLargeInvoices.Concat(b2cSmallInvoices).ToList());
    }

    private void CalculateSummary(List<Bill> invoices)
    {
        summaryData = new GSTR1Summary
        {
            TotalInvoices = invoices.Count,
            TotalTaxableValue = (decimal)invoices.Sum(b => b.BillTotal),
            TotalCGST = (decimal)invoices.Sum(b => b.BillCgst),
            TotalSGST = (decimal)invoices.Sum(b => b.BillSgst),
            TotalIGST = (decimal)invoices.Sum(b => b.BillIgst),
            TotalInvoiceValue = (decimal)invoices.Sum(b => b.BillNetAmount)
        };
    }

