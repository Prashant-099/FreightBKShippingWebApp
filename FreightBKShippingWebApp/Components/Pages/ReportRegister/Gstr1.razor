    /// <summary>
    /// Calculate HSN summary from Bills using BillDetails
    /// </summary>
    private List<GstTemplateService.HSNSummary> CalculateHSNSummary(List<Bill> bills)
    {
        if (bills == null || !bills.Any())
            return new List<GstTemplateService.HSNSummary>();

        // Collect all BillDetails from all Bills
        var allDetails = new List<BillDetailWithParent>();

        foreach (var bill in bills)
        {
            if (bill.BillDetails != null && bill.BillDetails.Any())
            {
                // Use BillDetails for HSN data
                foreach (var detail in bill.BillDetails)
                {
                    allDetails.Add(new BillDetailWithParent
                    {
                        Detail = detail,
                        ParentBill = bill
                    });
                }
            }
            else
            {
                // If no BillDetails, create virtual detail from Bill
                allDetails.Add(new BillDetailWithParent
                {
                    Detail = null,
                    ParentBill = bill
                });
            }
        }

        // Group by HSN code and aggregate
        var summary = allDetails
            .GroupBy(item => new
            {
                HSN = GetHSNCode(item),
                Description = GetDescription(item),
                UQC = GetUQC(item)
            })
            .Select(g => new GstTemplateService.HSNSummary
            {
                HSNCode = g.Key.HSN,
                Description = g.Key.Description,
                UQC = g.Key.UQC,
                TotalQuantity = g.Sum(item => GetQuantity(item)),
                TotalValue = g.Sum(item => GetValue(item)),
                TaxableValue = g.Sum(item => GetTaxableValue(item)),
                IGSTAmount = g.Sum(item => GetIGST(item)),
                CGSTAmount = g.Sum(item => GetCGST(item)),
                SGSTAmount = g.Sum(item => GetSGST(item)),
                TaxRate = CalculateTaxRateFromGroup(g.First())
            })
            .OrderBy(h => h.HSNCode)
            .ToList();

        return summary;
    }

    // Helper class for HSN calculation
    private class BillDetailWithParent
    {
        public BillDetail Detail { get; set; }
        public Bill ParentBill { get; set; }
    }

    // HSN extraction helpers
    private string GetHSNCode(BillDetailWithParent item)
    {
        if (item.Detail != null && !string.IsNullOrWhiteSpace(item.Detail.BillDetailHsnCode))
            return item.Detail.BillDetailHsnCode;

        return "9997"; // Default: Transport services
    }

    private string GetDescription(BillDetailWithParent item)
    {
        if (item.Detail != null && !string.IsNullOrWhiteSpace(item.Detail.BillDetailRemarks))
            return item.Detail.BillDetailRemarks;

        return "Freight and Transport Services";
    }

    private string GetUQC(BillDetailWithParent item)
    {
        if (item.Detail != null && !string.IsNullOrWhiteSpace(item.Detail.BillDetailUnit))
            return item.Detail.BillDetailUnit;

        return "NOS";
    }

    private double GetQuantity(BillDetailWithParent item)
    {
        if (item.Detail != null && item.Detail.BillDetailQty > 0)
            return item.Detail.BillDetailQty;

        return 1;
    }

    private double GetValue(BillDetailWithParent item)
    {
        if (item.Detail != null)
            return item.Detail.BillDetailAmount;

        return (double)item.ParentBill.BillNetAmount;
    }

    private double GetTaxableValue(BillDetailWithParent item)
    {
        if (item.Detail != null)
            return item.Detail.BillDetailAmount;

        return (double)item.ParentBill.BillTotal;
    }

    private double GetIGST(BillDetailWithParent item)
    {
        if (item.Detail != null)
            return item.Detail.BillDetailIgst;

        return (double)item.ParentBill.BillIgst;
    }

    private double GetCGST(BillDetailWithParent item)
    {
        if (item.Detail != null)
            return item.Detail.BillDetailCgst;

        return (double)item.ParentBill.BillCgst;
    }

    private double GetSGST(BillDetailWithParent item)
    {
        if (item.Detail != null)
            return item.Detail.BillDetailSgst;

        return (double)item.ParentBill.BillSgst;
    }

    private double CalculateTaxRateFromGroup(BillDetailWithParent item)
    {
        var taxableValue = GetTaxableValue(item);
        if (taxableValue == 0) return 0;

        var igst = GetIGST(item);
        if (igst > 0)
            return Math.Round((igst / taxableValue) * 100, 2);

        var cgst = GetCGST(item);
        var sgst = GetSGST(item);
        if (cgst > 0 || sgst > 0)
        {
            var totalGst = cgst + sgst;
            return Math.Round((totalGst / taxableValue) * 100, 2);
        }

        return 0;
    }

