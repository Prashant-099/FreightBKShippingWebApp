    private async Task ApplyFilter((DateTime? FromDate, DateTime? ToDate, string? JobType, int? vouchertype, string? OutstandingType) f)
    {
        filterFromDate = f.FromDate;
        filterToDate = f.ToDate;
        await ApplyCurrentFilter();
    }

    private async Task ApplyCurrentFilter()
    {
        try
        {
            var filteredInvoices = allSalesInvoices.AsEnumerable();

            if (filterFromDate.HasValue)
                filteredInvoices = filteredInvoices.Where(b => b.BillDate >= filterFromDate.Value);

            if (filterToDate.HasValue)
                filteredInvoices = filteredInvoices.Where(b => b.BillDate <= filterToDate.Value);

            var finalList = filteredInvoices.ToList();

            ClassifyInvoices(finalList);
            CalculateSummary(finalList);

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            ToastService.Error($"Error applying filter: {ex.Message}");
        }
    }

    private void ClassifyInvoices(List<Bill> invoices)
    {
        b2bInvoices = invoices
            .Where(b => !string.IsNullOrWhiteSpace(b.BillGstNo)
                     && b.BillGstNo.Length == 15
                     && (b.Vouchname?.Contains("CREDIT NOTE") != true))
            .ToList();

        b2cLargeInvoices = invoices
            .Where(b => (string.IsNullOrWhiteSpace(b.BillGstNo) || b.BillGstNo.Length != 15)
                     && b.BillNetAmount >= 250000
                     && (b.Vouchname?.Contains("CREDIT NOTE") != true))
            .ToList();

        b2cSmallInvoices = invoices
            .Where(b => (string.IsNullOrWhiteSpace(b.BillGstNo) || b.BillGstNo.Length != 15)
                     && b.BillNetAmount < 250000
                     && (b.Vouchname?.Contains("CREDIT NOTE") != true))
            .ToList();

        b2cSmallSummary = b2cSmallInvoices
            .GroupBy(b => b.posname ?? "Unknown")
            .Select(g => new GstTemplateService.B2CSmallSummary
            {
                PlaceOfSupply = g.Key,
                TaxableValue = (decimal)g.Sum(b => b.BillTotal),
                CGST = (decimal)g.Sum(b => b.BillCgst),
                SGST = (decimal)g.Sum(b => b.BillSgst),
                InvoiceValue = (decimal)g.Sum(b => b.BillNetAmount)
            })
            .ToList();

        creditDebitNotes = invoices
            .Where(b => b.Vouchname?.Contains("CREDIT NOTE") == true || b.Vouchname?.Contains("DEBIT NOTE") == true)
            .ToList();

        // Calculate HSN summaries
        hsnSummaryB2B = CalculateHSNSummary(b2bInvoices);
        hsnSummaryB2C = CalculateHSNSummary(b2cLargeInvoices.Concat(b2cSmallInvoices).ToList());
    }

    private void CalculateSummary(List<Bill> invoices)
    {
        summaryData = new GSTR1Summary
        {
            TotalInvoices = invoices.Count,
            TotalTaxableValue = (decimal)invoices.Sum(b => b.BillTotal),
            TotalCGST = (decimal)invoices.Sum(b => b.BillCgst),
            TotalSGST = (decimal)invoices.Sum(b => b.BillSgst),
            TotalIGST = (decimal)invoices.Sum(b => b.BillIgst),
            TotalInvoiceValue = (decimal)invoices.Sum(b => b.BillNetAmount)
        };
    }

