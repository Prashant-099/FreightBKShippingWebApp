                .Select(v => v.VoucherId)
                .ToList();

            allSalesInvoices = (await BillService.GetAllAsync())
                .Where(b => b.BillYearId == YearStatechangeService.SelectedYearId
                         && salesVoucherIds.Contains(b.BillVoucherId))
