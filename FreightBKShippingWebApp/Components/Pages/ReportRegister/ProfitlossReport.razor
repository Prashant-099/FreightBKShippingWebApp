@page "/jobprofitloss"
@using FreightBKShippingWebApp.Model
@using FreightBKShippingWebApp.Services
@using System.Text.Json
@inject JobService JobService
@inject BillService BillService
@inject ToasteService ToastService
@inject LoadingService LoadingService
@inject YearStatechangeService YearStatechangeService
@inject GridLayoutService GridLayoutService
@inject IJSRuntime JS

<style>
    .grid-size {
        max-height: 570px;
    }

    .layout-combobox {
        border-radius: 6px;
        width: 185px;
    }

    .toolbar-title {
        display: flex;
        align-items: center;
    }

    /* Print section ko hide rakho normally */
    .print-only-section {
        display: none;
    }

    /* Print time pe sirf print section dikhao */
    @@media print {
        body * {
            visibility: hidden;
        }

        .print-only-section,
        .print-only-section * {
            visibility: visible;
        }

        .print-only-section {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            display: block !important;
        }

        @@page {
            size: A4 landscape;
            margin: 1cm;
        }
    }

    /* Print table styling */
    .print-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
        font-size: 11px;
    }

        .print-table th,
        .print-table td {
            border: 1px solid #000;
            padding: 6px;
            text-align: left;
        }

        .print-table th {
            background-color: #f0f0f0;
            font-weight: bold;
        }

        .print-table tfoot td {
            font-weight: bold;
            background-color: #e8e8e8;
        }

    .print-header {
        text-align: center;
        margin-bottom: 20px;
    }

        .print-header h2 {
            margin: 5px 0;
        }

    .print-info {
        margin-bottom: 15px;
        font-size: 14px;
    }

    /* Profit/Loss color indicators */
    .profit-cell {
        color: green;
        font-weight: bold;
    }

    .loss-cell {
        color: red;
        font-weight: bold;
    }
</style>

<div class="px-3 py-3">
    <DxGrid TItem="JobProfitLoss"
            Data="@profitLossList"
            @ref="MyGrid"
            KeyFieldName="JobId"
            ShowSearchBox="true"
            PageSize="100"
            PageSizeSelectorVisible="false"
            ShowGroupPanel="true"
            FilterMenuButtonDisplayMode="GridFilterMenuButtonDisplayMode.Always"
            FocusedRowEnabled="true"
            ColumnResizeMode="GridColumnResizeMode.NextColumn"
            CssClass="grid-size"
            RowDoubleClick="OnRowDoubleClick"
            AllowSelectRowByClick="true"
            AllowColumnReorder="true">

        <ToolbarTemplate Context="gridContext">
            <DxToolbar>
                <!-- Title -->
                <DxToolbarItem Alignment="ToolbarItemAlignment.Left">
                    <Template Context="t">
                        <div class="toolbar-title">
                            <i class="bi bi-graph-up me-2"></i>
                            <span class="fs-5">Job-wise Profit & Loss</span>
                        </div>
                    </Template>
                </DxToolbarItem>

                <DxToolbarItem Text="Filter"
                               IconCssClass="bi bi-funnel-fill"
                               Click="OpenDateFilter"
                               RenderStyle="ButtonRenderStyle.None"
                               AdaptivePriority="2" />

                <DxToolbarItem Text="Export"
                               RenderStyle="ButtonRenderStyle.None"
                               AdaptivePriority="2">
                    <Items>
                        <DxToolbarItem Text="Excel"
                                       RenderStyle="ButtonRenderStyle.None"
                                       IconCssClass="bi bi-file-earmark-spreadsheet"
                                       Click="ExportXlsx" />
                        <DxToolbarItem Text="PDF"
                                       RenderStyle="ButtonRenderStyle.None"
                                       IconCssClass="bi bi-printer"
                                       Click="PrintGridPage" />
                    </Items>
                </DxToolbarItem>

                <DxToolbarItem Alignment="ToolbarItemAlignment.Right"
                               RenderStyle="ButtonRenderStyle.Secondary"
                               IconCssClass="bi bi-gear-wide-connected"
                               Click="ShowLayoutPopup" />

            </DxToolbar>
        </ToolbarTemplate>

        <Columns>

            <DxGridDataColumn FieldName="JobId"
                              Caption="ID"
                              SortIndex="0"
                              SortOrder="GridColumnSortOrder.Descending"
                              Width="@(layoutManager?.GetColumnWidth("JobId") ?? "80px")"
                              Visible="@(layoutManager?.GetColumnVisibility("JobId") ?? false)" />

            <DxGridDataColumn FieldName="BranchName"
                              Caption="Branch"
                              Width="@(layoutManager?.GetColumnWidth("BranchName") ?? "120px")"
                              Visible="@(layoutManager?.GetColumnVisibility("BranchName") ?? true)" />

            <DxGridDataColumn FieldName="JobNo"
                              Caption="Job No"
                              Width="@(layoutManager?.GetColumnWidth("JobNo") ?? "130px")"
                              Visible="@(layoutManager?.GetColumnVisibility("JobNo") ?? true)" />

            <DxGridDataColumn FieldName="JobDate"
                              Caption="Job Date"
                              DisplayFormat="dd/MM/yyyy"
                              Width="@(layoutManager?.GetColumnWidth("JobDate") ?? "120px")"
                              Visible="@(layoutManager?.GetColumnVisibility("JobDate") ?? true)" />

            <DxGridDataColumn FieldName="JobType"
                              Caption="Job Type"
                              Width="@(layoutManager?.GetColumnWidth("JobType") ?? "100px")"
                              Visible="@(layoutManager?.GetColumnVisibility("JobType") ?? true)" />

            <DxGridDataColumn FieldName="PartyName"
                              Caption="Customer"
                              Width="@(layoutManager?.GetColumnWidth("PartyName") ?? "350px")"
                              Visible="@(layoutManager?.GetColumnVisibility("PartyName") ?? true)" />

            <DxGridDataColumn FieldName="JobBlNo"
                              Caption="BL/BE No"
                              Width="@(layoutManager?.GetColumnWidth("JobBlNo") ?? "140px")"
                              Visible="@(layoutManager?.GetColumnVisibility("JobBlNo") ?? true)" />

            <DxGridDataColumn FieldName="TotalRevenue"
                              Caption="Total Revenue"
                              DisplayFormat="N2"
                              Width="@(layoutManager?.GetColumnWidth("TotalRevenue") ?? "140px")"
                              Visible="@(layoutManager?.GetColumnVisibility("TotalRevenue") ?? true)" />

            <DxGridDataColumn FieldName="TotalExpense"
                              Caption="Total Expense"
                              DisplayFormat="N2"
                              Width="@(layoutManager?.GetColumnWidth("TotalExpense") ?? "140px")"
                              Visible="@(layoutManager?.GetColumnVisibility("TotalExpense") ?? true)" />

            <DxGridDataColumn FieldName="ProfitLoss"
                              Caption="Profit / Loss"
                              DisplayFormat="N2"
                              Width="@(layoutManager?.GetColumnWidth("ProfitLoss") ?? "150px")"
                              Visible="@(layoutManager?.GetColumnVisibility("ProfitLoss") ?? true)">
                <CellDisplayTemplate Context="cellContext">
                    @{
                        var profitLoss = cellContext.Value is decimal d ? d : 0m;
                        var cssClass = profitLoss >= 0 ? "profit-cell" : "loss-cell";
                    }
                    <span class="@cssClass">@profitLoss.ToString("N2")</span>
                </CellDisplayTemplate>
            </DxGridDataColumn>

            <DxGridDataColumn FieldName="ProfitMargin"
                              Caption="Profit Margin %"
                              DisplayFormat="N2"
                              Width="@(layoutManager?.GetColumnWidth("ProfitMargin") ?? "140px")"
                              Visible="@(layoutManager?.GetColumnVisibility("ProfitMargin") ?? true)">
                <CellDisplayTemplate Context="cellContext">
                    @{
                        var margin = cellContext.Value is decimal m ? m : 0m;
                        var cssClass = margin >= 0 ? "profit-cell" : "loss-cell";
                    }
                    <span class="@cssClass">@margin.ToString("N2")%</span>
                </CellDisplayTemplate>
            </DxGridDataColumn>

            <DxGridDataColumn FieldName="SalesInvoiceCount"
                              Caption="Sales Count"
                              Width="@(layoutManager?.GetColumnWidth("SalesInvoiceCount") ?? "110px")"
                              Visible="@(layoutManager?.GetColumnVisibility("SalesInvoiceCount") ?? true)" />

            <DxGridDataColumn FieldName="PurchaseInvoiceCount"
                              Caption="Purchase Count"
                              Width="@(layoutManager?.GetColumnWidth("PurchaseInvoiceCount") ?? "130px")"
                              Visible="@(layoutManager?.GetColumnVisibility("PurchaseInvoiceCount") ?? true)" />

        </Columns>

        <TotalSummary>
            <DxGridSummaryItem SummaryType="GridSummaryItemType.Count" FieldName="JobId" />
            <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum"
                               FieldName="TotalRevenue"
                               DisplayFormat="Total Revenue: {0:N2}" />
            <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum"
                               FieldName="TotalExpense"
                               DisplayFormat="Total Expense: {0:N2}" />
            <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum"
                               FieldName="ProfitLoss"
                               DisplayFormat="Total Profit/Loss: {0:N2}" />
        </TotalSummary>
    </DxGrid>
</div>

<!-- PRINT ONLY SECTION -->
<div class="print-only-section" id="printProfitLossSection">
    <div class="print-header">
        <h2>Job-wise Profit & Loss Report</h2>
        <div class="print-info">
            <strong>From:</strong> @FromDate?.ToString("dd/MM/yyyy") &nbsp;&nbsp;
            <strong>To:</strong> @ToDate?.ToString("dd/MM/yyyy") &nbsp;&nbsp;
            @if (!string.IsNullOrEmpty(SelectedJobType))
            {
                <strong>Job Type:</strong> 
                @SelectedJobType
               
            }
            <strong>Print Date:</strong> @DateTime.Now.ToString("dd/MM/yyyy hh:mm tt")
        </div>
    </div>

    <table class="print-table">
        <thead>
            <tr>
                <th>Branch</th>
                <th>Job No</th>
                <th>Job Date</th>
                <th>Job Type</th>
                <th>Customer</th>
                <th>BL/BE No</th>
                <th>Revenue</th>
                <th>Expense</th>
                <th>Profit/Loss</th>
                <th>Margin %</th>
            </tr>
        </thead>

        <tbody>
            @if (profitLossList != null && profitLossList.Any())
            {
                @foreach (var item in profitLossList)
                {
                    <tr>
                        <td>@item.BranchName</td>
                        <td>@item.JobNo</td>
                        <td>@item.JobDate.ToString("dd/MM/yyyy")</td>
                        <td>@item.JobType</td>
                        <td>@item.PartyName</td>
                        <td>@item.JobBlNo</td>
                        <td>@item.TotalRevenue.ToString("N2")</td>
                        <td>@item.TotalExpense.ToString("N2")</td>
                        <td style="@(item.ProfitLoss >= 0 ? "color:green" : "color:red")">
                            @item.ProfitLoss.ToString("N2")
                        </td>
                        <td style="@(item.ProfitMargin >= 0 ? "color:green" : "color:red")">
                            @item.ProfitMargin.ToString("N2")%
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="10" style="text-align:center">No records available</td>
                </tr>
            }
        </tbody>

        <tfoot>
            <tr>
                <td colspan="6"><strong>Total:</strong></td>
                <td><strong>@profitLossList?.Sum(p => p.TotalRevenue).ToString("N2")</strong></td>
                <td><strong>@profitLossList?.Sum(p => p.TotalExpense).ToString("N2")</strong></td>
                <td style="@(profitLossList?.Sum(p => p.ProfitLoss) >= 0 ? "color:green" : "color:red")">
                    <strong>@profitLossList?.Sum(p => p.ProfitLoss).ToString("N2")</strong>
                </td>
                <td></td>
            </tr>
        </tfoot>
    </table>
</div>


@if (showInvoicePopup && selectedJob != null)
{
    <div class="modal fade show d-block"
         style="background-color:rgba(0,0,0,0.5); z-index:1050;">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">

                <!-- Header -->
                <div class="modal-header">
                    <h5 class="modal-title">
                        Job Invoices – @selectedJob.JobNo
                    </h5>
                    <button class="btn-close"
                            @onclick="CloseInvoicePopup"></button>
                </div>

                <!-- Body -->
                <div class="modal-body">

                    <!-- SALES -->
                    <h6 class="text-success mb-2">Sales Invoices</h6>
                    <DxGrid Data="@selectedSalesBills"
                            PageSize="5"
                            ShowSearchBox="true">
                        <Columns>
                            <DxGridDataColumn FieldName="BillNo" Caption="Invoice No" />
                            <DxGridDataColumn FieldName="BillDate" Caption="Date" DisplayFormat="dd/MM/yyyy" />
                            <DxGridDataColumn FieldName="BillNetAmount" Caption="Amount" DisplayFormat="N2" />
                        </Columns>
                    </DxGrid>

                    <hr />

                    <!-- PURCHASE -->
                    <h6 class="text-danger mb-2">Purchase Invoices</h6>
                    <DxGrid Data="@selectedPurchaseBills"
                            PageSize="5"
                            ShowSearchBox="true">
                        <Columns>
                            <DxGridDataColumn FieldName="BillNo" Caption="Invoice No" />
                            <DxGridDataColumn FieldName="BillDate" Caption="Date" DisplayFormat="dd/MM/yyyy" />
                            <DxGridDataColumn FieldName="BillNetAmount" Caption="Amount" DisplayFormat="N2" />
                        </Columns>
                    </DxGrid>

                </div>

                <!-- Footer -->
                <div class="modal-footer">
                    <button class="btn btn-secondary"
                            @onclick="CloseInvoicePopup">
                        Close
                    </button>
                </div>

            </div>
        </div>
    </div>
}

<DateFilterPage @ref="dateFilterPopup" ShowJobTypeFilter="true" OnFilterApplied="HandleFilterApplied" />
<ConfirmationDialog />

<GridLayoutpPopup @ref="layoutManager"
                  VoucherType="JobProfitLoss"
                  Columns="@allColumns"
                  OnLayoutChanged="HandleLayoutChanged" />

@code {
    // Job Profit Loss Model
    public class JobProfitLoss
    {
        public int JobId { get; set; }
        public string BranchName { get; set; }
        public string JobNo { get; set; }
        public DateTime JobDate { get; set; }
        public string JobType { get; set; }
        public string PartyName { get; set; }
        public string JobBlNo { get; set; }
        public decimal TotalRevenue { get; set; }
        public decimal TotalExpense { get; set; }
        public decimal ProfitLoss { get; set; }
        public decimal ProfitMargin { get; set; }
        public int SalesInvoiceCount { get; set; }
        public int PurchaseInvoiceCount { get; set; }
    }

    private async Task ExportXlsx()
    {
        if (profitLossList == null || !profitLossList.Any())
        {
            ToastService.Warning("No data to export.");
            return;
        }
        await MyGrid.ExportToXlsxAsync("JobProfitLoss.xlsx");
    }

    private async Task PrintGridPage()
    {
        if (profitLossList == null || !profitLossList.Any())
        {
            ToastService.Warning("No data to print.");
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("window.print");
        }
        catch (Exception ex)
        {
            ToastService.Error($"Print error: {ex.Message}");
        }
    }

    private IGrid MyGrid;
    private List<JobProfitLoss> profitLossList = new();
    private List<JobProfitLoss> allProfitLoss = new();
    private List<Job> allJobs = new();
    private List<Bill> allBills = new();

    //row doubleclick data
    private bool showInvoicePopup;
    private JobProfitLoss? selectedJob;

    private List<Bill> selectedSalesBills = new();
    private List<Bill> selectedPurchaseBills = new();

    // Filter properties
    private DateTime? FromDate;
    private DateTime? ToDate;
    private string SelectedJobType;

    // Grid Layout Management
    private GridLayoutpPopup? layoutManager;
    private List<GridColumnLayout> allColumns = [];
    private async void ShowLayoutPopup()
    {
        await InvokeAsync(() =>
        {
            layoutManager?.ShowPopup();
        });
    }
    private async Task HandleLayoutChanged(List<GridColumnLayout> updatedLayout)
    {
        allColumns = updatedLayout;
        // Force the grid to re-render with new layout
        await InvokeAsync(StateHasChanged);
    }

    private DateFilterPage dateFilterPopup;
   
    private void OnRowDoubleClick(GridRowClickEventArgs e)
    {
        if (e.VisibleIndex < 0)
            return;

        var job = (JobProfitLoss)e.Grid.GetDataItem(e.VisibleIndex);

        if (job == null)
            return;

        selectedJob = job;

        selectedSalesBills = allBills
            .Where(b => b.BillJobId == selectedJob.JobId &&
                        b.BillType.Equals("SALES", StringComparison.OrdinalIgnoreCase))
            .ToList();

        selectedPurchaseBills = allBills
            .Where(b => b.BillJobId == selectedJob.JobId &&
                        b.BillType.Equals("PURCHASE", StringComparison.OrdinalIgnoreCase))
            .ToList();

        showInvoicePopup = true;
    }
    private void CloseInvoicePopup()
    {
        showInvoicePopup = false;
        selectedSalesBills.Clear();
        selectedPurchaseBills.Clear();
    }

    private void OpenDateFilter()
    {
        dateFilterPopup.Show(FromDate, ToDate, SelectedJobType, null,null);
    }

    private async Task HandleFilterApplied((DateTime? FromDate, DateTime? ToDate, string? JobType, int? SelectedVoucherType, string? OutstandingType) f)
    {
        FromDate = f.FromDate;
        ToDate = f.ToDate;
        SelectedJobType = f.JobType;
        OnSearch();
    }

    protected override async Task OnInitializedAsync()
    {
        InitializeColumns();
        await LoadAllData();
    }

    private void InitializeColumns()
    {
        allColumns = new List<GridColumnLayout>
        {
            new() { FieldName = "JobId", Caption = "ID", Visible = false, Width = 80, DisplayIndex = 0 },
            new() { FieldName = "BranchName", Caption = "Branch", Visible = true, Width = 120, DisplayIndex = 1 },
            new() { FieldName = "JobNo", Caption = "Job No", Visible = true, Width = 130, DisplayIndex = 2 },
            new() { FieldName = "JobDate", Caption = "Job Date", Visible = true, Width = 120, DisplayIndex = 3 },
            new() { FieldName = "JobType", Caption = "Job Type", Visible = true, Width = 100, DisplayIndex = 4 },
            new() { FieldName = "PartyName", Caption = "Customer", Visible = true, Width = 350, DisplayIndex = 5 },
            new() { FieldName = "JobBlNo", Caption = "BL/BE No", Visible = true, Width = 130, DisplayIndex = 6 },
            new() { FieldName = "TotalRevenue", Caption = "Total Revenue", Visible = true, Width = 140, DisplayIndex = 7 },
            new() { FieldName = "TotalExpense", Caption = "Total Expense", Visible = true, Width = 140, DisplayIndex = 8 },
            new() { FieldName = "ProfitLoss", Caption = "Profit / Loss", Visible = true, Width = 140, DisplayIndex = 9 },
            new() { FieldName = "ProfitMargin", Caption = "Profit Margin %", Visible = true, Width = 140, DisplayIndex = 10 },
            new() { FieldName = "SalesInvoiceCount", Caption = "Sales Count", Visible = true, Width = 110, DisplayIndex = 11 },
            new() { FieldName = "PurchaseInvoiceCount", Caption = "Purchase Count", Visible = true, Width = 130, DisplayIndex = 12 }
        };
        
    }

    private async Task LoadAllData()
    {
        try
        {
            LoadingService.Show("Loading profit & loss data...");

            // Load all jobs and bills
            allJobs = (await JobService.GetAllAsync())
                .Where(j => j.JobYearId == YearStatechangeService.SelectedYearId.ToString())
                .ToList();

            allBills = (await BillService.GetAllAsync())
                .Where(b => b.BillYearId == YearStatechangeService.SelectedYearId)
                .ToList();

            // Calculate profit/loss for each job
            CalculateProfitLoss();
        }
        catch (Exception ex)
        {
            ToastService.Error($"Failed to load data: {ex.Message}");
        }
        finally
        {
            LoadingService.Hide();
        }
    }

    private void CalculateProfitLoss()
    {
        allProfitLoss = allJobs.Select(job =>
        {
            // Get all bills for this job
            var jobBills = allBills.Where(b => b.BillJobId == job.JobId).ToList();

            // Calculate revenue (SALES bills)
            var salesBills = jobBills.Where(b => 
                string.Equals(b.BillType, "SALES", StringComparison.OrdinalIgnoreCase)).ToList();
            var totalRevenue = salesBills.Sum(b => b.BillNetAmount);

            // Calculate expense (PURCHASE bills)
            var purchaseBills = jobBills.Where(b => 
                string.Equals(b.BillType, "PURCHASE", StringComparison.OrdinalIgnoreCase)).ToList();
            var totalExpense = purchaseBills.Sum(b => b.BillNetAmount);

            // Calculate profit/loss
            var profitLoss = totalRevenue - totalExpense;

            // Calculate profit margin %
            var profitMargin = totalRevenue > 0 ? (profitLoss / totalRevenue) * 100 : 0;

            return new JobProfitLoss
            {
                JobId = job.JobId,
                BranchName = job.BranchName ?? "",
                JobNo = job.JobNo ?? "",
                JobDate = job.JobDate,
                JobType = job.JobType ?? "",
                PartyName = job.Partyname ?? "",
                JobBlNo = job.JobBlNo ?? "",
                TotalRevenue = (decimal)totalRevenue,
                TotalExpense = (decimal)totalExpense,
                ProfitLoss = (decimal)profitLoss,
                ProfitMargin = (decimal)profitMargin,
                SalesInvoiceCount = salesBills.Count,
                PurchaseInvoiceCount = purchaseBills.Count
            };
        }).ToList();

        profitLossList = allProfitLoss;
    }

    private async Task OnSearch()
    {
        profitLossList = allProfitLoss;

        // Apply date filter
        if (FromDate.HasValue)
        {
            profitLossList = profitLossList.Where(p => p.JobDate.Date >= FromDate.Value.Date).ToList();
        }

        if (ToDate.HasValue)
        {
            profitLossList = profitLossList.Where(p => p.JobDate.Date <= ToDate.Value.Date).ToList();
        }

        // Apply job type filter
        if (!string.IsNullOrEmpty(SelectedJobType))
        {
            profitLossList = profitLossList.Where(p => 
                p.JobType.Equals(SelectedJobType, StringComparison.OrdinalIgnoreCase)).ToList();
        }

        if (profitLossList.Count == 0)
        {
            ToastService.Warning("No data found matching the criteria.");
        }
        else
        {
            ToastService.Success($"Found {profitLossList.Count} job(s).");
        }

        await InvokeAsync(StateHasChanged);
    }

   

    
}
