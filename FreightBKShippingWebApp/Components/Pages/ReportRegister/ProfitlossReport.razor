@page "/jobprofitloss"
@using FreightBKShippingWebApp.Model
@using FreightBKShippingWebApp.Services
@using System.Text.Json
@inject JobService JobService
@inject BillService BillService
@inject ToasteService ToastService
@inject LoadingService LoadingService
@inject YearStatechangeService YearStatechangeService
@inject GridLayoutService GridLayoutService
@inject IJSRuntime JS

<style>
    .grid-size {
        max-height: 570px;
    }

    .layout-combobox {
        border-radius: 6px;
        width: 185px;
    }

    .toolbar-title {
        display: flex;
        align-items: center;
    }

    /* Print section ko hide rakho normally */
    .print-only-section {
        display: none;
    }

    /* Print time pe sirf print section dikhao */
    @@media print {
        body * {
            visibility: hidden;
        }

        .print-only-section,
        .print-only-section * {
            visibility: visible;
        }

        .print-only-section {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            display: block !important;
        }

        @@page {
            size: A4 landscape;
            margin: 1cm;
        }
    }

    /* Print table styling */
    .print-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
        font-size: 11px;
    }

        .print-table th,
        .print-table td {
            border: 1px solid #000;
            padding: 6px;
            text-align: left;
        }

        .print-table th {
            background-color: #f0f0f0;
            font-weight: bold;
        }

        .print-table tfoot td {
            font-weight: bold;
            background-color: #e8e8e8;
        }

    .print-header {
        text-align: center;
        margin-bottom: 20px;
    }

        .print-header h2 {
            margin: 5px 0;
        }

    .print-info {
        margin-bottom: 15px;
        font-size: 14px;
    }

    /* Profit/Loss color indicators */
    .profit-cell {
        color: green;
        font-weight: bold;
    }

    .loss-cell {
        color: red;
        font-weight: bold;
    }
</style>

<div class="px-3 py-3 ">
    <DxGrid TItem="JobProfitLoss"
            Data="@profitLossList"
            @ref="MyGrid"
            KeyFieldName="JobId"
            ShowSearchBox="true"
            PageSize="100"
            PageSizeSelectorVisible="false"
            ShowGroupPanel="true"
            FilterMenuButtonDisplayMode="GridFilterMenuButtonDisplayMode.Always"
            FocusedRowEnabled="true"
            ColumnResizeMode="GridColumnResizeMode.NextColumn"
            CssClass="grid-size"
            RowDoubleClick="OnRowDoubleClick"
            AllowSelectRowByClick="true"
            AllowColumnReorder="true">

        <ToolbarTemplate Context="gridContext">
            <DxToolbar>
                <!-- Title -->
                <DxToolbarItem Alignment="ToolbarItemAlignment.Left">
                    <Template Context="t">
                        <div class="toolbar-title">
                            <i class="bi bi-graph-up me-2"></i>
                            <span class="fs-5">Job-wise Profit & Loss</span>
                        </div>
                    </Template>
                </DxToolbarItem>

                <DxToolbarItem Text="Filter"
                               IconCssClass="bi bi-funnel-fill"
                               Click="OpenDateFilter"
                               RenderStyle="ButtonRenderStyle.None"
                               AdaptivePriority="2" />

                <DxToolbarItem Text="Export"
                               RenderStyle="ButtonRenderStyle.None"
                               AdaptivePriority="2">
                    <Items>
                        <DxToolbarItem Text="Excel"
                                       RenderStyle="ButtonRenderStyle.None"
                                       IconCssClass="bi bi-file-earmark-spreadsheet"
                                       Click="ExportXlsx" />
                        <DxToolbarItem Text="PDF"
                                       RenderStyle="ButtonRenderStyle.None"
                                       IconCssClass="bi bi-printer"
                                       Click="PrintGridPage" />
                    </Items>
                </DxToolbarItem>

                <!-- Layout Selector -->
                <DxToolbarItem IconCssClass="bi bi-gear-wide-connected"
                               Alignment="ToolbarItemAlignment.Right"
                               AdaptivePriority="1">
                    <Template Context="ctx">
                        <DxComboBox Data="@availableLayouts"
                                    Value="@selectedLayoutId"
                                    ValueExpression="@(() => selectedLayoutId)"
                                    ValueChanged="@((int? value) => OnLayoutSelectedAsync(value))"
                                    ValueFieldName="GridLayoutId"
                                    TextFieldName="GridLayoutName"
                                    NullText="Default View"
                                    ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                    CssClass="layout-combobox" />
                    </Template>
                </DxToolbarItem>

                <!-- Layout Management -->
                <DxToolbarItem Context="cfdr"
                               Alignment="ToolbarItemAlignment.Right"
                               RenderStyleMode="ToolbarItemRenderStyleMode.Contained"
                               RenderStyle="ButtonRenderStyle.Secondary"
                               IconCssClass="bi bi-gear-wide-connected"
                               AdaptivePriority="1">
                    <Items>
                        <DxToolbarItem Text="Save Current Layout"
                                       RenderStyle="ButtonRenderStyle.Primary"
                                       IconCssClass="bi bi-floppy"
                                       Click="ShowSaveLayoutDialog" />

                        <DxToolbarItem Text="Create New Layout"
                                       RenderStyle="ButtonRenderStyle.Success"
                                       IconCssClass="bi bi-plus-square"
                                       Click="ShowNewLayoutDialog" />

                        @if (selectedLayoutId.HasValue)
                        {
                            <DxToolbarItem Text="Delete Current Layout"
                                           RenderStyle="ButtonRenderStyle.Danger"
                                           IconCssClass="bi bi-trash"
                                           Click="DeleteCurrentLayout" />
                        }
                    </Items>
                </DxToolbarItem>
            </DxToolbar>
        </ToolbarTemplate>

        <Columns>
            <DxGridDataColumn FieldName="JobId"
                              Caption="ID"
                              Visible="@GetColumnVisibility("JobId")"
                              Width="@GetColumnWidth("JobId")"
                              SortIndex="0"
                              SortOrder="GridColumnSortOrder.Descending" />

            <DxGridDataColumn FieldName="BranchName"
                              Caption="Branch"
                              Visible="@GetColumnVisibility("BranchName")"
                              Width="@GetColumnWidth("BranchName")" />

            <DxGridDataColumn FieldName="JobNo"
                              Caption="Job No"
                              Visible="@GetColumnVisibility("JobNo")"
                              Width="@GetColumnWidth("JobNo")" />

            <DxGridDataColumn FieldName="JobDate"
                              Caption="Job Date"
                              DisplayFormat="dd/MM/yyyy"
                              Visible="@GetColumnVisibility("JobDate")"
                              Width="@GetColumnWidth("JobDate")" />

            <DxGridDataColumn FieldName="JobType"
                              Caption="Job Type"
                              Visible="@GetColumnVisibility("JobType")"
                              Width="@GetColumnWidth("JobType")" />

            <DxGridDataColumn FieldName="PartyName"
                              Caption="Customer"
                              Visible="@GetColumnVisibility("PartyName")"
                              Width="@GetColumnWidth("PartyName")" />

            <DxGridDataColumn FieldName="JobBlNo"
                              Caption="BL/BE No"
                              Visible="@GetColumnVisibility("JobBlNo")"
                              Width="@GetColumnWidth("JobBlNo")" />

            <DxGridDataColumn FieldName="TotalRevenue"
                              Caption="Total Revenue"
                              DisplayFormat="N2"
                              Visible="@GetColumnVisibility("TotalRevenue")"
                              Width="@GetColumnWidth("TotalRevenue")" />

            <DxGridDataColumn FieldName="TotalExpense"
                              Caption="Total Expense"
                              DisplayFormat="N2"
                              Visible="@GetColumnVisibility("TotalExpense")"
                              Width="@GetColumnWidth("TotalExpense")" />

            <DxGridDataColumn FieldName="ProfitLoss"
                              Caption="Profit / Loss"
                              DisplayFormat="N2"
                              Visible="@GetColumnVisibility("ProfitLoss")"
                              Width="@GetColumnWidth("ProfitLoss")">
                <CellDisplayTemplate Context="cellContext">
                    @{
                        var profitLoss = (decimal)cellContext.Value;
                        var cssClass = profitLoss >= 0 ? "profit-cell" : "loss-cell";
                    }
                    <span class="@cssClass">@profitLoss.ToString("N2")</span>
                </CellDisplayTemplate>
            </DxGridDataColumn>

            <DxGridDataColumn FieldName="ProfitMargin"
                              Caption="Profit Margin %"
                              DisplayFormat="N2"
                              Visible="@GetColumnVisibility("ProfitMargin")"
                              Width="@GetColumnWidth("ProfitMargin")">
                <CellDisplayTemplate Context="cellContext">
                    @{
                        var margin = (decimal)cellContext.Value;
                        var cssClass = margin >= 0 ? "profit-cell" : "loss-cell";
                    }
                    <span class="@cssClass">@margin.ToString("N2")%</span>
                </CellDisplayTemplate>
            </DxGridDataColumn>

            <DxGridDataColumn FieldName="SalesInvoiceCount"
                              Caption="Sales Count"
                              Visible="@GetColumnVisibility("SalesInvoiceCount")"
                              Width="@GetColumnWidth("SalesInvoiceCount")" />

            <DxGridDataColumn FieldName="PurchaseInvoiceCount"
                              Caption="Purchase Count"
                              Visible="@GetColumnVisibility("PurchaseInvoiceCount")"
                              Width="@GetColumnWidth("PurchaseInvoiceCount")" />
        </Columns>

        <TotalSummary>
            <DxGridSummaryItem SummaryType="GridSummaryItemType.Count" FieldName="JobId" />
            <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum"
                               FieldName="TotalRevenue"
                               DisplayFormat="Total Revenue: {0:N2}" />
            <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum"
                               FieldName="TotalExpense"
                               DisplayFormat="Total Expense: {0:N2}" />
            <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum"
                               FieldName="ProfitLoss"
                               DisplayFormat="Total Profit/Loss: {0:N2}" />
        </TotalSummary>
    </DxGrid>
</div>

<!-- PRINT ONLY SECTION -->
<div class="print-only-section" id="printProfitLossSection">
    <div class="print-header">
        <h2>Job-wise Profit & Loss Report</h2>
        <div class="print-info">
            <strong>From:</strong> @FromDate?.ToString("dd/MM/yyyy") &nbsp;&nbsp;
            <strong>To:</strong> @ToDate?.ToString("dd/MM/yyyy") &nbsp;&nbsp;
            @if (!string.IsNullOrEmpty(SelectedJobType))
            {
                <strong>Job Type:</strong> 
                @SelectedJobType
               
            }
            <strong>Print Date:</strong> @DateTime.Now.ToString("dd/MM/yyyy hh:mm tt")
        </div>
    </div>

    <table class="print-table">
        <thead>
            <tr>
                <th>Branch</th>
                <th>Job No</th>
                <th>Job Date</th>
                <th>Job Type</th>
                <th>Customer</th>
                <th>BL/BE No</th>
                <th>Revenue</th>
                <th>Expense</th>
                <th>Profit/Loss</th>
                <th>Margin %</th>
            </tr>
        </thead>

        <tbody>
            @if (profitLossList != null && profitLossList.Any())
            {
                @foreach (var item in profitLossList)
                {
                    <tr>
                        <td>@item.BranchName</td>
                        <td>@item.JobNo</td>
                        <td>@item.JobDate.ToString("dd/MM/yyyy")</td>
                        <td>@item.JobType</td>
                        <td>@item.PartyName</td>
                        <td>@item.JobBlNo</td>
                        <td>@item.TotalRevenue.ToString("N2")</td>
                        <td>@item.TotalExpense.ToString("N2")</td>
                        <td style="@(item.ProfitLoss >= 0 ? "color:green" : "color:red")">
                            @item.ProfitLoss.ToString("N2")
                        </td>
                        <td style="@(item.ProfitMargin >= 0 ? "color:green" : "color:red")">
                            @item.ProfitMargin.ToString("N2")%
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="10" style="text-align:center">No records available</td>
                </tr>
            }
        </tbody>

        <tfoot>
            <tr>
                <td colspan="6"><strong>Total:</strong></td>
                <td><strong>@profitLossList?.Sum(p => p.TotalRevenue).ToString("N2")</strong></td>
                <td><strong>@profitLossList?.Sum(p => p.TotalExpense).ToString("N2")</strong></td>
                <td style="@(profitLossList?.Sum(p => p.ProfitLoss) >= 0 ? "color:green" : "color:red")">
                    <strong>@profitLossList?.Sum(p => p.ProfitLoss).ToString("N2")</strong>
                </td>
                <td></td>
            </tr>
        </tfoot>
    </table>
</div>

<!-- Layout Dialog -->
@if (showLayoutDialog)
{
    <div class="modal fade show d-block"
         style="background-color: rgba(0,0,0,0.5); z-index:1050;">

        <div class="modal-dialog modal-md"
             @onclick:stopPropagation="true">

            <div class="modal-content">

                <!-- Header -->
                <div class="modal-header">
                    <h5 class="modal-title">@dialogTitle</h5>
                    <button type="button"
                            class="btn-close"
                            @onclick="CloseLayoutDialog">
                    </button>
                </div>

                <!-- Body -->
                <div class="modal-body">

                    <!-- Layout Name -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">
                            Layout Name:
                        </label>

                        <input type="text"
                               class="form-control"
                               @bind="newLayoutName"
                               @bind:event="oninput"
                               placeholder="Enter layout name..."
                               maxlength="100" />
                    </div>

                    <!-- Default Layout -->
                    <div class="mb-3">
                        <div class="form-check">
                            <input class="form-check-input"
                                   type="checkbox"
                                   @bind="isDefaultLayout"
                                   id="defaultLayoutCheck" />

                            <label class="form-check-label"
                                   for="defaultLayoutCheck">
                                Set as Default Layout
                            </label>
                        </div>
                    </div>

                    <!-- Column Configuration -->
                    <div class="mt-3">
                        <label class="form-label fw-bold mb-2">
                            Column Configuration:
                        </label>

                        <div class="table-responsive"
                             style="max-height:400px; overflow-y:auto;">

                            <table class="table table-sm table-bordered">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th style="width:50px;">Visible</th>
                                        <th style="width:200px;">Column Name</th>
                                        <th style="width:150px;">Width (px)</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var col in allColumns)
                                    {
                                        <tr>
                                            <td class="text-center">
                                                <input class="form-check-input"
                                                       type="checkbox"
                                                       @bind="col.Visible"
                                                       id="col_@col.FieldName" />
                                            </td>

                                            <td>
                                                <label class="mb-0"
                                                       for="col_@col.FieldName">
                                                    @col.Caption
                                                </label>
                                            </td>

                                            <td>
                                                <input type="number"
                                                       class="form-control form-control-sm"
                                                       @bind="col.Width"
                                                       @bind:event="oninput"
                                                       min="50"
                                                       max="500"
                                                       step="10" />
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>

                        </div>
                    </div>

                </div>

                <!-- Footer -->
                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            @onclick="CloseLayoutDialog">
                        Cancel
                    </button>

                    <button type="button"
                            class="btn btn-primary"
                            @onclick="SaveCurrentLayout">
                        <i class="bi bi-floppy me-1"></i>
                        @(isEditMode ? "Update" : "Create") Layout
                    </button>
                </div>

            </div>
        </div>
    </div>
}
@if (showInvoicePopup && selectedJob != null)
{
    <div class="modal fade show d-block"
         style="background-color:rgba(0,0,0,0.5); z-index:1050;">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">

                <!-- Header -->
                <div class="modal-header">
                    <h5 class="modal-title">
                        Job Invoices – @selectedJob.JobNo
                    </h5>
                    <button class="btn-close"
                            @onclick="CloseInvoicePopup"></button>
                </div>

                <!-- Body -->
                <div class="modal-body">

                    <!-- SALES -->
                    <h6 class="text-success mb-2">Sales Invoices</h6>
