    private void UpdateRowAmounts(BillDetail item)
    {
        if (item == null) return;
        // Auto-populate HSN and Unit when service is selected
        if (item.BillDetailProductId > 0)
        {
            var selectedService = ServiceList.FirstOrDefault(s => s.ServiceId == item.BillDetailProductId);
            if (selectedService != null)
            {
                item.BillDetailStatus = true;
                item.BillDetailHsnCode = selectedService.HsnName;
                var unitName = UnitList.FirstOrDefault(u => u.UnitId == selectedService.ServiceUnitId);
                item.BillDetailUnit = unitName.UnitName;
                item.BillDetailUnitId = unitName.UnitId;


                // ✅ Handle BillDetailQty logic based on user input
                double bill20Ft = 0;
                double bill40Ft = 0;
                double manualQty = 0;
                // Try converting user input (if any) from string → number
                if (!string.IsNullOrWhiteSpace(EditModel?.Bill20Ft))
                    double.TryParse(EditModel.Bill20Ft, out bill20Ft);

                if (!string.IsNullOrWhiteSpace(EditModel?.Bill40Ft))
                    double.TryParse(EditModel.Bill40Ft, out bill40Ft);

                if ((item?.BillDetailQty) != 0)
                    manualQty = item.BillDetailQty;


                if (manualQty > 0)
                {
                    item.BillDetailQty = manualQty;
                }
                else if (bill20Ft == 0 && bill40Ft == 0)
                {
                    item.BillDetailQty = 1;
                }
                else
                {
                    // Otherwise, sum both values
                    item.BillDetailQty = bill20Ft + bill40Ft;
                }

                // ✅ Handle Exchange Rate logic
                if (item.BillDetailExchRate == 0 || item.BillDetailExchRate == default)
                {
                    // Only auto-assign if user hasn't entered custom value
                    item.BillDetailExchRate = (EditModel?.BillExchRate ?? 0) == 0
                        ? 1
                        : EditModel.BillExchRate;
                }
                var selectedCurr = CurrList.FirstOrDefault(h => h.CurrencyId == EditModel.BillDefaultCurrencyId);

                if (item.BillDetailCurrencyId>0)
                {

                    item.BillDetailCurrencyId = item.BillDetailCurrencyId;
                }
                else 
                { 
                    item.BillDetailCurrencyId = selectedCurr?.CurrencyId ?? 0; 
                }
                item.BillDetailExchUnit = selectedCurr?.CurrencyName??"";
                var selectedHsn = HsnList.FirstOrDefault(h => h.HsnName == selectedService.HsnName);
                var selectedGstslab = GstslabList.FirstOrDefault(h => h.GstSlabIgstPer == selectedService.HsnGstPer);
                var billdetailsabid = GstslabList.FirstOrDefault(h => h.GstSlabId == selectedHsn.HsnGstSlabId);

                item.BillDetailAmount = item.BillDetailQty * item.BillDetailRate??0;
                item.BillDetailTaxableAmt = item.BillDetailAmount * item.BillDetailExchRate;

                var vouchergroup = VoucherList.FirstOrDefault(v => v.VoucherId == EditModel.BillVoucherId);
                if (vouchergroup == null)
                {
                   
                    return;
                }
                if (item.BillDetailRate == 0 || item.BillDetailRate == null || item.BillDetailRate == default(double))
                {
                    var applicableRate = RateMasterList?
                        .Where(r =>
                            r.RateMasterPartyId == EditModel.BillPartyId &&
                            r.RateMasterServiceId == item.BillDetailProductId &&
                            r.RateMasterApplicableDt <= EditModel.BillDate)
                        .OrderByDescending(r => r.RateMasterApplicableDt) // Get the most recent rate
                        .FirstOrDefault();

                    if (vouchergroup.VoucherGroup == "SALES")
                    {
                        if (applicableRate != null)
                        {
                            item.BillDetailRate = (double)applicableRate.RateMasterSaleRate;
                        }
                        else
                        {
                            item.BillDetailRate = selectedService.ServiceSRate;
                        }
                    }

                    if (vouchergroup.VoucherGroup == "PURCHASE")
                    {
                        if (applicableRate != null)
                        {
                            item.BillDetailRate = (double)applicableRate.RateMasterPurchaseRate;
                        }
                        else
                        {
                            item.BillDetailRate = selectedService.ServicePRate;
                        }

                    }
                }
               
                else
                {
                    if (vouchergroup.VoucherGroup == "SALES")
                    {
                        item.BillDetailAccountId = selectedGstslab.GstSlabSalesAccountId;
                        item.BillDetailIgstAcId = selectedGstslab.GstSlabIgstAccountId;
                        item.BillDetailCgstAcId = selectedGstslab.GstSlabCgstAccountId;
                        item.BillDetailSgstAcId = selectedGstslab.GstSlabSgstAccountId;
                    }
                    else if (vouchergroup.VoucherGroup == "PURCHASE")
                    {
                        item.BillDetailAccountId = selectedGstslab.GstSlabPurchaseAccountId;
                        item.BillDetailIgstAcId = selectedGstslab.GstSlabPigstAccountId;
                        item.BillDetailCgstAcId = selectedGstslab.GstSlabPcgstAccountId;
                        item.BillDetailSgstAcId = selectedGstslab.GstSlabPsgstAccountId;
                    }
                }
                if (selectedHsn != null)
                {
                    item.BillDetailHsnId = selectedHsn.HsnId;
                    item.BillDetailSlabId = billdetailsabid.GstSlabName;
                    // Map GST % from slab — if your HSN table has GST percentage
                    item.BillDetailGstPer = selectedHsn.HsnGstPer; // ✅ You said this ID corresponds to percentage
                    // item.Taxcode = selectedGstslab.GstSlabName; // ✅ Not mapped to DB but used in grid
                }
                var selectedCompany = CompanyList?.FirstOrDefault(c => c.Status == true);
                var selectedpos = StateList.FirstOrDefault(h => h.StateId == EditModel.BillPlaceOfSupply);
                // ✅ Apply IGST or CGST+SGST based on Place of Supply vs Company State
                if (selectedCompany != null && selectedpos != null)
                {
                   
                    // Convert string StateId → int for safe comparison
                    var companyState = StateList?
      .FirstOrDefault(s =>
          s.StateId != null &&
          s.StateId.ToString() == selectedCompany.StateId.ToString());

                    if (companyState != null)  // ✅ Added null check
                    {
                        int companyStateId = companyState.StateId;

                        if (companyStateId == EditModel.BillPlaceOfSupply)
                        {
                            // Intra-state → CGST + SGST
                            item.BillDetailIgst = 0;
                            item.BillDetailIgstPer = 0;
                            item.BillDetailCgstPer = item.BillDetailGstPer / 2;
                            item.BillDetailSgstPer = item.BillDetailGstPer / 2;
                            item.BillDetailCgst = item.BillDetailTaxableAmt * (item.BillDetailCgstPer / 100);
                            item.BillDetailSgst = item.BillDetailTaxableAmt * (item.BillDetailSgstPer / 100);
                        }
                        else
                        {
                            // Inter-state → IGST only
                            item.BillDetailCgstPer = 0;
                            item.BillDetailSgstPer = 0;
                            item.BillDetailCgst = 0;
                            item.BillDetailSgst = 0;
                            item.BillDetailIgstPer = item.BillDetailGstPer;
                            item.BillDetailIgst = item.BillDetailTaxableAmt * (item.BillDetailIgstPer / 100);
                        }

                        if (EditModel.BillIsRcm)
                        {
                            // ✅ RCM: No GST charged
                            item.BillDetailIgst = 0;
                            item.BillDetailCgst = 0;
                            item.BillDetailSgst = 0;
                            item.BillDetailIgstPer = 0;
                            item.BillDetailCgstPer = 0;
                            item.BillDetailSgstPer = 0;
                            item.BillDetailSlabId = "RCM";
                        }
                        else
                        {

                            string supplyType = EditModel.BillSupplyType ?? "B2B";

                            switch (supplyType)
                            {
                                case "B2B":
                                case "B2CS":
                                    // Normal GST logic (domestic)
                                    if (companyStateId == EditModel.BillPlaceOfSupply)
                                    {
                                        // Intra-state → CGST + SGST
                                        item.BillDetailIgst = 0;
                                        item.BillDetailIgstPer = 0;
                                        item.BillDetailCgstPer = item.BillDetailGstPer / 2;
                                        item.BillDetailSgstPer = item.BillDetailGstPer / 2;
                                        item.BillDetailCgst = item.BillDetailTaxableAmt * (item.BillDetailCgstPer / 100);
                                        item.BillDetailSgst = item.BillDetailTaxableAmt * (item.BillDetailSgstPer / 100);
                                    }
                                    else
                                    {
                                        // Inter-state → IGST
                                        item.BillDetailCgstPer = 0;
                                        item.BillDetailSgstPer = 0;
                                        item.BillDetailIgstPer = item.BillDetailGstPer;
                                        item.BillDetailIgst = item.BillDetailTaxableAmt * (item.BillDetailIgstPer / 100);
                                    }
                                    break;

                                case "SEZWP":
                                case "EXPWP":
                                case "DEXP":
                                    // ✅ Export or SEZ with payment → only IGST
                                    item.BillDetailCgstPer = 0;
                                    item.BillDetailSgstPer = 0;
                                    item.BillDetailIgstPer = item.BillDetailGstPer;
                                    item.BillDetailIgst = item.BillDetailTaxableAmt * (item.BillDetailIgstPer / 100);
                                    break;

                                case "SEZWOP":
                                case "EXPWOP":
                                    // ✅ Export or SEZ without payment → no GST
                                    item.BillDetailIgst = 0;
                                    item.BillDetailCgst = 0;
                                    item.BillDetailSgst = 0;
                                    item.BillDetailIgstPer = 0;
                                    item.BillDetailCgstPer = 0;
                                    item.BillDetailSgstPer = 0;
                                    break;
                            }
                        }

                    }




                }


            }
        }

        // Calculate amounts
        item.BillDetailAmount = item.BillDetailQty * item.BillDetailRate??0;
        item.BillDetailTaxableAmt = item.BillDetailAmount * item.BillDetailExchRate + item.BillDetailExtraChrg;
        item.BillDetailTotal = item.BillDetailTaxableAmt + item.BillDetailIgst + item.BillDetailCgst + item.BillDetailSgst;
        // Update main bill total
        if (EditModel != null)
        {
            // EditModel.BillNetAmount = (float)BillDetails
            //     .Where(d => !UnsavedChanges.ContainsKey(d) || UnsavedChanges[d].Type != DataChangeType.Delete)
            //     .Sum(d => d.BillDetailTotal);

            EditModel.BillTotalUsd = (float)BillDetails
           .Where(d => !UnsavedChanges.ContainsKey(d) || UnsavedChanges[d].Type != DataChangeType.Delete)
           .Sum(d => d.BillDetailAmount);
            // ✅ Calculate Non-Taxable Amount (only HSN with 0% GST)
            EditModel.BillNonTaxable = (float)BillDetails
        .Where(d =>
            (!UnsavedChanges.ContainsKey(d) || UnsavedChanges[d].Type != DataChangeType.Delete)
            && (d.BillDetailGstPer == 0)
        )
        .Sum(d => d.BillDetailTaxableAmt);

            EditModel.BillIgst = (float)BillDetails
           .Where(d => !UnsavedChanges.ContainsKey(d) || UnsavedChanges[d].Type != DataChangeType.Delete)
           .Sum(d => d.BillDetailIgst);
            EditModel.BillCgst = (float)BillDetails
            .Where(d => !UnsavedChanges.ContainsKey(d) || UnsavedChanges[d].Type != DataChangeType.Delete)
            .Sum(d => d.BillDetailCgst);
            EditModel.BillSgst = (float)BillDetails
            .Where(d => !UnsavedChanges.ContainsKey(d) || UnsavedChanges[d].Type != DataChangeType.Delete)
            .Sum(d => d.BillDetailSgst);
            // ApplyRoundOff(EditModel.BillIsRoundOff);
            RecalculateNetAmount(EditModel.BillIsRoundOff);
        }
    }
    // ✅ NEW: Centralized calculation method
    private void RecalculateNetAmount(bool isChecked)
    {
        EditModel.BillIsRoundOff = isChecked;
        if (EditModel == null) return;

        // Calculate base amount (sum of all active line items)
        var baseAmount = (decimal)BillDetails
            .Where(d => !UnsavedChanges.ContainsKey(d) || UnsavedChanges[d].Type != DataChangeType.Delete)
            .Sum(d => d.BillDetailTotal);

            

        // if (EditModel.BillIsRoundOff)
        // {
        //     // Round to nearest whole number
        //     var roundedAmount = Math.Round(baseAmount, 0, MidpointRounding.AwayFromZero);

        //     // Calculate round-off difference
        //     var roundOffDifference = roundedAmount - baseAmount;

        //     EditModel.BillRoundAmt = (float)roundOffDifference;
        //     EditModel.BillNetAmount = (float)roundedAmount- EditModel.BillTdsAmt;
        // }
        // else
        // {
        //     EditModel.BillRoundAmt = 0;
        //     EditModel.BillNetAmount = (float)Math.Round(baseAmount, 2) - EditModel.BillTdsAmt;
        // }
        decimal tdsAmount = 0;

        // 2️⃣ TDS Calculation Logic
        if (EditModel.BillTdsPer > 0)
        {
            // If percentage entered
            tdsAmount = Math.Round(baseAmount * (decimal)EditModel.BillTdsPer / 100m, 2);
            EditModel.BillTdsAmt = (float)tdsAmount;
        }
        else if (EditModel.BillTdsAmt > 0)
        {
            // If amount entered
            tdsAmount = (decimal)EditModel.BillTdsAmt;
            EditModel.BillTdsPer = baseAmount > 0
                ? (float)Math.Round(tdsAmount / baseAmount * 100m, 2)
                : 0;
        }
        else
        {
            EditModel.BillTdsAmt = 0;
            EditModel.BillTdsPer = 0;
        }


        EditModel.BillTdsAmt = (float)tdsAmount;

        // Step 3: SubTotal after TDS
        decimal subTotal = baseAmount - tdsAmount;

        // Step 4: Apply Round Off on subtotal
        decimal finalAmount;

        if (EditModel.BillIsRoundOff)
        {
            finalAmount = Math.Round(subTotal, 0, MidpointRounding.AwayFromZero);
            EditModel.BillRoundAmt = (float)(finalAmount - subTotal);
        }
        else
        {
            finalAmount = Math.Round(subTotal, 2);
            EditModel.BillRoundAmt = 0;
        }

        // Step 5: Net Amount
        EditModel.BillNetAmount = (float)finalAmount;

        ConvertNumberToWords((decimal)EditModel.BillNetAmount);
    }
    private HashSet<string> ApplyModifiedFields(BillDetail source, BillDetail target)
    {
        var changedFields = new HashSet<string>();
        var properties = typeof(BillDetail).GetProperties();

        foreach (var prop in properties)
        {
            if (prop.Name == "BillDetailSno" || prop.Name == "BillDetailId") continue;

            var sourceValue = prop.GetValue(source);
            var targetValue = prop.GetValue(target);

            if (!Equals(sourceValue, targetValue))
            {
                prop.SetValue(target, sourceValue);
                changedFields.Add(prop.Name);
            }
        }

        return changedFields;
    }
