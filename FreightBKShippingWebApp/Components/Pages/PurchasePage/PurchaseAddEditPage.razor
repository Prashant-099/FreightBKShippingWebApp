    private decimal GetGrossAmount()
    {
        var baseAmount = (decimal)BillDetails
            .Where(d => !UnsavedChanges.ContainsKey(d) || UnsavedChanges[d].Type != DataChangeType.Delete)
            .Sum(d => d.BillDetailTotal);

        return EditModel.BillIsRoundOff
            ? Math.Round(baseAmount, 0, MidpointRounding.AwayFromZero)
            : Math.Round(baseAmount, 2);
    }

    private void OnTdsPerChanged(float value)
    {
        EditModel.BillTdsPer = value;
        var gross = GetGrossAmount();
        EditModel.BillTdsAmt = (float)Math.Round((decimal)value / 100m * gross, 2);
        EditModel.BillNetAmount = (float)(gross - (decimal)EditModel.BillTdsAmt);
        RecalculateNetAmount(EditModel.BillIsRoundOff);
        // ConvertNumberToWords((decimal)EditModel.BillNetAmount);
        StateHasChanged();
    }

    private void OnTdsAmtChanged(float value)
    {
        EditModel.BillTdsAmt = value;
        var gross = GetGrossAmount();
        EditModel.BillTdsPer = gross > 0 ? (float)Math.Round((decimal)value / gross * 100m, 2) : 0;
        EditModel.BillNetAmount = (float)(gross - (decimal)value);
        RecalculateNetAmount(EditModel.BillIsRoundOff);
        // ConvertNumberToWords((decimal)EditModel.BillNetAmount);
        StateHasChanged();
    }


