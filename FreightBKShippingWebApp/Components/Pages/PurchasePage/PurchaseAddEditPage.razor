    private async Task LoadBillListBasedOnVoucherType(Voucher voucher)
    {
        if (voucher == null) return;

        var allBills = await BillService.GetAllAsync();
        var currentYearBills = allBills.Where(b => b.BillYearId == YearStatechangeService.SelectedYearId).ToList();

        if (voucher.VoucherGroup?.Equals("DEBIT NOTE", StringComparison.OrdinalIgnoreCase) == true)
        {
            // ✅ CREDIT NOTE: Show only SALES bills
            Quotationvisible = false;
            IsCreditnote = true;

            var salesVoucherIds = VoucherList
                .Where(v => v.VoucherGroup?.Equals("PURCHASE", StringComparison.OrdinalIgnoreCase) == true)
                .Select(v => v.VoucherId)
                .ToList();

            billList = currentYearBills
                .Where(b => salesVoucherIds.Contains(b.BillVoucherId) && b.Bill_due_amt>0)
                .ToList();
        }
        else if (voucher.VoucherGroup?.Equals("PURCHASE", StringComparison.OrdinalIgnoreCase) == true)
        {
            // ✅ SALES: Show only QUOTATION bills
            Quotationvisible = true;
            IsCreditnote = false;

            billList = currentYearBills
                .Where(b => string.Equals(b.BillType, "QUOTATION", StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
        else
        {
            // ✅ OTHER VOUCHER TYPES: Clear billList
            Quotationvisible = false;
            IsCreditnote = false;
            billList = new List<Bill>();
        }

        StateHasChanged();
    }

