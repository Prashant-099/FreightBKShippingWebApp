    private string ConvertNumberToWords(decimal number)
    {
        if (EditModel == null)
            return string.Empty;

        if (number == 0)
        {
            EditModel.BillAmountInWord = "Zero Rupees Only";
            return EditModel.BillAmountInWord;
        }

        string[] unitsMap = { "Zero", "One", "Two", "Three", "Four", "Five", "Six", "Seven", "Eight", "Nine", "Ten", "Eleven", "Twelve", "Thirteen", "Fourteen", "Fifteen", "Sixteen", "Seventeen", "Eighteen", "Nineteen" };
        string[] tensMap = { "Zero", "Ten", "Twenty", "Thirty", "Forty", "Fifty", "Sixty", "Seventy", "Eighty", "Ninety" };

        string ConvertIntPart(long n)
        {
            if (n == 0)
                return "";
            if (n < 20)
                return unitsMap[n];
            if (n < 100)
                return tensMap[n / 10] + (n % 10 > 0 ? " " + unitsMap[n % 10] : "");
            if (n < 1000)
                return unitsMap[n / 100] + " Hundred" + (n % 100 > 0 ? " and " + ConvertIntPart(n % 100) : "");
            if (n < 100000)
                return ConvertIntPart(n / 1000) + " Thousand" + (n % 1000 > 0 ? " " + ConvertIntPart(n % 1000) : "");
            if (n < 10000000)
                return ConvertIntPart(n / 100000) + " Lakh" + (n % 100000 > 0 ? " " + ConvertIntPart(n % 100000) : "");
            return ConvertIntPart(n / 10000000) + " Crore" + (n % 10000000 > 0 ? " " + ConvertIntPart(n % 10000000) : "");
        }

        long intPart = (long)Math.Floor(number);
        int decimalPart = (int)((number - intPart) * 100);

        string words = ConvertIntPart(intPart) + " Rupees";
        if (decimalPart > 0)
            words += " and " + ConvertIntPart(decimalPart) + " Paise";

        EditModel.BillAmountInWord = words + " Only";
        return EditModel.BillAmountInWord;
    }

    // Keep ParseWidth helper for loading saved widths
    private int ParseWidth(string width)
    {
        if (string.IsNullOrEmpty(width))
            return 100;

        // Remove "px" suffix if present
        width = width.Replace("px", "").Trim();

        if (int.TryParse(width, out int result))
            return result;

        return 100; // default
    }
    private async Task OnBillAgainstChanged(int? selectedBillId)
    {
        if (!selectedBillId.HasValue)
        {
            return;
        }

        EditModel.BillAgainstBillId = selectedBillId;

        // Find the selected bill from billList
        var selectedBill = billList.FirstOrDefault(b => b.BillId == selectedBillId);
        if (selectedBill == null)
        {
            InitializeInvoiceDetails();
            return;
        }
        // --- Fill Header fields from the selected bill ---
        EditModel.BillPartyId = selectedBill.BillPartyId;
        EditModel.BillPlaceOfSupply = selectedBill.BillPlaceOfSupply;
        EditModel.BillSupplyType = selectedBill.BillSupplyType;
        EditModel.BillJobType = selectedBill.BillJobType;
        EditModel.BillJobNo = selectedBill.BillJobNo;
        EditModel.BillJobId = selectedBill.BillJobId;
        EditModel.BillShipPartyId = selectedBill.BillShipPartyId;
        EditModel.BillAddress1 = selectedBill.BillAddress1;
        EditModel.BillContactNo = selectedBill.BillContactNo;
        EditModel.BillGstNo = selectedBill.BillGstNo;
        EditModel.BillPincode = selectedBill.BillPincode;
        EditModel.BillCity = selectedBill.BillCity;
        EditModel.BillStateId = selectedBill.BillStateId;
        EditModel.BillRemarksDefault = selectedBill.BillRemarksDefault;
        EditModel.BillContainerNo = selectedBill.BillContainerNo;
        EditModel.BillSbNo = selectedBill.BillSbNo;
        EditModel.BillSbDate = selectedBill.BillSbDate;
        EditModel.BillRemarks = selectedBill.BillRemarks;
        EditModel.BillExchRate = selectedBill.BillExchRate;
        EditModel.BillDefaultCurrencyId = selectedBill.BillDefaultCurrencyId;
        EditModel.BillPolId = selectedBill.BillPolId;
        EditModel.BillPodId = selectedBill.BillPodId;
        EditModel.BillLineId = selectedBill.BillLineId;


        EditModel.BillIsRcm = selectedBill.BillIsRcm;
        EditModel.BillIsRoundOff = selectedBill.BillIsRoundOff;
        if (EditModel.BillIsRoundOff)
        {
            ApplyRoundOff(true);
        }
        EditModel.BillAgainstBillNo = selectedBill.BillNo;
        EditModel.BillAgainstBillDate = selectedBill.BillDate.ToString();
        // --- Clone detail lines from the selected bill (negative amounts for credit note) ---
        BillDetails.Clear();
        int sno = 1;

        if (selectedBill.BillDetails != null)
        {
            foreach (var detail in selectedBill.BillDetails.OrderBy(d => d.BillDetailSno))
            {
                var newDetail = new BillDetail
                {
                    BillDetailSno = sno++,
                    BillDetailId = 0,               // New rows — not saved yet
                    BillDetailBillId = 0,
                    BillDetailProductId = detail.BillDetailProductId,
                    BillDetailHsnCode = detail.BillDetailHsnCode,
                    BillDetailUnit = detail.BillDetailUnit,
                    BillDetailUnitId = detail.BillDetailUnitId,
                    BillDetailRemarks = detail.BillDetailRemarks,
                    BillDetailRate = detail.BillDetailActualRate,
                    BillDetailQty = detail.BillDetailQty,
                    BillDetailExchRate = detail.BillDetailExchRate,
                    BillDetailCurrencyId = detail.BillDetailCurrencyId,
                    BillDetailExtraChrg = detail.BillDetailExtraChrg,
                    BillDetailAmount = detail.BillDetailAmount,
                    BillDetailTaxableAmt = detail.BillDetailTaxableAmt,
                    BillDetailSlabId = detail.BillDetailSlabId,
                    BillDetailGstPer = detail.BillDetailGstPer,
                    BillDetailIgstPer = detail.BillDetailIgstPer,
                    BillDetailIgst = detail.BillDetailIgst,
                    BillDetailCgstPer = detail.BillDetailCgstPer,
                    BillDetailCgst = detail.BillDetailCgst,
                    BillDetailSgstPer = detail.BillDetailSgstPer,
                    BillDetailSgst = detail.BillDetailSgst,
                    BillDetailTotal = detail.BillDetailTotal,
                    BillDetailAccountId = detail.BillDetailAccountId,
                    BillDetailIgstAcId = detail.BillDetailIgstAcId,
                    BillDetailCgstAcId = detail.BillDetailCgstAcId,
                    BillDetailSgstAcId = detail.BillDetailSgstAcId,
                    BillDetailStatus = true
                };
                BillDetails.Add(newDetail);
                UpdateRowAmounts(newDetail);
            }
        }

        // If no details came from the original bill, add empty rows
        if (BillDetails.Count == 0)
        {
            nextSNo = 1;
            InitializeInvoiceDetails();
        }
        else
        {
            nextSNo = sno;
        }

        // Recalculate totals
        RecalculateNetAmount(EditModel.BillIsRoundOff);

        // Clear unsaved tracking since these are fresh copies
        UnsavedChanges.Clear();

        StateHasChanged();
    }


