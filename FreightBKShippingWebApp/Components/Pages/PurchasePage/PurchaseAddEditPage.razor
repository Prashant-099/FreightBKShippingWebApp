    async Task ClearUnsavedChangesAsync()
    {
        UnsavedChanges.Clear();
        BillDetails = BillDetails
       .Where(d => d.BillDetailId > 0 || d.BillDetailProductId > 0)
       .Select(d => CloneBillDetail(d))
       .OrderBy(d => d.BillDetailSno)
       .ToList();
        // for (int i = 0; i < BillDetails.Count; i++)
        // {
        //     BillDetails[i].BillDetailSno = i + 1;
        // }
        // nextSNo = BillDetails.Count + 1;

        // ✅ Don't reindex - preserve database SNo values
        nextSNo = BillDetails.Any() ? BillDetails.Max(d => d.BillDetailSno) + 1 : 1;
        await InvokeAsync(StateHasChanged);
    }

    private void OnServiceSelected(int newServiceId, BillDetail detail)
    {
        if (detail == null)
            return;

        // Update the product ID
        detail.BillDetailProductId = newServiceId;

        // Track changes
        if (!UnsavedChanges.ContainsKey(detail))
        {
            UnsavedChanges[detail] = new(
                DataChangeType.Modification,
                new HashSet<string>
                {
                    nameof(BillDetail.BillDetailProductId)
                }
            );
        }
        else if (UnsavedChanges[detail].Type != DataChangeType.Addition)
        {
            UnsavedChanges[detail].ChangedFields.Add(
                nameof(BillDetail.BillDetailProductId)
            );
        }
        // Update row calculations (HSN, Unit, Rate, GST, etc.)
        UpdateRowAmounts(detail);

        // Update main bill total
        EditModel.BillNetAmount = (float)BillDetails
            .Where(d => !UnsavedChanges.ContainsKey(d)
                        || UnsavedChanges[d].Type != DataChangeType.Delete)
            .Sum(d => d.BillDetailTotal);

        // Force grid to refresh the row
        if (DetailGrid != null)
        {
            DetailGrid.Reload();
        }

        // Trigger UI update
        InvokeAsync(StateHasChanged);

    }
