@page "/year"
@using FreightBKShippingWebApp.Model
@using FreightBKShippingWebApp.Services
@using FreightBKShippingWebApp.Components.Pages
@inject YearService YearService
@inject ToasteService ToastService
@inject LoadingService LoadingService
@inject ConfirmationDialogService ConfirmDialogService
@inject GridLayoutService GridLayoutService
<style>
    .grid-size {
        max-height: 600px;
    }


    /* ComboBox Styling */
    .layout-combobox {
        border-radius: 6px;
        width: 185px;
    }
</style>
<DxGrid TItem="Year"
        Data="@yearList"
        @ref="MyGrid"
        KeyFieldName="YearId"
        ShowSearchBox="true"
        PageSize="10"
        PageSizeSelectorVisible="true"
        ShowGroupPanel="true"
        FilterMenuButtonDisplayMode="GridFilterMenuButtonDisplayMode.Always"
        FocusedRowEnabled="true"
        SelectionMode="GridSelectionMode.Multiple"
        SelectedDataItems="@SelectedYears"
        SelectedDataItemsChanged="OnSelectedYearsChanged" ColumnResizeMode="GridColumnResizeMode.NextColumn"
        CssClass="grid-size" AllowSelectRowByClick="true">

    <ToolbarTemplate>
        <DxToolbar>
            <TitleTemplate Context="tl">
                <div class="d-flex align-items-center">
                    <i class="bi bi-calendar3 me-2"></i>
                    <span class="fs-5">Years</span>
                </div>
            </TitleTemplate>
            <Items>
                <DxToolbarItem Text="Add" IconCssClass="bi bi-plus-circle" Click="OnCreateNew" />
                <DxToolbarItem Text="Edit" IconCssClass="bi bi-pencil-square" Click="OnEdit" />
                <DxToolbarItem Text="Delete" IconCssClass="bi bi-trash" Click="OnDelete" />
                <DxToolbarItem Text="Refresh" IconCssClass="bi bi-arrow-clockwise" Click="@(async (_) => await LoadYearsAsync())" />
                <DxToolbarItem Alignment="ToolbarItemAlignment.Right"
                               RenderStyle="ButtonRenderStyle.Secondary"
                               IconCssClass="bi bi-gear-wide-connected"
                               Click="ShowLayoutPopup" />
            </Items>
        </DxToolbar>
    </ToolbarTemplate>

    <Columns>
        <DxGridSelectionColumn Width="30" FixedPosition="GridColumnFixedPosition.Left" />

        <DxGridDataColumn FieldName="YearId" Caption="ID"
                          Width="@(layoutManager?.GetColumnWidth("YearId") ?? "80px")"
                          Visible="@(layoutManager?.GetColumnVisibility("YearId") ?? false)" />

        <DxGridDataColumn FieldName="YearName" Caption="Year Name"
                          Width="@(layoutManager?.GetColumnWidth("YearName") ?? "400px")" 
            Visible="@(layoutManager?.GetColumnVisibility("YearName") ?? true)" />
            

        <DxGridDataColumn FieldName="YearDateFrom" Caption="From Date"
                          DisplayFormat="d"
                          Width="@(layoutManager?.GetColumnWidth("YearDateFrom") ?? "421px")"
                          Visible="@(layoutManager?.GetColumnVisibility("YearDateFrom") ?? true)" />

        <DxGridDataColumn FieldName="YearDateTo" Caption="To Date"
                          DisplayFormat="d"
                          Width="@(layoutManager?.GetColumnWidth("YearDateTo") ?? "400px")"
                          Visible="@(layoutManager?.GetColumnVisibility("YearDateTo") ?? true)" />

        <DxGridDataColumn FieldName="YearStatus" Caption="Active"
                          Width="@(layoutManager?.GetColumnWidth("YearStatus") ?? "120px")"
                          Visible="@(layoutManager?.GetColumnVisibility("YearStatus") ?? true)" />

        <DxGridDataColumn FieldName="YearIsDefault" Caption="Default"
                          Width="@(layoutManager?.GetColumnWidth("YearIsDefault") ?? "120px")"
                          Visible="@(layoutManager?.GetColumnVisibility("YearIsDefault") ?? true)" />
    </Columns>
</DxGrid>

<YearAddEditPage @ref="popup" OnSaved="LoadYearsAsync" />

<ConfirmationDialog />

<GridLayoutpPopup @ref="layoutManager"
                  VoucherType="Year"
                  Columns="@allColumns"
                  OnLayoutChanged="HandleLayoutChanged" />
@code {
    DxGrid MyGrid;
    private List<YearModel> yearList = [];
    // private List<YearModel> SelectedYears = new();
    private IReadOnlyList<object> SelectedYears { get; set; } = new List<object>();
    private YearAddEditPage popup;
 

    // All possible columns
    private List<GridColumnLayout> allColumns = [];
    private GridLayoutpPopup? layoutManager;
    private async void ShowLayoutPopup()
    {
        await InvokeAsync(() =>
        {
            layoutManager?.ShowPopup();
        });
    }
    private async Task HandleLayoutChanged(List<GridColumnLayout> updatedLayout)
    {
        allColumns = updatedLayout;
        // Force the grid to re-render with new layout
        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnInitializedAsync()
    {
        InitializeColumns();
        await LoadYearsAsync();
       
       
    }
    private void InitializeColumns()
    {
        allColumns = new List<GridColumnLayout>
        {
       new() { FieldName = "YearId", Caption = "ID", Visible = false, Width = 80, DisplayIndex = 0 },
        new() { FieldName = "YearName", Caption = "Year Name", Visible = true, Width = 400, DisplayIndex = 1 },
        new() { FieldName = "YearDateFrom", Caption = "From Date", Visible = true, Width = 421, DisplayIndex = 2 },
        new() { FieldName = "YearDateTo", Caption = "To Date", Visible = true, Width = 400, DisplayIndex = 3 },
        new() { FieldName = "YearStatus", Caption = "Active", Visible = true, Width = 120, DisplayIndex = 4 },
        new() { FieldName = "YearIsDefault", Caption = "Default", Visible = true, Width = 120, DisplayIndex = 5 },

   };
       
    }

   
    private async Task LoadYearsAsync()
    {
        LoadingService.Show();
        try
        {
            yearList = await YearService.GetAllAsync();
        }
        finally
        {
            LoadingService.Hide();
        }
    }

    private async Task OnSelectedYearsChanged(IReadOnlyList<object> years)
    {
        SelectedYears = years ?? new List<object>();
        await InvokeAsync(StateHasChanged);
    }
    // ✅ FIXED: Reliable clear selection method
    private async Task ClearSelectionManual()
    {
        try
        {
            if (MyGrid != null)
            {
                MyGrid.ClearSelection(); // ✅ Synchronous method
            }
            SelectedYears = new List<YearModel>();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Clear selection error: {ex.Message}");
        }
    }

    // ✅ FIXED: Auto-clear after operations
    private async Task ClearSelection()
    {
        await Task.Delay(100); // Small delay for UI update
        await ClearSelectionManual();
    }
    private void OnCreateNew(ToolbarItemClickEventArgs e)
    {
        popup.Show(new YearModel()
        {
            YearDateFrom = DateTime.Now,
            YearDateTo = DateTime.Now.AddMonths(12),
            YearStatus = true
        });
    }

    private async Task OnEdit(ToolbarItemClickEventArgs e)
    {
        var year = MyGrid.GetFocusedDataItem() as YearModel;
        if (year != null)
            popup.Show(year);
        else
            ToastService.Warning("Please select a year to edit.");
        await ClearSelection();
    }

    private async Task OnDelete(ToolbarItemClickEventArgs e)
    {
        if (SelectedYears == null || SelectedYears.Count == 0)
        {
            ToastService.Warning("Please select at least one year to delete.");
            return;
        }
        var selectedList = SelectedYears.Cast<YearModel>().ToList();

        var confirm = await ConfirmDialogService.ShowAsync(
            $"Are you sure you want to delete {SelectedYears.Count} selected year(s)?");

        if (!confirm)
        {
            await ClearSelection(); // ✅ Clear on cancel
            return;
        }
        try
        {
            LoadingService.Show("Deleting...");
        int successCount = 0;
        int failCount = 0;

        foreach (var year in selectedList)
        {
            var result = await YearService.DeleteAsync(year.YearId);

            if (result)
                successCount++;
            else
                failCount++;
        }

        if (successCount > 0)
            ToastService.Success($"{successCount} Year(s) Deleted Successfully.");

        if (failCount > 0)
            ToastService.Error($"{failCount} Year(s) Failed To Delete.");

        await LoadYearsAsync();
      
        }
        finally
        {
            LoadingService.Hide();
            await ClearSelection(); // ✅ Clear after delete (success or fail)
        }
    }

}
