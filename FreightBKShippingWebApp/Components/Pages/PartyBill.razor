@page "/partybill"
@using FreightBKShipping.Client.Services
@using FreightBKShippingWebApp.Model
@using FreightBKShippingWebApp.Services
@inject LrApiService LrApiService
@inject AccountService AccountService
@inject VoucherService VoucherService
@inject StateService StateService
<style>

    .page-container {
        display: flex;
        flex-direction: column;
        height: 100vh;
        background-color: #fff;
    }

    .page-header {
        padding: 10px 10px;
        background: white;
        border-bottom: 1px solid #e5e5e5;
    }

    .page-content {
        flex: 1;
        overflow-y: auto;
        padding: 20px;
    }

    .page-footer {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        background: white;
        border-top: 1px solid #ddd;
        padding: 12px 24px;
        text-align: right;
        box-shadow: 0 -2px 8px rgba(0,0,0,0.05);
        z-index: 1000;
    }

    .page-content {
        padding-bottom: 120px;
    }

    .grid-size {
        max-height: 280px;
    }

</style>

<div class="page-container">

    <div class="page-header d-flex align-items-center">
        <i class="bi bi-receipt me-2 py-2"></i>
        <span class="fs-5">Party Bill</span>
    </div>

    <div class="page-content">

        <DxFormLayout>

            <!-- Party Dropdown -->
            <DxFormLayoutItem Caption="Party" ColSpanMd="4">
                <DxComboBox Data="partylist"
                            TextFieldName="AccountName"
                            ValueFieldName="AccountId"
                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                            AllowUserInput="true"
                            SearchMode="ListSearchMode.AutoSearch"
                            SearchFilterCondition="ListSearchFilterCondition.StartsWith"
                            @bind-Value="lrs.LrPartyAccountId">
                </DxComboBox>
            </DxFormLayoutItem>

            <!-- From Date -->
            <DxFormLayoutItem Caption="From Date" ColSpanMd="3">
                <DxDateEdit @bind-Date="fromDate"
                            DisplayFormat="dd-MM-yyyy" Format="dd-MM-yyyy"
                            NullText="Select From Date">
                </DxDateEdit>
            </DxFormLayoutItem>

            <!-- To Date -->
            <DxFormLayoutItem Caption="To Date" ColSpanMd="3">
                <DxDateEdit @bind-Date="toDate"
                            DisplayFormat="dd-MM-yyyy" Format="dd-MM-yyyy"
                            NullText="Select To Date">
                </DxDateEdit>
            </DxFormLayoutItem>

            <!-- Search Button -->
            <DxFormLayoutItem ColSpanMd="2">
                <DxButton Text="Search"
                          RenderStyle="ButtonRenderStyle.Primary"
                          Click="SerchLrs">
                </DxButton>
            </DxFormLayoutItem>

        </DxFormLayout>

        <br />

        <!-- Result Grid -->
        <DxGrid Data="lrslist" SelectedDataItems="selectedLrs"
                SelectedDataItemsChanged="@OnSelectionChanged"
                KeyFieldName="LrId" PageSize="10" CssClass="grid-size">
            <Columns>

                <!-- Selection -->
                <DxGridSelectionColumn AllowSelectAll="true"
                                       Width="40"
                                       FixedPosition="GridColumnFixedPosition.Left" />

                <!-- Basic LR Info -->
                <DxGridDataColumn FieldName="SrNo" Caption="Sr No" Width="70" />
                <DxGridDataColumn FieldName="LrNoStr" Caption="LR No" />
                <DxGridDataColumn FieldName="LrDate" Caption="LR Date" DisplayFormat="dd-MM-yyyy" />

                <!-- Party / Job -->
                <DxGridDataColumn FieldName="LrJobNo" Caption="Job No" />
                <DxGridDataColumn FieldName="LrPartyAccountId" Caption="Party" />
                <DxGridDataColumn FieldName="LrSupplierAccountId" Caption="Supplier" />

                <!-- Route -->
                <DxGridDataColumn FieldName="LrFromLocationId" Caption="From" />
                <DxGridDataColumn FieldName="LrToLocationId" Caption="To" />

                <!-- Vehicle -->
                <DxGridDataColumn FieldName="LrVehicleId" Caption="Vehicle" />
                <DxGridDataColumn FieldName="LrDriverMobile" Caption="Driver Mobile" />

                <!-- Weight -->
                <DxGridDataColumn FieldName="LrLoadWt" Caption="Load Wt" />
                <DxGridDataColumn FieldName="LrUnloadWt" Caption="Unload Wt" />

                <!-- Billing -->
                <DxGridDataColumn FieldName="LrRateBill" Caption="Rate" />
                <DxGridDataColumn FieldName="LrNetFreightBill" Caption="Net Freight" />

                <!-- Status -->
                <DxGridDataColumn FieldName="LrPaymentType" Caption="Payment Type" />
                <DxGridDataColumn FieldName="LrStatus" Caption="Status" />
                <DxGridDataColumn FieldName="LrGrossFreightBill" Caption="Gross Amount" />

            </Columns>

        </DxGrid>
        <br />
        <!-- Tabs Section -->
        <div class="tab-section">

            <DxFormLayout>
                <DxFormLayoutGroup ColSpanMd="6" Decoration="FormLayoutGroupDecoration.None">
                    <DxFormLayoutTabPages>
                        <DxFormLayoutTabPage Caption="Bill Details">
                            <DxFormLayoutItem Caption="Bill Type">
                                <DxComboBox Data="@VoucherList" @bind-Value="bill.BillType"></DxComboBox>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Bill Date">
                                <DxMaskedInput @bind-Value="bill.BillDate"></DxMaskedInput>
                            </DxFormLayoutItem>

                            <DxFormLayoutItem Caption="Bill No">
                                <DxTextBox @bind-Text="bill.BillNo"></DxTextBox>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Due Date">
                                <DxMaskedInput @bind-Value="bill.BillDueDate"></DxMaskedInput>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Place of Supply">
                                <DxComboBox TData="State" TValue="int"
                                            Data="@stateList"
                                            TextFieldName="StateName"
                                            ValueFieldName="StateId"
                                            ClearButtonVisible="true"
                                            AllowUserInput="true"
                                            NullText="-- Select POS --"
                                            @bind-Value="bill.BillPlaceOfSupply"
                                            SearchMode="ListSearchMode.AutoSearch"
                                            SearchFilterCondition="ListSearchFilterCondition.StartsWith" />
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Ref No">
                                <DxTextBox></DxTextBox>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Remarks">
                                <DxMemo rows="3" @bind-Text="bill.BillRemarks"></DxMemo>
                            </DxFormLayoutItem>
                        </DxFormLayoutTabPage>
                        <DxFormLayoutTabPage Caption="Ship To">
                            <DxFormLayoutItem Caption="Ship To Party">
                                <DxComboBox Data="partylist" @bind-Value="bill.BillShipPartyId"></DxComboBox>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="State">
                                <DxComboBox Data="@stateList" @bind-Value="bill.BillStateId" TData="State" TValue="int"
                                            TextFieldName="StateName"
                                            ValueFieldName="StateId"
                                            ClearButtonVisible="true"
                                            AllowUserInput="true"
                                            SearchMode="ListSearchMode.AutoSearch"
                                            SearchFilterCondition="ListSearchFilterCondition.StartsWith"></DxComboBox>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Address">
                               <DxMemo @bind-Text="bill.BillAddress1" Rows="3"></DxMemo>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="GSTIN">
                                <DxTextBox @bind-Text="bill.BillGstNo"></DxTextBox>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="PIN">
                                <DxTextBox @bind-Text="bill.BillPincode"></DxTextBox>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Contact">
                                <DxTextBox @bind-Text="bill.BillContactNo"></DxTextBox>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Job No">
                                <DxTextBox @bind-Text="bill.BillJobNo"></DxTextBox>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="BE no">
                                <DxTextBox @bind-Text="bill.BillBlNo"></DxTextBox>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Supply Type" ColSpanMd="12">
                                <DxComboBox Data="@SupplyTypeList"
                                            @bind-Value="bill.BillSupplyType"
                                            TextFieldName="Text"
                                            ValueFieldName="Value"
                                            ShowValidationIcon="true"
                                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                            AllowUserInput="true"
                                            SearchMode="ListSearchMode.AutoSearch" SearchFilterCondition="ListSearchFilterCondition.StartsWith" />
                            </DxFormLayoutItem>

                        </DxFormLayoutTabPage>
                        <DxFormLayoutTabPage Caption="E-Invoice Details">
                            <DxFormLayoutItem Caption="IRN No"></DxFormLayoutItem>
                            <DxFormLayoutItem Caption="ACK No"></DxFormLayoutItem>
                            <DxFormLayoutItem Caption="ACK Date"></DxFormLayoutItem>

                        </DxFormLayoutTabPage>

                    </DxFormLayoutTabPages>

                </DxFormLayoutGroup>

                <DxFormLayoutGroup ColSpanMd="6" Decoration="FormLayoutGroupDecoration.None">
                    <DxFormLayoutTabPages>
                        <DxFormLayoutTabPage Caption="Total Summary">
                            <DxFormLayoutItem Caption="Total Trip" ColSpanMd="4">
                                <Template><b>@TotalTrip</b></Template>
                            </DxFormLayoutItem>

                            <DxFormLayoutItem Caption="Gross Total" ColSpanMd="4">
                                <Template><b>@GrossTotal</b></Template>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Shortage(-)" ColSpanMd="4">
                                <Template><b>@ShortageAmount</b></Template>
                            </DxFormLayoutItem>

                            <DxFormLayoutItem Caption="Total Wt" ColSpanMd="4">
                                <Template><b>@TotalWeight</b></Template>
                            </DxFormLayoutItem>

                            <DxFormLayoutItem Caption="Tax Amount" ColSpanMd="4">
                                <Template><b>@TaxAmount</b></Template>
                            </DxFormLayoutItem>

                            <DxFormLayoutItem Caption="Extra Charge" ColSpanMd="4">
                                <Template>
                                    <DxSpinEdit Value="ExtraCharge"
                                                ValueChanged="@((double value) => OnExtraChargeChanged(value))"
                                                ShowSpinButtons="false" />
                                </Template>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Less Advance(-)" ColSpanMd="4">
                                <Template>
                                    <DxSpinEdit Value="LessAdvance"
                                                ValueChanged="@((double value) => OnLessAdvanceChanged(value))"
                                                ShowSpinButtons="false" />
                                </Template>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Total Bill Amount" ColSpanMd="4">
                                <Template><b>@TotalBillAmount</b></Template>
                            </DxFormLayoutItem>

                         

                        
                           
                            <DxFormLayoutItem Caption="Net Total" ColSpanMd="4" >
                                <DxSpinEdit @bind-Text="bill.BillNetAmount" T="int" ShowSpinButtons="false"></DxSpinEdit>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Is RCM Applicable" CaptionPosition="CaptionPosition.Vertical">
                                <DxCheckBox @bind-Checked="bill.BillIsRcm" />
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Round Off " CaptionPosition="CaptionPosition.Vertical">
                                <DxCheckBox @bind-Checked="bill.BillIsRoundOff" />
                            </DxFormLayoutItem>
                        </DxFormLayoutTabPage>

                        @* <DxFormLayoutItem Caption="Total Trip"> *@



                        <DxFormLayoutTabPage Caption="Account Summary">

                            <DxFormLayoutItem >
                                <Template>
                                    <b>No Fields</b>
                                </Template>
                            </DxFormLayoutItem>
                            
                        </DxFormLayoutTabPage>
                        <DxFormLayoutTabPage Caption="Tax Summary">
                            <DxFormLayoutItem Caption="SAC">
                                <DxTextBox @bind-Text=""></DxTextBox>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Taxable (Transport)"></DxFormLayoutItem>
                            <DxFormLayoutItem Caption="GST (%)"></DxFormLayoutItem>
                            <DxFormLayoutItem Caption="SAC"></DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Taxable (Other)"></DxFormLayoutItem>
                            <DxFormLayoutItem Caption="GST (%)"></DxFormLayoutItem>
                        </DxFormLayoutTabPage>
                    </DxFormLayoutTabPages>

                </DxFormLayoutGroup>
            </DxFormLayout>
        </div>
    </div>

    <div class="page-footer">
        <DxButton Text="Save"
                  RenderStyle="ButtonRenderStyle.Primary"
                  CssClass="me-2" />
        <DxButton Text="Cancel"
                  RenderStyle="ButtonRenderStyle.Secondary" />
    </div>

</div>

@code {

    private Lr lrs = new Lr();

    private IEnumerable<Account> partylist = new List<Account>();
    private IEnumerable<Lr> lrslist = new List<Lr>();
    private List<Lr> selectedLrs = new();
    private DateTime? fromDate;
    private DateTime? toDate;

    private Bill bill = new Bill();
    private List<Voucher> VoucherList = new();
    private List<State> stateList = new();

    private int TotalTrip;
    private double GrossTotal;
    private double TotalWeight;
    private double TaxAmount;
    private double ShortageAmount;
    private double ExtraCharge;
    private double LessAdvance;
    private double TotalBillAmount;
    private double NetTotal;



    public class SelectItem
    {
        public string Text { get; set; }
        public string Value { get; set; }
    }
    List<SelectItem> SupplyTypeList = new()
{
    new SelectItem { Text = "B2B", Value = "B2B" },
    new SelectItem { Text = "B2CS", Value = "B2CS" },
    new SelectItem { Text = "SEZWP", Value = "SEZWP" },
    new SelectItem { Text = "SEZWOP", Value = "SEZWOP" },
    new SelectItem { Text = "EXPWP", Value = "EXPWP" },
    new SelectItem { Text = "EXPWOP", Value = "EXPWOP" },
    new SelectItem { Text = "DEXP", Value = "DEXP" }
};
    protected override async Task OnInitializedAsync()
    {
        var list = await AccountService.GetAllAsync();
        var voucher = await VoucherService.GetAllAsync();
        stateList = await StateService.GetStatesAsync();
            VoucherList = voucher.Where(x => x.VoucherId == 1).ToList();
        partylist = list
            .Where(x => x.AccountTypeId == 18)
            .ToList();
    }

    private async Task SerchLrs()
    {
        if (lrs.LrPartyAccountId == 0)
            return;

        lrslist = await LrApiService.SearchAsync(
            lrs.LrPartyAccountId,
            fromDate,
            toDate);
    }

    private void OnExtraChargeChanged(double value)
    {
        ExtraCharge = value;
        RecalculateTotals();
    }

    private void OnLessAdvanceChanged(double value)
    {
        LessAdvance = value;
        RecalculateTotals();
    }

    private void RecalculateTotals()
    {
        TaxAmount = bill.BillIsRcm ? 0 : GrossTotal * 0.18;

        TotalBillAmount = GrossTotal + TaxAmount - ShortageAmount;

        NetTotal = TotalBillAmount + ExtraCharge - LessAdvance;

        if (bill.BillIsRoundOff)
            NetTotal = Math.Round(NetTotal);

        bill.BillNetAmount = (int)Math.Round(NetTotal);

        StateHasChanged();
    }


    private void OnSelectionChanged(IEnumerable<object> items)
    {
        var typedList = items?
            .Cast<Lr>()
            .ToList() ?? new List<Lr>();

        selectedLrs = typedList;

        CalculateSummary(typedList);
    }


    private void CalculateSummary(List<Lr> selected)
    {
        if (selected == null || !selected.Any())
        {
            TotalTrip = 0;
            GrossTotal = 0;
            TotalWeight = 0;
            ShortageAmount = 0;
        }
        else
        {
            TotalTrip = selected.Count;
            GrossTotal = selected.Sum(x => x.LrGrossFreightBill);
            TotalWeight = selected.Sum(x => x.LrLoadWt);
            ShortageAmount = 0;
        }

        RecalculateTotals();
    }


}
