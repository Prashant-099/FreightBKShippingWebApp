@page "/partybill"
@using FreightBKShipping.Client.Services
@using FreightBKShippingWebApp.Model
@using FreightBKShippingWebApp.Services

@inject LrApiService LrApiService
@inject AccountService AccountService
@inject VoucherService VoucherService
@inject StateService StateService
@inject GstSlabService GstSlabService

<style>
    :root {
        --clr-bg: #f4f6fb;
        --clr-surface: #ffffff;
        --clr-border: #e2e8f0;
        --clr-primary: #2563eb;
        --clr-primary-dk: #1d4ed8;
        --clr-accent: #0ea5e9;
        --clr-text: #1e293b;
        --clr-muted: #64748b;
        --clr-danger: #ef4444;
        --clr-success: #10b981;
        --radius-card: 12px;
        --radius-inner: 8px;
        --shadow-card: 0 1px 3px rgba(0,0,0,.08), 0 4px 16px rgba(0,0,0,.06);
        --shadow-footer: 0 -2px 12px rgba(0,0,0,.08);
        --font-main: 'Sora', 'Segoe UI', sans-serif;
    }
</style>

<div class="pb-page">

    <!-- ══ HEADER ══ -->
    <div class="pb-header">
        <div class="pb-header-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="1.75"
                 stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                <polyline points="14,2 14,8 20,8"/>
                <line x1="16" y1="13" x2="8" y2="13"/>
                <line x1="16" y1="17" x2="8" y2="17"/>
                <polyline points="10,9 9,9 8,9"/>
            </svg>
        </div>
        <div class="pb-header-divider"></div>
        <div class="pb-header-text">
            <h1>Party Bill</h1>
            <span>Generate & Manage Party Bills</span>
        </div>
        <div class="pb-header-badge">New Bill</div>
    </div>

    <div class="pb-form-scroll">

        <!-- ══ SEARCH FILTER CARD ══ -->
        <div class="pb-card">
            <div class="pb-card-header"><h2>Search LRs</h2></div>
            <div class="pb-card-body">
                <div class="field-grid">
                    <div class="field-group">
                        <label>Party</label>
                        <DxComboBox Data="partylist"
                                    TextFieldName="AccountName"
                                    ValueFieldName="AccountId"
                                    Value="@lrs.LrPartyAccountId"
                                    ValueChanged="@((int v) => OnPartyChanged(v))"
                                    ValueExpression="@(() => lrs.LrPartyAccountId)"
                                    ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                    AllowUserInput="true"
                                    NullText="Select party"
                                    SearchMode="ListSearchMode.AutoSearch"
                                    SearchFilterCondition="ListSearchFilterCondition.StartsWith" />
                    </div>
                    <div class="field-group">
                        <label>From Date</label>
                        <DxDateEdit @bind-Date="fromDate" DisplayFormat="dd-MM-yyyy" Format="dd-MM-yyyy" NullText="From date" />
                    </div>
                    <div class="field-group">
                        <label>To Date</label>
                        <DxDateEdit @bind-Date="toDate" DisplayFormat="dd-MM-yyyy" Format="dd-MM-yyyy" NullText="To date" />
                    </div>
                    <div class="field-group" style="justify-content:flex-end; padding-top:18px;">
                        <DxButton Text="Search" RenderStyle="ButtonRenderStyle.Primary" Click="SerchLrs" />
                    </div>
                </div>
            </div>
        </div>

        <!-- ══ LR LIST CARD ══ -->
        <div class="pb-card">
            <div class="pb-card-header">
                <h2>LR List</h2>
                @if (selectedLrs.Any())
                {
                    <span style="margin-left:auto; font-size:.72rem; color:var(--clr-primary); font-weight:600; background:#eff4ff; padding:3px 8px; border-radius:4px;">
                        @selectedLrs.Count selected
                    </span>
                }
            </div>
            <div class="pb-card-body" style="padding:0;">
                <div class="grid-wrapper">
                    <DxGrid Data="lrslist"
                            SelectedDataItems="selectedLrs"
                            SelectedDataItemsChanged="@OnSelectionChanged"
                            KeyFieldName="LrId"
                            PageSize="10"
                            ShowFilterRow="false"
                            ShowGroupPanel="false">
                        <Columns>
                            <DxGridSelectionColumn AllowSelectAll="true" Width="40" FixedPosition="GridColumnFixedPosition.Left" />
                            <DxGridDataColumn FieldName="SrNo"                Caption="Sr No"       Width="60px" />
                            <DxGridDataColumn FieldName="LrNoStr"             Caption="LR No"       Width="90px" />
                            <DxGridDataColumn FieldName="LrDate"              Caption="LR Date"     Width="100px" DisplayFormat="dd-MM-yyyy" />
                            <DxGridDataColumn FieldName="LrJobNo"             Caption="Job No"      Width="80px" />
                            <DxGridDataColumn FieldName="LrFromLocationId"    Caption="From"        Width="80px" />
                            <DxGridDataColumn FieldName="LrToLocationId"      Caption="To"          Width="80px" />
                            <DxGridDataColumn FieldName="LrVehicleId"         Caption="Vehicle"     Width="90px" />
                            <DxGridDataColumn FieldName="LrLoadWt"            Caption="Load Wt"     Width="80px" />
                            <DxGridDataColumn FieldName="LrUnloadWt"          Caption="Unload Wt"   Width="85px" />
                            <DxGridDataColumn FieldName="LrRateBill"          Caption="Rate"        Width="70px" />
                            <DxGridDataColumn FieldName="LrGrossFreightBill"  Caption="Gross Amt"   Width="90px" />
                            <DxGridDataColumn FieldName="LrPaymentType"       Caption="Pay Type"    Width="90px" />
                            <DxGridDataColumn FieldName="LrStatus"            Caption="Status"      Width="80px" />
                        </Columns>
                    </DxGrid>
                </div>
            </div>
        </div>

        <!-- ══ SUMMARY STATS ══ -->
        @if (selectedLrs.Any())
        {
            <div class="stat-row">
                <div class="stat-badge">
                    <span class="stat-label">Total Trips</span>
                    <span class="stat-value">@TotalTrip</span>
                </div>
                <div class="stat-badge">
                    <span class="stat-label">Gross Total</span>
                    <span class="stat-value">@GrossTotal.ToString("N2")</span>
                </div>
                <div class="stat-badge">
                    <span class="stat-label">Total Weight</span>
                    <span class="stat-value">@TotalWeight.ToString("F3")</span>
                </div>
                <div class="stat-badge">
                    <span class="stat-label">Net Bill</span>
                    <span class="stat-value" style="color:var(--clr-success);">@bill.BillTotal.ToString("N2")</span>
                </div>
            </div>
        }

        <!-- ══ BILL DETAILS + SUMMARY ══ -->
        <div class="two-col-layout">

            <!-- LEFT: Bill Details Tabs -->
            <div class="pb-tabs-wrapper">
                <DxTabs>

                    <!-- Bill Details -->
                    <DxTabPage Text="Bill Details">
                        <div class="pb-tab-body">
                            <div class="field-grid-2" style="margin-bottom:12px;">
                                <div class="field-group">
                                    <label>Bill Type</label>
                                    <DxComboBox Data="@VoucherList" @bind-Value="bill.BillType" />
                                </div>
                                <div class="field-group">
                                    <label>Bill No</label>
                                    <DxTextBox @bind-Text="bill.BillNo" />
                                </div>
                                <div class="field-group">
                                    <label>Bill Date</label>
                                    <DxMaskedInput @bind-Value="bill.BillDate" DisplayFormat="dd/MM/yyyy" />
                                </div>
                                <div class="field-group">
                                    <label>Due Date</label>
                                    <DxMaskedInput @bind-Value="bill.BillDueDate" />
                                </div>
                                <div class="field-group">
                                    <label>Place of Supply</label>
                                    <DxComboBox TData="State" TValue="int"
                                                Data="@stateList"
                                                TextFieldName="StateName"
                                                ValueFieldName="StateId"
                                                ClearButtonVisible="true"
                                                AllowUserInput="true"
                                                NullText="-- Select POS --"
                                                @bind-Value="bill.BillPlaceOfSupply"
                                                SearchMode="ListSearchMode.AutoSearch"
                                                SearchFilterCondition="ListSearchFilterCondition.StartsWith" />
                                </div>
                                <div class="field-group">
                                    <label>Ref No</label>
                                    <DxTextBox />
                                </div>
                            </div>
                            <div class="field-group">
                                <label>Remarks</label>
                                <DxMemo rows="2" @bind-Text="bill.BillRemarks" />
                            </div>
                        </div>
                    </DxTabPage>

                    <!-- Ship To -->
                    <DxTabPage Text="Ship To">
                        <div class="pb-tab-body">
                            <div class="field-grid-2" style="margin-bottom:12px;">
                                <div class="field-group" style="grid-column: span 2;">
                                    <label>Ship To Party</label>
                                    <DxComboBox Data="partylist"
                                                @bind-Value="bill.BillShipPartyId"
                                                TextFieldName="AccountName"
                                                ValueFieldName="AccountId" />
                                </div>
                                <div class="field-group">
                                    <label>State</label>
                                    <DxComboBox Data="@stateList" TData="State" TValue="int"
                                                TextFieldName="StateName" ValueFieldName="StateId"
                                                ClearButtonVisible="true" AllowUserInput="true"
                                                @bind-Value="bill.BillStateId"
                                                SearchMode="ListSearchMode.AutoSearch"
                                                SearchFilterCondition="ListSearchFilterCondition.StartsWith" />
                                </div>
                                <div class="field-group">
                                    <label>PIN</label>
                                    <DxTextBox @bind-Text="bill.BillPincode" />
                                </div>
                                <div class="field-group">
                                    <label>Contact</label>
                                    <DxTextBox @bind-Text="bill.BillContactNo" />
                                </div>
                                <div class="field-group">
                                    <label>Job No</label>
                                    <DxTextBox @bind-Text="bill.BillJobNo" />
                                </div>
                                <div class="field-group">
                                    <label>GSTIN</label>
                                    <DxTextBox @bind-Text="bill.BillGstNo" />
                                </div>
                                <div class="field-group">
                                    <label>BE No</label>
                                    <DxTextBox @bind-Text="bill.BillBlNo" />
                                </div>
                                <div class="field-group" style="grid-column: span 2;">
                                    <label>Supply Type</label>
                                    <DxComboBox Data="@SupplyTypeList"
                                                @bind-Value="bill.BillSupplyType"
                                                TextFieldName="Text"
                                                ValueFieldName="Value"
                                                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                                AllowUserInput="true"
                                                SearchMode="ListSearchMode.AutoSearch"
                                                SearchFilterCondition="ListSearchFilterCondition.StartsWith" />
                                </div>
                                <div class="field-group" style="grid-column: span 2;">
                                    <label>Address</label>
                                    <DxMemo @bind-Text="bill.BillAddress1" Rows="2" />
                                </div>
                            </div>
                        </div>
                    </DxTabPage>

                    <!-- E-Invoice -->
                    <DxTabPage Text="E-Invoice">
                        <div class="pb-tab-body">
                            <div class="field-grid-2">
                                <div class="field-group">
                                    <label>IRN No</label>
                                    <DxTextBox />
                                </div>
                                <div class="field-group">
                                    <label>ACK No</label>
                                    <DxTextBox />
                                </div>
                                <div class="field-group">
                                    <label>ACK Date</label>
                                    @* <DxDateEdit /> *@
                                </div>
                            </div>
                        </div>
                    </DxTabPage>

                </DxTabs>
            </div>

            <!-- RIGHT: Summary + Tax Tabs -->
            <div class="pb-tabs-wrapper">
                <DxTabs>

                    <!-- Total Summary -->
                    <DxTabPage Text="Total Summary">
                        <div class="pb-tab-body">
                            <table class="summary-table">
                                <tr>
                                    <td>Total Trip</td>
                                    <td>@TotalTrip</td>
                                </tr>
                                <tr>
                                    <td>Gross Total</td>
                                    <td>@GrossTotal.ToString("N2")</td>
                                </tr>
                                <tr>
                                    <td>Shortage (−)</td>
                                    <td>@ShortageAmount.ToString("N2")</td>
                                </tr>
                                <tr>
                                    <td>Total Weight</td>
                                    <td>@TotalWeight.ToString("F3")</td>
                                </tr>
                                <tr>
                                    <td>Tax Amount</td>
                                    <td>@(bill.BillIsRcm ? "0.00" : CalculatedGstAmount.ToString("F2"))</td>
                                </tr>
                                <tr>
                                    <td>Extra Charge</td>
                                    <td>
                                        <DxSpinEdit TValue="double"
                                                    Value="@ExtraCharge"
                                                    ValueChanged="@((double v) => { ExtraCharge = v; RecalculateTotals(); })"
                                                    ShowSpinButtons="false" />
                                    </td>
                                </tr>
                                <tr>
                                    <td>Less Advance (−)</td>
                                    <td>
                                        <DxSpinEdit TValue="double"
                                                    Value="@LessAdvance"
                                                    ValueChanged="@((double v) => { LessAdvance = v; RecalculateTotals(); })"
                                                    ShowSpinButtons="false" />
                                    </td>
                                </tr>
                                <tr class="highlight-row">
                                    <td>Total Bill Amount</td>
                                    <td>@TotalBillAmount.ToString("N2")</td>
                                </tr>
                                <tr>
                                    <td>Round Off</td>
                                    <td>@bill.BillRoundAmt.ToString("F2")</td>
                                </tr>
                                <tr class="total-row">
                                    <td>Net Total</td>
                                    <td>@bill.BillTotal.ToString("N2")</td>
                                </tr>
                            </table>

                            <div style="display:flex; gap:20px; margin-top:12px; padding-top:10px; border-top:1px solid var(--clr-border);">
                                <label class="check-row">
                                    <input type="checkbox"
                                           checked="@bill.BillIsRcm"
                                           @onchange="@((e) => { bill.BillIsRcm = (bool)e.Value!; RecalculateTotals(); })" />
                                    Is RCM Applicable
                                </label>
                                <label class="check-row">
                                    <input type="checkbox"
                                           checked="@bill.BillIsRoundOff"
                                           @onchange="@((e) => { bill.BillIsRoundOff = (bool)e.Value!; RecalculateTotals(); })" />
                                    Round Off
                                </label>
                            </div>
                        </div>
                    </DxTabPage>

                    <!-- Tax Summary -->
                    <DxTabPage Text="Tax Summary">
                        <div class="pb-tab-body">
                            <div style="display:flex; flex-direction:column; gap:14px;">

                                <div class="field-group">
                                    <label>SAC</label>
                                    <DxTextBox />
                                </div>

                                <div class="field-group">
                                    <label>Taxable Amount (Transport)</label>
                                    <DxSpinEdit TValue="double"
                                                Value="@bill.BillTaxableAmt"
                                                ValueChanged="@((double v) => { bill.BillTaxableAmt = v; RecalculateTotals(); })"
                                                ShowSpinButtons="false" />
                                </div>

                                <div class="field-group">
                                    <label>GST (%)</label>
                                    <div class="gst-row">
                                        <DxComboBox TData="GstSlab"
                                                    TValue="GstSlab"
                                                    Data="Gstperlist"
                                                    Value="@SelectedGstSlab"
                                                    ValueChanged="@((GstSlab v) => { SelectedGstSlab = v; RecalculateTotals(); })"
                                                    TextFieldName="GstSlabName" />
                                        <DxTextBox Text="@CalculatedGstAmount.ToString("F2")"
                                                   ReadOnly="true" />
                                    </div>
                                </div>

                                <table class="summary-table" style="margin-top:4px;">
                                    <tr>
                                        <td>CGST</td>
                                        <td>@bill.BillCgst.ToString("F2")</td>
                                    </tr>
                                    <tr>
                                        <td>SGST</td>
                                        <td>@bill.BillSgst.ToString("F2")</td>
                                    </tr>
                                    <tr>
                                        <td>IGST</td>
                                        <td>@bill.BillIgst.ToString("F2")</td>
                                    </tr>
                                    <tr class="highlight-row">
                                        <td>GST on Freight</td>
                                        <td>@bill.BillGstAmtFreight.ToString("F2")</td>
                                    </tr>
                                </table>

                                <div class="field-group" style="margin-top:8px;">
                                    <label>SAC (Other)</label>
                                    <DxTextBox />
                                </div>
                                <div class="field-group">
                                    <label>Taxable (Other)</label>
                                    @* <DxSpinEdit TValue="double" ShowSpinButtons="false" /> *@
                                </div>
                                <div class="field-group">
                                    <label>GST Amount (Other)</label>
                                    <DxTextBox Text="@bill.BillGstAmtCharge.ToString("F2")" ReadOnly="true" />
                                </div>

                            </div>
                        </div>
                    </DxTabPage>

                    <!-- Account Summary -->
                    <DxTabPage Text="Account Summary">
                        <div class="pb-tab-body">
                            <p style="color:var(--clr-muted); font-size:.85rem;">No account data available.</p>
                        </div>
                    </DxTabPage>

                </DxTabs>
            </div>

        </div>

    </div>

    <!-- ══ FOOTER ══ -->
    <div class="pb-footer">
        <div class="pb-footer-meta">
            Party: <strong>@(partylist.FirstOrDefault(x => x.AccountId == lrs.LrPartyAccountId)?.AccountName ?? "—")</strong>
            &nbsp;|&nbsp;
            Net Total: <strong>@bill.BillTotal.ToString("N2")</strong>
        </div>
        <button type="button" class="btn-back" style="margin-right:8px;">Cancel</button>
        <button type="button" class="btn-save" @onclick="SaveBill">✓ Save Bill</button>
    </div>

</div>

@code {

    private Lr lrs = new Lr();
    private Bill bill = new Bill();

    private IEnumerable<Account> partylist = new List<Account>();
    private IEnumerable<Lr> lrslist = new List<Lr>();
    private IEnumerable<GstSlab> Gstperlist = new List<GstSlab>();
    private List<Lr> selectedLrs = new();
    private List<Voucher> VoucherList = new();
    private List<State> stateList = new();

    private DateTime? fromDate;
    private DateTime? toDate;

    private int TotalTrip;
    private double GrossTotal;
    private double TotalWeight;
    private double ShortageAmount;
    private double ExtraCharge;
    private double LessAdvance;
    private double TotalBillAmount;
    private double NetTotal;

    private double CalculatedGstAmount;
    private GstSlab? SelectedGstSlab;
    private bool IsInterState = false;

    public class SelectItem
    {
        public string Text { get; set; } = "";
        public string Value { get; set; } = "";
    }

    private List<SelectItem> SupplyTypeList = new()
    {
        new SelectItem { Text = "B2B",    Value = "B2B" },
        new SelectItem { Text = "B2CS",   Value = "B2CS" },
        new SelectItem { Text = "SEZWP",  Value = "SEZWP" },
        new SelectItem { Text = "SEZWOP", Value = "SEZWOP" },
        new SelectItem { Text = "EXPWP",  Value = "EXPWP" },
        new SelectItem { Text = "EXPWOP", Value = "EXPWOP" },
        new SelectItem { Text = "DEXP",   Value = "DEXP" }
    };

    protected override async Task OnInitializedAsync()
    {
        var list    = await AccountService.GetAllAsync();
        var voucher = await VoucherService.GetAllAsync();
        Gstperlist  = await GstSlabService.GetAllAsync();
        stateList   = await StateService.GetStatesAsync();

        VoucherList = voucher.Where(x => x.VoucherId == 1).ToList();
        partylist   = list.Where(x => x.AccountTypeId == 18).ToList();
    }

    private async Task SerchLrs()
    {
        if (lrs.LrPartyAccountId == 0) return;
        lrslist = await LrApiService.SearchAsync(lrs.LrPartyAccountId, fromDate, toDate);
    }

    private void OnSelectionChanged(IEnumerable<object> items)
    {
        var typedList = items?.Cast<Lr>().ToList() ?? new List<Lr>();
        selectedLrs   = typedList;
        CalculateSummary(typedList);
    }

    private void CalculateSummary(List<Lr> selected)
    {
        if (selected == null || !selected.Any())
        {
            TotalTrip = 0; GrossTotal = 0; TotalWeight = 0; ShortageAmount = 0;
        }
        else
        {
            TotalTrip     = selected.Count;
            GrossTotal    = selected.Sum(x => (double)x.LrRateBill);
            TotalWeight   = Math.Round(selected.Sum(x => (double)x.LrLoadWt), 3);
            ShortageAmount = 0;
        }
        RecalculateTotals();
    }

    private void RecalculateTotals()
    {
        bill.BillTaxableAmt = GrossTotal - ShortageAmount;
        CalculateGst();

        TotalBillAmount = bill.BillTaxableAmt + CalculatedGstAmount;
        NetTotal        = TotalBillAmount + ExtraCharge - LessAdvance;

        if (bill.BillIsRoundOff)
        {
            double rounded    = Math.Round(NetTotal, MidpointRounding.AwayFromZero);
            bill.BillRoundAmt = rounded - NetTotal;
            NetTotal          = rounded;
        }
        else
        {
            bill.BillRoundAmt = 0;
        }

        bill.BillAmount    = GrossTotal;
        bill.BillTotal     = Math.Round(NetTotal, 2);
        bill.BillNetAmount = (float)bill.BillTotal;

        StateHasChanged();
    }

    private void CalculateGst()
    {
        if (bill.BillIsRcm)
        {
            bill.BillCgst = bill.BillSgst = bill.BillIgst = bill.BillGstAmtFreight = 0;
            CalculatedGstAmount = 0;
            return;
        }

        if (SelectedGstSlab == null || SelectedGstSlab.GstSlabType != "GST")
        {
            bill.BillCgst = bill.BillSgst = bill.BillIgst = bill.BillGstAmtFreight = 0;
            CalculatedGstAmount = 0;
            return;
        }

        double taxable = bill.BillTaxableAmt;

        if (IsInterState)
        {
            bill.BillIgst = Math.Round(taxable * SelectedGstSlab.GstSlabIgstPer / 100, 2);
            bill.BillCgst = 0;
            bill.BillSgst = 0;
        }
        else
        {
            bill.BillCgst = Math.Round(taxable * SelectedGstSlab.GstSlabCgstPer / 100, 2);
            bill.BillSgst = Math.Round(taxable * SelectedGstSlab.GstSlabSgstPer / 100, 2);
            bill.BillIgst = 0;
        }

        bill.BillGstAmtFreight  = bill.BillCgst + bill.BillSgst + bill.BillIgst;
        bill.BillGstIdFreight   = SelectedGstSlab.GstSlabId;
        CalculatedGstAmount     = bill.BillGstAmtFreight;
    }

    private void OnPartyChanged(int partyId)
    {
        lrs.LrPartyAccountId = partyId;
        var party = partylist.FirstOrDefault(x => x.AccountId == partyId);
        if (party == null) return;

        bill.BillShipPartyId  = party.AccountId;
        bill.BillAddress1     = party.AccountAddress1;
        bill.BillPincode      = party.AccountPincode;
        bill.BillContactNo    = party.AccountMobile;
        bill.BillGstNo        = party.AccountGstNo;
        bill.BillStateId      = party.AccountStateId ?? 0;
        bill.BillPlaceOfSupply = party.AccountStateId ?? 0;

        StateHasChanged();
    }

    private async Task SaveBill()
    {
        // TODO: wire up save logic
    }
}
