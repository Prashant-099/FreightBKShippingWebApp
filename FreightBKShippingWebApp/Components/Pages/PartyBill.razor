@page "/partybill"
@using FreightBKShipping.Client.Services
@using FreightBKShippingWebApp.Model
@using FreightBKShippingWebApp.Services

@inject LrApiService LrApiService
@inject AccountService AccountService
@inject VoucherService VoucherService
@inject StateService StateService
@inject GstSlabService GstSlabService

<style>
    .page-container {
        display: flex;
        flex-direction: column;
        height: 100vh;
        background-color: #fff;
    }

    .page-header {
        padding: 10px;
        background: white;
        border-bottom: 1px solid #e5e5e5;
    }

    .page-content {
        flex: 1;
        overflow-y: auto;
        padding: 20px;
        padding-bottom: 120px;
    }

    .page-footer {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        background: white;
        border-top: 1px solid #ddd;
        padding: 12px 24px;
        text-align: right;
        box-shadow: 0 -2px 8px rgba(0,0,0,0.05);
        z-index: 1000;
    }

    .grid-size {
        max-height: 280px;
    }
</style>

<div class="page-container">

    <div class="page-header d-flex align-items-center">
        <i class="bi bi-receipt me-2 py-2"></i>
        <span class="fs-5"><b>Party Bill</b></span>
    </div>

    <div class="page-content">

        <DxFormLayout>
            <DxFormLayoutItem Caption="Party" ColSpanMd="4">
                <DxComboBox Data="partylist"
                            TextFieldName="AccountName"
                            ValueFieldName="AccountId"
                            Value="@lrs.LrPartyAccountId"
                            ValueChanged="@( (int v) => OnPartyChanged(v) )"
                            ValueExpression="@(() => lrs.LrPartyAccountId)"

                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                            AllowUserInput="true"
                            SearchMode="ListSearchMode.AutoSearch"
                            SearchFilterCondition="ListSearchFilterCondition.StartsWith"
                            />
            </DxFormLayoutItem>
            <DxFormLayoutItem Caption="From Date" ColSpanMd="3">
                <DxDateEdit @bind-Date="fromDate" DisplayFormat="dd-MM-yyyy" Format="dd-MM-yyyy" NullText="Select From Date" />
            </DxFormLayoutItem>
            <DxFormLayoutItem Caption="To Date" ColSpanMd="3">
                <DxDateEdit @bind-Date="toDate" DisplayFormat="dd-MM-yyyy" Format="dd-MM-yyyy" NullText="Select To Date" />
            </DxFormLayoutItem>
            <DxFormLayoutItem ColSpanMd="2">
                <DxButton Text="Search" RenderStyle="ButtonRenderStyle.Primary" Click="SerchLrs" />
            </DxFormLayoutItem>
        </DxFormLayout>

        <br />

        <DxGrid Data="lrslist" SelectedDataItems="selectedLrs"
                SelectedDataItemsChanged="@OnSelectionChanged"
                KeyFieldName="LrId" PageSize="10" CssClass="grid-size">
            <Columns>
                <DxGridSelectionColumn AllowSelectAll="true" Width="40" FixedPosition="GridColumnFixedPosition.Left" />
                <DxGridDataColumn FieldName="SrNo" Caption="Sr No" Width="70" />
                <DxGridDataColumn FieldName="LrNoStr" Caption="LR No" />
                <DxGridDataColumn FieldName="LrDate" Caption="LR Date" DisplayFormat="dd-MM-yyyy" />
                <DxGridDataColumn FieldName="LrJobNo" Caption="Job No" />
                <DxGridDataColumn FieldName="LrPartyAccountId" Caption="Party" />
                <DxGridDataColumn FieldName="LrSupplierAccountId" Caption="Supplier" />
                <DxGridDataColumn FieldName="LrFromLocationId" Caption="From" />
                <DxGridDataColumn FieldName="LrToLocationId" Caption="To" />
                <DxGridDataColumn FieldName="LrVehicleId" Caption="Vehicle" />
                <DxGridDataColumn FieldName="LrDriverMobile" Caption="Driver Mobile" />
                <DxGridDataColumn FieldName="LrLoadWt" Caption="Load Wt" />
                <DxGridDataColumn FieldName="LrUnloadWt" Caption="Unload Wt" />
                <DxGridDataColumn FieldName="LrRateBill" Caption="Rate" />
                <DxGridDataColumn FieldName="LrNetFreightBill" Caption="Net Freight" />
                <DxGridDataColumn FieldName="LrPaymentType" Caption="Payment Type" />
                <DxGridDataColumn FieldName="LrStatus" Caption="Status" />
                <DxGridDataColumn FieldName="LrGrossFreightBill" Caption="Gross Amount" />
            </Columns>
        </DxGrid>

        <br />

        <div class="tab-section">
            <DxFormLayout>

                <!-- LEFT GROUP -->
                <DxFormLayoutGroup ColSpanMd="6" Decoration="FormLayoutGroupDecoration.None">
                    <DxFormLayoutTabPages>

                        <DxFormLayoutTabPage Caption="Bill Details">

                            <DxFormLayoutItem Caption="Bill Type" CaptionPosition="CaptionPosition.Vertical" ColSpanMd="4">
                                <DxComboBox Data="@VoucherList" @bind-Value="bill.BillType" />
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Bill Date" CaptionPosition="CaptionPosition.Vertical" ColSpanMd="4">
                                <DxMaskedInput @bind-Value="bill.BillDate" DisplayFormat="dd/MM/yyyy"/>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Due Date" CaptionPosition="CaptionPosition.Vertical" ColSpanMd="4">
                                <DxMaskedInput @bind-Value="bill.BillDueDate" />
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Bill No" CaptionPosition="CaptionPosition.Vertical" >
                                <DxTextBox @bind-Text="bill.BillNo" />
                            </DxFormLayoutItem>                            
                            <DxFormLayoutItem Caption="Place of Supply" CaptionPosition="CaptionPosition.Vertical">
                                <DxComboBox TData="State" TValue="int"
                                            Data="@stateList"
                                            TextFieldName="StateName"
                                            ValueFieldName="StateId"
                                            ClearButtonVisible="true"
                                            AllowUserInput="true"
                                            NullText="-- Select POS --"
                                            @bind-Value="bill.BillPlaceOfSupply"
                                            SearchMode="ListSearchMode.AutoSearch"
                                            SearchFilterCondition="ListSearchFilterCondition.StartsWith" />
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Ref No" CaptionPosition="CaptionPosition.Vertical">
                                <DxTextBox />
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Remarks" CaptionPosition="CaptionPosition.Vertical">
                                <DxMemo rows="1" @bind-Text="bill.BillRemarks" />
                            </DxFormLayoutItem>
                        </DxFormLayoutTabPage>

                        <DxFormLayoutTabPage Caption="Ship To">
                            <DxFormLayoutItem Caption="Ship To Party" CaptionPosition="CaptionPosition.Vertical" ColSpanMd="6">
                                <DxComboBox Data="partylist" @bind-Value="bill.BillShipPartyId" TextFieldName="AccountName"
                                            ValueFieldName="AccountId" />
                            </DxFormLayoutItem>

                            <DxFormLayoutItem Caption="State" CaptionPosition="CaptionPosition.Vertical" ColSpanMd="3"> 
                                <DxComboBox Data="@stateList" TData="State" TValue="int"
                                            TextFieldName="StateName"
                                            ValueFieldName="StateId"
                                            ClearButtonVisible="true"
                                            AllowUserInput="true"
                                            @bind-Value="bill.BillStateId"
                                            SearchMode="ListSearchMode.AutoSearch"
                                            SearchFilterCondition="ListSearchFilterCondition.StartsWith" />
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="PIN" CaptionPosition="CaptionPosition.Vertical" ColSpanMd="3">
                                <DxTextBox @bind-Text="bill.BillPincode" />
                            </DxFormLayoutItem>


                            <DxFormLayoutItem Caption="Contact" CaptionPosition="CaptionPosition.Vertical" ColSpanMd="3">
                                <DxTextBox @bind-Text="bill.BillContactNo" />
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Job No" CaptionPosition="CaptionPosition.Vertical" ColSpanMd="3">
                                <DxTextBox @bind-Text="bill.BillJobNo" />
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="GSTIN" CaptionPosition="CaptionPosition.Vertical" ColSpanMd="3">
                                <DxTextBox @bind-Text="bill.BillGstNo" />
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="BE No" CaptionPosition="CaptionPosition.Vertical" ColSpanMd="3">
                                <DxTextBox @bind-Text="bill.BillBlNo" />
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Supply Type" ColSpanMd="6" CaptionPosition="CaptionPosition.Vertical">
                                <DxComboBox Data="@SupplyTypeList"
                                            @bind-Value="bill.BillSupplyType"
                                            TextFieldName="Text"
                                            ValueFieldName="Value"
                                            ShowValidationIcon="true"
                                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                            AllowUserInput="true"
                                            SearchMode="ListSearchMode.AutoSearch"
                                            SearchFilterCondition="ListSearchFilterCondition.StartsWith" />
                            </DxFormLayoutItem>

                            <DxFormLayoutItem Caption="Address" CaptionPosition="CaptionPosition.Vertical">
                                <DxMemo @bind-Text="bill.BillAddress1" Rows="1" />
                            </DxFormLayoutItem>
                            
                           
                        </DxFormLayoutTabPage>

                        <DxFormLayoutTabPage Caption="E-Invoice Details">
                            <DxFormLayoutItem Caption="IRN No" CaptionPosition="CaptionPosition.Vertical"></DxFormLayoutItem>
                            <DxFormLayoutItem Caption="ACK No" CaptionPosition="CaptionPosition.Vertical"></DxFormLayoutItem>
                            <DxFormLayoutItem Caption="ACK Date" CaptionPosition="CaptionPosition.Vertical"></DxFormLayoutItem>
                        </DxFormLayoutTabPage>

                    </DxFormLayoutTabPages>
                </DxFormLayoutGroup>

                <!-- RIGHT GROUP -->
                <DxFormLayoutGroup ColSpanMd="6" Decoration="FormLayoutGroupDecoration.None">
                    <DxFormLayoutTabPages>

                        <DxFormLayoutTabPage Caption="Total Summary">
                            <DxFormLayoutItem Caption="Total Trip" ColSpanMd="4" CaptionPosition="CaptionPosition.Vertical">
                                <Template><b>@TotalTrip</b></Template>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Gross Total" ColSpanMd="4" CaptionPosition="CaptionPosition.Vertical">
                                <Template><b>@GrossTotal</b></Template>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Shortage(-)" ColSpanMd="4" CaptionPosition="CaptionPosition.Vertical">
                                <Template><b>@ShortageAmount</b></Template>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Total Wt" ColSpanMd="4" CaptionPosition="CaptionPosition.Vertical">
                                <Template><b>@TotalWeight.ToString("F3")</b></Template>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Tax Amount" ColSpanMd="4" CaptionPosition="CaptionPosition.Vertical">
                                <Template>
                                    <b>@(bill.BillIsRcm ? "0.00" : CalculatedGstAmount.ToString("F2"))</b>
                                </Template>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Extra Charge" ColSpanMd="4" CaptionPosition="CaptionPosition.Vertical">
                                <Template>
                                    <DxSpinEdit TValue="double"
                                                Value="@ExtraCharge"
                                                ValueChanged="@(async (double v) => { ExtraCharge = v; RecalculateTotals(); })"
                                                ShowSpinButtons="false" />
                                </Template>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Less Advance(-)" ColSpanMd="4" CaptionPosition="CaptionPosition.Vertical">
                                <Template>
                                    <DxSpinEdit TValue="double"
                                                Value="@LessAdvance"
                                                ValueChanged="@(async (double v) => { LessAdvance = v; RecalculateTotals(); })"
                                                ShowSpinButtons="false" />
                                </Template>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Total Bill Amount" ColSpanMd="4" CaptionPosition="CaptionPosition.Vertical">
                                <Template><b>@TotalBillAmount.ToString("N2")</b></Template>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Round Off Amount" ColSpanMd="4" CaptionPosition="CaptionPosition.Vertical">
                                <Template><b>@bill.BillRoundAmt.ToString("F2")</b></Template>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Net Total" ColSpanMd="4" CaptionPosition="CaptionPosition.Vertical">
                                <Template><b>@bill.BillTotal.ToString("N2")</b></Template>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Is RCM Applicable" CaptionPosition="CaptionPosition.Vertical" ColSpanMd="3">
                                <DxCheckBox Checked="@bill.BillIsRcm"
                                            CheckedChanged="@( (bool v) =>
                                                        {
                                                            bill.BillIsRcm = v;
                                                            RecalculateTotals();
                                                        })" />

                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Round Off" CaptionPosition="CaptionPosition.Vertical" ColSpanMd="2">
                                <DxCheckBox Checked="@bill.BillIsRoundOff"
                                            CheckedChanged="@(async (bool v) => { bill.BillIsRoundOff = v; RecalculateTotals(); })" />
                            </DxFormLayoutItem>
                        </DxFormLayoutTabPage>

                        <DxFormLayoutTabPage Caption="Account Summary">
                            <DxFormLayoutItem>
                                <Template><b>No Fields</b></Template>
                            </DxFormLayoutItem>
                        </DxFormLayoutTabPage>

                        <DxFormLayoutTabPage Caption="Tax Summary">

                            <DxFormLayoutItem Caption="SAC">
                                <DxTextBox />
                            </DxFormLayoutItem>

                            <DxFormLayoutItem Caption="Taxable (Transport)">
                                <DxSpinEdit TValue="double"
                                            Value="@bill.BillTaxableAmt"
                                            ValueChanged="@((double v) =>
                                          {
                                              bill.BillTaxableAmt = v;
                                              RecalculateTotals();
                                          })"
                                            ShowSpinButtons="false" />
                            </DxFormLayoutItem>

                            <DxFormLayoutItem Caption="GST (%)">
                                <div class="d-flex gap-2 align-items-center">
                                    <DxComboBox TData="GstSlab"
                                                TValue="GstSlab"
                                                Data="Gstperlist"
                                                Value="@SelectedGstSlab"
                                                ValueChanged="@((GstSlab v) =>
                                                {
                                                    SelectedGstSlab = v;
                                                    RecalculateTotals();
                                                })"
                                                TextFieldName="GstSlabName" />
                                    <DxTextBox Text="@CalculatedGstAmount.ToString("F2")"
                                               ReadOnly="true"
                                               Width="120px" />
                                </div>
                            </DxFormLayoutItem>

                            @* <DxFormLayoutItem Caption="CGST">
                                <Template><b>@bill.BillCgst.ToString("F2")</b></Template>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="SGST">
                                <Template><b>@bill.BillSgst.ToString("F2")</b></Template>
                            </DxFormLayoutItem>
                            <DxFormLayoutItem Caption="IGST">
                                <Template><b>@bill.BillIgst.ToString("F2")</b></Template>
                            </DxFormLayoutItem> *@

                            <DxFormLayoutItem Caption="SAC" CaptionPosition="CaptionPosition.Vertical"></DxFormLayoutItem>
                            <DxFormLayoutItem Caption="Taxable (Other)" CaptionPosition="CaptionPosition.Vertical"></DxFormLayoutItem>
                            <DxFormLayoutItem Caption="GST (%)" CaptionPosition="CaptionPosition.Vertical"></DxFormLayoutItem>
                            <DxFormLayoutItem Caption="GST Amount (Other)" CaptionPosition="CaptionPosition.Vertical">
                                <Template><b>@bill.BillGstAmtCharge.ToString("F2")</b></Template>
                            </DxFormLayoutItem>

                        </DxFormLayoutTabPage>

                    </DxFormLayoutTabPages>

                </DxFormLayoutGroup>

            </DxFormLayout>
        </div>
    </div>

    <div class="page-footer">
        <DxButton Text="Save" RenderStyle="ButtonRenderStyle.Primary" CssClass="me-2" />
        <DxButton Text="Cancel" RenderStyle="ButtonRenderStyle.Secondary" />
    </div>

</div>

@code {

    private Lr lrs = new Lr();
    private Bill bill = new Bill();

    private IEnumerable<Account> partylist = new List<Account>();
    private IEnumerable<Lr> lrslist = new List<Lr>();
    private IEnumerable<GstSlab> Gstperlist = new List<GstSlab>();
    private List<Lr> selectedLrs = new();
    private List<Voucher> VoucherList = new();
    private List<State> stateList = new();

    private DateTime? fromDate;
    private DateTime? toDate;

    private int TotalTrip;
    private double GrossTotal;
    private double TotalWeight;
    private double ShortageAmount;
    private double ExtraCharge;
    private double LessAdvance;
    private double TotalBillAmount;
    private double NetTotal;

    private double CalculatedGstAmount;
    private GstSlab? SelectedGstSlab;
    private bool IsInterState = false;

    public class SelectItem
    {
        public string Text { get; set; } = "";
        public string Value { get; set; } = "";
    }

    private List<SelectItem> SupplyTypeList = new()
    {
        new SelectItem { Text = "B2B",    Value = "B2B" },
        new SelectItem { Text = "B2CS",   Value = "B2CS" },
        new SelectItem { Text = "SEZWP",  Value = "SEZWP" },
        new SelectItem { Text = "SEZWOP", Value = "SEZWOP" },
        new SelectItem { Text = "EXPWP",  Value = "EXPWP" },
        new SelectItem { Text = "EXPWOP", Value = "EXPWOP" },
        new SelectItem { Text = "DEXP",   Value = "DEXP" }
    };

    protected override async Task OnInitializedAsync()
    {
        var list = await AccountService.GetAllAsync();
        var voucher = await VoucherService.GetAllAsync();
        Gstperlist = await GstSlabService.GetAllAsync();
        stateList = await StateService.GetStatesAsync();

        VoucherList = voucher.Where(x => x.VoucherId == 1).ToList();
        partylist = list.Where(x => x.AccountTypeId == 18).ToList();
    }

    private async Task SerchLrs()
    {
        if (lrs.LrPartyAccountId == 0) return;
        lrslist = await LrApiService.SearchAsync(lrs.LrPartyAccountId, fromDate, toDate);
    }

    private void OnSelectionChanged(IEnumerable<object> items)
    {
        var typedList = items?.Cast<Lr>().ToList() ?? new List<Lr>();
        selectedLrs = typedList;
        CalculateSummary(typedList);
    }

    private void CalculateSummary(List<Lr> selected)
    {
        if (selected == null || !selected.Any())
        {
            TotalTrip = 0; GrossTotal = 0; TotalWeight = 0; ShortageAmount = 0;
        }
        else
        {
            TotalTrip = selected.Count;
            GrossTotal = selected.Sum(x => (double)x.LrRateBill);
            TotalWeight = Math.Round(selected.Sum(x => (double)x.LrLoadWt), 3);
            ShortageAmount = 0;
        }
        RecalculateTotals();
    }

    private void RecalculateTotals()
    {
        bill.BillTaxableAmt = GrossTotal - ShortageAmount;

        CalculateGst();

        // Always add GST to total (RCM or not)
        TotalBillAmount = bill.BillTaxableAmt + CalculatedGstAmount;

        NetTotal = TotalBillAmount + ExtraCharge - LessAdvance;

        if (bill.BillIsRoundOff)
        {
            double rounded = Math.Round(NetTotal, MidpointRounding.AwayFromZero);
            bill.BillRoundAmt = rounded - NetTotal;
            NetTotal = rounded;
        }
        else
        {
            bill.BillRoundAmt = 0;
        }

        bill.BillAmount = GrossTotal;
        bill.BillTotal = Math.Round(NetTotal, 2);
        bill.BillNetAmount = (float)bill.BillTotal;

        StateHasChanged();
    }
    private void CalculateGst()
    {
        // RCM: buyer pays GST, seller does NOT charge it on the bill
        if (bill.BillIsRcm)
        {
            bill.BillCgst = 0;
            bill.BillSgst = 0;
            bill.BillIgst = 0;
            bill.BillGstAmtFreight = 0;
            CalculatedGstAmount = 0;
            return;
        }

        if (SelectedGstSlab == null || SelectedGstSlab.GstSlabType != "GST")
        {
            bill.BillCgst = 0;
            bill.BillSgst = 0;
            bill.BillIgst = 0;
            bill.BillGstAmtFreight = 0;
            CalculatedGstAmount = 0;
            return;
        }

        double taxable = bill.BillTaxableAmt;

        if (IsInterState)
        {
            bill.BillIgst = Math.Round(taxable * SelectedGstSlab.GstSlabIgstPer / 100, 2);
            bill.BillCgst = 0;
            bill.BillSgst = 0;
        }
        else
        {
            bill.BillCgst = Math.Round(taxable * SelectedGstSlab.GstSlabCgstPer / 100, 2);
            bill.BillSgst = Math.Round(taxable * SelectedGstSlab.GstSlabSgstPer / 100, 2);
            bill.BillIgst = 0;
        }

        bill.BillGstAmtFreight = bill.BillCgst + bill.BillSgst + bill.BillIgst;
        bill.BillGstIdFreight = SelectedGstSlab.GstSlabId;
        CalculatedGstAmount = bill.BillGstAmtFreight;
    }

    private void OnPartyChanged(int partyId)
    {
        lrs.LrPartyAccountId = partyId;

        var party = partylist.FirstOrDefault(x => x.AccountId == partyId);

        if (party == null)
            return;

        // Fill Ship To
        bill.BillShipPartyId = party.AccountId;

        // Fill Address Details
        bill.BillAddress1 = party.AccountAddress1;
        bill.BillPincode = party.AccountPincode;
        bill.BillContactNo = party.AccountMobile;
        bill.BillGstNo = party.AccountGstNo;

        // Fill State
        bill.BillStateId = party.AccountStateId ?? 0;
        bill.BillPlaceOfSupply = party.AccountStateId ?? 0;

        StateHasChanged();
    }

}