@page "/vehicle"
@using FreightBKShippingWebApp.Model
@using FreightBKShippingWebApp.Services

@inject VehicleService VehicleService
@inject ToasteService ToastService
@inject LoadingService LoadingService
@inject ConfirmationDialogService ConfirmDialogService

<DxGrid TItem="Vehicle"
        Data="@vehicleList"
        @ref="MyGrid"
        KeyFieldName="VehicleId"
        ColumnResizeMode="GridColumnResizeMode.ColumnsContainer"
        ShowFilterRow="true"
        ShowSearchBox="true"
        FocusedRowEnabled="true"
        SelectionMode="GridSelectionMode.Multiple"
        SelectedDataItems="@SelectedVehicles"
        SelectedDataItemsChanged="OnSelectedVehiclesChanged">

    <ToolbarTemplate Context="toolbarContext">

        <DxToolbar>
            <TitleTemplate Context="tl">
                <div class="d-flex align-items-center">
                    <i class="bi bi-diagram-3 me-2"></i>
                    <span class="fs-5">Vehicles</span>
                </div>
            </TitleTemplate>
            <Items>
                <DxToolbarItem Text="Add" IconCssClass="bi bi-plus-circle" Click="OnCreateNew" />
                <DxToolbarItem Text="Edit" IconCssClass="bi bi-pencil-square" Click="OnEdit" />
                <DxToolbarItem Text="Delete" IconCssClass="bi bi-trash" Click="OnDelete" />
                <DxToolbarItem Text="Refresh" IconCssClass="bi bi-arrow-clockwise" Click="@LoadVehiclesAsync" />
                <DxToolbarItem Alignment="ToolbarItemAlignment.Right"
                               RenderStyle="ButtonRenderStyle.Secondary"
                               IconCssClass="bi bi-gear-wide-connected"
                               Click="ShowLayoutPopup" />
            </Items>
        </DxToolbar>

    </ToolbarTemplate>

    <Columns>

        <DxGridSelectionColumn Width="40" />

        <DxGridDataColumn FieldName="VehicleNo"
                          Caption="Vehicle No"
                          Width="@(layoutManager?.GetColumnWidth("VehicleNo") ?? "300px")"
                          Visible="@(layoutManager?.GetColumnVisibility("VehicleNo") ?? true)" />

        <DxGridDataColumn FieldName="VehicleOwnerType"
                          Caption="Owner Type"
                          Width="@(layoutManager?.GetColumnWidth("VehicleOwnerType") ?? "350px")"
                          Visible="@(layoutManager?.GetColumnVisibility("VehicleOwnerType") ?? true)" />

        <DxGridDataColumn FieldName="VehicleMake"
                          Caption="Make"
                          Width="@(layoutManager?.GetColumnWidth("VehicleMake") ?? "350px")"
                          Visible="@(layoutManager?.GetColumnVisibility("VehicleMake") ?? true)" />

        <DxGridDataColumn FieldName="VehicleModel"
                          Caption="Model"
                          Width="@(layoutManager?.GetColumnWidth("VehicleModel") ?? "250px")"
                          Visible="@(layoutManager?.GetColumnVisibility("VehicleModel") ?? true)" />

        <DxGridDataColumn FieldName="VehicleLoadCapacity"
                          Caption="Capacity"
                          Width="@(layoutManager?.GetColumnWidth("VehicleLoadCapacity") ?? "120px")"
                          Visible="@(layoutManager?.GetColumnVisibility("VehicleLoadCapacity") ?? true)" />

        <DxGridDataColumn FieldName="VehicleStatus"
                          Caption="Status"
                          Width="@(layoutManager?.GetColumnWidth("VehicleStatus") ?? "100px")"
                          Visible="@(layoutManager?.GetColumnVisibility("VehicleStatus") ?? true)" />

    </Columns>
</DxGrid>


<VehicleAddEditPage @ref="popup" OnSaved="LoadVehiclesAsync" />


<ConfirmationDialog />

<GridLayoutpPopup @ref="layoutManager"
                  VoucherType="VehiclePage"
                  Columns="@allColumns"
                  OnLayoutChanged="HandleLayoutChanged" />


@code {

    DxGrid MyGrid;
    private List<Vehicle> vehicleList = new();
    private IReadOnlyList<object> SelectedVehicles { get; set; } = new List<object>();
    private VehicleAddEditPage popup;

    protected override async Task OnInitializedAsync()
    {
        InitializeColumns();
        await LoadVehiclesAsync();
    }

    private async Task LoadVehiclesAsync()
    {
        LoadingService.Show();
        try
        {
            vehicleList = await VehicleService.GetAllAsync();
        }
        finally
        {
            LoadingService.Hide();
        }
    }

    private async Task OnSelectedVehiclesChanged(IReadOnlyList<object> vehicles)
    {
        SelectedVehicles = vehicles ?? new List<object>();
        await InvokeAsync(StateHasChanged);
    }

    private void OnCreateNew(ToolbarItemClickEventArgs e)
    {
        popup.Show(new Vehicle());
    }

    private async Task OnEdit(ToolbarItemClickEventArgs e)
    {
        var vehicle = MyGrid.GetFocusedDataItem() as Vehicle;
        if (vehicle == null)
        {
            ToastService.Warning("Please select a vehicle to edit.");
            return;
        }

        popup.Show(vehicle);
    }

    private async Task OnDelete(ToolbarItemClickEventArgs e)
    {
        if (SelectedVehicles == null || SelectedVehicles.Count == 0)
        {
            ToastService.Warning("Please select at least one vehicle.");
            return;
        }

        var confirm = await ConfirmDialogService.ShowAsync(
            $"Are you sure you want to delete {SelectedVehicles.Count} vehicle(s)?");

        if (!confirm) return;

        LoadingService.Show();

        try
        {
            foreach (var vehicle in SelectedVehicles.Cast<Vehicle>())
            {
                await VehicleService.DeleteAsync(vehicle.VehicleId);
            }

            ToastService.Success("Vehicle(s) deleted successfully.");
            await LoadVehiclesAsync();
        }
        finally
        {
            LoadingService.Hide();
        }
    }

    private GridLayoutpPopup? layoutManager;
    private List<GridColumnLayout> allColumns = [];
    private void InitializeColumns()
    {
        allColumns = new List<GridColumnLayout>
    {
        new() { FieldName = "VehicleNo", Caption = "Vehicle No", Visible = true, Width = 270, DisplayIndex = 0 },
        new() { FieldName = "VehicleOwnerType", Caption = "Owner Type", Visible = true, Width = 240, DisplayIndex = 1 },
        new() { FieldName = "VehicleMake", Caption = "Make", Visible = true, Width = 250, DisplayIndex = 2 },
        new() { FieldName = "VehicleModel", Caption = "Model", Visible = true, Width = 150, DisplayIndex = 3 },
        new() { FieldName = "VehicleLoadCapacity", Caption = "Capacity", Visible = true, Width = 220, DisplayIndex = 4 },
        new() { FieldName = "VehicleStatus", Caption = "Status", Visible = true, Width = 100, DisplayIndex = 5 }
    };
    }
    private async void ShowLayoutPopup()
    {
        await InvokeAsync(() =>
        {
            layoutManager?.ShowPopup();
        });
    }
    private async Task HandleLayoutChanged(List<GridColumnLayout> updatedLayout)
    {
        allColumns = updatedLayout;
        // Force the grid to re-render with new layout
        await InvokeAsync(StateHasChanged);
    }

}