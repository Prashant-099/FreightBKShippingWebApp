@using FreightBKShippingWebApp.Model
@using FreightBKShippingWebApp.Services

@inject VehicleService VehicleService
@inject ToasteService ToastService
@inject LoadingService LoadingService
@inject AccountService AccountService
@inject AuditLogService AuditLogService
<DxPopup @bind-Visible="Visible"
         ShowCloseButton="true"
         HeaderText="@Title"
         MaxWidth="600"
         CloseOnOutsideClick="false"
         HorizontalAlignment="HorizontalAlignment.Center"
         VerticalAlignment="VerticalAlignment.Center"
         BodyCssClass="my-popup-body"
         ShowFooter="true"
         Scrollable="true">

    <BodyContentTemplate Context="bdyvehicle">
        <EditForm Model="@EditModel"
                  OnValidSubmit="HandleValidSubmit"
                  Context="ctxeditform"
                  id="vehicleForm">

            <DataAnnotationsValidator />

            <DxFormLayout>

                <DxFormLayoutItem Caption="Vehicle No">
                    <ChildContent Context="ctx">
                        <DxTextBox @bind-Text="EditModel.VehicleNo"
                                   ShowValidationIcon="true"
                                   ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                    </ChildContent>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="Owner Type">
                    <ChildContent Context="ctx">
                        <DxTextBox @bind-Text="EditModel.VehicleOwnerType"
                                   ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                    </ChildContent>
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Driver">
                    <ChildContent Context="ctx">
                        <DxComboBox Data="driverlist" @bind-Value="EditModel.VehicleDriverId"
                        TextFieldName="AccountName" ValueFieldName="AccountId"
                         ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                                AllowUserInput="true"
                                                SearchMode="ListSearchMode.AutoSearch"
                                                SearchFilterCondition="ListSearchFilterCondition.Contains"
                                    />
                    </ChildContent>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="Make">
                    <ChildContent Context="ctx">
                        <DxTextBox @bind-Text="EditModel.VehicleMake"
                                   ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                    </ChildContent>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="Model">
                    <ChildContent Context="ctx">
                        <DxTextBox @bind-Text="EditModel.VehicleModel"
                                   ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                    </ChildContent>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="Load Capacity">
                    <ChildContent Context="ctx">
                        <DxSpinEdit @bind-Value="EditModel.VehicleLoadCapacity"
                                    ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                    </ChildContent>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="Engine No">
                    <ChildContent Context="ctx">
                        <DxTextBox @bind-Text="EditModel.VehicleEngineNo"
                                   ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                    </ChildContent>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="Chassis No">
                    <ChildContent Context="ctx">
                        <DxTextBox @bind-Text="EditModel.VehicleChassisNo"
                                   ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                    </ChildContent>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="Insurance Expiry">
                    <ChildContent Context="ctx">
                        <DxDateEdit @bind-Date="EditModel.VehicleInsurance"
                                    ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                    </ChildContent>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="Fitness Expiry">
                    <ChildContent Context="ctx">
                        <DxDateEdit @bind-Date="EditModel.VehicleFitness"
                                    ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                    </ChildContent>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="Active">
                    <ChildContent Context="ctx">
                        <DxCheckBox @bind-Checked="IsActive" />
                    </ChildContent>
                </DxFormLayoutItem>

            </DxFormLayout>

        </EditForm>
    </BodyContentTemplate>

    <FooterContentTemplate Context="ftrvehicle">
        <div class="mt-3 text-end">
            <DxButton Text="Save"
                      RenderStyle="ButtonRenderStyle.Primary"
                      SubmitFormOnClick="true"
                      Form="vehicleForm" />

            <DxButton Text="Cancel"
                      RenderStyle="ButtonRenderStyle.Secondary"
                      Click="Hide" />
        </div>
    </FooterContentTemplate>

</DxPopup>

@code {

    [Parameter] public EventCallback OnSaved { get; set; }

    private bool Visible { get; set; }
    private string Title { get; set; } = "Add/Edit Vehicle";
    private Vehicle EditModel { get; set; } = new();
    private List<Account> driverlist = new();

    // private EditContext? editContext;
    private bool IsActive
    {
        get => EditModel.VehicleStatus == 1;
        set => EditModel.VehicleStatus = value ? 1 : 0;
    }

    protected override async Task OnInitializedAsync()
    {
        var driverlists = await AccountService.GetAllAsync();
        driverlist = driverlists.Where(a => a.AccountTypeId== 16).ToList();
    }


    public void Show(Vehicle vehicle)
    {
        if (vehicle != null && vehicle.VehicleId > 0)
        {
            EditModel = new Vehicle
            {
                VehicleId = vehicle.VehicleId,
                VehicleNo = vehicle.VehicleNo,
                VehicleOwnerType = vehicle.VehicleOwnerType,
                VehicleMake = vehicle.VehicleMake,
                VehicleModel = vehicle.VehicleModel,
                VehicleLoadCapacity = vehicle.VehicleLoadCapacity,
                VehicleEngineNo = vehicle.VehicleEngineNo,
                VehicleChassisNo = vehicle.VehicleChassisNo,
                VehicleInsurance = vehicle.VehicleInsurance,
                VehicleFitness = vehicle.VehicleFitness,
                VehicleStatus = vehicle.VehicleStatus,
                VehicleDriverId =vehicle.VehicleDriverId
            };

            Title = "Edit Vehicle";
        }
        else
        {
            EditModel = new Vehicle { VehicleStatus = 1 };
            Title = "Add Vehicle";
        }
     
        Visible = true;
    }

    private void Hide()
    {
        Visible = false;
    }

    private async Task HandleValidSubmit()
    {
        LoadingService.Show();

        try
        {
            bool result;

            if (EditModel.VehicleId == 0)
                result = await VehicleService.CreateAsync(EditModel);
            else
                result = await VehicleService.UpdateAsync(EditModel);

            if (result)
            {
                ToastService.Success("Vehicle saved successfully.");
                AuditLogService.NotifyAuditChanged();
                Visible = false;
                await OnSaved.InvokeAsync();
            }
            else
            {
                ToastService.Error(VehicleService.LastError ?? "Failed to save vehicle.");
            }
        }
        finally
        {
            LoadingService.Hide();
        }
    }
}