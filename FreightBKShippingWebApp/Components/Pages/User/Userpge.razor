@page "/user"
@using FreightBKShippingWebApp.Model
@using FreightBKShippingWebApp.Services
@inject UserService UserService
@inject ToasteService ToastService
@inject LoadingService LoadingService
@inject ConfirmationDialogService ConfirmDialogService
@inject GridLayoutService GridLayoutService
<style>
    .grid-size {
        max-height: 600px;
    }


    /* ComboBox Styling */
    .layout-combobox {
        border-radius: 6px;
        width: 185px;
    }
</style>
<DxGrid TItem="User"
        Data="@userList"
        @ref="MyGrid"
        KeyFieldName="UserId"
        ShowSearchBox="true"
        PageSize="10"
        PageSizeSelectorVisible="true"
        ShowGroupPanel="true"
        FilterMenuButtonDisplayMode="GridFilterMenuButtonDisplayMode.Always"
        FocusedRowEnabled="true"
        SelectionMode="GridSelectionMode.Multiple"
        SelectedDataItems="@SelectedUsers"
        SelectedDataItemsChanged="OnSelectedUsersChanged"
        ColumnResizeMode="GridColumnResizeMode.NextColumn"
        CssClass="grid-size"
        AllowSelectRowByClick="true">

    <ToolbarTemplate>
        <DxToolbar>
            <TitleTemplate Context="tl">
                <div class="d-flex align-items-center">
                    <i class="bi bi-people me-2"></i>
                    <span class="fs-5">Users</span>
                </div>
            </TitleTemplate>
            <Items>
                <DxToolbarItem Text="Add" IconCssClass="bi bi-plus-circle" Click="OnCreateNew" />
                <DxToolbarItem Text="Edit" IconCssClass="bi bi-pencil-square" Click="OnEdit" />
                <DxToolbarItem Text="Delete" IconCssClass="bi bi-trash" Click="OnDelete" />
                <DxToolbarItem Text="Refresh" IconCssClass="bi bi-arrow-clockwise" Click="@LoadUsersAsync" />
             <DxToolbarItem BeginGroup="true"  IconCssClass="bi bi-gear-wide-connected" Alignment="ToolbarItemAlignment.Right">
                    <Template Context="ctx">
                        
                                <DxComboBox Data="@availableLayouts"
                                            Value="@selectedLayoutId"
                                            ValueExpression="@(() => selectedLayoutId)"
                                            ValueChanged="@((int? value) => OnLayoutSelectedAsync(value))"
                                            ValueFieldName="GridLayoutId"
                                            TextFieldName="GridLayoutName"
                                            NullText="Default View"
                                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                            CssClass="layout-combobox" />
                           
                    </Template>
                    
                </DxToolbarItem>
                <DxToolbarItem BeginGroup="true" Context="cfdr"
                               Alignment="ToolbarItemAlignment.Right"
                               RenderStyleMode="ToolbarItemRenderStyleMode.Contained"
                               RenderStyle="ButtonRenderStyle.Secondary"
                               IconCssClass="bi bi-gear-wide-connected">
                    <Items>
                        <DxToolbarItem Text="Save Current Layout"
                                       RenderStyle="ButtonRenderStyle.Primary"
                                       IconCssClass="bi bi-floppy"
                                       Click="ShowSaveLayoutDialog" />

                        <DxToolbarItem Text="Create New Layout"
                                       RenderStyle="ButtonRenderStyle.Success"
                                       IconCssClass="bi bi-plus-square"
                                       Click="ShowNewLayoutDialog" />

                        @if (selectedLayoutId.HasValue)
                        {
                            <DxToolbarItem Text="Delete Current Layout"
                                           RenderStyle="ButtonRenderStyle.Danger"
                                           IconCssClass="bi bi-trash"
                                           Click="DeleteCurrentLayout" />
                        }

                    </Items>
                </DxToolbarItem>
               
                   
               


            </Items>
        </DxToolbar>
    </ToolbarTemplate>

    <Columns>
       
            <DxGridSelectionColumn Width="30" FixedPosition="GridColumnFixedPosition.Left" />

            <DxGridDataColumn FieldName="UserId" Caption="ID"
                              Visible="@GetColumnVisibility("UserId")"
                              Width="@GetColumnWidth("UserId")" />

            <DxGridDataColumn FieldName="UserName" Caption="User Name"
                              Visible="@GetColumnVisibility("UserName")"
                              Width="@GetColumnWidth("UserName")" />

            <DxGridDataColumn FieldName="UserFirstName" Caption="First Name"
                              Visible="@GetColumnVisibility("UserFirstName")"
                              Width="@GetColumnWidth("UserFirstName")" />

            <DxGridDataColumn FieldName="UserLastName" Caption="Last Name"
                              Visible="@GetColumnVisibility("UserLastName")"
                              Width="@GetColumnWidth("UserLastName")" />

            <DxGridDataColumn FieldName="UserEmail" Caption="Email"
                              Visible="@GetColumnVisibility("UserEmail")"
                              Width="@GetColumnWidth("UserEmail")" />

            <DxGridDataColumn FieldName="UserMobile" Caption="Mobile"
                              Visible="@GetColumnVisibility("UserMobile")"
                              Width="@GetColumnWidth("UserMobile")" />

          
            <DxGridDataColumn FieldName="UserCreated" Caption="Created On"
                              DisplayFormat="dd/MM/yyyy"
                              Visible="@GetColumnVisibility("UserCreated")"
                              Width="@GetColumnWidth("UserCreated")" />

            <DxGridDataColumn FieldName="UserStatus" Caption="Status"/>
        </Columns>
</DxGrid>
@if (showLayoutDialog)
{
    <div class="modal fade show d-block"
         style="background-color: rgba(0, 0, 0, 0.5); z-index: 1050;"
         @onclick="@(() => { })">

        <div class="modal-dialog modal-lg" @onclick:stopPropagation="true">
            <div class="modal-content">

                <!-- Header -->
                <div class="modal-header">
                    <h5 class="modal-title">@dialogTitle</h5>
                    <button type="button"
                            class="btn-close"
                            @onclick="CloseLayoutDialog"
                            aria-label="Close">
                    </button>
                </div>

                <!-- Body -->
                <div class="modal-body">

                    <!-- Layout Name -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">Layout Name:</label>
                        <input type="text"
                               class="form-control"
                               @bind="newLayoutName"
                               @bind:event="oninput"
                               placeholder="Enter layout name..."
                               maxlength="100" />
                    </div>

                    <!-- Default Layout Checkbox -->
                    <div class="mb-3">
                        <div class="form-check">
                            <input class="form-check-input"
                                   type="checkbox"
                                   @bind="isDefaultLayout"
                                   id="defaultLayoutCheck" />

                            <label class="form-check-label" for="defaultLayoutCheck">
                                Set as Default Layout
                            </label>
                        </div>
                    </div>

                    <!-- Column Configuration -->
                    <div class="mt-3">
                        <label class="form-label fw-bold mb-2">Column Configuration:</label>

                        <div class="table-responsive"
                             style="max-height: 400px; overflow-y: auto;">

                            <table class="table table-sm table-bordered">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th style="width: 50px;">Visible</th>
                                        <th style="width: 200px;">Column Name</th>
                                        <th style="width: 150px;">Width (px)</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var col in allColumns)
                                    {
                                        <tr>
                                            <td class="text-center">
                                                <input class="form-check-input"
                                                       type="checkbox"
                                                       @bind="col.Visible"
                                                       id="col_@col.FieldName" />
                                            </td>

                                            <td>
                                                <label class="mb-0" for="col_@col.FieldName">
                                                    @col.Caption
                                                </label>
                                            </td>

                                            <td>
                                                <input type="number"
                                                       class="form-control form-control-sm"
                                                       @bind="col.Width"
                                                       @bind:event="oninput"
                                                       min="50"
                                                       max="500"
                                                       step="10"
                                                       placeholder="Width" />
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>

                        </div>
                    </div>

                    <!-- Info Note -->
                    <div class="alert alert-info mt-3">
                        <i class="bi bi-info-circle me-2"></i>
                        <strong>Note:</strong>
                        Adjust column widths here manually. The widths will be saved and applied when you load this layout.
                    </div>

                </div>

                <!-- Footer -->
                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            @onclick="CloseLayoutDialog">
                        Cancel
                    </button>

                    <button type="button"
                            class="btn btn-primary"
                            @onclick="SaveCurrentLayout">
                        <i class="bi bi-floppy me-1"></i>
                        @(isEditMode ? "Update" : "Create") Layout
                    </button>
                </div>

            </div>
        </div>

    </div>
}
<UserAddEditPage @ref="popup" OnSaved="LoadUsersAsync" />
<ConfirmationDialog />

@code {
    DxGrid MyGrid;
    private List<User> userList = new();
    // private List<User> SelectedUsers = new();
    private IReadOnlyList<object> SelectedUsers { get; set; } = new List<object>();
    private UserAddEditPage popup;
    // Grid Layout Management Variables
    private List<GridLayoutDto> availableLayouts = [];
    private int? selectedLayoutId;
    private bool showLayoutDialog = false;
    private string newLayoutName = "";
    private string dialogTitle = "";
    private bool isEditMode = false;
    private bool isDefaultLayout = false;
    private const string VOUCHER_TYPE = "User";

    // All possible columns
    private List<GridColumnLayout> allColumns = [];
    private List<GridColumnLayout> currentLayout = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadUsersAsync();
        InitializeColumns();
        await LoadAvailableLayouts();
        await LoadDefaultLayout();
    }
    private void InitializeColumns()
    {
        allColumns = new List<GridColumnLayout>
    {
        new() { FieldName = "UserId", Caption = "ID", Visible = false, Width = 80, DisplayIndex = 0 },

        new() { FieldName = "UserName", Caption = "User Name", Visible = true, Width = 200, DisplayIndex = 1 },
        new() { FieldName = "UserFirstName", Caption = "First Name", Visible = true, Width = 150, DisplayIndex = 2 },
        new() { FieldName = "UserLastName", Caption = "Last Name", Visible = true, Width = 150, DisplayIndex = 3 },

        new() { FieldName = "UserEmail", Caption = "Email", Visible = true, Width = 250, DisplayIndex = 4 },
        new() { FieldName = "UserMobile", Caption = "Mobile", Visible = true, Width = 150, DisplayIndex = 5 },

        // new() { FieldName = "UserStatus", Caption = "Status", Visible = true, Width = 120, DisplayIndex = 6 },
        new() { FieldName = "UserCreated", Caption = "Created On", Visible = true, Width = 150, DisplayIndex = 6 }
    };
        currentLayout = allColumns.Select(c => new GridColumnLayout
        {
            FieldName = c.FieldName,
            Caption = c.Caption,
            Visible = c.Visible,
            Width = c.Width,
            DisplayIndex = c.DisplayIndex
        }).ToList();
    }

    private int ParseWidth(string width)
    {
        if (string.IsNullOrEmpty(width))
            return 100;

        width = width.Replace("px", "").Trim();

        if (int.TryParse(width, out int result))
            return result;

        return 100;
    }

    private string GetColumnWidth(string fieldName)
    {
        if (currentLayout == null || !currentLayout.Any())
        {
            var defaultCol = allColumns.FirstOrDefault(x => x.FieldName == fieldName);
            return $"{defaultCol?.Width ?? 100}px";
        }

        var col = currentLayout.FirstOrDefault(x => x.FieldName == fieldName);
        return $"{col?.Width ?? 100}px";
    }

    private bool GetColumnVisibility(string fieldName)
    {
        if (currentLayout == null || !currentLayout.Any())
        {
            return true;
        }

        var col = currentLayout.FirstOrDefault(x => x.FieldName == fieldName);
        return col?.Visible ?? true;
    }

    // private void Grid_ColumnResizing(GridColumnResizeMode e)
    // {
    //     var col = currentLayout.FirstOrDefault(x => x.FieldName == e.Column.FieldName);
    //     if (col != null)
    //     {
    //         col.Width = ParseWidth(e.Width);
    //     }
    // }

    private async Task LoadAvailableLayouts()
    {
        availableLayouts = await GridLayoutService.GetLayoutsByVoucherTypeAsync(VOUCHER_TYPE);
    }

    private async Task LoadDefaultLayout()
    {
        var defaultLayout = await GridLayoutService.GetDefaultLayoutAsync(VOUCHER_TYPE);
        if (defaultLayout != null)
        {
            selectedLayoutId = defaultLayout.GridLayoutId;
            await ApplyLayout(defaultLayout);
        }
    }

    private async Task OnLayoutSelectedAsync(int? layoutId)
    {
        selectedLayoutId = layoutId;

        if (layoutId.HasValue)
        {
            var layout = await GridLayoutService.GetByIdAsync(layoutId.Value);
            if (layout != null)
            {
                await ApplyLayout(layout);
            }
        }
        else
        {
            InitializeColumns();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ApplyLayout(GridLayoutDto layout)
    {
        if (!string.IsNullOrEmpty(layout.GridLayoutData))
        {
            var savedLayout = GridLayoutService.DeserializeColumnLayout(layout.GridLayoutData);
            if (savedLayout != null && savedLayout.Any())
            {
                currentLayout = savedLayout.Select(s => new GridColumnLayout
                {
                    FieldName = s.FieldName,
                    Caption = s.Caption,
                    Visible = s.Visible,
                    Width = s.Width,
                    DisplayIndex = s.DisplayIndex
                }).ToList();

                foreach (var saved in savedLayout)
                {
                    var existing = allColumns.FirstOrDefault(x => x.FieldName == saved.FieldName);
                    if (existing != null)
                    {
                        existing.Visible = saved.Visible;
                        existing.Width = saved.Width;
                        existing.DisplayIndex = saved.DisplayIndex;
                    }
                }

                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void ShowSaveLayoutDialog()
    {
        if (selectedLayoutId.HasValue)
        {
            var layout = availableLayouts.FirstOrDefault(x => x.GridLayoutId == selectedLayoutId.Value);
            if (layout != null)
            {
                newLayoutName = layout.GridLayoutName ?? "";
                isDefaultLayout = layout.GridLayoutDefault;
                isEditMode = true;
                dialogTitle = "Update Grid Layout";
                showLayoutDialog = true;
                return;
            }
        }

        ShowNewLayoutDialog();
    }

    private void ShowNewLayoutDialog()
    {
        newLayoutName = "";
        isDefaultLayout = false;
        isEditMode = false;
        dialogTitle = "Create New Grid Layout";
        showLayoutDialog = true;
    }

    private async Task SaveCurrentLayout()
    {
        if (string.IsNullOrWhiteSpace(newLayoutName))
        {
            ToastService.Warning("Please enter a layout name.");
            return;
        }

        LoadingService.Show("Saving layout...");
        try
        {
            foreach (var col in allColumns)
            {
                var current = currentLayout.FirstOrDefault(c => c.FieldName == col.FieldName);
                if (current != null)
                {
                    current.Visible = col.Visible;
                    current.Width = col.Width;
                    current.DisplayIndex = col.DisplayIndex;
                }
                else
                {
                    currentLayout.Add(new GridColumnLayout
                    {
                        FieldName = col.FieldName,
                        Caption = col.Caption,
                        Visible = col.Visible,
                        Width = col.Width,
                        DisplayIndex = col.DisplayIndex
                    });
                }
            }

            var configJson = GridLayoutService.SerializeColumnLayout(currentLayout);
            bool success = false;

            if (isEditMode && selectedLayoutId.HasValue)
            {
                var updateRequest = new SaveGridLayoutRequest
                {
                    GridLayoutName = newLayoutName,
                    GridLayoutVoucherType = VOUCHER_TYPE,
                    GridLayoutData = configJson,
                    GridLayoutDefault = isDefaultLayout
                };
                success = await GridLayoutService.UpdateAsync(selectedLayoutId.Value, updateRequest);
            }
            else
            {
                var newLayoutRequest = new SaveGridLayoutRequest
                {
                    GridLayoutName = newLayoutName,
                    GridLayoutVoucherType = VOUCHER_TYPE,
                    GridLayoutData = configJson,
                    GridLayoutDefault = isDefaultLayout
                };
                var result = await GridLayoutService.CreateAsync(newLayoutRequest);
                success = result;

                if (success)
                {
                    await LoadAvailableLayouts();
                    var createdLayout = availableLayouts.FirstOrDefault(l => l.GridLayoutName == newLayoutName);
                    if (createdLayout != null)
                        selectedLayoutId = createdLayout.GridLayoutId;
                }
            }

            if (success)
            {
                ToastService.Success($"Grid layout {(isEditMode ? "updated" : "created")} successfully!");
                await LoadAvailableLayouts();

                if (isDefaultLayout)
                {
                    await LoadDefaultLayout();
                }

                CloseLayoutDialog();
                await InvokeAsync(StateHasChanged);
            }
            else
            {
                ToastService.Error($"Failed to {(isEditMode ? "update" : "create")} grid layout.");
            }
        }
        catch (Exception ex)
        {
            ToastService.Error($"Error saving layout: {ex.Message}");
            Console.WriteLine($"Layout save error: {ex}");
        }
        finally
        {
            LoadingService.Hide();
        }
    }

    private async Task DeleteCurrentLayout()
    {
        if (!selectedLayoutId.HasValue) return;

        var confirm = await ConfirmDialogService.ShowAsync(
            "Are you sure you want to delete this grid layout?");

        if (!confirm) return;

        LoadingService.Show("Deleting layout...");
        try
        {
            var success = await GridLayoutService.DeleteAsync(selectedLayoutId.Value);

            if (success)
            {
                ToastService.Success("Grid layout deleted successfully!");

                selectedLayoutId = null;
                InitializeColumns();
                currentLayout = allColumns.ToList();

                await LoadAvailableLayouts();
                await InvokeAsync(StateHasChanged);
            }
            else
            {
                ToastService.Error("Failed to delete grid layout.");
            }
        }
        catch (Exception ex)
        {
            ToastService.Error($"Error deleting layout: {ex.Message}");
        }
        finally
        {
            LoadingService.Hide();
        }
    }

    private void CloseLayoutDialog()
    {
        showLayoutDialog = false;
        newLayoutName = "";
        isDefaultLayout = false;
        isEditMode = false;
    }
    private async Task LoadUsersAsync()
    {
        LoadingService.Show();
        try
        {
            userList = await UserService.GetAllAsync();
        }
        finally
        {
            LoadingService.Hide();
        }
    }

    private async Task OnSelectedUsersChanged(IReadOnlyList<object> users)
    {
        SelectedUsers = users ?? new List<object>();
        await InvokeAsync(StateHasChanged);
    }
    // ✅ FIXED: Reliable clear selection method
    private async Task ClearSelectionManual()
    {
        try
        {
            if (MyGrid != null)
            {
                MyGrid.ClearSelection(); // ✅ Synchronous method
            }
            SelectedUsers = new List<User>();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Clear selection error: {ex.Message}");
        }
    }

    // ✅ FIXED: Auto-clear after operations
    private async Task ClearSelection()
    {
        await Task.Delay(100); // Small delay for UI update
        await ClearSelectionManual();
    }

    private void OnCreateNew(ToolbarItemClickEventArgs e)
    {
        popup.Show(new User(),true);
    }

    private async Task OnEdit(ToolbarItemClickEventArgs e)
    {
        var user = MyGrid.GetFocusedDataItem() as User;
        if (user != null)
            popup.Show(user,false);
        else
            ToastService.Warning("Please select a user to edit.");


        await ClearSelection();
    }

    private async Task OnDelete(ToolbarItemClickEventArgs e)
    {
        if (SelectedUsers == null || SelectedUsers.Count == 0)
        {
            ToastService.Warning("Please select at least one user to delete.");
            return;
        }
        var selectedList = SelectedUsers.Cast<User>().ToList();
        var confirm = await ConfirmDialogService.ShowAsync(
            $"Are you sure you want to delete {SelectedUsers.Count} selected user(s)?");
        if (!confirm)
        {
            await ClearSelection(); // ✅ Clear on cancel
            return;
        }
        try
        {
            LoadingService.Show("Deleting...");
            int successCount = 0, failCount = 0;

            foreach (var user in selectedList)
            {
                var result = await UserService.DeleteAsync(user.UserId);
                if (result) successCount++; else failCount++;
            }
            if (successCount > 0) ToastService.Success($"{successCount} Branch(s) Deleted Successfully.");
            if (failCount > 0) ToastService.Error($"{failCount} Branch(s) Failed To Delete.");

            await LoadUsersAsync();
        }
        finally
        {
            LoadingService.Hide();
            await ClearSelection();
        }
    }
}
