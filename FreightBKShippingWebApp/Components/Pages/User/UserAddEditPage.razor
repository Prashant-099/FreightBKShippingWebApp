@using FreightBKShippingWebApp.Model
@using FreightBKShippingWebApp.Services
@using System.Text.Json
@inject UserService UserService
@inject ToasteService ToastService
@inject LoadingService LoadingService
@inject UserRoleService UserRoleService
@inject BranchService BranchService

<DxPopup @bind-Visible="Visible" ShowCloseButton="true" HeaderText="@Title" CloseOnOutsideClick="false" MaxWidth="600px" horizontalAlignment="HorizontalAlignment.Center"
         verticalAlignment="VerticalAlignment.Center" BodyCssClass="my-popup-body" ShowFooter="true" scrollable="true">
   <BodyContentTemplate Context="bdybrnch">
        <EditForm Model="@EditModel" OnValidSubmit="HandleValidSubmit" Context="ctxuseraddedits" id="Userform">
        <DataAnnotationsValidator />
       @*  <ValidationSummary /> *@

        <DxFormLayout>

            <DxFormLayoutItem Caption="User Name" ColSpanMd="12">
                    <DxTextBox @bind-Text="EditModel.UserName" ShowValidationIcon="true" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
            </DxFormLayoutItem> 

            <DxFormLayoutItem Caption="First Name" ColSpanMd="12">
                    <DxTextBox @bind-Text="EditModel.UserFirstName" ShowValidationIcon="true" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="Last Name" ColSpanMd="12">
                    <DxTextBox @bind-Text="EditModel.UserLastName" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="Email" ColSpanMd="12">
                    <DxTextBox @bind-Text="EditModel.UserEmail" ShowValidationIcon="true" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
            </DxFormLayoutItem>
                @if (IsNewUser)
                {
                    <DxFormLayoutItem Caption="Password" ColSpanMd="12">

                        <div style="position: relative;">
                            

                            <DxTextBox @bind-Text="EditModel.UserPassword"
                                       Password="@(!showPassword)" 
                                       NullText="Password must be atleast 6 characters/digits"
                                       ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                            <span class="oi @(showPassword ? "bi bi-eye" : "bi bi-eye-slash") myIcon"
                                  style="cursor:pointer; position:absolute; right:35px; top:50%; transform:translateY(-50%); z-index:10;"
                                  @onclick="TogglePasswordVisibility">
                            </span>
                        </div>

                    </DxFormLayoutItem>
                }
@* 
            <DxFormLayoutItem Caption="Branch" ColSpanMd="12">
                <DxComboBox Data="@branchList"
                            TextFieldName="BranchName"
                            ValueFieldName="BranchId"
                                @bind-Value="EditModel.UserBranchId"
                                SearchMode="ListSearchMode.AutoSearch"
                                SearchFilterCondition="ListSearchFilterCondition.Contains" 
                                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"></DxComboBox>

                                <DxListBox TData="Branch"
            TValue="int"
           Data="@branchList"
           TextFieldName="BranchName"
           ValueFieldName="BranchId"
           @bind-SelectedValues="EditModel.AssignedBranchIds"
           ValuesExpression="() => EditModel.AssignedBranchIds"
           SelectionMode="ListBoxSelectionMode.Multiple"
           ShowClearButton="true" />
           </DxFormLayoutItem> *@

                    <DxFormLayoutItem Caption="Assigned Branches" ColSpanMd="12">

                        <DxTagBox Data="@branchList" Context="ctxtag"
                                  ListRenderMode="ListRenderMode.Virtual"
                                  @bind-Values="SelectedBranches"
                                  TextFieldName="@nameof(Branch.BranchName)"
                                  ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                  NullText="Selected branches will appear here..." />

                    </DxFormLayoutItem>


            <DxFormLayoutItem Caption="Address" ColSpanMd="12">
                    <DxMemo @bind-Text="EditModel.UserAddress" Rows="2" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="Mobile" ColSpanMd="12">
                    <DxTextBox @bind-Text="EditModel.UserMobile" 
                   NullText="Enter mobile number 10 digit only" ShowValidationIcon="true" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
            </DxFormLayoutItem>
        
            <DxFormLayoutItem Caption="Role" ColSpanMd="6">
                <DxComboBox Data="@rolelist"
                            TextFieldName="RoleName"
                            ValueFieldName="RoleUuid"
                                @bind-Value="EditModel.UserRoleId"
                                SearchMode="ListSearchMode.AutoSearch" ShowValidationIcon="true"
                                SearchFilterCondition="ListSearchFilterCondition.Contains" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"></DxComboBox>
            </DxFormLayoutItem>
            <DxFormLayoutItem Caption="Status" ColSpanMd="6">
                    <DxCheckBox @bind-Checked="EditModel.UserStatus" />
            </DxFormLayoutItem>
            

        </DxFormLayout>

       
    </EditForm>
     </BodyContentTemplate>
    <FooterContentTemplate Context="ftrbrnch">
        <div class="mt-3 text-end">
            <DxButton Text="Save" RenderStyle="ButtonRenderStyle.Primary" SubmitFormOnClick="true" Form="Userform" />
            <DxButton Text="Cancel" RenderStyle="ButtonRenderStyle.Secondary" Click="Hide" />
        </div>
    </FooterContentTemplate>
</DxPopup>

@code {
    // private IEnumerable<int> SelectedBranchIds { get; set; } = new List<int>();

    // void OnBranchesSelected(IEnumerable<int> values)
    // {
    //     SelectedBranchIds = values.ToList();
    //     You can optionally do more here
    // }
    [Parameter]
    public bool Password { get; set; }
    private bool showPassword = false;
    private bool Visible { get; set; }
    private string Title { get; set; } = "Add/Edit User";
    private User EditModel { get; set; } = new();


    private List<UserRole> rolelist = new();
    private IEnumerable<Branch> branchList { get; set; } = new List<Branch>();
    private IEnumerable<Branch> SelectedBranches { get; set; } = new List<Branch>();

    private void TogglePasswordVisibility()
    {
        showPassword = !showPassword;
    }
    protected override async Task OnInitializedAsync()
    {
        rolelist = await UserRoleService.GetAllAsync();
        branchList = await BranchService.GetAllAsync();
    }
    // private bool IsActive
    // {
    //     get => EditModel.UserStatus == 1;
    //     set => EditModel.UserStatus = value ? (byte)1 : (byte)0;
    // }

    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public bool IsNewUser { get; set; } = true; // true => create, false => edit
    // private EditContext? editContext;
    public void Show(User user, bool isNew)
    {
        if (user.UserId != null)
        {
            IsNewUser = isNew;
            //EditModel = user;
            var json = JsonSerializer.Serialize(user);
            EditModel = JsonSerializer.Deserialize<User>(json) ?? new User();
            Title = "Edit User";
            if (!string.IsNullOrEmpty(EditModel?.UserId))
            {
                SelectedBranches = branchList
                    .Where(b => EditModel.AssignedBranchIds.Contains(b.BranchId))
                    .ToList();
            }
            else
            {
                SelectedBranches = new List<Branch>();
            }

        }
        else
        {
            IsNewUser = true;
            EditModel = new User { UserStatus =true};

            Title = "Add User";
        }
        showPassword = false;
        // Create EditContext when showing the form
        // editContext = new EditContext(EditModel);
       
    Visible = true;
        StateHasChanged();
    }
    
    private void Hide() => Visible = false;

    private async Task HandleValidSubmit()
    {
        LoadingService.Show();
        try
        {
            EditModel.AssignedBranchIds = SelectedBranches
                   .Select(b => b.BranchId)
                   .ToList();

           bool isNew = string.IsNullOrEmpty(EditModel.UserId);
            if (isNew && string.IsNullOrWhiteSpace(EditModel.UserPassword))
            {
                ToastService.Error("Password is required for new user!");
                return;
            }
            bool success = isNew
                ? await UserService.CreateAsync(EditModel)
                : await UserService.UpdateAsync(EditModel);

            if (!success)
            {
                ToastService.Error(isNew ? "User creation failed!" : "User update failed!");
                return;
            }

            ToastService.Success(isNew ? "User created successfully!" : "User updated successfully!");
            Visible = false;
            await OnSaved.InvokeAsync();
        }
        finally
        {
            LoadingService.Hide();
        }
    }
}
