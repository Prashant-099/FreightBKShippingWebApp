    int? FindVoucherId(string voucherType, int? branchId)
    {
        if (branchId == null || string.IsNullOrWhiteSpace(voucherType))
            return null;

        var key = voucherType.Trim().ToUpper();

        if (VoucherMap.TryGetValue((branchId.Value, key), out var directId))
            return directId;

        if (VoucherGroupMap.TryGetValue((branchId.Value, key), out var groupId))
            return groupId;

        return null;
    }


    private (int? saleAcc, int? igstAcc, int? cgstAcc, int? sgstAcc, int? hsnId, string slabName, List<string> errs)
    ResolveGstForService(int serviceId, string voucherGroup)
    {
        var errs = new List<string>();
        var service = ServicesList.FirstOrDefault(s => s.ServiceId == serviceId);
        if (service == null) { errs.Add("Service master not found"); return (null,null,null,null,null,null,errs); }

        var hsn = HsnList.FirstOrDefault(h => h.HsnName == service.HsnName);
        if (hsn == null) { errs.Add($"HSN not found for service '{service.ServiceName}'"); return (null,null,null,null,null,null,errs); }

        var slab = GstslabList.FirstOrDefault(g => g.GstSlabId == hsn.HsnGstSlabId);
        if (slab == null) { errs.Add($"GST Slab not mapped for HSN '{hsn.HsnName}'"); return (null,null,null,null,hsn.HsnId,null,errs); }

        int? saleAcc = null, igstAcc = null, cgstAcc = null, sgstAcc = null;
        var grp = voucherGroup?.Trim().ToUpperInvariant();

        if (grp == "SALES")
        {
            saleAcc = slab.GstSlabSalesAccountId; igstAcc = slab.GstSlabIgstAccountId;
            cgstAcc = slab.GstSlabCgstAccountId; sgstAcc = slab.GstSlabSgstAccountId;
        }
        else if (grp == "PURCHASE")
        {
            saleAcc = slab.GstSlabPurchaseAccountId; igstAcc = slab.GstSlabPigstAccountId;
            cgstAcc = slab.GstSlabPcgstAccountId; sgstAcc = slab.GstSlabPsgstAccountId;
        }
        else if (grp == "CREDIT NOTE")
        {
            var salesReturnAcc = Accounts.FirstOrDefault(x =>
                x.AccountName != null && x.AccountName.Contains("Sales Return", StringComparison.OrdinalIgnoreCase));
            if (salesReturnAcc == null) errs.Add("Sales Return Account not found");
            else saleAcc = salesReturnAcc.AccountId;
            igstAcc = slab.GstSlabPigstAccountId; cgstAcc = slab.GstSlabPcgstAccountId; sgstAcc = slab.GstSlabPsgstAccountId;
        }

        return (saleAcc, igstAcc, cgstAcc, sgstAcc, hsn.HsnId, slab.GstSlabName, errs);
    }

    async Task ReadBillExcel()
    {
        if (SelectedFile == null)
            return;

        await LoadMasters();      // for Account map (party + gst ledger a/c lookups)
        await LoadBillMasters();  // for Service / State / Voucher maps
        PreviewData.Clear();

        using var stream = SelectedFile.OpenReadStream(20 * 1024 * 1024);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        ms.Position = 0;

        using var package = new ExcelPackage(ms);
        var ws = package.Workbook.Worksheets.First();

        if (ws.Dimension == null)
            return;

        var map = ExcelService.ReadHeader(ws);
        ExcelColumns = map.Columns.Keys.ToList();

        foreach (var col in RequiredBillColumns)
        {
            if (!map.Has(col))
                throw new Exception($"Excel Column Missing: {col}");
        }

        int totalRows = ws.Dimension.End.Row;

        // collect non-blank data rows, in original order
        var rowNumbers = new List<int>();
        for (int row = 2; row <= totalRows; row++)
        {
            if (!ExcelService.IsBlankRow(ws, row))
                rowNumbers.Add(row);
        }

        // group by Voucher No, preserving first-seen order
        var groups = rowNumbers
            .GroupBy(r => ExcelService.GetText(ws, map, r, "Voucher No"))
            .ToList();

        foreach (var grp in groups)
        {
            var rowsInGroup = grp.ToList();
            int firstRow = rowsInGroup.First();
            int lastRow = rowsInGroup.Last();

            var billErrors = new List<string>();
            var rowMessages = rowsInGroup.ToDictionary(r => r, r => new List<string>());

            // ---------------- Header-level fields (from first row of group) ----------------
            string voucherNo = grp.Key;
            string branch = ExcelService.GetText(ws, map, firstRow, "Branch");
            string voucherType = ExcelService.GetText(ws, map, firstRow, "Voucher Type");
            string partyName = ExcelService.GetText(ws, map, firstRow, "Buyer/Supplier");
            string ShippartyName = ExcelService.GetText(ws, map, firstRow, "ShipParty");
            string posName = ExcelService.GetText(ws, map, firstRow, "Place of Supply");
