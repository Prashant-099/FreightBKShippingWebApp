    async Task ReadReceiptExcel()
    {
        if (SelectedFile == null)
            return;

        await LoadMasters();          // for AccountMap (party + bank lookups)
        await LoadReceiptMasters();   // for RECEIPT voucher
        PreviewData.Clear();

        using var stream = SelectedFile.OpenReadStream(20 * 1024 * 1024);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        ms.Position = 0;

        using var package = new ExcelPackage(ms);
        var ws = package.Workbook.Worksheets.First();

        if (ws.Dimension == null)
            return;

        var map = ExcelService.ReadHeader(ws);
        ExcelColumns = map.Columns.Keys.ToList();

        foreach (var col in RequiredReceiptColumns)
        {
            if (!map.Has(col))
                throw new Exception($"Excel Column Missing: {col}");
        }

        int totalRows = ws.Dimension.End.Row;

        for (int row = 2; row <= totalRows; row++)
        {
            if (ExcelService.IsBlankRow(ws, row))
                continue;

            var errors = new List<string>();

            string partyName = ExcelService.GetText(ws, map, row, "Account Name");
            string bankName = ExcelService.GetText(ws, map, row, "Cash/Bank");
            string branch = ExcelService.GetText(ws, map, row, "Branch");
            double receiptAmt = ExcelService.GetDouble(ws, map, row, "Receipt Amt") ?? 0;
            double discount = ExcelService.GetDouble(ws, map, row, "Discount") ?? 0;
            double shortage = ExcelService.GetDouble(ws, map, row, "Short") ?? 0;
            double tds = ExcelService.GetDouble(ws, map, row, "Tds") ?? 0;

            DateTime date = ExcelService.GetDate(ws, map, row, "Date") ?? DateTime.Today;
            string receiptNo = ExcelService.GetText(ws, map, row, "Receipt No");
            //branch 
            int? branchid = FindBranchId(branch);
            if (branchid == null)
                errors.Add($"Account '{branch}' not found. Please create Account master.");

                int? receiptVoucherId = ReceiptVouchers
    .Where(v =>
        !string.IsNullOrWhiteSpace(v.VoucherGroup) &&
        v.VoucherGroup.Trim().Equals("RECEIPT", StringComparison.OrdinalIgnoreCase) &&
    v.VoucherBranchId == branchid)
    .Select(v => (int?)v.VoucherId)
    .FirstOrDefault();

            if (!string.IsNullOrWhiteSpace(receiptNo) && receiptVoucherId != null && branchid != null)
            {
                bool exists = await JournalService.ExistsAsync(
                    receiptNo,
                    branchid,
                    receiptVoucherId.Value,
                    YearStatechangeService.SelectedYearId);

                if (exists && !AllowDuplicate)
                    errors.Add($"Receipt No '{receiptNo}' already exists.");
            }
            // ---- Party ----
            int? partyId = FindAccountId(partyName);
            if (partyId == null)
                errors.Add($"Account '{partyName}' not found. Please create Account master.");

            // ---- Bank/Cash ----
            int? bankId = FindAccountId(bankName);
            if (bankId == null)
                errors.Add($"Cash/Bank '{bankName}' not found. Please create Account master.");

            // ---- Receipt voucher ----
            if (receiptVoucherId == null)
                errors.Add("RECEIPT voucher not found for current branch. Please create Voucher master.");

            if (receiptAmt <= 0)
                errors.Add("Receipt Amt must be greater than 0.");
           

            // ✅ ALL ON ACCOUNT — no bill-to-bill.
            // OnAccount = ReceiptAmt - (discount + tds + shortage), clamped at 0.
            double onAccount = Math.Max(receiptAmt - discount - tds - shortage, 0);

            var journal = new Journal
            {
                JournalVoucherId = receiptVoucherId ?? 0,
                JournalBranchId = branchid??0,
                JournalYearId = YearStatechangeService.SelectedYearId,
                JournalNoStr = receiptNo,
                 JournalNo= 0,
                JournalPartyId = partyId ?? 0,
                JournalAccountId = bankId ?? 0,
                JournalMasterType = "RECEIPT",
                JournalRefType = "Cr",
                JournalDate = date,
                JournalAmount = receiptAmt,
                JournalTotalDiscount = (float)discount,
                JournalTotalShort = (float)shortage,
                JournalTotalTds = (float)tds,
                JournalOnAccount = (float)onAccount,
                JournalTotal = receiptAmt,   // total received
                JournalChqNo = ExcelService.GetText(ws, map, row, "Chq.No."),
                JournalChqDate = ExcelService.GetText(ws, map, row, "Chq.Date"),
                JournalRemarks = ExcelService.GetText(ws, map, row, "Remarks"),
                JournalStatus = true,
                JournalCreated = DateTime.Now,
                JournalUpdated = DateTime.Now,

                // On-account => NO bill settlement rows
                BillRefDetails = new List<BillRefDetail>()
            };

            string status = errors.Any() ? "Error" : "Ready";

            dynamic obj = new ExpandoObject();
            var dict = (IDictionary<string, object?>)obj;

            dict["RowNo"] = row;
            dict["Status"] = status;
            dict["Message"] = string.Join(", ", errors);

            foreach (var col in ExcelColumns)
                dict[col] = ExcelService.GetText(ws, map, row, col);

            dict["Data"] = journal;

            PreviewData.Add(obj);
        }
    }

    async Task SaveReceipts()
    {
        bool hasError = PreviewData
            .Select(x => (IDictionary<string, object?>)x)
            .Any(d => d.TryGetValue("Status", out var status) &&
                      status?.ToString() == "Error");

        if (hasError)
        {
            ToastService.Error("Errors present. Please fix all errors before saving. No data was imported.");
            return;
        }

        var receipts = PreviewData
            .Select(x => (IDictionary<string, object?>)x)
            .Where(d =>
                d.TryGetValue("Status", out var status) &&
                status?.ToString() == "Ready" &&
                d.TryGetValue("Data", out var data) &&
                data is Journal)
            .Select(d => (Journal)d["Data"]!)
            .ToList();

        if (!receipts.Any())
        {
            ToastService.Error("PLEASE IMPORT CORRECT DATA");
            return;
        }

        foreach (var j in receipts)
            j.JournalYearId = YearStatechangeService.SelectedYearId;

        var result = await JournalService.BulkCreateAsync(receipts);

        if (result == null)
        {
            ToastService.Error(JournalService.LastError ?? "Bulk import failed.");
            return;
        }

        // Match by Receipt No column back to preview rows
        foreach (var item in result.Items)
        {
            foreach (var row in PreviewData)
            {
                var rd = (IDictionary<string, object?>)row;
                if (rd.TryGetValue("Receipt No", out var rno) &&
                    rno?.ToString() == item.JournalNoInput)
                {
                    rd["Status"] = item.Success ? "Saved" : "Error";
                    rd["Message"] = item.Success ? $"Imported (Journal Id {item.JournalId})" : item.Error;
                }
            }
        }

        if (result.FailCount == 0)
            ToastService.Success($"{result.SuccessCount} receipt(s) imported successfully.");
        else
            ToastService.Warning($"{result.SuccessCount} imported, {result.FailCount} failed. Check Message column.");

        StateHasChanged();
    }

