            int? partyId = FindAccountId(partyName);
            if (partyId == null)
                billErrors.Add($"Party '{partyName}' not found. Please create Account master.");

            int? ShippartyId = FindAccountId(ShippartyName);
            if (ShippartyId == null)
                billErrors.Add($"ShipParty '{ShippartyName}' not found. Please create Account master.");



