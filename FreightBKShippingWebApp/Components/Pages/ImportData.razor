    async Task ReadContraExcel()
    {
        if (SelectedFile == null)
            return;

        await LoadMasters();        // AccountMap (from + to account lookups)
        await LoadContraMasters();  // CONTRA voucher
        PreviewData.Clear();

        using var stream = SelectedFile.OpenReadStream(20 * 1024 * 1024);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        ms.Position = 0;

        using var package = new ExcelPackage(ms);
        var ws = package.Workbook.Worksheets.First();

        if (ws.Dimension == null)
            return;

        var map = ExcelService.ReadHeader(ws);
        ExcelColumns = map.Columns.Keys.ToList();

        foreach (var col in RequiredContraColumns)
        {
            if (!map.Has(col))
                throw new Exception($"Excel Column Missing: {col}");
        }

        int totalRows = ws.Dimension.End.Row;

        for (int row = 2; row <= totalRows; row++)
        {
            if (ExcelService.IsBlankRow(ws, row))
                continue;

            var errors = new List<string>();

            string branch = ExcelService.GetText(ws, map, row, "Branch");
            string fromName = ExcelService.GetText(ws, map, row, "From Account");
            string toName = ExcelService.GetText(ws, map, row, "To Account");
            double amount = ExcelService.GetDouble(ws, map, row, "Amount") ?? 0;
            DateTime date = ExcelService.GetDate(ws, map, row, "Date") ?? DateTime.Today;
            string contraNo = ExcelService.GetText(ws, map, row, "Contra No");

            // ---- Branch ----
            int? branchid = FindBranchId(branch);
            if (branchid == null)
                errors.Add($"Branch '{branch}' not found. Please create Branch master.");

            // ---- CONTRA voucher for this branch ----
            int? contraVoucherId = ContraVouchers
                .Where(v =>
                    !string.IsNullOrWhiteSpace(v.VoucherGroup) &&
                    v.VoucherGroup.Trim().Equals("CONTRA", StringComparison.OrdinalIgnoreCase) &&
                    v.VoucherBranchId == branchid)
                .Select(v => (int?)v.VoucherId)
                .FirstOrDefault();

            if (contraVoucherId == null)
                errors.Add($"CONTRA voucher not found for branch '{branch}'. Please create Voucher master.");

            // ---- Duplicate check ----
            if (!string.IsNullOrWhiteSpace(contraNo) && contraVoucherId != null && branchid != null)
            {
                bool exists = await JournalService.ExistsAsync(
                    contraNo,
                    branchid,
                    contraVoucherId.Value,
                    YearStatechangeService.SelectedYearId);

                if (exists && !AllowDuplicate)
                    errors.Add($"Contra No '{contraNo}' already exists.");
            }

            // ---- From Account (=> JournalAccountId) ----
            int? fromId = FindAccountId(fromName);
            if (fromId == null)
                errors.Add($"From Account '{fromName}' not found. Please create Account master.");

            // ---- To Account (=> JournalPartyId) ----
            int? toId = FindAccountId(toName);
            if (toId == null)
                errors.Add($"To Account '{toName}' not found. Please create Account master.");

            // ---- Same account guard ----
            if (fromId != null && toId != null && fromId == toId)
                errors.Add("'From' and 'To' accounts cannot be the same.");

            if (amount <= 0)
                errors.Add("Amount must be greater than 0.");

            var journal = new Journal
            {
                JournalVoucherId = contraVoucherId ?? 0,
                JournalBranchId = branchid ?? 0,
                JournalYearId = YearStatechangeService.SelectedYearId,
                JournalNoStr = contraNo,
                JournalNo = 0,
                JournalAccountId = fromId ?? 0,   // From
                JournalPartyId = toId ?? 0,       // To
                JournalMasterType = "CONTRA",
                JournalRefType = "Cr",
                JournalDate = date,
                JournalAmount = amount,
                JournalOnAccount = (float)amount,
                JournalTotal = amount,            // controller's isContra uses JournalTotal
                JournalChqNo = ExcelService.GetText(ws, map, row, "Ref_No"),
                JournalChqDate = ExcelService.GetText(ws, map, row, "Ref_Date"),
                JournalRemarks = ExcelService.GetText(ws, map, row, "Remarks"),
                JournalStatus = true,
                JournalCreated = DateTime.Now,
                JournalUpdated = DateTime.Now,

                // Contra has no bill settlements
                BillRefDetails = new List<BillRefDetail>()
            };

            string status = errors.Any() ? "Error" : "Ready";

            dynamic obj = new ExpandoObject();
            var dict = (IDictionary<string, object?>)obj;

            dict["RowNo"] = row;
            dict["Status"] = status;
            dict["Message"] = string.Join(", ", errors);

            foreach (var col in ExcelColumns)
                dict[col] = ExcelService.GetText(ws, map, row, col);

            dict["Data"] = journal;

            PreviewData.Add(obj);
        }
    }

    async Task SaveContra()
    {
        bool hasError = PreviewData
            .Select(x => (IDictionary<string, object?>)x)
            .Any(d => d.TryGetValue("Status", out var status) &&
                      status?.ToString() == "Error");

        if (hasError)
        {
            ToastService.Error("Errors present. Please fix all errors before saving. No data was imported.");
            return;
        }

        var contras = PreviewData
            .Select(x => (IDictionary<string, object?>)x)
            .Where(d =>
                d.TryGetValue("Status", out var status) &&
                status?.ToString() == "Ready" &&
                d.TryGetValue("Data", out var data) &&
                data is Journal)
            .Select(d => (Journal)d["Data"]!)
            .ToList();

        if (!contras.Any())
        {
            ToastService.Error("PLEASE IMPORT CORRECT DATA");
            return;
        }

        foreach (var j in contras)
            j.JournalYearId = YearStatechangeService.SelectedYearId;

        var result = await JournalService.BulkCreateAsync(contras);

        if (result == null)
        {
            ToastService.Error(JournalService.LastError ?? "Bulk import failed.");
            return;
        }

        // Match by Contra No column back to preview rows
        foreach (var item in result.Items)
        {
            foreach (var row in PreviewData)
            {
                var rd = (IDictionary<string, object?>)row;
                if (rd.TryGetValue("Contra No", out var cno) &&
                    cno?.ToString() == item.JournalNoInput)
                {
                    rd["Status"] = item.Success ? "Saved" : "Error";
                    rd["Message"] = item.Success ? $"Imported (Journal Id {item.JournalId})" : item.Error;
                }
            }
        }

        if (result.FailCount == 0)
            ToastService.Success($"{result.SuccessCount} contra(s) imported successfully.");
        else
            ToastService.Warning($"{result.SuccessCount} imported, {result.FailCount} failed. Check Message column.");

        StateHasChanged();
    }


