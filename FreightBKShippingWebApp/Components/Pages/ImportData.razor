    async Task LoadBillMasters()
    {
        // Reuse existing Account map (already loaded by LoadMasters for party + gst ledger accounts)
        var services = await ServiceService.GetAllAsync();
        ServicesList = services;
        ServiceMap = services
            .Where(x => !string.IsNullOrWhiteSpace(x.ServiceName))
            .GroupBy(x => x.ServiceName.Trim().ToUpper())
