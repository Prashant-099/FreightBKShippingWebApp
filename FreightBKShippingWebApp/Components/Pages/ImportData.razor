@page "/importData"
@using DevExpress.Blazor
@using FreightBKShippingWebApp.Model
@using FreightBKShippingWebApp.Models
@using OfficeOpenXml
@using System.Dynamic
@inject ExcelImportService ExcelService
@inject JobService JobService
@inject AccountService AccountService
@inject LocationService LocationService
@inject CargoService CargoService
@inject VesselService VesselService
@inject NotifyService NotifyService
@inject CurrencyService CurrencyService
@inject BranchService BranchService
@inject IBranchContext BranchContext
@inject YearStatechangeService YearStatechangeService
@inject ToasteService ToastService
@inject StatusService StatusService
@inject CountryService CountryService
@inject BillService BillService
@inject ServiceService ServiceService      
@inject StateService StateService          
@inject VoucherService VoucherService
@inject HsnSacService HsnSacService
@inject GstSlabService GstSlabService
@inject UnitService UnitService
@inject JournalService JournalService
@inject LedgerService LedgerService

<div class="d-flex align-items-center p-2 border-bottom">

    <label class="me-2 fw-bold">Import Type</label>

    <DxComboBox Data="@ImportTypes"
                ValueFieldName="Name"
                TextFieldName="Name"
                Width="220px"
                @bind-Value="SelectedImportType" />

    <InputFile OnChange="OnFileSelected" accept=".xlsx" />

    @if (!string.IsNullOrEmpty(FileName))
    {
        <p>@FileName</p>
    }

    <DxButton Text="Import"
              IconCssClass="bi bi-upload"
              CssClass="ms-2"
              Click="ImportExcel" />

    <DxCheckBox @bind-Checked="AllowDuplicate"
                CssClass="ms-auto">
        Allow Duplicate Entry
    </DxCheckBox>

</div>

<DxGrid Data="@PreviewData"
        Height="550px"
        ShowFilterRow="true"
        ShowSearchBox="true">

    <Columns>

        <DxGridDataColumn FieldName="RowNo" Width="70" />

        <DxGridDataColumn FieldName="Status" Width="120" />

        <DxGridDataColumn FieldName="Message" Width="280" />

        @foreach (var col in ExcelColumns)
        {
            <DxGridDataColumn FieldName="@col" Caption="@col" />
        }

    </Columns>

</DxGrid>

<div class="d-flex justify-content-end mt-2">

    <DxButton Text="Save"
              IconCssClass="bi bi-save"
              Click="Save" />

    <DxButton Text="Close"
              CssClass="ms-2"
              IconCssClass="bi bi-x-circle"
              Click="Close" />

</div>
@code {

    // -----------------------------------------------------------------
    // Import type selector
    // -----------------------------------------------------------------
    List<ImportTypeModel> ImportTypes = new()
    {
        new() { Id = 1, Name = "EXPORT" },
        new() { Id = 2, Name = "IMPORT" },
        new() { Id = 3, Name = "Bill" },
         new() { Id = 4, Name = "Receipt" },
         new() { Id = 5, Name = "Payment" },
           new() { Id = 6, Name = "Contra" }
    };

    public class ImportTypeModel
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
    }

    ImportTypeModel? SelectedImportType;

    bool AllowDuplicate = false;

    List<ExpandoObject> PreviewData = new();
    // async Task ImportExcel()
    // {
    //     switch (SelectedImportType.Id)
    //     {
    //         case 1:
    //             await ImportExportJob();
    //             break;

    //         case 2:
    //             await ImportImportJob();
    //             break;

    //         case 3:
    //             await ImportBill();
    //             break;
    //     }
    // }
    // -----------------------------------------------------------------
    // Required columns (must match headers in Job_Import_Template.xlsx)
    // -----------------------------------------------------------------
    static readonly string[] RequiredColumns =
    {
         "BRANCH",
        "JOB_NO",
         "JOB_DATE",
        "PARTY",

    };

    // Y/N text helper
    static bool ParseYesNo(string value) =>
        !string.IsNullOrWhiteSpace(value) &&
        (value.Trim().Equals("Y", StringComparison.OrdinalIgnoreCase) ||
         value.Trim().Equals("YES", StringComparison.OrdinalIgnoreCase) ||
         value.Trim() == "1");

    // -----------------------------------------------------------------
    // File selection
    // -----------------------------------------------------------------
    IBrowserFile? SelectedFile;
    string FileName = "";
    List<string> ExcelColumns = new();

    async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        SelectedFile = e.File;
        FileName = SelectedFile.Name;
    }

    async Task ImportExcel()
    {
        if (SelectedImportType == null)
        {
            ToastService.Warning("Please select Import Type");
            return;
        }

        try
        {
            if (SelectedImportType.Id == 3) // Bill
                await ReadBillExcel();
            else if (SelectedImportType.Id == 4)     // ✅ Receipt
                await ReadReceiptExcel();
            else if (SelectedImportType.Id == 5)     // ✅ payment
                await ReadPaymentExcel();
            else if (SelectedImportType.Id == 6)     // ✅ payment
                await ReadContraExcel();
            else                            // Export / Import Job
                await ReadExcel();
        }
        catch (Exception ex)
        {
            ToastService.Error("Import failed: " + ex.Message);
        }

        StateHasChanged();
    }

    // -----------------------------------------------------------------
    // Core: read the uploaded workbook, build Job objects, validate
    // -----------------------------------------------------------------
    async Task ReadExcel()
    {
        if (SelectedFile == null)
            return;

        await LoadMasters();
        PreviewData.Clear();

        using var stream = SelectedFile.OpenReadStream(20 * 1024 * 1024);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        ms.Position = 0;

        using var package = new ExcelPackage(ms);
        var ws = package.Workbook.Worksheets.First();

        if (ws.Dimension == null)
            return;

        // -----------------------------------
        // Read Header (row 2 in the template - row 1 holds helper notes)
        // -----------------------------------
        // int headerRow = DetectHeaderRow(ws);
        var map = ExcelService.ReadHeader(ws);
        ExcelColumns = map.Columns.Keys.ToList();

        foreach (var col in RequiredColumns)
        {
            if (!map.Has(col))
                throw new Exception($"Excel Column Missing: {col}");
        }

        int totalRows = ws.Dimension.End.Row;

        for (int row = 2; row <= totalRows; row++)
        {
            if (ExcelService.IsBlankRow(ws, row))
                continue;

            List<string> errors = new();

            string jobNo = ExcelService.GetText(ws, map, row, "JOB_NO");
            string jobType = SelectedImportType.Name;
            string exporterImporter = ExcelService.GetText(ws, map, row, "PARTY");
            string Highseas = ExcelService.GetText(ws, map, row, "HIGHSEAS");
            string pol = ExcelService.GetText(ws, map, row, "POL");
            string pod = ExcelService.GetText(ws, map, row, "POD");

            if (string.IsNullOrWhiteSpace(jobNo))
                errors.Add("Job No Missing");

            if (string.IsNullOrWhiteSpace(exporterImporter))
                errors.Add("Party Missing");



            //-----------------------------------
            // Master lookups
            //-----------------------------------
            int? partyId = FindAccountId(exporterImporter);
            if (partyId == null)
                errors.Add($"Exporter/Importer '{exporterImporter}' not found. Please create Account master.");


            int? HighseasId = null;

            if (!string.IsNullOrWhiteSpace(Highseas))
            {
                HighseasId = FindAccountId(Highseas);

                if (HighseasId == null)
                    errors.Add($"Highseas '{Highseas}' not found. Please create Account master.");
            }

            // POL
            int? polId = null;
            if (!string.IsNullOrWhiteSpace(pol))
            {
                polId = FindLocationId(pol);

                if (polId == null)
                    errors.Add($"POL '{pol}' not found. Please create Location master.");
            }

            // POD
            int? podId = null;
            if (!string.IsNullOrWhiteSpace(pod))
            {
                podId = FindLocationId(pod);

                if (podId == null)
                    errors.Add($"POD '{pod}' not found. Please create Location master.");
            }

            // JOB STATUS
            string jobstatus = ExcelService.GetText(ws, map, row, "JOB_STATUS");
            int? jobstatusId = null;
            if (!string.IsNullOrWhiteSpace(jobstatus))
            {
                jobstatusId = FindJobStatusId(jobstatus);

                if (jobstatusId == null)
                    errors.Add($"JOB STATUS '{jobstatus}' not found. Please create STATUS master.");
            }

            // CONSIGNEE
            string consigneeName = ExcelService.GetText(ws, map, row, "CONSIGNEE");
            int? consigneeId = null;
            if (!string.IsNullOrWhiteSpace(consigneeName))
            {
                consigneeId = FindNotifyId(consigneeName, "CONSIGNEE");

                if (consigneeId == null)
                    errors.Add($"Consignee '{consigneeName}' not found. Please create MISC master.");
            }

            // CONSIGNOR
            string supplierName = ExcelService.GetText(ws, map, row, "CONSIGNOR");
            int? supplierId = null;
            if (!string.IsNullOrWhiteSpace(supplierName))
            {
                supplierId = FindNotifyId(supplierName, "CONSIGNOR");

                if (supplierId == null)
                    errors.Add($"Supplier/Consignor '{supplierName}' not found. Please create MISC master.");
            }

            // SHIPPER
            string shipperName = ExcelService.GetText(ws, map, row, "SHIPPER");
            int? shipperId = null;
            if (!string.IsNullOrWhiteSpace(shipperName))
            {
                shipperId = FindNotifyId(shipperName, "SHIPPER");

                if (shipperId == null)
                    errors.Add($"Shipper '{shipperName}' not found. Please create MISC master.");
            }

            // LINE
            string lineName = ExcelService.GetText(ws, map, row, "LINE");
            int? lineId = null;
            if (!string.IsNullOrWhiteSpace(lineName))
            {
                lineId = FindNotifyId(lineName, "LINE");

                if (lineId == null)
                    errors.Add($"Line '{lineName}' not found. Please create MISC master.");
            }

            // CHA
            string chaName = ExcelService.GetText(ws, map, row, "CHA");
            int? chaId = null;
            if (!string.IsNullOrWhiteSpace(chaName))
            {
                chaId = FindNotifyId(chaName, "CHA");

                if (chaId == null)
                    errors.Add($"CHA '{chaName}' not found. Please create MISC master.");
            }

            // VESSEL
            string vesselName = ExcelService.GetText(ws, map, row, "VESSEL");
            int? vesselId = null;
            if (!string.IsNullOrWhiteSpace(vesselName))
            {
                vesselId = FindVesselId(vesselName);

                if (vesselId == null)
                    errors.Add($"Vessel '{vesselName}' not found.");
            }

            // CARGO
            string cargoName = ExcelService.GetText(ws, map, row, "CARGO");
            int? cargoId = null;
            if (!string.IsNullOrWhiteSpace(cargoName))
            {
                cargoId = FindCargoId(cargoName);

                if (cargoId == null)
                    errors.Add($"Cargo '{cargoName}' not found.");
            }

            // COUNTRY
            string countryName = ExcelService.GetText(ws, map, row, "COUNTRY_ORIGIN");
            int? countryId = null;
            if (!string.IsNullOrWhiteSpace(countryName))
            {
                countryId = FindCountryId(countryName);

                if (countryId == null)
                    errors.Add($"Country '{countryName}' not found.");
            }

            // CURRENCY
            string currencyName = ExcelService.GetText(ws, map, row, "CURRENCY");
            int? currencyId = null;
            if (!string.IsNullOrWhiteSpace(currencyName))
            {
                currencyId = FindCurrencyId(currencyName);

                if (currencyId == null)
                    errors.Add($"Currency '{currencyName}' not found.");
            }
            string branchName = ExcelService.GetText(ws, map, row, "BRANCH");
            int? branchId = FindBranchId(branchName);
            if (!string.IsNullOrWhiteSpace(branchName))
            {
                if (branchId == null)
                    errors.Add($"Branch '{branchName}' not found.");
            }


            //-----------------------------------
            // Duplicate check
            //-----------------------------------
            bool exists = await JobService.ExistsAsync(jobNo, branchId, jobType, YearStatechangeService.SelectedYearId.ToString());
            if (exists && !AllowDuplicate)
                errors.Add("Job No Already Exists");

            //-----------------------------------
            // Build Job entity
            //-----------------------------------
            var job = new Job
            {
                JobBranchId = branchId,
                JobNo = jobNo,
                JobDate = ExcelService.GetDate(ws, map, row, "JOB_DATE") ?? DateTime.Today,
                JobType = jobType,
                JobShipmentType = ExcelService.GetText(ws, map, row, "SHIPMENT_TYPE"),
                JobSubType = ExcelService.GetText(ws, map, row, "JOB_SUB_TYPE"),
                IsClearing = ParseYesNo(ExcelService.GetText(ws, map, row, "IS_CLEARING")),
                IsForwarding = ParseYesNo(ExcelService.GetText(ws, map, row, "IS_FORWARD")),
                IsTransportaion = ParseYesNo(ExcelService.GetText(ws, map, row, "IS_TRANSPORT")),
                IsMiscService = ParseYesNo(ExcelService.GetText(ws, map, row, "IS_MISC.")),
                JobPartyId = partyId,
                JobPartyAddress = Accounts.FirstOrDefault(x => x.AccountId == partyId)?.AccountAddress1,
                JobHighSeas1 = HighseasId,
                JobHighseas1Address = Accounts.FirstOrDefault(x => x.AccountId == HighseasId)?.AccountAddress1,
                JobAgent = ExcelService.GetText(ws, map, row, "AGENT"),
                JobAgentAddress = ExcelService.GetText(ws, map, row, "AGENT_ADDRESS"),
                JobCargoId = cargoId,
                JobGoodsDesc = Cargos.FirstOrDefault(x => x.CargoId == cargoId)?.CargoRemarks,
                JobHsnCode = Cargos.FirstOrDefault(x => x.CargoId == cargoId)?.cargohsnname,
                JobBrand = ExcelService.GetText(ws, map, row, "CARGO_BRAND"),
                JobVesselId = vesselId,
                JobLineId = lineId,
                JobDefCurrId = currencyId,
                JobExchRate = ExcelService.GetDouble(ws, map, row, "EXCH_RATE"),
                JobStatus = jobstatusId,
                JobRemarks = ExcelService.GetText(ws, map, row, "REMARKS"),
                JobSbNo = ExcelService.GetText(ws, map, row, "SB_NO"),
                JobSbDate = ExcelService.GetDate(ws, map, row, "SB_DATE"),
                JobBlNo = ExcelService.GetText(ws, map, row, "BL_NO"),
                JobBlDate = ExcelService.GetDate(ws, map, row, "BL_DATE"),
                JobHblNo = ExcelService.GetText(ws, map, row, "HBL_NO"),
                JobHblDate = ExcelService.GetDate(ws, map, row, "HBL_DATE"),
                JobBeNo = ExcelService.GetText(ws, map, row, "BE_NO"),
                JobBeDate = ExcelService.GetDate(ws, map, row, "BE_DATE"),
                JobShipperInvNo = ExcelService.GetText(ws, map, row, "SHIPPER_INV_NO"),
                JobShipperInvDate = ExcelService.GetDate(ws, map, row, "SHIPPER_INV_DATE"),
                JobGrossWt = ExcelService.GetDouble(ws, map, row, "GROSS_WT"),
                JobGrossUnit = ExcelService.GetText(ws, map, row, "GROSS_UNIT"),
                JobNetWt = ExcelService.GetDouble(ws, map, row, "NET_WT"),
                JobNetUnit = ExcelService.GetText(ws, map, row, "NET_UNIT"),
                JobQty = ExcelService.GetDouble(ws, map, row, "QTY"),
                JobQtyUnit = ExcelService.GetText(ws, map, row, "QTY_UNIT"),
                JobCbm = (float?)ExcelService.GetDouble(ws, map, row, "CBM"),
                JobPolId = polId,
                JobPodId = podId,
                JobPlaceOfReceipt = ExcelService.GetText(ws, map, row, "PLACE_OF_RECEIPT"),
                JobPlaceOfDelivery = ExcelService.GetText(ws, map, row, "PLACE_OF_DELIVERY"),
                JobCountryOrigin = countryName,
                JobCertiOrigin = ExcelService.GetText(ws, map, row, "CERTI_ORIGIN"),
                JobConsigneeId = consigneeId,
                JobConsigneeAddress = Notifies.FirstOrDefault(x => x.NotifyId == consigneeId)?.NotifyAddress1,
                JobSupplierId = supplierId,
                JobShipperId = shipperId,
                JobChaId = chaId,
                JobBookingNo = ExcelService.GetText(ws, map, row, "BOOKING_NO"),


                //Extra details
                JobEta = ExcelService.GetDate(ws, map, row, "ETA"),
                JobEtd = ExcelService.GetDate(ws, map, row, "ETD"),
                JobIcd = ExcelService.GetText(ws, map, row, "ICD"),
                JobCfs = ExcelService.GetText(ws, map, row, "CFS"),
                JobDoNo = ExcelService.GetText(ws, map, row, "DO_NO"),
                JobDoDate = ExcelService.GetDate(ws, map, row, "DO_DATE"),
                 JobDoPer = (float?)ExcelService.GetDouble(ws, map, row, "DO_PERCENT"),
                JobDoType = ExcelService.GetText(ws, map, row, "DO_TYPE"),
                JobDoValid = ExcelService.GetDate(ws, map, row, "DO_VALID"),
                JobTerminal = ExcelService.GetText(ws, map, row, "TERMINAL"),
                JobIgmNo = ExcelService.GetText(ws, map, row, "IGM_NO"),
                JobIgmDate = ExcelService.GetDate(ws, map, row, "IGM_DATE"),
                JobMarks = ExcelService.GetText(ws, map, row, "MARKS_NUMBERS"),
                JobEmptyYard = ExcelService.GetText(ws, map, row, "EMPTY_YARD"),
                JobForwarder = ExcelService.GetText(ws, map, row, "FORWARD"),
                Surveyor = ExcelService.GetText(ws, map, row, "SURVEYOR"),
                SurveyorAddress = ExcelService.GetText(ws, map, row, "SURVEYOR_ADDRESS"),
                JobFreeDays = (int?)ExcelService.GetDouble(ws, map, row, "FREE_DAYS"),
                JobVolume = ExcelService.GetText(ws, map, row, "VOLUME"),
                JobOutOfChargeDate = ExcelService.GetDate(ws, map, row, "OUT_OF_CHARGE_DATE"),
                JobGoodsDesc1 = ExcelService.GetText(ws, map, row, "REMARK2"),
                JobCust1 = ExcelService.GetText(ws, map, row, "CUSTOM_1"),
                JobCust2 = ExcelService.GetText(ws, map, row, "CUSTOM_2"),
                JobCust3 = ExcelService.GetText(ws, map, row, "CUSTOM_3"),
                JobCust4 = ExcelService.GetText(ws, map, row, "CUSTOM_4"),
                JobCust5 = ExcelService.GetText(ws, map, row, "CUSTOM_5"),
                JobCust6 = ExcelService.GetText(ws, map, row, "CUSTOM_6"),
                JobCust7 = ExcelService.GetText(ws, map, row, "CUSTOM_7"),
                JobCust8 = ExcelService.GetText(ws, map, row, "CUSTOM_8"),
                JobCust9 = ExcelService.GetText(ws, map, row, "CUSTOM_9"),

                //CONTAINERS DETAILS
                JobContainer20Ft = ExcelService.GetText(ws, map, row, "CONTAINER_20FT"),
                JobContainer40Ft = ExcelService.GetText(ws, map, row, "CONTAINER_40FT"),
                Job40Ft = ExcelService.GetText(ws, map, row, "_40FT"),
                Job20Ft = ExcelService.GetText(ws, map, row, "_20FT"),
                JobContainerType = ExcelService.GetText(ws, map, row, "CONTAINER_TYPE"),

                JobYearId = YearStatechangeService.SelectedYearId.ToString(),
                JobCreated = DateTime.Now,
                JobUpdated = DateTime.Now,
                JobActive = true
            };

            string status = errors.Any() ? "Error" : "Ready";
            string message = string.Join(", ", errors);

            //-----------------------------------
            // Preview row
            //-----------------------------------
            dynamic obj = new ExpandoObject();
            var dict = (IDictionary<string, object?>)obj;

            dict["RowNo"] = row;
            dict["Status"] = status;
            dict["Message"] = message;

            foreach (var col in ExcelColumns)
            {
                dict[col] = ExcelService.GetText(ws, map, row, col);
            }
            dict["Data"] = job;

            PreviewData.Add(obj);
        }
    }

    // Row 1 of the template is helper notes, row 2 is the real header.
    // If a plain single-header file is uploaded instead, fall back to row 1.
    // int DetectHeaderRow(ExcelWorksheet ws)
    // {
    //     var row2Map = ExcelService.ReadHeader(ws, 2);
    //     if (row2Map.Has("Job_No") || row2Map.Has("Job_Type"))
    //         return 2;

    //     return 1;
    // }

    // -----------------------------------------------------------------
    // Save
    // -----------------------------------------------------------------
    async Task Save()
    {
        if (SelectedImportType?.Id == 3)
        {
            await SaveBills();
            return;
        }
        if (SelectedImportType?.Id == 4)          
        {
            await SaveReceipts();
            return;
        }
        if (SelectedImportType?.Id == 5)
        {
            await SavePayment();
            return;
        }
        if (SelectedImportType?.Id == 6)
        {
            await SaveContra();
            return;
        }
        // ✅ Same error guard for jobs
    bool hasError = PreviewData
        .Select(x => (IDictionary<string, object?>)x)
        .Any(d => d.TryGetValue("Status", out var status) &&
                  status?.ToString() == "Error");

    if (hasError)
    {
        ToastService.Error("Errors present. Please fix all errors before saving. No data was imported.");
        return;
    }



        var jobs = PreviewData
            .Select(x => (IDictionary<string, object?>)x)
            .Where(d =>
                d.TryGetValue("Status", out var status) &&
                status?.ToString() == "Ready" &&
                d.TryGetValue("Data", out var data) &&
                data is Job)
            .Select(d => (Job)d["Data"]!)
            .ToList();

        if (!jobs.Any())
        {
            ToastService.Error("PLEASE IMPORT CORRECT DATA");
            return;
        }

        var result = await JobService.BulkCreateAsync(jobs);

        foreach (var row in PreviewData)
        {
            var d = (IDictionary<string, object?>)row;

            if (d.TryGetValue("Status", out var status) && status?.ToString() == "Ready")
            {
                d["Status"] = result.Success ? "Saved" : "Error";
                d["Message"] = result.Success ? "Imported" : result.Error;
            }
        }

        if (result.Success)
            ToastService.Success($"{jobs.Count} job(s) imported successfully.");
        else
            ToastService.Error(result.Error ?? "Bulk import failed.");

        StateHasChanged();
    }
    async Task SaveBills()
    {


        // ✅ Pehle check karo — koi bhi row error status me to hai kya
    bool hasError = PreviewData
        .Select(x => (IDictionary<string, object?>)x)
        .Any(d => d.TryGetValue("Status", out var status) &&
                  status?.ToString() == "Error");

    if (hasError)
    {
        ToastService.Error("Errors present. Please fix all errors before saving. No data was imported.");
        return;   // API call hi nahi hogi
    }




        var bills = PreviewData
            .Select(x => (IDictionary<string, object?>)x)
            .Where(d =>
                d.TryGetValue("Status", out var status) &&
                status?.ToString() == "Ready" &&
                d.TryGetValue("Data", out var data) &&
                data is Bill)
            .Select(d => (Bill)d["Data"]!)
            .ToList();

        if (!bills.Any())
        {
            ToastService.Error("PLEASE IMPORT CORRECT DATA");
            return;
        }

        foreach (var b in bills)
        {
            b.BillYearId = YearStatechangeService.SelectedYearId;
        }

        var result = await BillService.BulkCreateAsync(bills);

        if (result == null)
        {
            ToastService.Error(BillService.LastError ?? "Bulk import failed.");
            return;
        }

        // Har result item ko uske Voucher No se match karke us group ki
        // saari excel rows update karo (ek Voucher No = ek group)
        foreach (var item in result.Items)
        {
            foreach (var row in PreviewData)
            {
                var rd = (IDictionary<string, object?>)row;
                if (rd.TryGetValue("Voucher No", out var vno) && vno?.ToString() == item.BillNoInput)
                {
                    rd["Status"] = item.Success ? "Saved" : "Error";
                    rd["Message"] = item.Success ? $"Imported (Bill Id {item.BillId})" : item.Error;
                }
            }
        }

        if (result.FailCount == 0)
            ToastService.Success($"{result.SuccessCount} bill(s) imported successfully.");
        else
            ToastService.Warning($"{result.SuccessCount} imported, {result.FailCount} failed. Check Message column.");

        StateHasChanged();
    }  
    void Close()
    {
        PreviewData.Clear();
        SelectedFile = null;
        FileName = "";
        ExcelColumns.Clear();
    }

    // -----------------------------------------------------------------
    // Master data caches + lookups
    // -----------------------------------------------------------------
    List<Account> Accounts = new();
    List<Location> Locations = new();
    List<Cargo> Cargos = new();
    List<Vessel> Vessels = new();
    List<Notify> Notifies = new();
    List<Currency> Currencies = new();
    List<Branch> Branches = new();
    List<Status> statuslist = new();
    List<Country> Countrylist = new();

    Dictionary<string, int> AccountMap = new();
    Dictionary<string, int> LocationMap = new();
    Dictionary<string, int> CargoMap = new();
    Dictionary<string, int> VesselMap = new();
    Dictionary<string, int> CurrencyMap = new();
    Dictionary<string, int> BranchMap = new();
    Dictionary<string, int> JobStatusMap = new();
    Dictionary<string, int> CountryMap = new();

    // Notify master is keyed by (Type, Name) because the same name could
    // theoretically exist under different notify types (Shipper/Line/etc).
    Dictionary<(string Type, string Name), int> NotifyMap = new();

    async Task LoadMasters()
    {
        var accounts = await AccountService.GetAllAsync();
        Accounts = accounts;
        AccountMap = accounts
            .Where(x => !string.IsNullOrWhiteSpace(x.AccountName))
            .GroupBy(x => x.AccountName.Trim().ToUpper())
            .ToDictionary(g => g.Key, g => g.First().AccountId);

        var statuslist = await StatusService.GetAllAsync();
        JobStatusMap = statuslist
            .Where(x => !string.IsNullOrWhiteSpace(x.StatusName))
            .GroupBy(x => x.StatusName.Trim().ToUpper())
