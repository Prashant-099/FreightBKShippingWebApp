            // Amount in words — BillAddEditPage jaisa hi logic
            static string AmountInWords(decimal number)
            {
                if (number == 0) return "Zero Rupees Only";

                string[] u = { "Zero","One","Two","Three","Four","Five","Six","Seven","Eight","Nine","Ten",
                       "Eleven","Twelve","Thirteen","Fourteen","Fifteen","Sixteen","Seventeen","Eighteen","Nineteen" };
                string[] t = { "Zero", "Ten", "Twenty", "Thirty", "Forty", "Fifty", "Sixty", "Seventy", "Eighty", "Ninety" };

                string Conv(long n) =>
                    n == 0 ? "" :
                    n < 20 ? u[n] :
                    n < 100 ? t[n / 10] + (n % 10 > 0 ? " " + u[n % 10] : "") :
                    n < 1000 ? u[n / 100] + " Hundred" + (n % 100 > 0 ? " and " + Conv(n % 100) : "") :
                    n < 100000 ? Conv(n / 1000) + " Thousand" + (n % 1000 > 0 ? " " + Conv(n % 1000) : "") :
                    n < 10000000 ? Conv(n / 100000) + " Lakh" + (n % 100000 > 0 ? " " + Conv(n % 100000) : "")
                                 : Conv(n / 10000000) + " Crore" + (n % 10000000 > 0 ? " " + Conv(n % 10000000) : "");

                long ip = (long)Math.Floor(number);
                int dp = (int)Math.Round((number - ip) * 100);

                var w = Conv(ip) + " Rupees";
                if (dp > 0) w += " and " + Conv(dp) + " Paise";
                return w + " Only";
            }

