            .ToDictionary(g => g.Key, g => g.First().StateId);

        var vouchers = await VoucherService.GetAllAsync();
        VouchersList = vouchers;
        VoucherMap = vouchers
    .Where(x => !string.IsNullOrWhiteSpace(x.VoucherName) && x.VoucherBranchId > 0)
    .GroupBy(x => (x.VoucherBranchId.Value, x.VoucherName.Trim().ToUpper()))
    .ToDictionary(g => g.Key, g => g.First().VoucherId);

        // one voucher per group, restricted to the branch currently importing into
        VoucherGroupMap = vouchers
