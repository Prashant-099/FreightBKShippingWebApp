    Job? FindJob(string jobType, string jobNo)
    {
        if (string.IsNullOrWhiteSpace(jobType) ||
            string.IsNullOrWhiteSpace(jobNo))
            return null;

        JobMap.TryGetValue(
            (jobType.Trim().ToUpper(), jobNo.Trim().ToUpper()),
            out var job);

        return job;
    }

