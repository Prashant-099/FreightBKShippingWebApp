@page "/ratemaster"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using FreightBKShippingWebApp.Model
@using FreightBKShippingWebApp.Services
@inject RateMasterService RateMasterService
@inject ToasteService ToastService
@inject LoadingService LoadingService
@inject ConfirmationDialogService ConfirmDialogService
@inject AccountService AccountService
@inject ServiceService ServiceService
@inject GridLayoutService GridLayoutService
@inject AuditLogService AuditLogService
<style>
    .grid-size {
        max-height: 600px;
    }


    /* ComboBox Styling */
    .layout-combobox {
        border-radius: 6px;
        width: 185px;
    }
</style>
<DxGrid TItem="RateMaster"
        Data="@rateMasterList"
        @ref="MyGrid"
        KeyFieldName="RateMasterId"
        ShowSearchBox="true"
        PageSize="10"
        PageSizeSelectorVisible="true"
        ShowGroupPanel="true"
        FilterMenuButtonDisplayMode="GridFilterMenuButtonDisplayMode.Always"
        FocusedRowEnabled="true"
        SelectionMode="GridSelectionMode.Multiple"
        SelectedDataItems="@SelectedRates"
        SelectedDataItemsChanged="OnSelectedRatesChanged"
        ColumnResizeMode="GridColumnResizeMode.NextColumn"
        CssClass="grid-size"
        AllowSelectRowByClick="true">

    <ToolbarTemplate Context="toolbarContext">
        <DxToolbar>
            <TitleTemplate Context="ratemasterpagectx"> 
                <div class="d-flex align-items-center">
                    <i class="bi bi-currency-exchange me-2"></i>
                    <span class="fs-5">Rate Master</span>
                </div>
            </TitleTemplate>
            <Items>
                <DxToolbarItem Text="Add" IconCssClass="bi bi-plus-circle" Click="OnCreateNew" />
                <DxToolbarItem Text="Edit" IconCssClass="bi bi-pencil-square" Click="OnEdit" />
                <DxToolbarItem Text="Delete" IconCssClass="bi bi-trash" Click="OnDelete" />
                <DxToolbarItem Text="Refresh" IconCssClass="bi bi-arrow-clockwise" Click="LoadRatesAsync" />

                <DxToolbarItem Alignment="ToolbarItemAlignment.Right"
                               RenderStyle="ButtonRenderStyle.Secondary"
                               IconCssClass="bi bi-gear-wide-connected"
                               Click="ShowLayoutPopup" />

            </Items>
        </DxToolbar>
    </ToolbarTemplate>

    <Columns>

        <DxGridSelectionColumn Width="30"
                               FixedPosition="GridColumnFixedPosition.Left" />

        <DxGridDataColumn FieldName="RateMasterId"
                          Caption="ID"
                          Width="@(layoutManager?.GetColumnWidth("RateMasterId") ?? "80px")"
                          Visible="@(layoutManager?.GetColumnVisibility("RateMasterId") ?? false)" />

        <DxGridDataColumn FieldName="RateMasterApplicableDt"
                          Caption="Applicable Date"
                          DisplayFormat="dd/MM/yyyy"
                          Width="@(layoutManager?.GetColumnWidth("RateMasterApplicableDt") ?? "150px")"
                          Visible="@(layoutManager?.GetColumnVisibility("RateMasterApplicableDt") ?? true)" />

        <DxGridDataColumn FieldName="PartyName"
                          Caption="Party Name"
                          Width="@(layoutManager?.GetColumnWidth("PartyName") ?? "350px")"
                          Visible="@(layoutManager?.GetColumnVisibility("PartyName") ?? true)" />

        <DxGridDataColumn FieldName="ServiceName"
                          Caption="Service Name"
                          Width="@(layoutManager?.GetColumnWidth("ServiceName") ?? "370px")"
                          Visible="@(layoutManager?.GetColumnVisibility("ServiceName") ?? true)" />

        <DxGridDataColumn FieldName="RateMasterSaleRate"
                          Caption="Sale Rate"
                          DisplayFormat="N2"
                          Width="@(layoutManager?.GetColumnWidth("RateMasterSaleRate") ?? "140px")"
                          Visible="@(layoutManager?.GetColumnVisibility("RateMasterSaleRate") ?? true)" />

        <DxGridDataColumn FieldName="RateMasterPurchaseRate"
                          Caption="Purchase Rate"
                          DisplayFormat="N2"
                          Width="@(layoutManager?.GetColumnWidth("RateMasterPurchaseRate") ?? "170px")"
                          Visible="@(layoutManager?.GetColumnVisibility("RateMasterPurchaseRate") ?? true)" />

        <DxGridDataColumn FieldName="RateMasterCreated"
                          Caption="Created At"
                          DisplayFormat="dd/MM/yyyy"
                          Width="@(layoutManager?.GetColumnWidth("RateMasterCreated") ?? "160px")"
                          Visible="@(layoutManager?.GetColumnVisibility("RateMasterCreated") ?? true)" />

        <DxGridDataColumn FieldName="RateMasterUpdated"
                          Caption="Updated At"
                          DisplayFormat="dd/MM/yyyy"
                          Width="@(layoutManager?.GetColumnWidth("RateMasterUpdated") ?? "160px")"
                          Visible="@(layoutManager?.GetColumnVisibility("RateMasterUpdated") ?? true)" />

    </Columns>
</DxGrid>

<RateMasterAddEditPage @ref="popup" OnSaved="LoadRatesAsync" />

<ConfirmationDialog />
<GridLayoutpPopup @ref="layoutManager"
                  VoucherType="Ratemaster"
                  Columns="@allColumns"
                  OnLayoutChanged="HandleLayoutChanged" />

@code {
    DxGrid MyGrid;
    private List<RateMaster> rateMasterList = new();
    // private List<RateMaster> SelectedRates = new();
    private IReadOnlyList<object> SelectedRates { get; set; } = new List<object>();

    private RateMasterAddEditPage popup;

    // All possible columns
    private GridLayoutpPopup? layoutManager;
    private List<GridColumnLayout> allColumns = [];
    private async void ShowLayoutPopup()
    {
        await InvokeAsync(() =>
        {
            layoutManager?.ShowPopup();
        });
    }
    private async Task HandleLayoutChanged(List<GridColumnLayout> updatedLayout)
    {
        allColumns = updatedLayout;
        // Force the grid to re-render with new layout
        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnInitializedAsync()
    {
        InitializeColumns();
        await LoadRatesAsync();

    }
    private void InitializeColumns()
    {
        allColumns = new List<GridColumnLayout>
        {
       new(){ FieldName = "RateMasterId", Caption = "ID", Visible = false, Width = 80, DisplayIndex = 0 },

    new(){ FieldName = "RateMasterApplicableDt", Caption = "Applicable Date", Visible = true, Width = 150, DisplayIndex = 1 },

    new(){ FieldName = "PartyName", Caption = "Party Name", Visible = true, Width = 350, DisplayIndex = 2 },

    new(){ FieldName = "ServiceName", Caption = "Service Name", Visible = true, Width = 370, DisplayIndex = 3 },

    new(){ FieldName = "RateMasterSaleRate", Caption = "Sale Rate", Visible = true, Width = 140, DisplayIndex = 4 },

    new(){ FieldName = "RateMasterPurchaseRate", Caption = "Purchase Rate", Visible = true, Width = 170, DisplayIndex = 5 },

    new(){ FieldName = "RateMasterCreated", Caption = "Created At", Visible = true, Width = 140, DisplayIndex = 6 },

     new(){ FieldName = "RateMasterUpdated", Caption = "Updated At", Visible = true, Width = 140, DisplayIndex = 7 }
};

    }


    private async Task LoadRatesAsync()
    {
        LoadingService.Show();
        try
        {
            rateMasterList = await RateMasterService.GetAllAsync();
        }
        finally
        {
            LoadingService.Hide();
        }
    }

    private async Task OnSelectedRatesChanged(IReadOnlyList<object> rates)
    {
        SelectedRates = rates ?? new List<object>();
        await InvokeAsync(StateHasChanged);
    }
    // ✅ FIXED: Reliable clear selection method
    private async Task ClearSelectionManual()
    {
        try
        {
            if (MyGrid != null)
            {
                MyGrid.ClearSelection(); // ✅ Synchronous method
            }
            SelectedRates = new List<RateMaster>();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Clear selection error: {ex.Message}");
        }
    }

    // ✅ FIXED: Auto-clear after operations
    private async Task ClearSelection()
    {
        await Task.Delay(100); // Small delay for UI update
        await ClearSelectionManual();
    }

    private void OnCreateNew(ToolbarItemClickEventArgs e)
    {
        popup.Show(new RateMaster());
    }

    private async Task OnEdit(ToolbarItemClickEventArgs e)
    {
        var rate = MyGrid.GetFocusedDataItem() as RateMaster;
        if (rate != null)
        {
            var freshData = rateMasterList
    .FirstOrDefault(x => x.RateMasterId == rate.RateMasterId);

            if (freshData != null)
                popup.Show(freshData);
        }
        else
            ToastService.Warning("Please select a rate to edit.");
        await ClearSelection();
    }

    private async Task OnDelete(ToolbarItemClickEventArgs e)
    {
        if (SelectedRates == null || SelectedRates.Count == 0)
        {
            ToastService.Warning("Please select at least one rate to delete.");
            return;
        }
        var selectedList = SelectedRates.Cast<RateMaster>().ToList();
        var confirm = await ConfirmDialogService.ShowAsync(
            $"Are you sure you want to delete {SelectedRates.Count} selected rate(s)?");
        if (!confirm)
        {
            await ClearSelection(); // ✅ Clear on cancel
            return;
        }
        try
        {
            LoadingService.Show("Deleting...");
            int successCount = 0, failCount = 0;
            List<string> errorMessages = new();
            foreach (var rate in selectedList)
            {
                var result = await RateMasterService.DeleteAsync(rate.RateMasterId);
                if (result.Success)
                {
                    successCount++;
                    AuditLogService.NotifyAuditChanged();

                }
                else
                {
                    failCount++;
                    errorMessages.Add(result.Error);
                }
            }

            if (successCount > 0) ToastService.Success($"{successCount} rate(s) Deleted Successfully.");
            if (failCount > 0) 
            ToastService.Error($"{failCount} Rate(s) Failed To Delete.\nDetails: {string.Join("\n", errorMessages.Distinct())}");

            await LoadRatesAsync();
        }
        finally
        {
            LoadingService.Hide();
            await ClearSelection(); // ✅ Clear after delete (success or fail)
        }
        }
    }

