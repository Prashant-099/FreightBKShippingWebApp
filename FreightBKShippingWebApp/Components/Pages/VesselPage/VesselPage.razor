@page "/vessels"
@using FreightBKShippingWebApp.Model
@using FreightBKShippingWebApp.Services
@using FreightBKShippingWebApp.Components.Pages
@using System.Text.Json
@inject AuditLogService AuditLogService
@inject VesselService VesselService
@inject ToasteService ToastService
@inject LoadingService LoadingService
@inject ConfirmationDialogService ConfirmDialogService
@inject GridLayoutService GridLayoutService
@inject IJSRuntime JS
<style>
    .grid-size {
        max-height: 600px;
    }


    /* ComboBox Styling */
    .layout-combobox {
        border-radius: 6px;
        width: 185px;
    }
</style>
<DxGrid TItem="Vessel"
        Data="@vesselList"
        @ref="MyGrid"
        KeyFieldName="VesselId"
        ShowSearchBox="true"
        PageSize="10"
        PageSizeSelectorVisible="true"
        ShowGroupPanel="true"
        FilterMenuButtonDisplayMode="GridFilterMenuButtonDisplayMode.Always"
        FocusedRowEnabled="true"
        SelectionMode="GridSelectionMode.Multiple"
        SelectedDataItems="@SelectedVessels"
        SelectedDataItemsChanged="OnSelectedVesselsChanged"
        ColumnResizeMode="GridColumnResizeMode.NextColumn"
        CssClass="grid-size"
        AllowSelectRowByClick="true">

    <ToolbarTemplate>
        <DxToolbar>
            <TitleTemplate Context="tl">
                <div class="d-flex align-items-center">
                    <i class="bi bi-truck me-2"></i>
                    <span class="fs-5 ">Vessels</span>
                </div>
            </TitleTemplate>
            <Items>
                <DxToolbarItem Text="Add" IconCssClass="bi bi-plus-circle" Click="OnCreateNew" />
                <DxToolbarItem Text="Edit" IconCssClass="bi bi-pencil-square" Click="OnEdit" />
                <DxToolbarItem Text="Delete" IconCssClass="bi bi-trash" Click="OnDelete" />
                <DxToolbarItem Text="Refresh" IconCssClass="bi bi-arrow-clockwise" Click="@(async (_) => await LoadVesselsAsync())" />
                <DxToolbarItem Alignment="ToolbarItemAlignment.Right"
                               RenderStyle="ButtonRenderStyle.Secondary"
                               IconCssClass="bi bi-gear-wide-connected"
                               Click="ShowLayoutPopup" />

            </Items>
        </DxToolbar>
    </ToolbarTemplate>

    <Columns>

        <DxGridSelectionColumn Width="30" FixedPosition="GridColumnFixedPosition.Left" />

        <DxGridDataColumn FieldName="VesselId" Caption="ID"
                          Width="@(layoutManager?.GetColumnWidth("VesselId") ?? "80px")"
                          Visible="@(layoutManager?.GetColumnVisibility("VesselId") ?? false)" />

        <DxGridDataColumn FieldName="VesselName" Caption="Vessel Name"
                          Width="@(layoutManager?.GetColumnWidth("VesselName") ?? "310px")"
                          Visible="@(layoutManager?.GetColumnVisibility("VesselName") ?? true)" />

        <DxGridDataColumn FieldName="VesselQty" Caption="Quantity"
                          DisplayFormat="N2"
                          Width="@(layoutManager?.GetColumnWidth("VesselQty") ?? "120px")"
                          Visible="@(layoutManager?.GetColumnVisibility("VesselQty") ?? true)" />

        <DxGridDataColumn FieldName="VesselCbm" Caption="CBM"
                          DisplayFormat="N2"
                          Width="@(layoutManager?.GetColumnWidth("VesselCbm") ?? "120px")"
                          Visible="@(layoutManager?.GetColumnVisibility("VesselCbm") ?? true)" />

        <DxGridDataColumn FieldName="VesselDtSailing" Caption="Sailing Date"
                          DisplayFormat="d"
                          Width="@(layoutManager?.GetColumnWidth("VesselDtSailing") ?? "130px")"
                          Visible="@(layoutManager?.GetColumnVisibility("VesselDtSailing") ?? true)" />

        <DxGridDataColumn FieldName="VesselDtBerting" Caption="Berting Date"
                          DisplayFormat="d"
                          Width="@(layoutManager?.GetColumnWidth("VesselDtBerting") ?? "130px")"
                          Visible="@(layoutManager?.GetColumnVisibility("VesselDtBerting") ?? true)" />

        <DxGridDataColumn FieldName="VesselDtDemmurate" Caption="Demmurate Date"
                          DisplayFormat="d"
                          Width="@(layoutManager?.GetColumnWidth("VesselDtDemmurate") ?? "170px")"
                          Visible="@(layoutManager?.GetColumnVisibility("VesselDtDemmurate") ?? true)" />

        <DxGridDataColumn FieldName="VesselNoOfBL" Caption="No. of BL"
                          Width="@(layoutManager?.GetColumnWidth("VesselNoOfBL") ?? "120px")"
                          Visible="@(layoutManager?.GetColumnVisibility("VesselNoOfBL") ?? true)" />

        <DxGridDataColumn FieldName="VesselCreated" Caption="Created At"
                          Width="@(layoutManager?.GetColumnWidth("VesselCreated") ?? "120px")"
                          Visible="@(layoutManager?.GetColumnVisibility("VesselCreated") ?? true)" />

        <DxGridDataColumn FieldName="VesselUpdated" Caption="Updated At"
                          Width="@(layoutManager?.GetColumnWidth("VesselUpdated") ?? "120px")"
                          Visible="@(layoutManager?.GetColumnVisibility("VesselUpdated") ?? true)" />

        <DxGridDataColumn FieldName="VesselStatus" Caption="Active"
                          Width="@(layoutManager?.GetColumnWidth("VesselStatus") ?? "120px")"
                          Visible="@(layoutManager?.GetColumnVisibility("VesselStatus") ?? true)" />

    </Columns>
</DxGrid>

<VesselAddEditPage @ref="popup" OnSaved="LoadVesselsAsync" />

<ConfirmationDialog />
<GridLayoutpPopup @ref="layoutManager"
                  VoucherType="Vessel"
                  Columns="@allColumns"
                  OnLayoutChanged="HandleLayoutChanged" />

@code {
    DxGrid MyGrid;
    private List<Vessel> vesselList = new();
    // private List<Vessel> SelectedVessels = new();
    private IReadOnlyList<object> SelectedVessels { get; set; } = new List<object>();

    private VesselAddEditPage popup;

    // All possible columns
    private GridLayoutpPopup? layoutManager;
    private List<GridColumnLayout> allColumns = [];
    private async void ShowLayoutPopup()
    {
        await InvokeAsync(() =>
        {
            layoutManager?.ShowPopup();
        });
    }
    private async Task HandleLayoutChanged(List<GridColumnLayout> updatedLayout)
    {
        allColumns = updatedLayout;
        // Force the grid to re-render with new layout
        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnInitializedAsync()
    {
        InitializeColumns();
        await LoadVesselsAsync();
    }

    private void InitializeColumns()
    {
        allColumns = new List<GridColumnLayout>
        {
        new() { FieldName = "VesselId", Caption = "ID",Visible = false, Width = 80, DisplayIndex = 0 },

        new() { FieldName = "VesselName", Caption = "Vessel Name",Visible = true, Width = 310, DisplayIndex = 1 },

        new() { FieldName = "VesselQty", Caption = "Quantity",Visible = true, Width = 120, DisplayIndex = 2 },

        new() { FieldName = "VesselCbm", Caption = "CBM",Visible = true, Width = 120, DisplayIndex = 3 },

        new() { FieldName = "VesselDtSailing", Caption = "Sailing Date",Visible = true, Width = 130, DisplayIndex = 4 },

        new() { FieldName = "VesselDtBerting", Caption = "Berting Date",Visible = true, Width = 130, DisplayIndex = 5 },

        new() { FieldName = "VesselDtDemmurate", Caption = "Demmurate Date",Visible = true, Width = 170, DisplayIndex = 6 },

        new() { FieldName = "VesselNoOfBL", Caption = "No. of BL",Visible = true, Width = 120, DisplayIndex = 7 },

         new() { FieldName = "VesselStatus", Caption = "Active",Visible = true, Width = 120, DisplayIndex = 8 },

        new() { FieldName = "VesselCreated", Caption = "Created At",Visible = true, Width = 120, DisplayIndex = 9 },

        new() { FieldName = "VesselUpdated", Caption = "Updated At",Visible = true, Width = 120, DisplayIndex = 10 } 
    };


    }


    private async Task LoadVesselsAsync()
    {
        LoadingService.Show();
        try
        {
            vesselList = await VesselService.GetAllAsync();
        }
        finally
        {
            LoadingService.Hide();
        }
    }

    private async Task OnSelectedVesselsChanged(IReadOnlyList<object> vessels)
    {
        SelectedVessels = vessels ?? new List<object>();
        await InvokeAsync(StateHasChanged);
    }
    // ✅ FIXED: Reliable clear selection method
    private async Task ClearSelectionManual()
    {
        try
        {
            if (MyGrid != null)
            {
                MyGrid.ClearSelection(); // ✅ Synchronous method
            }
            SelectedVessels = new List<Vessel>();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Clear selection error: {ex.Message}");
        }
    }

    // ✅ FIXED: Auto-clear after operations
    private async Task ClearSelection()
    {
        await Task.Delay(100); // Small delay for UI update
        await ClearSelectionManual();
    }

    private void OnCreateNew(ToolbarItemClickEventArgs e)
    {
        popup.Show(new Vessel()
        {
            VesselStatus = true,
            VesselDtSailing = DateTime.Now,
            VesselDtBerting = DateTime.Now.AddDays(3),
            VesselEta = DateTime.Now.AddDays(5)
        });
    }

    private async Task OnEdit(ToolbarItemClickEventArgs e)
    {
        var vessel = MyGrid.GetFocusedDataItem() as Vessel;
        if (vessel != null)
        {
            var freshData = vesselList
                   .FirstOrDefault(x => x.VesselId == vessel.VesselId);

            if (freshData != null)
                popup.Show(vessel);
        }
        else
            ToastService.Warning("Please select a vessel to edit.");
        await ClearSelection();
    }

    private async Task OnDelete(ToolbarItemClickEventArgs e)
    {
        if (SelectedVessels == null || SelectedVessels.Count == 0)
        {
            ToastService.Warning("Please select at least one vessel to delete.");
            return;
        }
        var selectedList = SelectedVessels.Cast<Vessel>().ToList();

        var confirm = await ConfirmDialogService.ShowAsync(
            $"Are you sure you want to delete {SelectedVessels.Count} selected vessel(s)?");

        if (!confirm)
        {
            await ClearSelection(); // ✅ Clear on cancel
            return;
        }
        try
        {
            LoadingService.Show("Deleting...");
            int successCount = 0, failCount = 0;

            foreach (var vessel in selectedList)
            {
                var result = await VesselService.DeleteAsync(vessel.VesselId);
                if (result)
                {
                    successCount++;
                    AuditLogService.NotifyAuditChanged();

                }
                else
                    failCount++;
            }

            if (successCount > 0)
                ToastService.Success($"{successCount} Vessel(s) Deleted Successfully.");

            if (failCount > 0)
                ToastService.Error($"{failCount} Vessel(s) Failed To Delete.");

            await LoadVesselsAsync();
        }
        finally
        {
            LoadingService.Hide();
            await ClearSelection(); // ✅ Clear after delete (success or fail)
        }
    }

}