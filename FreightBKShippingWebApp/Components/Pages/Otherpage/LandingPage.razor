<!-- ════════════════════════════════════════
     PAGE WRAPPER + BACKGROUND
════════════════════════════════════════ -->
<div class="lp">
    <div class="lp-body">

        <!-- ── HERO ── -->
        <section class="hero">
            <div class="hero-left">
                <div class="hero-pill">
                    <i class="bi bi-lightning-charge-fill"></i> Freight Management Platform
                </div>
