            </div>
            <div class="stat-card">
                <div class="ic ic-green"><i class="bi bi-check-circle-fill"></i></div>
                <div><div class="sc-label">Uptime</div><div class="sc-val">99.9%</div><div class="sc-sub">Always on</div></div>
            </div>
            <div class="stat-card">
