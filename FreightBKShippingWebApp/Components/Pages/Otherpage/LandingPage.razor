                </p>
            </div>
            <div class="hero-right">
                <a href="/login" class="btn-primary">
                    <i class="bi bi-rocket-takeoff-fill"></i> Get Started — Sign In
                </a>
                <a href="tel:9409309616" class="btn-secondary">
                    <i class="bi bi-headset"></i> Call: 9409309616
                </a>
            </div>
        </section>

        <!-- ── STATS ── -->
        <div class="stat-grid">
            <div class="stat-card">
                <div class="ic ic-blue"><i class="bi bi-box-arrow-in-down"></i></div>
                <div>
                    <div class="sc-label">Shipments</div>
                    <div class="sc-val">50K+</div>
                    <div class="sc-sub">↑ tracked</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="ic ic-green"><i class="bi bi-check-circle-fill"></i></div>
                <div>
                    <div class="sc-label">Uptime</div>
                    <div class="sc-val">99.9%</div>
                    <div class="sc-sub">Always on</div>
                </div>
