@page "/coming-soon"
@layout EmptyLayout

<PageTitle>Coming Soon | FreightBook</PageTitle>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />

<style>
    *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    .cs-shell {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #edf1f8;
        background-image: radial-gradient(ellipse 80% 60% at 10% 0%, rgba(26,115,232,.12) 0%, transparent 60%), radial-gradient(ellipse 60% 50% at 90% 100%, rgba(6,182,212,.08) 0%, transparent 55%);
        font-family: 'Sora', sans-serif;
        padding: 2rem 1rem;
    }

    .cs-wrap {
        width: 100%;
        max-width: 500px;
        animation: fadeUp .4s ease both;
    }

    .cs-banner {
        background: linear-gradient(135deg, #0891b2 0%, #0e7490 100%);
        border-radius: 16px;
        padding: 20px 22px;
        margin-bottom: 14px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        box-shadow: 0 4px 18px rgba(8,145,178,.28);
    }

        .cs-banner h2 {
            font-size: 1.1rem;
            font-weight: 800;
            color: #fff;
            margin-bottom: 3px;
        }

        .cs-banner p {
            font-size: .75rem;
            color: rgba(255,255,255,.75);
            font-family: 'JetBrains Mono', monospace;
        }

    .cs-badge {
        background: rgba(255,255,255,.2);
        border: 1px solid rgba(255,255,255,.3);
        color: #fff;
        font-size: .68rem;
        font-weight: 700;
        font-family: 'JetBrains Mono', monospace;
        padding: .28rem .8rem;
        border-radius: 100px;
        letter-spacing: 1px;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .cs-card {
        background: #fff;
        border-radius: 18px;
        border: 1px solid #dce5f2;
        padding: 2.5rem 2rem 2.25rem;
        text-align: center;
        box-shadow: 0 4px 24px rgba(21,87,176,.10);
        position: relative;
        overflow: hidden;
    }

        .cs-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, #06b6d4, #22d3ee);
        }

    .cs-icon-box {
        width: 76px;
        height: 76px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.4rem;
        font-size: 2rem;
        background: #06b6d4;
        color: #fff;
        animation: spinGear 5s linear infinite;
    }

    @@keyframes spinGear {
        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }
    }

    .cs-label {
        font-size: .62rem;
        font-weight: 700;
        color: #94a3b8;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        font-family: 'JetBrains Mono', monospace;
        margin-bottom: .3rem;
    }

    .cs-title {
        font-size: 1.45rem;
        font-weight: 800;
        color: #1e293b;
        letter-spacing: -.4px;
        line-height: 1.2;
        margin-bottom: .2rem;
    }

        .cs-title em {
            font-style: normal;
            color: #06b6d4;
        }

    .cs-divider {
        width: 38px;
        height: 3px;
        background: linear-gradient(90deg,#06b6d4,#22d3ee);
        margin: .6rem auto .85rem;
        border-radius: 2px;
    }

    .cs-sub {
        font-size: .82rem;
        color: #64748b;
        line-height: 1.65;
        max-width: 340px;
        margin: 0 auto 1.6rem;
    }

    .cs-progress {
        margin-bottom: 1.75rem;
    }

    .cs-prog-meta {
        display: flex;
        justify-content: space-between;
        font-size: .68rem;
        color: #94a3b8;
        font-family: 'JetBrains Mono', monospace;
        margin-bottom: .5rem;
    }

    .cs-prog-track {
        height: 8px;
        background: #f1f5f9;
        border-radius: 100px;
        overflow: hidden;
        border: 1px solid #e2e8f0;
    }

    .cs-prog-fill {
        height: 100%;
        background: linear-gradient(90deg,#0891b2,#06b6d4,#22d3ee);
        border-radius: 100px;
        width: 70%;
        animation: fillIn 1.6s cubic-bezier(.16,1,.3,1) .4s both;
        position: relative;
        overflow: hidden;
    }

        .cs-prog-fill::after {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            bottom: 0;
            width: 50%;
            background: linear-gradient(90deg,transparent,rgba(255,255,255,.5));
            animation: sheen 2.5s ease-in-out infinite;
        }

    @@keyframes fillIn {
        from {
            width: 0;
        }

        to {
            width: 70%;
        }
    }

    @@keyframes sheen {
        from {
            transform: translateX(-150%);
        }

        to {
            transform: translateX(300%);
        }
    }

    .cs-btn {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        padding: .58rem 1.4rem;
        background: #06b6d4;
        color: #fff;
        border: none;
        border-radius: 10px;
        font-family: 'Sora', sans-serif;
        font-size: .83rem;
        font-weight: 700;
        cursor: pointer;
        text-decoration: none;
        box-shadow: 0 4px 14px rgba(6,182,212,.32);
        transition: background .18s, transform .18s;
    }

        .cs-btn:hover {
            background: #0891b2;
            transform: translateY(-2px);
        }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(16px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<div class="cs-shell">
    <div class="cs-wrap">
        <div class="cs-banner">
            <div>
                <h2>🔧 Feature In Progress</h2>
                <p>Development Status · Active Build</p>
            </div>
            <span class="cs-badge">Coming Soon</span>
        </div>
        <div class="cs-card">
            <div class="cs-icon-box"><i class="bi bi-gear-fill"></i></div>
            <div class="cs-label">Under Development</div>
            <div class="cs-title">Something <em>New</em><br />Is Loading…</div>
            <div class="cs-divider"></div>
            <p class="cs-sub">Our team is actively building this feature. It will be ready and deployed for your team soon.</p>
            <div class="cs-progress">
                <div class="cs-prog-meta">
                    <span>Development Progress</span>
                    <span>70%</span>
                </div>
                <div class="cs-prog-track">
                    <div class="cs-prog-fill"></div>
                </div>
            </div>
            <a href="/" class="cs-btn"><i class="bi bi-house-fill"></i> Back to Dashboard</a>
        </div>
    </div>
</div>
