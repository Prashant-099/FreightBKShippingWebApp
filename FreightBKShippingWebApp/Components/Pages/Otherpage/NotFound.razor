@page "/404"
@layout EmptyLayout

<PageTitle>404 – Not Found | FreightBook</PageTitle>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />

<style>
    *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    .err-shell {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #edf1f8;
        background-image: radial-gradient(ellipse 80% 60% at 10% 0%, rgba(26,115,232,.12) 0%, transparent 60%), radial-gradient(ellipse 60% 50% at 90% 100%, rgba(59,130,246,.08) 0%, transparent 55%);
        font-family: 'Sora', sans-serif;
        padding: 2rem 1rem;
    }

    .err-wrap {
        width: 100%;
        max-width: 500px;
        animation: fadeUp .4s ease both;
    }

    .err-banner {
        background: linear-gradient(135deg, #1a73e8 0%, #1557b0 100%);
        border-radius: 16px;
        padding: 20px 22px;
        margin-bottom: 14px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        box-shadow: 0 4px 18px rgba(21,87,176,.28);
    }

        .err-banner h2 {
            font-size: 1.1rem;
            font-weight: 800;
            color: #fff;
            margin-bottom: 3px;
        }

        .err-banner p {
            font-size: .75rem;
            color: rgba(255,255,255,.75);
            font-family: 'JetBrains Mono', monospace;
        }

    .err-badge {
        background: rgba(255,255,255,.2);
        border: 1px solid rgba(255,255,255,.3);
        color: #fff;
        font-size: .68rem;
        font-weight: 700;
        font-family: 'JetBrains Mono', monospace;
        padding: .28rem .8rem;
        border-radius: 100px;
        letter-spacing: 1px;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .err-card {
        background: #fff;
        border-radius: 18px;
        border: 1px solid #dce5f2;
        padding: 2.5rem 2rem 2.25rem;
        text-align: center;
        box-shadow: 0 4px 24px rgba(21,87,176,.10);
        position: relative;
        overflow: hidden;
    }

        .err-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, #3b82f6, #60a5fa);
        }

    .err-icon-box {
        width: 76px;
        height: 76px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.4rem;
        font-size: 2rem;
        background: #3b82f6;
        color: #fff;
    }

    .err-label {
        font-size: .62rem;
        font-weight: 700;
        color: #94a3b8;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        font-family: 'JetBrains Mono', monospace;
        margin-bottom: .3rem;
    }

    .err-code {
        font-family: 'JetBrains Mono', monospace;
        font-size: clamp(4rem,14vw,6.5rem);
        font-weight: 700;
        line-height: 1;
        letter-spacing: -3px;
        color: #3b82f6;
        margin-bottom: .2rem;
    }

    .err-divider {
        width: 38px;
        height: 3px;
        background: linear-gradient(90deg,#3b82f6,#60a5fa);
        margin: .6rem auto .85rem;
        border-radius: 2px;
    }

    .err-title {
        font-size: 1.15rem;
        font-weight: 700;
        color: #1e293b;
        letter-spacing: -.3px;
        margin-bottom: .4rem;
    }

    .err-sub {
        font-size: .82rem;
        color: #64748b;
        line-height: 1.65;
        max-width: 340px;
        margin: 0 auto 1.75rem;
    }

    .err-actions {
        display: flex;
        gap: .75rem;
        justify-content: center;
        flex-wrap: wrap;
    }

    .btn-primary {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        padding: .58rem 1.4rem;
        background: #3b82f6;
        color: #fff;
        border: none;
        border-radius: 10px;
        font-family: 'Sora', sans-serif;
        font-size: .83rem;
        font-weight: 700;
        cursor: pointer;
        text-decoration: none;
        box-shadow: 0 4px 14px rgba(59,130,246,.32);
        transition: background .18s, transform .18s, box-shadow .18s;
    }

        .btn-primary:hover {
            background: #2563eb;
            transform: translateY(-2px);
            box-shadow: 0 8px 22px rgba(59,130,246,.42);
        }

    .btn-ghost {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        padding: .58rem 1.4rem;
        background: #f1f5f9;
        color: #64748b;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        font-family: 'Sora', sans-serif;
        font-size: .83rem;
        cursor: pointer;
        text-decoration: none;
        transition: background .18s, color .18s;
    }

        .btn-ghost:hover {
            background: #e2e8f0;
            color: #334155;
        }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(16px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<div class="err-shell">
    <div class="err-wrap">
        <div class="err-banner">
            <div>
                <h2>⚠ Page Not Found</h2>
                <p>HTTP 404 · Route Unresolved</p>
            </div>
            <span class="err-badge">Error 404</span>
        </div>
        <div class="err-card">
            <div class="err-icon-box"><i class="bi bi-compass"></i></div>
            <div class="err-label">Status Code</div>
            <div class="err-code">404</div>
            <div class="err-divider"></div>
            <div class="err-title">Route Not Found</div>
            <p class="err-sub">The page you're looking for has drifted off course. It may have been moved, deleted, or the URL is incorrect.</p>
            <div class="err-actions">
                <a href="/" class="btn-primary"><i class="bi bi-house-fill"></i> Back to Dashboard</a>
                <a href="javascript:history.back()" class="btn-ghost"><i class="bi bi-arrow-left"></i> Go Back</a>
            </div>
        </div>
    </div>
</div>
