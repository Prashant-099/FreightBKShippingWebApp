@page "/500"
@layout EmptyLayout

<PageTitle>500 – Server Error | FreightBook</PageTitle>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=JetBrains+Mono:wght@500&display=swap');
    *, *::before, *::after { box-sizing:border-box; margin:0; padding:0; }

    body, .err-shell { background:#f0f4f8; font-family:'Sora',sans-serif; }
    .err-shell { min-height:100vh; display:flex; flex-direction:column; }

    .err-header {
        height:60px; background:linear-gradient(90deg,#1a73e8 0%,#1557b0 100%);
        display:flex; align-items:center; padding:0 1.25rem; gap:.75rem;
        box-shadow:0 2px 8px rgba(21,87,176,.3); flex-shrink:0;
    }
    .err-header img { height:36px; width:36px; border-radius:8px; border:2px solid rgba(255,255,255,.3); }
    .hdr-brand { display:flex; flex-direction:column; line-height:1.2; }
    .hdr-brand-name { font-size:1rem; font-weight:800; color:#fff; }
    .hdr-brand-sub  { font-size:.65rem; color:rgba(255,255,255,.7); }
    .hdr-marquee {
        flex:1; overflow:hidden;
        mask-image:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent);
    }
    .hdr-marquee-inner {
        display:inline-flex; white-space:nowrap;
        animation:marquee 20s linear infinite;
        font-size:.78rem; color:rgba(255,255,255,.85); font-family:'JetBrains Mono',monospace;
    }
    @@keyframes marquee { from{transform:translateX(0)} to{transform:translateX(-50%)} }

    .err-body  { flex:1; display:flex; align-items:center; justify-content:center; padding:32px 20px; }
    .err-wrap  { width:100%; max-width:540px; animation:fadeUp .45s ease both; }

    .err-banner {
        background:linear-gradient(135deg,#d97706 0%,#b45309 100%);
        border-radius:16px; padding:22px 24px; margin-bottom:16px;
        display:flex; align-items:center; justify-content:space-between;
        box-shadow:0 4px 16px rgba(180,83,9,.25);
    }
    .err-banner h2 { font-size:1.15rem; font-weight:800; color:#fff; margin-bottom:3px; letter-spacing:-.3px; }
    .err-banner p  { font-size:.78rem; color:rgba(255,255,255,.75); font-family:'JetBrains Mono',monospace; }
    .err-badge {
        background:rgba(255,255,255,.2); border:1px solid rgba(255,255,255,.3);
        color:#fff; font-size:.7rem; font-weight:700;
        font-family:'JetBrains Mono',monospace;
        padding:.3rem .85rem; border-radius:100px;
        letter-spacing:1px; text-transform:uppercase;
    }

    .err-card {
        background:#fff; border-radius:16px; border:1px solid #e2e8f0;
        padding:2.5rem 2rem 2.25rem; text-align:center;
        box-shadow:0 2px 12px rgba(0,0,0,.06);
        position:relative; overflow:hidden;
    }
    .err-card::before {
        content:''; position:absolute; top:0; left:0; right:0; height:4px;
        background:linear-gradient(90deg,#f59e0b,#fbbf24);
    }

    .err-icon-box {
        width:72px; height:72px; border-radius:16px;
        display:flex; align-items:center; justify-content:center;
        margin:0 auto 1.5rem; font-size:1.9rem;
        background:#f59e0b; color:#fff;
        animation:warnPulse 2.5s ease-in-out infinite;
    }
    @@keyframes warnPulse {
        0%,100% { box-shadow:0 0 0 0 rgba(245,158,11,.4); }
        50%      { box-shadow:0 0 0 12px rgba(245,158,11,.0); }
    }

    .err-label   { font-size:.65rem; font-weight:700; color:#94a3b8; text-transform:uppercase; letter-spacing:1.5px; font-family:'JetBrains Mono',monospace; margin-bottom:.35rem; }
    .err-code    { font-family:'JetBrains Mono',monospace; font-size:clamp(4.5rem,15vw,7rem); font-weight:700; line-height:1; letter-spacing:-3px; color:#f59e0b; margin-bottom:.2rem; }
    .err-divider { width:40px; height:3px; background:linear-gradient(90deg,#f59e0b,#fbbf24); margin:.65rem auto .9rem; border-radius:2px; }
    .err-title   { font-size:1.2rem; font-weight:700; color:#1e293b; letter-spacing:-.3px; margin-bottom:.45rem; }
    .err-sub     { font-size:.83rem; color:#64748b; line-height:1.65; max-width:360px; margin:0 auto 2rem; }

    .err-actions { display:flex; gap:.75rem; justify-content:center; flex-wrap:wrap; }
    .btn-primary {
        display:inline-flex; align-items:center; gap:.45rem;
        padding:.6rem 1.5rem; background:#f59e0b; color:#fff;
        border:none; border-radius:10px;
        font-family:'Sora',sans-serif; font-size:.85rem; font-weight:700;
        cursor:pointer; text-decoration:none;
        box-shadow:0 4px 12px rgba(245,158,11,.35);
        transition:background .18s,transform .18s;
    }
    .btn-primary:hover { background:#d97706; transform:translateY(-2px); }
    .btn-ghost {
        display:inline-flex; align-items:center; gap:.45rem;
        padding:.6rem 1.5rem; background:#f1f5f9; color:#64748b;
        border:1px solid #e2e8f0; border-radius:10px;
        font-family:'Sora',sans-serif; font-size:.85rem;
        cursor:pointer; text-decoration:none; transition:background .18s;
    }
    .btn-ghost:hover { background:#e2e8f0; color:#334155; }

    .err-footer {
        height:40px; background:#fff; border-top:1px solid #e2e8f0;
        display:flex; align-items:center; justify-content:center;
        font-size:.75rem; color:#94a3b8; font-family:'JetBrains Mono',monospace;
    }
    @@keyframes fadeUp { from{opacity:0;transform:translateY(14px)} to{opacity:1;transform:translateY(0)} }
</style>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<div class="err-shell">
    <header class="err-header">
        <img src="images/freightbook.jpg" alt="FB" />
        <div class="hdr-brand">
            <span class="hdr-brand-name">FreightBook</span>
            <span class="hdr-brand-sub">Shipping Management</span>
        </div>
        <div class="hdr-marquee">
            <div class="hdr-marquee-inner">
                <span>FREIGHTBOOKSHIPPING &nbsp;&nbsp;<i class="bi bi-headset"></i> 9409309616 &nbsp;&nbsp;&nbsp;&nbsp; FREIGHTBOOKSHIPPING &nbsp;&nbsp;<i class="bi bi-headset"></i> 9409309616 &nbsp;&nbsp;&nbsp;&nbsp;</span>
            </div>
        </div>
    </header>

    <div class="err-body">
        <div class="err-wrap">
            <div class="err-banner">
                <div>
                    <h2>⚠ Server Error</h2>
                    <p>HTTP 500 · Internal Server Error</p>
                </div>
                <span class="err-badge">Error 500</span>
            </div>
            <div class="err-card">
                <div class="err-icon-box"><i class="bi bi-exclamation-triangle-fill"></i></div>
                <div class="err-label">Status Code</div>
                <div class="err-code">500</div>
                <div class="err-divider"></div>
                <div class="err-title">Internal Server Error</div>
                <p class="err-sub">Something went wrong on our end. Our team has been notified. Please refresh or try again in a moment.</p>
                <div class="err-actions">
                    <a href="javascript:location.reload()" class="btn-primary"><i class="bi bi-arrow-clockwise"></i> Try Again</a>
                    <a href="/" class="btn-ghost"><i class="bi bi-house-fill"></i> Dashboard</a>
                </div>
            </div>
        </div>
    </div>

    <footer class="err-footer"><i class="bi bi-headset me-1"></i>&nbsp;Support: 9409309616</footer>
</div>
