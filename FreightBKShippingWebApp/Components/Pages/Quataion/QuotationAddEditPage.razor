    // All calculations based on SALE RATE (BillDetailRate), not purchase rate
    private void UpdateRowAmounts(BillDetail item)
    {
        if (item == null) return;

        if (item.BillDetailProductId > 0)
        {
            var selectedService = ServiceList.FirstOrDefault(s => s.ServiceId == item.BillDetailProductId);
            if (selectedService != null)
            {
                item.BillDetailStatus = true;
                item.BillDetailHsnCode = selectedService.HsnName;

                var unitName = UnitList.FirstOrDefault(u => u.UnitId == selectedService.ServiceUnitId);
                item.BillDetailUnit = unitName?.UnitName;
                item.BillDetailUnitId = unitName?.UnitId ?? 0;

                if (item.BillDetailQty == 0)
                    item.BillDetailQty = 1;

                var selectedHsn = HsnList.FirstOrDefault(h => h.HsnName == selectedService.HsnName);
                var selectedGstslab = GstslabList.FirstOrDefault(h => h.GstSlabIgstPer == selectedService.HsnGstPer);

                // ✅ Auto-fill purchase rate if not set
                if (item.BillDetailActualRate == 0 && selectedService?.ServicePRate != null)
                {
                    item.BillDetailActualRate = (double)selectedService.ServicePRate; // Purchase rate
                }

                // ✅ Auto-fill sale rate if not set
                if (item.BillDetailRate == 0)
                {
                    item.BillDetailRate = selectedService.ServiceSRate; // Sale rate
                }

                // All calculations use SALE RATE
                item.BillDetailAmount = (double)(item.BillDetailQty * item?.BillDetailRate??0);
                item.BillDetailTaxableAmt = item.BillDetailAmount;

                if (selectedHsn != null)
                {
                    item.BillDetailHsnId = selectedHsn.HsnId;
                    item.BillDetailGstPer = selectedHsn.HsnGstPer;

                    var billDetailSlabId = GstslabList.FirstOrDefault(h => h.GstSlabId == selectedHsn.HsnGstSlabId);
                    item.BillDetailSlabId = billDetailSlabId?.GstSlabName;
                }

                var selectedCompany = CompanyList?.FirstOrDefault(c => c.Status == true);
                var selectedPos = StateList.FirstOrDefault(h => h.StateId == EditModel.BillPlaceOfSupply);

                if (selectedCompany != null && selectedPos != null)
                {
                    var companyState = StateList?.FirstOrDefault(s =>
                        s.StateId != null &&
                        s.StateId.ToString() == selectedCompany.StateId.ToString());

                    if (companyState != null)
                    {
                        int companyStateId = companyState.StateId;

                        if (companyStateId == EditModel.BillPlaceOfSupply)
                        {
                            // Intra-state → CGST + SGST
                            item.BillDetailIgst = 0;
                            item.BillDetailIgstPer = 0;
                            item.BillDetailCgstPer = item.BillDetailGstPer / 2;
                            item.BillDetailSgstPer = item.BillDetailGstPer / 2;
                            item.BillDetailCgst = item.BillDetailTaxableAmt * (item.BillDetailCgstPer / 100);
                            item.BillDetailSgst = item.BillDetailTaxableAmt * (item.BillDetailSgstPer / 100);
                        }
                        else
                        {
                            // Inter-state → IGST
                            item.BillDetailCgstPer = 0;
                            item.BillDetailSgstPer = 0;
                            item.BillDetailCgst = 0;
                            item.BillDetailSgst = 0;
                            item.BillDetailIgstPer = item.BillDetailGstPer;
                            item.BillDetailIgst = item.BillDetailTaxableAmt * (item.BillDetailIgstPer / 100);
                        }

                        if (EditModel.BillIsRcm)
                        {
                            item.BillDetailIgst = 0;
                            item.BillDetailCgst = 0;
                            item.BillDetailSgst = 0;
                            item.BillDetailIgstPer = 0;
                            item.BillDetailCgstPer = 0;
                            item.BillDetailSgstPer = 0;
                            item.BillDetailSlabId = "RCM";
                        }
                    }
                }
            }
        }

        item.BillDetailAmount = (double)(item.BillDetailQty * item?.BillDetailRate??0);
        item.BillDetailTaxableAmt = item.BillDetailAmount;
        item.BillDetailTotal = item.BillDetailTaxableAmt + item.BillDetailIgst + item.BillDetailCgst + item.BillDetailSgst;

        if (EditModel != null)
        {
            EditModel.BillIgst = (float)BillDetails
                .Where(d => !UnsavedChanges.ContainsKey(d) || UnsavedChanges[d].Type != DataChangeType.Delete)
                .Sum(d => d.BillDetailIgst);

            EditModel.BillCgst = (float)BillDetails
                .Where(d => !UnsavedChanges.ContainsKey(d) || UnsavedChanges[d].Type != DataChangeType.Delete)
                .Sum(d => d.BillDetailCgst);

            EditModel.BillSgst = (float)BillDetails
                .Where(d => !UnsavedChanges.ContainsKey(d) || UnsavedChanges[d].Type != DataChangeType.Delete)
                .Sum(d => d.BillDetailSgst);

            RecalculateNetAmount(EditModel.BillIsRoundOff);
        }
    }

    private void RecalculateNetAmount(bool isChecked)
    {
        EditModel.BillIsRoundOff = isChecked;
        if (EditModel == null) return;

        var baseAmount = (decimal)BillDetails
            .Where(d => !UnsavedChanges.ContainsKey(d) || UnsavedChanges[d].Type != DataChangeType.Delete)
            .Sum(d => d.BillDetailTotal);

        if (EditModel.BillIsRoundOff)
        {
            var roundedAmount = Math.Round(baseAmount, 0, MidpointRounding.AwayFromZero);
            var roundOffDifference = roundedAmount - baseAmount;

            EditModel.BillRoundAmt = (float)roundOffDifference;
            EditModel.BillNetAmount = (float)roundedAmount;
        }
        else
        {
            EditModel.BillRoundAmt = 0;
            EditModel.BillNetAmount = (float)Math.Round(baseAmount, 2);
        }
    }

    private HashSet<string> ApplyModifiedFields(BillDetail source, BillDetail target)
    {
        var changedFields = new HashSet<string>();
        var properties = typeof(BillDetail).GetProperties();

        foreach (var prop in properties)
        {
            if (prop.Name == "BillDetailSno" || prop.Name == "BillDetailId") continue;

            var sourceValue = prop.GetValue(source);
            var targetValue = prop.GetValue(target);

            if (!Equals(sourceValue, targetValue))
            {
                prop.SetValue(target, sourceValue);
                changedFields.Add(prop.Name);
            }
        }

        return changedFields;
    }

    private void ApplyRcmLogic(bool isChecked)
    {
        EditModel.BillIsRcm = isChecked;

        if (EditModel.BillIsRcm)
        {
            foreach (var detail in BillDetails)
            {
                detail.BillDetailTotal = detail.BillDetailTaxableAmt;
            }

            if (!EditModel.BillRemarks?.Contains("RCM") ?? true)
            {
                EditModel.BillRemarks = (EditModel.BillRemarks ?? "") +
                    "Tax is payable under Reverse Charge Mechanism by the recipient as per Section 9(3) of CGST Act 2017.";
            }
        }
        else
        {
            EditModel.BillRemarks = EditModel.BillRemarks?.Replace(
                "Tax is payable under Reverse Charge Mechanism by the recipient as per Section 9(3) of CGST Act 2017.", "");

            foreach (var detail in BillDetails)
            {
                UpdateRowAmounts(detail);
            }
        }

        RecalculateNetAmount(EditModel.BillIsRoundOff);
        StateHasChanged();
    }

    private void ApplyRoundOff(bool isChecked)
    {
        EditModel.BillIsRoundOff = isChecked;
        RecalculateNetAmount(EditModel.BillIsRoundOff);
        StateHasChanged();
    }

    private async Task CopyDetails()
    {
        LoadingService.Show();
        try
        {
            foreach (var unsavedChange in UnsavedChanges)
            {
                var changedItem = unsavedChange.Key;
                var changeType = unsavedChange.Value.Type;

                if (changeType == DataChangeType.Modification)
                {
                    UpdateRowAmounts(changedItem);
                }
            }

            var activeDetails = BillDetails
                .Where(d => !UnsavedChanges.ContainsKey(d) || UnsavedChanges[d].Type != DataChangeType.Delete)
                .OrderBy(d => d.BillDetailSno)
                .ToList();

            int sequentialSno = 1;
            foreach (var detail in activeDetails)
            {
                detail.BillDetailSno = sequentialSno++;
            }

            EditModel.BillAmount = activeDetails.Sum(d => d.BillDetailAmount);
            EditModel.BillTaxableAmt = activeDetails.Sum(d => d.BillDetailTaxableAmt);
            EditModel.BillTotal = EditModel.BillNetAmount;
            EditModel.BillYearId = YearStatechangeService.SelectedYearId;

            var validDetails = activeDetails
                .Where(d => d.BillDetailProductId > 0 || !string.IsNullOrEmpty(d.BillDetailHsnCode))
                .ToList();

            EditModel.BillDetails = validDetails.OrderBy(d => d.BillDetailSno).ToList();
            EditModel.BillId = 0;
            EditModel.BillTime = DateTime.Now.ToString("hh:mm tt");

            int result = await BillService.CreateAsync(EditModel);

            if (result > 0)
                ToastService.Success("Quotation created successfully!");
            else
            {
                ToastService.Error("Failed to create Quotation!");
                return;
            }

            UnsavedChanges.Clear();
            Visible = false;
            await OnSaved.InvokeAsync();
        }
        catch (Exception ex)
        {
            ToastService.Error($"Error saving quotation: {ex.Message}");
        }
        finally
        {
            LoadingService.Hide();
        }
    }

    private async Task OnSubmit()
    {
        await HandleValidSubmit(_isPrint);
    }

    private async Task HandleValidSubmit(bool isPrint = false)
    {
        LoadingService.Show();
        try
        {
            foreach (var unsavedChange in UnsavedChanges)
            {
                var changedItem = unsavedChange.Key;
                var changeType = unsavedChange.Value.Type;

                if (changeType == DataChangeType.Modification)
                {
                    UpdateRowAmounts(changedItem);
                }
            }

            var activeDetails = BillDetails
                .Where(d => !UnsavedChanges.ContainsKey(d) || UnsavedChanges[d].Type != DataChangeType.Delete)
                .OrderBy(d => d.BillDetailSno)
                .ToList();

            int sequentialSno = 1;
            foreach (var detail in activeDetails)
            {
                detail.BillDetailSno = sequentialSno++;
            }

            EditModel.BillAmount = activeDetails.Sum(d => d.BillDetailAmount);
            EditModel.BillTaxableAmt = activeDetails.Sum(d => d.BillDetailTaxableAmt);
            EditModel.BillTotal = EditModel.BillNetAmount;
            EditModel.BillYearId = YearStatechangeService.SelectedYearId;

            var validDetails = activeDetails
                .Where(d => d.BillDetailProductId > 0 || !string.IsNullOrEmpty(d.BillDetailHsnCode))
                .ToList();

            EditModel.BillDetails = validDetails.OrderBy(d => d.BillDetailSno).ToList();

            int savedQuotationId = EditModel.BillId;
            bool result;

            if (EditModel.BillId == 0)
            {
                EditModel.BillTime = DateTime.Now.ToString("hh:mm tt");
                savedQuotationId = await BillService.CreateAsync(EditModel);

                if (savedQuotationId > 0)
                    ToastService.Success("Quotation created successfully!");
                else
                {
                    ToastService.Error("Failed to create Quotation!");
                    return;
                }
            }
            else
            {
                result = await BillService.UpdateAsync(EditModel);

                if (result)
                    ToastService.Success("Quotation updated successfully!");
                else
                {
                    ToastService.Error(
                        string.IsNullOrWhiteSpace(BillService.LastError)
                            ? "Failed to update Quotation!"
                            : BillService.LastError
                    );
                    return;
                }
            }

            if (isPrint)
            {
                await PreviewMergedReports(EditModel.BillReportId, savedQuotationId);
            }

            UnsavedChanges.Clear();
            Visible = false;
            await OnSaved.InvokeAsync();
        }
        catch (Exception ex)
        {
            ToastService.Error($"Error saving quotation: {ex.Message}");
        }
        finally
        {
            LoadingService.Hide();
        }
    }

    private async Task PreviewMergedReports(int reportId, int quotationId)
    {
        if (reportId == 0)
        {
            ToastService.Warning("No quotation to print.");
            return;
        }

        LoadingService.Show("Building merged report...");
        try
        {
            var layoutBytes = await ReportDataService.GetLayoutBytesAsync(reportId);
            if (layoutBytes == null || layoutBytes.Length == 0)
            {
                ToastService.Error("Failed to load report layout.");
                return;
            }

            var quotationList = new List<Bill> { EditModel };
            var dto = await BillService.GetPrintableBillAsync(quotationId);

            var dtoDict = new Dictionary<Bill, PrintBillFullDto?>
            {
                { EditModel, dto }
            };

            await ReportService.CreateMergedReportAsync(
                quotationList,
                quotation => dtoDict.ContainsKey(quotation) ? dtoDict[quotation] : null,
                layoutBytes);

            Navigation.NavigateTo("/reportviewer");
        }
        finally
        {
            LoadingService.Hide();
        }
    }

    record DataChange(DataChangeType Type, HashSet<string> ChangedFields);
    enum DataChangeType { Modification, Addition, Delete }
}
