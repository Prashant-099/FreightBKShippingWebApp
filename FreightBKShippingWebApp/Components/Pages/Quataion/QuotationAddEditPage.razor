@using FreightBKShippingWebApp.Components.Pages.Account
@using FreightBKShippingWebApp.Components.Pages.ServicePage
@using FreightBKShippingWebApp.Model
@using FreightBKShippingWebApp.Models
@using FreightBKShippingWebApp.Services
@using DevExpress.Blazor

@inject BillService BillService
@inject ToasteService ToastService
@inject LoadingService LoadingService
@inject VoucherService VoucherService
@inject AccountService AccountService
@inject NotifyService NotifyService
@inject ServiceService ServiceService
@inject UnitService UnitService
@inject HsnSacService HsnSacService
@inject GstSlabService GstSlabService
@inject StateService StateService
@inject CompanyService CompanyService
@inject YearStatechangeService YearStatechangeService
@inject BranchService BranchService
@inject ReportDataService ReportDataService
@inject ReportService ReportService
@inject ConfirmationDialogService ConfirmDialogService
@inject NavigationManager Navigation
@inject GridLayoutService GridLayoutService
@inject LocationService LocationService
@inject NotifyService NotifyService
@inject IBranchContext BranchContext

<style>
    /* Mobile Grid Fix */
    .quotation-grid-wrapper {
        width: 100%;
        overflow-x: auto ;
        overflow-y: visible;
        -webkit-overflow-scrolling: touch;
        position: relative;
    }

        .quotation-grid-wrapper .dxbl-grid {
            min-width: 1800px;
            width: max-content;
        }
    /* Prevent column shrinking */
        .quotation-grid-wrapper .dxbl-grid-table {
        table-layout: auto !important;
        width: 100% !important;
    }
    .fixed-height-grid {
        height: 300px;
        overflow-y: auto;
    }

    @@media (max-width: 768px) {
        .fixed-height-grid {
            height: 220px;
        }

        .quotation-grid-wrapper {
            margin: 0 -10px;
            padding: 0 10px;
        }
    }

    .net-amount-box {
        background-color: #e3fcef;
        border-radius: 8px;
        padding: 6px 10px;
        font-weight: bold;
    }

    .net-amount-field {
        font-size: 1.1rem;
        font-weight: 700;
        color: #0a4b0a;
        background-color: #d8f8e1 ;
        border: 2px solid #7dd87d;
        border-radius: 6px;
        text-align: right;
    }

    .right-stack {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 6px;
        width: 100%;
    }

    .right-row {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 10px;
        width: auto;
    }

    .right-spin {
        min-width: 160px;
    }

        .right-spin .dx-texteditor-input {
            text-align: right ;
        }

    .roundoff-amt {
        min-width: 140px;
    }

    .total-amt {
        min-width: 220px;
        font-weight: 700;
        font-size: 1.15rem;
        background-color: #e9fef0 ;
        border: 3px solid #28a745 ;
        border-radius: 6px;
    }

    @@media (max-width: 768px) {
        .right-stack {
            align-items: stretch;
            width: 100%;
        }

        .right-row {
            flex-direction: column;
            align-items: stretch;
            gap: 4px;
        }

        .right-spin, .roundoff-amt, .total-amt {
            width: 100% ;
            min-width: 100% ;
        }
    }

    .my-footer {
        position: sticky;
        bottom: 0;
        background: #f8f9fa;
        padding: 12px;
        display: flex;
        justify-content: space-between;
        gap: 12px;
        z-index: 20;
    }

    .footer-left, .footer-right {
        display: flex;
        gap: 10px;
        align-items: center;
    }

    @@media (max-width: 768px) {
        .my-footer {
            flex-direction: column;
            gap: 14px;
            padding: 10px;
        }

        .footer-left {
            flex-direction: column;
            width: 100%;
        }

        .footer-right {
            width: 100%;
            flex-wrap: wrap;
            justify-content: flex-end;
        }
    }
</style>

<DxPopup @bind-Visible="Visible"
         ShowCloseButton="true"
         HeaderText="@Title"
         CloseOnOutsideClick="false"
         MaxWidth="1400"
         Width="82vw"
         MaxHeight="95vh"
         horizontalAlignment="HorizontalAlignment.Center"
         verticalAlignment="VerticalAlignment.Center"
         BodyCssClass="my-popup-body"
         ShowFooter="true"
         Scrollable="true"
         FooterCssClass="my-footer">

    <BodyContentTemplate Context="bdy">
        <EditForm Model="@EditModel" OnValidSubmit="OnSubmit" Context="cxquotation" id="quotationForm">
            <DataAnnotationsValidator />

            <DxFormLayout>
                <DxFormLayoutItem Caption="Quotation Type" ColSpanMd="3">
                    <ChildContent Context="ctx">
                        <DxComboBox TData="Voucher" TValue="int"
                                    Data="@VoucherList"
                                    TextFieldName="VoucherName"
                                    ValueFieldName="VoucherId"
                                    AllowUserInput="true"
                                    ShowValidationIcon="true"
                                    NullText="-- Select Quotation Type --"
                                    Value="@EditModel.BillVoucherId"
                                    ValueChanged="@((int voucherId) => OnVoucherChanged(EditModel, voucherId))"
                                    ValueExpression="@( () => EditModel.BillVoucherId )"
                                    SearchMode="ListSearchMode.AutoSearch"
                                    SearchFilterCondition="ListSearchFilterCondition.StartsWith"
                                    ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                    </ChildContent>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="Quotation No" ColSpanMd="3">
                    <ChildContent Context="ctx">
                        <DxTextBox @bind-Text="EditModel.BillNo" ReadOnly="true" />
                    </ChildContent>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="Date" ColSpanMd="3">
                    <ChildContent Context="ctx">
                        <DxDateEdit @bind-Date="EditModel.BillDate" ShowValidationIcon="true" Format="dd-MM-yyyy" />
                        <ValidationMessage For="@(() => EditModel.BillDate)" />
                    </ChildContent>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="Valid Until" ColSpanMd="3">
                    <ChildContent Context="ctx">
                        <DxDateEdit @bind-Date="EditModel.BillDueDate" Format="dd-MM-yyyy" />
                    </ChildContent>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="Supply Type" ColSpanMd="3">
                    <DxComboBox Data="@SupplyTypeList"
                                @bind-Value="EditModel.BillSupplyType"
                                TextFieldName="Text"
                                ValueFieldName="Value"
                                ShowValidationIcon="true"
                                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                AllowUserInput="true"
                                SearchMode="ListSearchMode.AutoSearch"
                                SearchFilterCondition="ListSearchFilterCondition.StartsWith" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="Place of Supply" ColSpanMd="3">
                    <DxComboBox TData="State" TValue="int"
                                Data="@stateList"
                                TextFieldName="StateName"
                                ValueFieldName="StateId"
                                ClearButtonVisible="true"
                                AllowUserInput="true"
                                NullText="-- Select POS --"
                                @bind-Value="EditModel.BillPlaceOfSupply"
                                SearchMode="ListSearchMode.AutoSearch"
                                SearchFilterCondition="ListSearchFilterCondition.StartsWith" />
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="Customer Name" ColSpanMd="6">
                    <div style="position: relative; display: inline-block; width: 100%;">
                        <DxButton Click="@ShowAccountPopup"
                                  Text="+"
                                  CssClass="custom-plus-button" />
                        <DxComboBox TData="Account" TValue="int"
                                    Data="@AccountList"
                                    TextFieldName="AccountName"
                                    ValueFieldName="AccountId"
                                    Value="@EditModel.BillPartyId"
                                    ValueChanged="@((int partyid) => OnPartyChanged(partyid))"
                                    ValueExpression="@(() => EditModel.BillPartyId)"
                                    AllowUserInput="false"
                                    NullText="-- Select Customer --"
                                    SearchMode="ListSearchMode.AutoSearch"
                                    SearchFilterCondition="ListSearchFilterCondition.StartsWith"
                                    ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                    </div>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="Branch" ColSpanMd="3">
                    <DxComboBox TData="Branch" TValue="int"
                                Data="@branchList"
                                TextFieldName="BranchName"
                                ValueFieldName="BranchId"
                                AllowUserInput="true"
                                ShowValidationIcon="true"
                                NullText="-- Select Branch --"
                                Value="@EditModel.BillBranchId"
                                ValueChanged="@((int branchId) => OnBranchChanged(EditModel, branchId))"
                                ValueExpression="@( () => EditModel.BillBranchId )"
                                SearchMode="ListSearchMode.AutoSearch"
                                SearchFilterCondition="ListSearchFilterCondition.StartsWith"
                                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                </DxFormLayoutItem>
                 <DxFormLayoutItem Caption="POL" ColSpanMd="3">
     <DxComboBox TData="Location" TValue="int"
     Data="@locationList"
     TextFieldName="LocationName"
     ValueFieldName="LocationId"
     AllowUserInput="true"
     NullText="-- Select POl --"
     @bind-Value="EditModel.BillPolId"
     SearchMode="ListSearchMode.AutoSearch"
     SearchFilterCondition="ListSearchFilterCondition.StartsWith" />

 </DxFormLayoutItem>
   <DxFormLayoutItem Caption="POD" ColSpanMd="3">
      <DxComboBox TData="Location" TValue="int"
      Data="@locationList"
      TextFieldName="LocationName"
      ValueFieldName="LocationId"
      AllowUserInput="true"
      NullText="-- Select POD --"
      @bind-Value="EditModel.BillPodId"
      SearchMode="ListSearchMode.AutoSearch"
      SearchFilterCondition="ListSearchFilterCondition.StartsWith" />
  </DxFormLayoutItem>

                <DxFormLayoutItem Caption="Line" ColSpanMd="3">
                    <DxComboBox TData="Notify" TValue="int"
                                Data="@LineList"
                                TextFieldName="NotifyName"
                                ValueFieldName="NotifyId"
                                AllowUserInput="true"
                                NullText="-- Select Line --"
                                @bind-Value="EditModel.BillLineId"
                                SearchMode="ListSearchMode.AutoSearch"
                                SearchFilterCondition="ListSearchFilterCondition.StartsWith" />
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Is RCM Applicable" ColSpanMd="3">
                    <DxCheckBox Checked="@EditModel.BillIsRcm"
                                CheckedChanged="@((bool isChecked) => ApplyRcmLogic(isChecked))"
                                CheckedExpression="() => EditModel.BillIsRcm" />
                </DxFormLayoutItem>
            </DxFormLayout>
           



                            
                            
            <DxFormLayout>
                <DxFormLayoutTabPages>
                    <DxFormLayoutTabPage Caption="Service Details">
                        <div class="quotation-grid-wrapper">
                            <DxGrid Data="@BillDetails.OrderBy(x => x.BillDetailSno)"
                                    TItem="BillDetail"
                                    @ref="DetailGrid"
                                    KeyFieldName="BillDetailSno"
                                    EditMode="GridEditMode.EditCell"
                                    EditOnKeyPress="true"
                                    ShowAddNewButton="true"
                                    EditModelSaving="Grid_EditModelSaving"
                                    CustomizeElement="Grid_CustomizeElement"
                                    CustomizeEditModel="Grid_CustomizeEditModel"
                                    ShowFilterRow="false"
                                    AllowSort="false"
                                    ShowGroupPanel="false"
                                    ColumnResizeMode="GridColumnResizeMode.NextColumn"
                                    TextWrapEnabled="false"
                                    PageSize="10"
                                    CssClass="fixed-height-grid mobile-grid">
                                <Columns>
                                    <DxGridCommandColumn Width="90px"
                                                         EditButtonVisible="false"
                                                         FixedPosition="GridColumnFixedPosition.Left"
                                                         CancelButtonVisible="false"
                                                         SaveButtonVisible="false"
                                                         NewButtonVisible="false"
                                                         Visible="@(layoutManager?.GetColumnVisibility("Actions") ?? true)">
                                        <HeaderCaptionTemplate>
                                            <DxButton IconCssClass="bi bi-plus-circle-dotted"
                                                      RenderStyle="ButtonRenderStyle.Link"
                                                      Click="New_Click" />
                                            <DxButton IconCssClass="bi bi-arrow-clockwise"
                                                      RenderStyle="ButtonRenderStyle.Link"
                                                      Click="Revert_Click" />
                                            <DxButton RenderStyle="ButtonRenderStyle.Link"
                                                      IconCssClass="bi bi-three-dots"
                                                      SizeMode="SizeMode.Medium"
                                                      Click="ShowLayoutPopup" />
                                        </HeaderCaptionTemplate>

                                        <CellEditTemplate>
                                            <DxButton Enabled="false"
                                                      CssClass="grid-disabled-button"
                                                      IconCssClass="bi bi-trash"
                                                      RenderStyle="ButtonRenderStyle.Link" />
                                            <DxButton IconCssClass="bi bi-plus-lg"
                                                      RenderStyle="ButtonRenderStyle.Link"
                                                      Click="ShowServicePopup" />
                                        </CellEditTemplate>

                                        <CellDisplayTemplate>
                                            <DxButton IconCssClass="bi bi-trash"
                                                      CssClass="grid-delete-btn"
                                                      RenderStyle="ButtonRenderStyle.Link"
                                                      Click="@(() => DeleteDataItem(context.DataItem))" />
                                            <DxButton IconCssClass="bi bi-plus-lg"
                                                      RenderStyle="ButtonRenderStyle.Link"
                                                      Click="ShowServicePopup" />
                                        </CellDisplayTemplate>
                                    </DxGridCommandColumn>

                                    <DxGridDataColumn FieldName="BillDetailSno" Caption="SNo"
                                                      Width="@(layoutManager?.GetColumnWidth("BillDetailSno") ?? "60px")"
                                                      ReadOnly="true"
                                                      Visible="@(layoutManager?.GetColumnVisibility("BillDetailSno") ?? true)"
                                                      SortOrder="GridColumnSortOrder.Descending">
                                        <EditSettings>
                                            <DxSpinEditSettings ShowSpinButtons="false" />
                                        </EditSettings>
                                    </DxGridDataColumn>

                                    <DxGridDataColumn TextAlignment="GridTextAlignment.Left"
                                                      FieldName="BillDetailProductId"
                                                      Caption="Service Name"
                                                      Width="@(layoutManager?.GetColumnWidth("BillDetailProductId") ?? "180px")"
                                                      Visible="@(layoutManager?.GetColumnVisibility("BillDetailProductId") ?? true)">
                                        <CellDisplayTemplate>
                                            @{
                                                var serviceId = (int)context.Value;
                                                var selectedService = ServiceList.FirstOrDefault(s => s.ServiceId == serviceId);
                                            }
                                            <span>@(selectedService?.ServiceName ?? "")</span>
                                        </CellDisplayTemplate>

                                        <CellEditTemplate Context="editcontext">
                                            @{
                                                var service = (BillDetail)editcontext.EditModel;
                                            }
                                            <DxComboBox Data="@ServiceList"
                                                        TValue="int"
                                                        TData="Service"
                                                        Value="@service.BillDetailProductId"
                                                        ValueExpression="@(() => service.BillDetailProductId)"
                                                        TextFieldName="ServiceName"
                                                        ValueFieldName="ServiceId"
                                                        NullText="Select a Service"
                                                        AllowUserInput="true"
                                                        SearchFilterCondition="ListSearchFilterCondition.Contains"
                                                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                                        ValueChanged="@(newServiceId => OnServiceSelected(newServiceId, service))" />
                                        </CellEditTemplate>
                                    </DxGridDataColumn>

                                    <DxGridDataColumn FieldName="BillDetailRemarks" Caption="Description"
                                                      Visible="@(layoutManager?.GetColumnVisibility("BillDetailRemarks") ?? true)"
                                                      Width="@(layoutManager?.GetColumnWidth("BillDetailRemarks") ?? "150px")" />

                                    <DxGridDataColumn FieldName="BillDetailHsnCode" Caption="SAC" ReadOnly="true"
                                                      Visible="@(layoutManager?.GetColumnVisibility("BillDetailHsnCode") ?? true)"
                                                      Width="@(layoutManager?.GetColumnWidth("BillDetailHsnCode") ?? "100px")" />

                                    <DxGridDataColumn FieldName="BillDetailUnit" Caption="Unit" ReadOnly="true"
                                                      Visible="@(layoutManager?.GetColumnVisibility("BillDetailUnit") ?? true)"
                                                      Width="@(layoutManager?.GetColumnWidth("BillDetailUnit") ?? "80px")" />

                                    <!-- ✅ NEW COLUMN: Purchase Rate (Actual Rate) -->
                                    <DxGridDataColumn FieldName="BillDetailActualRate" Caption="Purchase Rate"
                                                      Visible="@(layoutManager?.GetColumnVisibility("BillDetailActualRate") ?? true)"
                                                      Width="@(layoutManager?.GetColumnWidth("BillDetailActualRate") ?? "120px")">
                                        <CellEditTemplate Context="editcontext">
                                            @{
                                                var row = (BillDetail)editcontext.EditModel;
                                            }
                                            <input type="number"
                                                   step="0.01"
                                                   class="form-control"
                                                   value="@row.BillDetailActualRate"
                                                   @onchange="@((ChangeEventArgs e) => OnActualRateChanged(ParseDouble(e.Value), row))" />
                                        </CellEditTemplate>
                                    </DxGridDataColumn>

                                    <!-- Sale Rate Column -->
                                    <DxGridDataColumn FieldName="BillDetailRate" Caption="Sale Rate"
                                                      Visible="@(layoutManager?.GetColumnVisibility("BillDetailRate") ?? true)"
                                                      Width="@(layoutManager?.GetColumnWidth("BillDetailRate") ?? "100px")">
                                        <CellEditTemplate Context="editcontext">
                                            @{
                                                var row = (BillDetail)editcontext.EditModel;
                                            }
                                            <input type="number"
                                                   step="0.01"
                                                   class="form-control"
                                                   value="@row.BillDetailRate"
                                                   @onchange="@((ChangeEventArgs e) => OnRateChanged(ParseDouble(e.Value), row))" />
                                        </CellEditTemplate>
                                    </DxGridDataColumn>

                                    <DxGridDataColumn FieldName="BillDetailQty" Caption="Qty"
                                                      Visible="@(layoutManager?.GetColumnVisibility("BillDetailQty") ?? true)"
                                                      Width="@(layoutManager?.GetColumnWidth("BillDetailQty") ?? "80px")">
                                        <CellEditTemplate Context="editcontext">
                                            @{
                                                var row = (BillDetail)editcontext.EditModel;
                                            }
                                            <input type="number"
                                                   step="0.01"
                                                   class="form-control"
                                                   value="@row.BillDetailQty"
                                                   @onchange="@((ChangeEventArgs e) => OnQtyChanged(ParseDouble(e.Value), row))" />
                                        </CellEditTemplate>
                                    </DxGridDataColumn>

                                    <DxGridDataColumn FieldName="BillDetailAmount" Caption="Amount" ReadOnly="true"
                                                      Visible="@(layoutManager?.GetColumnVisibility("BillDetailAmount") ?? true)"
                                                      Width="@(layoutManager?.GetColumnWidth("BillDetailAmount") ?? "120px")">
                                        <EditSettings>
                                            <DxSpinEditSettings ShowSpinButtons="false" />
                                        </EditSettings>
                                    </DxGridDataColumn>

                                    <DxGridDataColumn FieldName="BillDetailTaxableAmt" ReadOnly="true" Caption="Taxable"
                                                      Visible="@(layoutManager?.GetColumnVisibility("BillDetailTaxableAmt") ?? true)"
                                                      Width="@(layoutManager?.GetColumnWidth("BillDetailTaxableAmt") ?? "120px")">
                                        <EditSettings>
                                            <DxSpinEditSettings ShowSpinButtons="false" />
                                        </EditSettings>
                                    </DxGridDataColumn>

                                    <DxGridDataColumn FieldName="BillDetailSlabId" ReadOnly="true" Caption="Tax Code"
                                                      Visible="@(layoutManager?.GetColumnVisibility("BillDetailSlabId") ?? true)"
                                                      Width="@(layoutManager?.GetColumnWidth("BillDetailSlabId") ?? "110px")" />

                                    <DxGridDataColumn FieldName="BillDetailIgstPer" ReadOnly="true" Caption="IGST %"
                                                      Visible="@(layoutManager?.GetColumnVisibility("BillDetailIgstPer") ?? true)"
                                                      Width="@(layoutManager?.GetColumnWidth("BillDetailIgstPer") ?? "90px")">
                                        <EditSettings>
                                            <DxSpinEditSettings ShowSpinButtons="false" />
                                        </EditSettings>
                                    </DxGridDataColumn>

                                    <DxGridDataColumn FieldName="BillDetailIgst" ReadOnly="true" Caption="IGST"
                                                      Visible="@(layoutManager?.GetColumnVisibility("BillDetailIgst") ?? true)"
                                                      Width="@(layoutManager?.GetColumnWidth("BillDetailIgst") ?? "100px")">
                                        <EditSettings>
                                            <DxSpinEditSettings ShowSpinButtons="false" />
                                        </EditSettings>
                                    </DxGridDataColumn>

                                    <DxGridDataColumn FieldName="BillDetailCgstPer" ReadOnly="true" Caption="CGST %"
                                                      Visible="@(layoutManager?.GetColumnVisibility("BillDetailCgstPer") ?? true)"
                                                      Width="@(layoutManager?.GetColumnWidth("BillDetailCgstPer") ?? "90px")">
                                        <EditSettings>
                                            <DxSpinEditSettings ShowSpinButtons="false" />
                                        </EditSettings>
                                    </DxGridDataColumn>

                                    <DxGridDataColumn FieldName="BillDetailCgst" ReadOnly="true" Caption="CGST"
                                                      Visible="@(layoutManager?.GetColumnVisibility("BillDetailCgst") ?? true)"
                                                      Width="@(layoutManager?.GetColumnWidth("BillDetailCgst") ?? "100px")">
                                        <EditSettings>
                                            <DxSpinEditSettings ShowSpinButtons="false" />
                                        </EditSettings>
                                    </DxGridDataColumn>

                                    <DxGridDataColumn FieldName="BillDetailSgstPer" ReadOnly="true" Caption="SGST %"
                                                      Visible="@(layoutManager?.GetColumnVisibility("BillDetailSgstPer") ?? true)"
                                                      Width="@(layoutManager?.GetColumnWidth("BillDetailSgstPer") ?? "90px")">
                                        <EditSettings>
                                            <DxSpinEditSettings ShowSpinButtons="false" />
                                        </EditSettings>
                                    </DxGridDataColumn>

                                    <DxGridDataColumn FieldName="BillDetailSgst" ReadOnly="true" Caption="SGST"
                                                      Visible="@(layoutManager?.GetColumnVisibility("BillDetailSgst") ?? true)"
                                                      Width="@(layoutManager?.GetColumnWidth("BillDetailSgst") ?? "100px")">
                                        <EditSettings>
                                            <DxSpinEditSettings ShowSpinButtons="false" />
                                        </EditSettings>
                                    </DxGridDataColumn>

                                    <DxGridDataColumn FieldName="BillDetailTotal" Caption="Total" ReadOnly="true"
                                                      Visible="@(layoutManager?.GetColumnVisibility("BillDetailTotal") ?? true)"
                                                      Width="@(layoutManager?.GetColumnWidth("BillDetailTotal") ?? "120px")">
                                        <EditSettings>
                                            <DxSpinEditSettings ShowSpinButtons="false" />
                                        </EditSettings>
                                    </DxGridDataColumn>
                                </Columns>

                                <TotalSummary>
                                    <DxGridSummaryItem FieldName="BillDetailTaxableAmt" SummaryType="GridSummaryItemType.Sum" DisplayText="Total: {0:N2}" />
                                    <DxGridSummaryItem FieldName="BillDetailAmount" SummaryType="GridSummaryItemType.Sum" DisplayText="Total: {0:N2}" />
                                    <DxGridSummaryItem FieldName="BillDetailIgst" SummaryType="GridSummaryItemType.Sum" />
                                    <DxGridSummaryItem FieldName="BillDetailCgst" SummaryType="GridSummaryItemType.Sum" />
                                    <DxGridSummaryItem FieldName="BillDetailSgst" SummaryType="GridSummaryItemType.Sum" />
                                    <DxGridSummaryItem FieldName="BillDetailTotal" SummaryType="GridSummaryItemType.Sum" DisplayText="Grand Total: {0:N2}" />
                                </TotalSummary>
                            </DxGrid>
                        </div>
                    </DxFormLayoutTabPage>
                   

                    <DxFormLayoutTabPage Caption="Customer Details">
                        <div class="popup-content-container">
                            <div class="form-scroll-section">
                                <DxFormLayout>
                                    <DxFormLayoutGroup Caption="Customer Information" ColSpanMd="6">
                                        <DxFormLayoutItem Caption="Customer Name" ColSpanMd="12">
                                            <DxComboBox TData="Account" TValue="int"
                                                        Data="@AccountList"
                                                        TextFieldName="AccountName"
                                                        ValueFieldName="AccountId"
                                                        ClearButtonVisible="true"
                                                        AllowUserInput="false"
                                                        NullText="-- Select Customer --"
                                                        Value="@EditModel.BillShipPartyId"
                                                        ValueChanged="@((int shippartyId) => ShipPartyDetails(shippartyId))"
                                                        ValueExpression="@(() => EditModel.BillShipPartyId)"
                                                        SearchMode="ListSearchMode.AutoSearch"
                                                        SearchFilterCondition="ListSearchFilterCondition.StartsWith"
                                                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                                        </DxFormLayoutItem>

                                        <DxFormLayoutItem Caption="Address" ColSpanMd="12">
                                            <DxMemo @bind-Text="EditModel.BillAddress1" />
                                        </DxFormLayoutItem>

                                        <DxFormLayoutItem Caption="Mobile No." ColSpanMd="6">
                                            <DxTextBox @bind-Text="EditModel.BillContactNo" />
                                        </DxFormLayoutItem>

                                        <DxFormLayoutItem Caption="GSTIN No." ColSpanMd="6">
                                            <DxTextBox @bind-Text="EditModel.BillGstNo" />
                                        </DxFormLayoutItem>

                                        <DxFormLayoutItem Caption="PIN" ColSpanMd="6">
                                            <DxTextBox @bind-Text="EditModel.BillPincode" />
                                        </DxFormLayoutItem>

                                        <DxFormLayoutItem Caption="City" ColSpanMd="6">
                                            <DxTextBox @bind-Text="EditModel.BillCity" />
                                        </DxFormLayoutItem>

                                        <DxFormLayoutItem Caption="State" ColSpanMd="12">
                                            <DxComboBox TData="State" TValue="int"
                                                        Data="@stateList"
                                                        TextFieldName="StateName"
                                                        ValueFieldName="StateId"
                                                        AllowUserInput="true"
                                                        NullText="-- Select State --"
                                                        @bind-Value="EditModel.BillStateId"
                                                        SearchMode="ListSearchMode.AutoSearch"
                                                        SearchFilterCondition="ListSearchFilterCondition.StartsWith"
                                                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                                        </DxFormLayoutItem>
                                    </DxFormLayoutGroup>

                                    @* <DxFormLayoutGroup Caption="Additional Information" ColSpanMd="6">
                                        <DxFormLayoutItem Caption="Reference No." ColSpanMd="12">
                                            <DxTextBox @bind-Text="EditModel.BillCust1" />
                                        </DxFormLayoutItem>

                                        <DxFormLayoutItem Caption="Subject" ColSpanMd="12">
                                            <DxTextBox @bind-Text="EditModel.BillCust2" />
                                        </DxFormLayoutItem>

                                        <DxFormLayoutItem Caption="Project Name" ColSpanMd="12">
                                            <DxTextBox @bind-Text="EditModel.BillCust3" />
                                        </DxFormLayoutItem>
                                    </DxFormLayoutGroup> *@
                                   @*  <DxFormLayoutItem Caption="Containers" ColSpanMd="6">
                                        <DxMemo @bind-Text="EditModel.BillContainerNo" Rows="3" />
                                    </DxFormLayoutItem> *@

