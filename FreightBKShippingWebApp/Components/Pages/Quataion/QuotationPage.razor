}
@if (showPurchasePopup)
{
    <FreightBKShippingWebApp.Components.Pages.PurchasePage.PurchaseAddEditPage @ref="purchasaddedit" ></FreightBKShippingWebApp.Components.Pages.PurchasePage.PurchaseAddEditPage>
}
<DxContextMenu @ref="voucherMenu" ItemClick="@OnMenuItemClick">
