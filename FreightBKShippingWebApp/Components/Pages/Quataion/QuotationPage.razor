            //     .Where(v => v.VoucherGroup == "QUOTATION")
            //     .Select(v => v.VoucherId)
            //     .ToList();

            // quotationList = (await BillService.GetAllAsync())
            //     .Where(q => q.BillYearId == YearStatechangeService.SelectedYearId 
            //              && quotationVoucherIds.Contains(q.BillVoucherId))
            //     .ToList();

            // ReportDataList = (await ReportDataService.GetAllAsync()).Where(r=>r.DocType="Quotation");

            // var voucherTask = await VoucherService.GetAllAsync(); 

            // VoucherList = voucherTask.Where(v =>
            //     !string.IsNullOrWhiteSpace(v.VoucherGroup) &&
            //     (
            //         v.VoucherGroup.Trim().Equals("SALES", StringComparison.OrdinalIgnoreCase) ||
            //         v.VoucherGroup.Trim().Equals("PURCHASE", StringComparison.OrdinalIgnoreCase)
            //     ))
            //     .ToList();
            LoadingService.Hide();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            ToastService.Error($"Error loading quotations: {ex.Message}");
