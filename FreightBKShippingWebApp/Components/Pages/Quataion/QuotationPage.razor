    private async Task OnEdit(ToolbarItemClickEventArgs e)
    {
        var quotation = MyGrid?.GetFocusedDataItem() as Bill;
        
        if (quotation == null)
        {
            ToastService.Warning("Please select a quotation to edit.");
            return;
        }
        var freshData = quotationList
                .FirstOrDefault(x => x.BillId == quotation.BillId);

        if (freshData != null)
        {
            
            pendingQuotationBill = freshData;
            showQuotationaddeditPopup = true;
            triggerQuotationPopup = true;

            await InvokeAsync(StateHasChanged);
            // if (popup != null)
            // {
            // popup.Show(freshData);
            // }
        }
        await ClearSelection();
    }

    private async Task OnDelete(ToolbarItemClickEventArgs e)
    {
        if (SelectedQuotations == null || SelectedQuotations.Count == 0)
        {
            ToastService.Warning("Please select at least one quotation to delete.");
            return;
        }

        var selectedList = SelectedQuotations.Cast<Bill>().ToList();
        
        var confirm = await ConfirmDialogService.ShowAsync(
            $"Are you sure you want to delete {selectedList.Count} selected quotation(s)?");

        if (!confirm)
        {
            await ClearSelection();
            return;
        }

        try
        {
            LoadingService.Show("Deleting...");
            int successCount = 0, failCount = 0;
            List<string> errorMessages = new();
            foreach (var quotation in selectedList)
            {
                var result = await BillService.DeleteAsync(quotation.BillId);
                if (result.Success) {
                    successCount++;
                    AuditLogService.NotifyAuditChanged();

                }
                else
                {
                    failCount++;
                    errorMessages.Add(result.Error);
                }
            }

            if (successCount > 0) 
                ToastService.Success($"{successCount} Quotation(s) Deleted Successfully.");
            if (failCount > 0)
                ToastService.Error($"{failCount} Quotation(s)  Failed To Delete.\nDetails: {string.Join("\n", errorMessages.Distinct())}");

            await LoadQuotationsAsync();
        }
        finally
        {
            LoadingService.Hide();
            await ClearSelection();
        }
    }

