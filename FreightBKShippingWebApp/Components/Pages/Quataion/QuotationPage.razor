<style>
    .grid-size {
        max-height: 570px;
    }
</style>

<DxGrid @ref="MyGrid"
        TItem="Bill"
        Data="@quotationList"
        KeyFieldName="BillId"
        ShowSearchBox="true"
        ShowFilterRow="true"
        PageSize="100"
        AllowSort="false"
        PageSizeSelectorVisible="false"
        ShowGroupPanel="true"
        FilterMenuButtonDisplayMode="GridFilterMenuButtonDisplayMode.Always"
        FocusedRowEnabled="true"
        SelectionMode="GridSelectionMode.Multiple"
        SelectedDataItems="@SelectedQuotations"
        SelectedDataItemsChanged="OnSelectedQuotationsChanged"
        ColumnResizeMode="GridColumnResizeMode.NextColumn"
        CssClass="grid-size"
        AllowSelectRowByClick="true">

    <ToolbarTemplate>
        <DxToolbar>
            <TitleTemplate Context="tl">
                <div class="d-flex align-items-center">
                    <i class="bi bi-file-earmark-text me-2 py-2"></i>
                    <span class="fs-5">Quotation</span>
                </div>
            </TitleTemplate>
            <Items>
                <DxToolbarItem Text="Add" IconCssClass="bi bi-plus-circle" Click="OnCreateNew" />
                <DxToolbarItem Text="Edit" IconCssClass="bi bi-pencil-square" Click="OnEdit" />
                <DxToolbarItem Text="Delete" IconCssClass="bi bi-trash" Click="OnDelete" />
                
                <DxToolbarItem Context="cfdr"
                              Text="Print"
                              RenderStyleMode="ToolbarItemRenderStyleMode.Contained"
                              RenderStyle="ButtonRenderStyle.Secondary"
                              IconCssClass="bi bi-printer">
                    <Items>
                        <DxToolbarItem Text="Print PDF" IconCssClass="bi bi-printer" Click="@(async () => await PrintReports(false))" />
                        <DxToolbarItem Text="Print Preview" IconCssClass="bi bi-printer" Click="@((_) => ShowReportPopup())"></DxToolbarItem>
                    </Items>
                </DxToolbarItem>
                
                <DxToolbarItem Text="Refresh" IconCssClass="bi bi-arrow-clockwise" Click="@(async (_) => await LoadQuotationsAsync())" />
                <DxToolbarItem Text="Clear Selection" IconCssClass="bi bi-x-circle" Click="@(async (_) => await ClearSelectionManual())" Visible="@(SelectedQuotations?.Count > 0)" />

                <DxToolbarItem Alignment="ToolbarItemAlignment.Right"
                               RenderStyle="ButtonRenderStyle.Secondary"
                               IconCssClass="bi bi-gear-wide-connected"
                               Click="ShowLayoutPopup" />

            </Items>
        </DxToolbar>
    </ToolbarTemplate>

    <Columns>
        <DxGridSelectionColumn Width="30" FixedPosition="GridColumnFixedPosition.Left" />

        <DxGridCommandColumn CancelButtonVisible="false" Name="Bill" Caption="Bill"
                            DeleteButtonVisible="false"
                            EditButtonVisible="false"
                            SaveButtonVisible="false"
                            NewButtonVisible="false" Width="80">
            <CellDisplayTemplate Context="cellContext">
                <div style="display: flex; align-items: center;">
                  

                    <DxButton RenderStyle="ButtonRenderStyle.Link"
                              IconCssClass="bi bi-three-dots"
                              SizeMode="SizeMode.Medium"
                              Click="@(e => ShowVoucherMenu(e, (Bill)cellContext.DataItem))" />
                </div>
            </CellDisplayTemplate>
        </DxGridCommandColumn>

        <DxGridDataColumn FieldName="BillId" Caption="ID" Width="@(layoutManager?.GetColumnWidth("BillId") ?? "80px")"
                         Visible="@(layoutManager?.GetColumnVisibility("BillId") ?? false)" />

        <DxGridDataColumn FieldName="branchname" Caption="Branch" Width="@(layoutManager?.GetColumnWidth("branchname") ?? "120px")"
                         Visible="@(layoutManager?.GetColumnVisibility("branchname") ?? true)" />

        <DxGridDataColumn FieldName="BillNo" Caption="Quotation No" Width="@(layoutManager?.GetColumnWidth("BillNo") ?? "150px")"
                         Visible="@(layoutManager?.GetColumnVisibility("BillNo") ?? true)" />

        <DxGridDataColumn FieldName="BillDate" Caption="Date" DisplayFormat="dd/MM/yyyy" Width="@(layoutManager?.GetColumnWidth("BillDate") ?? "110px")"
                         Visible="@(layoutManager?.GetColumnVisibility("BillDate") ?? true)" />

        <DxGridDataColumn FieldName="BillDueDate" DisplayFormat="dd/MM/yyyy" Caption="Valid Until" Width="@(layoutManager?.GetColumnWidth("BillDueDate") ?? "110px")"
                         Visible="@(layoutManager?.GetColumnVisibility("BillDueDate") ?? true)" />

        <DxGridDataColumn FieldName="partyname" Caption="Customer" Width="@(layoutManager?.GetColumnWidth("partyname") ?? "260px")"
                         Visible="@(layoutManager?.GetColumnVisibility("partyname") ?? true)" />

        <DxGridDataColumn FieldName="Vouchname" Caption="Voucher Type" Width="@(layoutManager?.GetColumnWidth("Vouchname") ?? "150px")"
                         Visible="@(layoutManager?.GetColumnVisibility("Vouchname") ?? true)" />

        <DxGridDataColumn FieldName="BillGstNo" Caption="GST No" Width="@(layoutManager?.GetColumnWidth("BillGstNo") ?? "130px")"
                         Visible="@(layoutManager?.GetColumnVisibility("BillGstNo") ?? true)" />

        <DxGridDataColumn FieldName="posname" Caption="Place of Supply" Width="@(layoutManager?.GetColumnWidth("posname") ?? "190px")"
                         Visible="@(layoutManager?.GetColumnVisibility("posname") ?? true)" />

        <DxGridDataColumn FieldName="BillTotal" Caption="Basic Amount" Width="@(layoutManager?.GetColumnWidth("BillTotal") ?? "150px")"
                         Visible="@(layoutManager?.GetColumnVisibility("BillTotal") ?? true)" />

        <DxGridDataColumn FieldName="BillNetAmount" Caption="Total Amount" Width="@(layoutManager?.GetColumnWidth("BillNetAmount") ?? "130px")"
                         Visible="@(layoutManager?.GetColumnVisibility("BillNetAmount") ?? true)" />

        <DxGridDataColumn FieldName="BillCreated" Caption="Created At" Width="@(layoutManager?.GetColumnWidth("BillCreated") ?? "140px")"
                         Visible="@(layoutManager?.GetColumnVisibility("BillCreated") ?? true)" />

        <DxGridDataColumn FieldName="BillStatus" Caption="Status" Width="@(layoutManager?.GetColumnWidth("BillStatus") ?? "140px")"
                         Visible="@(layoutManager?.GetColumnVisibility("BillStatus") ?? true)" />
    </Columns>
</DxGrid>

<DxPopup @bind-Visible="IsReportPopupVisible"
         ShowCloseButton="true"
         Width="400px"
         HeaderText="Select Report"
         CloseOnOutsideClick="true"
         CloseOnEscape="true">
    <div class="p-3">
        <DxFormLayout>
            <DxFormLayoutItem Caption="Report" ColSpanMd="12">
                <DxComboBox Data="@ReportDataList"
                           TextFieldName="FormatName"
                           ValueFieldName="ReportDataId"
                           AllowUserInput="true"
                           NullText="-- Select Report --"
                           @bind-Value="SelectedReportId"
                           SearchMode="ListSearchMode.AutoSearch"
                           SearchFilterCondition="ListSearchFilterCondition.StartsWith"
                           ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
            </DxFormLayoutItem>
        </DxFormLayout>
        <div class="mt-3 d-flex justify-content-end gap-2">
            <DxButton Text="OK" RenderStyle="ButtonRenderStyle.Primary" IconCssClass="bi bi-box-arrow-right" Click="@ConfirmReportSelection" />
            <DxButton Text="Cancel" RenderStyle="ButtonRenderStyle.Danger" IconCssClass="bi bi-x-circle" Click="@(() => IsReportPopupVisible = false)" />
        </div>
    </div>
</DxPopup>
@if (showQuotationaddeditPopup)
{
<QuotationAddEditPage @ref="popup" OnSaved="LoadQuotationsAsync" />
}
@if (showGridlayoutPopup)
{
    <GridLayoutpPopup @ref="layoutManager" VoucherType="Quotation" Columns="@allColumns" OnLayoutChanged="HandleLayoutChanged" />
}
<ConfirmationDialog />

<script>
    window.downloadFileFromStream = async (fileName, contentStreamReference) => {
        const arrayBuffer = await contentStreamReference.arrayBuffer();
        const blob = new Blob([arrayBuffer]);
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = fileName;
        a.click();
        URL.revokeObjectURL(url);
    };
</script>

@if (showBillPopup)
