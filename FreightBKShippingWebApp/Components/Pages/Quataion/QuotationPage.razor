                VoucherList = Voucher.Result;
                // 👉 Only for context menu
                ActionVouchers = (Voucher.Result)
                    .Where(v =>
                        v.VoucherGroup.Equals("SALES", StringComparison.OrdinalIgnoreCase) ||
                        v.VoucherGroup.Equals("PURCHASE", StringComparison.OrdinalIgnoreCase))
                    .ToList();
            }

            


            
            var allBills = await BillService.GetAllAsync();

            var quotationVoucherIds = VoucherList
                .Where(v => v.VoucherGroup.Equals("QUOTATION", StringComparison.OrdinalIgnoreCase))
                .Select(v => v.VoucherId)
                .ToHashSet();

            quotationList = allBills
                .Where(q => q.BillYearId == YearStatechangeService.SelectedYearId
                         && quotationVoucherIds.Contains(q.BillVoucherId))
                .ToList();


            // // Get quotation voucher types
