@using FreightBKShippingWebApp.Model
@using FreightBKShippingWebApp.Models
@using FreightBKShippingWebApp.Services
@using Microsoft.AspNetCore.Components.Authorization
@using System.Text.Json
@inject AuthenticationStateProvider AuthStateProvider
@inject CompanyService CompanyService
@inject ToasteService ToastService
@inject LoadingService LoadingService
@inject StateService StateService
@inject CountryService CountryService
@inject AuditLogService AuditLogService
@inject IJSRuntime JSRuntime

<DxPopup @bind-Visible="Visible"
         ShowCloseButton="true"
         HeaderText="@Title"
         MaxWidth="700"
         CloseOnOutsideClick="false"
         HorizontalAlignment="HorizontalAlignment.Center"
         VerticalAlignment="VerticalAlignment.Center"
         BodyCssClass="my-popup-body"
         ShowFooter="true"
         Scrollable="true">

    <BodyContentTemplate Context="bdycomp">
        <EditForm EditContext="@editContext" OnValidSubmit="HandleValidSubmit" Context="ctxeditform" id="companyForm">
            <DataAnnotationsValidator />

            <DxFormLayout>

                <!-- BASIC INFO -->
                <DxFormLayoutGroup Caption="Basic Information">

                    <DxFormLayoutItem Caption="Company Name" ColSpanMd="12">
                        <DxTextBox @bind-Text="EditModel.Name"
                                   @oninput="AutoFillPrintName"
                                   ShowValidationIcon="true"
                                   ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="Print Name" ColSpanMd="12">
                        <DxTextBox @bind-Text="EditModel.PrintName"
                                   ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="Address" ColSpanMd="12">
                        <DxMemo @bind-Text="EditModel.Address1"
                                Rows="2"
                                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="City">
                        <DxTextBox @bind-Text="EditModel.City"
                                   ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="Pincode">
                        <DxTextBox @bind-Text="EditModel.Pincode"
                                   ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="State">
                        <DxComboBox TData="State"
                                    TValue="int"
                                    Data="@stateList"
                                    TextFieldName="StateName"
                                    ValueFieldName="StateId"
                                    NullText="-- Select State --"
                                    @bind-Value="EditModel.StateId"
                                    SearchMode="ListSearchMode.AutoSearch"
                                    SearchFilterCondition="ListSearchFilterCondition.Contains" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="Country">
                        <DxComboBox TData="Country"
                                    TValue="String"
                                    Data="@CountryList"
                                    TextFieldName="CountryName"
                                    ValueFieldName="CountryName"
                                    NullText="-- Select Country --"
                                    @bind-Value="EditModel.Country"
                                    SearchMode="ListSearchMode.AutoSearch"
                                    SearchFilterCondition="ListSearchFilterCondition.Contains" />
                    </DxFormLayoutItem>

                </DxFormLayoutGroup>

                <!-- CONTACT INFO -->
                <DxFormLayoutGroup Caption="Contact Information">

                    <DxFormLayoutItem Caption="Email">
                        <DxTextBox @bind-Text="EditModel.Email"
                                   ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="Mobile">
                        <DxTextBox @bind-Text="EditModel.Mobile"
                                   ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="Telephone">
                        <DxTextBox @bind-Text="EditModel.Telephone"
                                   ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="Fax">
                        <DxTextBox @bind-Text="EditModel.Fax"
                                   ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="Website">
                        <DxTextBox @bind-Text="EditModel.Website"
                                   ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="Contact Person">
                        <DxTextBox @bind-Text="EditModel.ContactPerson"
                                   ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                    </DxFormLayoutItem>

                </DxFormLayoutGroup>

                <!-- GST INFO -->
                <DxFormLayoutGroup Caption="Tax Information">

                    <DxFormLayoutItem Caption="GST Applicable">
                        <DxCheckBox @bind-Checked="EditModel.IsGstApplicable" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="GSTIN">
                        <DxTextBox @bind-Text="EditModel.Gstin"
                                   ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="PAN">
                        <DxTextBox @bind-Text="EditModel.Panno"
                                   ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                    </DxFormLayoutItem>

                </DxFormLayoutGroup>

                <!-- OTHER DETAILS -->
                <DxFormLayoutGroup Caption="Additional Details">

                    <DxFormLayoutItem Caption="Currency Symbol">
                        <DxTextBox @bind-Text="EditModel.CurrencySymbol" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="Tagline 1">
                        <DxTextBox @bind-Text="EditModel.Tagline1" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="Tagline 2">
                        <DxTextBox @bind-Text="EditModel.Tagline2" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="MSME No">
                        <DxTextBox @bind-Text="EditModel.MsmeNo" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="FSS Expiry">
                        <DxDateEdit ReadOnly @bind-Date="EditModel.FssExpiry" DisplayFormat="dd/MM/yyyy" />
                    </DxFormLayoutItem>

                

                </DxFormLayoutGroup>

                <!-- SUPER ADMIN SECTION -->
                @if (IsSuperAdmin)
                {
                    <DxFormLayoutGroup Caption="Admin Controls">

                        <DxFormLayoutItem Caption="Is Online">
                            <DxCheckBox @bind-Checked="EditModel.IsOnline" />
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="In Online">
                            <DxCheckBox @bind-Checked="EditModel.InOnline" />
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="Multi Branch">
                            <DxCheckBox @bind-Checked="EditModel.IsMultiBranch" />
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="Remarks" ColSpanMd="12">
                            <DxMemo @bind-Text="EditModel.Remarks"
                                    Rows="2" />
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Extend Days">
                            <DxSpinEdit @bind-Value="EditModel.ExtendDays"
                                        MinValue="0" />
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Max User">
                            <DxSpinEdit @bind-Value="EditModel.MaxUser"
                                        MinValue="0" />
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="Whatsapp Enable">
                            <DxCheckBox @bind-Checked="EditModel.HasWhatsapp" />
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="Active">
                            <DxCheckBox @bind-Checked="EditModel.Status" />
                        </DxFormLayoutItem>
                    </DxFormLayoutGroup>
                }

            </DxFormLayout>

        </EditForm>
    </BodyContentTemplate>

    <FooterContentTemplate Context="ftrcomp">
        <div class="mt-3 text-end">
            <DxButton Text="Save" RenderStyle="ButtonRenderStyle.Primary" Click="SubmitForm" />
            <DxButton Text="Cancel" RenderStyle="ButtonRenderStyle.Secondary" Click="Hide" />
        </div>
    </FooterContentTemplate>
</DxPopup>

@code {
    private EditContext? editContext;

    [Parameter] public EventCallback OnSaved { get; set; }

    private bool Visible { get; set; }
    private string Title { get; set; } = "Add/Edit Company";
    private Company EditModel { get; set; } = new();
    private List<State> stateList = new();
    private List<Country> CountryList = new();
    private bool IsSuperAdmin = false;

    private void AutoFillPrintName(ChangeEventArgs e)
    {
        EditModel.Name = e.Value?.ToString() ?? "";
        EditModel.PrintName = EditModel.Name;

        if (editContext != null)
        {
            editContext.NotifyFieldChanged(editContext.Field(nameof(EditModel.Name)));
        }
    }

    private async Task SubmitForm()
    {
        await JSRuntime.InvokeVoidAsync("eval", "document.getElementById('companyForm').requestSubmit()");
    }

    public void Show(Company company)
    {
        if (company != null && company.CompanyId > 0)
        {
           // EditModel = company;
            var json = JsonSerializer.Serialize(company);
            EditModel = JsonSerializer.Deserialize<Company>(json) ?? new Company();
            Title = "Edit Company";
        }
        else
        {
            EditModel = new Company { Status = true, IsGstApplicable = true };
            Title = "Add Company";
        }

        editContext = new EditContext(EditModel);
        Visible = true;
    }

    private void Hide()
    {
        Visible = false;
    }
    protected override async Task OnInitializedAsync()
    {
        stateList = await StateService.GetStatesAsync();
        CountryList = await CountryService.GetAllAsync();

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        IsSuperAdmin = user.IsInRole("SuperAdmin");
    }

    private async Task HandleValidSubmit()
    {
        LoadingService.Show();
        try
        {
            int? resultId;

            if (EditModel.CompanyId == null || EditModel.CompanyId == 0)
            {
                resultId = await CompanyService.CreateAsync(EditModel);

                if (resultId == null)
                {
                    ToastService.Error("Company failed to create!");
                    return;
                }

                EditModel.CompanyId = resultId;
                AuditLogService.NotifyAuditChanged();
                ToastService.Success("Company created successfully!");
            }
            else
            {
                if (IsSuperAdmin)
                {
                    resultId = await CompanyService.UpdateByAdminAsync(EditModel);
                }
                else
                {
                    resultId = await CompanyService.UpdateAsync(EditModel);
                }

                if (resultId == null)
                {
                    ToastService.Error("Company failed to update!");
                    return;
                }
                AuditLogService.NotifyAuditChanged();
                ToastService.Success("Company updated successfully!");
            }


            Visible = false;
            await OnSaved.InvokeAsync();
        }
        catch (Exception ex)
        {
            ToastService.Error($"Error saving company: {ex.Message}");
        }
        finally
        {
            LoadingService.Hide();
        }
    }

}