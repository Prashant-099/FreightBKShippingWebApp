@using FreightBKShippingWebApp.Model
@using FreightBKShippingWebApp.Models
@using FreightBKShippingWebApp.Services
@using Microsoft.AspNetCore.Components.Authorization
@using System.Text.Json
@inject AuthenticationStateProvider AuthStateProvider
@inject CompanyService CompanyService
@inject ToasteService ToastService
@inject LoadingService LoadingService
@inject StateService StateService
@inject CountryService CountryService
@inject AuditLogService AuditLogService
@inject IJSRuntime JSRuntime
<style>
   .company-header-section {
    display: flex;
    gap: 24px;
    align-items: flex-start;
    width: 100%;
}

.company-fields {
    flex: 1;
    min-width: 0;
}

.company-logo {
    width: 220px;
    text-align: center;
}

.logo-preview {
    width: 200px;
    height: 90px;
    border: 1px solid #d9d9d9;
    border-radius: 8px;
    background: #fafafa;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    margin-bottom: 10px;
}

.logo-preview img {
    width: 100%;
    height: 100%;
    object-fit: contain;
}

.logo-actions {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

@@media (max-width: 768px) {
    .company-header-section {
        flex-direction: column;
    }

    .company-logo {
        width: 100%;
    }

    .logo-preview {
        width: 100%;
        max-width: 220px;
        margin: auto;
    }
}
</style>
<DxPopup @bind-Visible="Visible"
         ShowCloseButton="true"
         HeaderText="@Title"
         MaxWidth="700"
         CloseOnOutsideClick="false"
         HorizontalAlignment="HorizontalAlignment.Center"
         VerticalAlignment="VerticalAlignment.Center"
         BodyCssClass="my-popup-body"
         ShowFooter="true"
         Scrollable="true">

    <BodyContentTemplate Context="bdycomp">
        <EditForm EditContext="@editContext" OnValidSubmit="HandleValidSubmit" Context="ctxeditform" id="companyForm">
            <DataAnnotationsValidator />

            <DxFormLayout>

                <!-- BASIC INFO -->
                <DxFormLayoutGroup Caption="Basic Information">

                    <!-- LEFT COLUMN -->
                    <DxFormLayoutItem ColSpanMd="12" Caption="">
                        <div class="company-header-section">

                            <!-- Left Side -->
                            <div class="company-fields">

                                <div class="mb-3">
                                    <label class="form-label">Company Name</label>
                                    <DxTextBox @bind-Text="EditModel.Name"
                                               @oninput="AutoFillPrintName"
                                               ShowValidationIcon="true" />
                                </div>

                                <div>
                                    <label class="form-label">Print Name</label>
                                    <DxTextBox @bind-Text="EditModel.PrintName" />
                                </div>

                            </div>

                            <!-- Right Side -->
                            <div class="company-logo">

                                @* <label class="form-label">Company Logo</label> *@

                                <div class="logo-preview">
                                    @if (EditModel.Logo != null)
                                    {
                                        <img src="@GetLogoPreview()" />
                                    }
                                    else
                                    {
                                        <span>No image data</span>
                                    }
                                </div>

                                <div class="logo-actions">
                                    <InputFile OnChange="UploadLogo"
                                               accept=".png,.jpg,.jpeg,.webp" />

                                    <DxButton Text="Remove"
                                              RenderStyle="ButtonRenderStyle.Danger"
                                              Click="RemoveLogo" />
                                </div>

                            </div>

                        </div>
                    </DxFormLayoutItem>


                    <DxFormLayoutItem Caption="Address" ColSpanMd="12">
                        <DxMemo @bind-Text="EditModel.Address1"
                                Rows="2"
                                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="City">
                        <DxTextBox @bind-Text="EditModel.City"
                                   ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="Pincode">
                        <DxTextBox @bind-Text="EditModel.Pincode"
                                   ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="State">
                        <DxComboBox TData="State"
                                    TValue="int"
                                    Data="@stateList"
                                    TextFieldName="StateName"
                                    ValueFieldName="StateId"
                                    NullText="-- Select State --"
                                    @bind-Value="EditModel.StateId"
                                    SearchMode="ListSearchMode.AutoSearch"
                                    SearchFilterCondition="ListSearchFilterCondition.Contains" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="Country">
                        <DxComboBox TData="Country"
                                    TValue="String"
                                    Data="@CountryList"
                                    TextFieldName="CountryName"
                                    ValueFieldName="CountryName"
                                    NullText="-- Select Country --"
                                    @bind-Value="EditModel.Country"
                                    SearchMode="ListSearchMode.AutoSearch"
                                    SearchFilterCondition="ListSearchFilterCondition.Contains" />
                    </DxFormLayoutItem>
                </DxFormLayoutGroup>

               

                <!-- CONTACT INFO -->
                <DxFormLayoutGroup Caption="Contact Information">

                    <DxFormLayoutItem Caption="Email">
                        <DxTextBox @bind-Text="EditModel.Email"
                                   ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="Mobile">
                        <DxTextBox @bind-Text="EditModel.Mobile"
                                   ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="Telephone">
                        <DxTextBox @bind-Text="EditModel.Telephone"
                                   ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="Fax">
                        <DxTextBox @bind-Text="EditModel.Fax"
                                   ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="Website">
                        <DxTextBox @bind-Text="EditModel.Website"
                                   ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="Contact Person">
                        <DxTextBox @bind-Text="EditModel.ContactPerson"
                                   ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                    </DxFormLayoutItem>

                </DxFormLayoutGroup>

                <!-- GST INFO -->
                <DxFormLayoutGroup Caption="Tax Information">

                    <DxFormLayoutItem Caption="GST Applicable">
                        <DxCheckBox @bind-Checked="EditModel.IsGstApplicable" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="GSTIN">
                        <DxTextBox @bind-Text="EditModel.Gstin"
                                   ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="PAN">
                        <DxTextBox @bind-Text="EditModel.Panno"
                                   ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                    </DxFormLayoutItem>

                </DxFormLayoutGroup>

                <!-- OTHER DETAILS -->
                <DxFormLayoutGroup Caption="Additional Details">

                    <DxFormLayoutItem Caption="Currency Symbol">
                        <DxTextBox @bind-Text="EditModel.CurrencySymbol" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="Tagline 1">
                        <DxTextBox @bind-Text="EditModel.Tagline1" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="Tagline 2">
                        <DxTextBox @bind-Text="EditModel.Tagline2" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="MSME No">
                        <DxTextBox @bind-Text="EditModel.MsmeNo" />
                    </DxFormLayoutItem>

                    <DxFormLayoutItem Caption="FSS Expiry">
                        <DxDateEdit ReadOnly @bind-Date="EditModel.FssExpiry" DisplayFormat="dd/MM/yyyy" />
                    </DxFormLayoutItem>

                

                </DxFormLayoutGroup>

                <!-- SUPER ADMIN SECTION -->
                @if (IsSuperAdmin)
                {
                    <DxFormLayoutGroup Caption="Admin Controls">

                        <DxFormLayoutItem Caption="Is Online">
                            <DxCheckBox @bind-Checked="EditModel.IsOnline" />
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="In Online">
                            <DxCheckBox @bind-Checked="EditModel.InOnline" />
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="Multi Branch">
                            <DxCheckBox @bind-Checked="EditModel.IsMultiBranch" />
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="Remarks" ColSpanMd="12">
                            <DxMemo @bind-Text="EditModel.Remarks"
                                    Rows="2" />
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Extend Days">
                            <DxSpinEdit @bind-Value="EditModel.ExtendDays"
                                        MinValue="0" />
                        </DxFormLayoutItem>
                        <DxFormLayoutItem Caption="Max User">
                            <DxSpinEdit @bind-Value="EditModel.MaxUser"
                                        MinValue="0" />
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="Whatsapp Enable">
                            <DxCheckBox @bind-Checked="EditModel.HasWhatsapp" />
                        </DxFormLayoutItem>

                        <DxFormLayoutItem Caption="Active">
                            <DxCheckBox @bind-Checked="EditModel.Status" />
                        </DxFormLayoutItem>
                    </DxFormLayoutGroup>
                }

            </DxFormLayout>

        </EditForm>
    </BodyContentTemplate>

    <FooterContentTemplate Context="ftrcomp">
        <div class="mt-3 text-end">
            <DxButton Text="Save" RenderStyle="ButtonRenderStyle.Primary" Click="SubmitForm" />
            <DxButton Text="Cancel" RenderStyle="ButtonRenderStyle.Secondary" Click="Hide" />
        </div>
    </FooterContentTemplate>
</DxPopup>

@code {
    private EditContext? editContext;

    [Parameter] public EventCallback OnSaved { get; set; }

    private bool Visible { get; set; }
    private string Title { get; set; } = "Add/Edit Company";
    private Company EditModel { get; set; } = new();
    private List<State> stateList = new();
    private List<Country> CountryList = new();
    private bool IsSuperAdmin = false;

    private void AutoFillPrintName(ChangeEventArgs e)
    {
        EditModel.Name = e.Value?.ToString() ?? "";
        EditModel.PrintName = EditModel.Name;

        if (editContext != null)
        {
            editContext.NotifyFieldChanged(editContext.Field(nameof(EditModel.Name)));
        }
    }

    private async Task SubmitForm()
    {
        await JSRuntime.InvokeVoidAsync("eval", "document.getElementById('companyForm').requestSubmit()");
    }

    public void Show(Company company)
    {
        if (company != null && company.CompanyId > 0)
        {
           // EditModel = company;
            var json = JsonSerializer.Serialize(company);
            EditModel = JsonSerializer.Deserialize<Company>(json) ?? new Company();
            Title = "Edit Company";
        }
        else
        {
            EditModel = new Company { Status = true, IsGstApplicable = true };
            Title = "Add Company";
        }

        editContext = new EditContext(EditModel);
        Visible = true;
    }

    private void Hide()
    {
        Visible = false;
    }
    protected override async Task OnInitializedAsync()
    {
        stateList = await StateService.GetStatesAsync();
        CountryList = await CountryService.GetAllAsync();

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        IsSuperAdmin = user.IsInRole("SuperAdmin");
    }

    private async Task HandleValidSubmit()
    {
        LoadingService.Show();
        try
        {
            if (EditModel.Logo is { Length: > 0 } logo && logo.Length > MaxLogoBytes)
    {
        ToastService.Error(
            $"❌ Logo ({logo.Length / 1024} KB) exceeds the {MaxLogoBytes / 1024} KB limit. Please re-upload.");
        return;
    }

            // int? resultId;
            if (EditModel.CompanyId == null || EditModel.CompanyId == 0)
            {
                var result = await CompanyService.CreateAsync(EditModel);

                if (!result.Success)
                {
                    ToastService.Error(result.Error ?? "Company failed to create!");
                    return;
                }

                EditModel.CompanyId = result.CompanyId; 
                AuditLogService.NotifyAuditChanged();
                ToastService.Success("Company created successfully!");
            }
            else
            {
                if (IsSuperAdmin)
                {
                  var  result = await CompanyService.UpdateByAdminAsync(EditModel);
                    if (!result.Success)
                    {
                        ToastService.Error("Company failed to update!");
                        return;
                    }
                }
                else
                {
                  var  result = await CompanyService.UpdateAsync(EditModel);
                    if (!result.Success)
                    {
                        ToastService.Error("Company failed to update!");
                        return;
                    }
                }
                
                
                AuditLogService.NotifyAuditChanged();
                ToastService.Success("Company updated successfully!");
            }


            Visible = false;
            await OnSaved.InvokeAsync();
        }
        catch (Exception ex)
        {
            ToastService.Error($"Error saving company: {ex.Message}");
        }
        finally
        {
            LoadingService.Hide();
        }
    }
    // ── Limits (must match DB column capacity) ──────────────────────────────────
    private const long MaxLogoBytes = 500 * 1024;   // 500 KB — safe for MEDIUMBLOB
    private const int MaxWidthPixels = 1000;          // px — optional JS check
    private const int MaxHeightPixels = 500;           // px — optional JS check

    private static readonly HashSet<string> AllowedExtensions =
        new(StringComparer.OrdinalIgnoreCase) { ".jpg", ".jpeg", ".png" };

    private static readonly HashSet<string> AllowedMimeTypes =
        new(StringComparer.OrdinalIgnoreCase) { "image/jpeg", "image/jpg", "image/png" };

    // ── Upload with full validation ─────────────────────────────────────────────
    private async Task UploadLogo(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null)
        {
            ToastService.Warning("No file selected.");
            return;
        }

        // ── 1. Extension check ──────────────────────────────────────────────────
        var ext = Path.GetExtension(file.Name);
        if (!AllowedExtensions.Contains(ext))
        {
            ToastService.Error($"❌ '{ext}' is not allowed. Please upload JPG or PNG only.");
            return;
        }

        // ── 2. MIME type check ──────────────────────────────────────────────────
        if (!AllowedMimeTypes.Contains(file.ContentType))
        {
            ToastService.Error($"❌ Invalid file type '{file.ContentType}'. Only JPG/PNG accepted.");
            return;
        }

        // ── 3. File size check (BEFORE reading stream) ──────────────────────────
        if (file.Size > MaxLogoBytes)
        {
            var actualKb = file.Size / 1024.0;
            var limitKb = MaxLogoBytes / 1024.0;
            ToastService.Error(
                $"❌ Logo is too large ({actualKb:F0} KB). Maximum allowed size is {limitKb:F0} KB.");
            return;
        }

        if (file.Size == 0)
        {
            ToastService.Error("❌ Selected file is empty.");
            return;
        }

        // ── 4. Read stream ──────────────────────────────────────────────────────
        byte[] bytes;
        try
        {
            using var ms = new MemoryStream();
            await file.OpenReadStream(MaxLogoBytes).CopyToAsync(ms);
            bytes = ms.ToArray();
        }
        catch (Exception ex)
        {
            ToastService.Error($"❌ Failed to read file: {ex.Message}");
            return;
        }

        // ── 5. Magic byte check (rejects renamed .exe → .png tricks) ───────────
        if (!IsValidImageBytes(bytes))
        {
            ToastService.Error("❌ File content is not a valid JPG or PNG image.");
            return;
        }

        // ── 6. Final size guard against DB column limit ─────────────────────────
        //    MEDIUMBLOB = 16,777,215 bytes. Belt-and-suspenders check.
        if (bytes.Length > MaxLogoBytes)
        {
            ToastService.Error(
                $"❌ Processed image ({bytes.Length / 1024} KB) exceeds the {MaxLogoBytes / 1024} KB limit.");
            return;
        }

        // ── All validations passed ──────────────────────────────────────────────
        EditModel.Logo = bytes;
        ToastService.Success($"✅ Logo uploaded ({bytes.Length / 1024} KB).");
        StateHasChanged();
    }

    // ── Remove ──────────────────────────────────────────────────────────────────
    private void RemoveLogo()
    {
        EditModel.Logo = null;
        ToastService.Info("Logo removed.");
        StateHasChanged();
    }

    // ── Preview ─────────────────────────────────────────────────────────────────
    private string GetLogoPreview()
    {
        if (EditModel.Logo is not { Length: > 4 }) return string.Empty;
        var mime = DetectMimeType(EditModel.Logo);
        return $"data:{mime};base64,{Convert.ToBase64String(EditModel.Logo)}";
    }

    // ── Helpers ─────────────────────────────────────────────────────────────────
    private static bool IsValidImageBytes(byte[] b)
    {
        if (b.Length < 4) return false;
        bool isJpeg = b[0] == 0xFF && b[1] == 0xD8 && b[2] == 0xFF;
        bool isPng = b[0] == 0x89 && b[1] == 0x50 && b[2] == 0x4E && b[3] == 0x47;
        return isJpeg || isPng;
    }

    private static string DetectMimeType(byte[] b)
    {
        if (b[0] == 0xFF && b[1] == 0xD8) return "image/jpeg";
        if (b[0] == 0x89 && b[1] == 0x50) return "image/png";
        return "image/png";
    }
}