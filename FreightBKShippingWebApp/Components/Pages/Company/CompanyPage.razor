</DxGrid>
</div>
@if (showLayoutDialog)
{
    <div class="modal fade show d-block"
         style="background-color: rgba(0, 0, 0, 0.5); z-index: 1050;"
         @onclick="@(() => { })">

        <div class="modal-dialog modal-lg" @onclick:stopPropagation="true">
            <div class="modal-content">

                <!-- Header -->
                <div class="modal-header">
                    <h5 class="modal-title">@dialogTitle</h5>
                    <button type="button"
                            class="btn-close"
                            @onclick="CloseLayoutDialog"
                            aria-label="Close">
                    </button>
                </div>

                <!-- Body -->
                <div class="modal-body">

                    <!-- Layout Name -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">Layout Name:</label>
                        <input type="text"
                               class="form-control"
                               @bind="newLayoutName"
                               @bind:event="oninput"
                               placeholder="Enter layout name..."
                               maxlength="100" />
                    </div>

                    <!-- Default Layout Checkbox -->
                    <div class="mb-3">
                        <div class="form-check">
                            <input class="form-check-input"
                                   type="checkbox"
                                   @bind="isDefaultLayout"
                                   id="defaultLayoutCheck" />

                            <label class="form-check-label" for="defaultLayoutCheck">
                                Set as Default Layout
                            </label>
                        </div>
                    </div>

                    <!-- Column Configuration -->
                    <div class="mt-3">
                        <label class="form-label fw-bold mb-2">Column Configuration:</label>

                        <div class="table-responsive"
                             style="max-height: 400px; overflow-y: auto;">

                            <table class="table table-sm table-bordered">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th style="width: 50px;">Visible</th>
                                        <th style="width: 200px;">Column Name</th>
                                        <th style="width: 150px;">Width (px)</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var col in allColumns)
                                    {
                                        <tr>
                                            <td class="text-center">
                                                <input class="form-check-input"
                                                       type="checkbox"
                                                       @bind="col.Visible"
                                                       id="col_@col.FieldName" />
                                            </td>

                                            <td>
                                                <label class="mb-0" for="col_@col.FieldName">
                                                    @col.Caption
                                                </label>
                                            </td>

                                            <td>
                                                <input type="number"
                                                       class="form-control form-control-sm"
                                                       @bind="col.Width"
                                                       @bind:event="oninput"
                                                       min="50"
                                                       max="500"
                                                       step="10"
                                                       placeholder="Width" />
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>

                        </div>
                    </div>

                    <!-- Info Note -->
                    <div class="alert alert-info mt-3">
                        <i class="bi bi-info-circle me-2"></i>
                        <strong>Note:</strong>
                        Adjust column widths here manually. The widths will be saved and applied when you load this layout.
                    </div>

                </div>

                <!-- Footer -->
                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            @onclick="CloseLayoutDialog">
                        Cancel
                    </button>

                    <button type="button"
                            class="btn btn-primary"
                            @onclick="SaveCurrentLayout">
                        <i class="bi bi-floppy me-1"></i>
                        @(isEditMode ? "Update" : "Create") Layout
                    </button>
                </div>

            </div>
        </div>

    </div>
}

<ConfigAddEditPage @ref="popup" OnSaved="LoadCompaniesAsync" />
<ConfirmationDialog />
@* </ConfigAuthorize> *@
@code {
    private ConfigAddEditPage popup;
    EinvConfig ConfigModel = new();
  
    private void config(ToolbarItemClickEventArgs e) 
{
        popup.Show(ConfigModel);
}

    void OnColumnChooserClick()
    {
        CompanyGrid.ShowColumnChooser(".column-chooser-button");
    }
    //===================================================
    DxGrid CompanyGrid;
    List<Company> companyList = [];
    List<Company> SelectedCompanies = new();
    private List<State> stateList = new();
    private List<Country> CountryList = new();
    bool isSaving = false;
    // Grid Layout Management Variables
    private List<GridLayoutDto> availableLayouts = [];
    private int? selectedLayoutId;
    private bool showLayoutDialog = false;
    private string newLayoutName = "";
    private string dialogTitle = "";
    private bool isEditMode = false;
    private bool isDefaultLayout = false;
    private const string VOUCHER_TYPE = "Company";

    // All possible columns
    private List<GridColumnLayout> allColumns = [];
    private List<GridColumnLayout> currentLayout = [];
    protected override async Task OnInitializedAsync() 
    {
        await LoadCompaniesAsync();
        InitializeColumns();
        await LoadAvailableLayouts();
        await LoadDefaultLayout();
    }

    private void InitializeColumns()
    {
        allColumns = new List<GridColumnLayout>
        {
           new() { FieldName = "CompanyId", Caption = "ID", Visible = false, Width = 80, DisplayIndex = 0 },

new() { FieldName = "Name", Caption = "Name", Visible = true, Width = 300, DisplayIndex = 1 },
new() { FieldName = "Code", Caption = "Code", Visible = false, Width = 120, DisplayIndex = 2 },
new() { FieldName = "PrintName", Caption = "Print Name", Visible = false, Width = 150, DisplayIndex = 3 },

new() { FieldName = "Address1", Caption = "Address", Visible = true, Width = 250, DisplayIndex = 4 },
new() { FieldName = "City", Caption = "City", Visible = true, Width = 150, DisplayIndex = 5 },

new() { FieldName = "StateId", Caption = "State ID", Visible = false, Width = 120, DisplayIndex = 6 },
new() { FieldName = "Country", Caption = "Country", Visible = false, Width = 120, DisplayIndex = 7 },

new() { FieldName = "Email", Caption = "Email", Visible = true, Width = 200, DisplayIndex = 8 },
new() { FieldName = "Mobile", Caption = "Mobile", Visible = false, Width = 150, DisplayIndex = 9 },
new() { FieldName = "Website", Caption = "Website", Visible = false, Width = 150, DisplayIndex = 10 },

new() { FieldName = "Gstin", Caption = "GSTIN", Visible = true, Width = 180, DisplayIndex = 11 },
new() { FieldName = "Panno", Caption = "PAN No.", Visible = false, Width = 150, DisplayIndex = 12 },

new() { FieldName = "IsGstApplicable", Caption = "GST Applicable", Visible = false, Width = 150, DisplayIndex = 13 },
new() { FieldName = "Status", Caption = "Status", Visible = false, Width = 120, DisplayIndex = 14 }
  };
        currentLayout = allColumns.Select(c => new GridColumnLayout
        {
            FieldName = c.FieldName,
            Caption = c.Caption,
            Visible = c.Visible,
            Width = c.Width,
            DisplayIndex = c.DisplayIndex
        }).ToList();
    }

    private int ParseWidth(string width)
    {
        if (string.IsNullOrEmpty(width))
            return 100;

        width = width.Replace("px", "").Trim();

        if (int.TryParse(width, out int result))
            return result;

        return 100;
    }

    private string GetColumnWidth(string fieldName)
    {
        if (currentLayout == null || !currentLayout.Any())
        {
            var defaultCol = allColumns.FirstOrDefault(x => x.FieldName == fieldName);
            return $"{defaultCol?.Width ?? 100}px";
        }

        var col = currentLayout.FirstOrDefault(x => x.FieldName == fieldName);
        return $"{col?.Width ?? 100}px";
    }

    private bool GetColumnVisibility(string fieldName)
    {
        if (currentLayout == null || !currentLayout.Any())
        {
            return true;
        }

        var col = currentLayout.FirstOrDefault(x => x.FieldName == fieldName);
        return col?.Visible ?? true;
    }

    // private void Grid_ColumnResizing(GridColumnResizeMode e)
    // {
    //     var col = currentLayout.FirstOrDefault(x => x.FieldName == e.Column.FieldName);
    //     if (col != null)
    //     {
    //         col.Width = ParseWidth(e.Width);
    //     }
    // }

    private async Task LoadAvailableLayouts()
    {
        availableLayouts = await GridLayoutService.GetLayoutsByVoucherTypeAsync(VOUCHER_TYPE);
    }

    private async Task LoadDefaultLayout()
    {
        var defaultLayout = await GridLayoutService.GetDefaultLayoutAsync(VOUCHER_TYPE);
        if (defaultLayout != null)
        {
            selectedLayoutId = defaultLayout.GridLayoutId;
            await ApplyLayout(defaultLayout);
        }
    }

    private async Task OnLayoutSelectedAsync(int? layoutId)
    {
        selectedLayoutId = layoutId;

        if (layoutId.HasValue)
        {
            var layout = await GridLayoutService.GetByIdAsync(layoutId.Value);
            if (layout != null)
            {
                await ApplyLayout(layout);
            }
        }
        else
        {
            InitializeColumns();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ApplyLayout(GridLayoutDto layout)
    {
        if (!string.IsNullOrEmpty(layout.GridLayoutData))
        {
            var savedLayout = GridLayoutService.DeserializeColumnLayout(layout.GridLayoutData);
            if (savedLayout != null && savedLayout.Any())
            {
                currentLayout = savedLayout.Select(s => new GridColumnLayout
                {
                    FieldName = s.FieldName,
                    Caption = s.Caption,
                    Visible = s.Visible,
                    Width = s.Width,
                    DisplayIndex = s.DisplayIndex
                }).ToList();

                foreach (var saved in savedLayout)
                {
                    var existing = allColumns.FirstOrDefault(x => x.FieldName == saved.FieldName);
                    if (existing != null)
                    {
                        existing.Visible = saved.Visible;
                        existing.Width = saved.Width;
                        existing.DisplayIndex = saved.DisplayIndex;
                    }
                }

                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void ShowSaveLayoutDialog()
    {
        if (selectedLayoutId.HasValue)
        {
            var layout = availableLayouts.FirstOrDefault(x => x.GridLayoutId == selectedLayoutId.Value);
            if (layout != null)
            {
                newLayoutName = layout.GridLayoutName ?? "";
                isDefaultLayout = layout.GridLayoutDefault;
                isEditMode = true;
                dialogTitle = "Update Grid Layout";
                showLayoutDialog = true;
                return;
            }
        }

        ShowNewLayoutDialog();
    }

    private void ShowNewLayoutDialog()
    {
        newLayoutName = "";
        isDefaultLayout = false;
        isEditMode = false;
        dialogTitle = "Create New Grid Layout";
        showLayoutDialog = true;
    }

    private async Task SaveCurrentLayout()
    {
        if (string.IsNullOrWhiteSpace(newLayoutName))
        {
            ToastService.Warning("Please enter a layout name.");
            return;
        }

        LoadingService.Show("Saving layout...");
        try
        {
            foreach (var col in allColumns)
            {
                var current = currentLayout.FirstOrDefault(c => c.FieldName == col.FieldName);
                if (current != null)
                {
                    current.Visible = col.Visible;
                    current.Width = col.Width;
                    current.DisplayIndex = col.DisplayIndex;
                }
                else
                {
                    currentLayout.Add(new GridColumnLayout
                    {
                        FieldName = col.FieldName,
                        Caption = col.Caption,
                        Visible = col.Visible,
                        Width = col.Width,
                        DisplayIndex = col.DisplayIndex
                    });
                }
            }

            var configJson = GridLayoutService.SerializeColumnLayout(currentLayout);
            bool success = false;

            if (isEditMode && selectedLayoutId.HasValue)
            {
                var updateRequest = new SaveGridLayoutRequest
                {
                    GridLayoutName = newLayoutName,
                    GridLayoutVoucherType = VOUCHER_TYPE,
                    GridLayoutData = configJson,
                    GridLayoutDefault = isDefaultLayout
                };
                success = await GridLayoutService.UpdateAsync(selectedLayoutId.Value, updateRequest);
            }
            else
            {
                var newLayoutRequest = new SaveGridLayoutRequest
                {
                    GridLayoutName = newLayoutName,
                    GridLayoutVoucherType = VOUCHER_TYPE,
                    GridLayoutData = configJson,
                    GridLayoutDefault = isDefaultLayout
                };
                var result = await GridLayoutService.CreateAsync(newLayoutRequest);
                success = result;

                if (success)
                {
                    await LoadAvailableLayouts();
                    var createdLayout = availableLayouts.FirstOrDefault(l => l.GridLayoutName == newLayoutName);
                    if (createdLayout != null)
                        selectedLayoutId = createdLayout.GridLayoutId;
                }
            }

            if (success)
            {
                ToastService.Success($"Grid layout {(isEditMode ? "updated" : "created")} successfully!");
                await LoadAvailableLayouts();

                if (isDefaultLayout)
                {
                    await LoadDefaultLayout();
                }

                CloseLayoutDialog();
                await InvokeAsync(StateHasChanged);
            }
            else
            {
                ToastService.Error($"Failed to {(isEditMode ? "update" : "create")} grid layout.");
            }
        }
        catch (Exception ex)
        {
            ToastService.Error($"Error saving layout: {ex.Message}");
            Console.WriteLine($"Layout save error: {ex}");
        }
        finally
        {
            LoadingService.Hide();
        }
    }

    private async Task DeleteCurrentLayout()
    {
        if (!selectedLayoutId.HasValue) return;

        var confirm = await ConfirmDialogService.ShowAsync(
            "Are you sure you want to delete this grid layout?");

        if (!confirm) return;

        LoadingService.Show("Deleting layout...");
        try
        {
            var success = await GridLayoutService.DeleteAsync(selectedLayoutId.Value);

            if (success)
            {
                ToastService.Success("Grid layout deleted successfully!");

                selectedLayoutId = null;
                InitializeColumns();
                currentLayout = allColumns.ToList();

                await LoadAvailableLayouts();
                await InvokeAsync(StateHasChanged);
            }
            else
            {
                ToastService.Error("Failed to delete grid layout.");
            }
        }
        catch (Exception ex)
        {
            ToastService.Error($"Error deleting layout: {ex.Message}");
        }
        finally
        {
            LoadingService.Hide();
        }
    }

    private void CloseLayoutDialog()
    {
        showLayoutDialog = false;
        newLayoutName = "";
        isDefaultLayout = false;
        isEditMode = false;
    }
    private async Task LoadCompaniesAsync()
    {
        LoadingService.Show();
        try
        {
            stateList = await StateService.GetStatesAsync();
            CountryList = await CountryService.GetAllAsync();

            companyList = await CompanyService.GetAllAsync();
            var configs = await EinvConfigService.GetAllAsync();
            ConfigModel = configs.FirstOrDefault() ?? new EinvConfig();
        }
        catch (Exception ex)
        {
            ToasteService.Error($"❌ Failed to load companies: {ex.Message}", "Error");
        }
       
        {
            LoadingService.Hide();
        }
    }

    async Task OnAddNew(ToolbarItemClickEventArgs e)
    {
        await CompanyGrid.StartEditNewRowAsync();
        ToasteService.Info("Creating new company...", "Info");
    }

    async Task OnEdit(ToolbarItemClickEventArgs e)
    {
        var company = CompanyGrid.GetFocusedDataItem() as Company;
        if (company != null)
            await CompanyGrid.StartEditDataItemAsync(company);
        else
            ToasteService.Warning("Please select a company to edit", "No Selection");
    }

    async Task OnDelete(ToolbarItemClickEventArgs e)
    {
        if (SelectedCompanies.Any())
        {
            var confirm = await ConfirmDialogService.ShowAsync($"Are you sure you want to delete {SelectedCompanies.Count} selected company(s)?");
            if (confirm)
            {
                LoadingService.Show();

                try
                {
                    foreach (var company in SelectedCompanies.ToList())
                    {
                        var result = await CompanyService.DeleteAsync(company.CompanyId);
                        if (result)
                        {
                            companyList.Remove(company);

                        }
                    }
                    ToasteService.Success($"{SelectedCompanies.Count} company(s) deleted", "Deleted");
                    SelectedCompanies.Clear();
                }
                catch (Exception ex)
                {
                    ToasteService.Error($"Delete failed: {ex.Message}", "Error");
                }
               
                {
                    LoadingService.Hide();
                    await LoadCompaniesAsync();
                }
            }
        }
        else
        {
            var company = CompanyGrid.GetFocusedDataItem();
            if (company != null)
                CompanyGrid.ShowDataItemDeleteConfirmation(company);
            else
                ToasteService.Warning("Please select a company to delete", "No Selection");
        }
    }

    async Task OnEditModelSaving(GridEditModelSavingEventArgs e)
    {
        LoadingService.Show();
        var model = e.EditModel as Company;
        if (model == null)
        {
            e.Cancel = true;
            ToasteService.Error("Invalid company data", "Error");
            return;
        }

        try
        {
            if (e.IsNew)
            {
                await CompanyService.CreateAsync(model);
                ToasteService.Success("Company created", "Success");
            }
            else
            {
                e.CopyChangesToDataItem();
                await CompanyService.UpdateAsync(model);
                ToasteService.Success("Company updated", "Success");
            }
            await LoadCompaniesAsync();
        }
        catch (Exception ex)
        {
            ToasteService.Error($"Save failed: {ex.Message}", "Error");
            e.Cancel = true;
        }
       
        {
            LoadingService.Hide();
        }
    }

    async Task OnDataItemDeleting(GridDataItemDeletingEventArgs e)
    {
        LoadingService.Show();
        var company = e.DataItem as Company;

        try
        {
            await CompanyService.DeleteAsync(company.CompanyId);
            ToasteService.Success("Company deleted", "Deleted");
            await LoadCompaniesAsync();
        }
        catch (Exception ex)
        {
            ToasteService.Error($"Delete failed: {ex.Message}", "Error");
        }
       
        {
            LoadingService.Hide();
        }
    }

    void OnSelectedDataItemsChanged(IReadOnlyList<object> selectedItems)
    {
        SelectedCompanies = selectedItems.Cast<Company>().ToList();
    }
