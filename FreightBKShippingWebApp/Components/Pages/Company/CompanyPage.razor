@page "/company"

@using FreightBKShippingWebApp.Model
@using FreightBKShippingWebApp.Models
@using FreightBKShippingWebApp.Services
@using DevExpress.Blazor
@using FreightBKShippingWebApp.Components.Pages
@using Microsoft.AspNetCore.Components.Authorization

@inject CompanyService CompanyService
@inject ToasteService ToastService
@inject LoadingService LoadingService
@inject StateService StateService
@inject CountryService CountryService
@inject EinvConfigService EinvConfigService
@inject ConfirmationDialogService ConfirmDialogService
@inject GridLayoutService GridLayoutService
@inject AuthenticationStateProvider AuthenticationStateProvider

<style>
    .grid-size {
        max-height: 600px;
    }

    .layout-combobox {
        border-radius: 6px;
        width: 185px;
    }
</style>

<DxGrid TItem="Company"
        Data="@companyList"
        @ref="CompanyGrid"
        KeyFieldName="CompanyId"
        ShowSearchBox="true"
        PageSize="10"
        PageSizeSelectorVisible="true"
        ShowGroupPanel="true"
        FilterMenuButtonDisplayMode="GridFilterMenuButtonDisplayMode.Always"
        FocusedRowEnabled="true"
        SelectionMode="GridSelectionMode.Multiple"
        SelectedDataItems="@SelectedCompanies"
        SelectedDataItemsChanged="OnSelectedCompaniesChanged"
        ColumnResizeMode="GridColumnResizeMode.NextColumn"
        CssClass="grid-size" AllowSelectRowByClick="true">

    <ToolbarTemplate Context="toolbarContext">
        <DxToolbar>
            <TitleTemplate Context="tl">
                <div class="d-flex align-items-center">
                    <i class="bi bi-building me-2"></i>
                    <span class="fs-5">Company</span>
                </div>
            </TitleTemplate>
            <Items>

                <DxToolbarItem Text="Add" IconCssClass="bi bi-plus-circle" Click="OnCreateNew" Visible="@IsSuperAdmin" />
                
                <DxToolbarItem Text="Edit" IconCssClass="bi bi-pencil-square" Click="OnEdit"  />
                <DxToolbarItem Text="Delete" IconCssClass="bi bi-trash" Click="OnDelete" Visible="@IsSuperAdmin" />
                <DxToolbarItem Text="Refresh" IconCssClass="bi bi-arrow-clockwise" Click="@LoadCompaniesAsync" />
                <DxToolbarItem Text="Config" IconCssClass="bi bi-gear" Click="OnConfig" />
                <DxToolbarItem Alignment="ToolbarItemAlignment.Right"
                               RenderStyle="ButtonRenderStyle.Secondary"
                               IconCssClass="bi bi-gear-wide-connected"
                               Click="ShowLayoutPopup" />
            </Items>
        </DxToolbar>
    </ToolbarTemplate>

    <Columns>
        <DxGridSelectionColumn Width="30" FixedPosition="GridColumnFixedPosition.Left" />

        <DxGridDataColumn FieldName="CompanyId" Caption="ID"
                          Width="@(layoutManager?.GetColumnWidth("CompanyId") ?? "100px")"
                          Visible="@(layoutManager?.GetColumnVisibility("CompanyId") ?? false)" />

        <DxGridDataColumn FieldName="Name" Caption="Name"
                          Width="@(layoutManager?.GetColumnWidth("Name") ?? "180px")" 
                          Visible="@(layoutManager?.GetColumnVisibility("Name") ?? true)" />

        <DxGridDataColumn FieldName="Code" Caption="Code"
                          Width="@(layoutManager?.GetColumnWidth("Code") ?? "120px")"
                          Visible="@(layoutManager?.GetColumnVisibility("Code") ?? false)" />

        <DxGridDataColumn FieldName="PrintName" Caption="Print Name"
                          Width="@(layoutManager?.GetColumnWidth("PrintName") ?? "180px")"
                          Visible="@(layoutManager?.GetColumnVisibility("PrintName") ?? true)" />

        <DxGridDataColumn FieldName="Address1" Caption="Address"
                          Width="@(layoutManager?.GetColumnWidth("Address1") ?? "220px")"
                          Visible="@(layoutManager?.GetColumnVisibility("Address1") ?? true)" />

        <DxGridDataColumn FieldName="City" Caption="City"
                          Width="@(layoutManager?.GetColumnWidth("City") ?? "140px")"
                          Visible="@(layoutManager?.GetColumnVisibility("City") ?? true)" />

        <DxGridDataColumn FieldName="StateName" Caption="State"
                          Width="@(layoutManager?.GetColumnWidth("StateName") ?? "160px")"
                          Visible="@(layoutManager?.GetColumnVisibility("StateName") ?? true)" />

        <DxGridDataColumn FieldName="Country" Caption="Country"
                          Width="@(layoutManager?.GetColumnWidth("Country") ?? "140px")"
                          Visible="@(layoutManager?.GetColumnVisibility("Country") ?? true)" />

        <DxGridDataColumn FieldName="Email" Caption="Email"
                          Width="@(layoutManager?.GetColumnWidth("Email") ?? "200px")"
                          Visible="@(layoutManager?.GetColumnVisibility("Email") ?? true)" />

        <DxGridDataColumn FieldName="Mobile" Caption="Mobile"
                          Width="@(layoutManager?.GetColumnWidth("Mobile") ?? "140px")"
                          Visible="@(layoutManager?.GetColumnVisibility("Mobile") ?? true)" />

        <DxGridDataColumn FieldName="Website" Caption="Website"
                          Width="@(layoutManager?.GetColumnWidth("Website") ?? "200px")"
                          Visible="@(layoutManager?.GetColumnVisibility("Website") ?? true)" />

        <DxGridDataColumn FieldName="Gstin" Caption="GSTIN"
                          Width="@(layoutManager?.GetColumnWidth("Gstin") ?? "160px")"
                          Visible="@(layoutManager?.GetColumnVisibility("Gstin") ?? true)" />

        <DxGridDataColumn FieldName="Panno" Caption="PAN No."
                          Width="@(layoutManager?.GetColumnWidth("Panno") ?? "140px")"
                          Visible="@(layoutManager?.GetColumnVisibility("Panno") ?? true)" />

        <DxGridDataColumn FieldName="IsGstApplicable" Caption="GST Applicable"
                          Width="@(layoutManager?.GetColumnWidth("IsGstApplicable") ?? "130px")"
                          Visible="@(layoutManager?.GetColumnVisibility("IsGstApplicable") ?? true)" />

        <DxGridDataColumn FieldName="Status" Caption="Status"
                          Width="@(layoutManager?.GetColumnWidth("Status") ?? "120px")"
                          Visible="@(layoutManager?.GetColumnVisibility("Status") ?? true)" />
    </Columns>
</DxGrid>


<CompanyAddEditPage @ref="companyPopup" OnSaved="LoadCompaniesAsync" />
<ConfigAddEditPage @ref="configPopup" OnSaved="LoadCompaniesAsync" />
<ConfirmationDialog />

<GridLayoutpPopup @ref="layoutManager"
                  VoucherType="Company"
                  Columns="@allColumns"
                  OnLayoutChanged="HandleLayoutChanged" />

@code {
   

  

    DxGrid CompanyGrid;
    private List<Company> companyList = [];
    // private List<Company> SelectedCompanies = new();
    private IReadOnlyList<object> SelectedCompanies { get; set; } = new List<object>();
    private CompanyAddEditPage companyPopup;
    private ConfigAddEditPage configPopup;
    private EinvConfig ConfigModel = new();

    

    private GridLayoutpPopup? layoutManager;
    private List<GridColumnLayout> allColumns = [];
    private async void ShowLayoutPopup()
    {
        await InvokeAsync(() =>
        {
            layoutManager?.ShowPopup();
        });
    }
    private async Task HandleLayoutChanged(List<GridColumnLayout> updatedLayout)
    {
        allColumns = updatedLayout;
        // Force the grid to re-render with new layout
        await InvokeAsync(StateHasChanged);
    }

    private bool IsSuperAdmin { get; set; }
    protected override async Task OnInitializedAsync()
    {
        InitializeColumns();
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
       
        var user = authState.User;

        IsSuperAdmin = user.IsInRole("SuperAdmin");
       
        await LoadCompaniesAsync();
      
       
    }


    private void InitializeColumns()
    {
        allColumns = new List<GridColumnLayout>
        {
            new() { FieldName = "CompanyId", Caption = "ID", Visible = false, Width =100, DisplayIndex = 0 },
            new() { FieldName = "Name", Caption = "Name", Visible = true, Width = 180, DisplayIndex = 1 },
            new() { FieldName = "Code", Caption = "Code", Visible = false, Width = 120, DisplayIndex = 2 },
            new() { FieldName = "PrintName", Caption = "Print Name", Visible = true, Width = 180, DisplayIndex = 3 },
            new() { FieldName = "Address1", Caption = "Address", Visible = true, Width = 250, DisplayIndex = 4 },
            new() { FieldName = "City", Caption = "City", Visible = true, Width = 150, DisplayIndex = 5 },
            new() { FieldName = "StateName", Caption = "State", Visible = true, Width = 150, DisplayIndex = 6 },
            new() { FieldName = "Country", Caption = "Country", Visible = true, Width = 150, DisplayIndex = 7 },
            new() { FieldName = "Email", Caption = "Email", Visible = true, Width = 200, DisplayIndex = 8 },
            new() { FieldName = "Mobile", Caption = "Mobile", Visible = true, Width = 150, DisplayIndex = 9 },
            new() { FieldName = "Website", Caption = "Website", Visible = true, Width = 150, DisplayIndex = 10 },
            new() { FieldName = "Gstin", Caption = "GSTIN", Visible = true, Width = 180, DisplayIndex = 11 },
            new() { FieldName = "Panno", Caption = "PAN No.", Visible = true, Width = 150, DisplayIndex = 12 },
            new() { FieldName = "IsGstApplicable", Caption = "GST Applicable", Visible = false, Width = 150, DisplayIndex = 13 },
            new() { FieldName = "Status", Caption = "Status", Visible = true, Width = 150, DisplayIndex = 14 }
        };
    }
        
    

   
    // ✅ FIXED: Reliable clear selection method
    private async Task ClearSelectionManual()
    {
        try
        {
            if (CompanyGrid != null)
            {
                CompanyGrid.ClearSelection(); // ✅ Synchronous method
            }
            SelectedCompanies = new List<Company>();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Clear selection error: {ex.Message}");
        }
    }

    // ✅ FIXED: Auto-clear after operations
    private async Task ClearSelection()
    {
        await Task.Delay(100); // Small delay for UI update
        await ClearSelectionManual();
    }
    private async Task LoadCompaniesAsync()
    {
        LoadingService.Show();
        try
        {
            companyList = await CompanyService.GetAllAsync();
            var configs = await EinvConfigService.GetAllAsync();
            ConfigModel = configs.FirstOrDefault() ?? new EinvConfig();
        }
        finally
        {
            LoadingService.Hide();
        }
    }

    private async Task OnSelectedCompaniesChanged(IReadOnlyList<object> companies)
    {
        SelectedCompanies = companies ?? new List<object>();
        await InvokeAsync(StateHasChanged);
    }

    private void OnCreateNew(ToolbarItemClickEventArgs e)
    {
        companyPopup.Show(new Company());
    }

    private async Task OnEdit(ToolbarItemClickEventArgs e)
    {
        var company = CompanyGrid.GetFocusedDataItem() as Company;
        if (company != null)
            companyPopup.Show(company);
        else
            ToastService.Warning("Please select a company to edit.");
        await ClearSelection();
    }

    private async Task OnDelete(ToolbarItemClickEventArgs e)
    {
        if (SelectedCompanies == null || SelectedCompanies.Count == 0)
        {
            ToastService.Warning("Please select at least one company to delete.");
            return;
        }
        var selectedList = SelectedCompanies.Cast<Company>().ToList();
        var confirm = await ConfirmDialogService.ShowAsync(
            $"Are you sure you want to delete {SelectedCompanies.Count} selected company(s)?");

        if (confirm)
        {
            LoadingService.Show();
            try
            {
                foreach (var company in selectedList)
                {
                    await CompanyService.DeleteAsync(company.CompanyId ?? 0);
                }

                ToastService.Success($"{SelectedCompanies.Count} company(s) deleted successfully.");
                await LoadCompaniesAsync();
            }
            catch (Exception ex)
            {
                ToastService.Error($"Error deleting companies: {ex.Message}");
            }
            finally
            {
                LoadingService.Hide();
                await ClearSelection();
            }
        }
    }

    private void OnConfig(ToolbarItemClickEventArgs e)
    {
        configPopup.Show(ConfigModel);
    }
}