@page "/JournalEntry"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using FreightBKShippingWebApp.Model
@using FreightBKShippingWebApp.Models
@using FreightBKShippingWebApp.Services
@using DevExpress.Blazor
@using Microsoft.AspNetCore.Components.Authorization
@inject JournalService JournalService
@inject ToasteService ToastService
@inject LoadingService LoadingService
@inject NavigationManager NavigationManager
@inject ConfirmationDialogService ConfirmDialogService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject AuditLogService AuditLogService

<PageTitle>Journal Entries</PageTitle>

<style>
    .grid-size {
        max-height: 570px;
    }
</style>

<DxGrid @ref="MyGrid"
        TItem="Journal"
        Data="@JournalList"
        KeyFieldName="JournalId"
        ShowSearchBox="true"
        ShowFilterRow="true"
        PageSize="100"
        AllowSort="false"
        ShowGroupPanel="true"
        FilterMenuButtonDisplayMode="GridFilterMenuButtonDisplayMode.Always"
        FocusedRowEnabled="true"
        SelectionMode="GridSelectionMode.Multiple"
        SelectedDataItems="@SelectedJournals"
        SelectedDataItemsChanged="OnSelectionChanged"
        ColumnResizeMode="GridColumnResizeMode.NextColumn"
        CssClass="grid-size"
        AllowSelectRowByClick="true">

    <ToolbarTemplate>
        <DxToolbar>
            <TitleTemplate Context="tlt">
                <div class="d-flex align-items-center">
                    <i class="bi bi-journal-text me-2 py-2"></i>
                    <span class="fs-5">Journal Entries</span>
                </div>
            </TitleTemplate>
            <Items>
                <DxToolbarItem Text="Add"
                               IconCssClass="bi bi-plus-circle"
                               Click="OnAdd" />

                <DxToolbarItem Text="Edit"
                               IconCssClass="bi bi-pencil-square"
                               Click="OnEdit" />

                <DxToolbarItem Text="Delete"
                               IconCssClass="bi bi-trash"
                               Click="OnDelete" />

                @if (IsAdmin)
                {
                    <DxToolbarItem Text="@GetLockText()"
                                   IconCssClass="@GetLockIcon()"
                                   Click="OnToggleLock" />
                }

                <DxToolbarItem Text="Refresh"
                               IconCssClass="bi bi-arrow-clockwise"
                               Click="@(async (_) => await LoadJournals())" />

                <DxToolbarItem Alignment="ToolbarItemAlignment.Right"
                               RenderStyle="ButtonRenderStyle.Secondary"
                               IconCssClass="bi bi-gear-wide-connected"
                               Click="ShowLayoutPopup" />
            </Items>
        </DxToolbar>
    </ToolbarTemplate>

    <Columns>
        <DxGridSelectionColumn Width="40" />

        <DxGridDataColumn FieldName="JournalLockedByUsername" Caption="Locked By"
                          Width="@(layoutManager?.GetColumnWidth("JournalLockedByUsername") ?? "150px")">
            <CellDisplayTemplate>
                @{
                    var j = context.DataItem as Journal;
                    if (!string.IsNullOrEmpty(j?.JournalLockedByUsername))
                    {
                        <span class="badge bg-warning text-dark">
                            <i class="bi bi-lock-fill"></i>
                            @j.JournalLockedByUsername
                        </span>
                    }
                    else
                    {
                        <span class="text-muted">—</span>
                    }
                }
            </CellDisplayTemplate>
        </DxGridDataColumn>

        <DxGridDataColumn FieldName="VoucherName" Caption="Voucher Type"
                          Width="@(layoutManager?.GetColumnWidth("VoucherName") ?? "200px")"
                          Visible="@(layoutManager?.GetColumnVisibility("VoucherName") ?? true)" />

        <DxGridDataColumn FieldName="JournalNoStr" Caption="Journal No"
                          Width="@(layoutManager?.GetColumnWidth("JournalNoStr") ?? "160px")"
                          Visible="@(layoutManager?.GetColumnVisibility("JournalNoStr") ?? true)" />

        <DxGridDataColumn FieldName="JournalDate" Caption="Date" DisplayFormat="dd/MM/yyyy"
                          Width="@(layoutManager?.GetColumnWidth("JournalDate") ?? "150px")"
                          Visible="@(layoutManager?.GetColumnVisibility("JournalDate") ?? true)" />

        <DxGridDataColumn FieldName="JournalAmount" Caption="Total Debit / Credit"
                          Width="@(layoutManager?.GetColumnWidth("JournalAmount") ?? "200px")"
                          Visible="@(layoutManager?.GetColumnVisibility("JournalAmount") ?? true)">
            <CellDisplayTemplate>
                @{
                    var j = context.DataItem as Journal;
                }
                <span class="fw-semibold">₹ @j?.JournalAmount.ToString("N2")</span>
            </CellDisplayTemplate>
        </DxGridDataColumn>

        <DxGridDataColumn FieldName="JournalRemarks" Caption="Narration"
                          Width="@(layoutManager?.GetColumnWidth("JournalRemarks") ?? "400px")"
                          Visible="@(layoutManager?.GetColumnVisibility("JournalRemarks") ?? true)" />
    </Columns>
</DxGrid>

<JournalAddEditPage @ref="Popup" OnSaved="LoadJournals" />
<ConfirmationDialog />

<GridLayoutpPopup @ref="layoutManager"
                  VoucherType="JournalEntry"
                  Columns="@allColumns"
                  OnLayoutChanged="HandleLayoutChanged" />

@code {
    private IGrid? MyGrid;
    private JournalAddEditPage? Popup;

    private List<Journal> JournalList = new();
    private IReadOnlyList<object> SelectedJournals = new List<object>();

    private bool IsAdmin;
    private string CurrentUserId = string.Empty;

    private GridLayoutpPopup? layoutManager;
    private List<GridColumnLayout> allColumns = [];

    private async void ShowLayoutPopup()
        => await InvokeAsync(() => layoutManager?.ShowPopup());

    private async Task HandleLayoutChanged(List<GridColumnLayout> updatedLayout)
    {
        allColumns = updatedLayout;
        await InvokeAsync(StateHasChanged);
    }

    private void InitializeColumns()
    {
        allColumns = new List<GridColumnLayout>
        {
            new() { FieldName = "JournalLockedByUsername", Caption = "Locked By",          Visible = true, Width = 150, DisplayIndex = 0 },
            new() { FieldName = "VoucherName",             Caption = "Voucher Type",        Visible = true, Width = 200, DisplayIndex = 1 },
            new() { FieldName = "JournalNoStr",            Caption = "Journal No",          Visible = true, Width = 160, DisplayIndex = 2 },
            new() { FieldName = "JournalDate",             Caption = "Date",                Visible = true, Width = 150, DisplayIndex = 3 },
            new() { FieldName = "JournalAmount",           Caption = "Total Debit/Credit",  Visible = true, Width = 200, DisplayIndex = 4 },
            new() { FieldName = "JournalRemarks",          Caption = "Narration",           Visible = true, Width = 400, DisplayIndex = 5 },
        };
    }

    protected override async Task OnInitializedAsync()
    {
        InitializeColumns();
        await CheckRole();
        await LoadJournals();
    }

    private async Task LoadJournals()
    {
        try
        {
            LoadingService.Show();
            JournalList = (await JournalService.GetAllAsync())
                .Where(j => j.JournalMasterType == "JOURNAL")
                .OrderByDescending(j => j.JournalDate)
                .ToList();
        }
        finally
        {
            LoadingService.Hide();
        }
    }

    private void OnAdd(ToolbarItemClickEventArgs e)
        => Popup?.Show(new Journal { JournalDate = DateTime.Now });

    private void OnEdit(ToolbarItemClickEventArgs e)
    {
        var journal = MyGrid?.GetFocusedDataItem() as Journal;
        if (journal == null)
        {
            ToastService.Warning("Select a journal entry to edit.");
            return;
        }
        if (!string.IsNullOrEmpty(journal.JournalLockedBy))
        {
            ToastService.Error("This journal entry is locked.");
            return;
        }
        var freshData = JournalList.FirstOrDefault(x => x.JournalId == journal.JournalId);
        if (freshData != null)
            Popup?.Show(freshData);
    }

    private async Task OnDelete(ToolbarItemClickEventArgs e)
    {
        if (SelectedJournals == null || !SelectedJournals.Any())
        {
            ToastService.Warning("Select journal entry/entries to delete.");
            return;
        }

        var selectedList = SelectedJournals.Cast<Journal>().ToList();
        var confirm = await ConfirmDialogService.ShowAsync(
            $"Are you sure you want to delete {selectedList.Count} selected journal entry/entries?");

        if (!confirm)
        {
            MyGrid?.ClearSelection();
            return;
        }

        try
        {
            LoadingService.Show("Deleting...");
            int successCount = 0;

            foreach (var journal in selectedList)
            {
                var result = await JournalService.DeleteAsync(journal.JournalId);
                if (result.Success)
                {
                    successCount++;
                    AuditLogService.NotifyAuditChanged();
                }
                else
                {
                    ToastService.Error(result.Error);
                }
            }

            if (successCount > 0)
                ToastService.Success($"{successCount} Journal entry/entries deleted successfully.");

            await LoadJournals();
        }
        finally
        {
            LoadingService.Hide();
            MyGrid?.ClearSelection();
        }
    }

    private async Task OnToggleLock(ToolbarItemClickEventArgs e)
    {
        foreach (var j in SelectedJournals.Cast<Journal>())
            await JournalService.ToggleLockAsync(j.JournalId);

        await LoadJournals();
        MyGrid?.ClearSelection();
    }

    private async Task OnSelectionChanged(IReadOnlyList<object> items)
    {
        SelectedJournals = items ?? new List<object>();
        await InvokeAsync(StateHasChanged);
    }

    private string GetLockText()
        => SelectedJournals.Any(j => string.IsNullOrEmpty(((Journal)j).JournalLockedBy))
            ? "Lock" : "Unlock";

    private string GetLockIcon()
        => SelectedJournals.Any(j => string.IsNullOrEmpty(((Journal)j).JournalLockedBy))
            ? "bi bi-lock" : "bi bi-unlock";

    private async Task CheckRole()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = state.User;
        IsAdmin = user.IsInRole("Admin");
        CurrentUserId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
    }
}
