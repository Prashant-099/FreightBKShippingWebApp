@page "/notify"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using FreightBKShippingWebApp.Model
@using FreightBKShippingWebApp.Services
@using FreightBKShippingWebApp.Components.Pages
@inject NotifyService NotifyService
@inject ToasteService ToastService
@inject LoadingService LoadingService
@inject ConfirmationDialogService ConfirmDialogService
@inject GridLayoutService GridLayoutService
@inject AuditLogService AuditLogService
<style>
    .grid-size {
        max-height: 600px;
    }


    /* ComboBox Styling */
    .layout-combobox {
        border-radius: 6px;
        width: 185px;
    }
</style>
<DxGrid TItem="NotifyModel"
        Data="@notifyList"
        @ref="MyGrid"
        KeyFieldName="NotifyId"
        ShowSearchBox="true"
        PageSize="10"
        PageSizeSelectorVisible="true"
        ShowGroupPanel="true"
        FilterMenuButtonDisplayMode="GridFilterMenuButtonDisplayMode.Always"
        FocusedRowEnabled="true"
        SelectionMode="GridSelectionMode.Multiple"
        SelectedDataItems="@SelectedNotifies"
        SelectedDataItemsChanged="OnSelectedNotifiesChanged"
        ColumnResizeMode="GridColumnResizeMode.NextColumn"
        CssClass="grid-size"
        AllowSelectRowByClick="true">

    <ToolbarTemplate Context="toolbarContext">
        <DxToolbar>
            <TitleTemplate Context="tl">
                <div class="d-flex align-items-center">
                    <i class="bi bi-bell me-2"></i>
                    <span class="fs-5">Miscellaneous</span>
                </div>
            </TitleTemplate>
            <Items>
                <DxToolbarItem Text="Add" IconCssClass="bi bi-plus-circle" Click="OnCreateNew" />
                <DxToolbarItem Text="Edit" IconCssClass="bi bi-pencil-square" Click="OnEdit" />
                <DxToolbarItem Text="Delete" IconCssClass="bi bi-trash" Click="OnDelete" />
                <DxToolbarItem Text="Refresh" IconCssClass="bi bi-arrow-clockwise" Click="@(async (_) => await LoadNotifiesAsync())" />

                <DxToolbarItem Alignment="ToolbarItemAlignment.Right"
                               RenderStyle="ButtonRenderStyle.Secondary"
                               IconCssClass="bi bi-gear-wide-connected"
                               Click="ShowLayoutPopup" />

            </Items>
        </DxToolbar>
    </ToolbarTemplate>

    <Columns>

        <DxGridSelectionColumn Width="30" FixedPosition="GridColumnFixedPosition.Left" />

        <DxGridDataColumn FieldName="NotifyId" Caption="ID"
                          Width="@(layoutManager?.GetColumnWidth("NotifyId") ?? "80px")"
                          Visible="@(layoutManager?.GetColumnVisibility("NotifyId") ?? false)" />

        <DxGridDataColumn FieldName="NotifyName" Caption="Name"
                          Width="@(layoutManager?.GetColumnWidth("NotifyName") ?? "630px")"
                          Visible="@(layoutManager?.GetColumnVisibility("NotifyName") ?? true)" />

        <DxGridDataColumn FieldName="NotifyType" Caption="Type"
                          Width="@(layoutManager?.GetColumnWidth("NotifyType") ?? "160px")"
                          Visible="@(layoutManager?.GetColumnVisibility("NotifyType") ?? true)" />

        <DxGridDataColumn FieldName="NotifyCity" Caption="City"
                          Width="@(layoutManager?.GetColumnWidth("NotifyCity") ?? "200px")"
                          Visible="@(layoutManager?.GetColumnVisibility("NotifyCity") ?? true)" />

        <DxGridDataColumn FieldName="NotifyCountry" Caption="Country"
                          Width="@(layoutManager?.GetColumnWidth("NotifyCountry") ?? "170px")"
                          Visible="@(layoutManager?.GetColumnVisibility("NotifyCountry") ?? true)" />

        <DxGridDataColumn FieldName="NotifyEmail" Caption="Email"
                          Width="@(layoutManager?.GetColumnWidth("NotifyEmail") ?? "180px")"
                          Visible="@(layoutManager?.GetColumnVisibility("NotifyEmail") ?? true)" />

        <DxGridDataColumn FieldName="NotifyStatus" Caption="Active"
                          Width="@(layoutManager?.GetColumnWidth("NotifyStatus") ?? "120px")"
                          Visible="@(layoutManager?.GetColumnVisibility("NotifyStatus") ?? true)" />

    </Columns>
</DxGrid>

<NotifyAddEditPage @ref="popup" OnSaved="LoadNotifiesAsync" />

<ConfirmationDialog />
<GridLayoutpPopup @ref="layoutManager"
                  VoucherType="Notify"
                  Columns="@allColumns"
                  OnLayoutChanged="HandleLayoutChanged" />

@code {
    DxGrid MyGrid;
    private List<Notify> notifyList = new();
    // private List<Notify> SelectedNotifies = new();
    private IReadOnlyList<object> SelectedNotifies { get; set; } = new List<object>();

    private NotifyAddEditPage popup;

    // All possible columns
    private GridLayoutpPopup? layoutManager;
    private List<GridColumnLayout> allColumns = [];
    private async void ShowLayoutPopup()
    {
        await InvokeAsync(() =>
        {
            layoutManager?.ShowPopup();
        });
    }
    private async Task HandleLayoutChanged(List<GridColumnLayout> updatedLayout)
    {
        allColumns = updatedLayout;
        // Force the grid to re-render with new layout
        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnInitializedAsync()
    {
        InitializeColumns();
        await LoadNotifiesAsync();


    }
    private void InitializeColumns()
    {
        allColumns = new List<GridColumnLayout>
        {new() { FieldName = "NotifyId", Caption = "ID", Visible = false, Width = 10, DisplayIndex = 0 },
    new() { FieldName = "NotifyName", Caption = "Name", Visible = true, Width = 630, DisplayIndex = 1 },
    new() { FieldName = "NotifyType", Caption = "Type", Visible = true, Width = 160, DisplayIndex = 2 },
    new() { FieldName = "NotifyCity", Caption = "City", Visible = true, Width = 200, DisplayIndex = 3 },
    new() { FieldName = "NotifyCountry", Caption = "PAN", Visible = true, Width = 170, DisplayIndex = 4 },
    new() { FieldName = "NotifyEmail", Caption = "Email", Visible = true, Width = 180, DisplayIndex = 5 },
     new() { FieldName = "NotifyStatus", Caption = "Active", Visible = true, Width = 120, DisplayIndex = 6 }
    };

    }


    private async Task LoadNotifiesAsync()
    {
        LoadingService.Show("Loading notifies...");
        try
        {
            notifyList = await NotifyService.GetAllAsync();
        }
        finally
        {
            LoadingService.Hide();
        }
    }

    private async Task OnSelectedNotifiesChanged(IReadOnlyList<object> notifies)
    {
        SelectedNotifies = notifies ?? new List<object>();
        await InvokeAsync(StateHasChanged);
    }
    // ✅ FIXED: Reliable clear selection method
    private async Task ClearSelectionManual()
    {
        try
        {
            if (MyGrid != null)
            {
                MyGrid.ClearSelection(); // ✅ Synchronous method
            }
            SelectedNotifies = new List<Notify>();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Clear selection error: {ex.Message}");
        }
    }

    // ✅ FIXED: Auto-clear after operations
    private async Task ClearSelection()
    {
        await Task.Delay(100); // Small delay for UI update
        await ClearSelectionManual();
    }

    private void OnCreateNew(ToolbarItemClickEventArgs e)
    {
        popup.Show(new Notify()
        {
            NotifyStatus = true,
            NotifyCreated = DateTime.Now,
            NotifyUpdated = DateTime.Now
        });
    }

    private async Task OnEdit(ToolbarItemClickEventArgs e)
    {
        var notify = MyGrid.GetFocusedDataItem() as Notify;
        if (notify != null)
        {
            var freshData = notifyList
          .FirstOrDefault(x => x.NotifyId == notify.NotifyId);

            if (freshData != null)
                popup.Show(freshData);

        }
        else
            ToastService.Warning("Please select a record to edit.");
        await ClearSelection();
    }

    private async Task OnDelete(ToolbarItemClickEventArgs e)
    {
        if (SelectedNotifies == null || SelectedNotifies.Count == 0)
        {
            ToastService.Warning("Please select at least one record to delete.");
            return;
        }
        var selectedList = SelectedNotifies.Cast<Notify>().ToList();

        var confirm = await ConfirmDialogService.ShowAsync(
            $"Are you sure you want to delete {SelectedNotifies.Count} selected record(s)?");

        if (!confirm)
        {
            await ClearSelection(); // ✅ Clear on cancel
            return;
        }
        try
        {
            LoadingService.Show("Deleting...");
            int successCount = 0, failCount = 0;
            List<string> errorMessages = new();
            foreach (var notify in selectedList)
            {
                var result = await NotifyService.DeleteAsync(notify.NotifyId);
                if (result.Success)
                {
                    successCount++;
                    AuditLogService.NotifyAuditChanged();

                }
                else
                {
                    failCount++;
                    errorMessages.Add(result.Error);
                }
            }

        if (successCount > 0)
            ToastService.Success($"{successCount} record(s) deleted successfully.");
        if (failCount > 0)
                ToastService.Error($"{failCount}  record(s) Failed To Delete.\nDetails: {string.Join("\n", errorMessages.Distinct())}");
        await LoadNotifiesAsync();
        }
        finally
        {
            LoadingService.Hide();
            await ClearSelection(); // ✅ Clear after delete (success or fail)
        }
    }
}
