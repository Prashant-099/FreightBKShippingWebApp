@using FreightBKShippingWebApp.Model
@using FreightBKShippingWebApp.Models
@using FreightBKShippingWebApp.Services
@using System.Text.Json
@inject NotifyService NotifyService
@inject ToasteService ToastService
@inject LoadingService LoadingService
@inject CountryService CountryService
@inject StateService StateService
@inject AuditLogService AuditLogService
<DxPopup @bind-Visible="Visible" ShowCloseButton="true" HeaderText="@Title" MaxWidth="850"
         CloseOnOutsideClick="false" horizontalAlignment="HorizontalAlignment.Center"
         verticalAlignment="VerticalAlignment.Center" BodyCssClass="my-popup-body" 
         ShowFooter="true" scrollable="true">
     <BodyContentTemplate Context="bdy">
        <EditForm EditContext="@editContext" OnValidSubmit="HandleValidSubmit" Context="cxnotify" id="notfyForm">
        <DataAnnotationsValidator />
       @*  <ValidationSummary /> *@
        <DxFormLayout>

            <DxFormLayoutItem Caption="Name" ColSpanMd="8">
                <ChildContent>
                        <DxTextBox @bind-Text="EditModel.NotifyName"ShowValidationIcon="true" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                </ChildContent>
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="Type" ColSpanMd="4">
                <ChildContent>
                    <DxComboBox Data="@TypeList"
                                @bind-Value="EditModel.NotifyType"
                                ShowValidationIcon="true"
                                TextFieldName="Text"
                                ValueFieldName="Value"
                                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                AllowUserInput="true"
                                SearchMode="ListSearchMode.AutoSearch" SearchFilterCondition="ListSearchFilterCondition.Contains" />
                </ChildContent>
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="Address" ColSpanMd="12">
                <ChildContent>
                    <DxMemo @bind-Text="EditModel.NotifyAddress1" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                </ChildContent>
            </DxFormLayoutItem>

            @*  <DxFormLayoutItem Caption="Address 2">
                <ChildContent>
                    <DxMemo @bind-Text="EditModel.NotifyAddress2" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                </ChildContent>
            </DxFormLayoutItem> *@

            <DxFormLayoutItem Caption="City">
                <ChildContent>
                    <DxTextBox @bind-Text="EditModel.NotifyCity" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                </ChildContent>
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="State" ColSpanMd="6">
                <ChildContent>
                    <DxComboBox TData="State" TValue="int"
                                Data="@stateList"
                                TextFieldName="StateName"
                                ValueFieldName="StateId"
                                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                AllowUserInput="false"
                                NullText="-- Select State --"
                                @bind-Value="EditModel.NotifyStateId"
                                SearchMode="ListSearchMode.AutoSearch"
                                SearchFilterCondition="ListSearchFilterCondition.Contains" />
                </ChildContent>
            </DxFormLayoutItem>
            <DxFormLayoutItem Caption="Pincode">
                <ChildContent>
                    <DxTextBox @bind-Text="EditModel.NotifyPincode" />
                </ChildContent>
            </DxFormLayoutItem>
            <DxFormLayoutItem Caption="Country">
                <ChildContent>
                    <DxComboBox TData="Country" TValue="String"
                                Data="@CountryList"
                                TextFieldName="CountryName"
                                ValueFieldName="CountryName"
                                    ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                AllowUserInput="false"
                                NullText="-- Select Country --"
                                @bind-Value="EditModel.NotifyCountry"
                                SearchMode="ListSearchMode.AutoSearch"
                                SearchFilterCondition="ListSearchFilterCondition.Contains" />
                </ChildContent>
            </DxFormLayoutItem>
            <DxFormLayoutItem Caption="GSTIN">
                <ChildContent>
                        <DxTextBox @bind-Text="EditModel.NotifyGstNo" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                </ChildContent>
            </DxFormLayoutItem>
            <DxFormLayoutItem Caption="Contact No">
                <ChildContent>
                        <DxTextBox @bind-Text="EditModel.NotifyContactNo" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                </ChildContent>
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="Email">
                <ChildContent>
                        <DxTextBox @bind-Text="EditModel.NotifyEmail" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                </ChildContent>
            </DxFormLayoutItem>
            <DxFormLayoutItem Caption="PAN">
                <ChildContent>
                        <DxTextBox @bind-Text="EditModel.NotifyPan" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                </ChildContent>
            </DxFormLayoutItem>

            @*   <DxFormLayoutItem Caption="Active">
                <ChildContent>
                    <DxCheckBox @bind-Checked="EditModel.NotifyStatus" />
                </ChildContent>
            </DxFormLayoutItem> *@

        </DxFormLayout>
    </EditForm>
    </BodyContentTemplate>
    <FooterContentTemplate Context="ftrbrnch">
        <div class="mt-3 text-end">
            <DxButton Text="Save" RenderStyle="ButtonRenderStyle.Primary" SubmitFormOnClick="true" Form="notfyForm" />
            <DxButton Text="Cancel" RenderStyle="ButtonRenderStyle.Secondary" Click="Hide" />
        </div>
    </FooterContentTemplate>
</DxPopup>

@code {
    [Parameter] public EventCallback OnSaved { get; set; }
    private EditContext? editContext;
    private bool Visible { get; set; }
    private string Title { get; set; } = "Add/Edit Miscellaneous";
    private Notify EditModel { get; set; } = new();
    private List<State> stateList = new();
    private List<Country> CountryList = new();
    public class SelectItem
    {
        public string Text { get; set; }
        public string Value { get; set; }

    }
    List<SelectItem> TypeList = new()
{
    new SelectItem { Text = "LINE", Value = "LINE" },
    new SelectItem { Text = "SHIPPER", Value = "SHIPPER" },
    new SelectItem { Text = "CONSIGNEE", Value = "CONSIGNEE" },
    new SelectItem { Text = "CONSIGNOR", Value = "CONSIGNOR" },
    new SelectItem { Text = "CHA", Value = "CHA" },
    new SelectItem { Text = "AGENT", Value = "AGENT" },
    new SelectItem { Text = "YARD", Value = "YARD" },
    new SelectItem { Text = "NOTIFY", Value = "NOTIFY" },
    new SelectItem { Text = "SALESMAN", Value = "SALESMAN" },
    new SelectItem { Text = "REFRENCEBY", Value = "REFRENCEBY" },
    new SelectItem { Text = "ALL", Value = "ALL" },

};
    protected override async Task OnInitializedAsync()
    {
        stateList = await StateService.GetStatesAsync();
        CountryList = await CountryService.GetAllAsync();
    }
    public void Show(Notify notify)
    {
        if (notify.NotifyId>0)
        {
            // EditModel = notify;
            var json = JsonSerializer.Serialize(notify);
            EditModel = JsonSerializer.Deserialize<Notify>(json) ?? new Notify();
            Title = "Edit Miscellaneous";
        }
        else
        {
            EditModel = new Notify { NotifyStatus = true, NotifyType = notify?.NotifyType ?? string.Empty };
            Title = "Add Miscellaneous";
        }
        // Create EditContext when showing the form
        editContext = new EditContext(EditModel);
        Visible = true;
    }

    private void Hide()
    {
        Visible = false;
    }

    private async Task HandleValidSubmit()
    {
        LoadingService.Show("Saving Miscellaneous...");

        try
        {
            Notify? result;

            if (EditModel.NotifyId == 0)
            {
                // Create new notify
                result = await NotifyService.CreateAsync(EditModel);

                if (result != null)
                {
                    ToastService.Success("Miscellaneous created successfully!");
                    AuditLogService.NotifyAuditChanged();

                }
                else
                {
                    ToastService.Error("Failed to create Miscellaneous!");
                    return;
                }
            }
            else
            {
                // Update existing notify
                result = await NotifyService.UpdateAsync(EditModel);

                if (result != null)
                {
                    ToastService.Success("Miscellaneous updated successfully!");
                    AuditLogService.NotifyAuditChanged();

                }
                else
                {
                    ToastService.Error("Failed to update Miscellaneous!");
                    return;
                }
            }

            Visible = false;
            await OnSaved.InvokeAsync();
        }
        catch (Exception ex)
        {
            ToastService.Error($"❌ Error saving Miscellaneous: {ex.Message}");
        }
        finally
        {
            LoadingService.Hide();
        }
    }

}