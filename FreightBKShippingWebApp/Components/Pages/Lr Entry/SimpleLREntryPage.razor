@page "/lrentry"
@page "/lrentry/{LrId:int}"
@using FreightBKShipping.Client.Services
@using FreightBKShippingWebApp.Model
@using FreightBKShippingWebApp.Services
@using DevExpress.Blazor
@using static FreightBKShippingWebApp.Components.Pages.FileUploadpopup
@inject AuditLogService AuditLogService
@inject ToasteService ToastService
@inject PayTypeService PayTypeService
@inject LocationService LocationService
@inject NotifyService NotifyService
@inject AccountService AccountService
@inject ContainerAddServices ContainerAddServices
@inject CargoService CargoService
@inject ReportDataService ReportDataService
@inject FileUploadService FileUploadService
@inject IJSRuntime JS
@inject LrApiService LrApiService
@inject NavigationManager NavManager
@inject VehicleService VehicleService
@inject GridLayoutService GridLayoutService
@inject YearStatechangeService YearStatechangeService

<style>
    :root {
        --clr-bg: #f4f6fb;
        --clr-surface: #ffffff;
        --clr-border: #e2e8f0;
        --clr-primary: #2563eb;
        --clr-primary-dk: #1d4ed8;
        --clr-accent: #0ea5e9;
        --clr-text: #1e293b;
        --clr-muted: #2c679f;
        --clr-danger: #ef4444;
        --radius-card: 12px;
        --radius-inner: 8px;
        --shadow-card: 0 1px 3px rgba(0,0,0,.08), 0 4px 16px rgba(0,0,0,.06);
        --shadow-footer: 0 -2px 12px rgba(0,0,0,.08);
        --font-main: 'Sora', 'Segoe UI', sans-serif;
    }

    .dxbl-grid-header-cell,
    .dxbl-grid-header-cell button,
    .dxbl-grid-header-cell a {
        outline: none !important;
    }

    .dxbl-grid-header-row {
        pointer-events: auto;
    }
    .dxbl-grid-header-row *:not(button):not(a):not(input) {
        pointer-events: none;
    }

    .lr-page {
     height: 93vh;
    display: grid;
    grid-template-rows: auto 1fr auto;
    font-family: var(--font-main);
    color: var(--clr-text);
    overflow: hidden;
}

.lr-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 10px;
    border-top: 4px solid var(--clr-primary);
   /*  border-radius: var(--radius-inner); */
    padding: 5px 16px;
    box-shadow: var(--shadow-card);
    flex-wrap: nowrap;
    overflow: hidden;
    flex-shrink: 0;
    background: var(--clr-surface);
}

.lr-header-icon {
    width: 40px;
    height: 40px;
    border-radius: 6px;
    background: #eff4ff;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--clr-primary);
    flex-shrink: 0;
}

.lr-header-divider {
    width: 1px;
    height: 32px;
    background: var(--clr-border);
    flex-shrink: 0;
}

.lr-header-text {
    display: flex;
    flex-direction: column;
    gap: 0;
    min-width: 0;
}

.lr-header h1 {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -.02em;
    margin: 0;
    line-height: 1.2;
    white-space: nowrap;
    color: var(--clr-text);
}

.lr-header span {
    font-size: .75rem;
    color: var(--clr-muted);
    white-space: nowrap;
    line-height: 1.2;
}

.lr-header-badge {
    margin-left: auto;
    background: #eff4ff;
    color: var(--clr-primary);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: .08em;
    padding: 3px 8px;
    border-radius: 3px;
    text-transform: uppercase;
    white-space: nowrap;
    flex-shrink: 0;
}

    .lr-header-badge.edit-mode {
        background: #fef3c7;
        color: #b45309;
    }

.btn-back {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: #f1f5f9;
    color: var(--clr-text);
    border: 1px solid var(--clr-border);
    border-radius: 6px;
    padding: 6px 12px;
    font-size: .8rem;
    font-weight: 600;
    cursor: pointer;
    transition: background .15s;
    white-space: nowrap;
    flex-shrink: 0;
    text-decoration: none;
}

    .btn-back:hover {
        background: #e2e8f0;
    }

/* ── Column toggle button ── */
.btn-columns {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: #f1f5f9;
    color: var(--clr-text);
    border: 1px solid var(--clr-border);
    border-radius: 6px;
    padding: 6px 12px;
    font-size: .8rem;
    font-weight: 600;
    cursor: pointer;
    transition: background .15s;
    white-space: nowrap;
    flex-shrink: 0;
}

    .btn-columns:hover {
        background: #e2e8f0;
    }

/* ── Panel backdrop ── */
.col-panel-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,.25);
    z-index: 999;
}

/* ── Slide-in panel ── */
.col-panel {
    position: fixed;
    top: 0;
    right: 0;
    width: 260px;
    height: 100vh;
    background: #fff;
    border-left: 1px solid #e2e8f0;
    box-shadow: -4px 0 24px rgba(0,0,0,.12);
    z-index: 1000;
    display: flex;
    flex-direction: column;
    animation: slideIn .2s ease;
}

@@keyframes slideIn {
    from {
        transform: translateX(100%);
    }

    to {
        transform: translateX(0);
    }
}

.col-panel-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 3px 16px;
    font-weight: 600;
    font-size: 13px;
    border-bottom: 1px solid #f1f5f9;
    color: #1e293b;
}

    .col-panel-header button {
        background: none;
        border: none;
        cursor: pointer;
        font-size: 16px;
        color: #64748b;
        line-height: 1;
    }

.col-panel-actions {
    display: flex;
    gap: 8px;
    padding: 7px 16px;
    border-bottom: 1px solid #f1f5f9;
}

    .col-panel-actions button {
        flex: 1;
        padding: 5px 0;
        border: 1px solid #cbd5e1;
        border-radius: 5px;
        background: #f8fafc;
        font-size: 12px;
        cursor: pointer;
        color: #475569;
    }

        .col-panel-actions button:hover {
            background: #e2e8f0;
        }

.col-panel-list {
    flex: 1;
    overflow-y: auto;
    /* padding: 6px 0;*/
}

.col-toggle-row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 16px;
    cursor: pointer;
    font-size: 13px;
    color: #334155;
    transition: background .1s;
    user-select: none;
}

    .col-toggle-row:hover {
        background: #f8fafc;
    }

    .col-toggle-row input[type="checkbox"] {
        width: 15px;
        height: 15px;
        accent-color: #3b82f6;
        cursor: pointer;
        flex-shrink: 0;
    }

@@media (max-width: 640px) {
    .lr-header {
        padding: 8px 12px;
        gap: 8px;
        margin-bottom: 8px;
    }

        .lr-header h1 {
            font-size: .9rem;
        }

        .lr-header span {
            font-size: .68rem;
        }

    .lr-header-divider {
        display: none;
    }

    .lr-header-badge {
        display: none;
    }
}

.lr-card {
    background: var(--clr-surface);
    border: 1px solid var(--clr-border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    margin-bottom: 5px;
    overflow: hidden;
}

    .lr-card-Trans {
        background: var(--clr-surface);
        margin-bottom: 12px;
        overflow: hidden;
    }
.lr-card-header {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    border-bottom: 1px solid var(--clr-border);
    background: linear-gradient(90deg, #f8faff 0%, #fff 100%);
}

    .lr-card-header h2 {
        font-size: .8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .06em;
        color: var(--clr-primary);
        margin: 0;
    }
.lr-card-body-Add {
    padding: 6px 16px;
    overflow-y: auto;
    height:280px;
}
.lr-card-body {
    padding: 6px 16px;
}

    .lr-card-body-Trans {
        padding: 5px 5px;
    }
.field-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 5px 4px;
}

    /* Container for the fields */
    .field-grid-header {
        display: flex;
        align-items: center;
        gap: 12px; /* Gap thoda kam kiya taaki desktop pe fit ho sake */
        flex-wrap: wrap;
    }

    /* Field wrapper setup */
    .field-inline {
        display: flex;
        align-items: center;
        gap: 8px;
        flex: 1; /* Yeh desktop pe space ke hisaab se adjust hoga */
    }

        /* Label styling */
        .field-inline label {
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--clr-muted);
            white-space: nowrap;
            width: 60px; /* Sabhi labels ki fixed width taaki inputs align rahein */
        }

        /* Input styling */
        .field-inline .dxbl-text-edit,
        .field-inline .dxbl-spin-edit,
        .field-inline .dxbl-date-edit,
        .field-inline .dxbl-combobox {
            flex: 1; /* Input bachi hui puri jagah le lega */
            min-width: 100px;
        }

    /* --- Mobile Specific Changes --- */
    @@media (max-width: 768px) {
        .field-grid-header

    {
        flex-direction: column; /* Mobile pe ek ke niche ek */
        align-items: stretch;
    }

    .field-inline {
        width: 100%; /* Mobile pe full width */
    }

        .field-inline label {
            width: 80px; /* Mobile pe label ko thoda zyada space */
        }

    }
.twoinone {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
}

@@media (max-width: 1100px) {
    .field-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

@@media (max-width: 640px) {
    .field-grid {
        grid-template-columns: 1fr;
    }

    .lr-page {
        padding: 0;
    }

    .km-group {
        grid-template-columns: 1fr !important;
    }
}

.field-group {
    display: flex;
    flex-direction: column;
    gap: 3px;
}

    .field-group label {
        font-size: .7rem;
        font-weight: 700;
        color: var(--clr-muted);
        text-transform: uppercase;
        letter-spacing: .05em;
        line-height: 1.2;
    }

.km-group {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 12px 16px;
}

.lr-tabs-wrapper {
    background: var(--clr-surface);
    border: 1px solid var(--clr-border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    overflow: hidden;
    margin-bottom: 12px;
}

.lr-tab-body {
    padding: 10px;
}

.validation-summary-errors {
    background: #fff5f5;
    border: 1px solid #fca5a5;
    border-radius: var(--radius-inner);
    padding: 10px 14px;
    margin-bottom: 12px;
    color: var(--clr-danger);
    font-size: .8rem;
    line-height: 1.4;
}

    .validation-summary-errors ul {
        margin: 0;
        padding-left: 14px;
    }

.lr-footer {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    background: var(--clr-surface);
    border-top: 1px solid var(--clr-border);
    box-shadow: var(--shadow-footer);
    padding: 10px 24px;
    gap: 12px;
    height: 52px;
    flex-shrink: 0;
    z-index: 100;
}

   
.lr-footer-meta {
    font-size: .75rem;
    color: var(--clr-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    flex: 1;
    line-height: 1.4;
}

    .lr-footer-meta strong {
        color: var(--clr-text);
        font-weight: 600;
    }

.btn-save {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: linear-gradient(135deg, var(--clr-primary) 0%, var(--clr-accent) 100%);
    color: #fff !important;
    border: none;
    border-radius: 6px;
    padding: 8px 20px;
    font-size: .85rem;
    font-weight: 600;
    cursor: pointer;
    transition: opacity .15s, transform .1s;
    letter-spacing: .01em;
    flex-shrink: 0;
    white-space: nowrap;
}

    .btn-save:hover {
        opacity: .9;
        transform: translateY(-1px);
    }

    .btn-save:active {
        transform: translateY(0);
    }

@@media (max-width: 640px) {
    .lr-footer {
        padding: 8px 16px;
        height: 48px;
    }

    .btn-save {
        padding: 7px 14px;
        font-size: .8rem;
    }

        .lr-tab-body {
            padding: 10px;
            width:290px;
        }
    }

.lr-form-scroll {
    overflow-y: auto;
    padding: 0 16px 12px;
    min-height: 0; /* critical for grid row 1fr to shrink correctly */
}

.loading-overlay {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 200px;
    color: var(--clr-muted);
    font-size: .9rem;
    gap: 8px;
}











    /* ===== Flex Layout for Booking + Billing ===== */
    .lr-tab-flex {
        display: flex;
        gap: 16px;
        align-items: flex-start;
    }

    /* Left Section */
    .lr-tab-left {
        flex: 1 1 auto;
        min-width: 0;
    }

    /* Right Billing Section */
    .lr-tab-right {
        flex: 0 0 360px;
        position: sticky;
        top: 10px;
    }

    /* Billing Wrapper */
    .billing-wrapper {
        background: var(--clr-surface);
        border: 1px solid var(--clr-border);
        border-radius: var(--radius-card);
        box-shadow: var(--shadow-card);
        overflow: hidden;
    }

    /* Billing Body */
    .billing-body {
        padding: 14px;
    }

    /* Billing Row */
    .billing-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
        margin-bottom: 12px;
    }

    /* Action Buttons */
    .billing-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin: 12px 0;
    }

        .billing-actions .dx-button {
            flex: 1 1 calc(50% - 4px);
        }

   

    .summary-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 6px;
        font-size: 0.9rem;
    }

        .summary-row strong {
            font-size: 1.1rem;
        }

    .text-primary {
        color: var(--clr-primary);
    }

    /* ===== Responsive Design ===== */
    @@media (max-width: 992px) {
        .lr-tab-flex

    {
        flex-direction: column;
    }

    .lr-tab-right {
        flex: 1 1 auto;
        width: 100%;
        position: static;
        margin-top: 12px;
    }

    }




    /* Outline Button Style */
    .btn-outline {
        background: #eff6ff;
        border: 1px solid var(--clr-primary);
        color: var(--clr-primary);
        font-weight: 600;
    }

        .btn-outline:hover {
            background: #dbeafe;
        }

    /* Summary Section */
    .billing-summary {
        border-top: 1px dashed var(--clr-border);
        border-bottom: 1px dashed var(--clr-border);
       /*  padding: 12px 0; */
        margin: 10px 0;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.95rem;
    }

        .summary-row.total strong,
        .billing-summary.balance strong {
            font-size: 1.2rem;
        }

    .summary-sub {
        font-size: 0.75rem;
        color: var(--clr-muted);
    }

    /* Payment List */
    .payment-list {
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin: 10px 0;
    }

    .payment-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px;
        background: #f8fafc;
        border: 1px solid var(--clr-border);
        border-radius: var(--radius-inner);
    }

    .payment-info {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

        .payment-info strong {
            font-size: 0.85rem;
        }

        .payment-info span {
            font-size: 0.8rem;
            color: var(--clr-muted);
        }

        .payment-info small {
            font-size: 0.7rem;
            color: #64748b;
        }

    .payment-amount {
        display: flex;
        align-items: center;
        gap: 6px;
        font-weight: 600;
    }

    /* Balance Highlight */
    .billing-summary.balance {
        background: #f8fafc;
        border-radius: var(--radius-inner);
        padding: 12px;
    }


    /* Wrapper for Expense and Driver Payment */
    .expense-driver-wrapper {
        display: flex;
        gap: 16px;
        align-items: stretch;
    }

    /* Equal width sections */
    .expense-section,
    .driver-section {
        flex: 1;
        min-width: 0;
    }

        /* Ensure cards take full height */
        .expense-section .lr-card,
        .driver-section .lr-card {
            height: 100%;
        }

    .clickable {
        cursor: pointer;
    }
    /* Mobile View: Stack vertically */
   @@media (max-width: 768px) {
        .expense-driver-wrapper

    {
        flex-direction: column;
    }

    }


    /* Wrapper for both sections */
    .lr-details-wrapper {
        display: flex;
        gap: 16px;
        align-items: flex-start;
    }

    /* Left section -*/
    .lr-main-details {
        flex: 1; /* 65% width */
        min-width: 210px;
        
    }

    /* Right section */
    .lr-additional-details {
        flex: 0 0 35%; /*  width (~35%) */
        min-width: 0;
       
    }

    /* Grid inside sections */
    .field-grid-main,
    .field-grid-additional {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 10px;
    }
    /* Responsive: Mobile view */
    @@media (max-width: 768px) {
        .lr-details-wrapper

    {
        flex-direction: column;
    }

    .lr-main-details,
    .lr-additional-details {
        flex: 1 1 100%;
        width: 100%;
    }

        .field-grid-main,
        .field-grid-additional {
            display: grid;
            grid-template-columns: repeat(1, 1fr);
            gap: 10px;
        }

        .billing-row {
            display: grid;
            grid-template-columns: repeat(1, 1fr);
            gap: 10px;
            margin-bottom: 12px;
        }
    }

    /*  for commison */
    .input-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
}

</style>


<div class="lr-page">

    <!-- ══ HEADER ══ -->
    <div class="lr-header">
        <div class="lr-header-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="1.75"
                 stroke-linecap="round" stroke-linejoin="round">
                <rect x="1" y="3" width="15" height="13" rx="1" />
                <path d="M16 8h4l3 4v4h-7V8z" />
                <circle cx="5.5" cy="18.5" r="2.5" />
                <circle cx="18.5" cy="18.5" r="2.5" />
            </svg>
        </div>
        <div class="lr-header-divider"></div>
        <div class="lr-header-text">
            <h1>LR Entry</h1>
            <span>Lorry Receipt</span>
        </div>
        <button type="button" class="btn-back" @onclick="GoBack">← List</button>
        <div class="lr-header-badge @(IsEditMode ? "edit-mode" : "")">
            @(IsEditMode ? "Edit" : "New Entry")
        </div>
        <button type="button" class="btn-columns" @onclick="() => showPanel = !showPanel">⚙ Columns</button>
    </div>

    <!-- ══ COLUMN VISIBILITY PANEL ══ -->
    @if (showPanel)
    {
        <div class="col-panel-backdrop" @onclick="CloseFieldPanel"></div>
        <div class="col-panel">
            <div class="col-panel-header">
                <span>Show / Hide Fields</span>
                <button type="button" @onclick="CloseFieldPanel">✕</button>
            </div>
            <div class="col-panel-actions">
                <button type="button" @onclick="SelectAll">Select All</button>
                <button type="button" @onclick="SelectNone">Clear All</button>
                <button type="button" disabled="@_isSavingFields" @onclick="SaveFieldLayout">
                    @(_isSavingFields ? "..." : "Save")
                </button>
            </div>
            <div class="col-panel-list">
                @foreach (var key in Visible.Keys.ToList())
                {
                    var capturedKey = key;
                    <label class="col-toggle-row">
                        <input type="checkbox"
                               checked="@Visible[capturedKey]"
                               @onchange="e => OnFieldVisibilityChanged(capturedKey, (bool)e.Value!)" />
                        <span>@Labels[capturedKey]</span>
                    </label>
                }
            </div>
        </div>
    }

    @if (IsLoading)
    {
        <div class="loading-overlay"><span>⏳ Lsdoading LR data...</span></div>
    }
    else
    {
        <div class="lr-form-scroll">
            <EditForm Model="@model" OnValidSubmit="@Save">
                <DataAnnotationsValidator />
                <ValidationSummary class="validation-summary-errors" />
                <div class="lr-card">
                    
                    <div class="lr-card-body">
                        <div class="field-grid-header">
                            
                            @if (Visible["LrNo"] || Visible["LrDate"])
                            {
                                
                                    @if (Visible["LrNo"])
                                    {
                                        
                                               
                                        <div class="field-inline">
                                                                    <label>LR No</label>
                                                <DxTextBox @bind-Text="model.LrNoStr" />

                                    </div>
                                  
                                    }
                                    @if (Visible["LrDate"])
                                    {


                                    <div class="field-inline">
                                                                    <label>LR Date </label>
                                                <DxDateEdit @bind-Date="model.LrDate" Format="dd-MM-yyyy" />

                                           
                                        </div>
                                    }
                          }
                          
                            <div class="field-inline">
                                                                    <label>Vehicle NO </label>
                                <DxComboBox Data="@vehiclelist" TData="Vehicle" TValue="int?"
                                            TextFieldName="VehicleNo" ValueFieldName="VehicleId"
                                            Value="@model.LrVehicleId" ValueChanged="@((int? val)=>OnVehicleChanged(val))"
                                            ValueExpression="() => model.LrVehicleId"
                                            NullText="Select Vehicle"
                                            AllowUserInput="true"
                                            SearchMode="ListSearchMode.AutoSearch"
                                            SearchFilterCondition="ListSearchFilterCondition.Contains" />
                                  </div>
