    protected override async Task OnInitializedAsync()
    {
        InitializeAllGridColumns();

        await LoadCoreFieldLayoutAsync();

        var notifyTask   = NotifyService.GetAllAsync();
        var locationTask = LocationService.GetAllAsync();
        var accountTask  = AccountService.GetAllAsync();
        var payTypeTask  = PayTypeService.GetAllAsync();
        var cargoTask    = CargoService.GetAllAsync();
        var vehicleTask  = VehicleService.GetAllAsync();
        await Task.WhenAll(notifyTask, locationTask, accountTask, payTypeTask, cargoTask, vehicleTask);

        notifylist          = notifyTask.Result;
        paytypeList         = payTypeTask.Result;
        ProductList         = cargoTask.Result;
        LocationList        = locationTask.Result;
        StationLocationList = LocationList.Where(x => x.LocationType == "STATION").ToList();
        accountlist         = accountTask.Result;
        accountSupplierlist = accountlist.Where(x => x.AccountTypeId == 14).ToList();
        accountpartylist    = accountlist.Where(x => x.AccountTypeId == 18).ToList();
        DriverList          = accountlist.Where(x => x.AccountTypeId == 16).ToList();
        PumpList            = accountlist.Where(x => x.AccountTypeId == 12).ToList();
        ChargesList         = accountlist.Where(x => x.AccountTypeId == 20).ToList();
        ExpenseAccountList  = accountlist.Where(x => x.AccountTypeId == 19).ToList();
        BankCashList        = accountlist.Where(x => x.AccountTypeId == 10 || x.AccountTypeId == 11).ToList();
        vehiclelist         = vehicleTask.Result;

        model.LrBillTypeBill = "Rate X Weight";
        model.LrBillTypeTruck = "Rate X Weight";
        model.LrPaymentType = "To be Billed";
        model.LrShortAllowType = "%";
        if (IsEditMode) await LoadLrForEdit(LrId!.Value);
    }

