    private async Task LoadCoreFieldLayoutAsync()
    {
        try
        {
            var saved = await GridLayoutService.GetLayoutAsync("LrCoreFields");
            if (saved != null && saved.Any())
                foreach (var col in saved)
                    if (Visible.ContainsKey(col.FieldName))
                        Visible[col.FieldName] = col.Visible;
        }
        catch { }
    }

    private void OnFieldVisibilityChanged(string key, bool value) { Visible[key] = value; StateHasChanged(); }

    private List<GridColumnLayout> BuildCoreFieldColumns() =>
        CoreFieldKeys.Select((key, i) => new GridColumnLayout
        {
            FieldName    = key,
            Caption      = Labels.TryGetValue(key, out var lbl) ? lbl : key,
            Visible      = Visible.TryGetValue(key, out var vis) && vis,
            Width        = 100,
            DisplayIndex = i
        }).ToList();

    private async Task SaveFieldLayout()
    {
        _isSavingFields = true; StateHasChanged();
        try
        {
            var ok = await GridLayoutService.SaveLayoutAsync("LrCoreFields", BuildCoreFieldColumns());
            ToastService.Success(ok ? "Field visibility saved." : "Save failed.");
        }
        catch (Exception ex) { ToastService.Error($"Save error: {ex.Message}"); }
        finally { _isSavingFields = false; showPanel = false; StateHasChanged(); }
    }

    private void CloseFieldPanel() => showPanel = false;

    private void HandleCoreFieldLayoutChanged(List<GridColumnLayout> cols)
    {
        CoreFieldColumns = cols;
        foreach (var col in cols)
            if (Visible.ContainsKey(col.FieldName))
                Visible[col.FieldName] = col.Visible;
        StateHasChanged();
    }

