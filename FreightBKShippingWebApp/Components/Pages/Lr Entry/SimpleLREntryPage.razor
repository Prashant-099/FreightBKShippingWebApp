@code {
    // ══ Commission sync flags ════════════════════════════════════════════
    private bool _isBillCommPctSource = false;
    private bool _isBillCommAmtSource = false;
    private bool _isTruckCommPctSource = false;
    private bool _isTruckCommAmtSource = false;

    private bool shortallowperVisible = true;

    private void OnPartyDetdayChanged(double value)
    {
        model.LrDetentionDayBill = value;
        model.LrDetentionAmtBill = model.LrDetentionDayBill * model.LrDetentionRateBill;
        RecalcAll();


    }
    private void OnPartyDetrateChanged(double value)
    {
        model.LrDetentionRateBill = value;
        model.LrDetentionAmtBill = model.LrDetentionDayBill * model.LrDetentionRateBill;
        RecalcAll();


    }
    private void OnSupplierDetdayChanged(double value)
    {
        model.LrDetentionDayTruck = value;
        model.LrDetentionAmtTruck = model.LrDetentionDayTruck * model.LrDetentionRateTruck;
        RecalcAll();


    }
    private void OnSupplierDetrateChanged(double value)
    {
        model.LrDetentionRateTruck = value;
        model.LrDetentionAmtTruck = model.LrDetentionDayTruck * model.LrDetentionRateTruck;
        RecalcAll();


    }
    private void OnShortTypeChanged(string ShortType)
    {
        model.LrShortAllowType = ShortType;

        shortallowperVisible = ShortType == "%";

        // Reset values when switching types
        model.LrShortPerBill = 0;
        model.LrShortPerTruck = 0;
        model.LrShortAllowBill = 0;
        model.LrShortAllowTruck = 0;

        RecalcShortage();
    }
    private void OnPartyShortDedrateChanged(double shortrate)
    {
        model.LrShortRateBill = shortrate;
        RecalcAll();


    }
    private void OnsupplierShortDedrateChanged(double shortrate)
    {
        model.LrShortRateTruck = shortrate;
        RecalcAll();

    }
    private void OnSupplierShortADedrateChanged(double Allowper)
    {
        model.LrShortPerBill = Allowper;
        RecalcAll();

    }
    private void OnPartyShortAllowPerChanged(double Allowper)
    {
        model.LrShortPerBill=Allowper;
        RecalcAll();

    }
    private void OnPartyShortAllowWtChanged(double AllowWt)
    { 
        model.LrShortAllowBill=AllowWt;
        RecalcAll();
    }
    private void OnSupplierShortAllowPerChanged(float Allowper)
    {
        model.LrShortPerTruck = Allowper;
        RecalcAll();
    }
    private void OnSupplierShortAllowWtChanged(float AllowWt)
    {
        model.LrShortAllowTruck = AllowWt;
        RecalcAll();

    }
    // ══ Weight Change Handlers ════════════════════════════════════════════

    private void OnGrossWtChanged(double? grossWt)
    {
        model.LrGrossWt = grossWt;
        if (grossWt.HasValue && grossWt.Value > 0)
            model.LrLoadWt = Math.Max(0, grossWt.Value - (model.LrTareWt ?? 0));
        RecalcAll();
    }

    private void OnTareWtChanged(double? tareWt)
    {
        model.LrTareWt = tareWt;
        if (model.LrGrossWt.HasValue && model.LrGrossWt.Value > 0)
            model.LrLoadWt = Math.Max(0, model.LrGrossWt.Value - (tareWt ?? 0));
        RecalcAll();
    }

    private void OnloadWtChanged(double loadWt)
    {
        model.LrLoadWt = loadWt;
        RecalcAll();
    }

    private void OnUnloadWtChanged(double unloadWt)
    {
        model.LrUnloadWt = unloadWt;
        RecalcAll();
    }

    // ══ Billing Type Handlers ════════════════════════════════════════════

    private void OnBillTypeChanged(string billType)
    {
        model.LrBillTypeBill = billType;
        RecalcAll();
        StateHasChanged();
    }

    private void OnPayTypeChanged(string payType)
    {
        model.LrBillTypeTruck = payType;
        RecalcAll();
        StateHasChanged();
    }

    // ══ Rate Change Handlers ════════════════════════════════════════════

    private void OnBillRateChanged(double rate)
    {
        model.LrRateBill = rate;
        RecalcAll();
    }
    private void OnBillChargeWtChanged(double value)
    {
        model.LrChargeQty = value;
        RecalcAll();
    }
    private void OnTruckRateChanged(double rate)
    {
        model.LrBillRateTruck = rate;
        RecalcAll();
    }

    // ══ Commission: Customer ════════════════════════════════════════════

    private void OnBillCommPctChanged(float pct)
    {
        _isBillCommPctSource = true;
        _isBillCommAmtSource = false;
        model.LrCommPerBill = (float)(pct);

        if (model.LrGrossFreightBill != 0)
            model.LrCommAmtBill = (float)(Math.Round(model.LrGrossFreightBill * pct / 100.0, 2));
        else
            model.LrCommAmtBill = 0;

        RecalcAll();
        _isBillCommPctSource = false;
    }

    private void OnBillCommAmtChanged(float amt)
    {
        _isBillCommAmtSource = true;
        _isBillCommPctSource = false;
        model.LrCommAmtBill = (float)(amt) ;

        if ( model.LrGrossFreightBill != 0)
            model.LrCommPerBill = (float)(Math.Round(amt / model.LrGrossFreightBill * 100.0, 4));
        else
            model.LrCommPerBill = 0f;

        RecalcCustomerNet();
        _isBillCommAmtSource = false;
    }

    // ══ Commission: Supplier ════════════════════════════════════════════

    private void OnTruckCommPctChanged(float pct)
    {
        _isTruckCommPctSource = true;
        _isTruckCommAmtSource = false;
        model.LrCommPerTruck = pct;

        if (model.LrGrossFreightTruck != 0)
            model.LrCommAmtTruck = (float)(Math.Round(model.LrGrossFreightTruck * pct / 100.0, 2));
        else
            model.LrCommAmtTruck = 0;

        RecalcSupplierNet();
        _isTruckCommPctSource = false;
    }

    private void OnTruckCommAmtChanged(float amt)
    {
        _isTruckCommAmtSource = true;
        _isTruckCommPctSource = false;
        model.LrCommAmtTruck = (float)(amt);

        if ( model.LrGrossFreightTruck != 0)
            model.LrCommPerTruck = (float)(Math.Round(amt / model.LrGrossFreightTruck * 100.0, 4));
        else
            model.LrCommPerTruck = 0f;

        RecalcSupplierNet();
        _isTruckCommAmtSource = false;
    }

    // ══ Freight Calculation Core ════════════════════════════════════════

    private double CalcGrossFreight(double rate, string? billType, double loadWt, double unloadWt, double chargeWt)
    {
        return billType switch
        {
            "Fixed Rate" => rate,
            "Rate X Weight" => rate * loadWt,
            "Rate X KM" => rate,
            "Rate X UnloadWt" => rate * unloadWt,
            "Rate X ChargeWt" => rate * chargeWt,
            _ => rate * loadWt
        };
    }

    private void RecalcCustomerFreight()
    {
        model.LrGrossFreightBill = CalcGrossFreight(
            model.LrRateBill,
            model.LrBillTypeBill,
            model.LrLoadWt,
            model.LrUnloadWt,
            model.LrChargeQty);

        // Recompute commission with existing % (rate-change recalc)
        if ( model.LrCommPerBill > 0)
        {
            model.LrCommAmtBill = (float)(Math.Round(model.LrGrossFreightBill * model.LrCommPerBill / 100.0, 2));
        }
        else if (model.LrCommAmtBill > 0 && model.LrGrossFreightBill > 0)
        {
            model.LrCommPerBill = (float)(Math.Round(model.LrCommAmtBill / model.LrGrossFreightBill * 100.0, 4));
        }

        RecalcCustomerNet();
    }

    private void RecalcSupplierFreight()
    {
        model.LrGrossFreightTruck = CalcGrossFreight(
            model.LrBillRateTruck,
            model.LrBillTypeTruck,
            model.LrLoadWt,
            model.LrUnloadWt,
            model.LrChargeQty);

        if ( model.LrCommPerTruck > 0)
        {
            model.LrCommAmtTruck = (float)(Math.Round(model.LrGrossFreightTruck * model.LrCommPerTruck / 100.0, 2));
        }
        else if (model.LrCommAmtTruck > 0 && model.LrGrossFreightTruck > 0)
        {
            model.LrCommPerTruck = (float)(Math.Round(model.LrCommAmtTruck / model.LrGrossFreightTruck * 100.0, 4));
        }

        RecalcSupplierNet();
    }

    private void RecalcCustomerNet()
    {
        model.LrNetFreightBill =
       model.LrGrossFreightBill
       - model.LrCommAmtBill
       - model.LrShortNetBill+model.LrDetentionAmtBill;

        StateHasChanged();
    }

    private void RecalcSupplierNet()
    {
        model.LrNetFreightTruck =
        model.LrGrossFreightTruck
        - model.LrCommAmtTruck
        - model.LrShortNetTruck +model.LrDetentionAmtTruck;

        StateHasChanged();
    }

    // ══ Shortage Calculation ════════════════════════════════════════════

    private void RecalcShortage()
    {
        // // Short Wt in kg (weights are in MT → *1000)
        // double loadKg = model.LrLoadWt * 1000.0;
        // double unloadKg = model.LrUnloadWt * 1000.0;
        // model.LrShortWt =(loadKg - unloadKg);
        // if( model.LrShortWt >0){
        //     // Party (Bill)
        //     double allowBill = loadKg * ((model.LrShortPerBill) / 100.0);
        //     model.LrShortAllowBill = allowBill;
        //     model.LrShortAmtBill = Math.Max(0, model.LrShortWt - allowBill);   // net short kg
        //     model.LrShortNetBill = (float)(Math.Round(model.LrShortAmtBill * (model.LrShortRateBill) ));

        //     // Supplier (Truck)
        //     double allowTruck = loadKg * ((model.LrShortPerTruck ) / 100.0);
        //     model.LrShortAllowTruck = (float)(allowTruck);
        //     model.LrShortAmtTruck = Math.Max(0, model.LrShortWt - allowTruck); // net short kg
        //     model.LrShortNetTruck = (float)(Math.Round(model.LrShortAmtTruck * (model.LrShortRateTruck)) );
        // }
        // else
        // {
        //     // Party (Bill)
        //     model.LrShortAllowBill=0;
        //      model.LrShortAmtBill=0;
        //     model.LrShortNetBill = 0;

        //     // Supplier (Truck)
        //      model.LrShortAllowTruck=0;
        //       model.LrShortAmtTruck=0;
        //     model.LrShortNetTruck = 0;
        // }

        // Convert MT to KG
        double loadKg = (model.LrLoadWt ) * 1000.0;
        double unloadKg = (model.LrUnloadWt ) * 1000.0;

        // Short weight (never negative)
        model.LrShortWt = Math.Max(0, loadKg - unloadKg);

        // ===================== PARTY (BILL) =====================
        double allowBillKg;

        if (model.LrShortAllowType == "%")
        {
            allowBillKg = loadKg * (model.LrShortPerBill / 100.0);
            model.LrShortAllowBill = Math.Round(allowBillKg, 2);
        }
        else // Fixed
        {
            allowBillKg = model.LrShortAllowBill;
        }

        model.LrShortAmtBill = Math.Max(0, model.LrShortWt - allowBillKg);
        model.LrShortNetBill = (float)Math.Round(
            model.LrShortAmtBill * model.LrShortRateBill, 2);

        // ===================== SUPPLIER (TRUCK) =====================
        double allowTruckKg;

        if (model.LrShortAllowType == "%")
        {
            allowTruckKg = loadKg * (model.LrShortPerTruck / 100.0);
            model.LrShortAllowTruck = (float)Math.Round(allowTruckKg, 2);
        }
        else // Fixed
        {
            allowTruckKg = model.LrShortAllowTruck;
        }

        model.LrShortAmtTruck = Math.Max(0, model.LrShortWt - allowTruckKg);
        model.LrShortNetTruck = (float)Math.Round(
            model.LrShortAmtTruck * model.LrShortRateTruck, 2);

        // Recalculate final net freight after shortage
        RecalcCustomerNet();
        RecalcSupplierNet();
    }

    // ══ Master Recalc (call on any weight/type change) ════════════════════

    private void RecalcAll()
    {
        RecalcCustomerFreight();
        RecalcSupplierFreight();
        RecalcShortage();
        StateHasChanged();
    }


