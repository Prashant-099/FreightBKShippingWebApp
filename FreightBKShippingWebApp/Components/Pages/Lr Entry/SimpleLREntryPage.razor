    public class PendingUploadFile { public string FileName{get;set;}=""; public byte[] Content{get;set;}=Array.Empty<byte>(); }
    private List<PendingUploadFile> PendingFiles = new();
    private List<UploadedFileInfo>  UploadedDocs = new();

    private void OpenUploadPopup()
    {
        SelectedCategory="LR"; SelectedSubCategory=model.LrNoStr;
        SelectedReferenceId=model.LrId.ToString(); IsUploadPopupVisible=true;
    }

    private async Task HandleSelectedFiles(List<IBrowserFile> files)
    {
        PendingFiles.Clear();
        foreach (var file in files)
        {
            using var ms = new MemoryStream();
            await file.OpenReadStream(10*1024*1024).CopyToAsync(ms);
            PendingFiles.Add(new PendingUploadFile { FileName=file.Name, Content=ms.ToArray() });
        }
        ToastService.Success($"{PendingFiles.Count} file(s) ready to upload.");
    }

    private async Task LoadDocumentsAsync()
    {
        if (string.IsNullOrEmpty(model.LrNoStr)) return;
        var docs = await FileUploadService.GetDocumentsAsync("LR", model.LrId.ToString());
        UploadedDocs = docs.Select(d => new UploadedFileInfo
        {
            DocumentId=d.DocumentId, FileName=d.OriginalFileName,
            FileSize=d.FileSizeBytes, Url=d.BlobUrl, Category=d.Category,
        }).ToList();
        StateHasChanged();
    }

    private async Task DeleteDoc(UploadedFileInfo file)
    {
        bool ok = await JS.InvokeAsync<bool>("confirm", $"Delete {file.FileName}?");
        if (!ok) return;
        if (await FileUploadService.DeleteDocumentAsync(file.DocumentId))
            await LoadDocumentsAsync();
    }

    private async Task PreviewDoc(UploadedFileInfo file)
    {
        if (uploadPopup != null) await uploadPopup.OpenPreview(file);
    }

    // ══ Save ═════════════════════════════════════════════════════════
    private async Task Save()
    {
        try
        {
            model.LrYearId = YearStatechangeService.SelectedYearId;
            var savedLr = await LrApiService.SaveAsync(model, null, null);
            if (savedLr == null) { ToastService.Error("Failed to save LR."); return; }

            model.LrId = savedLr.LrId;

            if (PendingFiles.Any())
            {
                foreach (var file in PendingFiles)
                    await FileUploadService.UploadFileAsync(file.Content, file.FileName, "LR", model.LrNoStr??"", model.LrId.ToString());
                PendingFiles.Clear();
            }

            await LoadDocumentsAsync();
            ToastService.Success(IsEditMode ? "LR updated successfully." : "LR saved successfully.");
            AuditLogService.NotifyAuditChanged();

            if (!IsEditMode)
                NavManager.NavigateTo($"/lrentry/{model.LrId}", replace: true);
        }
        catch (Exception ex) { ToastService.Error($"Save failed: {ex.Message}"); }
    }

    

