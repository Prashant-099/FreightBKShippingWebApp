    private void ApplyNotify(int? notifyId, Action<string> setAddress, Action<string?> setGst, Action<string?> setState)
    {
        var n = notifylist.FirstOrDefault(x => x.NotifyId == notifyId);
        setAddress(n is null ? string.Empty : $"{n.NotifyAddress1} {n.NotifyAddress2} {n.NotifyAddress3}".Trim());
        setGst(n?.GstNo);
        setState(n?.NotifyState);
    }





