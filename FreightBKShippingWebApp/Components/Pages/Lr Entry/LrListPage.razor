                    var html = BuildJournalTooltip("Diesel", "⛽", lr.DieselRows, lr.LrDieselTotal);
                }
                <span class="amt-badge orange"
                      @onmouseenter="@(e => ShowTT(e, html))"
                      @onmouseleave="HideTT">
                    <span class="dot"></span>@lr.LrDieselTotal.ToString("N2")
                </span>
            </CellDisplayTemplate>

        </DxGridDataColumn>

        <!-- ✅ Charges — account-wise breakdown -->
        <DxGridDataColumn FieldName="LrChargesTotal" Caption="Charges"
                          Width="@(layoutManager?.GetColumnWidth("LrChargesTotal") ?? "160px")"
                          Visible="@(layoutManager?.GetColumnVisibility("LrChargesTotal") ?? true)">
            <CellDisplayTemplate Context="ctx">
                @{
                    var lr = (LrListVM)ctx.DataItem;
                    var html = BuildJournalTooltip("Charges", "📋", lr.ChargesRows, lr.LrChargesTotal);
                }
                <span class="amt-badge purple"
                      @onmouseenter="@(e => ShowTT(e, html))"
                      @onmouseleave="HideTT">
                    <span class="dot"></span>@lr.LrChargesTotal.ToString("N2")
                </span>
            </CellDisplayTemplate>
        </DxGridDataColumn>

        <!-- ✅ Expense — account-wise breakdown -->
        <DxGridDataColumn FieldName="LrExpenseTotal" Caption="Expense"
                          Width="@(layoutManager?.GetColumnWidth("LrExpenseTotal") ?? "160px")"
                          Visible="@(layoutManager?.GetColumnVisibility("LrExpenseTotal") ?? true)">
            <CellDisplayTemplate Context="ctx">
                @{
                    var lr = (LrListVM)ctx.DataItem;
                    var html = BuildJournalTooltip("Expenses", "💸", lr.ExpenseRows, lr.LrExpenseTotal);
                }
                <span class="amt-badge red"
