                          Visible="@(layoutManager?.GetColumnVisibility("LrShortWt") ?? true)" />

        <DxGridDataColumn FieldName="LrBillTypeBill" Caption="Bill Type"
                          Width="@(layoutManager?.GetColumnWidth("LrBillTypeBill") ?? "140px")"
                          Visible="@(layoutManager?.GetColumnVisibility("LrBillTypeBill") ?? true)" />

        <DxGridDataColumn FieldName="LrRateBill" Caption="Rate"
