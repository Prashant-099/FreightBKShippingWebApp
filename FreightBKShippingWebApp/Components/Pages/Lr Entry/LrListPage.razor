<style>
    /* ── Amount badges ─────────────────────────────────────────── */
    .amt-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 3px 10px;
        border-radius: 5px;
        font-weight: 700;
        font-size: 12.5px;
        cursor: default;
        user-select: none;
        letter-spacing: .01em;
        transition: filter .15s;
        white-space: nowrap;
        min-width: max-content;
        background: #eff6ff;
        color: #1d4ed8;
    }

        .amt-badge:hover {
            filter: brightness(.94);
        }

        .amt-badge.green {
            background: #dcfce7;
            color: #15803d;
        }

        .amt-badge.orange {
            background: #ffedd5;
            color: #c2410c;
        }

        .amt-badge.purple {
            background: #ede9fe;
            color: #6d28d9;
        }

        .amt-badge.red {
            background: #fee2e2;
            color: #b91c1c;
        }

        .amt-badge.teal {
            background: #ccfbf1;
            color: #0f766e;
        }

        .amt-badge .dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: currentColor;
            opacity: .6;
            flex-shrink: 0;
        }

    /* ── Grid cell overflow ─────────────────────────────────────── */
