    private static string E(string? s) => System.Web.HttpUtility.HtmlEncode(s ?? "");

    // ✅ Gross Freight — product-wise breakdown table + formula strip
    private string BuildGrossFreightTooltip(LrListVM lr)
    {
        double net = lr.LrNetFreightCalc;
        var sb = new System.Text.StringBuilder();
        sb.Append("<div class='tt-head'><span class='tt-icon'>📦</span>Gross Freight — Product Breakdown</div>");
        sb.Append("<div class='tt-body'>");
        sb.Append("<table><thead><tr>");
        sb.Append("<th>Product</th><th>Bill Type</th><th style='text-align:right;'>Rate</th><th style='text-align:right;'>Freight</th>");
        sb.Append("</tr></thead><tbody>");

        if (lr.Products.Any())
        {
            foreach (var p in lr.Products)
            {
                sb.Append("<tr>");
                sb.Append($"<td class='tt-name'>{E(p.ProductName)}</td>");
                sb.Append($"<td class='tt-sub'>{E(p.BillType)}</td>");
                sb.Append($"<td class='tt-mid'>₹ {p.Rate:N2}</td>");
                sb.Append($"<td class='tt-amt'>₹ {p.GrossFreight:N2}</td>");
                sb.Append("</tr>");
            }
        }
        else
        {
            sb.Append("<tr><td colspan='4' class='tt-empty'>No product rows</td></tr>");
        }

        sb.Append("</tbody></table></div>");
        sb.Append($"<div class='tt-total'><span class='tt-total-label'>Total Gross Freight</span><span class='tt-total-amt'>₹ {lr.LrGrossFreightBill:N2}</span></div>");

        // Formula strip
        sb.Append("<div class='tt-formula'>");
        sb.Append($"<span class='tf-item tf-gross'>₹ {lr.LrGrossFreightBill:N2}</span>");
        sb.Append($"<span class='tf-op tf-plus-op'>+</span><span class='tf-item tf-plus'>Charges ₹ {lr.LrChargesTotal:N2}</span>");
        sb.Append($"<span class='tf-op tf-minus-op'>−</span><span class='tf-item tf-minus'>Advance ₹ {lr.LrAdvanceTotal:N2}</span>");
        sb.Append($"<span class='tf-op tf-minus-op'>−</span><span class='tf-item tf-minus'>Diesel ₹ {lr.LrDieselTotal:N2}</span>");
        sb.Append($"<span class='tf-op tf-minus-op'>−</span><span class='tf-item tf-minus'>Expense ₹ {lr.LrExpenseTotal:N2}</span>");
        sb.Append($"<span class='tf-eq'>=</span><span class='tf-item {(net < 0 ? "tf-neg" : "tf-net")}'>Net ₹ {net:N2}</span>");
        sb.Append("</div>");
        return sb.ToString();
    }

