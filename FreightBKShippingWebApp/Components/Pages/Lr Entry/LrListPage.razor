    /* ── Tooltip ────────────────────────────────────────────────── */
    #lr-tt {
        display: none;
        position: fixed;
        z-index: 2147483647;
        background: #0f172a;
        border: 1px solid #1e3a5f;
        color: #e2e8f0;
        border-radius: 10px;
        padding: 0;
        font-family: 'Segoe UI', system-ui, sans-serif;
        font-size: 12.5px;
        line-height: 1.5;
        box-shadow: 0 12px 40px rgba(0,0,0,.55), 0 2px 8px rgba(0,0,0,.3);
        pointer-events: none;
        min-width: 320px;
        max-width: 560px;
        overflow: hidden;
    }

        #lr-tt.visible {
            display: block;
        }

        #lr-tt::before {
            content: "";
            position: absolute;
            bottom: -7px;
            left: 50%;
            transform: translateX(-50%);
            border: 7px solid transparent;
            border-top-color: #1e3a5f;
            border-bottom: none;
        }

        #lr-tt::after {
            content: "";
            position: absolute;
            bottom: -6px;
            left: 50%;
            transform: translateX(-50%);
            border: 6px solid transparent;
            border-top-color: #0f172a;
            border-bottom: none;
        }

        #lr-tt .tt-head {
            padding: 8px 14px 7px;
            background: #1e3a5f;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: .07em;
            text-transform: uppercase;
            color: #7dd3fc;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        #lr-tt .tt-icon {
            width: 18px;
            height: 18px;
            background: #38bdf8;
            border-radius: 3px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 10px;
            color: #0f172a;
            font-weight: 900;
        }

        #lr-tt table {
            width: 100%;
            border-collapse: collapse;
        }

        #lr-tt .tt-body {
            padding: 8px 14px 4px;
        }

        #lr-tt thead tr th {
            font-size: 10.5px;
            font-weight: 600;
            color: #475569;
            text-transform: uppercase;
            letter-spacing: .06em;
            padding: 4px 6px 5px 0;
            border-bottom: 1px solid #1e293b;
            white-space: nowrap;
        }

            #lr-tt thead tr th:last-child {
                text-align: right;
            }

        #lr-tt tbody tr td {
            padding: 5px 6px 5px 0;
            vertical-align: middle;
            border-bottom: 1px solid #0f1e30;
            white-space: nowrap;
        }

        #lr-tt tbody tr:last-child td {
            border-bottom: none;
        }

        #lr-tt .tt-name {
            color: #cbd5e1;
            max-width: 260px;
            overflow: hidden;
            text-overflow: ellipsis;
            font-size: 12px;
        }

        #lr-tt .tt-sub {
            color: #64748b;
            font-size: 11px;
        }

        #lr-tt .tt-mid {
            color: #64748b;
            font-size: 11.5px;
            text-align: center;
            padding: 4px 10px;
        }

        #lr-tt .tt-amt {
            text-align: right;
            font-weight: 700;
            color: #38bdf8;
            font-variant-numeric: tabular-nums;
            padding-left: 16px;
            font-size: 12.5px;
        }

        #lr-tt .tt-amt-neg {
            color: #f87171 !important;
        }

        #lr-tt .tt-total {
            margin: 0 14px 10px;
            padding: 6px 10px;
            background: #1e293b;
            border-radius: 6px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            #lr-tt .tt-total .tt-total-label {
                font-size: 11px;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: .06em;
                color: #64748b;
            }

            #lr-tt .tt-total .tt-total-amt {
                font-size: 14px;
                font-weight: 800;
                color: #fbbf24;
                font-variant-numeric: tabular-nums;
            }

        #lr-tt .tt-empty {
            padding: 10px 14px 14px;
            color: #475569;
            font-size: 12px;
            text-align: center;
        }

        #lr-tt .tt-divider {
            height: 1px;
            background: #1e293b;
            margin: 0 14px;
        }

        #lr-tt .tt-formula {
            background: #0a1628;
            border-top: 1px solid #1e293b;
            padding: 8px 14px 10px;
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 4px 2px;
            font-size: 11px;
        }

        #lr-tt .tf-item {
            padding: 2px 7px;
            border-radius: 4px;
            font-weight: 600;
            white-space: nowrap;
        }

        #lr-tt .tf-gross {
            background: #1e3a5f;
            color: #7dd3fc;
        }

        #lr-tt .tf-plus {
            background: #14532d;
            color: #86efac;
        }

        #lr-tt .tf-minus {
            background: #450a0a;
            color: #fca5a5;
        }

        #lr-tt .tf-net {
            background: #134e4a;
            color: #5eead4;
            font-size: 12px;
            font-weight: 800;
        }

        #lr-tt .tf-neg {
            background: #450a0a;
            color: #f87171;
            font-size: 12px;
            font-weight: 800;
        }

        #lr-tt .tf-op {
            color: #64748b;
            font-weight: 700;
            font-size: 13px;
            padding: 0 1px;
        }

        #lr-tt .tf-plus-op {
            color: #86efac;
        }

        #lr-tt .tf-minus-op {
            color: #fca5a5;
        }

        #lr-tt .tf-eq {
            color: #fbbf24;
            font-weight: 900;
            font-size: 14px;
            padding: 0 3px;
        }
        /* row stripe */
        #lr-tt tbody tr:nth-child(odd) td {
            background: rgba(255,255,255,.02);
        }

        #lr-tt tbody tr:nth-child(even) td {
            background: transparent;
        }
</style>

<div id="lr-tt"></div>

<DxGrid TItem="LrListVM"
        Data="@LrList"
        @ref="MyGrid"
        KeyFieldName="LrId"
        ShowSearchBox="true"
        PageSize="10"
        PageSizeSelectorVisible="true"
        ShowGroupPanel="true"
        FilterMenuButtonDisplayMode="GridFilterMenuButtonDisplayMode.Always"
        FocusedRowEnabled="true"
        SelectionMode="GridSelectionMode.Multiple"
        SelectedDataItems="@SelectedLrs"
        SelectedDataItemsChanged="OnSelectedLrsChanged"
        ColumnResizeMode="GridColumnResizeMode.NextColumn"
        CssClass="grid-size"
        AllowSelectRowByClick="true">

    <ToolbarTemplate>
        <DxToolbar>
            <Items>
                <DxToolbarItem Text="Add" IconCssClass="bi bi-plus-circle" Click="OnCreateNew" />
                <DxToolbarItem Text="Edit" IconCssClass="bi bi-pencil-square" Click="OnEdit"
                               Enabled="@(SelectedLrs?.Count == 1)" />
                <DxToolbarItem Text="Delete" IconCssClass="bi bi-trash" Click="OnDelete"
                               Enabled="@(SelectedLrs?.Any() == true)" />
                <DxToolbarItem Text="Refresh" IconCssClass="bi bi-arrow-clockwise" Click="LoadDataAsync" />
                 <DxToolbarItem Context="cfdr"
                               Text="Print"
                               RenderStyleMode="ToolbarItemRenderStyleMode.Contained"
                               RenderStyle="ButtonRenderStyle.Secondary"
                               IconCssClass="bi bi-printer">
                    <Items>
                        <DxToolbarItem Text="Print PDF" IconCssClass="bi bi-printer" Click="@(async () => await PrintReports())" />
                        <DxToolbarItem Text="Print Preview" IconCssClass="bi bi-printer" Click="@((_) => ShowReportPopup())"></DxToolbarItem>
                    </Items>
                </DxToolbarItem>

                <DxToolbarItem Alignment="ToolbarItemAlignment.Right"
                               RenderStyle="ButtonRenderStyle.Secondary"
                               IconCssClass="bi bi-gear-wide-connected"
                               Click="ShowLayoutPopup" />
            </Items>
        </DxToolbar>
    </ToolbarTemplate>

    <Columns>
        <DxGridSelectionColumn Width="40" FixedPosition="GridColumnFixedPosition.Left" />

        <DxGridDataColumn FieldName="LrNoStr" Caption="LR No"
                          Width="@(layoutManager?.GetColumnWidth("LrNoStr") ?? "120px")"
                          Visible="@(layoutManager?.GetColumnVisibility("LrNoStr") ?? true)">
            <CellDisplayTemplate Context="ctx">
                @{
                    var lr = (LrListVM)ctx.DataItem;
                }
                <a href="javascript:void(0)"
                   style="color:#2563eb;font-weight:600;text-decoration:none;cursor:pointer;"
                   @onclick="@(() => NavigateToEdit(lr.LrId))">@lr.LrNoStr</a>
            </CellDisplayTemplate>
        </DxGridDataColumn>

        <DxGridDataColumn FieldName="LrDate" Caption="Date" DisplayFormat="dd-MM-yyyy"
                          Width="@(layoutManager?.GetColumnWidth("LrDate") ?? "110px")"
                          Visible="@(layoutManager?.GetColumnVisibility("LrDate") ?? true)" />

        <DxGridDataColumn FieldName="LrTripNo" Caption="Trip No"
                          Width="@(layoutManager?.GetColumnWidth("LrTripNo") ?? "90px")"
                          Visible="@(layoutManager?.GetColumnVisibility("LrTripNo") ?? true)" />

        <DxGridDataColumn FieldName="PartyName" Caption="Party"
                          Width="@(layoutManager?.GetColumnWidth("PartyName") ?? "200px")"
                          Visible="@(layoutManager?.GetColumnVisibility("PartyName") ?? true)" />

        <DxGridDataColumn FieldName="SupplierName" Caption="Supplier"
                          Width="@(layoutManager?.GetColumnWidth("SupplierName") ?? "200px")"
                          Visible="@(layoutManager?.GetColumnVisibility("SupplierName") ?? true)" />

        <DxGridDataColumn FieldName="VehicleNo" Caption="Vehicle"
                          Width="@(layoutManager?.GetColumnWidth("VehicleNo") ?? "140px")"
                          Visible="@(layoutManager?.GetColumnVisibility("VehicleNo") ?? true)">
            <CellDisplayTemplate Context="ctx">
                @{
                    var lr = (LrListVM)ctx.DataItem;
                }
                <span style="font-weight:600;color:#1e40af;font-size:12.5px;letter-spacing:.03em;">
                    @(string.IsNullOrEmpty(lr.VehicleNo) ? "—" : lr.VehicleNo)
