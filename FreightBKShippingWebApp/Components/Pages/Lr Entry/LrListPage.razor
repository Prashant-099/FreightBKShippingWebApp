    // ══ Data loading ══════════════════════════════════════════════════

    private async Task LoadDataAsync()
    {
        if (_accountNames.Count == 0)
        {
            var accounts = await AccountService.GetAllAsync();
            _accountNames = accounts.ToDictionary(a => a.AccountId, a => a.AccountName ?? "");
        }

        if (_vehicleNames.Count == 0)
        {
            var vehicles = await VehicleService.GetAllAsync();
            _vehicleNames = vehicles.ToDictionary(v => v.VehicleId, v => v.VehicleNo ?? "");
        }

        LrList = await LrService.GetListAsync();

        _productCache.Clear(); _advanceCache.Clear(); _dieselCache.Clear();
        _chargesCache.Clear(); _expenseCache.Clear(); _advRecCache.Clear();

        foreach (var lr in LrList)
        {
            try
            {
                var dto = await LrService.GetEntryAsync(lr.LrId);
                if (dto == null) continue;

                _productCache[lr.LrId] = (dto.Details ?? new())
                    .Where(d => d.LrDetailGrossFreight.HasValue && d.LrDetailGrossFreight != 0)
                    .Select(d => new ProductDetail
                    {
                        ProductName = d.LrDetailCargoName ?? $"Product {d.LrDetailProductId}",
                        Freight = d.LrDetailGrossFreight ?? 0
                    }).ToList();

                var j = dto.Journals ?? new();
                _advanceCache[lr.LrId] = MapJournalCache(j, "Advance");
                _chargesCache[lr.LrId] = MapJournalCache(j, "Charges");
                _expenseCache[lr.LrId] = MapJournalCache(j, "Expense");
                _dieselCache[lr.LrId] = MapDieselCache(j);
                _advRecCache[lr.LrId] = MapAdvRecCache(j);
            }
            catch { /* silently skip on error */ }
        }

        await InvokeAsync(StateHasChanged);
    }

    private List<JournalDetail> MapJournalCache(List<LRJournal> journals, string group) =>
        journals
            .Where(j => j.JournalGroup?.ToString() == group && j.Amount.HasValue && j.Amount != 0)
            .Select(j => new JournalDetail
            {
                AccountName = j.AccountId.HasValue && _accountNames.TryGetValue(j.AccountId.Value, out var n)
                                ? n : $"Account {j.AccountId}",
                Amount = j.Amount.HasValue ? Convert.ToDecimal(j.Amount) : 0
            }).ToList();

    private List<JournalDetail> MapDieselCache(List<LRJournal> journals) =>
        journals
            .Where(j => j.JournalGroup?.ToString() == "Diesel" && j.UreaAmount.HasValue && j.UreaAmount != 0)
            .Select(j => new JournalDetail
            {
                AccountName = j.PumpBillId.HasValue && _accountNames.TryGetValue(j.PumpBillId.Value, out var n)
                                ? n : $"Pump {j.PumpBillId}",
                Amount = j.UreaAmount.HasValue ? Convert.ToDecimal(j.UreaAmount) : 0,
                Qty = j.UreaQty.HasValue ? Convert.ToDecimal(j.UreaQty) : 0
            }).ToList();

    private List<JournalDetail> MapAdvRecCache(List<LRJournal> journals) =>
        journals
            .Where(j => j.JournalGroup?.ToString() == "AdvanceReceived" && j.Amount.HasValue && j.Amount != 0)
            .Select(j => new JournalDetail
            {
                AccountName = j.AccountId.HasValue && _accountNames.TryGetValue(j.AccountId.Value, out var n)
                                ? n : $"Account {j.AccountId}",
                Amount = j.Amount.HasValue ? Convert.ToDecimal(j.Amount) : 0,
                Qty = j.UreaQty.HasValue ? Convert.ToDecimal(j.UreaQty) : 0
            }).ToList();

    // ══ Selection / navigation / delete ═════════════════════════════

    private void OnSelectedLrsChanged(IReadOnlyList<object> items) => SelectedLrs = items;
    private void OnCreateNew() => NavManager.NavigateTo("/lrentry");
    private void OnEdit()
    {
        if (SelectedLrs?.Count == 1)
            NavigateToEdit(((LrListVM)SelectedLrs.First()).LrId);
    }
    private void NavigateToEdit(int lrId) => NavManager.NavigateTo($"/lrentry/{lrId}");

    private async Task ClearSelectionManual()
    {
        try { MyGrid?.ClearSelection(); SelectedLrs = new List<Lr>(); }
        catch (Exception ex) { Console.WriteLine($"Clear selection error: {ex.Message}"); }
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnDelete()
    {
        if (SelectedLrs == null || SelectedLrs.Count == 0)
        {
            ToastService.Warning("Please select at least one LR to delete.");
            return;
        }
        var selectedList = SelectedLrs.Cast<LrListVM>().ToList();
        var confirm = await ConfirmDialogService.ShowAsync(
            $"Are you sure you want to delete {SelectedLrs.Count} selected LR(s)?");
        if (!confirm) { await ClearSelectionManual(); return; }
        try
        {
            LoadingService.Show("Deleting...");
            int ok = 0, fail = 0;
            foreach (var lrs in selectedList)
            {
                if (await LrService.DeleteAsync(lrs.LrId)) { ok++; AuditLogService.NotifyAuditChanged(); }
                else fail++;
            }
            if (ok > 0) ToastService.Success($"{ok} LR(s) deleted successfully.");
            if (fail > 0) ToastService.Error($"{fail} LR(s) failed to delete.");
            await LoadDataAsync();
        }
        finally
        {
            LoadingService.Hide();
            await ClearSelectionManual();
        }
    }
