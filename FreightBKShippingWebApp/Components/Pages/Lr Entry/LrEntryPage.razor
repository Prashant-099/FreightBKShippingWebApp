    void AddJournalRow(List<LRJournalRowVM> list, LrJournalGroup group, LrJournalVchType vchType)
    {
        int next = list.Select(x => x.Sno).DefaultIfEmpty(0).Max() + 1;
        list.Add(new LRJournalRowVM
        {
            Sno = next,
            JournalDate = DateTime.Now,
            JournalGroup = group.ToString(),
            VchType = vchType.ToString()
        });
        StateHasChanged();
    }

    void DeleteJournalRow(List<LRJournalRowVM> list, LRJournalRowVM row)
    {
        list.Remove(row);
        RenumberJournal(list);
        StateHasChanged();
    }

