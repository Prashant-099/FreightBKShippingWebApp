        AdvanceRows         = CreateJournalRows(LrJournalGroup.Advance,         LrJournalVchType.Payment, 5);
        DieselRows          = CreateJournalRows(LrJournalGroup.Diesel,          LrJournalVchType.Payment, 5);
        ChargesRows         = CreateJournalRows(LrJournalGroup.Charges,         LrJournalVchType.Payment, 5);
        ExpenseRows         = CreateJournalRows(LrJournalGroup.Expense,         LrJournalVchType.Payment, 5);
        AdvanceReceivedRows = CreateJournalRows(LrJournalGroup.AdvanceReceived, LrJournalVchType.Receipt, 5);
    }

    private List<LrProductRow> CreateProductRows(int count = 5)
    {
        var list = new List<LrProductRow>();
        for (int i = 1; i <= count; i++)
            list.Add(new LrProductRow { SrNo = i });
        return list;
    }

    private List<LRJournalRowVM> CreateJournalRows(
        LrJournalGroup group, LrJournalVchType vchType, int count = 5)
    {
        var list = new List<LRJournalRowVM>();
        for (int i = 1; i <= count; i++)
            list.Add(new LRJournalRowVM
            {
                Sno          = i,
                JournalDate  = DateTime.Now,
                JournalGroup = group.ToString(),
                VchType      = vchType.ToString()
            });
        return list;
    }

    private void RenumberJournal(List<LRJournalRowVM> list)
    {
        for (int i = 0; i < list.Count; i++) list[i].Sno = i + 1;
    }
    private void RenumberProducts()
    {
        for (int i = 0; i < ProductRows.Count; i++) ProductRows[i].SrNo = i + 1;
    }

