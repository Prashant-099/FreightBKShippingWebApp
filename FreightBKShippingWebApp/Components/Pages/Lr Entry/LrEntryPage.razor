    private List<LRDetail> BuildDetails()
    {
        var details = new List<LRDetail>();
        int srNo = 1;
        foreach (var row in ProductRows)
        {
            if (row.ProductId == 0 &&
                string.IsNullOrWhiteSpace(row.NtUnit) &&
                row.GrossWt is null && row.TareWt is null)
                continue;

            details.Add(new LRDetail
            {
                LrDetailSrNo        = srNo++,
                LrDetailsLrId       = model.LrId,
                LrDetailProductId   = row.ProductId,
                LrDetailUnit        = row.NtUnit,
                LrDetailBillType    = row.LrBillTypeBill,
                LrDetailGrossWt     = row.GrossWt.HasValue   ? (decimal?)Convert.ToDecimal(row.GrossWt)   : null,
                LrDetailTareWt      = row.TareWt.HasValue    ? (decimal?)Convert.ToDecimal(row.TareWt)    : null,
                LrDetailNetWt       = row.NetWt,
                LrDetailLoadWt      = row.LoadWt.HasValue    ? (decimal?)Convert.ToDecimal(row.LoadWt)    : null,
                LrDetailUnloadWt    = row.UnLoadWt.HasValue  ? (decimal?)Convert.ToDecimal(row.UnLoadWt)  : null,
                LrDetailChargeQty   = row.ChargeQty.HasValue ? (decimal?)Convert.ToDecimal(row.ChargeQty) : null,
                LrDetailBillRate    = row.RateBill.HasValue  ? (decimal?)Convert.ToDecimal(row.RateBill)  : null,
                LrDetailGrossFreight= row.GrossFreight.HasValue ? (decimal?)Convert.ToDecimal(row.GrossFreight) : null,
                LrDetailTotalBags   = row.TotalBags.HasValue ? (int?)Convert.ToInt32(row.TotalBags)       : null,
                LrDetailCargoName   = row.ProductName,
                LrDetailInvoiceNo   = row.InvoiceNo,
            });
        }
        ApplyProductRowsToModel();
        return details;
    }

    private List<LRJournal> BuildJournals()
    {
        var journals = new List<LRJournal>();
        MapJournalGroup(journals, AdvanceRows);
        MapJournalGroup(journals, DieselRows);
        MapJournalGroup(journals, ChargesRows);
        MapJournalGroup(journals, ExpenseRows);
        MapJournalGroup(journals, AdvanceReceivedRows);
        return journals;
    }

    private void MapJournalGroup(List<LRJournal> target, List<LRJournalRowVM> rows)
    {
        foreach (var row in rows)
        {
            bool hasData = (row.AccountId.HasValue && row.AccountId > 0)
                        || (row.PumpBillId.HasValue && row.PumpBillId > 0)
                        || (row.Amount.HasValue && row.Amount != 0)
                        || (row.UreaAmount.HasValue && row.UreaAmount != 0);
            if (!hasData) continue;

            LrJournalGroup?  group = Enum.TryParse<LrJournalGroup>(row.JournalGroup,  out var g) ? g : (LrJournalGroup?)null;
            LrJournalVchType? vch  = Enum.TryParse<LrJournalVchType>(row.VchType,     out var v) ? v : (LrJournalVchType?)null;

            target.Add(new LRJournal
            {
                LrId         = model.LrId,
                Sno          = row.Sno,
                JournalDate  = row.JournalDate,
                AccountId    = row.AccountId,
                Amount       = (float)(row.Amount ?? 0),
                Remarks      = row.Remarks,
                JournalGroup = group,
                VchType      = vch,
                PumpBillId   = row.PumpBillId,
                UreaRate     = (double)(row.UreaRate ?? 0),
                UreaQty      = row.UreaQty.HasValue ? (float?)Convert.ToSingle(row.UreaQty) : null,
                UreaAmount   = (double)(row.UreaAmount ?? 0),
            });
        }
    }

