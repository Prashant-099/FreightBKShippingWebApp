<FileUploadpopup IsVisible="@IsUploadPopupVisible"
                 OnFilesSelected="HandleSelectedFiles"
                 @ref="uploadPopup"
                 IsVisibleChanged="@(v => IsUploadPopupVisible = v)"
                 DefaultCategory="@SelectedCategory"
                 DefaultSubCategory="@SelectedSubCategory"
                 DefaultReferenceId="@SelectedReferenceId" />

@code {

    // ══════════════════════════════════════════════════════════════════
    // COLUMN VISIBILITY
    // ══════════════════════════════════════════════════════════════════
    private Dictionary<string, bool> Visible = new()
    {
        ["LrNo"]         = true,
        ["LrDate"]       = true,
        ["Vehicle"]      = true,
        ["Supplier"]     = true,
        ["BillingParty"] = true,
        ["Consignor"]    = true,
        ["Consignee"]    = true,
        ["FromStation"]  = true,
        ["ToLocation"]   = true,
        ["PickupLoc"]    = true,
        ["BackLocation"] = true,
        ["Driver"]       = true,
        ["Container1"]   = true,
        ["Container2"]   = true,
        ["RefNo"]        = true,
        ["PaymentMode"]  = true,
        ["TripNo"]       = true,
    };

    private bool showPanel = false;

    private void SelectAll()  => Visible.Keys.ToList().ForEach(k => Visible[k] = true);
    private void SelectNone() => Visible.Keys.ToList().ForEach(k => Visible[k] = false);

    private Dictionary<string, string> Labels = new()
    {
        ["LrNo"]         = "LR No",
        ["LrDate"]       = "LR Date",
        ["Vehicle"]      = "Vehicle",
        ["Supplier"]     = "Supplier",
        ["BillingParty"] = "Billing Party",
        ["Consignor"]    = "From Party / Consignor",
        ["Consignee"]    = "To Party / Consignee",
        ["FromStation"]  = "From (Station)",
        ["ToLocation"]   = "To Location",
        ["PickupLoc"]    = "Pickup Location",
        ["BackLocation"] = "Back Location",
        ["Driver"]       = "Driver",
        ["Container1"]   = "Container No",
        ["Container2"]   = "Container No 2",
        ["RefNo"]        = "Reference No",
        ["PaymentMode"]  = "Payment Mode",
        ["TripNo"]       = "Trip No",
    };

    // ── Route Parameter ───────────────────────────────────────────────
    [Parameter] public int? LrId { get; set; }

    private bool IsEditMode => LrId.HasValue && LrId.Value > 0;
    private bool IsLoading = false;

    // ─────────────────────────────────────────────────────────────────
    // LrProductRow
    // ─────────────────────────────────────────────────────────────────
    public class LrProductRow
    {
        public int SrNo { get; set; }
        public string? ProductName { get; set; }
        public int ProductId { get; set; }
        public string? NtUnit { get; set; }
        public string? LrBillTypeBill { get; set; }
        public double? GrossWt { get; set; }
        public double? TareWt { get; set; }
        public decimal? NetWt { get; set; }
        public double? LoadWt { get; set; }
        public double? UnLoadWt { get; set; }
        public double? ChargeQty { get; set; }
        public double? RateBill { get; set; }
        public double? GrossFreight { get; set; }
        public decimal? NtQty { get; set; }
        public string? InvoiceNo { get; set; }
        public string? EwayBillNo { get; set; }
        public decimal? TotalBags { get; set; }
    }

    // ─────────────────────────────────────────────────────────────────
    // LRJournalRowVM
    // ─────────────────────────────────────────────────────────────────
    public class LRJournalRowVM
    {
        public Guid RowId { get; set; } = Guid.NewGuid();
        public int Sno { get; set; }
        public DateTime JournalDate { get; set; }
        public int? AccountId { get; set; }
        public decimal? Amount { get; set; }
        public string? Remarks { get; set; }
        public int? PumpBillId { get; set; }
        public decimal? UreaRate { get; set; }
        public decimal? UreaQty { get; set; }
        public decimal? UreaAmount { get; set; }
        public decimal? Rate { get; set; }
        public decimal? Qty { get; set; }
        public string? SlipNo { get; set; }
        public string? JournalGroup { get; set; }
        public string? VchType { get; set; }
    }

    // ── Model & Lists ─────────────────────────────────────────────────
    private Lr model = new();

    private List<Notify> notifylist = new();
    private List<Account> accountpartylist = new();
    private List<Account> accountSupplierlist = new();
    private List<Account> DriverList = new();
    private List<Location> LocationList = new();
    private List<Location> StationLocationList = new();
    private List<PayType> paytypeList = new();
    private List<Cargo> ProductList = new();
    private List<Account> PumpList = new();
    private List<Account> ChargesList = new();
    private List<Account> ExpenseAccountList = new();
    private List<Account> BankCashList = new();
    private List<Vehicle> vehiclelist = new();

    public class BillTypeVM { public string Name { get; set; } = ""; }
    private List<BillTypeVM> BillTypeList = new()
    {
        new BillTypeVM { Name = "Fixed Rate" },
        new BillTypeVM { Name = "Rate X Weight" },
        new BillTypeVM { Name = "Rate X KM" },
        new BillTypeVM { Name = "Rate X UnloadWt" },
        new BillTypeVM { Name = "Rate X ChargeWt" }
    };

    public class SelectItem
    {
        public string Text { get; set; } = "";
        public string Value { get; set; } = "";
    }
    private readonly List<SelectItem> PaymethodList = new()
    {
        new SelectItem { Text = "To be Billed", Value = "To be Billed" },
        new SelectItem { Text = "To Pay",        Value = "To Pay"        },
        new SelectItem { Text = "Paid",          Value = "Paid"          },
    };

    // ── Init ──────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        InitializeAllGridRows();

        var notifyTask    = NotifyService.GetAllAsync();
        var locationTask  = LocationService.GetAllAsync();
        var accountTask   = AccountService.GetAllAsync();
        var payTypeTask   = PayTypeService.GetAllAsync();
        var cargoTask     = CargoService.GetAllAsync();
        var vehicleTask   = VehicleService.GetAllAsync();
        await Task.WhenAll(notifyTask, locationTask, accountTask, payTypeTask, cargoTask,vehicleTask);

        notifylist           = notifyTask.Result;
        paytypeList          = payTypeTask.Result;
        ProductList          = cargoTask.Result;
        LocationList         = locationTask.Result;
        StationLocationList  = LocationList.Where(x => x.LocationType == "STATION").ToList();
        accountpartylist     = accountTask.Result;
        accountSupplierlist  = accountpartylist.Where(x => x.AccountTypeId == 14).ToList();
        accountpartylist  = accountpartylist.Where(x => x.AccountTypeId == 18).ToList();
        DriverList           = accountpartylist.Where(x => x.AccountTypeId == 16).ToList();
        PumpList             = accountpartylist.Where(x => x.AccountTypeId == 12).ToList();
        ChargesList          = accountpartylist.Where(x => x.AccountTypeId == 20).ToList();
        ExpenseAccountList   = accountpartylist.Where(x => x.AccountTypeId == 19).ToList();
        BankCashList         = accountpartylist
            .Where(x => x.AccountTypeId == 10 || x.AccountTypeId == 11).ToList();
        vehiclelist          = vehicleTask.Result;
        if (IsEditMode) 
            await LoadLrForEdit(LrId!.Value);
    }

    // ── Load for Edit ─────────────────────────────────────────────────
    private async Task LoadLrForEdit(int lrId)
    {
        IsLoading = true;
        StateHasChanged();
        try
        {
            var dto = await LrApiService.GetEntryAsync(lrId);
            if (dto == null) return;

            model = dto.Main ?? new Lr();

            if (dto.Details?.Any() == true)
            {
                ProductRows = dto.Details.Select((d, i) => new LrProductRow
                {
                    SrNo           = i + 1,
                    ProductId      = d.LrDetailProductId ?? 0,
                    ProductName    = d.LrDetailCargoName,
                    NtUnit         = d.LrDetailUnit,
                    LrBillTypeBill = d.LrDetailBillType,
                    GrossWt        = d.LrDetailGrossWt.HasValue        ? (double?)Convert.ToDouble(d.LrDetailGrossWt)        : null,
                    TareWt         = d.LrDetailTareWt.HasValue         ? (double?)Convert.ToDouble(d.LrDetailTareWt)         : null,
                    NetWt          = d.LrDetailNetWt,
                    LoadWt         = d.LrDetailLoadWt.HasValue         ? (double?)Convert.ToDouble(d.LrDetailLoadWt)         : null,
                    UnLoadWt       = d.LrDetailUnloadWt.HasValue       ? (double?)Convert.ToDouble(d.LrDetailUnloadWt)       : null,
                    ChargeQty      = d.LrDetailChargeQty.HasValue      ? (double?)Convert.ToDouble(d.LrDetailChargeQty)      : null,
                    RateBill       = d.LrDetailBillRate.HasValue       ? (double?)Convert.ToDouble(d.LrDetailBillRate)       : null,
                    GrossFreight   = d.LrDetailGrossFreight.HasValue   ? (double?)Convert.ToDouble(d.LrDetailGrossFreight)   : null,
                    TotalBags      = d.LrDetailTotalBags.HasValue      ? (decimal?)d.LrDetailTotalBags                       : null,
                    InvoiceNo      = d.LrDetailInvoiceNo,
                }).ToList();

                while (ProductRows.Count < 5)
                    ProductRows.Add(new LrProductRow { SrNo = ProductRows.Count + 1 });
            }

            var journals = dto.Journals ?? new List<LRJournal>();

            AdvanceRows         = MapJournals(journals, LrJournalGroup.Advance,          LrJournalVchType.Payment);
            DieselRows          = MapJournals(journals, LrJournalGroup.Diesel,            LrJournalVchType.Payment);
            ChargesRows         = MapJournals(journals, LrJournalGroup.Charges,          LrJournalVchType.Payment);
            ExpenseRows         = MapJournals(journals, LrJournalGroup.Expense,          LrJournalVchType.Payment);
            AdvanceReceivedRows = MapJournals(journals, LrJournalGroup.AdvanceReceived,  LrJournalVchType.Receipt);

            EnsureMinRows(AdvanceRows,         LrJournalGroup.Advance,         LrJournalVchType.Payment);
            EnsureMinRows(DieselRows,          LrJournalGroup.Diesel,          LrJournalVchType.Payment);
            EnsureMinRows(ChargesRows,         LrJournalGroup.Charges,         LrJournalVchType.Payment);
            EnsureMinRows(ExpenseRows,         LrJournalGroup.Expense,         LrJournalVchType.Payment);
            EnsureMinRows(AdvanceReceivedRows, LrJournalGroup.AdvanceReceived, LrJournalVchType.Receipt);

            await LoadDocumentsAsync();
        }
        catch (Exception ex)
        {
            ToastService.Error($"Failed to load LR: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private List<LRJournalRowVM> MapJournals(
        List<LRJournal> journals, LrJournalGroup group, LrJournalVchType vchType)
    {
        return journals
            .Where(j => j.JournalGroup == group && j.VchType == vchType)
            .Select((j, i) => new LRJournalRowVM
            {
                Sno          = i + 1,
                JournalDate  = j.JournalDate ?? DateTime.Now,
                AccountId    = j.AccountId,
                Amount       = j.Amount    != null ? (decimal?)Convert.ToDecimal(j.Amount)    : null,
                Remarks      = j.Remarks,
                PumpBillId   = j.PumpBillId,
                UreaRate     = j.UreaRate  != null ? (decimal?)Convert.ToDecimal(j.UreaRate)  : null,
                UreaQty      = j.UreaQty   != null ? (decimal?)Convert.ToDecimal(j.UreaQty)   : null,
                UreaAmount   = j.UreaAmount != null ? (decimal?)Convert.ToDecimal(j.UreaAmount) : null,
                JournalGroup = group.ToString(),
                VchType      = vchType.ToString(),
            }).ToList();
    }

    private void EnsureMinRows(List<LRJournalRowVM> list,
        LrJournalGroup group, LrJournalVchType vchType, int min = 5)
    {
        int start = list.Count;
        while (list.Count < min)
            list.Add(new LRJournalRowVM
            {
                Sno          = ++start,
                JournalDate  = DateTime.Now,
                JournalGroup = group.ToString(),
                VchType      = vchType.ToString()
            });
    }

