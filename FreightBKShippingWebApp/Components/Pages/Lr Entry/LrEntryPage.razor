@page "/lrentry"
@page "/lrentry/{LrId:int}"
@using FreightBKShipping.Client.Services
@using FreightBKShippingWebApp.Model
@using FreightBKShippingWebApp.Services
@using DevExpress.Blazor
@using static FreightBKShippingWebApp.Components.Pages.FileUploadpopup
@inject AuditLogService AuditLogService
@inject ToasteService ToastService
@inject PayTypeService PayTypeService
@inject LocationService LocationService
@inject NotifyService NotifyService
@inject AccountService AccountService
@inject ContainerAddServices ContainerAddServices
@inject CargoService CargoService
@inject ReportDataService ReportDataService
@inject FileUploadService FileUploadService
@inject IJSRuntime JS
@inject LrApiService LrApiService
@inject NavigationManager NavManager
@inject VehicleService VehicleService
<style>
    :root {
        --clr-bg: #f4f6fb;
        --clr-surface: #ffffff;
        --clr-border: #e2e8f0;
        --clr-primary: #2563eb;
        --clr-primary-dk: #1d4ed8;
        --clr-accent: #0ea5e9;
        --clr-text: #1e293b;
        --clr-muted: #64748b;
        --clr-danger: #ef4444;
        --radius-card: 12px;
        --radius-inner: 8px;
        --shadow-card: 0 1px 3px rgba(0,0,0,.08), 0 4px 16px rgba(0,0,0,.06);
        --shadow-footer: 0 -2px 12px rgba(0,0,0,.08);
        --font-main: 'Sora', 'Segoe UI', sans-serif;
    }

</style>

<div class="lr-page">

    <!-- ══ HEADER ══ -->
    <div class="lr-header">
        <div class="lr-header-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="1.75"
                 stroke-linecap="round" stroke-linejoin="round">
                <rect x="1" y="3" width="15" height="13" rx="1" />
                <path d="M16 8h4l3 4v4h-7V8z" />
                <circle cx="5.5" cy="18.5" r="2.5" />
                <circle cx="18.5" cy="18.5" r="2.5" />
            </svg>
        </div>
        <div class="lr-header-divider"></div>
        <div class="lr-header-text">
            <h1>LR Entry</h1>
            <span>Lorry Receipt</span>
        </div>

        <button type="button" class="btn-back" @onclick="GoBack">
            ← List
        </button>

        <div class="lr-header-badge @(IsEditMode ? "edit-mode" : "")">
            @(IsEditMode ? "Edit" : "New Entry")
        </div>

        <!-- ── Column Visibility Toggle Button ── -->
        <button type="button" class="btn-columns" @onclick="() => showPanel = !showPanel">
            ⚙ Columns
        </button>
    </div>

    <!-- ══ COLUMN VISIBILITY PANEL ══ -->
    @if (showPanel)
    {
        <div class="col-panel-backdrop" @onclick="() => showPanel = false"></div>
        <div class="col-panel">
            <div class="col-panel-header">
                <span>Show / Hide Fields</span>
                <button type="button" @onclick="() => showPanel = false">✕</button>
            </div>
            <div class="col-panel-actions">
                <button type="button" @onclick="SelectAll">Select All</button>
                <button type="button" @onclick="SelectNone">Clear All</button>
            </div>
            <div class="col-panel-list">
                @foreach (var key in Visible.Keys.ToList())
                {
                    var capturedKey = key;
                    <label class="col-toggle-row">
                        <input type="checkbox"
                               checked="@Visible[capturedKey]"
                               @onchange="e => { Visible[capturedKey] = (bool)e.Value!; StateHasChanged(); }" />
                        <span>@Labels[capturedKey]</span>
                    </label>
                }
            </div>
        </div>
    }

    @if (IsLoading)
    {
        <div class="loading-overlay">
            <span>⏳ Loading LR data...</span>
        </div>
    }
    else
    {
        <div class="lr-form-scroll">

            <EditForm Model="@model" OnValidSubmit="@Save">
                <DataAnnotationsValidator />
                <ValidationSummary class="validation-summary-errors" />

                <!-- ══ CORE DETAILS ══ -->
                <div class="lr-card">
                    <div class="lr-card-header"><h2>Core Details</h2></div>
                    <div class="lr-card-body">
                        <div class="field-grid">

                            @if (Visible["LrNo"] || Visible["LrDate"])
                            {
                                <div class="twoinone">
                                    @if (Visible["LrNo"])
                                    {
                                        <div class="field-group">
                                            <label>LR No</label>
                                            <DxTextBox @bind-Text="model.LrNoStr" />
                                        </div>
                                    }
                                    @if (Visible["LrDate"])
                                    {
                                        <div class="field-group">
                                            <label>LR Date</label>
                                            <DxDateEdit @bind-Date="model.LrDate" />
                                        </div>
                                    }
                                </div>
                            }

                            @if (Visible["Vehicle"])
                            {
                                <div class="field-group">
                                    <label>Vehicle</label>

                                                 <DxComboBox Data="@vehiclelist"
                                                TData="Vehicle" TValue="int?"
                                                TextFieldName="VehicleNo" ValueFieldName="VehicleId"
                                                @bind-Value="model.LrVehicleId"
                                                NullText="Select Vehicle"
                                                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                                AllowUserInput="true"
                                                SearchMode="ListSearchMode.AutoSearch"
                                                SearchFilterCondition="ListSearchFilterCondition.Contains" />
                                </div>
                            }

                            @if (Visible["Supplier"])
                            {
                                <div class="field-group">
                                    <label>Supplier</label>
                                    <DxComboBox Data="@accountSupplierlist"
                                                TData="Account" TValue="int?"
                                                TextFieldName="AccountName" ValueFieldName="AccountId"
                                                @bind-Value="model.LrSupplierAccountId"
                                                NullText="Select supplier"
                                                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                                AllowUserInput="true"
                                                SearchMode="ListSearchMode.AutoSearch"
                                                SearchFilterCondition="ListSearchFilterCondition.Contains" />
                                </div>
                            }

                            @if (Visible["BillingParty"])
                            {
                                <div class="field-group">
                                    <label>Billing Party</label>
                                    <DxComboBox Data="@accountSupplierlist"
                                                TData="Account" TValue="int"
                                                TextFieldName="AccountName" ValueFieldName="AccountId"
                                                @bind-Value="model.LrPartyAccountId"
                                                NullText="Select billing party"
                                                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                                AllowUserInput="true"
                                                SearchMode="ListSearchMode.AutoSearch"
                                                SearchFilterCondition="ListSearchFilterCondition.Contains" />
                                </div>
                            }

                            @if (Visible["Consignor"])
                            {
                                <div class="field-group">
                                    <label>From Party / Consignor</label>
                                    <DxComboBox Data="@notifylist"
                                                TData="Notify" TValue="int?"
                                                Value="@model.LrConsignorNotifyId"
                                                ValueChanged="@(id => OnConsignorChanged(id))"
                                                ValueExpression="() => model.LrConsignorNotifyId"
                                                TextFieldName="NotifyName" ValueFieldName="NotifyId"
                                                NullText="Select consignor"
                                                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                                AllowUserInput="true"
                                                SearchMode="ListSearchMode.AutoSearch"
                                                SearchFilterCondition="ListSearchFilterCondition.Contains" />
                                </div>
                            }

                            @if (Visible["Consignee"])
                            {
                                <div class="field-group">
                                    <label>To Party / Consignee</label>
                                    <DxComboBox Data="@notifylist"
                                                TData="Notify" TValue="int?"
                                                Value="@model.LrConsigneeNotifyId"
                                                ValueChanged="@((int? id) => OnConsigneeChanged(id))"
                                                ValueExpression="() => model.LrConsigneeNotifyId"
                                                TextFieldName="NotifyName" ValueFieldName="NotifyId"
                                                NullText="Select consignee"
                                                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                                AllowUserInput="true"
                                                SearchMode="ListSearchMode.AutoSearch"
                                                SearchFilterCondition="ListSearchFilterCondition.Contains" />
                                </div>
                            }

                            @if (Visible["FromStation"])
                            {
                                <div class="field-group">
                                    <label>From (Station)</label>
                                    <DxComboBox Data="@StationLocationList"
                                                TData="Location" TValue="int?"
                                                TextFieldName="LocationName" ValueFieldName="LocationId"
                                                @bind-Value="model.LrFromLocationId"
                                                NullText="Select station"
                                                AllowUserInput="true"
                                                SearchMode="ListSearchMode.AutoSearch"
                                                SearchFilterCondition="ListSearchFilterCondition.Contains" />
                                </div>
                            }

                            @if (Visible["ToLocation"])
                            {
                                <div class="field-group">
                                    <label>To Location</label>
                                    <DxComboBox Data="@LocationList"
                                                TData="Location" TValue="int?"
                                                TextFieldName="LocationName" ValueFieldName="LocationId"
                                                @bind-Value="model.LrToLocationId"
                                                NullText="Select destination"
                                                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                                AllowUserInput="true"
                                                SearchMode="ListSearchMode.AutoSearch"
                                                SearchFilterCondition="ListSearchFilterCondition.Contains" />
                                </div>
                            }

                            @if (Visible["PickupLoc"])
                            {
                                <div class="field-group">
                                    <label>Pickup Location</label>
                                    <DxTextBox @bind-Text="model.LrNtPickupLoc" />
                                </div>
                            }

                            @if (Visible["BackLocation"])
                            {
                                <div class="field-group">
                                    <label>Back Location</label>
                                    <DxSpinEdit @bind-Value="model.LrBackLocationId" ShowSpinButtons=false/>
                                </div>
                            }

                            @if (Visible["Driver"])
                            {
                                <div class="field-group">
                                    <label>Driver</label>
                                    <DxComboBox Data="@DriverList"
                                                TData="Account"
                                                TValue="int?"
                                                TextFieldName="AccountName"
                                                ValueFieldName="AccountId"
                                                @bind-Value="model.LrDriverId"
                                                NullText="Select Driver"
                                                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                                SearchMode="ListSearchMode.AutoSearch"
                                                SearchFilterCondition="ListSearchFilterCondition.Contains"
                                                AllowUserInput="true">
                                    </DxComboBox>
                                </div>
                            }

                            @if (Visible["Container1"])
                            {
                                <div class="field-group">
                                    <label>Container No</label>
                                    <DxTextBox @bind-Text="model.LrContainer1" />
                                </div>
                            }

                            @if (Visible["Container2"])
                            {
                                <div class="field-group">
                                    <label>Container No 2</label>
                                    <DxTextBox @bind-Text="model.LrContainer2" />
                                </div>
                            }

                            @if (Visible["RefNo"])
                            {
                                <div class="field-group">
                                    <label>Reference No</label>
                                    <DxTextBox @bind-Text="model.LrRefName" />
                                </div>
                            }

                            @if (Visible["PaymentMode"] || Visible["TripNo"])
                            {
                                <div class="field-group">
                                    <div class="twoinone">
                                        @if (Visible["PaymentMode"])
                                        {
                                            <div class="field-group">
                                                <label>Payment Mode</label>
                                                
                                                <DxComboBox Data="@PaymethodList"
                                                            @bind-Value="model.LrPaymentType"
                                                            TextFieldName="Text" ValueFieldName="Value"
                                                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                                            SearchMode="ListSearchMode.AutoSearch"
                                                            SearchFilterCondition="ListSearchFilterCondition.Contains"
                                                            AllowUserInput="false"
                                                            NullText="Payment Mode"
                                                            TData="SelectItem" TValue="string?" />

                                            </div>
                                        }
                                        @if (Visible["TripNo"])
                                        {
                                            <div class="field-group">
                                                <label>Trip No</label>
                                                <DxSpinEdit @bind-Value="model.LrTripNo" ShowSpinButtons=false/>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                        </div>
                    </div>
                </div>

                <!-- ══ TABBED SECTIONS ══ -->
                <div class="lr-tabs-wrapper">
                    <DxTabs>

                        <!-- ── Products ── -->
                        <DxTabPage Text="Products">
                            <div class="lr-tab-body">

                            <DxGrid AllowSort="false"
            Data="@ProductRows"
            ShowFilterRow="false"
            ShowGroupPanel="false"
            TItem="LrProductRow"
            @ref="ProductGrid"
            EditMode="GridEditMode.EditCell"
            EditModelSaving="Product_EditModelSaving"
            CustomizeEditModel="Product_CustomizeEditModel"
            KeyFieldName="SrNo"
            ColumnResizeMode="GridColumnResizeMode.ColumnsContainer" >
        <Columns>
            <DxGridCommandColumn Width="80px"
                                 EditButtonVisible="false"
                                 FixedPosition="GridColumnFixedPosition.Left"
                                 CancelButtonVisible="false"
                                 SaveButtonVisible="false"
                                 NewButtonVisible="false">
                <HeaderCaptionTemplate Context="ctx">
                    <DxButton IconCssClass="bi bi-plus-circle-dotted" RenderStyle="ButtonRenderStyle.Link"
                              Click="@AddNewProduct" style="padding:1px" />
                    <DxButton IconCssClass="bi bi-arrow-clockwise" RenderStyle="ButtonRenderStyle.Link"
                              Click="@RevertProductGrid" style="padding:1px" />
                </HeaderCaptionTemplate>
                <CellEditTemplate Context="editCtx">
                    <DxButton Enabled="false" IconCssClass="bi bi-trash" RenderStyle="ButtonRenderStyle.Link" />
                </CellEditTemplate>
                <CellDisplayTemplate Context="dispCtx">
                    @{ var row = (LrProductRow)dispCtx.DataItem; }
                    <DxButton IconCssClass="bi bi-trash" RenderStyle="ButtonRenderStyle.Link"
                              Click="@(() => DeleteProductRow(row))" />
                </CellDisplayTemplate>
            </DxGridCommandColumn>

            <DxGridDataColumn FieldName="SrNo" Caption="Sr No" Width="60px" ReadOnly="true" />

            <DxGridDataColumn FieldName="ProductId" Caption="Product" Width="280px">
                <CellDisplayTemplate Context="data">
                    @{
                        var row = (LrProductRow)data.DataItem;
                        var actualRow = ProductRows?.FirstOrDefault(r => r.SrNo == row.SrNo);
                        var pid = actualRow?.ProductId ?? row.ProductId;
                        var pname = ProductList?.FirstOrDefault(p => p.CargoId == pid)?.CargoName ?? "";
                    }
                    @pname
                </CellDisplayTemplate>
                <CellEditTemplate Context="editCtx">
                    @{ var edit = (LrProductRow)editCtx.EditModel; }
                    <DxComboBox Data="@ProductList"
                                TData="Cargo" TValue="int"
                                TextFieldName="CargoName"
                                ValueFieldName="CargoId"
                                NullText="Select Product..."
                                Value="@edit.ProductId"
                                ValueExpression="@(() => edit.ProductId)"
                                ValueChanged="@((int v) => {
                                    edit.ProductId = v;
                                    edit.ProductName = ProductList?.FirstOrDefault(p => p.CargoId == v)?.CargoName;
                                    var existing = ProductRows?.FirstOrDefault(r => r.SrNo == edit.SrNo);
                                    if (existing != null)
                                    {
                                        existing.ProductId = v;
                                        existing.ProductName = edit.ProductName;
                                    }
                                    InvokeAsync(StateHasChanged);
                                })"
                                SearchMode="ListSearchMode.AutoSearch"
                                SearchFilterCondition="ListSearchFilterCondition.Contains" />
                </CellEditTemplate>
            </DxGridDataColumn>

            <DxGridDataColumn FieldName="LrBillTypeBill" Caption="Bill Type" Width="180px">
                <CellEditTemplate Context="editCtx">
                    @{ var edit = (LrProductRow)editCtx.EditModel; }
                    <DxComboBox Data="@BillTypeList"
                                TData="BillTypeVM" TValue="string"
                                TextFieldName="Name"
                                ValueFieldName="Name"
                                NullText="Select Type..."
                                Value="@edit.LrBillTypeBill"
                                ValueExpression="@(() => edit.LrBillTypeBill)"
                                ValueChanged="@((string v) => {
                                    edit.LrBillTypeBill = v;
                                    RecalculateEditRow(edit);
                                    InvokeAsync(StateHasChanged);
                                })"
                                SearchMode="ListSearchMode.AutoSearch"
                                SearchFilterCondition="ListSearchFilterCondition.Contains" />
                </CellEditTemplate>
            </DxGridDataColumn>

            <DxGridDataColumn FieldName="NtUnit" Caption="Unit" Width="90px">
                <EditSettings><DxTextBoxSettings /></EditSettings>
            </DxGridDataColumn>

            <DxGridDataColumn FieldName="TotalBags" Caption="Total Bags" Width="100px">
                <CellEditTemplate Context="editCtx">
                    @{ var edit = (LrProductRow)editCtx.EditModel; }
                    <DxSpinEdit TValue="decimal?"
                                Value="@edit.TotalBags"
                                ValueExpression="@(() => edit.TotalBags)"
                                ValueChanged="@((decimal? v) => { edit.TotalBags = v; })"
                                ShowSpinButtons="false" />
                </CellEditTemplate>
            </DxGridDataColumn>

            <DxGridDataColumn FieldName="GrossWt" Caption="Gross Wt" Width="100px">
                <CellEditTemplate Context="editCtx">
                    @{ var edit = (LrProductRow)editCtx.EditModel; }
                    <DxSpinEdit TValue="double?"
                                Value="@edit.GrossWt"
                                ValueExpression="@(() => edit.GrossWt)"
                                ValueChanged="@((double? v) => {
                                    edit.GrossWt = v;
                                    edit.NetWt = Convert.ToDecimal(v ?? 0) - Convert.ToDecimal(edit.TareWt ?? 0);
                                    RecalculateEditRow(edit);
                                    InvokeAsync(StateHasChanged);
                                })"
                                ShowSpinButtons="false" />
                </CellEditTemplate>
            </DxGridDataColumn>

            <DxGridDataColumn FieldName="TareWt" Caption="Tare Wt" Width="90px">
                <CellEditTemplate Context="editCtx">
                    @{ var edit = (LrProductRow)editCtx.EditModel; }
                    <DxSpinEdit TValue="double?"
                                Value="@edit.TareWt"
                                ValueExpression="@(() => edit.TareWt)"
                                ValueChanged="@((double? v) => {
                                    edit.TareWt = v;
                                    edit.NetWt = Convert.ToDecimal(edit.GrossWt ?? 0) - Convert.ToDecimal(v ?? 0);
                                    RecalculateEditRow(edit);
                                    InvokeAsync(StateHasChanged);
                                })"
                                ShowSpinButtons="false" />
                </CellEditTemplate>
            </DxGridDataColumn>

            <DxGridDataColumn FieldName="NetWt" Caption="Net Wt" Width="90px" ReadOnly="true">
                <CellDisplayTemplate Context="data">
                    @{ var row = (LrProductRow)data.DataItem; }
                    <span style="color:#1e293b;">@(row.NetWt.HasValue ? row.NetWt.Value.ToString("N2") : "")</span>
                </CellDisplayTemplate>
                <CellEditTemplate Context="editCtx">
                    @{ var edit = (LrProductRow)editCtx.EditModel; }
                    <span style="padding:4px 8px; display:block; color:#0ea5e9; font-weight:600;">
                        @(edit.NetWt.HasValue ? edit.NetWt.Value.ToString("N2") : "0.00")
                    </span>
                </CellEditTemplate>
            </DxGridDataColumn>

            <DxGridDataColumn FieldName="UnLoadWt" Caption="UnLoad Wt" Width="100px">
                <CellEditTemplate Context="editCtx">
                    @{ var edit = (LrProductRow)editCtx.EditModel; }
                    <DxSpinEdit TValue="double?"
                                Value="@edit.UnLoadWt"
                                ValueExpression="@(() => edit.UnLoadWt)"
                                ValueChanged="@((double? v) => {
                                    edit.UnLoadWt = v;
                                    RecalculateEditRow(edit);
                                    InvokeAsync(StateHasChanged);
                                })"
                                ShowSpinButtons="false" />
                </CellEditTemplate>
            </DxGridDataColumn>

            <DxGridDataColumn FieldName="ChargeQty" Caption="Charge Wt" Width="100px">
                <CellEditTemplate Context="editCtx">
                    @{ var edit = (LrProductRow)editCtx.EditModel; }
                    <DxSpinEdit TValue="double?"
                                Value="@edit.ChargeQty"
                                ValueExpression="@(() => edit.ChargeQty)"
                                ValueChanged="@((double? v) => {
                                    edit.ChargeQty = v;
                                    RecalculateEditRow(edit);
                                    InvokeAsync(StateHasChanged);
                                })"
                                ShowSpinButtons="false" />
                </CellEditTemplate>
            </DxGridDataColumn>

            <DxGridDataColumn FieldName="RateBill" Caption="Rate" Width="90px">
                <CellEditTemplate Context="editCtx">
                    @{ var edit = (LrProductRow)editCtx.EditModel; }
                    <DxSpinEdit TValue="double?"
                                Value="@edit.RateBill"
                                ValueExpression="@(() => edit.RateBill)"
                                ValueChanged="@((double? v) => {
                                    edit.RateBill = v;
                                    RecalculateEditRow(edit);
                                    InvokeAsync(StateHasChanged);
                                })"
                                ShowSpinButtons="false" />
                </CellEditTemplate>
            </DxGridDataColumn>

            <DxGridDataColumn FieldName="GrossFreight"
                              Caption="Freight"
                              Width="100px"
                              ReadOnly="true">
                <CellDisplayTemplate Context="ctx">
                    @{
                        var row = (LrProductRow)ctx.DataItem;
                        var actualRow = ProductRows?.FirstOrDefault(r => r.SrNo == row.SrNo);
                        var freight = actualRow?.GrossFreight ?? row.GrossFreight;
                    }
                    <span style="color:#2563eb; font-weight:600;">
                        @(freight.HasValue ? freight.Value.ToString("N2") : "0.00")
                    </span>
                </CellDisplayTemplate>
                <CellEditTemplate Context="editCtx">
                    @{ var edit = (LrProductRow)editCtx.EditModel; }
                    <span style="padding:4px 8px; display:block; color:#2563eb; font-weight:600;">
                        @(edit.GrossFreight.HasValue
                            ? Convert.ToDecimal(edit.GrossFreight).ToString("N2")
                            : "0.00")
                    </span>
                </CellEditTemplate>
            </DxGridDataColumn>

        </Columns>
    </DxGrid>
                            </div>
                        </DxTabPage>

                        <!-- ── Advance ── -->
                        <DxTabPage Text="Advance">
                            <div class="lr-tab-body">
                                <DxGrid Data="@AdvanceRows"
                                        @ref="AdvanceGrid"
                                        TItem="LRJournalRowVM"
                                        KeyFieldName="RowId"
                                        EditMode="GridEditMode.EditCell"
                                        EditModelSaving="Advance_EditModelSaving">
                                    <Columns>
                                        <DxGridCommandColumn Width="80px" EditButtonVisible="false"
                                                             FixedPosition="GridColumnFixedPosition.Left"
                                                             CancelButtonVisible="false"
                                                             SaveButtonVisible="false"
                                                             NewButtonVisible="false">
                                            <HeaderCaptionTemplate Context="headerCtx">
                                                <DxButton IconCssClass="bi bi-plus-circle-dotted"
                                                          RenderStyle="ButtonRenderStyle.Link"
                                                          Click="@AddNewAdvance" style="padding:1px" />
                                                <DxButton IconCssClass="bi bi-arrow-clockwise"
                                                          RenderStyle="ButtonRenderStyle.Link"
                                                          Click="@RevertAdvanceGrid" style="padding:1px" />
                                            </HeaderCaptionTemplate>
                                            <CellDisplayTemplate Context="rowCtx">
                                                @{
                                                    var row = (LRJournalRowVM)rowCtx.DataItem;
                                                }
                                                <DxButton IconCssClass="bi bi-trash"
                                                          RenderStyle="ButtonRenderStyle.Link"
                                                          Click="@(() => DeleteAdvanceRow(row))" />
                                            </CellDisplayTemplate>
                                        </DxGridCommandColumn>
                                        <DxGridDataColumn FieldName="Sno" Caption="Sr No" Width="70px" ReadOnly="true" />
                                        <DxGridDataColumn FieldName="JournalDate" Caption="Date" Width="120px">
                                            <EditSettings><DxDateEditSettings PickerDisplayMode="DatePickerDisplayMode.ScrollPicker"/></EditSettings>
                                        </DxGridDataColumn>
                                        <DxGridDataColumn FieldName="AccountId" Caption="Account" Width="200px">
                                            <EditSettings>
                                                <DxComboBoxSettings Data="@BankCashList"
                                                                    TextFieldName="AccountName"
                                                                    ValueFieldName="AccountId"
                                                                    SearchMode="ListSearchMode.AutoSearch"
                                                                    SearchFilterCondition="ListSearchFilterCondition.Contains" />
                                            </EditSettings>
                                        </DxGridDataColumn>
                                        <DxGridDataColumn FieldName="Amount" Caption="Amount">
                                            <EditSettings><DxSpinEditSettings ShowSpinButtons="false" /></EditSettings>
                                        </DxGridDataColumn>
                                        <DxGridDataColumn FieldName="Remarks" Caption="Remarks" Width="200px" />
                                    </Columns>
                                </DxGrid>
                            </div>
                        </DxTabPage>

                        <!-- ── Diesel ── -->
                        <DxTabPage Text="Diesel">
                            <div class="lr-tab-body">
                                <DxGrid Data="@DieselRows"
                                        TItem="LRJournalRowVM"
                                        @ref="DieselGrid"
                                        KeyFieldName="Sno"
                                        EditMode="GridEditMode.EditCell"
                                        EditModelSaving="Diesel_EditModelSaving"
                                        CustomizeEditModel="Diesel_Customize">
                                    <Columns>
                                        <DxGridCommandColumn Width="80px"
                                                             EditButtonVisible="false"
                                                             FixedPosition="GridColumnFixedPosition.Left"
                                                             CancelButtonVisible="false"
                                                             SaveButtonVisible="false"
                                                             NewButtonVisible="false">
                                            <HeaderCaptionTemplate Context="ctx">
                                                <DxButton IconCssClass="bi bi-plus-circle-dotted"
                                                          RenderStyle="ButtonRenderStyle.Link"
                                                          Click="@AddNewDiesel" style="padding:1px" />
                                                <DxButton IconCssClass="bi bi-arrow-clockwise"
                                                          RenderStyle="ButtonRenderStyle.Link"
