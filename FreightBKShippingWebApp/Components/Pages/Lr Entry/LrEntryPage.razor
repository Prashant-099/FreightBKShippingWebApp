@page "/lrentry"
@using FreightBKShipping.Client.Services
@using FreightBKShippingWebApp.Model
@using FreightBKShippingWebApp.Services
@using DevExpress.Blazor
@using static FreightBKShippingWebApp.Components.Pages.FileUploadpopup

@inject ToasteService ToastService
@inject PayTypeService PayTypeService
@inject LocationService LocationService
@inject NotifyService NotifyService
@inject AccountService AccountService
@inject ContainerAddServices ContainerAddServices
@inject CargoService CargoService
@inject ReportDataService ReportDataService
@inject FileUploadService FileUploadService
@inject IJSRuntime JS
@inject LrApiService LrApiService

<style>

    :root {
        --clr-bg: #f4f6fb;
        --clr-surface: #ffffff;
        --clr-border: #e2e8f0;
        --clr-primary: #2563eb;
        --clr-primary-dk: #1d4ed8;
        --clr-accent: #0ea5e9;
        --clr-text: #1e293b;
        --clr-muted: #64748b;
        --clr-danger: #ef4444;
        --radius-card: 12px;
        --radius-inner: 8px;
        --shadow-card: 0 1px 3px rgba(0,0,0,.08), 0 4px 16px rgba(0,0,0,.06);
        --shadow-footer: 0 -2px 12px rgba(0,0,0,.08);
        --font-main: 'Sora', 'Segoe UI', sans-serif;
    }

    .lr-page {
        height: 100vh;
        display: flex;
        flex-direction: column;
        font-family: var(--font-main);
        color: var(--clr-text);
        overflow: hidden;
    }

    /* ── HEADER ── */
    .lr-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 10px;
        border-top: 4px solid var(--clr-primary);
        border-radius: var(--radius-inner);
        padding: 10px 16px;
        box-shadow: var(--shadow-card);
        flex-wrap: nowrap;
        overflow: hidden;
        flex-shrink: 0;
    }

    .lr-header-icon {
        width: 40px;
        height: 40px;
        border-radius: 6px;
        background: #eff4ff;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--clr-primary);
        flex-shrink: 0;
    }

    .lr-header-divider {
        width: 1px;
        height: 32px;
        background: var(--clr-border);
        flex-shrink: 0;
    }

    .lr-header-text {
        display: flex;
        flex-direction: column;
        gap: 0;
        min-width: 0;
    }

    .lr-header h1 {
        font-size: 1rem;
        font-weight: 700;
        letter-spacing: -.02em;
        margin: 0;
        line-height: 1.2;
        white-space: nowrap;
        color: var(--clr-text);
    }

    .lr-header span {
        font-size: .75rem;
        color: var(--clr-muted);
        white-space: nowrap;
        line-height: 1.2;
    }

    .lr-header-badge {
        margin-left: auto;
        background: #eff4ff;
        color: var(--clr-primary);
        font-size: 0.6rem;
        font-weight: 600;
        letter-spacing: .08em;
        padding: 3px 8px;
        border-radius: 3px;
        text-transform: uppercase;
        white-space: nowrap;
        flex-shrink: 0;
    }

    @@media (max-width: 640px) {
        .lr-header {
            padding: 8px 12px;
            gap: 8px;
            margin-bottom: 8px;
        }

        .lr-header h1 {
            font-size: .9rem;
        }

        .lr-header span {
            font-size: .68rem;
        }

        .lr-header-divider {
            display: none;
        }

        .lr-header-badge {
            display: none;
        }
    }

    /* ── CARDS ── */
    .lr-card {
        background: var(--clr-surface);
        border: 1px solid var(--clr-border);
        border-radius: var(--radius-card);
        box-shadow: var(--shadow-card);
        margin-bottom: 12px;
        overflow: hidden;
    }

    .lr-card-header {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px 16px;
        border-bottom: 1px solid var(--clr-border);
        background: linear-gradient(90deg, #f8faff 0%, #fff 100%);
    }

    .lr-card-header h2 {
        font-size: .8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .06em;
        color: var(--clr-primary);
        margin: 0;
    }

    .lr-card-body {
        padding: 14px 16px;
    }

    /* ── GRIDS ── */
    .field-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 12px 16px;
    }

    .field-grid.cols-3 {
        grid-template-columns: repeat(3, 1fr);
    }

    .field-grid.cols-2 {
        grid-template-columns: repeat(2, 1fr);
    }

    .split-column {
        grid-column: span 1;
    }

    .twoinone {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }

    .three-in-one {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 10px;
    }

    @@media (max-width: 1100px) {
        .field-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .field-grid.cols-2 {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 640px) {
        .field-grid, .field-grid.cols-3, .field-grid.cols-2 {
            grid-template-columns: 1fr;
        }

        .lr-page {
            padding: 0;
        }

        .km-group {
            grid-template-columns: 1fr !important;
        }
    }

    .field-group {
        display: flex;
        flex-direction: column;
        gap: 3px;
    }

    .field-group label {
        font-size: .7rem;
        font-weight: 600;
        color: var(--clr-muted);
        text-transform: uppercase;
        letter-spacing: .05em;
        line-height: 1.2;
    }

    .km-group {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 12px 16px;
    }

    /* ── TABS ── */
    .lr-tabs-wrapper {
        background: var(--clr-surface);
        border: 1px solid var(--clr-border);
        border-radius: var(--radius-card);
        box-shadow: var(--shadow-card);
        overflow: hidden;
        margin-bottom: 12px;
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .lr-tab-body {
        padding: 16px;
        overflow-y: auto;
        flex: 1;
    }

    .sub-section-label {
        margin-bottom: 6px;
        font-size: .7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .06em;
        color: var(--clr-muted);
        line-height: 1.2;
    }

    /* ── VALIDATION ── */
    .validation-summary-errors {
        background: #fff5f5;
        border: 1px solid #fca5a5;
        border-radius: var(--radius-inner);
        padding: 10px 14px;
        margin-bottom: 12px;
        color: var(--clr-danger);
        font-size: .8rem;
        line-height: 1.4;
    }

    .validation-summary-errors ul {
        margin: 0;
        padding-left: 14px;
    }

    /* ── FOOTER ── */
    .lr-footer {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        background: var(--clr-surface);
        border-top: 1px solid var(--clr-border);
        box-shadow: var(--shadow-footer);
        padding: 10px 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        z-index: 1000;
        gap: 12px;
        height: 52px;
        flex-shrink: 0;
    }

    .lr-footer-meta {
        font-size: .75rem;
        color: var(--clr-muted);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        flex: 1;
        line-height: 1.4;
    }

    .lr-footer-meta strong {
        color: var(--clr-text);
        font-weight: 600;
    }

    .btn-save {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: linear-gradient(135deg, var(--clr-primary) 0%, var(--clr-accent) 100%);
        color: #fff !important;
        border: none;
        border-radius: 6px;
        padding: 8px 20px;
        font-size: .85rem;
        font-weight: 600;
        cursor: pointer;
        transition: opacity .15s, transform .1s;
        letter-spacing: .01em;
        flex-shrink: 0;
        white-space: nowrap;
    }

    .btn-save:hover {
        opacity: .9;
        transform: translateY(-1px);
    }

    .btn-save:active {
        transform: translateY(0);
    }

    @@media (max-width: 640px) {
        .lr-footer {
            padding: 8px 16px;
            height: 48px;
        }

        .btn-save {
            padding: 7px 14px;
            font-size: .8rem;
        }
    }

    /* ── READONLY FIELD ── */
    .field-readonly {
        padding: 6px 8px;
        background: #f8fafc;
        border: 1px solid var(--clr-border);
        border-radius: 4px;
        font-size: .8rem;
        color: var(--clr-muted);
        min-height: 32px;
        line-height: 1.4;
    }

    .lr-form-scroll {
        flex: 1;
        overflow-y: auto;
        padding: 0 16px 64px;
    }
</style>

<div class="lr-page">

    <!-- ══ HEADER ══ -->
    <div class="lr-header">

        <div class="lr-header-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="1.75"
                 stroke-linecap="round" stroke-linejoin="round">
                <rect x="1" y="3" width="15" height="13" rx="1" />
                <path d="M16 8h4l3 4v4h-7V8z" />
                <circle cx="5.5" cy="18.5" r="2.5" />
                <circle cx="18.5" cy="18.5" r="2.5" />
            </svg>
        </div>

        <div class="lr-header-divider"></div>

        <div class="lr-header-text">
            <h1>LR Entry</h1>
            <span>Lorry Receipt</span>
        </div>

        <div class="lr-header-badge">New Entry</div>
   
    </div>

    <div class="lr-form-scroll">
    
        <EditForm Model="@model" OnValidSubmit="@Save">
            <DataAnnotationsValidator />
            <ValidationSummary class="validation-summary-errors" />

            <!-- ══ CORE DETAILS ══ -->
            <div class="lr-card">
                <div class="lr-card-header">
                    <h2>Core Details</h2>
                </div>
                <div class="lr-card-body">
                    <div class="field-grid">
                        <div class="twoinone">
                            <div class="field-group">
                                <label>LR No</label>
                                <DxTextBox @bind-Text="model.LrNoStr" />
                            </div>

                            <div class="field-group">
                                <label>LR Date</label>
                                <DxDateEdit @bind-Date="model.LrDate" />
                            </div>
                        </div>
                      

                        <div class="field-group">
                            <label>Vehicle</label>
                            <DxSpinEdit @bind-Value="model.LrVehicleId" />
                        </div>
                        <div class="field-group">
                                <label>Supplier</label>
                                <DxComboBox Data="@accountSupplierlist"
                                            TData="Account" TValue="int?"
                                            TextFieldName="AccountName"
                                            ValueFieldName="AccountId"
                                            @bind-Value="model.LrSupplierAccountId"
                                            NullText="Select supplier"
                                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                            AllowUserInput="true"
                                            SearchMode="ListSearchMode.AutoSearch"
                                            SearchFilterCondition="ListSearchFilterCondition.Contains" />
              
                        </div>
                        <div class="field-group">
                                <label>Billing Party</label>
                                <DxComboBox Data="@accountSupplierlist"
                                            TData="Account" TValue="int"
                                            TextFieldName="AccountName"
                                            ValueFieldName="AccountId"
                                            @bind-Value="model.LrPartyAccountId"
                                            NullText="Select supplier"
                                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                            AllowUserInput="true"
                                            SearchMode="ListSearchMode.AutoSearch"
                                            SearchFilterCondition="ListSearchFilterCondition.Contains" />
              
                        </div>
                        <div class="field-group">
                            <label>From Party / Consignor</label>
                            <DxComboBox Data="@notifylist"
                                        TData="Notify" TValue="int?"
                                        Value="@model.LrConsignorNotifyId"
                                        ValueChanged="@(id => OnConsignorChanged(id))"
                                        ValueExpression="() => model.LrConsignorNotifyId"
                                        TextFieldName="NotifyName"
                                        ValueFieldName="NotifyId"
                                        NullText="Select consignor"
                                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                        AllowUserInput="true"
                                        SearchMode="ListSearchMode.AutoSearch"
                                        SearchFilterCondition="ListSearchFilterCondition.Contains" />
                        </div>
                        <div class="field-group">
                            <label>To Party / Consignee</label>
                            <DxComboBox Data="@notifylist"
                                        TData="Notify" TValue="int?"
                                        Value="@model.LrConsigneeNotifyId"
                                        ValueChanged="@((int? id) => OnConsigneeChanged(id))"
                                        ValueExpression="() => model.LrConsigneeNotifyId"
                                        TextFieldName="NotifyName"
                                        ValueFieldName="NotifyId"
                                        NullText="Select consignee"
                                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                        AllowUserInput="true"
                                        SearchMode="ListSearchMode.AutoSearch"
                                        SearchFilterCondition="ListSearchFilterCondition.Contains" />
                        </div>

                        <div class="field-group">
                            <label>From (Station)</label>
                            <DxComboBox Data="@StationLocationList"
                                        TData="Location" TValue="int?"
                                        TextFieldName="LocationName"
                                        ValueFieldName="LocationId"
                                        @bind-Value="model.LrFromLocationId"
                                        NullText="Select station"
                                        AllowUserInput="true"
                                        SearchMode="ListSearchMode.AutoSearch"
                                        SearchFilterCondition="ListSearchFilterCondition.Contains" />
                        </div>

                        <div class="field-group">
                            <label>To Location</label>
                            <DxComboBox Data="@LocationList"
                                        TData="Location" TValue="int?"
                                        TextFieldName="LocationName"
                                        ValueFieldName="LocationId"
                                        @bind-Value="model.LrToLocationId"
                                        NullText="Select destination"
                                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                        AllowUserInput="true"
                                        SearchMode="ListSearchMode.AutoSearch"
                                        SearchFilterCondition="ListSearchFilterCondition.Contains" />
                        </div>
                        <div class="field-group">
                            <label>Pickup Location</label>
                            <DxTextBox @bind-Text="model.LrNtPickupLoc" />
                        </div>

                        <div class="field-group">
                            <label>Back Location</label>
                            <DxSpinEdit @bind-Value="model.LrBackLocationId" />
                        </div>

                        <div class="field-group">
                            <label>Container No</label>
                            <DxTextBox @bind-Text="model.LrContainer1" />
                        </div>
                        <div class="field-group">
                            <label>Container No 2</label>
                            <DxTextBox @bind-Text="model.LrContainer2" />
                        </div>

                        
                        <div class="field-group">
                            <label>Reference No</label>
                            <DxTextBox @bind-Text="model.LrRefName" />
                        </div>

                        

                        <div class="field-group split-column">
                                <div class="twoinone">
                                        <div>
                                            <label>Payment Mode</label>
                                            <DxComboBox Data="@PaymethodList"
                                                        @bind-Value="model.LrPaymentType"
                                                        TextFieldName="Text"
                                                        ValueFieldName="Value"
                                                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                                        AllowUserInput="false"
                                                        NullText="Payemnet Mode"
                                                        TData="SelectItem" TValue="string?" />
                                        </div>

                                        <div>
                                            <label>Trip No</label>
                                            <DxSpinEdit @bind-Value="model.LrTripNo" />
                                        </div>
                                    </div>
                        </div>

                     </div>

                </div>
            </div>

            <!-- ══ TABBED SECTIONS ══ -->
            <div class="lr-tabs-wrapper">
                <DxTabs>

                    <!-- Products -->
                    <DxTabPage Text="Products">
                        <div class="lr-tab-body">
                            <DxGrid AllowSort="false"
                                    Data="@Rows"
                                    ShowFilterRow="false"
                                    ShowGroupPanel="false"
                                    TItem="LrProductRow"
                                    @ref="Grid"
                                    EditMode="GridEditMode.EditCell"
                                    EditModelSaving="Grid_EditModelSaving"
                                    CustomizeEditModel="Grid_CustomizeEditModel"
                                    KeyFieldName="SrNo"
                                    ColumnResizeMode="GridColumnResizeMode.ColumnsContainer">
                                <Columns>
                                    <DxGridCommandColumn Width="80px" EditButtonVisible="false"
                                                         FixedPosition="GridColumnFixedPosition.Left"
                                                         CancelButtonVisible="false"
                                                         SaveButtonVisible="false" NewButtonVisible="false">

                                        <HeaderCaptionTemplate Context="dendercaptioncontext">
                                            <DxButton IconCssClass="bi bi-plus-circle-dotted"
                                                      RenderStyle="ButtonRenderStyle.Link"
                                                      Click="@(() => AddNew())" style="padding:1px" />

                                            <DxButton IconCssClass="bi bi-arrow-clockwise"
                                                      RenderStyle="ButtonRenderStyle.Link"
                                                      Click="@RevertGridtransport_Click" style="padding:1px" />

                                            <DxButton RenderStyle="ButtonRenderStyle.Link"
                                                      IconCssClass="bi bi-three-dots"
                                                      SizeMode="SizeMode.Medium" style="padding:1px" />
                                        </HeaderCaptionTemplate>

                                        <CellEditTemplate Context="editContext">
                                            <DxButton Enabled="false"
                                                      CssClass="grid-disabled-button"
                                                      IconCssClass="bi bi-trash"
                                                      RenderStyle="ButtonRenderStyle.Link" />
                                        </CellEditTemplate>

                                        <CellDisplayTemplate Context="displayContext">
                                            @{
                                                var row = (LrProductRow)displayContext.DataItem;
                                            }
                                            <DxButton IconCssClass="bi bi-trash"
                                                      CssClass="grid-delete-btn"
                                                      RenderStyle="ButtonRenderStyle.Link"
                                                      Click="@(() => DeleteDataItem(row))" />

                                        </CellDisplayTemplate>

                                    </DxGridCommandColumn>

                                    <DxGridDataColumn FieldName="SrNo" Caption="Sr No" Width="50px" ReadOnly="true" />
                                    <DxGridDataColumn FieldName="Product" Caption="Product" />
                                    <DxGridDataColumn FieldName="Unit" Caption="Unit" Width="70px">
                                        <EditSettings>
                                            <DxSpinEditSettings ShowSpinButtons="false" />
                                        </EditSettings>
                                    </DxGridDataColumn>
                                    <DxGridDataColumn FieldName="GrossWt" Caption="Gross Wt" Width="100px" />
                                    <DxGridDataColumn FieldName="TareWt" Caption="Tare Wt" Width="90px" />
                                    <DxGridDataColumn FieldName="NetWt" Caption="Net Wt" Width="90px" />
                                    <DxGridDataColumn FieldName="LoadWt" Caption="Load Wt" Width="90px" />
                                    <DxGridDataColumn FieldName="UnLoadWt" Caption="UnLoad Wt" Width="100px" />
                                    <DxGridDataColumn FieldName="ChargeWt" Caption="Charge Wt" Width="100px" />
                                    <DxGridDataColumn FieldName="BillingRate" Caption="Rate" Width="90px" />
                                    <DxGridDataColumn FieldName="GrossFreight" Caption="Freight" Width="100px" />
                                </Columns>
                            </DxGrid>
                        </div>
                    </DxTabPage>

                        <!-- Driver Advance -->
                        <DxTabPage Text="Driver Advance">
                            <div class="lr-tab-body">
                                <div class="field-grid cols-3">

                                    <div class="field-group">
                                        <label>Account</label>
                                        <DxComboBox Data="@accountsList"
                                                    TextFieldName="AccountName"
                                                    ValueFieldName="AccountId"
                                                    @bind-Value="lRJournal.AccountId"
                                                    NullText="Select Account"
                                                    ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" 
                                                    AllowUserInput 
                                                    SearchMode="ListSearchMode.AutoSearch"
                                                    SearchFilterCondition="ListSearchFilterCondition.Contains" />
                                    </div>

                                    <div class="field-group">
                                        <label>Amount</label>
                                        <DxSpinEdit @bind-Value="lRJournal.Amount" />
                                    </div>

                                    <div class="field-group">
                                        <label>Remarks</label>
                                        <DxTextBox @bind-Text="lRJournal.Remarks" />
                                    </div>
                                </div>
                            </div>
                        </DxTabPage>

                        <!-- Diesel -->
                        <DxTabPage Text="Diesel">
                            <div class="lr-tab-body">
                                <div class="field-grid cols-3">

                                    <div class="field-group">
                                        <label>Petrol Pump</label>
                                        <DxSpinEdit @bind-Value="lRJournal.PumpBillId" />
                                    </div>

                                    <div class="field-group">
                                        <label>Rate</label>
                                        <DxSpinEdit @bind-Value="lRJournal.UreaRate" />
                                    </div>
                                    <div class="field-group">
                                        <label>Amount</label>
                                        <DxSpinEdit @bind-Value="lRJournal.UreaAmount" />
                                    </div>

                                    <div class="field-group">
                                        <label>Ltr</label>
                                        <DxSpinEdit @bind-Value="lRJournal.UreaQty" />
                                    </div>

                                </div>
                            </div>
                        </DxTabPage>

                        <!-- Charges -->
                        <DxTabPage Text="Charges">
                            <div class="lr-tab-body">
                                <div class="field-grid cols-3">
                                    <div class="field-group">
                                        <label>Account</label>
                                        <DxSpinEdit @bind-Value="lRJournal.AccountId"></DxSpinEdit>
                                    </div>

                                    <div class="field-group">
                                        <label>Amount</label>
                                        <DxSpinEdit @bind-Value="lRJournal.Amount" />
                                    </div>
                                    <div class="field-group">
                                        <label>Remarks</label>
                                        <DxTextBox @bind-Text="lRJournal.Remarks" />
                                    </div>

                                </div>

                            </div>
                        </DxTabPage>

                        <!-- Expense -->
                        <DxTabPage Text="Expense">
                            <div class="lr-tab-body">   

                                <div class="field-grid cols-3">

                                    <div class="field-group">
                                        <label>Account</label>
                                        <DxSpinEdit @bind-Value="lRJournal.AccountId"></DxSpinEdit>
                                    </div>

                                    <div class="field-group">
                                        <label>Amount</label>
                                        <DxSpinEdit @bind-Value="lRJournal.Amount" />
                                    </div>

                                    <div class="field-group">
                                        <label>Remarks</label>
                                        <DxTextBox @bind-Text="lRJournal.Remarks" />
                                    </div>

                                </div>

                            </div>
                        </DxTabPage>

                        <!-- Advance Received -->
                        <DxTabPage Text="Advance Received">
                            <div class="lr-tab-body">             

                                <div class="field-grid cols-3">

                                    <div class="field-group">
                                        <label>Account</label>
                                        <DxSpinEdit @bind-Value="lRJournal.AccountId"></DxSpinEdit>
                                    </div>

                                    <div class="field-group">
                                        <label>Amount</label>
                                        <DxSpinEdit @bind-Value="lRJournal.Amount" />
                                    </div>
                                    <div class="field-group">
                                        <label>Qty (Diesel)</label>
                                        <DxSpinEdit @bind-Value="lRJournal.UreaQty" />
                                    </div>

                                    <div class="field-group">
                                        <label>Remarks</label>
                                        <DxTextBox @bind-Text="lRJournal.Remarks" />
                                    </div>

                                </div>

                            </div>
                        </DxTabPage>

                        <!-- Documents -->
                        <DxTabPage Text="Documents">
                            <div class="lr-tab-body">
                                <div class="upload-docs-header" style="margin-bottom:12px;">
                                    <DxButton Text="Upload Documents"
                                              IconCssClass="bi bi-upload"
                                              RenderStyle="ButtonRenderStyle.Primary"
                                              CssClass="upload-btn"
                                              Click="OpenUploadPopup" />
                                </div>
                                @if (UploadedDocs?.Any() == true)
                                {
                                    <DxGrid Data="@UploadedDocs"
                                            ShowBorders="true"
                                            CssClass="docs-grid"
                                            PageSize="5"
                                            ShowFilterRow="true">

                                        <Columns>
                                            <DxGridDataColumn FieldName="FileName"
                                                              Caption="Document"
                                                              MinWidth="200" />

                                            <DxGridDataColumn FieldName="FileSize"
                                                              Caption="Size (KB)"
                                                              Width="100px"
                                                              TextAlignment="GridTextAlignment.Right" />

                                            <DxGridDataColumn Caption="Actions"
                                                              Width="120px"
                                                              AllowSort="false"
                                                              AllowFilter="false">
                                                <CellDisplayTemplate Context="doc">
                                                    <div class="action-buttons" style="display:flex;gap:4px;">
                                                        <DxButton IconCssClass="bi bi-eye"
                                                                  RenderStyle="ButtonRenderStyle.Secondary"
                                                                  Size="Size.Small"
                                                                  Click="@(async () => await PreviewDoc((UploadedFileInfo)doc.DataItem))" />

                                                        <DxButton IconCssClass="bi bi-trash"
                                                                  RenderStyle="ButtonRenderStyle.Secondary"
                                                                  Size="Size.Small"
                                                                  Click="@(() => DeleteDoc((UploadedFileInfo)doc.DataItem))" />
                                                    </div>
                                                </CellDisplayTemplate>
                                            </DxGridDataColumn>

                                        </Columns>
                                    </DxGrid>
                                }
                                else
                                {
                                    <div class="empty-docs" style="text-align:center;padding:20px;color:var(--clr-muted);">
                                        <i class="bi bi-folder-x" style="font-size:2rem;display:block;margin-bottom:8px;"></i>
                                        <span>No documents uploaded yet</span>
                                    </div>
                                }
                            </div>
                        </DxTabPage>

                        <!-- Other Details -->
                        <DxTabPage Text="Other Details">
                            <div class="lr-tab-body">

                                <div class="km-group">
                                    <div class="field-group">
                                        <label>Start KM</label>
                                        <DxTextBox @bind-Text="model.LrStartKm" />
                                    </div>
                                    <div class="field-group">
                                        <label>End KM</label>
                                        <DxTextBox @bind-Text="model.LrEndKm" />
                                    </div>
                                    <div class="field-group">
                                        <label>Total KM</label>
                                        <DxTextBox @bind-Text="model.LrTotKm" />
                                    </div>
                                </div>
                           </div>
                        </DxTabPage>

                        <!-- Policy Details -->
                        <DxTabPage Text="Policy Details">
                            <div class="lr-tab-body">
                                <p style="color:var(--clr-muted);font-size:.9rem;">No policy details available</p>
                            </div>
                        </DxTabPage>

                    </DxTabs>
                </div>

            <!-- ══ STICKY FOOTER ══ -->
            <div class="lr-footer">

                <div class="lr-footer-meta">
                    LR No: <strong>@(string.IsNullOrWhiteSpace(model.LrNoStr) ? "—" : model.LrNoStr)</strong>
                    &nbsp;|&nbsp;
                    Date: <strong>@(model.LrDate.HasValue? model.LrDate.Value.ToString("dd MMM yyyy") : "—")</strong>
                </div>

                <button type="submit" class="btn-save">✓ Save LR</button>
            </div>

        </EditForm>
    
    </div>

</div>

<FileUploadpopup IsVisible="@IsUploadPopupVisible" OnFilesSelected="HandleSelectedFiles"
                 @ref="uploadPopup"
                 IsVisibleChanged="@(v => IsUploadPopupVisible = v)"
                 DefaultCategory="@SelectedCategory"
                 DefaultSubCategory="@SelectedSubCategory"
                 DefaultReferenceId="@SelectedReferenceId" />

@code {

    private Lr model = new();
    private LRJournal lRJournal = new();
    DxGrid Grid;
    private List<Notify> notifylist = new();
    private List<Account> accountpartylist = new();
    private List<Account> accountSupplierlist = new();
    private List<Account> DriverList = new();
    private List<Location> LocationList = new();
    private List<Location> StationLocationList = new();
    private List<PayType> paytypeList = new();
    private List<Cargo> ProductList = new();
    List<Account> accountsList = new();
    public class SelectItem
    {
        public string Text { get; set; } = "";
        public string Value { get; set; } = "";
    }

    private readonly List<SelectItem> PaymethodList = new()
    {
        new SelectItem { Text = "To be Billed", Value = "To be Billed" },
        new SelectItem { Text = "To Pay",        Value = "To Pay"        },
        new SelectItem { Text = "Paid",          Value = "Paid"          },
    };

    protected override async Task OnInitializedAsync()
    {
        var notifyTask = NotifyService.GetAllAsync();
        var locationTask = LocationService.GetAllAsync();
        var accountTask = AccountService.GetAllAsync();
        var payTypeTask = PayTypeService.GetAllAsync();
        var cargoTask = CargoService.GetAllAsync();

        await Task.WhenAll(notifyTask, locationTask, accountTask, payTypeTask, cargoTask);

        notifylist = notifyTask.Result;
        paytypeList = payTypeTask.Result;
        ProductList = cargoTask.Result;

        LocationList = locationTask.Result;
        StationLocationList = LocationList
            .Where(x => string.Equals(x.LocationType, "STATION", StringComparison.OrdinalIgnoreCase))
            .ToList();

        accountpartylist = accountTask.Result;
        accountSupplierlist = accountpartylist.Where(x => x.AccountTypeId == 14).ToList();
        DriverList = accountpartylist.Where(x => x.AccountTypeId == 16).ToList();

        AssignDefaultImportRows();
    }

    private void OnConsignorChanged(int? notifyId)
    {
        model.LrConsignorNotifyId = notifyId;
        ApplyNotify(notifyId,
            addr => model.LrConsignorNotifyAddress = addr,
            gst => model.LrConsignorNotifyGst = gst,
            state => model.LrConsignorNotifyState = state);
    }

    private void OnConsigneeChanged(int? notifyId)
    {
        model.LrConsigneeNotifyId = notifyId;
        ApplyNotify(notifyId,
            addr => model.LrConsigneeNotifyAddress = addr,
            gst => model.LrConsigneeNotifyGst = gst,
            state => model.LrConsigneeNotifyState = state);
    }

    private void ApplyNotify(int? notifyId,
        Action<string> setAddress,
        Action<string?> setGst,
        Action<string?> setState)
    {
        var n = notifylist.FirstOrDefault(x => x.NotifyId == notifyId);
        setAddress(n is null ? string.Empty
            : $"{n.NotifyAddress1} {n.NotifyAddress2} {n.NotifyAddress3}".Trim());
        setGst(n?.GstNo);
        setState(n?.NotifyState);
    }

    List<LrProductRow> Rows = new();
    private LrProductRow? editingRow;

    void Grid_CustomizeEditModel(GridCustomizeEditModelEventArgs e)
    {
        editingRow = e.EditModel as LrProductRow;
    }

    void Grid_EditModelSaving(GridEditModelSavingEventArgs e)
    {
        var editedRow = (LrProductRow)e.EditModel;
        var dataRow = (LrProductRow)e.DataItem;

        dataRow.Product = editedRow.Product;
        dataRow.Unit = editedRow.Unit;
        dataRow.GrossWt = editedRow.GrossWt;
        dataRow.TareWt = editedRow.TareWt;
        dataRow.NetWt = editedRow.NetWt;
        dataRow.LoadWt = editedRow.LoadWt;
        dataRow.UnLoadWt = editedRow.UnLoadWt;
        dataRow.ChargeWt = editedRow.ChargeWt;
        dataRow.BillingRate = editedRow.BillingRate;
        dataRow.GrossFreight = editedRow.GrossFreight;
        dataRow.Amount = editedRow.Amount;
        // dataRow.InvNo = editedRow.InvNo;
        // dataRow.InvDate = editedRow.InvDate;
        // dataRow.InvValue = editedRow.InvValue;
        // dataRow.EWayBillNo = editedRow.EWayBillNo;
        // dataRow.EWayBillDate = editedRow.EWayBillDate;
        // dataRow.GpBeNo = editedRow.GpBeNo;
    }

    private void AssignDefaultImportRows()
    {
        Rows = new List<LrProductRow>(5);
        for (int i = 1; i <= 5; i++)
            Rows.Add(new LrProductRow { SrNo = i });
    }

    private void AddNew()
    {
        int nextSrNo = Rows.Count > 0 ? Rows.Max(r => r.SrNo) + 1 : 1;
        Rows.Add(new LrProductRow { SrNo = nextSrNo });
    }

    private void DeleteDataItem(object dataItem)
    {
        if (dataItem is LrProductRow row)
        {
            Rows.Remove(row);
            for (int i = 0; i < Rows.Count; i++)
                Rows[i].SrNo = i + 1;
        }
    }

    async Task RevertGridtransport_Click()
    {
        await Grid.CancelEditAsync();
        AssignDefaultImportRows();
    }

    private bool IsUploadPopupVisible;
    private string? SelectedCategory;
    private string? SelectedSubCategory;
    private string? SelectedReferenceId;
    private UploadedFileInfo? PreviewFile;
    private FileUploadpopup? uploadPopup;
    
    public class PendingUploadFile
    {
        public string FileName { get; set; } = "";
        public byte[] Content { get; set; } = Array.Empty<byte>();
    }
    
    private List<PendingUploadFile> PendingFiles = new();
    private List<UploadedFileInfo> UploadedDocs = new();

    private async Task Save()
    {
        try
        {
            var savedLr = await LrApiService.SaveAsync(model);

            if (savedLr == null)
            {
                ToastService.Error("Failed to save LR.");
                return;
            }

            model.LrId = savedLr.LrId;

            if (PendingFiles.Any())
            {
                foreach (var file in PendingFiles)
                {
                    await FileUploadService.UploadFileAsync(
                        file.Content,
                        file.FileName,
                        "LR",
                        model.LrNoStr ?? "",
                        model.LrId.ToString()
                    );
                }

                PendingFiles.Clear();
            }

            await LoadDocumentsAsync();

            ToastService.Success("LR and documents saved successfully.");
        }
        catch (Exception ex)
        {
            ToastService.Error($"Save failed: {ex.Message}");
        }
    }

    private async Task HandleSelectedFiles(List<IBrowserFile> files)
    {
        PendingFiles.Clear();

        foreach (var file in files)
        {
            using var ms = new MemoryStream();
            await file.OpenReadStream(10 * 1024 * 1024)
                      .CopyToAsync(ms);

            PendingFiles.Add(new PendingUploadFile
            {
                FileName = file.Name,
                Content = ms.ToArray()
            });
        }

        ToastService.Success($"{PendingFiles.Count} file(s) ready to upload.");
    }

    private async Task LoadDocumentsAsync()
    {
        if (string.IsNullOrEmpty(model.LrNoStr)) return;

        var docs = await FileUploadService.GetDocumentsAsync(
            "job",
            model.LrId.ToString()
        );

        UploadedDocs = docs.Select(d => new UploadedFileInfo
        {
            DocumentId = d.DocumentId,
            FileName = d.OriginalFileName,
            FileSize = d.FileSizeBytes,
            Url = d.BlobUrl,
            Category = d.Category
        }).ToList();

        StateHasChanged();
    }

    private async Task DeleteDoc(UploadedFileInfo file)
    {
        bool ok = await JS.InvokeAsync<bool>("confirm", $"Delete {file.FileName}?");
        if (!ok) return;

        var success = await FileUploadService.DeleteDocumentAsync(file.DocumentId);
        if (success)
        {
            await LoadDocumentsAsync();
        }
    }

    private async Task PreviewDoc(UploadedFileInfo file)
    {
        if (uploadPopup != null)
        {
            await uploadPopup.OpenPreview(file);
        }
    }

    private void OpenUploadPopup()
    {
        SelectedCategory = "LR";
        SelectedSubCategory = model.LrNoStr;
        SelectedReferenceId = model.LrId.ToString();

        IsUploadPopupVisible = true;
    }

    public class LrProductRow
    {
        public int SrNo { get; set; }
        public string? Product { get; set; }
        public int? Unit { get; set; }
        public decimal? GrossWt { get; set; }
        public decimal? TareWt { get; set; }
        public decimal? NetWt { get; set; }
        public decimal? LoadWt { get; set; }
        public decimal? UnLoadWt { get; set; }
        public decimal? ChargeWt { get; set; }
        public decimal? BillingRate { get; set; }
        public decimal? GrossFreight { get; set; }
        public decimal? Amount { get; set; }

    }
}
