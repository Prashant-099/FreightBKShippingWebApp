@code {

    // ─────────────────────────────────────────────────────────────────
    // LrProductRow  (UI-only view model for the Products grid)
    // ─────────────────────────────────────────────────────────────────

    public class LrProductRow
    {
        public int SrNo { get; set; }
        public string? ProductName { get; set; }
        public int ProductId { get; set; }
        public string? NtUnit { get; set; }
        public string? LrBillTypeBill { get; set; }

        public double? GrossWt { get; set; }
        public double? TareWt { get; set; }
        public decimal? NetWt { get; set; }
        public double? LoadWt { get; set; }
        public double? UnLoadWt { get; set; }
        public double? ChargeQty { get; set; }
        public double? RateBill { get; set; }
        public double? GrossFreight { get; set; }
        public decimal? NtQty { get; set; }
        public string? InvoiceNo { get; set; }
        public string? EwayBillNo { get; set; }
        public decimal? TotalBags { get; set; }
    }

    // ─────────────────────────────────────────────────────────────────
    // LRJournalRowVM  (UI-only view model for all journal grids)
    // ─────────────────────────────────────────────────────────────────

    public class LRJournalRowVM
    {
        public Guid RowId { get; set; } = Guid.NewGuid();

        // Common
        public int Sno { get; set; }
        public DateTime JournalDate { get; set; }
        public int? AccountId { get; set; }
        public decimal? Amount { get; set; }   // ✅ changed
        public string? Remarks { get; set; }

        // Diesel-specific
        public int? PumpBillId { get; set; }
        public decimal? UreaRate { get; set; }     // ✅ changed
        public decimal? UreaQty { get; set; }      // ✅ changed
        public decimal? UreaAmount { get; set; }   // ✅ changed

        // Optional
        public decimal? Rate { get; set; }     // ✅ changed
        public decimal? Qty { get; set; }      // ✅ changed
        public string? SlipNo { get; set; }

        // Backend tagging
        public string? JournalGroup { get; set; }
        public string? VchType { get; set; }
    }

    // ── Model & Lists ─────────────────────────────────────────────────

    private Lr model = new();

    private List<Notify> notifylist = new();
    private List<Account> accountpartylist = new();
    private List<Account> accountSupplierlist = new();
    private List<Account> DriverList = new();
    private List<Location> LocationList = new();
    private List<Location> StationLocationList = new();
    private List<PayType> paytypeList = new();
    private List<Cargo> ProductList = new();
    private List<Account> PumpList = new();
    private List<Account> ChargesList = new();
    private List<Account> ExpenseAccountList = new();
    private List<Account> BankCashList = new();

    public class BillTypeVM { public string Name { get; set; } = ""; }
    private List<BillTypeVM> BillTypeList = new()
    {
        new BillTypeVM { Name = "Fixed Rate" },
        new BillTypeVM { Name = "Rate X Weight" },
        new BillTypeVM { Name = "Rate X KM" },
        new BillTypeVM { Name = "Rate X UnloadWt" },
        new BillTypeVM { Name = "Rate X ChargeWt" }
    };

    public class SelectItem
    {
        public string Text { get; set; } = "";
        public string Value { get; set; } = "";
    }
    private readonly List<SelectItem> PaymethodList = new()
    {
        new SelectItem { Text = "To be Billed", Value = "To be Billed" },
        new SelectItem { Text = "To Pay",        Value = "To Pay"        },
        new SelectItem { Text = "Paid",          Value = "Paid"          },
    };

    // ── Init ──────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        InitializeAllGridRows();

        var notifyTask = NotifyService.GetAllAsync();
        var locationTask = LocationService.GetAllAsync();
        var accountTask = AccountService.GetAllAsync();
        var payTypeTask = PayTypeService.GetAllAsync();
        var cargoTask = CargoService.GetAllAsync();

        await Task.WhenAll(notifyTask, locationTask, accountTask, payTypeTask, cargoTask);

        notifylist = notifyTask.Result;
        paytypeList = payTypeTask.Result;
        ProductList = cargoTask.Result;
        LocationList = locationTask.Result;

        StationLocationList = LocationList.Where(x => x.LocationType == "STATION").ToList();

        accountpartylist = accountTask.Result;
        accountSupplierlist = accountpartylist.Where(x => x.AccountTypeId == 14).ToList();
        DriverList = accountpartylist.Where(x => x.AccountTypeId == 16).ToList();
        PumpList = accountpartylist.Where(x => x.AccountTypeId == 12).ToList();
        ChargesList = accountpartylist.Where(x => x.AccountTypeId == 20).ToList();
        ExpenseAccountList = accountpartylist.Where(x => x.AccountTypeId == 19).ToList();
        BankCashList = accountpartylist
            .Where(x => x.AccountTypeId == 10 || x.AccountTypeId == 11).ToList();
    }

    // ── Consignor / Consignee ─────────────────────────────────────────
    private void OnConsignorChanged(int? notifyId)
    {
        model.LrConsignorNotifyId = notifyId;
        ApplyNotify(notifyId,
            addr => model.LrConsignorNotifyAddress = addr,
            gst => model.LrConsignorNotifyGst = gst,
            state => model.LrConsignorNotifyState = state);
    }

    private void OnConsigneeChanged(int? notifyId)
    {
        model.LrConsigneeNotifyId = notifyId;
        ApplyNotify(notifyId,
            addr => model.LrConsigneeNotifyAddress = addr,
            gst => model.LrConsigneeNotifyGst = gst,
            state => model.LrConsigneeNotifyState = state);
    }

    private void ApplyNotify(int? notifyId,
        Action<string> setAddress, Action<string?> setGst, Action<string?> setState)
    {
        var n = notifylist.FirstOrDefault(x => x.NotifyId == notifyId);
        setAddress(n is null ? string.Empty
            : $"{n.NotifyAddress1} {n.NotifyAddress2} {n.NotifyAddress3}".Trim());
        setGst(n?.GstNo);
        setState(n?.NotifyState);
    }

    // ── Grid References ───────────────────────────────────────────────
    DxGrid ProductGrid;
    DxGrid AdvanceGrid;
    DxGrid DieselGrid;
    DxGrid ChargesGrid;
    DxGrid ExpenseGrid;
    DxGrid AdvanceReceivedGrid;

    // ── Grid Row Lists ────────────────────────────────────────────────
    private List<LrProductRow> ProductRows = new();
    private List<LRJournalRowVM> AdvanceRows = new();
    private List<LRJournalRowVM> DieselRows = new();
    private List<LRJournalRowVM> ChargesRows = new();
    private List<LRJournalRowVM> ExpenseRows = new();
    private List<LRJournalRowVM> AdvanceReceivedRows = new();

    private void InitializeAllGridRows()
    {
        if (!ProductRows.Any()) ProductRows = CreateProductRows(5);

        AdvanceRows = CreateJournalRows(LrJournalGroup.Advance, LrJournalVchType.Payment, 5);
        DieselRows = CreateJournalRows(LrJournalGroup.AdvanceFuel, LrJournalVchType.Payment, 5);
        ChargesRows = CreateJournalRows(LrJournalGroup.Charges, LrJournalVchType.Payment, 5);
        ExpenseRows = CreateJournalRows(LrJournalGroup.Payments, LrJournalVchType.Payment, 5);
        AdvanceReceivedRows = CreateJournalRows(LrJournalGroup.Advance, LrJournalVchType.Receipt, 5);
    }

    private List<LrProductRow> CreateProductRows(int count = 5)
    {
        var list = new List<LrProductRow>();
        for (int i = 1; i <= count; i++)
            list.Add(new LrProductRow { SrNo = i });
        return list;
    }

    private List<LRJournalRowVM> CreateJournalRows(
        LrJournalGroup group, LrJournalVchType vchType, int count = 5)
    {
        var list = new List<LRJournalRowVM>();
        for (int i = 1; i <= count; i++)
            list.Add(new LRJournalRowVM
            {
                Sno = i,
                JournalDate = DateTime.Now,
                JournalGroup = group.ToString(),
                VchType = vchType.ToString()
            });
        return list;
    }

    // ── Renumber helpers ──────────────────────────────────────────────
    private void RenumberJournal(List<LRJournalRowVM> list)
    {
        for (int i = 0; i < list.Count; i++) list[i].Sno = i + 1;
    }
    private void RenumberProducts()
    {
        for (int i = 0; i < ProductRows.Count; i++) ProductRows[i].SrNo = i + 1;
    }

