    private bool IsUploadPopupVisible;
    private string? SelectedCategory;
    private string? SelectedSubCategory;
    private string? SelectedReferenceId;
    private FileUploadpopup? uploadPopup;

    public class PendingUploadFile
    {
        public string FileName { get; set; } = "";
        public byte[] Content  { get; set; } = Array.Empty<byte>();
    }

    private List<PendingUploadFile> PendingFiles  = new();
    private List<UploadedFileInfo>  UploadedDocs  = new();

    private void OpenUploadPopup()
    {
        SelectedCategory    = "LR";
        SelectedSubCategory = model.LrNoStr;
        SelectedReferenceId = model.LrId.ToString();
        IsUploadPopupVisible = true;
    }

    private async Task HandleSelectedFiles(List<IBrowserFile> files)
    {
        PendingFiles.Clear();
        foreach (var file in files)
        {
            using var ms = new MemoryStream();
            await file.OpenReadStream(10 * 1024 * 1024).CopyToAsync(ms);
            PendingFiles.Add(new PendingUploadFile { FileName = file.Name, Content = ms.ToArray() });
        }
        ToastService.Success($"{PendingFiles.Count} file(s) ready to upload.");
    }

    private async Task LoadDocumentsAsync()
    {
        if (string.IsNullOrEmpty(model.LrNoStr)) return;
        var docs = await FileUploadService.GetDocumentsAsync("LR", model.LrId.ToString());
        UploadedDocs = docs.Select(d => new UploadedFileInfo
        {
            DocumentId = d.DocumentId,
            FileName   = d.OriginalFileName,
            FileSize   = d.FileSizeBytes,
            Url        = d.BlobUrl,
            Category   = d.Category,
        }).ToList();
        StateHasChanged();
    }

    private async Task DeleteDoc(UploadedFileInfo file)
    {
        bool ok = await JS.InvokeAsync<bool>("confirm", $"Delete {file.FileName}?");
        if (!ok) return;
        if (await FileUploadService.DeleteDocumentAsync(file.DocumentId))
            await LoadDocumentsAsync();
    }

    private async Task PreviewDoc(UploadedFileInfo file)
    {
        if (uploadPopup != null)
            await uploadPopup.OpenPreview(file);
    }

    // ══════════════════════════════════════════════════════════════════
    // SAVE
    // ══════════════════════════════════════════════════════════════════
    private async Task Save()
    {
        try
        {
            List<LRDetail>  details  = BuildDetails();
            List<LRJournal> journals = BuildJournals();

            var savedLr = await LrApiService.SaveAsync(model, details, journals);

            if (savedLr == null)
            {
                ToastService.Error("Failed to save LR.");
                return;
            }

            model.LrId = savedLr.LrId;

            if (PendingFiles.Any())
            {
                foreach (var file in PendingFiles)
                    await FileUploadService.UploadFileAsync(
                        file.Content, file.FileName, "LR",
                        model.LrNoStr ?? "", model.LrId.ToString());
                PendingFiles.Clear();
            }

            await LoadDocumentsAsync();
            ToastService.Success(IsEditMode ? "LR updated successfully." : "LR saved successfully.");
                                AuditLogService.NotifyAuditChanged();

            if (!IsEditMode)
                NavManager.NavigateTo($"/lrentry/{model.LrId}", replace: true);
        }
        catch (Exception ex)
        {
            ToastService.Error($"Save failed: {ex.Message}");
        }
    }

    // ══════════════════════════════════════════════════════════════════
    // CALCULATIONS
    // ══════════════════════════════════════════════════════════════════
    private void RecalculateEditRow(LrProductRow edit)
    {
        if (edit == null) return;
        decimal rate     = Convert.ToDecimal(edit.RateBill  ?? 0);
        decimal netWt    = Convert.ToDecimal(edit.NetWt     ?? 0);
        decimal unloadWt = Convert.ToDecimal(edit.UnLoadWt  ?? 0);
        decimal chargeWt = Convert.ToDecimal(edit.ChargeQty ?? 0);
        decimal.TryParse(model.LrStartKm, out decimal startKm);
        decimal.TryParse(model.LrEndKm,   out decimal endKm);
        decimal km = Math.Max(0, endKm - startKm);
        decimal total = edit.LrBillTypeBill switch
        {
            "Fixed Rate"      => rate,
            "Rate X Weight"   => rate * netWt,
            "Rate X KM"       => rate * km,
            "Rate X UnloadWt" => rate * unloadWt,
            "Rate X ChargeWt" => rate * chargeWt,
            _                 => 0m
        };
        edit.GrossFreight = Convert.ToDouble(total);

        var existing = ProductRows?.FirstOrDefault(r => r.SrNo == edit.SrNo);
        if (existing != null)
        {
            existing.GrossFreight   = edit.GrossFreight;
            existing.NetWt          = edit.NetWt;
            existing.RateBill       = edit.RateBill;
            existing.LoadWt         = edit.LoadWt;
            existing.UnLoadWt       = edit.UnLoadWt;
            existing.ChargeQty      = edit.ChargeQty;
            existing.LrBillTypeBill = edit.LrBillTypeBill;
        }
    }

    private void RecalculateRow(LrProductRow row)
    {
        if (row == null) return;
        decimal rate     = Convert.ToDecimal(row.RateBill  ?? 0);
        decimal netWt    = Convert.ToDecimal(row.NetWt     ?? 0);
        decimal unloadWt = Convert.ToDecimal(row.UnLoadWt  ?? 0);
        decimal chargeWt = Convert.ToDecimal(row.ChargeQty ?? 0);
        decimal.TryParse(model.LrStartKm, out decimal startKm);
        decimal.TryParse(model.LrEndKm,   out decimal endKm);
        decimal km = Math.Max(0, endKm - startKm);
        decimal total = row.LrBillTypeBill switch
        {
            "Fixed Rate"      => rate,
            "Rate X Weight"   => rate * netWt,
            "Rate X KM"       => rate * km,
            "Rate X UnloadWt" => rate * unloadWt,
            "Rate X ChargeWt" => rate * chargeWt,
            _                 => 0m
        };
        row.GrossFreight = Convert.ToDouble(total);
    }

    private decimal? StartKm
    {
        get => decimal.TryParse(model.LrStartKm, out var v) ? v : (decimal?)null;
        set { model.LrStartKm = value?.ToString() ?? "0"; UpdateKmAndRecalculate(); }
    }

    private decimal? EndKm
    {
        get => decimal.TryParse(model.LrEndKm, out var v) ? v : (decimal?)null;
        set { model.LrEndKm = value?.ToString() ?? "0"; UpdateKmAndRecalculate(); }
    }

    private decimal? TotKm
    {
        get => decimal.TryParse(model.LrTotKm, out var v) ? v : (decimal?)null;
        set { }
    }

    private void UpdateKmAndRecalculate()
    {
        decimal.TryParse(model.LrStartKm?.ToString(), out decimal start);
        decimal.TryParse(model.LrEndKm?.ToString(),   out decimal end);
        decimal total = Math.Max(0, end - start);
        model.LrTotKm = total.ToString();
        RecalculateAllRows();
        StateHasChanged();
    }

    private void RecalculateAllRows()
    {
        foreach (var row in ProductRows)
            RecalculateRow(row);
        StateHasChanged();
    }

    private void OnStartKmChanged(decimal? value)
    {
        model.LrStartKm = value?.ToString();
        UpdateKmAndRecalculate();
    }

    private void OnEndKmChanged(decimal? value)
    {
        model.LrEndKm = value?.ToString();
        UpdateKmAndRecalculate();
    }
