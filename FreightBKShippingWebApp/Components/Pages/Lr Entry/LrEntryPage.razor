    void Product_CustomizeEditModel(GridCustomizeEditModelEventArgs e)
    {
        // EditModel ko DataItem ka same reference banao
        // Taaki CellEditTemplate mein changes turant reflect hon
        if (e.DataItem is LrProductRow original)
        {
            // Copy current values into edit model
            var edit = (LrProductRow)e.EditModel;
            edit.ProductId = original.ProductId;
            edit.ProductName = original.ProductName;
            edit.NtUnit = original.NtUnit;
            edit.LrBillTypeBill = original.LrBillTypeBill;
            edit.GrossWt = original.GrossWt;
            edit.TareWt = original.TareWt;
            edit.NetWt = original.NetWt;
            edit.LoadWt = original.LoadWt;
            edit.UnLoadWt = original.UnLoadWt;
            edit.ChargeQty = original.ChargeQty;
            edit.RateBill = original.RateBill;
            edit.GrossFreight = original.GrossFreight;
            edit.TotalBags = original.TotalBags;
            edit.NtQty = original.NtQty;
            edit.InvoiceNo = original.InvoiceNo;
            edit.EwayBillNo = original.EwayBillNo;
        }
    }
    void Product_EditModelSaving(GridEditModelSavingEventArgs e)
    {
        var edited = (LrProductRow)e.EditModel;
        var data = (LrProductRow)e.DataItem;

        // Copy all editable fields
        data.ProductId = edited.ProductId;
        data.ProductName = edited.ProductName;
        data.NtUnit = edited.NtUnit;
        data.LrBillTypeBill = edited.LrBillTypeBill;
        data.GrossWt = edited.GrossWt;
        data.TareWt = edited.TareWt;
        data.LoadWt = edited.LoadWt;
        data.UnLoadWt = edited.UnLoadWt;
        data.ChargeQty = edited.ChargeQty;
        data.RateBill = edited.RateBill;
        data.NtQty = edited.NtQty;
        data.InvoiceNo = edited.InvoiceNo;
        data.EwayBillNo = edited.EwayBillNo;
        data.TotalBags = edited.TotalBags;

        // Auto-calculate NetWt
        data.NetWt = Convert.ToDecimal(data.GrossWt ?? 0)
                   - Convert.ToDecimal(data.TareWt ?? 0);

        // Auto-calculate GrossFreight based on BillType
        RecalculateRow(data);

        StateHasChanged();
    }

    void AddNewProduct()
    {
        int next = ProductRows.Count > 0 ? ProductRows.Max(r => r.SrNo) + 1 : 1;
        ProductRows.Add(new LrProductRow { SrNo = next });
        StateHasChanged();
    }

    void DeleteProductRow(LrProductRow row)
    {
        ProductRows.Remove(row);
        RenumberProducts();
        StateHasChanged();
    }

    async Task RevertProductGrid()
    {
        await ProductGrid.CancelEditAsync();
        ProductRows = CreateProductRows(5);
    }

    /// <summary>Copies first-row data into Lr.main summary fields.</summary>
    private void ApplyProductRowsToModel()
    {
        var first = ProductRows.FirstOrDefault(r =>
            r.GrossWt.HasValue || r.TareWt.HasValue || !string.IsNullOrWhiteSpace(r.ProductName));

        if (first is null) return;

        model.LrGrossWt = first.GrossWt;
        model.LrTareWt = first.TareWt;
        model.LrNtNetWt = first.NetWt;
        model.LrLoadWt = first.LoadWt ?? 0;
        model.LrUnloadWt = first.UnLoadWt ?? 0;
        model.LrChargeQty = first.ChargeQty ?? 0;
        model.LrRateBill = first.RateBill ?? 0;
        model.LrGrossFreightBill = first.GrossFreight ?? 0;
        model.LrNtQty = first.NtQty;
        model.LrNtUnit = first.NtUnit;
        model.LrInvoiceNo = first.InvoiceNo;
        model.LrEwayBillNo = first.EwayBillNo;
        model.LrTotalBags = first.TotalBags ?? 0;
        model.LrRemarks = first.ProductName;
    }

