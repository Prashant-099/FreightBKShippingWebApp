@using FreightBKShippingWebApp.Services
@using FreightBKShippingWebApp.Model
@using System.ComponentModel.DataAnnotations
@inject ToasteService ToastService
@inject VoucherService VoucherService
@inject AccountService AccountService
<style>
    .date-filter-body {
        padding: 0.5rem;
    }

    .quick-filters {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 1rem;
        padding: 0.75rem;
        background: #f8f9fa;
        border-radius: 8px;
    }

    .quick-filter-btn {
        padding: 0.4rem 0.8rem;
        border-radius: 6px;
        font-size: 0.85rem;
        border: 1px solid #dee2e6;
        background: white;
        color: #495057;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .quick-filter-btn:hover {
            background: #667eea;
            color: white;
            border-color: #667eea;
        }

    .error-text {
        color: #dc3545;
        font-size: 0.875rem;
        margin-top: 0.5rem;
    }
</style>

<DxPopup @bind-Visible="Visible"
         ShowCloseButton="true"
         HeaderText="@Title"
         MaxWidth="550"
         CloseOnOutsideClick="false"
         HorizontalAlignment="HorizontalAlignment.Center"
         VerticalAlignment="VerticalAlignment.Center"
         BodyCssClass="date-filter-body"
         ShowFooter="true">

    <BodyContentTemplate Context="bdydt">
        <EditForm EditContext="@editContext" OnValidSubmit="HandleValidSubmit" Context="ctxeditform" id="dateFilterForm">
            <DataAnnotationsValidator />
           
            <!-- Quick Filter Buttons -->
            <div class="quick-filters">
                <button type="button" class="quick-filter-btn" @onclick="SetToday">
                    <i class="bi bi-calendar-day me-1"></i>Today
                </button>
                <button type="button" class="quick-filter-btn" @onclick="SetYesterday">
                    <i class="bi bi-calendar-minus me-1"></i>Yesterday
                </button>
                <button type="button" class="quick-filter-btn" @onclick="SetThisWeek">
                    <i class="bi bi-calendar-week me-1"></i>This Week
                </button>
                <button type="button" class="quick-filter-btn" @onclick="SetThisMonth">
                    <i class="bi bi-calendar-month me-1"></i>This Month
                </button>
                <button type="button" class="quick-filter-btn" @onclick="SetLastMonth">
                    <i class="bi bi-calendar3 me-1"></i>Last Month
                </button>
                <button type="button" class="quick-filter-btn" @onclick="SetThisQuarter">
                    <i class="bi bi-calendar3 me-1"></i>This Quarter
                </button>
            </div>
          
             
            <DxFormLayout>
                @if (ShowOutstandingTypeFilter)
                {
                    <DxFormLayoutItem Caption="Type">
                        <ChildContent Context="ctx">
                            <DxComboBox Data="@OutstandingTypeslist"
                                        @bind-Value="EditModel.SelectedOutstandingType"
                                        NullText="All Types"
                                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                        SizeMode="SizeMode.Small" />
                        </ChildContent>
                    </DxFormLayoutItem>
                }
                @if (ShowJobTypeFilter)
                {
                    <DxFormLayoutItem Caption="Job Type">
                        <ChildContent Context="ctx">
                            <DxComboBox Data="@jobTypeslist"
                                @bind-Value="EditModel.SelectedJobType"
                                NullText="All Types"
                                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                SizeMode="SizeMode.Small" />
                            </ChildContent>
                </DxFormLayoutItem>
                }
                @if (ShowVoucherTypeFilter)
                {
                    <DxFormLayoutItem Caption="Voucher Type">
                        <ChildContent Context="ctx">
                            <DxComboBox Data="@voucherTypes" TData="Voucher" TValue="int?"
                                        @bind-Value="EditModel.SelectedVoucherType"
                                        NullText="All Vouchers"
                                        TextFieldName="VoucherName"
                                        ValueFieldName="VoucherId"
                                        AllowUserInput="true"
                                        SearchMode="ListSearchMode.AutoSearch"
                                        SearchFilterCondition="ListSearchFilterCondition.Contains"
                                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                        </ChildContent>
                    </DxFormLayoutItem>
                }
                @if (ShowAccountFilter)
                {
                    <DxFormLayoutItem Caption="Accounts">
                        <ChildContent Context="ctx">
                            <DxComboBox Data="@AccountList" TData="Account" TValue="int?"
                                        @bind-Value="EditModel.SelectedAccount"
                                        NullText="Select Account"
                                        TextFieldName="AccountName"
                                        ValueFieldName="AccountId"
                                        AllowUserInput="true"
                                        SearchMode="ListSearchMode.AutoSearch"
                                        SearchFilterCondition="ListSearchFilterCondition.Contains"
                                        ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                        </ChildContent>
                    </DxFormLayoutItem>
                }
                <DxFormLayoutItem Caption="From Date">
                    <ChildContent Context="ctx">
                        <DxDateEdit @bind-Date="EditModel.FromDate"
                                    DisplayFormat="dd/MM/yyyy"
                                    ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                    NullText="Select start date..." />
                    </ChildContent>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="To Date">
                    <ChildContent Context="ctx">
                        <DxDateEdit @bind-Date="EditModel.ToDate"
                                    DisplayFormat="dd/MM/yyyy"
                                    ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                    NullText="Select end date..." />
                    </ChildContent>
                </DxFormLayoutItem>
            </DxFormLayout>
            <ValidationMessage For="@(() => EditModel.FromDate)" />
            <ValidationMessage For="@(() => EditModel.ToDate)" />
            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="error-text">
                    <i class="bi bi-exclamation-circle me-1"></i>@ErrorMessage
                </div>
            }
        </EditForm>
    </BodyContentTemplate>

    <FooterContentTemplate Context="ftrdt">
        <div class="mt-3 text-end">
            <DxButton Text="Clear" RenderStyle="ButtonRenderStyle.Secondary" Click="ClearFilter" />
            <DxButton Text="Apply" RenderStyle="ButtonRenderStyle.Primary" SubmitFormOnClick="true" Form="dateFilterForm" />
           @*  <DxButton Text="Cancel" RenderStyle="ButtonRenderStyle.Secondary" Click="Hide" /> *@
        </div>
    </FooterContentTemplate>
</DxPopup>

@code {
    private EditContext? editContext;

    [Parameter] public EventCallback<(DateTime? FromDate, DateTime? ToDate, string? JobType, int? Vouchertype, string? ShowOutstandingTypeFilter, int? Account)> OnFilterApplied { get; set; }
    [Parameter] public bool ShowJobTypeFilter { get; set; } = false;
    [Parameter] public bool ShowVoucherTypeFilter { get; set; } = false;
    [Parameter] public bool ShowAccountFilter { get; set; } = false;
    [Parameter] public bool ShowOutstandingTypeFilter { get; set; } = false;
    private bool Visible { get; set; }
    private string Title { get; set; } = "Filter by Date Range";
    private DateFilterModel EditModel { get; set; } = new();
    private string ErrorMessage { get; set; } = string.Empty;
    private List<string> jobTypeslist = new() { "IMPORT", "EXPORT" };
    private List<string> OutstandingTypeslist = new() { "RECEIVABLE", "PAYABLE" };
    private List<Voucher> voucherTypes = new();
    private List<Account> AccountList = new();
    public void Show(DateTime? fromDate, DateTime? toDate, string? SelectedJobType, int? vouchertype, string? outstandingType, int? Accounts)
    {
        EditModel = new DateFilterModel
        {
            FromDate = fromDate,
            ToDate = toDate,
            SelectedJobType = SelectedJobType,
            SelectedVoucherType = vouchertype,
            SelectedOutstandingType = outstandingType,
            SelectedAccount = Accounts,
        };

        editContext = new EditContext(EditModel);
        ErrorMessage = string.Empty;
        Visible = true;
    }

    private void Hide()
    {
        Visible = false;
        ErrorMessage = string.Empty;
    }
    protected override async Task OnInitializedAsync()
    {
        if (ShowVoucherTypeFilter == true)
        {
            voucherTypes = (await VoucherService.GetAllAsync()).Where(v =>
    !string.IsNullOrWhiteSpace(v.VoucherGroup) &&
    (
        v.VoucherGroup.Trim().Equals("SALES", StringComparison.OrdinalIgnoreCase) ||
        v.VoucherGroup.Trim().Equals("CREDIT NOTE", StringComparison.OrdinalIgnoreCase) ||
        v.VoucherGroup.Trim().Equals("DEBIT NOTE", StringComparison.OrdinalIgnoreCase) ||
        v.VoucherGroup.Trim().Equals("PURCHASE", StringComparison.OrdinalIgnoreCase)
    ))
.ToList();

        }

        if (ShowAccountFilter == true)
        {
            AccountList = await AccountService.GetAllAsync();
        }
    }
    private async Task HandleValidSubmit()
    {
        ErrorMessage = string.Empty;

        // Validation
        if (EditModel.FromDate.HasValue && EditModel.ToDate.HasValue)
        {
            if (EditModel.FromDate.Value > EditModel.ToDate.Value)
            {
                ErrorMessage = "From Date cannot be greater than To Date";
                return;
            }
        }

        // Invoke callback
        if (OnFilterApplied.HasDelegate)
        {
            await OnFilterApplied.InvokeAsync((EditModel.FromDate, EditModel.ToDate, EditModel.SelectedJobType, EditModel.SelectedVoucherType, EditModel.SelectedOutstandingType, EditModel.SelectedAccount));
        }

        ToastService.Success("Date filter applied successfully!");
        Visible = false;
    }

    private async Task ClearFilter()
    {
        EditModel.FromDate = null;
        EditModel.ToDate = null;
        ErrorMessage = string.Empty;

        if (OnFilterApplied.HasDelegate)
        {
            await OnFilterApplied.InvokeAsync((null, null, null,null,null,null));
        }

        ToastService.Info("Date filter cleared.");
        Visible = false;
    }

    // Quick Filter Methods
    private void SetToday()
    {
        EditModel.FromDate = DateTime.Today;
        EditModel.ToDate = DateTime.Today;
        ErrorMessage = string.Empty;
    }

    private void SetYesterday()
    {
        EditModel.FromDate = DateTime.Today.AddDays(-1);
        EditModel.ToDate = DateTime.Today.AddDays(-1);
        ErrorMessage = string.Empty;
    }

    private void SetThisWeek()
    {
        var today = DateTime.Today;
        var startOfWeek = today.AddDays(-(int)today.DayOfWeek);
        EditModel.FromDate = startOfWeek;
        EditModel.ToDate = DateTime.Today;
        ErrorMessage = string.Empty;
    }

    private void SetThisMonth()
    {
        var today = DateTime.Today;
        EditModel.FromDate = new DateTime(today.Year, today.Month, 1);
        EditModel.ToDate = DateTime.Today;
        ErrorMessage = string.Empty;
    }

    private void SetLastMonth()
    {
        var today = DateTime.Today;
        var lastMonth = today.AddMonths(-1);
        EditModel.FromDate = new DateTime(lastMonth.Year, lastMonth.Month, 1);
        EditModel.ToDate = new DateTime(lastMonth.Year, lastMonth.Month, DateTime.DaysInMonth(lastMonth.Year, lastMonth.Month));
        ErrorMessage = string.Empty;
    }
    private void SetThisQuarter()
    {
        var today = DateTime.Today;
        int year = today.Year;

        DateTime fromDate;
        DateTime toDate;

        if (today.Month >= 4 && today.Month <= 6)        // Q1
            fromDate = new DateTime(year, 4, 1);
        else if (today.Month >= 7 && today.Month <= 9)   // Q2
            fromDate = new DateTime(year, 7, 1);
        else if (today.Month >= 10 && today.Month <= 12) // Q3
            fromDate = new DateTime(year, 10, 1);
        else                                             // Q4 (Jan–Mar)
            fromDate = new DateTime(year, 1, 1);

        toDate = fromDate.AddMonths(3).AddDays(-1);

        EditModel.FromDate = fromDate;
        EditModel.ToDate = toDate;
        ErrorMessage = string.Empty;
    }
    // Model Class
    public class DateFilterModel
    {
        [CustomValidation(typeof(YearStatechangeService), nameof(YearStatechangeService.ValidateDateWithinYear))]
        public DateTime? FromDate { get; set; } 

        [CustomValidation(typeof(YearStatechangeService), nameof(YearStatechangeService.ValidateDateWithinYear))]
        public DateTime? ToDate { get; set; }
        public string? SelectedJobType { get; set; }
        public int? SelectedVoucherType { get; set; }
        public string? SelectedOutstandingType { get; set; }
        public int? SelectedAccount { get; set; }
    }
}