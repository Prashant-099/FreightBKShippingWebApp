@using FreightBKShippingWebApp.Model
@using FreightBKShippingWebApp.Services
@inject GridLayoutService GridLayoutService
@inject ToasteService ToastService
@inject LoadingService LoadingService
@inject ConfirmationDialogService ConfirmDialogService

<style>
   

    .layout-table-scroll {
        max-height: 210px;
        overflow-y: auto;
    }

        .layout-table-scroll thead th {
            position: sticky;
            top: 0;
            background: #f8f9fa;
            z-index: 5;
        }

   
</style>

@if (showLayoutPopup)
{
    <DxPopup @bind-Visible="showLayoutPopup"
             ShowCloseButton="true"
             HeaderText="@dialogTitle"
             CloseOnOutsideClick="false"
             MaxWidth="500"
             Width="80vw"
             MaxHeight="90vh"
             HorizontalAlignment="HorizontalAlignment.Center"
             VerticalAlignment="VerticalAlignment.Center"
             ShowFooter="true"
             Scrollable="true">

        <BodyContentTemplate>
            <div class="p-0">
                <!-- ComboBox -->
                <DxComboBox Data="@availableLayouts"
                            Value="@selectedLayoutId"
                            ValueExpression="@(() => selectedLayoutId)"
                            ValueChanged="@((int? value) => OnLayoutSelectedAsync(value))"
                            ValueFieldName="GridLayoutId"
                            TextFieldName="GridLayoutName"
                            NullText="Default View"
                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                            CssClass="mb-3 w-100" />

                <!-- Layout Name Input -->
                <div class="mb-3">
                    <label class="form-label fw-bold">Layout Name:</label>
                    <input type="text"
                           class="form-control"
                           @bind="newLayoutName"
                           @bind:event="oninput"
                           placeholder="Enter layout name..."
                           maxlength="100" />
                </div>

                <!-- Default Checkbox -->
                <div class="mb-3">
                    <div class="form-check">
                        <input class="form-check-input"
                               type="checkbox"
                               @bind="isDefaultLayout"
                               id="defaultLayoutCheck" />
                        <label class="form-check-label" for="defaultLayoutCheck">
                            Set as Default Layout
                        </label>
                    </div>
                </div>

                <!-- Column Configuration Table -->
                <div class="mt-3">
                    <div class="layout-table-scroll table-responsive" style="max-height: 300px; overflow-y: auto;">
                        <table class="table table-sm table-bordered table-hover">
                            <thead class="table-light" style="position: sticky; top: 0; z-index: 10; background: #f8f9fa;">
                                <tr>
                                    <th style="width: 80px;" class="text-center">Visible</th>
                                    <th style="width: 250px;">Column Name</th>
                                    <th style="width: 150px;">Width (px)</th>
                                    <th>Preview</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var col in allColumns.OrderBy(c => c.DisplayIndex))
                                {
                                    <tr>
                                        <td class="text-center align-middle">
                                            <input class="form-check-input"
                                                   type="checkbox"
                                                   @bind="col.Visible"
                                                   id="col_@col.FieldName" />
                                        </td>
                                        <td class="align-middle">
                                            <label class="mb-0 fw-semibold" for="col_@col.FieldName">
                                                @col.Caption
                                            </label>
                                        </td>
                                        <td class="align-middle">
                                            <input type="number"
                                                   class="form-control form-control-sm"
                                                   @bind="col.Width"
                                                   @bind:event="oninput"
                                                   min="50"
                                                   max="800"
                                                   step="10"
                                                   placeholder="Width"
                                                   disabled="@(!col.Visible)" />
                                        </td>
                                        <td class="align-middle">
                                            <span class="badge @(col.Visible ? "bg-success" : "bg-secondary")">
                                                @(col.Visible ? $"{col.Width}px" : "Hidden")
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </BodyContentTemplate>

        <FooterContentTemplate>
            <div class="d-flex justify-content-between w-100 px-3 py-2">
                <!-- Left Side Buttons -->
                <div>
                    <DxButton Text="New"
                              IconCssClass="bi bi-plus-circle"
                              RenderStyle="ButtonRenderStyle.Success"
                              Click="ShowNewLayoutDialog"
                              CssClass="me-2" />

                    @if (selectedLayoutId.HasValue)
                    {
                        <DxButton Text="Delete"
                                  IconCssClass="bi bi-trash"
                                  RenderStyle="ButtonRenderStyle.Danger"
                                  Click="DeleteCurrentLayout" />
                    }
                </div>

                <!-- Right Side Buttons -->
                <div>
                    <DxButton Text="Cancel"
                              RenderStyle="ButtonRenderStyle.Secondary"
                              Click="ClosePopup"
                              CssClass="me-2" />

                    <DxButton Text="@(isEditMode ? "Update" : "Save")"
                              IconCssClass="bi bi-floppy"
                              RenderStyle="ButtonRenderStyle.Primary"
                              Click="SaveCurrentLayout" />
                </div>
            </div>
        </FooterContentTemplate>

    </DxPopup>

   
}


@code {
    private void ClosePopup()
    {
        showLayoutPopup = false;
        newLayoutName = "";
        isDefaultLayout = false;
        isEditMode = false;
        StateHasChanged();
    }

    public async Task ShowPopup()
    {
        showLayoutPopup = true;
        OnLayoutSelectedAsync(selectedLayoutId);
        StateHasChanged();
    }

    bool showLayoutPopup;

    [Parameter] public string VoucherType { get; set; } = string.Empty;
    [Parameter] public List<GridColumnLayout> Columns { get; set; } = new();
    [Parameter] public EventCallback<List<GridColumnLayout>> OnLayoutChanged { get; set; }

    private List<GridLayoutDto> availableLayouts = new();
    private int? selectedLayoutId;

    private string newLayoutName = "";
    private string dialogTitle = "Grid Layout";
    private bool isEditMode = false;
    private bool isDefaultLayout = false;

    private List<GridColumnLayout> allColumns = new();
    private List<GridColumnLayout> currentLayout = new();

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(VoucherType))
        {
            throw new InvalidOperationException("VoucherType parameter is required");
        }

        InitializeColumns();
        await LoadAvailableLayouts();
        await LoadDefaultLayout();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (allColumns == null || !allColumns.Any())
        {
            allColumns = Columns.Select(c => new GridColumnLayout
            {
                FieldName = c.FieldName,
                Caption = c.Caption,
                Visible = c.Visible,
                Width = c.Width,
                DisplayIndex = c.DisplayIndex
            }).ToList();

            currentLayout = allColumns
                .Select(c => new GridColumnLayout
                {
                    FieldName = c.FieldName,
                    Caption = c.Caption,
                    Visible = c.Visible,
                    Width = c.Width,
                    DisplayIndex = c.DisplayIndex
                }).ToList();
        }
    }

    public string GetColumnWidth(string fieldName)
    {
        if (currentLayout == null || !currentLayout.Any())
        {
            var defaultCol = allColumns.FirstOrDefault(x => x.FieldName == fieldName);
            return $"{defaultCol?.Width ?? 100}px";
        }

        var col = currentLayout.FirstOrDefault(x => x.FieldName == fieldName);
        return $"{col?.Width ?? 100}px";
    }

    public bool GetColumnVisibility(string fieldName)
    {
        if (currentLayout == null || !currentLayout.Any())
        {
            return true;
        }

        var col = currentLayout.FirstOrDefault(x => x.FieldName == fieldName);
        return col?.Visible ?? true;
    }

    public void ShowSaveLayoutDialog()
    {
        if (selectedLayoutId.HasValue)
        {
            var layout = availableLayouts.FirstOrDefault(x => x.GridLayoutId == selectedLayoutId.Value);
            if (layout != null)
            {
                newLayoutName = layout.GridLayoutName ?? "";
                isDefaultLayout = layout.GridLayoutDefault;
                isEditMode = true;
                dialogTitle = "Update Grid Layout";
                showLayoutPopup = true;
                StateHasChanged();
                return;
            }
        }

        ShowNewLayoutDialog();
    }

    public void ShowNewLayoutDialog()
    {
        selectedLayoutId = null;
        newLayoutName = "";
        isDefaultLayout = false;
        isEditMode = false;
        dialogTitle = "Create Grid Layout";
        StateHasChanged();
    }

    public async Task DeleteCurrentLayout()
    {
        if (!selectedLayoutId.HasValue)
        {
            ToastService.Warning("No layout selected to delete.");
            return;
        }

        var confirm = await ConfirmDialogService.ShowAsync(
            "Are you sure you want to delete this grid layout?");

        if (!confirm) return;

        LoadingService.Show("Deleting layout...");
        try
        {
            var success = await GridLayoutService.DeleteAsync(selectedLayoutId.Value);

            if (success)
            {
                ToastService.Success("Grid layout deleted successfully!");

                selectedLayoutId = null;
                InitializeColumns();
                currentLayout = allColumns.ToList();

                await LoadAvailableLayouts();

                // ✅ CRITICAL: Notify parent to refresh UI
                await NotifyLayoutChanged();
                await InvokeAsync(StateHasChanged);
            }
            else
            {
                ToastService.Error("Failed to delete grid layout.");
            }
        }
        catch (Exception ex)
        {
            ToastService.Error($"Error deleting layout: {ex.Message}");
        }
        finally
        {
            LoadingService.Hide();
        }
    }

    private void InitializeColumns()
    {
        if (Columns != null && Columns.Any())
        {
            allColumns = Columns.ToList();
            currentLayout = Columns.ToList();
        }
    }

    private async Task LoadAvailableLayouts()
    {
        availableLayouts = await GridLayoutService.GetLayoutsByVoucherTypeAsync(VoucherType);
    }

    private async Task LoadDefaultLayout()
    {
        var defaultLayout = await GridLayoutService.GetDefaultLayoutAsync(VoucherType);
        if (defaultLayout != null)
        {
            selectedLayoutId = defaultLayout.GridLayoutId;
            await ApplyLayout(defaultLayout);
        }
    }

    private async Task OnLayoutSelectedAsync(int? layoutId)
    {
        selectedLayoutId = layoutId;

        if (layoutId.HasValue)
        {
            var layout = await GridLayoutService.GetByIdAsync(layoutId.Value);
            if (layout != null)
            {
                newLayoutName = layout.GridLayoutName;
                isDefaultLayout = layout.GridLayoutDefault;
                isEditMode = true;
                dialogTitle = "Update Grid Layout";

                await ApplyLayout(layout);
            }
        }
        else
        {
            // Default view - Reset to original column definitions
            isEditMode = false;
            newLayoutName = "";
            isDefaultLayout = false;
            dialogTitle = "Grid Layout";
            if (Columns != null && Columns.Any())
            {
                allColumns = Columns.Select(c => new GridColumnLayout
                {
                    FieldName = c.FieldName,
                    Caption = c.Caption,
                    Visible = c.Visible,
                    Width = c.Width,
                    DisplayIndex = c.DisplayIndex
                }).ToList();

                currentLayout = Columns.Select(c => new GridColumnLayout
                {
                    FieldName = c.FieldName,
                    Caption = c.Caption,
                    Visible = c.Visible,
                    Width = c.Width,
                    DisplayIndex = c.DisplayIndex
                }).ToList();
            }

            // ✅ CRITICAL: Notify parent when switching to default
            await NotifyLayoutChanged();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ApplyLayout(GridLayoutDto layout)
    {
        if (!string.IsNullOrEmpty(layout.GridLayoutData))
        {
            var savedLayout = GridLayoutService.DeserializeColumnLayout(layout.GridLayoutData);
            if (savedLayout != null && savedLayout.Any())
            {
                currentLayout = savedLayout.Select(s => new GridColumnLayout
                {
                    FieldName = s.FieldName,
                    Caption = s.Caption,
                    Visible = s.Visible,
                    Width = s.Width,
                    DisplayIndex = s.DisplayIndex
                }).ToList();
                allColumns = savedLayout.Select(c => new GridColumnLayout
                {
                    FieldName = c.FieldName,
                    Caption = c.Caption,
                    Visible = c.Visible,
                    Width = c.Width,
                    DisplayIndex = c.DisplayIndex
                }).ToList();

                foreach (var saved in savedLayout)
                {
                    var existing = allColumns.FirstOrDefault(x => x.FieldName == saved.FieldName);
                    if (existing != null)
                    {
                        existing.Visible = saved.Visible;
                        existing.Width = saved.Width;
                        existing.DisplayIndex = saved.DisplayIndex;
                    }
                }

                // ✅ CRITICAL: Notify parent after applying layout
                await NotifyLayoutChanged();
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task SaveCurrentLayout()
    {
        if (string.IsNullOrWhiteSpace(newLayoutName))
        {
            ToastService.Warning("Please enter a layout name.");
            return;
        }

        LoadingService.Show("Saving layout...");
        try
        {
            // Update currentLayout with latest changes from allColumns
            foreach (var col in allColumns)
            {
                var current = currentLayout.FirstOrDefault(c => c.FieldName == col.FieldName);
                if (current != null)
                {
                    current.Visible = col.Visible;
                    current.Width = col.Width;
                    current.DisplayIndex = col.DisplayIndex;
                }
                else
                {
                    currentLayout.Add(new GridColumnLayout
                    {
                        FieldName = col.FieldName,
                        Caption = col.Caption,
                        Visible = col.Visible,
                        Width = col.Width,
                        DisplayIndex = col.DisplayIndex
                    });
                }
            }

            var configJson = GridLayoutService.SerializeColumnLayout(currentLayout);
            bool success = false;

            if (isEditMode && selectedLayoutId.HasValue)
            {
                var updateRequest = new SaveGridLayoutRequest
                {
                    GridLayoutName = newLayoutName,
                    GridLayoutVoucherType = VoucherType,
                    GridLayoutData = configJson,
                    GridLayoutDefault = isDefaultLayout
                };
                success = await GridLayoutService.UpdateAsync(selectedLayoutId.Value, updateRequest);
            }
            else
            {
                var newLayoutRequest = new SaveGridLayoutRequest
                {
                    GridLayoutName = newLayoutName,
                    GridLayoutVoucherType = VoucherType,
                    GridLayoutData = configJson,
                    GridLayoutDefault = isDefaultLayout
                };
                success = await GridLayoutService.CreateAsync(newLayoutRequest);

                if (success)
                {
                    await LoadAvailableLayouts();
                    var createdLayout = availableLayouts.FirstOrDefault(l => l.GridLayoutName == newLayoutName);
                    if (createdLayout != null)
                        selectedLayoutId = createdLayout.GridLayoutId;
                }
            }

            if (success)
            {
                ToastService.Success($"Grid layout {(isEditMode ? "updated" : "created")} successfully!");
                await LoadAvailableLayouts();

                if (isDefaultLayout)
                {
                    await LoadDefaultLayout();
                }

                ClosePopup();

                // ✅ CRITICAL: Notify parent after save/update
                await NotifyLayoutChanged();
            }
            else
            {
                ToastService.Error($"Failed to {(isEditMode ? "update" : "create")} grid layout.");
            }
        }
        catch (Exception ex)
        {
            ToastService.Error($"Error saving layout: {ex.Message}");
            Console.WriteLine($"Layout save error: {ex}");
        }
        finally
        {
            LoadingService.Hide();
        }
    }

    private async Task NotifyLayoutChanged()
    {
        if (OnLayoutChanged.HasDelegate)
        {
            await OnLayoutChanged.InvokeAsync(currentLayout);
        }
    }
}