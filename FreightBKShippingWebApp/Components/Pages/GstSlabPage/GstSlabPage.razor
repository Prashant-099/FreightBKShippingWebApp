@page "/gstslabs"
  
@using FreightBKShippingWebApp.Model
@using FreightBKShippingWebApp.Services
@using FreightBKShippingWebApp.Components.Pages
@inject GstSlabService GstSlabService
@inject ToasteService ToastService
@inject LoadingService LoadingService
@inject ConfirmationDialogService ConfirmDialogService
@inject GridLayoutService GridLayoutService
@inject AuditLogService AuditLogService
<style>
    .grid-size {
        max-height: 600px;
    }


    /* ComboBox Styling */
    .layout-combobox {
        border-radius: 6px;
        width: 185px;
    }
</style>
<DxGrid TItem="GstSlabModel"
        Data="@gstSlabList"
        @ref="MyGrid"
        KeyFieldName="GstSlabId"
        ShowSearchBox="true"
        PageSize="10"
        PageSizeSelectorVisible="true"
        ShowGroupPanel="true"
        FilterMenuButtonDisplayMode="GridFilterMenuButtonDisplayMode.Always"
        FocusedRowEnabled="true"
        SelectionMode="GridSelectionMode.Multiple"
        SelectedDataItems="@SelectedGstSlabs"
        SelectedDataItemsChanged="OnSelectedGstSlabsChanged"
        ColumnResizeMode="GridColumnResizeMode.NextColumn"
        CssClass="grid-size"
        AllowSelectRowByClick="true">

    <ToolbarTemplate Context="toolbarContext">
        <DxToolbar>
            <TitleTemplate Context="tl">
                <div class="d-flex align-items-center">
                    <i class="bi bi-receipt-cutoff me-2"></i>
                    <span class="fs-5 ms-2">GST Slabs</span>
                </div>
            </TitleTemplate>

            <Items>
                <DxToolbarItem Text="Add" IconCssClass="bi bi-plus-circle" Click="OnCreateNew" />
                <DxToolbarItem Text="Edit" IconCssClass="bi bi-pencil-square" Click="OnEdit" />
                <DxToolbarItem Text="Delete" IconCssClass="bi bi-trash" Click="OnDelete" />
                <DxToolbarItem Text="Refresh" IconCssClass="bi bi-arrow-clockwise" Click="@(async (_) => await LoadGstSlabsAsync())" />

                <DxToolbarItem Alignment="ToolbarItemAlignment.Right"
                               RenderStyle="ButtonRenderStyle.Secondary"
                               IconCssClass="bi bi-gear-wide-connected"
                               Click="ShowLayoutPopup" />
            </Items>
        </DxToolbar>
    </ToolbarTemplate>

    <Columns>
        <DxGridSelectionColumn Width="30" FixedPosition="GridColumnFixedPosition.Left" />

        <DxGridDataColumn FieldName="GstSlabId" Caption="ID"
                          Width="@(layoutManager?.GetColumnWidth("GstSlabId") ?? "80px")"
                          Visible="@(layoutManager?.GetColumnVisibility("GstSlabId") ?? false)" />

        <DxGridDataColumn FieldName="GstSlabName" Caption="Slab Name"
                          Width="@(layoutManager?.GetColumnWidth("GstSlabName") ?? "500px")"
                          Visible="@(layoutManager?.GetColumnVisibility("GstSlabName") ?? true)"/>
            
        <DxGridDataColumn FieldName="GstSlabType" Caption="Type"
                          Width="@(layoutManager?.GetColumnWidth("GstSlabType") ?? "160px")"
                          Visible="@(layoutManager?.GetColumnVisibility("GstSlabType") ?? true)" />

        <DxGridDataColumn FieldName="GstSlabSgstPer" Caption="SGST %"
                          Width="@(layoutManager?.GetColumnWidth("GstSlabSgstPer") ?? "190px")"
                          Visible="@(layoutManager?.GetColumnVisibility("GstSlabSgstPer") ?? true)" />

        <DxGridDataColumn FieldName="GstSlabCgstPer" Caption="CGST %"
                          Width="@(layoutManager?.GetColumnWidth("GstSlabCgstPer") ?? "190px")"
                          Visible="@(layoutManager?.GetColumnVisibility("GstSlabCgstPer") ?? true)" />

        <DxGridDataColumn FieldName="GstSlabIgstPer" Caption="IGST %"
                          Width="@(layoutManager?.GetColumnWidth("GstSlabIgstPer") ?? "190px")"
                          Visible="@(layoutManager?.GetColumnVisibility("GstSlabIgstPer") ?? true)" />

        <DxGridDataColumn FieldName="GstSlabCreated" Caption="Created"
                          DisplayFormat="dd/MM/yyyy"
                          Width="@(layoutManager?.GetColumnWidth("GstSlabCreated") ?? "110px")"
                          Visible="@(layoutManager?.GetColumnVisibility("GstSlabCreated") ?? true)" />

        <DxGridDataColumn FieldName="GstSlabStatus" Caption="Active"
                          Width="@(layoutManager?.GetColumnWidth("GstSlabStatus") ?? "120px")"
                          Visible="@(layoutManager?.GetColumnVisibility("GstSlabStatus") ?? true)" />
    </Columns>
</DxGrid>

<GstSlabAddEditPage @ref="popup" OnSaved="LoadGstSlabsAsync" />

<ConfirmationDialog />

<GridLayoutpPopup @ref="layoutManager"
                  VoucherType="GstSlab"
                  Columns="@allColumns"
                  OnLayoutChanged="HandleLayoutChanged" />
@code {
    DxGrid MyGrid;
    private List<GstSlab> gstSlabList = new();
    // private List<GstSlab> SelectedGstSlabs = new();
    private IReadOnlyList<object> SelectedGstSlabs { get; set; } = new List<object>();

    private GstSlabAddEditPage popup;   


    // All possible columns
    private GridLayoutpPopup? layoutManager;
    private List<GridColumnLayout> allColumns = [];
    private async void ShowLayoutPopup()
    {
        await InvokeAsync(() =>
        {
            layoutManager?.ShowPopup();
        });
    }
    private async Task HandleLayoutChanged(List<GridColumnLayout> updatedLayout)
    {
        allColumns = updatedLayout;
        // Force the grid to re-render with new layout
        await InvokeAsync(StateHasChanged);
    }
    protected override async Task OnInitializedAsync()
    {
        InitializeColumns();
        await LoadGstSlabsAsync();


    }
    private void InitializeColumns()
    {
        allColumns = new List<GridColumnLayout>
        {
            new() { FieldName = "GstSlabId", Caption = "ID", Visible = false, Width = 80, DisplayIndex = 0 },
        new() { FieldName = "GstSlabName", Caption = "Slab Name", Visible = true, Width = 500, DisplayIndex = 1 },
        new() { FieldName = "GstSlabType", Caption = "Type", Visible = true, Width = 160, DisplayIndex = 2 },
        new() { FieldName = "GstSlabSgstPer", Caption = "SGST %", Visible = true, Width = 190, DisplayIndex = 3 },
        new() { FieldName = "GstSlabCgstPer", Caption = "CGST %", Visible = true, Width = 190, DisplayIndex = 4 },
        new() { FieldName = "GstSlabIgstPer", Caption = "IGST %", Visible = true, Width = 190, DisplayIndex = 5 },
        new() { FieldName = "GstSlabStatus", Caption = "Active", Visible = true, Width = 120, DisplayIndex = 6 },
        new() { FieldName = "GstSlabCreated", Caption = "Created", Visible = true, Width = 110, DisplayIndex = 7 }
     };

    }



    private async Task LoadGstSlabsAsync()
    {
        LoadingService.Show();
        try
        {
            gstSlabList = await GstSlabService.GetAllAsync();
        }
        finally
        {
            LoadingService.Hide();
        }
    }

    private async Task OnSelectedGstSlabsChanged(IReadOnlyList<object> slabs)
    {
        SelectedGstSlabs = slabs ?? new List<object>();
        await InvokeAsync(StateHasChanged);
    }

    private void OnCreateNew(ToolbarItemClickEventArgs e)
    {
        popup.Show(new GstSlab
        {
            GstSlabStatus = true,
            GstSlabType = "GST"
        });
    }
    // ✅ FIXED: Reliable clear selection method
    private async Task ClearSelectionManual()
    {
        try
        {
            if (MyGrid != null)
            {
                MyGrid.ClearSelection(); // ✅ Synchronous method
            }
            SelectedGstSlabs = new List<GstSlab>();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Clear selection error: {ex.Message}");
        }
    }

    // ✅ FIXED: Auto-clear after operations
    private async Task ClearSelection()
    {
        await Task.Delay(100); // Small delay for UI update
        await ClearSelectionManual();
    }
    private async Task OnEdit(ToolbarItemClickEventArgs e)
    {
        var slab = MyGrid.GetFocusedDataItem() as GstSlab;
        if (slab != null)
        {

            var freshData = gstSlabList
          .FirstOrDefault(x => x.GstSlabId == slab.GstSlabId);

            if (freshData != null)
                popup.Show(freshData);
        
        }
        else
            ToastService.Warning("Please select a GST Slab to edit.");
        await ClearSelection();
    }

    private async Task OnDelete(ToolbarItemClickEventArgs e)
    {
        if (SelectedGstSlabs == null || SelectedGstSlabs.Count == 0)
        {
            ToastService.Warning("Please select at least one GST Slab to delete.");
            return;
        }
        var selectedList = SelectedGstSlabs.Cast<GstSlab>().ToList();
        var confirm = await ConfirmDialogService.ShowAsync(
            $"Are you sure you want to delete {SelectedGstSlabs.Count} selected GST slab(s)?");
        if (!confirm)
        {
            await ClearSelection(); // ✅ Clear on cancel
            return;
        }
        try
        {
            LoadingService.Show("Deleting...");
            int successCount = 0, failCount = 0;
            foreach (var slab in selectedList)
            {
                var result = await GstSlabService.DeleteAsync(slab.GstSlabId);
                if (result)
                {
                    successCount++;
                    AuditLogService.NotifyAuditChanged();
                }
                else failCount++;
            }

        if (successCount > 0)
            ToastService.Success($"{successCount} GST Slab(s) deleted successfully.");
        if (failCount > 0)
            ToastService.Error($"{failCount} GST Slab(s) failed to delete.");

        await LoadGstSlabsAsync();
        }
        finally
        {
            LoadingService.Hide();
            await ClearSelection(); // ✅ Clear after delete (success or fail)
        }
}
}