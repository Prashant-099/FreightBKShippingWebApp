@using FreightBKShippingWebApp.Model
@using FreightBKShippingWebApp.Services
@using System.Text.Json
@inject BranchService BranchService
@inject ToasteService ToastService
@inject LoadingService LoadingService
@inject StateService StateService
@inject CountryService CountryService
@inject IJSRuntime JSRuntime

@inject IBranchContext BranchContext

<DxPopup @bind-Visible="Visible"
ShowCloseButton="true" HeaderText="@Title" 
MaxWidth="600" 
CloseOnOutsideClick="false" 
horizontalAlignment="HorizontalAlignment.Center"
         verticalAlignment="VerticalAlignment.Center" 
         BodyCssClass="my-popup-body" ShowFooter="true" 
         scrollable="true">

    <BodyContentTemplate Context="bdybrnch">
        <EditForm  EditContext="@editContext" OnValidSubmit="HandleValidSubmit" Context="ctxeditform" id="branchForm">
            <DataAnnotationsValidator />
           @*  <ValidationSummary /> *@

            <DxFormLayout>

                <DxFormLayoutItem Caption="Branch Name">
                    <ChildContent Context="ctx">
                        <DxTextBox @bind-Text="EditModel.BranchName" @oninput="AutoFillPrintName" ShowValidationIcon="true" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                    </ChildContent>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="Print Name">
                    <ChildContent Context="ctx">
                        <DxTextBox @bind-Text="EditModel.BranchPrintName" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                    </ChildContent>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="GSTIN">
                    <ChildContent Context="ctx">
                        <DxTextBox @bind-Text="EditModel.BranchGstin" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                    </ChildContent>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="PAN">
                    <ChildContent Context="ctx">
                        <DxTextBox @bind-Text="EditModel.BranchPan" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                    </ChildContent>
                </DxFormLayoutItem>



                <DxFormLayoutItem Caption="Address">
                    <ChildContent Context="ctx">
                        <DxMemo @bind-Text="EditModel.BranchAddress1" Rows="2" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                    </ChildContent>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="City">
                    <ChildContent Context="ctx">
                        <DxTextBox @bind-Text="EditModel.BranchCity" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                    </ChildContent>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="State">
                    <Template Context="ctx">

                        <DxComboBox TData="State" TValue="int"
                                    Data="@stateList"
                                    TextFieldName="StateName"
                                    ValueFieldName="StateId"
                                    ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                    AllowUserInput="false"
                                    ShowValidationIcon="true"
                                    NullText="-- Select State --"
                                    @bind-Value="EditModel.BranchStateId"
                                    SearchMode="ListSearchMode.AutoSearch"
                                    SearchFilterCondition="ListSearchFilterCondition.Contains" />
                        @* <ValidationMessage For="@(() => EditModel.BranchStateId)" /> *@
                    </Template>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="Country">
                    <ChildContent Context="ctx">

                        <DxComboBox TData="Country" TValue="String"
                                    Data="@CountryList"
                                    TextFieldName="CountryName"
                                    ValueFieldName="CountryName"
                                    ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                    AllowUserInput="false"
                                    NullText="-- Select Country --"
                                    @bind-Value="EditModel.BranchCountry"
                                    SearchMode="ListSearchMode.AutoSearch"
                                    SearchFilterCondition="ListSearchFilterCondition.Contains" />

                    </ChildContent>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="Contact No">
                    <ChildContent Context="ctx">
                        <DxTextBox @bind-Text="EditModel.BranchContactNo" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                    </ChildContent>
                </DxFormLayoutItem>

                <DxFormLayoutItem Caption="Email">
                    <ChildContent Context="ctx">
                        <DxTextBox @bind-Text="EditModel.BranchEmail" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                    </ChildContent>
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="IsDefault">
                    <ChildContent Context="ctx">
                        <DxCheckBox @bind-Checked="EditModel.Branchisdefault" />
                    </ChildContent>
                </DxFormLayoutItem>
                <DxFormLayoutItem Caption="Active">
                    <ChildContent Context="ctx">
                        <DxCheckBox @bind-Checked="EditModel.BranchStatus" />
                    </ChildContent>
                </DxFormLayoutItem>
            </DxFormLayout>

            <!-- Hidden submit button -->
           @*  <button type="submit" @ref="submitButton" style="display:none;">Submit</button> *@
        </EditForm>
    </BodyContentTemplate>
    <FooterContentTemplate Context="ftrbrnch">
        <div class="mt-3 text-end">
            <DxButton Text="Save" RenderStyle="ButtonRenderStyle.Primary" SubmitFormOnClick="true" Form="branchForm" />
            <DxButton Text="Cancel" RenderStyle="ButtonRenderStyle.Secondary" Click="Hide" />
        </div>
    </FooterContentTemplate>

</DxPopup>

@code {

    // string FormValidationState = @"Press the ""Submit"" button to validate the form.";

    // void HandleInvalidSubmit()
    // {
    //     FormValidationState = @"Form data is invalid";
    //     ToastService.Error("Please fill in all required fields correctly.");
    // }
    private void AutoFillPrintName(ChangeEventArgs e)
    {
        EditModel.BranchName = e.Value?.ToString() ?? "";
        EditModel.BranchPrintName = EditModel.BranchName;
        // Notify the EditContext that the field has changed for real-time validation
        if (editContext != null)
        {
            editContext.NotifyFieldChanged(editContext.Field(nameof(EditModel.BranchName)));
        }
    }
    private EditContext? editContext;
    // private ElementReference submitButton;
    [Parameter] public EventCallback OnSaved { get; set; }

    private bool Visible { get; set; }
    private string Title { get; set; } = "Add/Edit Branch";
    private Branch EditModel { get; set; } = new();
    private List<State> stateList = new();
    private List<Country> CountryList = new();
    // private async Task SubmitForm()
    // {
    //     // Trigger form submission via JavaScript
    //     await JSRuntime.InvokeVoidAsync("eval", "document.getElementById('branchForm').requestSubmit()");
    //     // // Programmatically click the hidden submit button
    //     // await submitButton.FocusAsync(); // This triggers form validation
    //     // StateHasChanged(); // Force re-render to show validation messages
    // }

    public void Show(Branch branch)
    {
        if (branch != null && branch.BranchId > 0)
        {
            var json = JsonSerializer.Serialize(branch);
            EditModel = JsonSerializer.Deserialize<Branch>(json) ?? new Branch();
            Title = "Edit Branch";
        }
        else
        {
            EditModel = new Branch
            {
                BranchStatus = true,
                BranchId = 0  
            };
            Title = "Add Branch";
        }

        editContext = new EditContext(EditModel);
        Visible = true;
    }

    private void Hide()
    {
        Visible = false;
    }
    protected override async Task OnInitializedAsync()
    {
        stateList = await StateService.GetStatesAsync();
        CountryList = await CountryService.GetAllAsync();
    }
    private async Task HandleValidSubmit()
    {
        LoadingService.Show();
        try
        {
          

            if (EditModel.BranchId == 0)
            {
                var result = await BranchService.CreateAsync(EditModel);
                if (result == true)
                    ToastService.Success("Branch created successfully!");
                else
                {
                    ToastService.Error("Branch Failed To Create!");
                    return;
                }
            }
            else
            {
                var result = await BranchService.UpdateAsync(EditModel);
                if (result == true)
                    ToastService.Success("Branch Update successfully!");
                else
                {
                    ToastService.Error("Branch Failed To Update!");
                    return;
                }
            }

            Visible = false;
            await OnSaved.InvokeAsync();
        }
        catch (Exception ex)
        {
            ToastService.Error($"Error saving branch: {ex.Message}");
        }
        finally
        {
            LoadingService.Hide();
        }
    }
}
