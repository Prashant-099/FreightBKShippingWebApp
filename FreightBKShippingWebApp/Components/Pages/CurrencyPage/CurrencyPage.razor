@page "/currency"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using FreightBKShippingWebApp.Model
@using FreightBKShippingWebApp.Services
@using FreightBKShippingWebApp.Components.Pages
@inject CurrencyService CurrencyService
@inject ToasteService ToastService
@inject LoadingService LoadingService
@inject ConfirmationDialogService ConfirmDialogService
@inject GridLayoutService GridLayoutService
@inject AuditLogService AuditLogService
<style>
    .grid-size {
        max-height: 600px;
    }


    /* ComboBox Styling */
    .layout-combobox {
        border-radius: 6px;
        width: 185px;
    }
</style>
<DxGrid TItem="Currency"
        Data="@currencyList"
        @ref="MyGrid"
        KeyFieldName="CurrencyId"
        ShowSearchBox="true"
        PageSize="10"
        PageSizeSelectorVisible="true"
        ShowGroupPanel="true"
        FilterMenuButtonDisplayMode="GridFilterMenuButtonDisplayMode.Always"
        FocusedRowEnabled="true"
        SelectionMode="GridSelectionMode.Multiple"
        SelectedDataItems="@SelectedCurrencies"
        SelectedDataItemsChanged="OnSelectedCurrenciesChanged"
        CssClass="grid-size"
        AllowSelectRowByClick="true"
        ColumnResizeMode="GridColumnResizeMode.NextColumn">

    <ToolbarTemplate Context="toolbarContext">
        <DxToolbar>
            <TitleTemplate Context="tl">
                <div class="d-flex align-items-center">
                    <i class="bi bi-currency-exchange  me-2"></i>
                    <span class="fs-5">Currency</span>
                </div>
            </TitleTemplate>
            <Items>
                <DxToolbarItem Text="Add" IconCssClass="bi bi-plus-circle" Click="OnCreateNew" />
                <DxToolbarItem Text="Edit" IconCssClass="bi bi-pencil-square" Click="OnEdit" />
                <DxToolbarItem Text="Delete" IconCssClass="bi bi-trash" Click="OnDelete" />
                <DxToolbarItem Text="Refresh" IconCssClass="bi bi-arrow-clockwise" Click="@(async (_) => await LoadCurrenciesAsync())" />


                <DxToolbarItem Alignment="ToolbarItemAlignment.Right"
                               RenderStyle="ButtonRenderStyle.Secondary"
                               IconCssClass="bi bi-gear-wide-connected"
                               Click="ShowLayoutPopup" />
            </Items>
        </DxToolbar>
    </ToolbarTemplate>
    <Columns>

        <DxGridSelectionColumn Width="30" />

        <DxGridDataColumn FieldName="CurrencyId" Caption="ID"
                          Width="@(layoutManager?.GetColumnWidth("CurrencyId") ?? "80px")"
                          Visible="@(layoutManager?.GetColumnVisibility("CurrencyId") ?? false)" />

        <DxGridDataColumn FieldName="CurrencyName" Caption="Name"
                          Width="@(layoutManager?.GetColumnWidth("CurrencyName") ?? "510px")"
                          Visible="@(layoutManager?.GetColumnVisibility("CurrencyName") ?? true)" />

        <DxGridDataColumn FieldName="CurrencySymbol" Caption="Symbol"
                          Width="@(layoutManager?.GetColumnWidth("CurrencySymbol") ?? "530px")"
                          Visible="@(layoutManager?.GetColumnVisibility("CurrencySymbol") ?? true)" />

        <DxGridDataColumn FieldName="CurrencyCreated" Caption="Created At"
                          DisplayFormat="dd/MM/yyyy"
                          Width="@(layoutManager?.GetColumnWidth("CurrencyCreated") ?? "150px")"
                          Visible="@(layoutManager?.GetColumnVisibility("CurrencyCreated") ?? true)" />

        <DxGridDataColumn FieldName="CurrencyUpdated" Caption="Updated At"
                          DisplayFormat="dd/MM/yyyy"
                          Width="@(layoutManager?.GetColumnWidth("CurrencyUpdated") ?? "150px")"
                          Visible="@(layoutManager?.GetColumnVisibility("CurrencyUpdated") ?? true)" />

        <DxGridDataColumn FieldName="CurrencyStatus" Caption="Active"
                          Width="@(layoutManager?.GetColumnWidth("CurrencyStatus") ?? "120px")"
                          Visible="@(layoutManager?.GetColumnVisibility("CurrencyStatus") ?? true)" />

    </Columns>
</DxGrid>

<CurrencyAddEditPage @ref="popup" OnSaved="LoadCurrenciesAsync" />

<ConfirmationDialog />
<GridLayoutpPopup @ref="layoutManager"
                  VoucherType="Currency"
                  Columns="@allColumns"
                  OnLayoutChanged="HandleLayoutChanged" />

@code {
    DxGrid MyGrid;
    private List<Currency> currencyList = [];
    // private List<Currency> SelectedCurrencies = new();
    private IReadOnlyList<object> SelectedCurrencies { get; set; } = new List<object>();

    private CurrencyAddEditPage popup;


    // All possible columns
    private GridLayoutpPopup? layoutManager;
    private List<GridColumnLayout> allColumns = [];
    private async void ShowLayoutPopup()
    {
        await InvokeAsync(() =>
        {
            layoutManager?.ShowPopup();
        });
    }
    private async Task HandleLayoutChanged(List<GridColumnLayout> updatedLayout)
    {
        allColumns = updatedLayout;
        // Force the grid to re-render with new layout
        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnInitializedAsync()
    {
        InitializeColumns();
        await LoadCurrenciesAsync();


    }

    private void InitializeColumns()
    {
        allColumns = new List<GridColumnLayout>
        {
             new() { FieldName = "CurrencyId", Caption = "ID", Visible = false, Width = 80, DisplayIndex = 0 },
        new() { FieldName = "CurrencyName", Caption = "Name", Visible = true, Width = 510, DisplayIndex = 1 },
        new() { FieldName = "CurrencySymbol", Caption = "Symbol", Visible = true, Width = 530, DisplayIndex = 2 },
        new() { FieldName = "CurrencyStatus", Caption = "Active", Visible = true, Width = 120, DisplayIndex = 3 },
        new() { FieldName = "CurrencyCreated", Caption = "Created At", Visible = true, Width = 150, DisplayIndex = 3 },
        new() { FieldName = "CurrencyUpdated", Caption = "Updated At", Visible = true, Width = 150, DisplayIndex = 4 }
        };

    }



    private async Task LoadCurrenciesAsync()
    {
        LoadingService.Show();
        try
        {
            currencyList = await CurrencyService.GetAllAsync();
        }
        finally
        {
            LoadingService.Hide();
        }
    }

    private async Task OnSelectedCurrenciesChanged(IReadOnlyList<object> currencies)
    {
        SelectedCurrencies = currencies ?? new List<object>();
        await InvokeAsync(StateHasChanged);
    }
    // ✅ FIXED: Reliable clear selection method
    private async Task ClearSelectionManual()
    {
        try
        {
            if (MyGrid != null)
            {
                MyGrid.ClearSelection(); // ✅ Synchronous method
            }
            SelectedCurrencies = new List<Currency>();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Clear selection error: {ex.Message}");
        }
    }

    // ✅ FIXED: Auto-clear after operations
    private async Task ClearSelection()
    {
        await Task.Delay(100); // Small delay for UI update
        await ClearSelectionManual();
    }

    private void OnCreateNew(ToolbarItemClickEventArgs e)
    {
        popup.Show(new Currency());
    }

    private async Task OnEdit(ToolbarItemClickEventArgs e)
    {
        var currency = MyGrid.GetFocusedDataItem() as Currency;
        if (currency != null)
        {
            var freshData = currencyList
              .FirstOrDefault(x => x.CurrencyId == currency.CurrencyId);

            if (freshData != null)
              popup.Show(freshData);
        }
        else
            ToastService.Warning("Please select a currency to edit.");
        await ClearSelection();
    }

    private async Task OnDelete(ToolbarItemClickEventArgs e)
    {
        if (SelectedCurrencies == null || SelectedCurrencies.Count == 0)
        {
            ToastService.Warning("Please select at least one currency to delete.");
            return;
        }
        var selectedList = SelectedCurrencies.Cast<Currency>().ToList();

        var confirm = await ConfirmDialogService.ShowAsync(
            $"Are you sure you want to delete {SelectedCurrencies.Count} selected currency(ies)?");

        if (!confirm)
        {
            await ClearSelection(); // ✅ Clear on cancel
            return;
        }
        try
        {
            LoadingService.Show("Deleting...");
            int successCount = 0, failCount = 0;
            List<string> errorMessages = new();
            foreach (var currency in selectedList)
            {

                var result = await CurrencyService.DeleteAsync(currency.CurrencyId);
                if (result.Success) 
                {
                    AuditLogService.NotifyAuditChanged();
                    successCount++; 
                }
                else{
                    failCount++;
                    errorMessages.Add(result.Error);
                }
            }
            if (successCount > 0) ToastService.Success($"{successCount} currency(s) Deleted Successfully.");
            if (failCount > 0)
            ToastService.Error($"{failCount}  Currency(s) Failed To Delete.\nDetails: {string.Join("\n", errorMessages.Distinct())}");

            await LoadCurrenciesAsync();
        }
        finally
        {
            LoadingService.Hide();
            await ClearSelection(); // ✅ Clear after delete (success or fail)
        }
        }
    }

