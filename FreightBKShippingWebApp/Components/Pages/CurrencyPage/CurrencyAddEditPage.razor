@using FreightBKShippingWebApp.Model
@using FreightBKShippingWebApp.Services
@using System.Text.Json
@inject CurrencyService CurrencyService
@inject ToasteService ToastService
@inject LoadingService LoadingService
@inject AuditLogService AuditLogService
<DxPopup @bind-Visible="Visible" ShowCloseButton="true" HeaderText="@Title" MaxWidth="450" CloseOnOutsideClick="false" horizontalAlignment="HorizontalAlignment.Center"
         verticalAlignment="VerticalAlignment.Center" BodyCssClass="my-popup-body" ShowFooter="true" scrollable="true">
    <BodyContentTemplate Context="bdybrnch">
        <EditForm EditContext="@editContext" OnValidSubmit="HandleValidSubmit" id="currForm">
        <DataAnnotationsValidator />
        @* <ValidationSummary /> *@

        <DxFormLayout>
            <DxFormLayoutItem Caption="Name" ColSpanMd="12">
                <ChildContent Context="itemContext">
                        <DxTextBox @bind-Text="EditModel.CurrencyName" ShowValidationIcon="true" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                </ChildContent>
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="Symbol" ColSpanMd="12">
                <ChildContent Context="itemContext">
                        <DxTextBox @bind-Text="EditModel.CurrencySymbol" ShowValidationIcon="true" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                </ChildContent>
            </DxFormLayoutItem>

           @*  <DxFormLayoutItem Caption="Active">
                <ChildContent Context="itemContext">
                    <DxCheckBox @bind-Checked="EditModel.CurrencyStatus" />
                </ChildContent>
            </DxFormLayoutItem> *@
        </DxFormLayout>

    </EditForm>
     </BodyContentTemplate>
    <FooterContentTemplate Context="ftrbrnch">
        <div class="mt-3 text-end">
            <DxButton Text="Save" RenderStyle="ButtonRenderStyle.Primary" SubmitFormOnClick="true" Form="currForm" />
            <DxButton Text="Cancel" RenderStyle="ButtonRenderStyle.Secondary" Click="Hide" />
        </div>
    </FooterContentTemplate>
</DxPopup>

@code {
    [Parameter] public EventCallback OnSaved { get; set; }
    private EditContext? editContext;
    private bool Visible { get; set; }
    private string Title { get; set; } = "Add/Edit Currency";
    private Currency EditModel { get; set; } = new();

    public void Show(Currency currency)
    {

        if (currency.CurrencyId > 0)
        {
            // Edit mode – bind directly to the selected object
            // EditModel = currency;
            var json = JsonSerializer.Serialize(currency);
            EditModel = JsonSerializer.Deserialize<Currency>(json) ?? new Currency();
            Title = "Edit Currency";
        }
        else
        {
            // Add mode – create new object
            EditModel = new Currency { CurrencyStatus = true };
            Title = "Add Currency";
        }
        // Create EditContext when showing the form
        editContext = new EditContext(EditModel);
        Visible = true;
    }

    private void Hide()
    {
        Visible = false;
    }

    private async Task HandleValidSubmit()
    {
        LoadingService.Show();
        try
        {
            if (EditModel.CurrencyId == 0)
            {
                var result = await CurrencyService.CreateAsync(EditModel);
                if (result == true)
                {
                    ToastService.Success("Currency created successfully!");
                    AuditLogService.NotifyAuditChanged();

                }
                else
                {
                    ToastService.Error("Currency Failed To Created !");
                    return;
                }
            }
            else
            {
                var result = await CurrencyService.UpdateAsync(EditModel);
                if (result == true)
                {
                    ToastService.Success("Currency updated successfully!");
                    AuditLogService.NotifyAuditChanged();

                }
                else
                {
                    ToastService.Error("Currency Failed To Update !");
                    return;
                }

            }

            Visible = false;
            await OnSaved.InvokeAsync();
        }
        catch (Exception ex)
        {
            ToastService.Error($"Error saving currency: {ex.Message}");
        }
       finally
        {
            LoadingService.Hide();
        }
    }
}
