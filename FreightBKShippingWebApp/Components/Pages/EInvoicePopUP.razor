@using System.Text.Json
@using FreightBKShippingWebApp.Model
@using FreightBKShippingWebApp.Models
@using FreightBKShippingWebApp.Services
@using System.Text
@using Microsoft.JSInterop
@inject ToasteService ToastService
@inject BillService BillService
@inject EinvConfigService EinvConfigService
@inject HttpClient HttpClient
@inject IJSRuntime JSRuntime
@inject GstinAuthTokenService GstinAuthTokenService

<DxPopup @bind-Visible="Visible"
         MaxWidth="max(60%, 600px)"
         MaxHeight="91%"
         ShowCloseButton="true"
         Scrollable="true"
         CloseOnOutsideClick="false"
         HeaderText="E-Invoice Generator"
         HorizontalAlignment="HorizontalAlignment.Center"
         VerticalAlignment="VerticalAlignment.Center">

    <!-- SELECTED BILLS -->
    <DxFormLayout CssClass="mb-3">
        <DxFormLayoutItem Caption="Selected Bills" ColSpanMd="12">
            @if (SelectedBills?.Any() == true)
            {
                <div class="selected-bills-box">
                    @foreach (var bill in SelectedBills)
                    {
                        <span class="badge bg-primary me-2 mb-1 ">
                            Bill - @bill.BillNo - ₹@bill.BillAmount.ToString("N2")
                        </span>
                    }
                </div>
            }
            else
            {
                <div class="text-muted text-center py-2">
                    <small>No bills selected</small>
                </div>
            }
        </DxFormLayoutItem>
    </DxFormLayout>

    <!-- JSON PREVIEW -->
    @if (!string.IsNullOrWhiteSpace(jsonPreview))
    {
        <DxFormLayout CssClass="mb-3">
            <DxFormLayoutItem Caption="JSON Preview" ColSpanMd="12">
                <Template>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <small class="text-muted">Request Payload</small>
                        <DxButton Text="Copy"
                                  IconCssClass="bi bi-clipboard"
                                  RenderStyle="ButtonRenderStyle.Secondary"
                                  SizeMode="SizeMode.Small"
                                  Click="CopyToClipboard" />
                    </div>
                    <DxMemo Text="@jsonPreview"
                            ReadOnly="true"
                            Rows="8"
                            CssClass="code-preview" />
                </Template>
            </DxFormLayoutItem>
        </DxFormLayout>
    }

    <!-- API RESPONSE -->
    @if (!string.IsNullOrWhiteSpace(eInvoiceJson))
    {
        <DxFormLayout CssClass="mb-3">
            <DxFormLayoutItem Caption="API Response" ColSpanMd="12">
                <DxMemo Text="@eInvoiceJson"
                        ReadOnly="true"
                        Rows="8"
                        CssClass="code-preview" />
            </DxFormLayoutItem>
        </DxFormLayout>
    }

    <!-- SUCCESS MESSAGE -->
    @if (!string.IsNullOrWhiteSpace(generatedIrn))
    {
        <div class="alert alert-success alert-dismissible fade show mb-3 p-3 shadow-sm"
             role="alert" style="font-size: 0.95rem;">

            <div class="d-flex align-items-center mb-2">
                <i class="bi bi-check-circle-fill me-2" style="font-size: 1.2rem;"></i>
                <strong>IRN Generated Successfully!</strong>
            </div>

            <pre class="mt-2 mb-0 p-2 bg-light rounded small text-break"
                 style="white-space: pre-wrap; max-height: 200px; overflow-y: auto;">@generatedIrn</pre>

            <button type="button"
                    class="btn-close"
                    style="transform: scale(1.2);"
                    @onclick="() => generatedIrn = string.Empty">
            </button>
        </div>
    }

    <!-- ERROR MESSAGE -->
    @if (errorMessages.Any())
    {
        <div class="alert alert-danger alert-dismissible fade show mb-3 p-3 shadow-sm"
             role="alert" style="font-size: 0.95rem;">

            <div class="d-flex align-items-center mb-2">
                <i class="bi bi-exclamation-triangle-fill me-2" style="font-size: 1.2rem;"></i>
                <strong>Error(s) Occurred</strong>
            </div>

            <div class="mt-2" style="max-height: 250px; overflow-y: auto;">
                @foreach (var error in errorMessages)
                {
                    <div class="error-item p-2 mb-2 bg-light rounded">
                        <div class="fw-bold text-danger small">
                            <i class="bi bi-x-circle me-1"></i>
                            @error.BillInfo
                        </div>
                        <div class="text-dark small mt-1 ms-3">
                            @error.Message
                        </div>
                        @if (!string.IsNullOrWhiteSpace(error.Details))
                        {
                            <div class="text-muted small mt-1 ms-3" style="font-size: 0.85rem;">
                                <em>@error.Details</em>
                            </div>
                        }
                    </div>
                }
            </div>

            <button type="button"
                    class="btn-close"
                    style="transform: scale(1.2);"
                    @onclick="ClearErrors">
            </button>
        </div>
    }

    <!-- WARNING MESSAGE -->
    @if (warningMessages.Any())
    {
        <div class="alert alert-warning alert-dismissible fade show mb-3 p-3 shadow-sm"
             role="alert" style="font-size: 0.95rem;">

            <div class="d-flex align-items-center mb-2">
                <i class="bi bi-exclamation-circle-fill me-2" style="font-size: 1.2rem;"></i>
                <strong>Warning(s)</strong>
            </div>

            <div class="mt-2" style="max-height: 200px; overflow-y: auto;">
                @foreach (var warning in warningMessages)
                {
                    <div class="warning-item p-2 mb-2 bg-light rounded">
                        <div class="text-dark small">
                            <i class="bi bi-info-circle me-1"></i>
                            @warning
                        </div>
                    </div>
                }
            </div>

            <button type="button"
                    class="btn-close"
                    style="transform: scale(1.2);"
                    @onclick="ClearWarnings">
            </button>
        </div>
    }

    <!-- LOADING -->
    @if (isLoading)
    {
        <div class="text-center py-3 mb-3">
            <div class="spinner-border text-primary mb-2" style="width: 2rem; height: 2rem;"></div>
            <div><small class="text-muted">@loadingMessage</small></div>
        </div>
    }

    <!-- ACTION BUTTONS -->
    <div class="d-flex gap-2 justify-content-end flex-wrap">
        <DxButton Text="Preview JSON"
                  IconCssClass="bi bi-eye"
                  RenderStyle="ButtonRenderStyle.Primary"
                  RenderStyleMode="ButtonRenderStyleMode.Outline"
                  Click="PreviewJson"
                  Enabled="@(!isLoading)" />

        <DxButton Text="@(isLoading ? "Processing..." : "Generate E-Invoice")"
                  IconCssClass="bi bi-file-earmark-check"
                  RenderStyle="ButtonRenderStyle.Success"
                  Click="GenerateEInvoice"
                  Enabled="@(!isLoading)" />

        <DxButton Text="Close"
                  IconCssClass="bi bi-x-circle"
                  RenderStyle="ButtonRenderStyle.Secondary"
                  Click="Hide"
                  Enabled="@(!isLoading)" />
    </div>

</DxPopup>

<style>
    .code-preview {
        font-family: 'Consolas', 'Monaco', monospace;
        font-size: 12px;
        background: #1e1e1e;
        color: #dcdcdc;
    }

        .code-preview .dxbl-edit-area {
            background: black !important;
            color: #dcdcdc !important;
        }

    .selected-bills-box {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        padding: 0.5rem;
        background: #f8f9fa;
        border-radius: 4px;
        min-height: 50px;
    }

    .error-item {
        border-left: 3px solid #dc3545;
    }

    .warning-item {
        border-left: 3px solid #ffc107;
    }

    @@media (max-width: 576px) {
        .alert {
            font-size: 0.9rem;
            padding: 12px 16px !important;
        }

        pre {
            font-size: 0.85rem !important;
            word-wrap: break-word;
        }

        .btn-close {
            transform: scale(1.3);
        }
    }
</style>

@code {
    [Parameter] public EventCallback<List<Bill>> OnGenerateEInvoice { get; set; }
    [Parameter] public string ConfigUsername { get; set; } = "";

    public bool Visible { get; set; }
    public List<Bill> SelectedBills { get; set; } = new();

    private string jsonPreview = "";
    private string eInvoiceJson = "";
    private List<ErrorDetail> errorMessages = new();
    private List<string> warningMessages = new();
    private string generatedIrn = "";
    private bool isLoading = false;
    private string loadingMessage = "Loading...";

    // Error detail class
    private class ErrorDetail
    {
        public string BillInfo { get; set; } = "";
        public string Message { get; set; } = "";
        public string Details { get; set; } = "";
    }

    public void Show(List<Bill> bills)
    {
        SelectedBills = bills;
        jsonPreview = "";
        eInvoiceJson = "";
        ClearErrors();
        ClearWarnings();
        generatedIrn = "";
        Visible = true;
        StateHasChanged();
    }

    public void Hide()
    {
        Visible = false;
        SelectedBills.Clear();
        jsonPreview = "";
        eInvoiceJson = "";
        ClearErrors();
        ClearWarnings();
        generatedIrn = "";
        isLoading = false;
    }

    private void ClearErrors()
    {
        errorMessages.Clear();
    }

    private void ClearWarnings()
    {
        warningMessages.Clear();
    }

    private void AddError(string billInfo, string message, string details = "")
    {
        errorMessages.Add(new ErrorDetail
            {
                BillInfo = billInfo,
                Message = message,
                Details = details
            });
    }

    private string FormatJson(string input)
    {
        try
        {
            var parsed = JsonSerializer.Deserialize<JsonElement>(input);
            return JsonSerializer.Serialize(parsed, new JsonSerializerOptions
                {
                    WriteIndented = true
                });
        }
        catch
        {
            return input;
        }
    }

    private string? SafeGet(JsonElement parent, string property)
    {
        if (parent.TryGetProperty(property, out var node))
            return node.GetString();

        return null;
    }

    private async Task PreviewJson()
    {
        if (!SelectedBills.Any())
        {
            ToastService.Error("No bills selected.");
            return;
        }

        isLoading = true;
        loadingMessage = $"Generating JSON preview for {SelectedBills.Count} bill(s)...";
        ClearErrors();
        ClearWarnings();
        eInvoiceJson = "";
        generatedIrn = "";
        StateHasChanged();

        try
        {
            var allJsons = new List<string>();

            foreach (var bill in SelectedBills)
            {
                var rawJson = await BillService.GetEInvoiceRawAsync(bill.BillId);

                if (string.IsNullOrWhiteSpace(rawJson))
                {
                    warningMessages.Add($"Unable to generate JSON for Bill #{bill.BillNo}");
                    continue;
                }

                allJsons.Add($"// Bill #{bill.BillNo}\n{FormatJson(rawJson)}");
            }

            if (!allJsons.Any())
            {
                AddError("Preview Failed", "No valid JSON generated for any selected bills.",
                    "Please check if the bills have all required data.");
                ToastService.Error("Preview failed!");
                return;
            }

            jsonPreview = string.Join("\n\n// ========================================\n\n", allJsons);
            ToastService.Success($"Preview ready for {allJsons.Count} bill(s)!");
        }
        catch (Exception ex)
        {
            AddError("Preview Error", "Failed to generate JSON preview", ex.Message);
            ToastService.Error("Preview failed!");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task<EinvConfig> GetValidAuthTokenAsync()
    {
        var configs = await EinvConfigService.GetAllAsync();
        var config = configs.FirstOrDefault();

        if (config == null)
        {
            AddError("Configuration Error", "E-Invoice configuration not found",
                "Please set up E-Invoice configuration in settings.");
            ToastService.Error("Config not found!");
            return null;
        }

        if (string.IsNullOrWhiteSpace(config.AuthToken) || config.EInvoiceTokenExp == null)
        {
            warningMessages.Add("Auth Token not found. Generating new token...");
            var newTokenResponse = await GstinAuthTokenService.GenerateAuthTokenAsync(config);

            if (newTokenResponse == null)
            {
                AddError("Authentication Error", "Failed to generate Auth Token",
                    "Please check your credentials and try again.");
                ToastService.Error("Auth Token generation failed!");
                return null;
            }

            ToastService.Success("New Auth Token generated!");
            return await UpdateConfigAfterToken(config);
        }

        DateTime expiry;

        if (!DateTime.TryParse(config.EInvoiceTokenExp, out expiry))
        {
            var refreshed = await GstinAuthTokenService.GenerateAuthTokenAsync(config);
            if (refreshed == null)
            {
                AddError("Authentication Error", "Failed to refresh Auth Token",
                    "Token expiry format is invalid.");
                return null;
            }

            return await UpdateConfigAfterToken(config);
        }

        var remaining = expiry - DateTime.Now;

        if (remaining.TotalMinutes < 2)
        {
            var refreshed = await GstinAuthTokenService.GenerateAuthTokenAsync(config);

            if (refreshed == null)
            {
                AddError("Authentication Error", "Failed to refresh expired Auth Token");
                return null;
            }

            return await UpdateConfigAfterToken(config);
        }

        return config;
    }

    private async Task<EinvConfig> UpdateConfigAfterToken(EinvConfig oldConfig)
    {
        var updatedList = await EinvConfigService.GetAllAsync();
        return updatedList.FirstOrDefault(c => c.Gstin == oldConfig.Gstin);
    }

    private async Task GenerateEInvoice()
    {
        if (!SelectedBills.Any())
        {
            ToastService.Error("No bills selected.");
            return;
        }

        isLoading = true;
        loadingMessage = $"Processing {SelectedBills.Count} E-Invoice(s)...";
        ClearErrors();
        ClearWarnings();
        generatedIrn = "";
        eInvoiceJson = "";
        StateHasChanged();

        try
        {
            var config = await GetValidAuthTokenAsync();
            if (config == null)
                return;

            var allResponses = new List<string>();
            var successCount = 0;
            var failCount = 0;
            var generatedIrns = new List<string>();

            foreach (var bill in SelectedBills)
            {
                try
                {
                    var json = await BillService.GetEInvoiceRawAsync(bill.BillId);
                    if (string.IsNullOrWhiteSpace(json))
                    {
                        AddError($"Bill #{bill.BillNo}", "Failed to prepare JSON payload",
                            "Check if all required fields are filled.");
                        failCount++;
                        continue;
                    }

                    string url = $"{config.BaseUrl.TrimEnd('/')}/eicore/dec/v1.03/Invoice?QrCodeSize=250";

                    var req = new HttpRequestMessage(HttpMethod.Post, url);
                    req.Headers.Add("aspid", config.AspUserId);
                    req.Headers.Add("password", config.Password);
                    req.Headers.Add("Gstin", config.Gstin);
                    req.Headers.Add("user_name", config.Username);
                    req.Headers.Add("AuthToken", config.AuthToken);
                    req.Content = new StringContent(json, Encoding.UTF8, "application/json");

                    var response = await HttpClient.SendAsync(req);
                    var content = await response.Content.ReadAsStringAsync();

                    allResponses.Add($"// Bill #{bill.BillNo}\n{FormatJson(content)}");

                    JsonElement parsed;
                    try
                    {
                        parsed = JsonSerializer.Deserialize<JsonElement>(content);
                    }
                    catch
                    {
                        AddError($"Bill #{bill.BillNo}", "Invalid API response received",
                            "The response from server could not be parsed.");
                        failCount++;
                        continue;
                    }

                    var status = SafeGet(parsed, "Status");
                    if (status != "1")
                    {
                        var error = ExtractError(parsed);
                        AddError($"Bill #{bill.BillNo}", "E-Invoice generation failed", error);
                        failCount++;
                        continue;
                    }

                    if (!parsed.TryGetProperty("Data", out var dataNode))
                    {
                        AddError($"Bill #{bill.BillNo}", "Invalid response structure",
                            "'Data' field not found in API response.");
                        failCount++;
                        continue;
                    }

                    JsonElement data;
                    try
                    {
                        var dataString = dataNode.GetString();
                        data = JsonSerializer.Deserialize<JsonElement>(dataString);
                    }
                    catch
                    {
                        AddError($"Bill #{bill.BillNo}", "Failed to parse response data",
                            "Data field contains invalid JSON.");
                        failCount++;
                        continue;
                    }

                    var irn = SafeGet(data, "Irn");
                    var ackNo = SafeGet(data, "AckNo");
                    var ackDt = SafeGet(data, "AckDt");
                    var signedInv = SafeGet(data, "SignedInvoice");
                    var signedQr = SafeGet(data, "SignedQRCode");

                    DateTime? ackDate = null;
                    if (DateTime.TryParse(ackDt, out var parsedDt))
                        ackDate = parsedDt;

                    if (string.IsNullOrWhiteSpace(irn))
                    {
                        AddError($"Bill #{bill.BillNo}", "IRN not generated",
                            "IRN field is missing in successful response.");
                        failCount++;
                        continue;
                    }

                    bool saved = await BillService.SaveEInvoiceDataAsync(
                        bill.BillId, irn, ackNo, ackDate, signedInv, signedQr);

                    if (saved)
                    {
                        generatedIrns.Add($"Bill #{bill.BillNo}: {irn}");
                        successCount++;
                    }
                    else
                    {
                        AddError($"Bill #{bill.BillNo}", "Failed to save E-Invoice data",
                            $"IRN generated ({irn}) but database save failed.");
                        failCount++;
                    }
                }
                catch (HttpRequestException httpEx)
                {
                    AddError($"Bill #{bill.BillNo}", "Network error occurred", httpEx.Message);
                    failCount++;
                }
                catch (Exception ex)
                {
                    AddError($"Bill #{bill.BillNo}", "Unexpected error", ex.Message);
                    failCount++;
                }
            }

            if (allResponses.Any())
            {
                eInvoiceJson = string.Join("\n\n// ========================================\n\n", allResponses);
            }

            generatedIrn = string.Join("\n", generatedIrns);

            // Show toast notification with summary
            if (successCount > 0 && failCount == 0)
            {
                ToastService.Success($"✅ All {successCount} invoice(s) generated successfully!");
            }
            else if (successCount > 0 && failCount > 0)
            {
                ToastService.Warning($"⚠️ Partial Success: {successCount} succeeded, {failCount} failed");
            }
            else if (failCount > 0)
            {
                ToastService.Error($"❌ All {failCount} invoice(s) failed to generate");
            }

            if (successCount > 0)
            {
                if (OnGenerateEInvoice.HasDelegate)
                    await OnGenerateEInvoice.InvokeAsync(SelectedBills);
            }

        }
        catch (Exception ex)
        {
            AddError("Critical Error", "E-Invoice generation process failed", ex.Message);
            ToastService.Error("Generation failed!");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private string ExtractError(JsonElement parsed)
    {
        try
        {
            if (parsed.TryGetProperty("ErrorDetails", out var err) &&
                err.ValueKind == JsonValueKind.Array &&
                err.GetArrayLength() > 0)
            {
                var errorMsg = SafeGet(err[0], "ErrorMessage") ?? "Unknown error";
                var errorCode = SafeGet(err[0], "ErrorCode");

                if (!string.IsNullOrWhiteSpace(errorCode))
                    return $"[{errorCode}] {errorMsg}";

                return errorMsg;
            }
        }
        catch { }

        return "Unknown error occurred";
    }

    private async Task CopyToClipboard()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", jsonPreview);
            ToastService.Success("JSON copied!");
        }
        catch
        {
            ToastService.Error("Failed to copy.");
        }
    }
}