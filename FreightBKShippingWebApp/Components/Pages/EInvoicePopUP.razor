    .json-header, .response-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.75rem;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .success-response .section-title {
        color: #0f5132;
    }

    .error-response .section-title {
        color: #842029;
    }

    .irn-badge {
        background: #0f5132;
        color: white;
        padding: 0.25rem 0.75rem;
        border-radius: 4px;
        font-size: 0.8rem;
    }

    .irn-badge small {
