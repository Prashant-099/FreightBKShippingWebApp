@using System.Text.Json
@using FreightBKShippingWebApp.Model
@using FreightBKShippingWebApp.Models
@using FreightBKShippingWebApp.Services
@using System.Text
@using Microsoft.JSInterop
@inject ToasteService ToastService
@inject BillService BillService
@inject EinvConfigService EinvConfigService
@inject HttpClient HttpClient
@inject IJSRuntime JSRuntime

<DxPopup @bind-Visible="Visible"
         Width="95%"
         MaxWidth="1600px"
         ShowCloseButton="true"
         CloseOnOutsideClick="false"
         HeaderText="E-Invoice Preview & Submission"
         BodyCssClass="popup-body"
         HorizontalAlignment="HorizontalAlignment.Center"
         VerticalAlignment="VerticalAlignment.Center">

    <BodyTemplate>

        <div class="einvoice-container">

            <!-- SELECTED BILLS SECTION -->
            <div class="bills-summary">
                <h6 class="section-title">
                    <i class="bi bi-file-earmark-text"></i> Selected Bills
                </h6>

                @if (SelectedBills?.Any() == true)
                {
                    <div class="bills-list">
                        @foreach (var b in SelectedBills)
                        {
                            <div class="bill-item">
                                <span class="bill-number">@b.BillNo</span>
                                <span class="bill-amount">₹@b.BillAmount.ToString("N2")</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <i class="bi bi-inbox"></i>
                        <p>No bills selected</p>
                    </div>
                }
            </div>

            <!-- JSON PREVIEW SECTION -->
            @if (!string.IsNullOrWhiteSpace(jsonPreview))
            {
                <div class="json-preview-section">
                    <div class="json-header">
                        <h6 class="section-title">
                            <i class="bi bi-code-square"></i> JSON Preview
                        </h6>

                        <button class="btn btn-sm btn-outline-secondary copy-btn"
                                @onclick="CopyToClipboard">
                            <i class="bi bi-clipboard"></i> Copy
                        </button>
                    </div>

                    <div class="json-preview-wrapper">
                        <pre class="json-content">@jsonPreview</pre>
                    </div>
                </div>
            }

            <!-- API RESPONSE JSON -->
            @if (!string.IsNullOrWhiteSpace(eInvoiceJson))
            {
                <div class="response-section">
                    <div class="json-header">
                        <h6 class="section-title">
                            <i class="bi bi-file-text"></i> Response JSON
                        </h6>
                    </div>

                    <div class="json-preview-wrapper">
                        <pre class="json-content">@eInvoiceJson</pre>
                    </div>
                </div>
            }

            <!-- ERROR BOX -->
            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="error-box">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    @errorMessage
                </div>
            }

            <!-- SUCCESS IRN BADGE -->
            @if (!string.IsNullOrWhiteSpace(generatedIrn))
            {
                <div class="success-box">
                    <i class="bi bi-check-circle-fill"></i>
                    <strong>IRN:</strong> @generatedIrn
                </div>
            }

            <!-- LOADING -->
            @if (isLoading)
            {
                <div class="loading-state">
                    <div class="spinner-border text-primary"></div>
                    <p class="mt-2">@loadingMessage</p>
                </div>
            }

            <!-- ACTION BUTTONS -->
            <div class="action-buttons">
                <button class="btn btn-primary" @onclick="PreviewJson" disabled="@isLoading">
                    <i class="bi bi-eye"></i> Preview JSON
                </button>

                <button class="btn btn-success" @onclick="GenerateEInvoice" disabled="@isLoading">
                    <i class="bi bi-file-earmark-check"></i>
                    @(isLoading ? "Processing..." : "Generate E-Invoice")
                </button>

                <button class="btn btn-secondary" @onclick="Hide" disabled="@isLoading">
                    <i class="bi bi-x-circle"></i> Close
                </button>
            </div>

        </div>

    </BodyTemplate>

</DxPopup>

<style>
    .einvoice-container {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        padding: 0.5rem;
    }

    .section-title {
        font-weight: 600;
        color: #2c3e50;
        display: flex;
        align-items: center;
        gap: .5rem;
    }

    .bills-summary {
        background: #f8f9fa;
        padding: 1rem;
        border-radius: 8px;
        border: 1px solid #ddd;
    }

    .bills-list {
        margin-top: .75rem;
        display: grid;
        gap: .5rem;
    }

    .bill-item {
        display: flex;
        justify-content: space-between;
        padding: .6rem .8rem;
        background: #fff;
        border: 1px solid #ccc;
        border-radius: 6px;
    }

    .json-preview-section,
    .response-section {
        background: #f8f9fa;
        padding: 1rem;
        border-radius: 8px;
        border: 1px solid #ddd;
    }

    .json-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: .75rem;
    }

    .json-preview-wrapper {
        max-height: 250px;
        overflow-y: auto;
        background: #1e1e1e;
        border-radius: 6px;
        border: 1px solid #444;
    }

    .json-content {
        padding: 1rem;
        color: #dcdcdc;
        font-size: 13px;
        white-space: pre;
        margin: 0;
    }

    .error-box {
        background: #f8d7da;
        border-left: 5px solid #dc3545;
        padding: 1rem;
        border-radius: 6px;
        color: #842029;
        display: flex;
        align-items: center;
        gap: .75rem;
        font-weight: 600;
    }

    .success-box {
        background: #d1e7dd;
        border-left: 5px solid #198754;
        padding: 1rem;
        border-radius: 6px;
        color: #0f5132;
        display: flex;
        align-items: center;
        gap: .75rem;
        font-weight: 600;
    }

    .loading-state {
        text-align: center;
        padding: 2rem;
    }

    .action-buttons {
        display: flex;
        justify-content: flex-end;
        gap: .75rem;
        flex-wrap: wrap;
    }

    .empty-state {
        text-align: center;
        padding: 2rem;
        color: #6c757d;
    }

    .empty-state i {
        font-size: 3rem;
        margin-bottom: 1rem;
    }

    @@media (max-width: 768px) {
        .json-preview-wrapper {
            max-height: 200px !important;
        }

        .action-buttons {
            justify-content: stretch;
        }

        .action-buttons button {
            flex: 1;
        }
    }
</style>

@code {
    [Parameter] public EventCallback<List<Bill>> OnGenerateEInvoice { get; set; }
    [Parameter] public string ConfigUsername { get; set; } = "";
    
    public bool Visible { get; set; }
    public List<Bill> SelectedBills { get; set; } = new();
    
    private string jsonPreview = "";
    private string eInvoiceJson = "";
    private string errorMessage = "";
    private string generatedIrn = "";
    private bool isLoading = false;
    private string loadingMessage = "Loading...";

    // ------------------ SHOW -------------------
    public void Show(List<Bill> bills)
    {
        SelectedBills = bills;
        jsonPreview = "";
        eInvoiceJson = "";
        errorMessage = "";
        generatedIrn = "";
        Visible = true;
        StateHasChanged();
    }

    // ------------------ HIDE -------------------
    public void Hide()
    {
        Visible = false;
        SelectedBills.Clear();
        jsonPreview = "";
        eInvoiceJson = "";
        errorMessage = "";
        generatedIrn = "";
        isLoading = false;
    }

    // ------------------ PREVIEW JSON -------------------
    private async Task PreviewJson()
    {
        if (SelectedBills == null || SelectedBills.Count == 0)
        {
            ToastService.Error("No bills selected.");
            return;
        }

        var bill = SelectedBills.First();
        isLoading = true;
        loadingMessage = "Generating JSON preview...";
        errorMessage = "";
        eInvoiceJson = "";
        generatedIrn = "";
        StateHasChanged();

        try
        {
            var rawJson = await BillService.GetEInvoiceRawAsync(bill.BillId);

            if (string.IsNullOrWhiteSpace(rawJson))
            {
                errorMessage = "Unable to generate JSON.";
                ToastService.Error(errorMessage);
                return;
            }

            try
            {
                var parsed = JsonSerializer.Deserialize<JsonElement>(rawJson);
                jsonPreview = JsonSerializer.Serialize(parsed, new JsonSerializerOptions { WriteIndented = true });
            }
            catch
            {
                jsonPreview = rawJson;
            }

            ToastService.Success("JSON generated!");
        }
        catch (Exception ex)
        {
            errorMessage = "Error: " + ex.Message;
            ToastService.Error(errorMessage);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    // ------------------ GENERATE E-INVOICE -------------------
    private async Task GenerateEInvoice()
    {
        if (SelectedBills == null || !SelectedBills.Any())
        {
            ToastService.Error("No bills selected.");
            return;
        }

        var bill = SelectedBills.First();

        isLoading = true;
        loadingMessage = "Processing E-Invoice...";
        errorMessage = "";
        generatedIrn = "";
        eInvoiceJson = "";
        StateHasChanged();

        try
        {
            // STEP 1: Load Config
            EinvConfig? config = null;
            if (!string.IsNullOrEmpty(ConfigUsername))
                config = await EinvConfigService.GetByUsernameAsync(ConfigUsername);
            else
                config = (await EinvConfigService.GetAllAsync()).FirstOrDefault();

            if (config == null)
            {
                errorMessage = "E-Invoice configuration not found.";
                ToastService.Error(errorMessage);
                return;
            }

            // STEP 2: Get Invoice JSON
            var json = await BillService.GetEInvoiceRawAsync(bill.BillId);
            if (string.IsNullOrWhiteSpace(json))
            {
                errorMessage = "Failed to prepare invoice JSON.";
                ToastService.Error(errorMessage);
                return;
            }

            // STEP 3: Prepare API Request
            string url = $"{config.BaseUrl.TrimEnd('/')}/eicore/dec/v1.03/Invoice?QrCodeSize=250";

            var req = new HttpRequestMessage(HttpMethod.Post, url);
            req.Headers.Add("aspid", config.AspUserId);
            req.Headers.Add("password", config.Password);
            req.Headers.Add("Gstin", config.Gstin);
            req.Headers.Add("user_name", config.Username);
            req.Headers.Add("AuthToken", config.AuthToken);
            req.Content = new StringContent(json, Encoding.UTF8, "application/json");

            // STEP 4: Send Request
            var res = await HttpClient.SendAsync(req);
            var content = await res.Content.ReadAsStringAsync();

            // STEP 5: Parse Response
            var parsed = JsonSerializer.Deserialize<JsonElement>(content);
            eInvoiceJson = JsonSerializer.Serialize(parsed, new JsonSerializerOptions { WriteIndented = true });

            var status = parsed.GetProperty("Status").GetString();

            if (status == "1")
            {
                // STEP 6: Extract IRN and other data
                string? irn = null;
                string? ackNo = null;
                DateTime? ackDate = null;
                string? signedInvoice = null;
                string? signedQrCode = null;

                if (parsed.TryGetProperty("Data", out var dataNode))
                {
                    if (dataNode.TryGetProperty("Irn", out var irnNode))
                        irn = irnNode.GetString();

                    if (dataNode.TryGetProperty("AckNo", out var ackNoNode))
                        ackNo = ackNoNode.GetString();

                    if (dataNode.TryGetProperty("AckDt", out var ackDtNode))
                    {
                        var ackDtStr = ackDtNode.GetString();
                        if (DateTime.TryParse(ackDtStr, out var parsedDate))
                            ackDate = parsedDate;
                    }

                    if (dataNode.TryGetProperty("SignedInvoice", out var signedInvNode))
                        signedInvoice = signedInvNode.GetString();

                    if (dataNode.TryGetProperty("SignedQRCode", out var qrNode))
                        signedQrCode = qrNode.GetString();
                }

                if (!string.IsNullOrWhiteSpace(irn))
                {
                    generatedIrn = irn;

                    // STEP 7: Save IRN to Database
                    try
                    {
                        bool saved = await BillService.SaveEInvoiceDataAsync(
                            bill.BillId,
                            irn,
                            ackNo,
                            ackDate,
                            signedInvoice,
                            signedQrCode
                        );

                        if (saved)
                        {
                            ToastService.Success($"E-Invoice generated successfully! IRN: {irn}");
                            
                            // Trigger callback if provided
                            if (OnGenerateEInvoice.HasDelegate)
                            {
                                await OnGenerateEInvoice.InvokeAsync(SelectedBills);
                            }
                        }
                        else
                        {
                            ToastService.Warning("E-Invoice generated but failed to save to database.");
                        }
                    }
                    catch (Exception dbEx)
                    {
                        errorMessage = $"E-Invoice generated but database save failed: {dbEx.Message}";
                        ToastService.Warning(errorMessage);
                    }
                }
                else
                {
                    errorMessage = "IRN not found in response.";
                    ToastService.Error(errorMessage);
                }
            }
            else
            {
                // Read Error Message
                if (parsed.TryGetProperty("ErrorDetails", out var errArr) &&
                    errArr.GetArrayLength() > 0)
                {
                    errorMessage = errArr[0].GetProperty("ErrorMessage").GetString();
                }
                else
                {
                    errorMessage = "Unknown error occurred.";
                }

                ToastService.Error(errorMessage);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
            ToastService.Error(errorMessage);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    // ------------------ COPY TO CLIPBOARD -------------------
    private async Task CopyToClipboard()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", jsonPreview);
            ToastService.Success("JSON copied to clipboard!");
        }
        catch
        {
            ToastService.Error("Failed to copy to clipboard.");
        }
    }
}