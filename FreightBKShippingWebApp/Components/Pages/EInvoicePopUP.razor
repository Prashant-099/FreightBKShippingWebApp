</style>

@code {
    [Parameter] public EventCallback<List<Bill>> OnGenerateEInvoice { get; set; }
    [Parameter] public string ConfigUsername { get; set; } = ""; // Pass username to fetch config
    
    public bool Visible { get; set; }
    public List<Bill> SelectedBills { get; set; } = new();
    private string jsonPreview = "";
    private string eInvoiceResponse = "";
    private string errorMessage = "";
    private string generatedIrn = "";
    private bool isLoading = false;
    private string loadingMessage = "Loading...";

    // ------------------ SHOW -------------------
    public void Show(List<Bill> bills)
    {
        SelectedBills = bills;
        jsonPreview = "";
        eInvoiceResponse = "";
        errorMessage = "";
        generatedIrn = "";
        Visible = true;
        StateHasChanged();
    }

    // ------------------ HIDE -------------------
    public void Hide()
    {
        Visible = false;
        SelectedBills.Clear();
        jsonPreview = "";
        eInvoiceResponse = "";
        errorMessage = "";
        generatedIrn = "";
        isLoading = false;
    }

    // ------------------ PREVIEW JSON -------------------
    private async Task PreviewJson()
    {
        if (SelectedBills == null || SelectedBills.Count == 0)
        {
            ToasteService.Error("No bills selected.");
            return;
        }

        var firstBill = SelectedBills.First();
        isLoading = true;
        loadingMessage = "Generating JSON preview...";
        errorMessage = "";
        StateHasChanged();

        try
        {
            // 🔥 CALL API to get JSON
            string? rawJson = await BillService.GetEInvoiceRawAsync(firstBill.BillId);
            
            if (rawJson == null)
            {
                errorMessage = "Failed to generate JSON preview.";
                ToasteService.Error(errorMessage);
                return;
            }

            // 🔥 Format JSON
            try
            {
                var jsonElement = JsonSerializer.Deserialize<JsonElement>(rawJson);
                jsonPreview = JsonSerializer.Serialize(jsonElement, new JsonSerializerOptions
                {
                    WriteIndented = true
                });
            }
            catch
            {
                jsonPreview = rawJson;
            }

            ToasteService.Success("JSON preview generated successfully!");
        }
        catch (Exception ex)
        {
            errorMessage = "Error: " + ex.Message;
            ToasteService.Error(errorMessage);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    // ------------------ GENERATE E-INVOICE -------------------
    private async Task GenerateEInvoice()
    {
        if (SelectedBills == null || SelectedBills.Count == 0)
        {
            ToasteService.Error("No bills selected.");
            return;
        }

        var firstBill = SelectedBills.First();
        isLoading = true;
        loadingMessage = "Fetching E-Invoice configuration...";
        errorMessage = "";
        eInvoiceResponse = "";
        generatedIrn = "";
        StateHasChanged();

        try
        {
            // Step 1: Fetch E-Invoice Config
            EinvConfig? config = null;
            
            if (!string.IsNullOrEmpty(ConfigUsername))
            {
                config = await EinvConfigService.GetByUsernameAsync(ConfigUsername);
            }
            else
            {
                // If no username provided, try to get first available config
                var allConfigs = await EinvConfigService.GetAllAsync();
                config = allConfigs.FirstOrDefault();
            }

            if (config == null)
            {
                errorMessage = "E-Invoice configuration not found. Please configure E-Invoice settings first.";
                ToasteService.Error(errorMessage);
                return;
            }

            // Validate required fields
            if (string.IsNullOrEmpty(config.BaseUrl) || 
                string.IsNullOrEmpty(config.AspUserId) || 
                string.IsNullOrEmpty(config.Password) ||
                string.IsNullOrEmpty(config.Gstin) ||
                string.IsNullOrEmpty(config.Username) ||
                string.IsNullOrEmpty(config.AuthToken))
            {
                errorMessage = "E-Invoice configuration is incomplete. Please check all required fields.";
                ToasteService.Error(errorMessage);
                return;
            }

            loadingMessage = "Preparing invoice data...";
            StateHasChanged();

            // Step 2: Get Invoice JSON
            string? invoiceJson = await BillService.GetEInvoiceRawAsync(firstBill.BillId);
            if (string.IsNullOrEmpty(invoiceJson))
            {
                errorMessage = "Failed to prepare invoice data.";
                ToasteService.Error(errorMessage);
                return;
            }

            loadingMessage = "Submitting to GST portal...";
            StateHasChanged();

            // Step 3: Build API URL from BaseUrl
            string apiUrl = $"{config.BaseUrl.TrimEnd('/')}/eicore/dec/v1.03/Invoice?QrCodeSize=250";

            // Step 4: Prepare HTTP Request
            var request = new HttpRequestMessage(HttpMethod.Post, apiUrl);
            
            // Add Headers from Config
            request.Headers.Add("aspid", config.AspUserId);
            request.Headers.Add("password", config.Password);
            request.Headers.Add("Gstin", config.Gstin);
            request.Headers.Add("user_name", config.Username);
            request.Headers.Add("AuthToken", config.AuthToken);
            
            // Add irpurl if available (default to "1" if not set)
            string irpUrl = "1"; // Default value
            if (!string.IsNullOrEmpty(config.GspName))
            {
                // You can determine irpurl based on GSP name or add a field in config
                // For now using default "1"
                irpUrl = "1";
            }
            request.Headers.Add("irpurl", irpUrl);
            
            // Optional: Add eInvPwd if available
            if (!string.IsNullOrEmpty(config.eInvPwd))
            {
                request.Headers.Add("eInvPwd", config.eInvPwd);
            }

            // Add JSON Body
            request.Content = new StringContent(invoiceJson, System.Text.Encoding.UTF8, "application/json");

            // Step 5: Send Request
            var response = await HttpClient.SendAsync(request);
            string responseContent = await response.Content.ReadAsStringAsync();

            // Step 6: Parse Response
            if (response.IsSuccessStatusCode || !string.IsNullOrEmpty(responseContent))
            {
                try
                {
                    var jsonElement = JsonSerializer.Deserialize<JsonElement>(responseContent);
                    eInvoiceResponse = JsonSerializer.Serialize(jsonElement, new JsonSerializerOptions
                    {
                        WriteIndented = true
                    });

                    // Check Status
                    if (jsonElement.TryGetProperty("Status", out var status) && status.GetString() == "1")
                    {
                        ToasteService.Success("E-Invoice generated successfully!");
                        
                        // Extract IRN and other details
                        if (jsonElement.TryGetProperty("Data", out var dataStr))
                        {
                            try
                            {
                                var dataJson = dataStr.GetString() ?? "{}";
                                var dataObj = JsonSerializer.Deserialize<JsonElement>(dataJson);
                                
                                if (dataObj.TryGetProperty("Irn", out var irn))
                                {
                                    generatedIrn = irn.GetString() ?? "";
                                    
                                    // TODO: Save IRN to database
                                    // await BillService.UpdateIrnAsync(firstBill.BillId, generatedIrn);
                                    
                                    Console.WriteLine($"✅ Generated IRN: {generatedIrn}");
                                }

                                if (dataObj.TryGetProperty("AckNo", out var ackNo))
                                {
                                    Console.WriteLine($"✅ AckNo: {ackNo}");
                                }

                                if (dataObj.TryGetProperty("AckDt", out var ackDt))
                                {
                                    Console.WriteLine($"✅ AckDt: {ackDt}");
                                }
                            }
                            catch (Exception ex)
                            {
                                Console.WriteLine($"⚠️ Error parsing Data field: {ex.Message}");
                            }
                        }
                    }
                    else
                    {
                        // Error in response
                        errorMessage = "E-Invoice generation failed.";
                        
                        if (jsonElement.TryGetProperty("ErrorDetails", out var errors))
                        {
                            try
                            {
                                var errorArray = errors.EnumerateArray().ToList();
                                if (errorArray.Any())
                                {
                                    var firstError = errorArray.First();
                                    if (firstError.TryGetProperty("ErrorMessage", out var errMsg))
                                    {
                                        errorMessage += $" {errMsg.GetString()}";
                                    }
                                }
                            }
                            catch { }
                        }
                        
                        ToasteService.Error(errorMessage);
                    }
                }
                catch (Exception ex)
                {
                    // If JSON parsing fails, show raw response
                    eInvoiceResponse = responseContent;
                    errorMessage = "Response received but failed to parse. Check response details.";
                    Console.WriteLine($"⚠️ Parse error: {ex.Message}");
                }
            }
            else
            {
                errorMessage = $"API Error: {response.StatusCode}";
                if (!string.IsNullOrEmpty(responseContent))
                {
                    errorMessage += $" - {responseContent}";
                }
                ToasteService.Error("Failed to generate E-Invoice.");
            }
        }
        catch (HttpRequestException httpEx)
        {
            errorMessage = $"Network Error: {httpEx.Message}";
            ToasteService.Error("Failed to connect to E-Invoice API.");
            Console.WriteLine($"❌ HTTP Error: {httpEx}");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
            ToasteService.Error(errorMessage);
            Console.WriteLine($"❌ Error: {ex}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    // ------------------ COPY TO CLIPBOARD -------------------
    private async Task CopyToClipboard()
    {
        try
        {
            // Note: Requires JSInterop implementation
            // await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", jsonPreview);
            ToasteService.Success("JSON copied to clipboard!");
        }
        catch
        {
            ToasteService.Error("Failed to copy to clipboard.");
        }
    }
}