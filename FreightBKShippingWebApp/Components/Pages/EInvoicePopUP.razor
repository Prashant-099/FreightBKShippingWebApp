@using System.Text.Json
@using FreightBKShippingWebApp.Model
@using FreightBKShippingWebApp.Models
@using FreightBKShippingWebApp.Services
@using System.Text
@using Microsoft.JSInterop
@inject ToasteService ToastService
@inject BillService BillService
@inject EinvConfigService EinvConfigService
@inject HttpClient HttpClient
@inject IJSRuntime JSRuntime
@inject GstinAuthTokenService GstinAuthTokenService

<DxPopup @bind-Visible="Visible"
         Width="95%"
         MaxWidth="1600px"
         ShowCloseButton="true"
         CloseOnOutsideClick="false"
         HeaderText="E-Invoice Preview & Submission"
         BodyCssClass="popup-body"
         HorizontalAlignment="HorizontalAlignment.Center"
         VerticalAlignment="VerticalAlignment.Center">

    <BodyTemplate>

        <div class="einvoice-container">

            <!-- SELECTED BILLS SECTION -->
            <div class="bills-summary">
                <h6 class="section-title">
                    <i class="bi bi-file-earmark-text"></i> Selected Bills
                </h6>

                @if (SelectedBills?.Any() == true)
                {
                    <div class="bills-list">
                        @foreach (var b in SelectedBills)
                        {
                            <div class="bill-item">
                                <span class="bill-number">@b.BillNo</span>
                                <span class="bill-amount">₹@b.BillAmount.ToString("N2")</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <i class="bi bi-inbox"></i>
                        <p>No bills selected</p>
                    </div>
                }
            </div>

            <!-- JSON PREVIEW SECTION -->
            @if (!string.IsNullOrWhiteSpace(jsonPreview))
            {
                <div class="json-preview-section">
                    <div class="json-header">
                        <h6 class="section-title">
                            <i class="bi bi-code-square"></i> JSON Preview
                        </h6>

                        <button class="btn btn-sm btn-outline-secondary copy-btn"
                                @onclick="CopyToClipboard">
                            <i class="bi bi-clipboard"></i> Copy
                        </button>
                    </div>

                    <div class="json-preview-wrapper">
                        <pre class="json-content">@jsonPreview</pre>
                    </div>
                </div>
            }

            <!-- API RESPONSE JSON -->
            @if (!string.IsNullOrWhiteSpace(eInvoiceJson))
            {
                <div class="response-section">
                    <div class="json-header">
                        <h6 class="section-title">
                            <i class="bi bi-file-text"></i> Response JSON
                        </h6>
                    </div>

                    <div class="json-preview-wrapper">
                        <pre class="json-content">@eInvoiceJson</pre>
                    </div>
                </div>
            }

            <!-- ERROR BOX -->
            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="error-box">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    @errorMessage
                </div>
            }

            <!-- SUCCESS IRN BADGE -->
            @if (!string.IsNullOrWhiteSpace(generatedIrn))
            {
                <div class="success-box">
                    <i class="bi bi-check-circle-fill"></i>
                    <strong>IRN:</strong> @generatedIrn
                </div>
            }

            <!-- LOADING -->
            @if (isLoading)
            {
                <div class="loading-state">
                    <div class="spinner-border text-primary"></div>
                    <p class="mt-2">@loadingMessage</p>
                </div>
            }

            <!-- ACTION BUTTONS -->
            <div class="action-buttons">
                <button class="btn btn-primary" @onclick="PreviewJson" disabled="@isLoading">
                    <i class="bi bi-eye"></i> Preview JSON
                </button>

                <button class="btn btn-success" @onclick="GenerateEInvoice" disabled="@isLoading">
                    <i class="bi bi-file-earmark-check"></i>
                    @(isLoading ? "Processing..." : "Generate E-Invoice")
                </button>

                <button class="btn btn-secondary" @onclick="Hide" disabled="@isLoading">
                    <i class="bi bi-x-circle"></i> Close
                </button>
            </div>

        </div>

    </BodyTemplate>

</DxPopup>

<style>
    .einvoice-container {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        padding: 0.5rem;
    }

    .section-title {
        font-weight: 600;
        color: #2c3e50;
        display: flex;
        align-items: center;
        gap: .5rem;
    }

    .bills-summary {
        background: #f8f9fa;
        padding: 1rem;
        border-radius: 8px;
        border: 1px solid #ddd;
    }

    .bills-list {
        margin-top: .75rem;
        display: grid;
        gap: .5rem;
    }

    .bill-item {
        display: flex;
        justify-content: space-between;
        padding: .6rem .8rem;
        background: #fff;
        border: 1px solid #ccc;
        border-radius: 6px;
    }

    .json-preview-section,
    .response-section {
        background: #f8f9fa;
        padding: 1rem;
        border-radius: 8px;
        border: 1px solid #ddd;
    }

    .json-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: .75rem;
    }

    .json-preview-wrapper {
        max-height: 250px;
        overflow-y: auto;
        background: #1e1e1e;
        border-radius: 6px;
        border: 1px solid #444;
    }

    .json-content {
        padding: 1rem;
        color: #dcdcdc;
        font-size: 13px;
        white-space: pre;
        margin: 0;
    }

    .error-box {
        background: #f8d7da;
        border-left: 5px solid #dc3545;
        padding: 1rem;
        border-radius: 6px;
        color: #842029;
        display: flex;
        align-items: center;
        gap: .75rem;
        font-weight: 600;
    }

    .success-box {
        background: #d1e7dd;
        border-left: 5px solid #198754;
        padding: 1rem;
        border-radius: 6px;
        color: #0f5132;
        display: flex;
        align-items: center;
        gap: .75rem;
        font-weight: 600;
    }

    .loading-state {
        text-align: center;
        padding: 2rem;
    }

    .action-buttons {
        display: flex;
        justify-content: flex-end;
        gap: .75rem;
        flex-wrap: wrap;
