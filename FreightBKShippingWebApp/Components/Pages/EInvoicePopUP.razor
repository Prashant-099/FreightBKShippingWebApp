@using System.Text.Json
@using FreightBKShippingWebApp.Model
@using FreightBKShippingWebApp.Models
@using FreightBKShippingWebApp.Services
@inject ToasteService ToasteService
@inject BillService BillService
@inject EinvConfigService EinvConfigService
@inject HttpClient HttpClient

<DxPopup @bind-Visible="Visible"
         Width="90%"
         MaxWidth="1600px"
         ShowCloseButton="true"
         CloseOnOutsideClick="false"
         HeaderText="E-Invoice Preview & Generation"
         BodyCssClass="popup-body"
         horizontalAlignment="HorizontalAlignment.Center"
         verticalAlignment="VerticalAlignment.Center">
    <BodyTemplate>
        <div class="einvoice-container">
            <!-- Selected Bills Summary -->
            <div class="bills-summary">
                <h6 class="section-title">
                    <i class="bi bi-file-earmark-text"></i> Selected Bills
                </h6>
                @if (SelectedBills != null && SelectedBills.Any())
                {
                    <div class="bills-list">
                        @foreach (var b in SelectedBills)
                        {
                            <div class="bill-item">
                                <span class="bill-number">@b.BillNo</span>
                                <span class="bill-amount">₹@b.BillAmount.ToString("N2")</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <i class="bi bi-inbox"></i>
                        <p>No bills selected</p>
                    </div>
                }
            </div>

            <!-- JSON Preview Box - Only shows when JSON is available -->
            @if (!string.IsNullOrEmpty(jsonPreview))
            {
                <div class="json-preview-section">
                    <div class="json-header">
                        <h6 class="section-title">
                            <i class="bi bi-code-square"></i> Generated JSON Preview
                        </h6>
                        <button class="btn btn-sm btn-outline-secondary copy-btn" @onclick="CopyToClipboard">
                            <i class="bi bi-clipboard"></i> Copy
                        </button>
                    </div>
                    <div class="json-preview-wrapper">
                        <pre class="json-content">@jsonPreview</pre>
                    </div>
                </div>
            }

            <!-- E-Invoice Response - Only shows after successful generation -->
            @if (!string.IsNullOrEmpty(eInvoiceResponse))
            {
                <div class="response-section success-response">
                    <div class="response-header">
                        <h6 class="section-title">
                            <i class="bi bi-check-circle-fill"></i> E-Invoice Generated Successfully
                        </h6>
                        @if (!string.IsNullOrEmpty(generatedIrn))
                        {
                            <div class="irn-badge">
                                <small><strong>IRN:</strong> @generatedIrn</small>
                            </div>
                        }
                    </div>
                    <div class="response-content">
                        <pre class="response-text">@eInvoiceResponse</pre>
                    </div>
                </div>
            }

            <!-- Error Display -->
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="response-section error-response">
                    <div class="response-header">
                        <h6 class="section-title">
                            <i class="bi bi-exclamation-triangle-fill"></i> Error
                        </h6>
                    </div>
                    <div class="error-content">
                        <p>@errorMessage</p>
                    </div>
                </div>
            }

            <!-- Loading State -->
            @if (isLoading)
            {
                <div class="loading-state">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2">@loadingMessage</p>
                </div>
            }

            <!-- Action Buttons -->
            <div class="action-buttons">
                <button class="btn btn-primary" @onclick="PreviewJson" disabled="@isLoading">
                    <i class="bi bi-eye"></i>
                    <span>Preview JSON</span>
                </button>
                <button class="btn btn-success" @onclick="GenerateEInvoice" disabled="@isLoading">
                    <i class="bi bi-file-earmark-check"></i>
                    @if (isLoading)
                    {
                        <span>Processing...</span>
                    }
                    else
                    {
                        <span>Generate E-Invoice</span>
                    }
                </button>
                <button class="btn btn-secondary" @onclick="Hide" disabled="@isLoading">
                    <i class="bi bi-x-circle"></i> Close
                </button>
            </div>
        </div>
    </BodyTemplate>
</DxPopup>

<style>
