        border-color: #0d6efd;
        box-shadow: 0 2px 4px rgba(13, 110, 253, 0.1);
    }

    .bill-number {
        font-weight: 500;
        color: #495057;
    }

    .bill-amount {
        font-weight: 600;
        color: #198754;
    }

    .empty-state {
        text-align: center;
        padding: 2rem;
        color: #6c757d;
    }

    .empty-state i {
        font-size: 2.5rem;
        opacity: 0.5;
    }

    .empty-state p {
        margin-top: 0.5rem;
        margin-bottom: 0;
    }

    .json-preview-section, .response-section {
        background: #f8f9fa;
        border-radius: 8px;
        padding: 1rem;
        border: 1px solid #e0e0e0;
        animation: fadeIn 0.3s ease;
    }

    .success-response {
        border-color: #198754;
        background: #d1e7dd;
    }

    .error-response {
        border-color: #dc3545;
        background: #f8d7da;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }
        to {
