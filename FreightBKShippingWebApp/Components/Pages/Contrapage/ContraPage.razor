@page "/Contra"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using FreightBKShippingWebApp.Model
@using FreightBKShippingWebApp.Models
@using FreightBKShippingWebApp.Services
@using DevExpress.Blazor
@using Microsoft.AspNetCore.Components.Authorization
@inject JournalService JournalService
@inject ToasteService ToastService
@inject LoadingService LoadingService
@inject NavigationManager NavigationManager
@inject ConfirmationDialogService ConfirmDialogService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject AuditLogService AuditLogService
<PageTitle>Contra</PageTitle>
<style>
    .grid-size {
        max-height: 570px;
    }
</style>

<DxGrid @ref="MyGrid"
        TItem="Journal"
        Data="@ContraList"
        KeyFieldName="JournalId"
        ShowSearchBox="true"
        ShowFilterRow="true"
        PageSize="100"
        AllowSort="false"
        ShowGroupPanel="true"
        FilterMenuButtonDisplayMode="GridFilterMenuButtonDisplayMode.Always"
        FocusedRowEnabled="true"
        SelectionMode="GridSelectionMode.Multiple"
        SelectedDataItems="@SelectedContras"
        SelectedDataItemsChanged="OnSelectionChanged"
        ColumnResizeMode="GridColumnResizeMode.NextColumn"
        CssClass="grid-size"
        AllowSelectRowByClick="true">

    <ToolbarTemplate>
        <DxToolbar>
            <TitleTemplate Context="tlt">
                <div class="d-flex align-items-center">
                    <i class="bi bi-arrow-left-right me-2 py-2"></i>
                    <span class="fs-5">Contra</span>
                </div>
            </TitleTemplate>

            <Items>
                <DxToolbarItem Text="Add"
                               IconCssClass="bi bi-plus-circle"
                               Click="OnAdd" />

                <DxToolbarItem Text="Edit"
                               IconCssClass="bi bi-pencil-square"
                               Click="OnEdit" />

                <DxToolbarItem Text="Delete"
                               IconCssClass="bi bi-trash"
                               Click="OnDelete" />

                @if (IsAdmin)
                {
                    <DxToolbarItem Text="@GetLockText()"
                                   IconCssClass="@GetLockIcon()"
                                   Click="OnToggleLock" />
                }

                <DxToolbarItem Text="Refresh"
                               IconCssClass="bi bi-arrow-clockwise"
                               Click="@(async (_) => await LoadContras())" />

                <DxToolbarItem Alignment="ToolbarItemAlignment.Right"
                               RenderStyle="ButtonRenderStyle.Secondary"
                               IconCssClass="bi bi-gear-wide-connected"
                               Click="ShowLayoutPopup" />
            </Items>
        </DxToolbar>
    </ToolbarTemplate>

    <Columns>
        <DxGridSelectionColumn Width="40" />

        <DxGridDataColumn FieldName="JournalLockedByUsername" Caption="Locked By"
                          Width="@(layoutManager?.GetColumnWidth("JournalLockedByUsername") ?? "150px")">
            <CellDisplayTemplate>
                @{
                    var j = context.DataItem as Journal;
                    if (!string.IsNullOrEmpty(j?.JournalLockedByUsername))
                    {
                        <span class="badge bg-warning text-dark">
                            <i class="bi bi-lock-fill"></i>
                            @j.JournalLockedByUsername
                        </span>
                    }
                    else
                    {
                        <span class="text-muted">—</span>
                    }
                }
            </CellDisplayTemplate>
        </DxGridDataColumn>

        <DxGridDataColumn FieldName="VoucherName" Caption="Voucher Type"
                          Width="@(layoutManager?.GetColumnWidth("VoucherName") ?? "140px")"
                          Visible="@(layoutManager?.GetColumnVisibility("VoucherName") ?? true)" />

        <DxGridDataColumn FieldName="JournalNoStr" Caption="Contra No"
                          Width="@(layoutManager?.GetColumnWidth("JournalNoStr") ?? "130px")"
                          Visible="@(layoutManager?.GetColumnVisibility("JournalNoStr") ?? true)" />

        <DxGridDataColumn FieldName="JournalDate" Caption="Date" DisplayFormat="dd/MM/yyyy"
                          Width="@(layoutManager?.GetColumnWidth("JournalDate") ?? "120px")"
                          Visible="@(layoutManager?.GetColumnVisibility("JournalDate") ?? true)" />

        <DxGridDataColumn FieldName="AccountName" Caption="From (Cash/Bank)"
                          Width="@(layoutManager?.GetColumnWidth("AccountName") ?? "200px")"
                          Visible="@(layoutManager?.GetColumnVisibility("AccountName") ?? true)" />

        <DxGridDataColumn FieldName="PartyName" Caption="To (Cash/Bank)"
                          Width="@(layoutManager?.GetColumnWidth("PartyName") ?? "200px")"
                          Visible="@(layoutManager?.GetColumnVisibility("PartyName") ?? true)" />

        <DxGridDataColumn FieldName="JournalAmount" Caption="Amount"
                          Width="@(layoutManager?.GetColumnWidth("JournalAmount") ?? "150px")"
                          Visible="@(layoutManager?.GetColumnVisibility("JournalAmount") ?? true)" />

        <DxGridDataColumn FieldName="JournalRemarks" Caption="Remarks"
                          Width="@(layoutManager?.GetColumnWidth("JournalRemarks") ?? "200px")"
                          Visible="@(layoutManager?.GetColumnVisibility("JournalRemarks") ?? true)" />
    </Columns>
</DxGrid>

<ContraAddEditPage @ref="Popup" OnSaved="LoadContras" />
<ConfirmationDialog />

<GridLayoutpPopup @ref="layoutManager"
                  VoucherType="Contra"
                  Columns="@allColumns"
                  OnLayoutChanged="HandleLayoutChanged" />

@code {
    private IGrid? MyGrid;
    private ContraAddEditPage? Popup;

    private List<Journal> ContraList = new();
    private IReadOnlyList<object> SelectedContras = new List<object>();

    private bool IsAdmin;
    private string CurrentUserId = string.Empty;

    private GridLayoutpPopup? layoutManager;
    private List<GridColumnLayout> allColumns = [];

    private async void ShowLayoutPopup()
    {
        await InvokeAsync(() => layoutManager?.ShowPopup());
    }

    private async Task HandleLayoutChanged(List<GridColumnLayout> updatedLayout)
    {
        allColumns = updatedLayout;
        await InvokeAsync(StateHasChanged);
    }

    private void InitializeColumns()
    {
        allColumns = new List<GridColumnLayout>
        {
            new() { FieldName = "JournalLockedByUsername", Caption = "Locked By",    Visible = true, Width = 150, DisplayIndex = 0 },
            new() { FieldName = "VoucherName",             Caption = "Voucher Type",  Visible = true, Width = 140, DisplayIndex = 1 },
            new() { FieldName = "JournalNoStr",            Caption = "Contra No",     Visible = true, Width = 130, DisplayIndex = 2 },
            new() { FieldName = "JournalDate",             Caption = "Date",          Visible = true, Width = 120, DisplayIndex = 3 },
            new() { FieldName = "AccountName",             Caption = "From (Cash/Bank)", Visible = true, Width = 200, DisplayIndex = 4 },
            new() { FieldName = "PartyName",               Caption = "To (Cash/Bank)",   Visible = true, Width = 200, DisplayIndex = 5 },
            new() { FieldName = "JournalAmount",           Caption = "Amount",        Visible = true, Width = 150, DisplayIndex = 6 },
            new() { FieldName = "JournalRemarks",          Caption = "Remarks",       Visible = true, Width = 200, DisplayIndex = 7 },
        };
    }

    protected override async Task OnInitializedAsync()
    {
        InitializeColumns();
        await CheckRole();
        await LoadContras();
    }

    private async Task LoadContras()
    {
        try
        {
            LoadingService.Show();
            ContraList = (await JournalService.GetAllAsync())
                .Where(j => j.JournalMasterType == "CONTRA")
                .OrderByDescending(j => j.JournalDate)
                .ToList();
        }
        finally
        {
            LoadingService.Hide();
        }
    }

    private void OnAdd(ToolbarItemClickEventArgs e)
        => Popup?.Show(new Journal { JournalDate = DateTime.Now });

    private void OnEdit(ToolbarItemClickEventArgs e)
    {
        var journal = MyGrid?.GetFocusedDataItem() as Journal;
        if (journal == null)
        {
            ToastService.Warning("Select a contra entry to edit.");
            return;
        }

        if (!string.IsNullOrEmpty(journal.JournalLockedBy))
        {
            ToastService.Error("This contra entry is locked.");
            return;
        }

        var freshData = ContraList.FirstOrDefault(x => x.JournalId == journal.JournalId);
        if (freshData != null)
            Popup?.Show(freshData);
    }

    private async Task OnDelete(ToolbarItemClickEventArgs e)
    {
        if (SelectedContras == null || !SelectedContras.Any())
        {
            ToastService.Warning("Select contra entry/entries to delete.");
            return;
        }

        var selectedList = SelectedContras.Cast<Journal>().ToList();

        var confirm = await ConfirmDialogService.ShowAsync(
            $"Are you sure you want to delete {selectedList.Count} selected contra entry/entries?");

        if (!confirm)
        {
            MyGrid?.ClearSelection();
            return;
        }

        try
        {
            LoadingService.Show("Deleting...");
            int successCount = 0, failCount = 0;
            List<string> errorMessages = new();
            foreach (var journal in selectedList)
            {
                var result = await JournalService.DeleteAsync(journal.JournalId);
                if (result.Success)
                {
                    successCount++;
                    AuditLogService.NotifyAuditChanged();
                }
                else
                {
                    failCount++;
                    errorMessages.Add(result.Error);
                }
            }

            if (successCount > 0)
                ToastService.Success($"{successCount} Contra entry Deleted Successfully.");
            if (failCount > 0) ToastService.Error($"{failCount} Contra entry Failed To Delete.\nDetails: {string.Join("\n", errorMessages.Distinct())}");
            await LoadContras();
        }
        finally
        {
            LoadingService.Hide();
            MyGrid?.ClearSelection();
        }
    }

    private async Task OnToggleLock(ToolbarItemClickEventArgs e)
    {
        foreach (var j in SelectedContras.Cast<Journal>())
            await JournalService.ToggleLockAsync(j.JournalId);

        await LoadContras();
        MyGrid?.ClearSelection();
    }

    private async Task OnSelectionChanged(IReadOnlyList<object> items)
    {
        SelectedContras = items ?? new List<object>();
        await InvokeAsync(StateHasChanged);
    }

    private string GetLockText()
        => SelectedContras.Any(j => string.IsNullOrEmpty(((Journal)j).JournalLockedBy))
            ? "Lock"
            : "Unlock";

    private string GetLockIcon()
        => SelectedContras.Any(j => string.IsNullOrEmpty(((Journal)j).JournalLockedBy))
            ? "bi bi-lock"
            : "bi bi-unlock";

    private async Task CheckRole()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = state.User;
        IsAdmin = user.IsInRole("Admin");
        CurrentUserId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
    }
}
