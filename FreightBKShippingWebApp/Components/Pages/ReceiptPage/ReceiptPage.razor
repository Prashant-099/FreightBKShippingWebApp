@page "/Receipt"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using FreightBKShippingWebApp.Model
@using FreightBKShippingWebApp.Models
@using FreightBKShippingWebApp.Services
@using DevExpress.Blazor
@using Microsoft.AspNetCore.Components.Authorization
@inject JournalService JournalService
@inject ToasteService ToastService
@inject LoadingService LoadingService
@inject NavigationManager NavigationManager
@inject ConfirmationDialogService ConfirmDialogService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject AuditLogService AuditLogService
@inject ReportService ReportService
@inject ReportDataService ReportDataService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
<PageTitle>Receipts</PageTitle>
<style>
    .grid-size {
        max-height: 570px;
    }


  
</style>
    
           <DxGrid @ref="MyGrid"
        TItem="Journal"
        Data="@ReceiptList"
        KeyFieldName="JournalId"
        ShowSearchBox="true"
        ShowFilterRow="true"
        PageSize="100"
        AllowSort="false"
        ShowGroupPanel="true"
        FilterMenuButtonDisplayMode="GridFilterMenuButtonDisplayMode.Always"
        FocusedRowEnabled="true"
        SelectionMode="GridSelectionMode.Multiple"
        SelectedDataItems="@SelectedReceipts"
        SelectedDataItemsChanged="OnSelectionChanged"
        ColumnResizeMode="GridColumnResizeMode.NextColumn"
        CssClass="grid-size"
        AllowSelectRowByClick="true">

    <ToolbarTemplate>
        <DxToolbar>
            <TitleTemplate Context="tlt">
                <div class="d-flex align-items-center">
                    <i class="bi bi-cash me-2 py-2"></i>
                    <span class="fs-5">Receipts</span>
                </div>
            </TitleTemplate>

            <Items>
                <DxToolbarItem Text="Add"
                               IconCssClass="bi bi-plus-circle"
                               Click="OnAdd" />

                <DxToolbarItem Text="Edit"
                               IconCssClass="bi bi-pencil-square"
                               Click="OnEdit" />

                <DxToolbarItem Text="Delete"
                               IconCssClass="bi bi-trash"
                               Click="OnDelete" />


                <DxToolbarItem Context="cfdr"
                               Text="Print"
                               RenderStyleMode="ToolbarItemRenderStyleMode.Contained"
                               RenderStyle="ButtonRenderStyle.Secondary"
                               IconCssClass="bi bi-printer">
                    <Items>
                        <DxToolbarItem Text="Print PDF" IconCssClass="bi bi-printer" Click="@(async () => await PrintReports(false))" />
                        <DxToolbarItem Text="Print Preview" IconCssClass="bi bi-printer" Click="@((_) => ShowReportPopup())"></DxToolbarItem>
                    </Items>
                </DxToolbarItem>

                @* <DxToolbarItem Text="Print Preview" IconCssClass="bi bi-printer" Click="@((_) => ShowReportPopup())"></DxToolbarItem> *@

                   
             
                @if (IsAdmin)
                {
                    <DxToolbarItem Text="@GetLockText()"
                                   IconCssClass="@GetLockIcon()"
                                   Click="OnToggleLock" />
                }

                <DxToolbarItem Text="Refresh"
                               IconCssClass="bi bi-arrow-clockwise"
                               Click="@(async (_) => await LoadReceipts())" />

                <DxToolbarItem Alignment="ToolbarItemAlignment.Right"
                               RenderStyle="ButtonRenderStyle.Secondary"
                               IconCssClass="bi bi-gear-wide-connected"
                               Click="ShowLayoutPopup" />

            </Items>
        </DxToolbar>
    </ToolbarTemplate>
                <Columns>
                    <DxGridSelectionColumn Width="40" />
        <DxGridDataColumn FieldName="JournalLockedByUsername" Caption="  Locked By"
            Width="@(layoutManager?.GetColumnWidth("JournalLockedByUsername") ?? "150px")">
      
            <CellDisplayTemplate>
                @{
                    var j = context.DataItem as Journal;


                    if (!string.IsNullOrEmpty(j?.JournalLockedByUsername))
                    {
                        <span class="badge bg-warning text-dark">
                            <i class="bi bi-lock-fill"></i>
                            @j.JournalLockedByUsername
                        </span>
                    }
                    else
                    {
                        <span class="text-muted">—</span>
                    }
                }
            </CellDisplayTemplate>
        </DxGridDataColumn>
        <DxGridDataColumn FieldName="VoucherName" Caption="Voucher Type" Width="@(layoutManager?.GetColumnWidth("VoucherName") ?? "140px")"
                          Visible="@(layoutManager?.GetColumnVisibility("VoucherName") ?? true)" />

        <DxGridDataColumn FieldName="JournalNoStr" Caption="Receipt No" Width="@(layoutManager?.GetColumnWidth("JournalNoStr") ?? "130px")"
                          Visible="@(layoutManager?.GetColumnVisibility("JournalNoStr") ?? true)" />

        <DxGridDataColumn FieldName="JournalDate" Caption="Date" DisplayFormat="dd/MM/yyyy" Width="@(layoutManager?.GetColumnWidth("JournalDate") ?? "120px")"
                          Visible="@(layoutManager?.GetColumnVisibility("JournalDate") ?? true)" />

        <DxGridDataColumn FieldName="PartyName" Caption="Customer" Width="@(layoutManager?.GetColumnWidth("PartyName") ?? "270px")"
                          Visible="@(layoutManager?.GetColumnVisibility("PartyName") ?? true)" />

        <DxGridDataColumn FieldName="AccountName" Caption="Cash / Bank" Width="@(layoutManager?.GetColumnWidth("AccountName") ?? "160px")"
                          Visible="@(layoutManager?.GetColumnVisibility("AccountName") ?? true)" />

        <DxGridDataColumn FieldName="JournalAmount" Caption="Received Amount" Width="@(layoutManager?.GetColumnWidth("JournalAmount") ?? "170px")"
                          Visible="@(layoutManager?.GetColumnVisibility("JournalAmount") ?? true)" />

        <DxGridDataColumn FieldName="JournalTotalDiscount" Caption="Discount" Width="@(layoutManager?.GetColumnWidth("JournalTotalDiscount") ?? "120px")"
                          Visible="@(layoutManager?.GetColumnVisibility("JournalTotalDiscount") ?? true)" />

        <DxGridDataColumn FieldName="JournalTotalShort" Caption="Shortage" Width="@(layoutManager?.GetColumnWidth("JournalTotalShort") ?? "120px")"
                          Visible="@(layoutManager?.GetColumnVisibility("JournalTotalShort") ?? true)" />

        <DxGridDataColumn FieldName="JournalTotalTds" Caption="TDS" Width="@(layoutManager?.GetColumnWidth("JournalTotalTds") ?? "120px")"
                          Visible="@(layoutManager?.GetColumnVisibility("JournalTotalTds") ?? true)" />

        <DxGridDataColumn FieldName="JournalOnAccount" Caption="On Account" Width="@(layoutManager?.GetColumnWidth("JournalOnAccount") ?? "130px")"
                          Visible="@(layoutManager?.GetColumnVisibility("JournalOnAccount") ?? true)" />

        <DxGridDataColumn FieldName="JournalTotal" Caption="Total" Width="@(layoutManager?.GetColumnWidth("JournalTotal") ?? "130px")"
                          Visible="@(layoutManager?.GetColumnVisibility("JournalTotal") ?? true)" />

       @*  <DxGridDataColumn FieldName="JournalChqNo" Caption="Chq. No" Width="@(layoutManager?.GetColumnWidth("JournalChqNo") ?? "120px")"
                          Visible="@(layoutManager?.GetColumnVisibility("JournalChqNo") ?? true)" />

        <DxGridDataColumn FieldName="JournalChqDate" Caption="Chq Date" DisplayFormat="dd/MM/yyyy" Width="@(layoutManager?.GetColumnWidth("JournalChqDate") ?? "120px")"
                          Visible="@(layoutManager?.GetColumnVisibility("JournalChqDate") ?? true)" /> *@

        <DxGridDataColumn FieldName="JournalRemarks" Caption="Remarks" Width="@(layoutManager?.GetColumnWidth("JournalRemarks") ?? "200px")"
                          Visible="@(layoutManager?.GetColumnVisibility("JournalRemarks") ?? true)" />

      
                </Columns>
            </DxGrid>


<DxPopup @bind-Visible="IsReportPopupVisible"
         ShowCloseButton="true"
         Width="400px"
         HeaderText="Select Report"
         CloseOnOutsideClick="true"
         CloseOnEscape="true">
    <div class="p-3">
        <DxFormLayout>
            <DxFormLayoutItem Caption="Report" ColSpanMd="12">
                <DxComboBox Data="@ReportDataList"
                            TextFieldName="FormatName"
                            ValueFieldName="ReportDataId"
                            AllowUserInput="true"
                            NullText="-- Select Report --"
                            @bind-Value="SelectedReportId"
                            SearchMode="ListSearchMode.AutoSearch"
                            SearchFilterCondition="ListSearchFilterCondition.StartsWith"
                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
            </DxFormLayoutItem>
        </DxFormLayout>
        <div class="mt-3 d-flex justify-content-end gap-2">
            <DxButton Text="OK" RenderStyle="ButtonRenderStyle.Primary" IconCssClass="bi bi-box-arrow-right" Click="@ConfirmReportSelection" />
            <DxButton Text="Cancel" RenderStyle="ButtonRenderStyle.Danger" IconCssClass="bi bi-x-circle" Click="@(() => IsReportPopupVisible = false)" />
        </div>
    </div>
</DxPopup>

<ReceiptAddEditPage @ref="Popup" OnSaved="LoadReceipts" />
<ConfirmationDialog />

<GridLayoutpPopup @ref="layoutManager"
                  VoucherType="Receipt"
                  Columns="@allColumns"
                  OnLayoutChanged="HandleLayoutChanged" />
<script>
    window.downloadFileFromStream = async (fileName, contentStreamReference) => {
        const arrayBuffer = await contentStreamReference.arrayBuffer();
        const blob = new Blob([arrayBuffer]);
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = fileName;
        a.click();
        URL.revokeObjectURL(url);
    };
</script>
@code {
    private IGrid? MyGrid;
    private ReceiptAddEditPage? Popup;
    private List<ReportData> ReportDataList = new();

    private List<Journal> ReceiptList = new();
    private IReadOnlyList<object> SelectedReceipts = new List<object>();

    private bool IsAdmin;
    private string CurrentUserId = string.Empty;

    // Grid Layout Manager Reference
    private GridLayoutpPopup? layoutManager;
    private List<GridColumnLayout> allColumns = [];
    private async void ShowLayoutPopup()
    {
        await InvokeAsync(() =>
        {
            layoutManager?.ShowPopup();
        });
    }
    private async Task HandleLayoutChanged(List<GridColumnLayout> updatedLayout)
    {
        allColumns = updatedLayout;
        // Force the grid to re-render with new layout
        await InvokeAsync(StateHasChanged);
    }
    private void InitializeColumns()
    {
        allColumns = new List<GridColumnLayout>
{
    new() { FieldName = "JournalLockedByUsername", Caption = "Lockby", Visible = true, Width = 150, DisplayIndex = 0 },

    new() { FieldName = "VoucherName", Caption = "Voucher Type", Visible = true, Width = 140, DisplayIndex = 1 },

    new() { FieldName = "JournalNoStr", Caption = "Receipt No", Visible = true, Width = 130, DisplayIndex = 2 },

    new() { FieldName = "JournalDate", Caption = "Date", Visible = true, Width = 120, DisplayIndex = 3 },

    new() { FieldName = "PartyName", Caption = "Customer", Visible = true, Width = 270, DisplayIndex = 4 },

    new() { FieldName = "AccountName", Caption = "Cash / Bank", Visible = true, Width = 160, DisplayIndex = 5 },

    new() { FieldName = "JournalAmount", Caption = "Received Amount", Visible = true, Width = 170, DisplayIndex = 6 },

    new() { FieldName = "JournalTotalDiscount", Caption = "Discount", Visible = true, Width = 120, DisplayIndex = 7 },

    new() { FieldName = "JournalTotalShort", Caption = "Shortage", Visible = true, Width = 120, DisplayIndex = 8 },

    new() { FieldName = "JournalTotalTds", Caption = "TDS", Visible = true, Width = 120, DisplayIndex = 9 },

    new() { FieldName = "JournalOnAccount", Caption = "On Account", Visible = true, Width = 130, DisplayIndex = 10 },

    new() { FieldName = "JournalTotal", Caption = "Total", Visible = true, Width = 130, DisplayIndex = 11 },

    // new() { FieldName = "JournalChqNo", Caption = "Chq. No", Visible = true, Width = 120, DisplayIndex = 12 },

    // new() { FieldName = "JournalChqDate", Caption = "Chq Date", Visible = true, Width = 120, DisplayIndex = 13 },

    new() { FieldName = "JournalRemarks", Caption = "Remarks", Visible = true, Width = 200, DisplayIndex = 12}
};

    }
    protected override async Task OnInitializedAsync()
    {
        InitializeColumns();
        await CheckRole();
        await LoadReceipts();
        ReportDataList = (await ReportDataService.GetAllAsync()).Where(r => r.DocType.Equals("ReceiptPayment", StringComparison.OrdinalIgnoreCase)).ToList();

    }

    private async Task LoadReceipts()
    {
        try
        {
            LoadingService.Show();
            ReceiptList = (await JournalService.GetAllAsync())
                .Where(j => j.JournalMasterType == "RECEIPT")
                .OrderByDescending(j => j.JournalDate)
                .ToList();
        }
        finally
        {
            LoadingService.Hide();
        }
    }

    private void OnAdd(ToolbarItemClickEventArgs e)
        => Popup?.Show(new Journal { JournalDate = DateTime.Now });

    private void OnEdit(ToolbarItemClickEventArgs e)
    {
        var journal = MyGrid?.GetFocusedDataItem() as Journal;
        if (journal == null)
        {
            ToastService.Warning("Select a receipt to edit.");
            return;
        }

        if (!string.IsNullOrEmpty(journal.JournalLockedBy))
        {
            ToastService.Error("This receipt is locked.");
            return;
        }
        var freshData = ReceiptList
            .FirstOrDefault(x => x.JournalId == journal.JournalId);

        if (freshData != null)
            Popup?.Show(freshData);
    }

    private async Task OnDelete(ToolbarItemClickEventArgs e)
    {
        if (SelectedReceipts == null || !SelectedReceipts.Any())
        {   
            ToastService.Warning("Select receipt(s) to delete.");
            return;
        }

        var selectedList = SelectedReceipts.Cast<Journal>().ToList();

        var confirm = await ConfirmDialogService.ShowAsync(
            $"Are you sure you want to delete {selectedList.Count} selected receipt(s)?");

        if (!confirm)
        {
            MyGrid?.ClearSelection(); // ✅ Clear on cancel
            return;
        }

        try
        {
            LoadingService.Show("Deleting...");
            int successCount = 0, failCount = 0;
            List<string> errorMessages = new();
            foreach (var journal in selectedList)
            {
                var result = await JournalService.DeleteAsync(journal.JournalId);
                if (result.Success)
                {
                    successCount++;
                    AuditLogService.NotifyAuditChanged();

                }

                else
                {
                    failCount++;
                    errorMessages.Add(result.Error);
                }
            }

            if (successCount > 0)
                ToastService.Success($"{successCount} Receipt(s) Deleted Successfully.");
            if (failCount > 0) ToastService.Error($"{failCount} Receipt(s) Failed To Delete.\nDetails: {string.Join("\n", errorMessages.Distinct())}");
            await LoadReceipts();
        }
        finally
        {
            LoadingService.Hide();
            MyGrid?.ClearSelection(); // ✅ Always clear (success/fail)
        }
    }


    private async Task OnToggleLock(ToolbarItemClickEventArgs e)
    {
        foreach (var j in SelectedReceipts.Cast<Journal>())
            await JournalService.ToggleLockAsync(j.JournalId);

        await LoadReceipts();
        MyGrid?.ClearSelection();
    }

    private async Task OnSelectionChanged(IReadOnlyList<object> items)
    { SelectedReceipts = items?? new List<object>();
        SelectedReceipts = items ?? new List<object>();
        await InvokeAsync(StateHasChanged);
    }
    private string GetLockText()
        => SelectedReceipts.Any(j => string.IsNullOrEmpty(((Journal)j).JournalLockedBy))
            ? "Lock"
            : "Unlock";

    private string GetLockIcon()
        => SelectedReceipts.Any(j => string.IsNullOrEmpty(((Journal)j).JournalLockedBy))
            ? "bi bi-lock"
            : "bi bi-unlock";

    private async Task CheckRole()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = state.User;
        IsAdmin = user.IsInRole("Admin");
        CurrentUserId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
    }








    private bool IsReportPopupVisible = false;
    private int? SelectedReportId;
    private async Task PrintReports(bool sendViaWhatsapp = false)
    {
        if (SelectedReceipts == null || SelectedReceipts.Count == 0)
        {
            ToastService.Warning("Select at least one Receipt.");
            return;
        }

        var ReceiptList = SelectedReceipts.Cast<Journal>().ToList();
        LoadingService.Show("Building merged PDF...");

        try
        {
            var receiptByReportId = ReportDataList;
            var allReports = new List<DevExpress.XtraReports.UI.XtraReport>();

            foreach (var group in receiptByReportId)
            {
                var reportId = group.ReportDataId;
                var groupReceipt = ReceiptList.ToList();
                var layoutBytes = await ReportDataService.GetLayoutBytesAsync(reportId);

                if (layoutBytes == null || layoutBytes.Length == 0)
                {
                    var billNos = string.Join(", ", groupReceipt.Select(q => q.JournalNoStr));
                    ToastService.Error($"Failed to load report layout for Report ID: {reportId}, Receipt No: {billNos}");
                    continue;
                }

                var dtoList = new List<PrintJournalFullDto>();
                foreach (var receipt in groupReceipt)
                {
                    var dto = await JournalService.GetPrintableBillAsync(receipt.JournalId);
                    dtoList.Add(dto);
                }

                var dtoDict = groupReceipt.Select((receipt, i) => new { receipt, dto = dtoList[i] })
                    .ToDictionary(x => x.receipt, x => x.dto);

                await ReportService.CreateMergedReportAsync(
                    groupReceipt,
                    receipt => dtoDict.ContainsKey(receipt) ? dtoDict[receipt] : null,
                    layoutBytes);

                if (ReportService.MergedReport != null)
                {
                    allReports.Add(ReportService.MergedReport);
                }
            }

            if (!allReports.Any())
            {
                ToastService.Error("Failed to generate any reports.");
                return;
            }

            using var pdfStream = new MemoryStream();

            if (allReports.Count == 1)
            {
                allReports[0].ExportToPdf(pdfStream);
            }
            else
            {
                var combinedReport = new DevExpress.XtraReports.UI.XtraReport();
                foreach (var report in allReports)
                {
                    if (report.Pages.Count == 0) report.CreateDocument();
                    foreach (DevExpress.XtraPrinting.Page page in report.Pages)
                    {
                        combinedReport.Pages.Add(page);
                    }
                }
                combinedReport.ExportToPdf(pdfStream);
            }

            pdfStream.Position = 0;

            string fileName = ReceiptList.Count == 1
                ? $"{ReceiptList.First().JournalNoStr?.Replace("/", "_") ?? "Receipt"}.pdf"
                : $"Receipts_{ReceiptList.First().JournalNoStr?.Replace("/", "_")}_to_{ReceiptList.Last().JournalNoStr?.Replace("/", "_")}.pdf";

            using var streamRef = new Microsoft.JSInterop.DotNetStreamReference(pdfStream);
            await JSRuntime.InvokeVoidAsync("downloadFileFromStream", fileName, streamRef);

            ToastService.Success("PDF downloaded successfully.");
        }
        catch (Exception ex)
        {
            ToastService.Error($"Failed to generate report: {ex.Message}");
        }
        finally
        {
            LoadingService.Hide();
            await ClearSelection();
        }
    }
    private async Task ShowReportPopup()
    {
        if (ReportDataList?.Any() != true)
        {
            ToastService.Warning("No reports available.");
            return;
        }
        SelectedReportId = null;
        IsReportPopupVisible = true;
    }

    private async Task ConfirmReportSelection()
    {
        if (SelectedReportId == null)
        {
            ToastService.Warning("Please select a report first.");
            return;
        }
        IsReportPopupVisible = false;
        await PreviewMergedReports();
    }
    // ✅ FIXED: Reliable clear selection method
    private async Task ClearSelectionManual()
    {
        try
        {
            if (MyGrid != null)
            {
                MyGrid.ClearSelection(); // ✅ Synchronous method
            }
            SelectedReceipts = new List<object>();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Clear selection error: {ex.Message}");
        }
    }

    // ✅ FIXED: Auto-clear after operations
    private async Task ClearSelection()
    {
        await Task.Delay(100); // Small delay for UI update
        await ClearSelectionManual();
    }
    private async Task PreviewMergedReports()
    {
        if (SelectedReceipts == null || SelectedReceipts.Count == 0)
        {
            ToastService.Warning("Select at least one Bill.");
            return;
        }

        if (SelectedReportId == null)
        {
            ToastService.Warning("Please select a report format.");
            return;
        }

        var receiptList = SelectedReceipts.Cast<Journal>().ToList();
        LoadingService.Show("Building merged report...");

        try
        {
            // Get the report layout
            var layoutBytes = await ReportDataService.GetLayoutBytesAsync(SelectedReportId.Value);

            if (layoutBytes == null || layoutBytes.Length == 0)
            {
                ToastService.Error($"Failed to load report layout for Report ID: {SelectedReportId}");
                return;
            }

            // Prepare DTOs for all selected bills
            var dtoList = new List<PrintJournalFullDto>();
            foreach (var receipt in receiptList)
            {
                var dto = await JournalService.GetPrintableBillAsync(receipt.JournalId);
                dtoList.Add(dto);
            }

            var dtoDict = receiptList.Select((receipt, i) => new { receipt, dto = dtoList[i] })
                                  .ToDictionary(x => x.receipt, x => x.dto);

            // Create the merged report
            try
            {
                await ReportService.CreateMergedReportAsync(
                    receiptList,
                    receipt => dtoDict.ContainsKey(receipt) ? dtoDict[receipt] : null,
                    layoutBytes);
            }
            catch (InvalidOperationException ex) when (ex.Message.Contains("CodeDOM"))
            {
                ToastService.Error("Report format incompatible. Please contact administrator to update report template.");
                LoadingService.Hide();
                return;
            }

            if (ReportService.MergedReport == null)
            {
                ToastService.Error("Failed to generate report.");
                return;
            }

            // Navigate to the report viewer
            Navigation.NavigateTo("/reportviewer");
        }
        catch (Exception ex)
        {
            ToastService.Error($"Failed to generate report: {ex.Message}");
        }
        finally
        {
            LoadingService.Hide();
            await ClearSelection();
        }
    }


}
