@page "/service"


@using FreightBKShippingWebApp.Model
@using FreightBKShippingWebApp.Services
@using FreightBKShippingWebApp.Components.Pages
@inject ServiceService ServiceService
@inject ToasteService ToastService
@inject LoadingService LoadingService
@inject ConfirmationDialogService ConfirmDialogService
@inject GridLayoutService GridLayoutService
@inject AuditLogService AuditLogService
<style>
    .grid-size {
        max-height: 600px;
    }


    /* ComboBox Styling */
    .layout-combobox {
        border-radius: 6px;
        width: 185px;
    }
</style>
<DxGrid TItem="ServiceModel" Data="@serviceList" @ref="MyGrid"
        KeyFieldName="ServiceId"
        ShowSearchBox="true"
        PageSize="10"
        PageSizeSelectorVisible="true"
        ShowGroupPanel="true"
        FilterMenuButtonDisplayMode="GridFilterMenuButtonDisplayMode.Always"
        FocusedRowEnabled="true"
        SelectionMode="GridSelectionMode.Multiple"
        SelectedDataItems="@SelectedServices"
        SelectedDataItemsChanged="OnSelectedServicesChanged"
        ColumnResizeMode="GridColumnResizeMode.NextColumn"
        CssClass="grid-size"
        AllowSelectRowByClick="true">

    <ToolbarTemplate>
        <DxToolbar>
            <TitleTemplate Context="tl">
                <div class="d-flex align-items-center">
                    <i class="bi bi-gear me-2"></i>
                    <span class="fs-5">Services</span>
                </div>
            </TitleTemplate>
            <Items>
                <DxToolbarItem Text="Add" IconCssClass="bi bi-plus-circle" Click="OnCreateNew" />
                <DxToolbarItem Text="Edit" IconCssClass="bi bi-pencil-square" Click="OnEdit" />
                <DxToolbarItem Text="Delete" IconCssClass="bi bi-trash" Click="OnDelete" />
                <DxToolbarItem Text="Refresh" IconCssClass="bi bi-arrow-clockwise" Click="@(async (_) => await LoadServicesAsync())" />
                <DxToolbarItem Alignment="ToolbarItemAlignment.Right"
                               RenderStyle="ButtonRenderStyle.Secondary"
                               IconCssClass="bi bi-gear-wide-connected"
                               Click="ShowLayoutPopup" />
            </Items>
        </DxToolbar>
    </ToolbarTemplate>

    <Columns>
        <DxGridSelectionColumn Width="30" FixedPosition="GridColumnFixedPosition.Left" />

        <DxGridDataColumn FieldName="ServiceId" Caption="ID"
                          Width="@(layoutManager?.GetColumnWidth("ServiceId") ?? "80px")"
                          Visible="@(layoutManager?.GetColumnVisibility("ServiceId") ?? false)" />

        <DxGridDataColumn FieldName="ServiceName" Caption="Service Name"
                          Width="@(layoutManager?.GetColumnWidth("ServiceName") ?? "250px")"
                          Visible="@(layoutManager?.GetColumnVisibility("ServiceName") ?? true)" />

        <DxGridDataColumn FieldName="GroupName" Caption="Group"
                          Width="@(layoutManager?.GetColumnWidth("GroupName") ?? "150px")"
                          Visible="@(layoutManager?.GetColumnVisibility("GroupName") ?? true)" />

        <DxGridDataColumn FieldName="ServiceType" Caption="Type"
                          Width="@(layoutManager?.GetColumnWidth("ServiceType") ?? "120px")"
                          Visible="@(layoutManager?.GetColumnVisibility("ServiceType") ?? true)" />

        <DxGridDataColumn FieldName="ServiceSRate" Caption="Sale Rate"
                          DisplayFormat="N2"
                          Width="@(layoutManager?.GetColumnWidth("ServiceSRate") ?? "120px")"
                          Visible="@(layoutManager?.GetColumnVisibility("ServiceSRate") ?? true)" />

        <DxGridDataColumn FieldName="ServicePRate" Caption="Purchase Rate"
                          DisplayFormat="N2"
                          Width="@(layoutManager?.GetColumnWidth("ServicePRate") ?? "150px")"
                          Visible="@(layoutManager?.GetColumnVisibility("ServicePRate") ?? true)" />

        <DxGridDataColumn FieldName="ServiceChargeType" Caption="Charge Type"
                          Width="@(layoutManager?.GetColumnWidth("ServiceChargeType") ?? "100px")"
                          Visible="@(layoutManager?.GetColumnVisibility("ServiceChargeType") ?? true)" />

        <DxGridDataColumn FieldName="HsnName" Caption="SAC"
                          Width="@(layoutManager?.GetColumnWidth("HsnName") ?? "120px")"
                          Visible="@(layoutManager?.GetColumnVisibility("HsnName") ?? true)" />

        <DxGridDataColumn FieldName="HsnGstPer" Caption="GST Per(%)"
                          Width="@(layoutManager?.GetColumnWidth("HsnGstPer") ?? "200px")"
                          Visible="@(layoutManager?.GetColumnVisibility("HsnGstPer") ?? true)" />

        <DxGridDataColumn FieldName="ServicePrintName" Caption="Print Name"
                          Width="@(layoutManager?.GetColumnWidth("ServicePrintName") ?? "200px")"
                          Visible="@(layoutManager?.GetColumnVisibility("ServicePrintName") ?? true)" />

        <DxGridDataColumn FieldName="AccountName" Caption="Account"
                          Width="@(layoutManager?.GetColumnWidth("AccountName") ?? "120px")"
                          Visible="@(layoutManager?.GetColumnVisibility("AccountName") ?? true)" />

        <DxGridDataColumn FieldName="ServiceStatus" Caption="Active"
                          Width="@(layoutManager?.GetColumnWidth("ServiceStatus") ?? "120px")"
                          Visible="@(layoutManager?.GetColumnVisibility("ServiceStatus") ?? true)" />
    </Columns>
</DxGrid>

<ServiceAddEditPage @ref="popup" OnSaved="LoadServicesAsync" />
<ConfirmationDialog />
<GridLayoutpPopup @ref="layoutManager"
                  VoucherType="Service"
                  Columns="@allColumns"
                  OnLayoutChanged="HandleLayoutChanged" />

@code {
    DxGrid MyGrid;
    private List<Service> serviceList = new();
    // private List<Service> SelectedServices = new();
    private IReadOnlyList<object> SelectedServices { get; set; } = new List<object>();
    private ServiceAddEditPage popup;


    // All possible columns
    private GridLayoutpPopup? layoutManager;
    private List<GridColumnLayout> allColumns = [];
    private async void ShowLayoutPopup()
    {
        await InvokeAsync(() =>
        {
            layoutManager?.ShowPopup();
        });
    }
    private async Task HandleLayoutChanged(List<GridColumnLayout> updatedLayout)
    {
        allColumns = updatedLayout;
        // Force the grid to re-render with new layout
        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnInitializedAsync()
    {
        InitializeColumns();
        await LoadServicesAsync();
      
   
    }
    private void InitializeColumns()
    {
        allColumns = new List<GridColumnLayout>
        {
       new() { FieldName = "ServiceId", Caption = "ID", Visible = false, Width = 80, DisplayIndex = 0 },

        new() { FieldName = "ServiceName", Caption = "Service Name", Visible = true, Width = 250, DisplayIndex = 1 },
        new() { FieldName = "GroupName", Caption = "Group", Visible = true, Width = 150, DisplayIndex = 2 },
        new() { FieldName = "ServiceType", Caption = "Type", Visible = true, Width = 120, DisplayIndex = 3 },

        new() { FieldName = "ServiceSRate", Caption = "Sale Rate", Visible = true, Width = 120, DisplayIndex = 4 },
        new() { FieldName = "ServicePRate", Caption = "Purchase Rate", Visible = true, Width = 150, DisplayIndex = 5 },

        new() { FieldName = "ServiceChargeType", Caption = "Charge Type", Visible = true, Width = 150, DisplayIndex = 6 },

        new() { FieldName = "HsnName", Caption = "SAC", Visible = true, Width = 100, DisplayIndex = 7 },
        new() { FieldName = "HsnGstPer", Caption = "GST Per(%)", Visible = true, Width = 120, DisplayIndex = 8 },

        new() { FieldName = "ServicePrintName", Caption = "Print Name", Visible = true, Width = 200, DisplayIndex = 9 },

        new() { FieldName = "AccountName", Caption = "Account", Visible = true, Width = 200, DisplayIndex = 10 },

        new() { FieldName = "ServiceStatus", Caption = "Active", Visible = true, Width = 120, DisplayIndex = 11 }
    };
       
    }

  
    private async Task LoadServicesAsync()
    {
        LoadingService.Show();
        try
        {
            serviceList = await ServiceService.GetAllAsync();
        }
        finally
        {
            LoadingService.Hide();
        }
    }

    private async Task OnSelectedServicesChanged(IReadOnlyList<object> items)
    {
        // var selectedIds = items.Cast<Service>().Select(x => x.ServiceId).ToList();
        // SelectedServices = serviceList
        //     .Where(s => selectedIds.Contains(s.ServiceId))
        //     .ToList();
        SelectedServices = items ?? new List<object>();
        await InvokeAsync(StateHasChanged);
    }
    // ✅ FIXED: Reliable clear selection method
    private async Task ClearSelectionManual()
    {
        try
        {
            if (MyGrid != null)
            {
                MyGrid.ClearSelection(); // ✅ Synchronous method
            }
            SelectedServices = new List<Branch>();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Clear selection error: {ex.Message}");
        }
    }

    // ✅ FIXED: Auto-clear after operations
    private async Task ClearSelection()
    {
        await Task.Delay(100); // Small delay for UI update
        await ClearSelectionManual();
    }
    private void OnCreateNew(ToolbarItemClickEventArgs e)
    {
        popup.Show(new Service
        {
            ServiceStatus = true,
            ServiceSRate = 0,
            ServicePRate = 0
        });
    }

    private async Task OnEdit(ToolbarItemClickEventArgs e)
    {
        var item = MyGrid.GetFocusedDataItem() as Service;
        if (item != null)
        {
            var freshData = serviceList
               .FirstOrDefault(x => x.ServiceId == item.ServiceId);

            if (freshData != null)
                popup.Show(freshData);
        
        }else
            ToastService.Warning("Please select a service to edit.");
        await ClearSelection();
    }

    private async Task OnDelete(ToolbarItemClickEventArgs e)
    {
        if (SelectedServices == null || SelectedServices.Count == 0)
        {
            ToastService.Warning("Please select at least one service to delete.");
            return;
        }
        var selectedList = SelectedServices.Cast<Service>().ToList();
        var confirm = await ConfirmDialogService.ShowAsync(
            $"Are you sure you want to delete {SelectedServices.Count} selected service(s)?");
        if (!confirm)
        {
            await ClearSelection(); // ✅ Clear on cancel
            return;
        }
        try
        {
            LoadingService.Show("Deleting...");
            int successCount = 0, failCount = 0;
            List<string> errorMessages = new();
            foreach (var service in selectedList)
            {
                var result = await ServiceService.DeleteAsync(service.ServiceId);
                if (result.Success) 
                
                {
                    successCount++;
                    AuditLogService.NotifyAuditChanged();

                }
                else
                {
                    failCount++; 
                    errorMessages.Add(result.Error);
                }
            }

        if (successCount > 0)
            ToastService.Success($"{successCount} Service(s) Deleted Successfully.");
        if (failCount > 0)
                ToastService.Error($"{failCount} Cargo(s) failed.\nDetails: {string.Join("\n", errorMessages.Distinct())}");

        await LoadServicesAsync();
        }
        finally
        {
            LoadingService.Hide();
            await ClearSelection(); // ✅ Clear after delete (success or fail)
        }
    }
}
