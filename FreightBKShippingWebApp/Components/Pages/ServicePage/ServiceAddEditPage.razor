
@using FreightBKShippingWebApp.Components.Pages.HSNSACPage
@using FreightBKShippingWebApp.Components.Pages.UnitPage
@using FreightBKShippingWebApp.Components.Pages.AccountPage
@using FreightBKShippingWebApp.Model
@using FreightBKShippingWebApp.Models
@using FreightBKShippingWebApp.Services
@using System.Text.Json
@inject ServiceService ServiceService
@inject ToasteService ToastService
@inject LoadingService LoadingService
@inject ServiceGroupService ServiceGroupService
@inject HsnSacService HsnSacService
@inject UnitService UnitService
@inject AccountService AccountService
@inject VoucherService VoucherService



<style>
    .hsn-field-wrapper {
        position: relative;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .acc-combobox {
    flex: 1;
    min-width: 0; /* Critical: allows flex item to shrink below content size */
    max-width: 100%;
}
    .hsn-combobox {
        flex: 1;
    }

    
</style>
<DxPopup @bind-Visible="Visible" ShowCloseButton="true" HeaderText="@Title" CloseOnOutsideClick="false" MaxWidth="650" 
         horizontalAlignment="HorizontalAlignment.Center" 
         verticalAlignment="VerticalAlignment.Center" BodyCssClass="my-popup-body" ShowFooter="true" scrollable="true">
            <BodyContentTemplate Context="bdybrnch">
        <EditForm EditContext="@editContext" OnValidSubmit="HandleValidSubmit" Context="CXservice" id="serviceForm">
        <DataAnnotationsValidator />
       @*  <ValidationSummary /> *@
        <DxFormLayout>

            <DxFormLayoutItem Caption="Service Name" ColSpanMd="12">
                    <DxTextBox @bind-Text="EditModel.ServiceName" @oninput="AutoFillPrintName"
                ShowValidationIcon="true" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="Print Name" ColSpanMd="12">
                <DxTextBox @bind-Text="EditModel.ServicePrintName" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="Type" ColSpanMd="12">
                <DxComboBox TData="ServiceGroup" TValue="int?"
                            Data="@GroupList"
                            TextFieldName="ServiceGroupsName"
                            ValueFieldName="ServiceGroupsId"
                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                            AllowUserInput="false"
                            ShowValidationIcon="true"
                            NullText="-- Select Group Type --"
                            @bind-Value="EditModel.ServiceGroupId"
                            SearchMode="ListSearchMode.AutoSearch"
                            SearchFilterCondition="ListSearchFilterCondition.Contains" />
            </DxFormLayoutItem>
            <DxFormLayoutItem Caption="HSN">
                <div class="hsn-field-wrapper">
                <DxComboBox TData="HsnSac" TValue="int?"
                            Data="@HsnSacList"
                            TextFieldName="HsnName"
                            ValueFieldName="HsnId"
                            AllowUserInput="false"
                                ShowValidationIcon="true"
                            NullText="-- Select HSN/SAC --"
                            @bind-Value="EditModel.ServiceHsnId"
                            SearchMode="ListSearchMode.AutoSearch"
                            SearchFilterCondition="ListSearchFilterCondition.Contains" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                    <DxButton Click="@ShowHsnPopup"
                              Text="+"
                              CssClass="custom-plus-button" />
                </div>
                        </DxFormLayoutItem>
            <DxFormLayoutItem Caption="Purchase Rate">
                <DxSpinEdit @bind-Value="EditModel.ServicePRate" ShowSpinButtons=false ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="Unit">
                 <div class="hsn-field-wrapper">
                <DxComboBox TData="Unit" TValue="int?"
                            Data="@UnitList"
                            TextFieldName="UnitName"
                            ValueFieldName="UnitId"
                                ShowValidationIcon="true"
                            AllowUserInput="false"
                            NullText="-- Select Unit --"
                            @bind-Value="EditModel.ServiceUnitId"
                            SearchMode="ListSearchMode.AutoSearch"
                            SearchFilterCondition="ListSearchFilterCondition.Contains" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                <DxButton Click="@ShowUnitPopup"
                          Text="+"
                          CssClass="custom-plus-button" />
                </div>
                        </DxFormLayoutItem>

            <DxFormLayoutItem Caption="Sale Rate">
                <DxSpinEdit @bind-Value="EditModel.ServiceSRate" ShowSpinButtons="false" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="Charges Type">
                <DxComboBox Data="@ChargeTypeList"
                            @bind-Value="EditModel.ServiceChargeType"
                            TextFieldName="Text"
                            ValueFieldName="Value"
                            ShowValidationIcon="true"
                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                            AllowUserInput="true"
                            SearchMode="ListSearchMode.AutoSearch" SearchFilterCondition="ListSearchFilterCondition.Contains" />
            </DxFormLayoutItem>
            <DxFormLayoutItem Caption="Add. Charge">
                <DxSpinEdit @bind-Value="EditModel.ServiceExtraCharge" ShowSpinButtons="false" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
            </DxFormLayoutItem>
            <DxFormLayoutItem Caption="Add/Deduct">
                <DxComboBox Data="@AddDeductList"
                            @bind-Value="EditModel.ServiceType"
                            ShowValidationIcon="true"
                            TextFieldName="Text"
                            ValueFieldName="Value"
                            ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                            AllowUserInput="true"
                            SearchMode="ListSearchMode.AutoSearch" SearchFilterCondition="ListSearchFilterCondition.Contains" />
            </DxFormLayoutItem>

           
            <DxFormLayoutItem Caption="Voucher Type">
                 <DxComboBox TData="Voucher" TValue="int?"
                            Data="@VoucherList"
                            TextFieldName="VoucherName"
                            ValueFieldName="VoucherId"
                            AllowUserInput="false"
                            NullText="-- Select Voucher --"
                            @bind-Value="EditModel.ServiceVoucherId"
                            SearchMode="ListSearchMode.AutoSearch"
                            SearchFilterCondition="ListSearchFilterCondition.Contains" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
            </DxFormLayoutItem>
            <DxFormLayoutItem Caption="Account Name" ColSpanMd="10">
                   <div class="hsn-field-wrapper">
                <DxComboBox TData="Account" TValue="int?"
                            Data="@AccountList"
                            CssClass="acc-combobox"
                            TextFieldName="AccountName"
                            ValueFieldName="AccountId"
                            ClearButtonVisible="true"
                            AllowUserInput="false"
                            NullText="-- Select Account --"
                            @bind-Value="EditModel.ServiceAccountId"
                            SearchMode="ListSearchMode.AutoSearch"
                            SearchFilterCondition="ListSearchFilterCondition.Contains" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                             <DxButton Click="@ShowAccountPopup"
                          Text="+"
                          CssClass="custom-plus-button" />
                          </div>
            </DxFormLayoutItem>
            <DxFormLayoutItem Caption="Tally Name">
                <DxTextBox @bind-Text="EditModel.ServiceTallyName" />
            </DxFormLayoutItem>
            <DxFormLayoutItem Caption="Is Goods">
                <DxCheckBox @bind-Checked="EditModel.ServiceIsGoods" />
            </DxFormLayoutItem>
            <DxFormLayoutItem Caption="Description" ColSpanMd="12">
                <DxMemo @bind-Text="EditModel.ServiceRemarks" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
            </DxFormLayoutItem>
        </DxFormLayout>
     
    </EditForm>
     </BodyContentTemplate>
    <FooterContentTemplate Context="ftr">
        <div class="mt-3 text-end">
            <DxButton Text="Save" RenderStyle="ButtonRenderStyle.Primary" SubmitFormOnClick="true" Form="serviceForm" />
            <DxButton Text="Cancel" RenderStyle="ButtonRenderStyle.Secondary" Click="Hide" />
        </div>

    </FooterContentTemplate>
</DxPopup>
<HsnSacAddEditPage @ref="popup" OnSaved="RefreshList" />
<UnitAddEditPage @ref="Unitpopup" OnSaved="RefreshList" />

<AccountAddEditPage @ref="Accountpopup" OnSaved="RefreshList" />
@code {
    [Parameter] public EventCallback OnSaved { get; set; }

    private bool Visible { get; set; }
    private string Title { get; set; } = "Add/Edit Service";
    private Service EditModel { get; set; } = new();
    private List<ServiceGroup> GroupList = new();
    private List<HsnSac> HsnSacList = new();
    private List<Unit> UnitList = new();
    private List<Account> AccountList = new();
     private List<Voucher> VoucherList = new();
    private void AutoFillPrintName(ChangeEventArgs e)
    {
        EditModel.ServiceName = e.Value?.ToString() ?? "";
        EditModel.ServicePrintName = EditModel.ServiceName;
        if (editContext != null)
        {
            editContext.NotifyFieldChanged(editContext.Field(nameof(EditModel.ServiceName)));
        }
    }
    private EditContext? editContext;
    protected override async Task OnInitializedAsync()
    {
        GroupList = await ServiceGroupService.GetAllAsync();
        HsnSacList = await HsnSacService.GetAllAsync();
        UnitList = await UnitService.GetAllAsync();
 VoucherList = await VoucherService.GetAllAsync();
        // Fetch all accounts
        var allAccounts = await AccountService.GetAllAsync();

        // Filter only Sales & Purchase Accounts (group id 22, 23)
        AccountList = allAccounts
            .Where(a => a.AccountGroupId == 22 || a.AccountGroupId == 23)
            .ToList();

    }
    public class SelectItem
    {
        public string Text { get; set; }
        public string Value { get; set; }

    }
    List<SelectItem> AddDeductList = new()
{
    new SelectItem { Text = "ADD", Value = "ADD" },
    new SelectItem { Text = "DEDUCT", Value = "DEDUCT" },
    new SelectItem { Text = "N/A", Value = "N/A" }
};
    List<SelectItem> ChargeTypeList = new()
{
    new SelectItem { Text = "ABSOLUTE", Value = "ABSOLUTE" },
    new SelectItem { Text = "PER UNIT", Value = "PERUNIT" }

};
   private AccountAddEditPage Accountpopup;
    private UnitAddEditPage Unitpopup;
    private HsnSacAddEditPage popup;
    private void ShowHsnPopup(MouseEventArgs e)
    {
        popup.Show(new HsnSac() { HsnStatus = true });
    }
    private void ShowUnitPopup(MouseEventArgs e)
    {
        Unitpopup.Show(new Unit() { UnitStatus = true, UnitCreated = DateTime.Now });
    }
    
    private void ShowAccountPopup(MouseEventArgs e)
    {
        Accountpopup.Show(new Account());
    }
    private async Task RefreshList()
    {
        HsnSacList = await HsnSacService.GetAllAsync();
        UnitList = await UnitService.GetAllAsync();
        // Fetch all accounts
        var allAccounts = await AccountService.GetAllAsync();

        // Filter only Sales & Purchase Accounts (group id 22, 23)
        AccountList = allAccounts
            .Where(a => a.AccountGroupId == 22 || a.AccountGroupId == 23)
            .ToList();
        StateHasChanged();
    }


    public void Show(Service model)
    {
        if (model.ServiceId > 0)
        {
            // Edit mode – bind directly to the selected object
           // EditModel = model;
            var json = JsonSerializer.Serialize(model);
            EditModel = JsonSerializer.Deserialize<Service>(json) ?? new Service();
            Title = "Edit Service";
        }
        else
        {
            // Add mode – create new object
            EditModel = new Service { ServiceStatus = true };
            Title = "Add Service";
        }
        // Create EditContext when showing the form
        editContext = new EditContext(EditModel);
        Visible = true;
    }


    private void Hide() => Visible = false;

    private async Task HandleValidSubmit()
    {
        LoadingService.Show();
        try
        {
            bool result;
            if (EditModel.ServiceId == 0)
                result = await ServiceService.CreateAsync(EditModel);
            else
                result = await ServiceService.UpdateAsync(EditModel);

            if (result)
            {
                ToastService.Success($"Service {(EditModel.ServiceId == 0 ? "created" : "updated")} successfully!");
                Visible = false;
                await OnSaved.InvokeAsync();
            }
            else
            {
                ToastService.Error("Failed to save service!");
            }
        }
        catch (Exception ex)
        {
            ToastService.Error($"Error saving service: {ex.Message}");
        }
        finally
        {
            LoadingService.Hide();
        }
    }
}
