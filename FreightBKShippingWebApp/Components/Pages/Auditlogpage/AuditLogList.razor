@page "/audit-logs"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using FreightBKShippingWebApp.Model
@using FreightBKShippingWebApp.Services
@inject AuditLogService AuditLogService
@inject LoadingService LoadingService
@inject ToasteService ToastService
@inject YearStatechangeService YearStatechangeService

<style>
    .grid-size {
        max-height: 600px;
    }

    .grid-container {
        position: relative;
    }
</style>

<div class="grid-container">
    <DxGrid TItem="AuditLog"
            Data="@auditLogs"
            @ref="MyGrid"
            KeyFieldName="AuditLogsId"
            ShowSearchBox="true"
            PageSize="10"
            PageSizeSelectorVisible="true"
            ShowGroupPanel="true"
            FilterMenuButtonDisplayMode="GridFilterMenuButtonDisplayMode.Always"
            FocusedRowEnabled="true"
            ColumnResizeMode="GridColumnResizeMode.Disabled"
            CssClass="grid-size">
    
    <ToolbarTemplate>
        <DxToolbar>
            <TitleTemplate Context="titl">
                <div class="d-flex align-items-center">
                    <i class="bi bi-person-video2 me-2"></i>
                    <span class="fs-5">User Activity</span>
                </div>
            </TitleTemplate>
            <Items>
                <DxToolbarItem Text="Refresh"
                               IconCssClass="bi bi-arrow-clockwise"
                                   RenderStyle="ButtonRenderStyle.None"
                               Click="@(async (_) => await LoadAuditLogsAsync())" />

                                <DxToolbarItem Text="Filter"
                                       IconCssClass="bi bi-funnel-fill"
                                       Click="OpenFilter"
                                       RenderStyle="ButtonRenderStyle.None" />

                <DxToolbarItem Alignment="ToolbarItemAlignment.Right"
                               RenderStyle="ButtonRenderStyle.Secondary"
                               IconCssClass="bi bi-gear-wide-connected"
                               Click="ShowLayoutPopup" />
            </Items>
        </DxToolbar>
    </ToolbarTemplate>
    
    <Columns>
            <DxGridDataColumn FieldName="DateTime"
                              Caption="Date & Time"
                              DisplayFormat="dd/MM/yyyy hh:mm tt"
                              Visible="@(layoutManager?.GetColumnVisibility("DateTime") ?? true)"
                              Width="@(layoutManager?.GetColumnWidth("IndiaTime") ?? "180px")" />

        
        <DxGridDataColumn FieldName="BranchName"
                          Caption="Branch"
                          Visible="@(layoutManager?.GetColumnVisibility("BranchName") ?? true)"
                          Width="@(layoutManager?.GetColumnWidth("BranchName") ?? "170px")" />
        
        <DxGridDataColumn FieldName="TableName"
                          Caption="Name"
                          Visible="@(layoutManager?.GetColumnVisibility("TableName") ?? true)"
                          Width="@(layoutManager?.GetColumnWidth("TableName") ?? "190px")" />
        
        <DxGridDataColumn FieldName="VoucherType"
                          Caption="Voucher"
                          Visible="@(layoutManager?.GetColumnVisibility("VoucherType") ?? true)"
                          Width="@(layoutManager?.GetColumnWidth("VoucherType") ?? "180px")" />
        
        <DxGridDataColumn FieldName="Operations"
                          Caption="Operation"
                          Visible="@(layoutManager?.GetColumnVisibility("Operations") ?? true)"
                          Width="@(layoutManager?.GetColumnWidth("Operations") ?? "120px")" />
        
        <DxGridDataColumn FieldName="Amount"
                          Caption="Amount"
                          DisplayFormat="N2"
                          Visible="@(layoutManager?.GetColumnVisibility("Amount") ?? true)"
                          Width="@(layoutManager?.GetColumnWidth("Amount") ?? "120px")" />
        
        <DxGridDataColumn FieldName="Remarks"
                          Caption="Remarks"
                          Visible="@(layoutManager?.GetColumnVisibility("Remarks") ?? true)"
                          Width="@(layoutManager?.GetColumnWidth("Remarks") ?? "370px")" />
        
        <DxGridDataColumn FieldName="CreatedBy"
                          Caption="User"
                          Visible="@(layoutManager?.GetColumnVisibility("CreatedBy") ?? true)"
                          Width="@(layoutManager?.GetColumnWidth("CreatedBy") ?? "180px")" />
    </Columns>
</DxGrid>
    <ConfirmationDialog />
    <GridLayoutpPopup @ref="layoutManager"
                      VoucherType="AuditLog"
                      Columns="@gridColumns"
                      OnLayoutChanged="HandleLayoutChanged" />
    <DateFilterPage @ref="dateFilterPopup" OnFilterApplied="ApplyFilter" />
</div>

@code {
    private DateTime? filterFromDate;
    private DateTime? filterToDate;
    private DateFilterPage dateFilterPopup;
    private void OpenFilter()
    {
        dateFilterPopup.Show(filterFromDate, filterToDate, null, null, null,null);
    }
    private async Task ApplyFilter((DateTime? FromDate, DateTime? ToDate, string? JobType, int? vouchertype, string? OutstandingType, int? Account) f)
    {
        filterFromDate = f.FromDate;
        filterToDate = f.ToDate;
        await LoadAuditLogsAsync();
    }
    private async void ShowLayoutPopup()
    {
        await InvokeAsync(() =>
        {
            layoutManager?.ShowPopup();
        });
    }

    private DxGrid? MyGrid;
    private List<AuditLog> auditLogs = new();

    // Grid Layout Manager Reference
    private GridLayoutpPopup? layoutManager;

    // Define columns for the layout manager
    private List<GridColumnLayout> gridColumns = new();

    protected override async Task OnInitializedAsync()
    {
        InitializeGridColumns();
        await LoadAuditLogsAsync();
    }

    private void InitializeGridColumns()
    {
        gridColumns = new List<GridColumnLayout>
        {
            new() { FieldName = "DateTime", Caption = "Date & Time", Visible = true, Width = 180, DisplayIndex = 0 },
            new() { FieldName = "BranchName", Caption = "Branch", Visible = true, Width = 170, DisplayIndex = 1 },
            new() { FieldName = "TableName", Caption = "Name", Visible = true, Width = 190, DisplayIndex = 2 },
            new() { FieldName = "VoucherType", Caption = "Voucher", Visible = true, Width = 180, DisplayIndex = 3 },
            new() { FieldName = "Operations", Caption = "Operation", Visible = true, Width = 120, DisplayIndex = 4 },
            new() { FieldName = "Amount", Caption = "Amount", Visible = true, Width = 120, DisplayIndex = 5 },
            new() { FieldName = "Remarks", Caption = "Remarks", Visible = true, Width = 370, DisplayIndex = 6 },
            new() { FieldName = "CreatedBy", Caption = "User", Visible = true, Width = 180, DisplayIndex = 7 }
        };
    }

    // ✅ FIXED: This callback now properly triggers UI update
    private async Task HandleLayoutChanged(List<GridColumnLayout> updatedLayout)
    {
        gridColumns  = updatedLayout;
        // Force the grid to re-render with new layout
        await InvokeAsync(StateHasChanged);
        
     
    }

    private async Task LoadAuditLogsAsync()
    {
        LoadingService.Show();
        try
        {
            var CurrentYearId = YearStatechangeService.SelectedYearId;
            auditLogs = await AuditLogService.GetLatestAsync(
             filterFromDate,
             filterToDate);

            // Optional: agar year filter client side chahiye
            // auditLogs = data
            //     .Where(a => a.YearId == CurrentYearId)
            //     .ToList();
        }
        catch (Exception ex)
        {
            ToastService.Error($"Failed to load audit logs: {ex.Message}");
        }
        finally
        {
            LoadingService.Hide();
        }
    }
}