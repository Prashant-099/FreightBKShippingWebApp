
@page "/account"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using FreightBKShippingWebApp.Model
@using FreightBKShippingWebApp.Services
@using FreightBKShippingWebApp.Components.Pages
@inject AccountService AccountService
@inject ToasteService ToastService
@inject LoadingService LoadingService
@inject ConfirmationDialogService ConfirmDialogService
@inject GridLayoutService GridLayoutService
@inject AuditLogService AuditLogService
<style>
    .grid-size {
        max-height: 600px;
    }


    /* ComboBox Styling */
    .layout-combobox {
        border-radius: 6px;
        width: 185px;
    }
</style>
<DxGrid TItem="Account"
        Data="@accountList"
        @ref="MyGrid"
        KeyFieldName="AccountId"
        ShowSearchBox="true"
        PageSize="10"
        PageSizeSelectorVisible="true"
        ShowGroupPanel="true"
        FilterMenuButtonDisplayMode="GridFilterMenuButtonDisplayMode.Always"
        FocusedRowEnabled="true"
        SelectionMode="GridSelectionMode.Multiple"
        SelectedDataItems="@SelectedAccounts"
        SelectedDataItemsChanged="OnSelectedAccountsChanged"
         ColumnResizeMode="GridColumnResizeMode.NextColumn"
        CssClass="grid-size"
        AllowSelectRowByClick="true">

    <ToolbarTemplate Context="toolbarContext">
        <DxToolbar>
            <TitleTemplate Context="titleContext">
                <div class="d-flex align-items-center">
                    <i class="bi bi-person-lines-fill me-2"></i>
                    <span class="fs-5">Accounts</span>
                </div>
            </TitleTemplate>
            <Items>
                <DxToolbarItem Text="Add" IconCssClass="bi bi-plus-circle" Click="OnCreateNew" />
                <DxToolbarItem Text="Edit" IconCssClass="bi bi-pencil-square" Click="OnEdit" />
                <DxToolbarItem Text="Delete" IconCssClass="bi bi-trash" Click="OnDelete" />
                <DxToolbarItem Text="Refresh" IconCssClass="bi bi-arrow-clockwise" Click="LoadAccountsAsync" />

                <DxToolbarItem Alignment="ToolbarItemAlignment.Right"
                               RenderStyle="ButtonRenderStyle.Secondary"
                               IconCssClass="bi bi-gear-wide-connected"
                               Click="ShowLayoutPopup" />
                

            </Items>
        </DxToolbar>
    </ToolbarTemplate>

    <Columns>
        <DxGridSelectionColumn Width="30" FixedPosition="GridColumnFixedPosition.Left" />

        <DxGridDataColumn FieldName="AccountId" Caption="ID"
                          Width="@(layoutManager?.GetColumnWidth("AccountId") ?? "80px")"
                          Visible="@(layoutManager?.GetColumnVisibility("AccountId") ?? false)"/>
     
        <DxGridDataColumn FieldName="AccountName" Caption="Name"
                          Width="@(layoutManager?.GetColumnWidth("AccountName") ?? "450px")"
                          Visible="@(layoutManager?.GetColumnVisibility("AccountName") ?? true)" />

        <DxGridDataColumn FieldName="AccountContactPerson" Caption="Contact Person"
                          Width="@(layoutManager?.GetColumnWidth("AccountContactPerson") ?? "240px")"
                          Visible="@(layoutManager?.GetColumnVisibility("AccountContactPerson") ?? true)" />

        <DxGridDataColumn FieldName="AccountMobile" Caption="Mobile"
                          Width="@(layoutManager?.GetColumnWidth("AccountMobile") ?? "150px")"
                          Visible="@(layoutManager?.GetColumnVisibility("AccountMobile") ?? true)" />

        <DxGridDataColumn FieldName="AccountEmail" Caption="Email"
                          Width="@(layoutManager?.GetColumnWidth("AccountEmail") ?? "200px")"
                          Visible="@(layoutManager?.GetColumnVisibility("AccountEmail") ?? true)" />

        <DxGridDataColumn FieldName="AccountCity" Caption="City"
                          Width="@(layoutManager?.GetColumnWidth("AccountCity") ?? "150px")"
                          Visible="@(layoutManager?.GetColumnVisibility("AccountCity") ?? true)" />

        <DxGridDataColumn FieldName="AccountCountry" Caption="Country"
                          Width="@(layoutManager?.GetColumnWidth("AccountCountry") ?? "150px")"
                          Visible="@(layoutManager?.GetColumnVisibility("AccountCountry") ?? true)" />

        <DxGridDataColumn FieldName="AccountStatus" Caption="Active"
                          Width="@(layoutManager?.GetColumnWidth("AccountStatus") ?? "120px")"
                          Visible="@(layoutManager?.GetColumnVisibility("AccountStatus") ?? true)" />
    </Columns>
</DxGrid>

<AccountAddEditPage @ref="popup" OnSaved="LoadAccountsAsync" /> 


<ConfirmationDialog />
<GridLayoutpPopup @ref="layoutManager"
                  VoucherType="Account"
                  Columns="@allColumns"
                  OnLayoutChanged="HandleLayoutChanged" />

@code {
    DxGrid MyGrid = null!;
    private List<Account> accountList = [];
    // private List<Account> SelectedAccounts = [];
    private IReadOnlyList<object> SelectedAccounts { get; set; } = new List<object>();
    private AccountAddEditPage popup = null!;
  
  
    // All possible columns
    private GridLayoutpPopup? layoutManager;
    private List<GridColumnLayout> allColumns = [];
    private async void ShowLayoutPopup()
    {
        await InvokeAsync(() =>
        {
            layoutManager?.ShowPopup();
        });
    }
    private async Task HandleLayoutChanged(List<GridColumnLayout> updatedLayout)
    {
        allColumns = updatedLayout;
        // Force the grid to re-render with new layout
        await InvokeAsync(StateHasChanged);
    }
    protected override async Task OnInitializedAsync()
    {
        InitializeColumns();
        await LoadAccountsAsync();  
       
    }

    private void InitializeColumns()
    {
        allColumns = new List<GridColumnLayout>
        {
            new() { FieldName = "AccountId", Caption = "ID", Visible = false, Width = 80, DisplayIndex = 0 },
            new() { FieldName = "AccountName", Caption = "Name", Visible = true, Width = 450, DisplayIndex = 1 },
            new() { FieldName = "AccountContactPerson", Caption = "Contact Person", Visible = true, Width = 240, DisplayIndex = 2 },
            new() { FieldName = "AccountMobile", Caption = "Mobile", Visible = true, Width = 150, DisplayIndex = 3 },
            new() { FieldName = "AccountEmail", Caption = "Email", Visible = true, Width = 200, DisplayIndex = 4 },
            new() { FieldName = "AccountCity", Caption = "City", Visible = true, Width = 150, DisplayIndex = 5 },
            new() { FieldName = "AccountCountry", Caption = "Country", Visible = true, Width = 150, DisplayIndex = 6 },
            new() { FieldName = "AccountStatus", Caption = "Active", Visible = true, Width = 120, DisplayIndex = 7 }
        };
       
    }

   

    private async Task LoadAccountsAsync()
    {
        LoadingService.Show("Loading accounts...");
        try
        {
            accountList = await AccountService.GetAllAsync();
        }
        finally
        {
            LoadingService.Hide();
        }
    }

    // Rest of the existing methods...
    private async Task OnSelectedAccountsChanged(IReadOnlyList<object> accounts)
    {
        SelectedAccounts = accounts ?? new List<object>();
        await InvokeAsync(StateHasChanged);
    }
    // ✅ FIXED: Reliable clear selection method
    private async Task ClearSelectionManual()
    {
        try
        {
            if (MyGrid != null)
            {
                MyGrid.ClearSelection(); // ✅ Synchronous method
            }
            SelectedAccounts = new List<Account>();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Clear selection error: {ex.Message}");
        }
    }

    // ✅ FIXED: Auto-clear after operations
    private async Task ClearSelection()
    {
        await Task.Delay(100); // Small delay for UI update
        await ClearSelectionManual();
    }
    private void OnCreateNew(ToolbarItemClickEventArgs e)
    {
        popup.Show(new Account());
    }

    private async Task OnEdit(ToolbarItemClickEventArgs e)
    {
        var account = MyGrid.GetFocusedDataItem() as Account;
        if (account != null)
        {
            var freshData = accountList
            .FirstOrDefault(x => x.AccountId == account.AccountId);

            if (freshData != null)
                    popup.Show(freshData);

        }
        else
            ToastService.Warning("Please select an account to edit.");
        await ClearSelection();
    }

    private async Task OnDelete(ToolbarItemClickEventArgs e)
    {
        if (SelectedAccounts == null || SelectedAccounts.Count == 0)
        {
            ToastService.Warning("Please select at least one account to delete.");
            return;
        }
        var selectedList = SelectedAccounts.Cast<Account>().ToList();

        var confirm = await ConfirmDialogService.ShowAsync(
            $"Are you sure you want to delete {SelectedAccounts.Count} selected account(s)?");

        if (!confirm)
        {
            await ClearSelection(); // ✅ Clear on cancel
            return;
        }
        try
        {
            LoadingService.Show("Deleting...");
            int successCount = 0, failCount = 0;
            List<string> errorMessages = new();
            foreach (var account in selectedList)
            {
              
                var result = await AccountService.DeleteAsync(account.AccountId);
                if (result.Success)
                {
                    successCount++;
                    AuditLogService.NotifyAuditChanged();

                }
                else
                {
                    failCount++;
                    errorMessages.Add(result.Error);  // 🎉 show real API message
                }
            }
            if (successCount > 0) ToastService.Success($"{successCount} Account(s) Deleted Successfully.");
            if (failCount > 0) ToastService.Error($"{failCount} Account(s) failed.\nDetails: {string.Join("\n", errorMessages.Distinct())}");
            await LoadAccountsAsync();
        }
        finally
        {
            LoadingService.Hide();
            await ClearSelection(); // ✅ Clear after delete (success or fail)
        }
    }
}