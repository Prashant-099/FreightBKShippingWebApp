    // Updated GstinData model to match actual API response
    public class GstinData
    {
        public string Gstin { get; set; } = string.Empty;
        public string LegalName { get; set; } = string.Empty;
        public string TradeName { get; set; } = string.Empty;
        public int StateCode { get; set; }
        public string Status { get; set; } = string.Empty;

        // Address fields are individual properties
        public string AddrBnm { get; set; } = string.Empty;  // Building Name
        public string AddrBno { get; set; } = string.Empty;  // Building Number
        public string AddrFlno { get; set; } = string.Empty; // Floor Number
        public string AddrSt { get; set; } = string.Empty;   // Street
        public string AddrLoc { get; set; } = string.Empty;  // Location
        public int AddrPncd { get; set; }                     // Pincode
        public string TxpType { get; set; } = string.Empty;   // Taxpayer Type
        public string BlkStatus { get; set; } = string.Empty; // Block Status
        public string DtReg { get; set; } = string.Empty;     // Registration Date
        public string? DtDReg { get; set; }                   // De-registration Date
    }

    // Updated PopulateFormWithGstinData to match new structure
    private async Task PopulateFormWithGstinData(GstinData data)
    {
        if (data == null)
        {
            ToastService.Warning("Invalid GSTIN data received.");
            return;
        }

        // Basic fields
        EditModel.AccountName = data.LegalName ?? EditModel.AccountName;
        EditModel.AccountPrintName = data.TradeName ?? EditModel.AccountPrintName;

        // Address Line 1
        var addressParts1 = new List<string>();
        if (!string.IsNullOrEmpty(data.AddrBnm)) addressParts1.Add(data.AddrBnm);
        if (!string.IsNullOrEmpty(data.AddrBno)) addressParts1.Add(data.AddrBno);
        if (!string.IsNullOrEmpty(data.AddrFlno)) addressParts1.Add($"Floor {data.AddrFlno}");
        EditModel.AccountAddress1 = string.Join(", ", addressParts1);

        // Address Line 2
        var addressParts2 = new List<string>();
        if (!string.IsNullOrEmpty(data.AddrSt)) addressParts2.Add(data.AddrSt);
        if (!string.IsNullOrEmpty(data.AddrLoc)) addressParts2.Add(data.AddrLoc);
        EditModel.AccountAddress2 = string.Join(", ", addressParts2);

        EditModel.AccountAddress3 = "";
        EditModel.AccountPincode = data.AddrPncd > 0 ? data.AddrPncd.ToString() : "";

        // =============================
        // 🔥 STATE LOGIC
        // 1️⃣ First: Try to get state by StateCode
        // 2️⃣ If found → use it
        // 3️⃣ If not found → fallback to GetOrCreateStateIdAsync
        // =============================
        if (data.StateCode > 0)
        {
            try
            {
                string code = data.StateCode.ToString();

                // STEP 1 — Get existing state by Code
                var existingState = await StateService.GetStateByCodeAsync(code);

                if (existingState != null)
                {
                    // Found in DB — assign directly
                    EditModel.AccountStateId = existingState.StateId;
                    ToastService.Info($"State set: {existingState.StateName} ({code})");
                }
                else
                {
                    // STEP 2 — Not found → create using your existing create API
                    int createdStateId = await StateService.GetOrCreateStateIdAsync(
                        stateName: "",      // name not required
                        stateCode: code     // important
                    );

                    if (createdStateId > 0)
                    {
                        EditModel.AccountStateId = createdStateId;
                        ToastService.Info($"New state created for code {code}");
                    }
                    else
                    {
                        ToastService.Warning($"Unable to find or create state for code {code}");
                    }
                }
            }
            catch (Exception ex)
            {
                ToastService.Warning($"Failed to load state: {ex.Message}");
            }
        }

        StateHasChanged();
    }

