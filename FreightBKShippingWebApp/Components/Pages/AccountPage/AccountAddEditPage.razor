@code {
    private void AutoFillPrintName(ChangeEventArgs e)
    {
        EditModel.AccountName = e.Value?.ToString() ?? "";
        EditModel.AccountPrintName = EditModel.AccountName;
        // Notify the EditContext that the field has changed for real-time validation
        if (editContext != null)
        {
            editContext.NotifyFieldChanged(editContext.Field(nameof(EditModel.AccountName)));
        }
    }
    private EditContext? editContext;
    private async Task OnTypeChanged(int? newTypeId)
    {
        if (newTypeId.HasValue)
        {
            EditModel.AccountTypeId = newTypeId.Value;
            var sel = typeList.FirstOrDefault(x => x.AccountTypeId == newTypeId.Value);
            EditModel.AccountGroupId = sel?.AccountTypeGroupId ?? 0;
        }
        else
        {
            EditModel.AccountTypeId = 0; // or 0
            EditModel.AccountGroupId = 0;
        }
    }


