    public void Show(Account? account = null)
    {
        if (account == null || account.AccountId <= 0)
        {
            EditModel = new Account { AccountTypeId = account?.AccountTypeId ?? 0 };
            Title = "Add Account";
        }
        else
        {
            EditModel = account;         // direct same model
            Title = "Edit Account";
        }
        // Create EditContext when showing the form
        editContext = new EditContext(EditModel);
        Visible = true;
    }

    private void Hide()
    {
        Visible = false;
    }

    protected override async Task OnInitializedAsync()
    {
        stateList = await StateService.GetStatesAsync();
        countryList = await CountryService.GetAllAsync();
        groupList = await AccountGroupService.GetAllAsync();   // API से load
        typeList = await AccountTypeService.GetAllAsync(); 
        states = await StateService.GetStatesAsync();

    }

    private async Task HandleValidSubmit()
    {
        LoadingService.Show("Saving account...");

        try
        {
            Account? result;

            if (EditModel.AccountId == 0)
            {
                if ((EditModel.AccountTypeId == 17 || EditModel.AccountTypeId == 18)
                     && (EditModel.AccountStateId == null || EditModel.AccountStateId == 0))
                {
                    ToastService.Error("❌ Please select a State before saving!");
                    return;
                }




                // Create new account
                result = await AccountService.CreateAsync(EditModel);

                if (result != null)
                {
                    ToastService.Success("✅ Account created successfully!");
                }
                else
                {
                    ToastService.Error("❌ Failed to create account!");
                    return;
                }
            }
            else
            {
                // Update existing account
                result = await AccountService.UpdateAsync(EditModel);

                if (result != null)
                {
                    ToastService.Success("✅ Account updated successfully!");
                }
                else
                {
                    ToastService.Error("❌ Failed to update account!");
                    return;
                }
            }

            Visible = false;
            await OnSaved.InvokeAsync();
        }
        catch (Exception ex)
        {
            ToastService.Error($"⚠️ Error saving account: {ex.Message}");
        }
        finally
        {
            LoadingService.Hide();
        }
    }

