@page "/servicegroup"


@using FreightBKShippingWebApp.Model
@using FreightBKShippingWebApp.Services
@using FreightBKShippingWebApp.Components.Pages
@inject ServiceGroupService ServiceGroupService
@inject ToasteService ToastService
@inject LoadingService LoadingService
@inject ConfirmationDialogService ConfirmDialogService
@inject GridLayoutService GridLayoutService
@inject AuditLogService AuditLogService
<style>
    .grid-size {
        max-height: 600px;
    }


    /* ComboBox Styling */
    .layout-combobox {
        border-radius: 6px;
        width: 185px;
    }
</style>
<DxGrid TItem="ServiceGroup" Data="@serviceGroupList" @ref="MyGrid"
        KeyFieldName="ServiceGroupsId"
        ShowSearchBox="true"
        PageSize="10"
        PageSizeSelectorVisible="true"
        ShowGroupPanel="true"
        FilterMenuButtonDisplayMode="GridFilterMenuButtonDisplayMode.Always"
        FocusedRowEnabled="true"
        SelectionMode="GridSelectionMode.Multiple"
        SelectedDataItems="@SelectedGroups"
        SelectedDataItemsChanged="OnSelectedGroupsChanged"
        ColumnResizeMode="GridColumnResizeMode.NextColumn"
        CssClass="grid-size"
        AllowSelectRowByClick="true">

    <ToolbarTemplate>
        <DxToolbar>
            <TitleTemplate Context="tl">
                <div class="d-flex align-items-center">
                    <i class="bi bi-diagram-3"></i>
                    <span class="fs-5 ms-2">Service Groups</span>
                </div>
            </TitleTemplate>
            <Items>
                <DxToolbarItem Text="Add" IconCssClass="bi bi-plus-circle" Click="OnCreateNew" />
                <DxToolbarItem Text="Edit" IconCssClass="bi bi-pencil-square" Click="OnEdit" />
                <DxToolbarItem Text="Delete" IconCssClass="bi bi-trash" Click="OnDelete" />
                <DxToolbarItem Text="Refresh" IconCssClass="bi bi-arrow-clockwise" Click="@(async (_) => await LoadServiceGroupsAsync())" />
                <DxToolbarItem Alignment="ToolbarItemAlignment.Right"
                               RenderStyle="ButtonRenderStyle.Secondary"
                               IconCssClass="bi bi-gear-wide-connected"
                               Click="ShowLayoutPopup" />

            </Items>
        </DxToolbar>
    </ToolbarTemplate>

    <Columns>
        <DxGridSelectionColumn Width="30" FixedPosition="GridColumnFixedPosition.Left" />

        <DxGridDataColumn FieldName="ServiceGroupsId" Caption="ID"
                          Width="@(layoutManager?.GetColumnWidth("ServiceGroupsId") ?? "80px")"
                          Visible="@(layoutManager?.GetColumnVisibility("ServiceGroupsId") ?? false)" />

        <DxGridDataColumn FieldName="ServiceGroupsName" Caption="Group Name"
                          Width="@(layoutManager?.GetColumnWidth("ServiceGroupsName") ?? "440px")"
                          Visible="@(layoutManager?.GetColumnVisibility("ServiceGroupsName") ?? true)" />

        <DxGridDataColumn FieldName="ServiceGroupsRemarks" Caption="Description"
                          Width="@(layoutManager?.GetColumnWidth("ServiceGroupsRemarks") ?? "460px")"
                          Visible="@(layoutManager?.GetColumnVisibility("ServiceGroupsRemarks") ?? true)" />

        <DxGridDataColumn FieldName="ServiceGroupsAdded" Caption="Created At"
                          DisplayFormat="dd/MM/yyyy"
                          Width="@(layoutManager?.GetColumnWidth("ServiceGroupsAdded") ?? "210px")"
                          Visible="@(layoutManager?.GetColumnVisibility("ServiceGroupsAdded") ?? true)" />

        <DxGridDataColumn FieldName="ServiceGroupsUpdated" Caption="Updated At"
                          DisplayFormat="dd/MM/yyyy"
                          Width="@(layoutManager?.GetColumnWidth("ServiceGroupsUpdated") ?? "230px")"
                          Visible="@(layoutManager?.GetColumnVisibility("ServiceGroupsUpdated") ?? true)" />

        <DxGridDataColumn FieldName="ServiceGroupsStatus" Caption="Active"
                          Width="@(layoutManager?.GetColumnWidth("ServiceGroupsStatus") ?? "120px")"
                          Visible="@(layoutManager?.GetColumnVisibility("ServiceGroupsStatus") ?? true)" />
    </Columns>
</DxGrid>

<ServiceGroupAddEditPage @ref="popup" OnSaved="LoadServiceGroupsAsync" />
<ConfirmationDialog />
<GridLayoutpPopup @ref="layoutManager"
                  VoucherType="Servicegroup"
                  Columns="@allColumns"
                  OnLayoutChanged="HandleLayoutChanged" />

@code {
    DxGrid MyGrid;
    private List<ServiceGroup> serviceGroupList = new();
    // private List<ServiceGroup> SelectedGroups = new();
    private IReadOnlyList<object> SelectedGroups { get; set; } = new List<object>();

    private ServiceGroupAddEditPage popup;


    // All possible columns
    private GridLayoutpPopup? layoutManager;
    private List<GridColumnLayout> allColumns = [];
    private async void ShowLayoutPopup()
    {
        await InvokeAsync(() =>
        {
            layoutManager?.ShowPopup();
        });
    }
    private async Task HandleLayoutChanged(List<GridColumnLayout> updatedLayout)
    {
        allColumns = updatedLayout;
        // Force the grid to re-render with new layout
        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnInitializedAsync()
    {
        InitializeColumns();
        await LoadServiceGroupsAsync();


    }
    private void InitializeColumns()
    {
        allColumns = new List<GridColumnLayout>
        {
      new() { FieldName = "ServiceGroupsId", Caption = "ID", Visible = false, Width = 80, DisplayIndex = 0 },

        new() { FieldName = "ServiceGroupsName", Caption = "Group Name", Visible = true, Width = 440, DisplayIndex = 1 },

        new() { FieldName = "ServiceGroupsRemarks", Caption = "Description", Visible = true, Width = 460, DisplayIndex = 2 },

         new() { FieldName = "ServiceGroupsStatus", Caption = "Active", Visible = true, Width = 120, DisplayIndex = 3 }, 

        new() { FieldName = "ServiceGroupsAdded", Caption = "Created At", Visible = true, Width = 210, DisplayIndex = 3 },

        new() { FieldName = "ServiceGroupsUpdated", Caption = "Updated At", Visible = true, Width = 230, DisplayIndex = 4 }
    };

    }


    private async Task LoadServiceGroupsAsync()
    {
        LoadingService.Show();
        try
        {
            serviceGroupList = await ServiceGroupService.GetAllAsync();
        }
        finally
        {
            LoadingService.Hide();
        }
    }

    private async Task OnSelectedGroupsChanged(IReadOnlyList<object> groups)
    {
        SelectedGroups = groups ?? new List<object>();
        await InvokeAsync(StateHasChanged);
    }
    // ✅ FIXED: Reliable clear selection method
    private async Task ClearSelectionManual()
    {
        try
        {
            if (MyGrid != null)
            {
                MyGrid.ClearSelection(); // ✅ Synchronous method
            }
            SelectedGroups = new List<ServiceGroup>();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Clear selection error: {ex.Message}");
        }
    }

    // ✅ FIXED: Auto-clear after operations
    private async Task ClearSelection()
    {
        await Task.Delay(100); // Small delay for UI update
        await ClearSelectionManual();
    }

    private void OnCreateNew(ToolbarItemClickEventArgs e)
    {
        popup.Show(new ServiceGroup()
        {
            ServiceGroupsStatus = true
        });
    }

    private async Task OnEdit(ToolbarItemClickEventArgs e)
    {
        var group = MyGrid.GetFocusedDataItem() as ServiceGroup;
        if (group != null)
        {
            var freshData = serviceGroupList
               .FirstOrDefault(x => x.ServiceGroupsId == group.ServiceGroupsId);

            if (freshData != null)
                popup.Show(freshData);

        }
        else
            ToastService.Warning("Please select a Service Group to edit.");
        await ClearSelection();
    }

    private async Task OnDelete(ToolbarItemClickEventArgs e)
    {
        if (SelectedGroups == null || SelectedGroups.Count == 0)
        {
            ToastService.Warning("Please select at least one Service Group to delete.");
            return;
        }
        var selectedList = SelectedGroups.Cast<ServiceGroup>().ToList();
        var confirm = await ConfirmDialogService.ShowAsync(
            $"Are you sure you want to delete {SelectedGroups.Count} selected group(s)?");

        if (!confirm)
        {
            await ClearSelection(); // ✅ Clear on cancel
            return;
        }
        try
        {
            LoadingService.Show("Deleting...");
            int successCount = 0, failCount = 0;


            foreach (var group in selectedList)
            {
                var result = await ServiceGroupService.DeleteAsync(group.ServiceGroupsId);
                if (result)
                {
                    successCount++;
                    AuditLogService.NotifyAuditChanged();

                }
                else failCount++;
            }

        if (successCount > 0)
            ToastService.Success($"{successCount} Group(s) Deleted Successfully.");

        if (failCount > 0)
            ToastService.Error($"{failCount} Group(s) Failed To Delete.");

        await LoadServiceGroupsAsync();
        }
        finally
        {
            LoadingService.Hide();
            await ClearSelection(); // ✅ Clear after delete (success or fail)
        }
    }
}
