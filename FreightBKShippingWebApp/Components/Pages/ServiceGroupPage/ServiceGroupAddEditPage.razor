
@using FreightBKShippingWebApp.Model
@using FreightBKShippingWebApp.Services
@using System.Text.Json
@inject ServiceGroupService ServiceGroupService
@inject ToasteService ToastService
@inject LoadingService LoadingService
@inject AuditLogService AuditLogService
<DxPopup @bind-Visible="Visible" ShowCloseButton="true" HeaderText="@Title" MaxWidth="450" CloseOnOutsideClick="false" horizontalAlignment="HorizontalAlignment.Center"
         verticalAlignment="VerticalAlignment.Center" BodyCssClass="my-popup-body" ShowFooter="true" scrollable="true">
     <BodyContentTemplate Context="bdy">
         <EditForm  EditContext="@editContext" OnValidSubmit="HandleValidSubmit" Context="CXservicegp" id="srgrouForm">
        <DataAnnotationsValidator />
       @*  <ValidationSummary /> *@

        <DxFormLayout>
            <DxFormLayoutItem Caption="Group Name" ColSpanMd="12">
                <ChildContent>
                    <DxTextBox @bind-Text="EditModel.ServiceGroupsName" ShowValidationIcon="true" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                </ChildContent>
            </DxFormLayoutItem>

            <DxFormLayoutItem Caption="Description" ColSpanMd="12">
                <ChildContent>
                    <DxTextBox @bind-Text="EditModel.ServiceGroupsRemarks" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                </ChildContent>
            </DxFormLayoutItem>
@* <DxFormLayoutItem Caption="Active">
                <ChildContent>
                    <DxCheckBox @bind-Checked="EditModel.ServiceGroupsStatus" />
                </ChildContent>
            </DxFormLayoutItem> *@
        </DxFormLayout>

       
    </EditForm>
     </BodyContentTemplate>
    <FooterContentTemplate Context="ftrbrnch">

        <div class="mt-3 text-end">
            <DxButton Text="Save" RenderStyle="ButtonRenderStyle.Primary" SubmitFormOnClick="true" Form="srgrouForm" />
            <DxButton Text="Cancel" RenderStyle="ButtonRenderStyle.Secondary" Click="Hide" />
        </div>
    </FooterContentTemplate>
</DxPopup>

@code {
    [Parameter] public EventCallback OnSaved { get; set; }
    private EditContext? editContext;
    private bool Visible { get; set; }
    private string Title { get; set; } = "Add/Edit Service Group";
    private ServiceGroup EditModel { get; set; } = new();

    public void Show(ServiceGroup group)
    {

        if (group.ServiceGroupsId > 0)
        {
            // Edit mode – bind directly to the selected object
            //EditModel = group;
            var json = JsonSerializer.Serialize(group);
            EditModel = JsonSerializer.Deserialize<ServiceGroup>(json) ?? new ServiceGroup();
            Title = "Edit  Service Group";
        }
        else
        {
            // Add mode – create new object
            EditModel = new ServiceGroup { ServiceGroupsStatus = true };
            Title = "Add  Service Group";
        }
        // Create EditContext when showing the form
        editContext = new EditContext(EditModel);
        Visible = true;
    }

    private void Hide()
    {
        Visible = false;
    }

    private async Task HandleValidSubmit()
    {
        LoadingService.Show();
        try
        {
            bool result;
            if (EditModel.ServiceGroupsId == 0)
            {
                result = await ServiceGroupService.CreateAsync(EditModel);
                if (result)
                {
                    ToastService.Success("Service Group created successfully!");
                    AuditLogService.NotifyAuditChanged();

                }
                else
                {
                    ToastService.Error(ServiceGroupService.LastError??"Failed to create Service Group!");
                    return;
                }
            }
            else
            {
                result = await ServiceGroupService.UpdateAsync(EditModel);
                if (result)
                { 
                    AuditLogService.NotifyAuditChanged(); 
                    ToastService.Success("Service Group updated successfully!");
                }
                else
                {
                    ToastService.Error(ServiceGroupService.LastError ?? "Failed to update Service Group!");
                    return;
                }
            }

            Visible = false;
            await OnSaved.InvokeAsync();
        }
        catch (Exception ex)
        {
            ToastService.Error($"Error saving Service Group: {ex.Message}");
        }
       finally
        {
            LoadingService.Hide();
        }
    }
}
