@using FreightBKShippingWebApp.Services
@using FreightBKShippingWebApp.Model
@inject IBranchContext BranchContext
@inject AuthService AuthService

@if (branches.Count > 0)
{
    <DxComboBox Data="@branches"
                TextFieldName="BranchName"
                ValueFieldName="BranchId"
                Value="SelectedBranchId"
                ValueChanged="@((int newVal) => OnBranchChanged(newVal))"
                CssClass="form-select w-100" />

}
else
{
    <div class="text-muted small">Loading branches…</div>
}

@code {
    List<UserBranchDto> branches = new();
    private int _selectedBranchId;

    // ✅ Setter has NO side effects
    int SelectedBranchId
    {
        get => _selectedBranchId;
        set => _selectedBranchId = value;
    }

    protected override async Task OnInitializedAsync()
    {
        var session = await AuthService.GetSessionAsync();
        if (session == null) return;

        branches = session.Branches;

        // 🔒 if already decided globally, use it
        if (BranchContext.BranchId > 0)
        {
            SelectedBranchId = BranchContext.BranchId;
            return;
        }

        // 🔥 initial resolve ONLY ONCE
        SelectedBranchId =
            await AuthService.GetSelectedBranchAsync()
            ?? session.ActiveBranchId
            ?? branches.First().BranchId;

        BranchContext.SetBranch(SelectedBranchId);
    }

    // ✅ SINGLE SOURCE OF TRUTH
    private async Task OnBranchChanged(int newVal)
    {
        if (newVal == 0 || newVal == SelectedBranchId)
            return;

        SelectedBranchId = newVal;

        BranchContext.SetBranch(newVal);
        await AuthService.SelectBranchAsync(newVal);
    }
}
