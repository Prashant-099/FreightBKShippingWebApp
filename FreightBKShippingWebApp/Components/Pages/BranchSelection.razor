@using FreightBKShippingWebApp.Services
@using FreightBKShippingWebApp.Model
@inject IBranchContext BranchContext
@inject AuthService AuthService

@if (branches.Count > 0)
{
    <DxComboBox Data="@branches"
                TextFieldName="BranchName"
                ValueFieldName="BranchId"
                Value="SelectedBranchId"
                ValueChanged="@((int newVal) => OnBranchChanged(newVal))"
                CssClass="form-select w-100" />

}
else
{
    <div class="text-muted small">Loading branches…</div>
}

@code {
    List<UserBranchDto> branches = new();
    private int _selectedBranchId;

    int SelectedBranchId
    {
        get => _selectedBranchId;
        set
        {
            if (_selectedBranchId == value || value == 0) return;

            _selectedBranchId = value;
            BranchContext.SetBranch(value);
            _ = AuthService.SelectBranchAsync(value);
        }
    }


    protected override async Task OnInitializedAsync()
    {

        var session = await AuthService.GetSessionAsync();
        if (session == null) return;

        branches = session.Branches;

        var storedBranchId = await AuthService.GetSelectedBranchAsync();

        int initialBranchId =
            storedBranchId
            ?? session.ActiveBranchId
            ?? branches.First().BranchId;

        SelectedBranchId = initialBranchId;
    }


    private void OnBranchChanged(int newVal)
    {
        BranchContext.SetBranch(newVal);
        _ = AuthService.SelectBranchAsync(newVal); // localStorage
    }


}
