@page "/dashboard"
@implements IDisposable
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using FreightBKShippingWebApp.Model
@using FreightBKShippingWebApp.Services
@using Microsoft.AspNetCore.Components.Authorization
@using System.Globalization
@using static FreightBKShippingWebApp.Model.DashboardResponseDto
@inject ToasteService ToastService
@inject NavigationManager Navigation
@inject AuthService AuthService
@inject AuthenticationStateProvider AuthStateProvider
@inject YearStatechangeService YearStatechangeService
@inject JobService JobService
@inject BillService BillService
@inject LoadingService LoadingService
@inject StatusService StatusService
@inject DashboardService DashboardService
@inject IJSRuntime JS


<PageTitle>Dashboard - Freight BK Shipping</PageTitle>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=JetBrains+Mono:wght@500&display=swap');
</style>

<div class="dash-wrap">

    @if (!authReady)
    {
        <!-- Loading skeleton while auth state resolves -->
        <div style="padding:16px">
            <div class="skel" style="height:80px;border-radius:18px;margin-bottom:16px"></div>
            <div class="sa-grid">
                <div class="skel skel-card"></div>
                <div class="skel skel-card"></div>
                <div class="skel skel-card"></div>
                <div class="skel skel-card"></div>
            </div>
        </div>
    }
    else
    {
        @* <!-- ══ BANNER ══ --> *@
        <div class="dash-banner">
            <div class="dash-banner-left">
                <h2>⚡ Welcome, @UserName!</h2>
                <p>@DateTime.Now.ToString("dddd, dd MMMM yyyy")</p>
            </div>
            <div class="dash-banner-right">
                @if (!isSuperAdmin)
                {
                    <div class="dash-fy-badge" @onclick="OpenDateFilter">
                        <i class="bi bi-calendar3 me-1"></i> FY @CurrentYearName
                    </div>
                }
            </div>
        </div>

        @* <!-- ══ SUPERADMIN DASHBOARD ══ --> *@
        @if (isSuperAdmin)
        {
            @if (superAdminData == null)
            {
                @* <!-- Skeleton --> *@
                <div class="sa-grid">
                    <div class="skel skel-card"></div>
                    <div class="skel skel-card"></div>
                    <div class="skel skel-card"></div>
                    <div class="skel skel-card"></div>
                </div>
                <div class="skel skel-chart"></div>
            }
            else
            {
                @* <!-- SA Stat Cards --> *@
                <div class="sa-support-row">
                    <div class="sa-sup-card" @onclick='() => Navigation.NavigateTo("/superadmin/support")'>
                        <div class="sa-sup-icon">
                            <i class="bi bi-headset"></i>
                        </div>
                        <div class="sa-sup-body">
                            <div class="sa-sup-label">Open Tickets</div>
                            <div class="sa-sup-num">@(superAdminData?.TotalOpenTickets ?? 0)</div>
                            <div class="sa-sup-sub">Click to manage →</div>
                        </div>
                    </div>
                    <div class="sa-sup-card sa-sup-urgent" @onclick='() => Navigation.NavigateTo("/superadmin/support?status=1")'>
                        <div class="sa-sup-icon">
                            <i class="bi bi-envelope-exclamation"></i>
                        </div>
                        <div class="sa-sup-body">
                            <div class="sa-sup-label">Unread Messages</div>
                            <div class="sa-sup-num">@(superAdminData?.TotalUnreadTickets ?? 0)</div>
                            <div class="sa-sup-sub">Needs your response →</div>
                        </div>
                    </div>
                </div>
                <div class="sa-grid">
                    <div class="sa-card">
                        <div class="sa-card-label"><i class="bi bi-buildings me-1"></i>Total Companies</div>
                        <div class="sa-card-val sa-primary">@superAdminData.TotalCompanies</div>
                    </div>
                    <div class="sa-card">
                        <div class="sa-card-label"><i class="bi bi-exclamation-triangle me-1"></i>Expired</div>
                        <div class="sa-card-val sa-danger">@superAdminData.ExpiredCompanies</div>
                    </div>
                    <div class="sa-card">
                        <div class="sa-card-label"><i class="bi bi-wifi me-1"></i>Online Now</div>
                        <div class="sa-card-val sa-success">@superAdminData.OnlineCompanies</div>
                    </div>
                    <div class="sa-card">
                        <div class="sa-card-label"><i class="bi bi-person-check me-1"></i>Today's Logins</div>
                        <div class="sa-card-val sa-info">@superAdminData.TodayLogins</div>
                    </div>
                </div>

                @* <!-- SA Table --> *@
                <div class="sa-table-card">
                    <div class="sa-table-header">
                        <div class="sa-table-title">
                            <i class="bi bi-table me-2" style="color:#1565c0"></i>Company Login & User Stats
                        </div>
                        <span class="sa-table-count">@(superAdminData.CompanyLoginCounts?.Count() ?? 0) Companies</span>
                    </div>

                    <DxGrid Data="@superAdminData.CompanyLoginCounts"
                            ShowSearchBox="true"
                            PageSize="10"
                            PageSizeSelectorVisible="true"
                            ShowGroupPanel="false"
                            FilterMenuButtonDisplayMode="GridFilterMenuButtonDisplayMode.Always"
                            FocusedRowEnabled="false"
                            ColumnResizeMode="GridColumnResizeMode.ColumnsContainer">
                        <Columns>
                            <DxGridDataColumn Caption="Company" FixedPosition="GridColumnFixedPosition.Left" MinWidth="180">
                                <CellDisplayTemplate Context="c">
                                    @{
                                        var r = (CompanyLoginCountDto)c.DataItem;
                                    }
                                    <strong style="color:#1565c0">@r.CompanyName</strong>
                                </CellDisplayTemplate>
                            </DxGridDataColumn>

                            <DxGridDataColumn Caption="Users">
                                <CellDisplayTemplate Context="c">
                                    @{
                                        var r = (CompanyLoginCountDto)c.DataItem;
                                    }
                                    <span class="badge bg-info-subtle text-info">@r.TotalUsers / @r.MaxUsersAllowed</span>
                                </CellDisplayTemplate>
                            </DxGridDataColumn>

                            <DxGridDataColumn Caption="Remaining">
                                <CellDisplayTemplate Context="c">
                                    @{
                                        var r = (CompanyLoginCountDto)c.DataItem;
                                    }
                                    <span class="badge bg-success-subtle text-success">@r.RemainingUserSlots</span>
                                </CellDisplayTemplate>
                            </DxGridDataColumn>

                            <DxGridDataColumn Caption="Online">
                                <CellDisplayTemplate Context="c">
                                    @{
                                        var r = (CompanyLoginCountDto)c.DataItem;
                                        var o = superAdminData.OnlineCompaniesList.FirstOrDefault(x => x.CompanyId == r.CompanyId);
                                    }
                                    <span class="badge bg-primary-subtle text-primary">@(o?.OnlineUsers ?? 0)</span>
                                </CellDisplayTemplate>
                            </DxGridDataColumn>

                            <DxGridDataColumn Caption="Success Logins">
                                <CellDisplayTemplate Context="c">
                                    @{
                                        var r = (CompanyLoginCountDto)c.DataItem;
                                    }
                                    <span style="color:#10b981;font-weight:600">@r.TotalSuccessfulLogins</span>
                                </CellDisplayTemplate>
                            </DxGridDataColumn>

                            <DxGridDataColumn Caption="Failed">
                                <CellDisplayTemplate Context="c">
                                    @{
                                        var r = (CompanyLoginCountDto)c.DataItem;
                                    }
                                    <span style="color:#ef4444;font-weight:600">@r.TotalFailedLogins</span>
                                </CellDisplayTemplate>
                            </DxGridDataColumn>

                            <DxGridDataColumn FieldName="MonthlySuccessfulLogins" Caption="Monthly" />

                            <DxGridDataColumn Caption="Expiry" MinWidth="130">
                                <CellDisplayTemplate Context="c">
                                    @{
                                        var r = (CompanyLoginCountDto)c.DataItem;
                                        var exp = superAdminData.CompanyExpiryList.FirstOrDefault(x => x.CompanyId == r.CompanyId);
                                    }
                                    @if (exp != null)
                                    {
                                        <div>
                                            <div style="font-size:.8rem;font-weight:600">@exp.FinalExpiryDate?.ToString("dd MMM yyyy")</div>
                                            @if (exp.IsExpired)
                                            {
                                                <span class="badge bg-danger-subtle text-danger">Expired</span>
                                            }
                                            else if (exp.DaysRemaining <= 7)
                                            {
                                                <span class="badge bg-warning-subtle text-warning">@exp.DaysRemaining days left</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success-subtle text-success">@exp.DaysRemaining days left</span>
                                            }
                                        </div>
                                    }
                                </CellDisplayTemplate>
                            </DxGridDataColumn>
                        </Columns>
                    </DxGrid>
                </div>
            }
        }
        else
        {
            @* <!-- ══ NORMAL USER DASHBOARD ══ --> *@
            @if (isLoading)
            {
                <!-- Skeleton Loading -->
                <div class="stat-grid">
                    @for (int i = 0; i < 7; i++)
                    {
                        <div class="skel skel-card @(i == 5 ? "stat-wide" : "")"></div>
                    }
                </div>
                <div class="chart-row">
                    <div class="skel skel-chart"></div>
                    <div class="skel skel-chart"></div>
                </div>
            }
            else
            {
                @* <!-- Stat Cards --> *@
                <div class="stat-grid">

                    <div class="stat-card" @onclick="@(() => Navigation.NavigateTo("/jobimport"))">
                        <div class="stat-icon-wrap si-import"><i class="bi bi-box-arrow-in-down"></i></div>
                        <div class="stat-body">
                            <div class="stat-label">Import Active</div>
                            <div class="stat-value">@stats.TotalImportJobs</div>
                            <div class="stat-sub">↑ @stats.ImportJobsThisMonth this month</div>
                        </div>
                    </div>

                    <div class="stat-card" @onclick="@(() => Navigation.NavigateTo("/jobexport"))">
                        <div class="stat-icon-wrap si-export"><i class="bi bi-box-arrow-up"></i></div>
                        <div class="stat-body">
                            <div class="stat-label">Export Active</div>
                            <div class="stat-value" style="color:#e91e63">@stats.TotalExportJobs</div>
                            <div class="stat-sub">↑ @stats.ExportJobsThisMonth this month</div>
                        </div>
                    </div>

                    <div class="stat-card" @onclick="@(() => Navigation.NavigateTo("/jobregister"))">
                        <div class="stat-icon-wrap si-pending"><i class="bi bi-clock-history"></i></div>
                        <div class="stat-body">
                            <div class="stat-label">Pending</div>
                            <div class="stat-value" style="color:#f59e0b">@stats.PendingJobs</div>
                            <div class="stat-sub" style="color:#f59e0b">⚠ Requires attention</div>
                        </div>
                    </div>

                    <div class="stat-card" @onclick="@(() => Navigation.NavigateTo("/jobregister"))">
                        <div class="stat-icon-wrap si-done"><i class="bi bi-check-circle"></i></div>
                        <div class="stat-body">
                            <div class="stat-label">Completed</div>
                            <div class="stat-value" style="color:#10b981">@stats.CompletedJobs</div>
                            <div class="stat-sub">@stats.CompletionRate% rate</div>
                        </div>
                    </div>

                    <div class="stat-card" @onclick="@(() => Navigation.NavigateTo("/jobregister"))">
                        <div class="stat-icon-wrap si-cancel"><i class="bi bi-x-circle"></i></div>
                        <div class="stat-body">
                            <div class="stat-label">Cancelled</div>
                            <div class="stat-value" style="color:#ef4444">@stats.CancelledJobs</div>
                            <div class="stat-sub">@stats.CancellationRate% rate</div>
                        </div>
                    </div>

                    <div class="stat-card" @onclick="@(() => Navigation.NavigateTo("/bill"))">
                        <div class="stat-icon-wrap si-bill"><i class="bi bi-receipt"></i></div>
                        <div class="stat-body">
                            <div class="stat-label">Total Invoices</div>
                            <div class="stat-value" style="color:#6366f1">@stats.TotalBills</div>
                            <div class="stat-sub">↑ @stats.BillsThisMonth this month</div>
                        </div>
                    </div>

                    <div class="stat-card stat-wide" @onclick="@(() => Navigation.NavigateTo("/invoiceregister"))">
                        <div class="stat-icon-wrap si-rev"><i class="bi bi-currency-rupee"></i></div>
                        <div class="stat-body">
                            <div class="stat-label">Total Revenue</div>
                            <div class="stat-value" style="color:#0891b2">₹@stats.TotalRevenue.ToString("N0")</div>
                            <div class="stat-sub">↑ ₹@stats.RevenueThisMonth.ToString("N0") this month</div>
                        </div>
                    </div>

                </div>

                @* <!-- Charts — Slide 1: Pie + Bar --> *@
                <div class="chart-row">
                    <div class="chart-card">
                        <div class="chart-title"><i class="bi bi-pie-chart-fill"></i> Job Status Distribution</div>
                        @if (jobStatusData?.Any(x => !string.IsNullOrWhiteSpace(x.Label)) == true)
                        {
                            <DxChart Data="@jobStatusData" Height="260px">
                                <DxChartLegend Visible="true" Position="RelativePosition.Outside" HorizontalAlignment="HorizontalAlignment.Center" />
                                <DxChartPieSeries ArgumentField="@((JobTypeData s) => s.Label)"
                                                  ValueField="@((JobTypeData s) => s.Count)" Name="Jobs">
                                    <DxChartSeriesLabel Visible="true">
                                        <DxChartSeriesLabelConnector Visible="true" />
                                    </DxChartSeriesLabel>
                                </DxChartPieSeries>
                            </DxChart>
                        }
                        else
                        {
                            <div class="dash-empty"><i class="bi bi-pie-chart"></i><p>No data</p></div>
                        }
                    </div>

                    <div class="chart-card">
                        <div class="chart-title"><i class="bi bi-bar-chart-fill"></i> Import vs Export</div>
                        <DxChart Data="@jobTypeData" Width="100%" Height="260px">
                            <DxChartLegend Visible="true" Position="RelativePosition.Outside" />
                            <DxChartBarSeries T="JobTypeData" TArgument="string" TValue="int"
                                              Name="Import"
                                              ArgumentField="@(j => j.Label)"
                                              ValueField="@(j => j.Count)"
                                              Filter="@(j => j.Label == "IMPORT")" />
                            <DxChartBarSeries T="JobTypeData" TArgument="string" TValue="int"
                                              Name="Export"
                                              ArgumentField="@(j => j.Label)"
                                              ValueField="@(j => j.Count)"
                                              Filter="@(j => j.Label == "EXPORT")" />
                        </DxChart>
                    </div>
                </div>

                @* <!-- Chart — Slide 2: Revenue Trend --> *@
                <div class="chart-row">
                    <div class="chart-card chart-card-full">
                        <div class="chart-title"><i class="bi bi-graph-up"></i> Monthly Revenue Trend — FY @CurrentYearName</div>
                        @if (revenueData?.Any() == true)
                        {
                            <DxChart Data="@revenueData.OrderBy(x => x.MonthOrder)" Width="100%" Height="280px">
                                <DxChartLegend Visible="false" />
                                <DxChartLineSeries ArgumentField="@((MonthlyRevenueDto r) => r.MonthName)"
                                                   ValueField="@((MonthlyRevenueDto r) => Math.Round((decimal)r.Amount, 2))"
                                                   Name="Revenue">
                                    <DxChartSeriesPoint Symbol="ChartPointSymbol.Circle" Size="7" />
                                </DxChartLineSeries>
                                <DxChartTooltip Enabled="true">
                                    <div style="padding:8px 12px;font-size:.82rem">
                                        <strong>@context.Point.Argument</strong><br />
                                        ₹@(((decimal)context.Point.Value).ToString("N0"))
                                    </div>
                                </DxChartTooltip>
                            </DxChart>
                        }
                        else
                        {
                            <div class="dash-empty">
                                <i class="bi bi-graph-up"></i>
                                <p>No revenue data for FY @CurrentYearName</p>
                            </div>
                        }
                    </div>
                </div>
            }
        }

    } 

    @* < !--end authReady else --> *@
</div>

@* <!-- /.dash-wrap --> *@

<DateFilterPage @ref="dateFilterPopup" OnFilterApplied="HandleFilterApplied" />

@code {
    // ── State ────────────────────────────────────────────
    private string UserName { get; set; } = "User";
    private string CurrentYearName { get; set; } = "";
    private bool isLoading = true;
    private bool isSuperAdmin = false;
    private bool authReady = false;  // ✅ prevents flash before role is known

    private DashboardStats stats = new();
    private List<JobTypeData> jobStatusData = new();
    private List<JobTypeData> jobTypeData = new();
    private List<MonthlyRevenueDto> revenueData = new();
    private SuperAdminDashboardDto? superAdminData;
    private DateTime? filterFromDate;
    private DateTime? filterToDate;

    private DateFilterPage dateFilterPopup = default!;

    // ── Init — role check FIRST, then load correct data ──
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity?.IsAuthenticated != true)
                return;

            UserName = user.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value
                          ?? user.Identity.Name ?? "User";
            isSuperAdmin = user.IsInRole("SuperAdmin");
            authReady = true;   // ✅ role confirmed, now safe to render
            StateHasChanged();

            if (isSuperAdmin)
            {
                await LoadSuperAdminDashboard();
            }
            else
            {
                CurrentYearName = YearStatechangeService.Years
                    .FirstOrDefault(y => y.YearId == YearStatechangeService.SelectedYearId)?.YearName
                    ?? DateTime.Now.Year.ToString();

                YearStatechangeService.OnYearChanged += HandleYearChanged;
                await LoadDashboardData();
            }
        }
        catch (Exception ex)
        {
            ToastService.Error($"Error loading dashboard: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    // ── SuperAdmin Load ───────────────────────────────────
    private async Task LoadSuperAdminDashboard()
    {
        try
        {
            superAdminData = await DashboardService.GetSuperAdminDashboardAsync();
        }
        catch (Exception ex)
        {
            ToastService.Error($"SuperAdmin dashboard error: {ex.Message}");
        }
    }

    // ── Normal User Load ──────────────────────────────────
    private async Task LoadDashboardData()
    {
        isLoading = true;
        StateHasChanged();   // show skeleton immediately

        try
        {
            var yearId = YearStatechangeService.SelectedYearId;
            var result = await DashboardService.GetDashboardAsync(yearId, filterFromDate, filterToDate);

            if (result == null) { ToastService.Warning("No dashboard data."); return; }

            stats = result.Stats;
            jobStatusData = result.JobStatusChart?
                .Where(x => !string.IsNullOrWhiteSpace(x.Label))
                .Select(x => new JobTypeData { Label = x.Label!, Count = x.Count })
                .ToList() ?? new();
            jobTypeData = result.JobTypeChart ?? new();

            revenueData = result.MonthlyRevenue?.Select(r => new MonthlyRevenueDto
            {
                Month = r.Month,
                MonthName = CultureInfo.CurrentCulture.DateTimeFormat.GetAbbreviatedMonthName(r.Month),
                Amount = r.Amount,
                MonthOrder = r.Month >= 4 ? r.Month - 3 : r.Month + 9
            }).ToList() ?? new();
        }
        catch (Exception ex)
        {
            ToastService.Error($"Dashboard error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    // ── Filter ───────────────────────────────────────────
    private void OpenDateFilter()
        => dateFilterPopup.Show(filterFromDate, filterToDate, null, null, null);

    private async Task HandleFilterApplied(
        (DateTime? FromDate, DateTime? ToDate, string? JobType, int? vouchertype, string? OutstandingType) f)
    {
        filterFromDate = f.FromDate;
        filterToDate = f.ToDate;
        await LoadDashboardData();
    }

    // ── Year change ───────────────────────────────────────
    private async void HandleYearChanged()
    {
        try
        {
            CurrentYearName = YearStatechangeService.Years
                .FirstOrDefault(y => y.YearId == YearStatechangeService.SelectedYearId)?.YearName
                ?? DateTime.Now.Year.ToString();
            await LoadDashboardData();
        }
        catch (Exception ex)
        {
            ToastService.Error($"Year change error: {ex.Message}");
        }
    }

    public void Dispose()
        => YearStatechangeService.OnYearChanged -= HandleYearChanged;
}
