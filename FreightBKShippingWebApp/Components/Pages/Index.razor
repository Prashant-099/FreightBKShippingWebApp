    private void PrepareJobStatusData(List<Job> jobs,
                                  List<int> pendingIds,
                                  List<int> completeIds,
                                  List<int> cancelIds)
    {
        jobStatusData = new List<JobStatusData>
    {
        new()
        {
            Status = "Pending",
            Count = jobs.Count(j => j.JobStatus.HasValue && pendingIds.Contains(j.JobStatus.Value))
        },
        new()
        {
            Status = "Complete",
            Count = jobs.Count(j => j.JobStatus.HasValue && completeIds.Contains(j.JobStatus.Value))
        },
        new()
        {
            Status = "Cancelled",
            Count = jobs.Count(j => j.JobStatus.HasValue && cancelIds.Contains(j.JobStatus.Value))
        }
    };
    }
    private void PrepareJobTypeData(List<Job> jobs)
    {
        var monthlyData = jobs
            .GroupBy(j => new { j.JobDate.Year, j.JobDate.Month })
            .OrderBy(g => g.Key.Year).ThenBy(g => g.Key.Month)
            .Take(6)
            .Select(g => new JobTypeData
            {
                Month = new DateTime(g.Key.Year, g.Key.Month, 1).ToString("MMM yy"),
                ImportCount = g.Count(j => j.JobType?.ToUpper() == "IMPORT"),
                ExportCount = g.Count(j => j.JobType?.ToUpper() == "EXPORT")
            })
            .ToList();

        jobTypeData = monthlyData;
    }

    // ✅ NEW METHOD: Prepare revenue data for FULL YEAR only (ignores date filter)
    private void PrepareRevenueDataForYear(List<Bill> yearBills)
    {
        // Get the selected year's date range
        var selectedYear = YearStatechangeService.Years
            .FirstOrDefault(y => y.YearId == YearStatechangeService.SelectedYearId);

        if (selectedYear == null)
        {
            revenueData = new List<RevenueData>();
            return;
        }

        // Filter bills to only include those within the selected financial year
        var billsInYear = yearBills
            .Where(b => YearStatechangeService.IsDateWithinSelectedYear(b.BillDate))
            .ToList();

        // Generate all months in the financial year
        var allMonths = new List<DateTime>();
        var currentDate = new DateTime(selectedYear.YearDateFrom.Value.Year, selectedYear.YearDateFrom.Value.Month, 1);
        var endDate = new DateTime(selectedYear.YearDateTo.Value.Year, selectedYear.YearDateTo.Value.Month, 1);

        while (currentDate <= endDate)
        {
            allMonths.Add(currentDate);
            currentDate = currentDate.AddMonths(1);
        }

        // Create revenue data for all months (with 0 for months without bills)
        revenueData = allMonths
            .Select(month => new RevenueData
            {
                Month = month,
                MonthName = month.ToString("MMM yy"), // e.g., "Jan 24", "Feb 24"
                Amount = billsInYear
                    .Where(b => b.BillDate.Year == month.Year && b.BillDate.Month == month.Month)
                    .Sum(b => b.BillNetAmount)
            })
            .ToList();
    }

    private async void HandleYearChanged()
    {
        CurrentYearName = YearStatechangeService.Years.FirstOrDefault(y => y.YearId == YearStatechangeService.SelectedYearId)?.YearName ?? DateTime.Now.Year.ToString();
        await LoadDashboardData();
        StateHasChanged();
    }

    public void Dispose()
    {
        YearStatechangeService.OnYearChanged -= HandleYearChanged;
    }

