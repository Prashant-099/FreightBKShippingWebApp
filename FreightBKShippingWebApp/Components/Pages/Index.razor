    // Handle Filter Applied
    private async Task HandleFilterApplied((DateTime? FromDate, DateTime? ToDate, string? JobType, int? vouchertype, string? OutstandingType) f)
    {
        filterFromDate = f.FromDate;
        filterToDate = f.ToDate;

        await LoadDashboardData();
    }

    // Clear Date Filter
    private async Task ClearDateFilter()
    {
        filterFromDate = null;
        filterToDate = null;

        await LoadDashboardData();
        ToastService.Info("Date filter cleared.");
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            if (user.Identity != null && user.Identity.IsAuthenticated)
            {
                UserName = user.Identity.Name ?? "User";
                isSuperAdmin = user.IsInRole("SuperAdmin");

            }

            if (isSuperAdmin)
            {
                await LoadSuperAdminDashboard();
            }
            else
            {
                CurrentYearName = YearStatechangeService.Years
                    .FirstOrDefault(y => y.YearId == YearStatechangeService.SelectedYearId)?
                    .YearName ?? DateTime.Now.Year.ToString();

                YearStatechangeService.OnYearChanged += HandleYearChanged;

                await LoadDashboardData();
            }
        }
        catch (Exception ex)
        {
            ToastService.Error($"Error loading dashboard: {ex.Message}");
        }
        // finally
        // {
        //     isLoading = false;
        // }
    }

    private async Task LoadSuperAdminDashboard()
    {
        try
        {
            isLoading = true;
            superAdminData = await DashboardService.GetSuperAdminDashboardAsync();
        }
        catch (Exception ex)
        {
            ToastService.Error($"Error loading super admin dashboard: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }


    // Carousel Navigation
    private void NextSlide()
    {
        if (currentSlide < 1)
        {
            currentSlide++;
            StateHasChanged();
        }
    }

    private void PreviousSlide()
    {
        if (currentSlide > 0)
        {
            currentSlide--;
            StateHasChanged();
        }
    }

    private void GoToSlide(int slideIndex)
    {
        if (slideIndex >= 0 && slideIndex <= 1)
        {
            currentSlide = slideIndex;
            StateHasChanged();
        }
    }

    // Touch/Swipe Handlers
    private void HandleTouchStart(TouchEventArgs e)
    {
        if (e.Touches.Length > 0)
        {
            touchStartX = e.Touches[0].ClientX;
        }
    }

    private void HandleTouchMove(TouchEventArgs e)
    {
        if (e.Touches.Length > 0)
        {
            touchEndX = e.Touches[0].ClientX;
        }
    }

    private void HandleTouchEnd(TouchEventArgs e)
    {
        if (touchStartX - touchEndX > SWIPE_THRESHOLD)
        {
            // Swipe left - next slide
            NextSlide();
        }
        else if (touchEndX - touchStartX > SWIPE_THRESHOLD)
        {
            // Swipe right - previous slide
            PreviousSlide();
        }
    }

    private async Task LoadDashboardData()
    {
        StateHasChanged();

        try
        {
            var yearid = YearStatechangeService.SelectedYearId;
            isLoading = true;
            var result = await DashboardService.GetDashboardAsync(
           yearid,
           filterFromDate,
           filterToDate);
            isLoading = false;
            if (result == null)
            {
                ToastService.Warning("No dashboard data available.");
                return;
            }

            stats = result.Stats;
            jobStatusData = result.JobStatusChart?
                .Where(x => !string.IsNullOrWhiteSpace(x.Label))
                .Select(x => new JobTypeData
                {
                    Label = x.Label!,
                    Count = x.Count
                })
                .ToList()
                ?? new();
            jobTypeData = result.JobTypeChart;
            revenueData = result.MonthlyRevenue;
            if (result != null && result.MonthlyRevenue != null)
            {
                revenueData = result.MonthlyRevenue.Select(r => new MonthlyRevenueDto
                {
                    Month = r.Month,
                    MonthName = CultureInfo.CurrentCulture
        .DateTimeFormat.GetAbbreviatedMonthName(r.Month),
                    Amount = r.Amount,
                    MonthOrder = r.Month >= 4 ? r.Month - 3 : r.Month + 9
                }).ToList();
            }
        }
        catch (Exception ex)
        {
            ToastService.Error($"Error loading data: {ex.Message}");
        }
        finally
        {
            StateHasChanged();
        }
    }

