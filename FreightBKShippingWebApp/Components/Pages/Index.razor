<DateFilterPage @ref="dateFilterPopup" OnFilterApplied="HandleFilterApplied" />
@code {
    private List<Status> statusList = new();
    private DateFilterPage dateFilterPopup;
    private string UserName { get; set; } = "User";
    private string CurrentYearName { get; set; } = "";
    private bool isLoading = true;
    private int currentSlide = 0;
    private ElementReference swiperRef;

    // Touch/Swipe handling
    private double touchStartX = 0;
    private double touchEndX = 0;
    private const double SWIPE_THRESHOLD = 50;

    private DashboardStats stats = new();
    private List<JobStatusData> jobStatusData = new();
    private List<JobTypeData> jobTypeData = new();
    private List<RevenueData> revenueData = new();
    private DateTime? filterFromDate;
    private DateTime? filterToDate;

    private void OpenDateFilter()
    {
        dateFilterPopup.Show(filterFromDate, filterToDate ,null ,null);
    }

    // Handle Filter Applied
    private async Task HandleFilterApplied((DateTime? FromDate, DateTime? ToDate, string? JobType, int? vouchertype) f)
    {
        filterFromDate = f.FromDate;
        filterToDate = f.ToDate;

        await LoadDashboardData();
    }

    // Clear Date Filter
    private async Task ClearDateFilter()
    {
        filterFromDate = null;
        filterToDate = null;

        await LoadDashboardData();
        ToastService.Info("Date filter cleared.");
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            if (user.Identity != null && user.Identity.IsAuthenticated)
            {
                UserName = user.Identity.Name ?? "User";
            }

            CurrentYearName = YearStatechangeService.Years.FirstOrDefault(y => y.YearId == YearStatechangeService.SelectedYearId)?.YearName ?? DateTime.Now.Year.ToString();
            YearStatechangeService.OnYearChanged += HandleYearChanged;

            await LoadDashboardData();
        }
        catch (Exception ex)
        {
            ToastService.Error($"Error loading dashboard: {ex.Message}");
        }
        // finally
        // {
        //     isLoading = false;
        // }
    }

    // Carousel Navigation
    private void NextSlide()
    {
        if (currentSlide < 1)
        {
            currentSlide++;
            StateHasChanged();
        }
    }

    private void PreviousSlide()
    {
        if (currentSlide > 0)
        {
            currentSlide--;
            StateHasChanged();
        }
    }

    private void GoToSlide(int slideIndex)
    {
        if (slideIndex >= 0 && slideIndex <= 1)
        {
            currentSlide = slideIndex;
            StateHasChanged();
        }
    }

    // Touch/Swipe Handlers
    private void HandleTouchStart(TouchEventArgs e)
    {
        if (e.Touches.Length > 0)
        {
            touchStartX = e.Touches[0].ClientX;
        }
    }

    private void HandleTouchMove(TouchEventArgs e)
    {
        if (e.Touches.Length > 0)
        {
            touchEndX = e.Touches[0].ClientX;
        }
    }

    private void HandleTouchEnd(TouchEventArgs e)
    {
        if (touchStartX - touchEndX > SWIPE_THRESHOLD)
        {
            // Swipe left - next slide
            NextSlide();
        }
        else if (touchEndX - touchStartX > SWIPE_THRESHOLD)
        {
            // Swipe right - previous slide
            PreviousSlide();
        }
    }

    private async Task LoadDashboardData()
    {
        StateHasChanged();

        try
        {
            isLoading = true;
            var allJobs = await JobService.GetAllAsync();
            var allBills = await BillService.GetAllAsync();
            statusList = await StatusService.GetAllAsync();
            isLoading = false;

            // Get jobs and bills for selected year
            var yearJobs = allJobs.Where(j => j.JobYearId == YearStatechangeService.SelectedYearId.ToString()).ToList();
            var yearBills = allBills.Where(b => b.BillYearId == YearStatechangeService.SelectedYearId).ToList();

            // Create a copy for filtered data (for stats and charts in Slide 1)
            var filteredJobs = yearJobs.ToList();
            var filteredBills = yearBills.ToList();

            // Apply date filter ONLY to filtered data (not to yearJobs/yearBills)
            if (filterFromDate.HasValue)
            {
                filteredJobs = filteredJobs
                    .Where(j => j.JobDate.Date >= filterFromDate.Value.Date)
                    .ToList();

                filteredBills = filteredBills
                    .Where(b => b.BillDate.Date >= filterFromDate.Value.Date)
                    .ToList();
            }

            if (filterToDate.HasValue)
            {
                filteredJobs = filteredJobs
                    .Where(j => j.JobDate.Date <= filterToDate.Value.Date)
                    .ToList();

                filteredBills = filteredBills
                    .Where(b => b.BillDate.Date <= filterToDate.Value.Date)
                    .ToList();
            }
            var pendingIds = statusList.Where(x => string.Equals(x.StatusName?.Trim(), "Pending", StringComparison.OrdinalIgnoreCase)).Select(x => x.StatusId).ToList();
            var cancelIds = statusList.Where(x => string.Equals(x.StatusName?.Trim(), "Cancel", StringComparison.OrdinalIgnoreCase)).Select(x => x.StatusId).ToList();
            var completeIds = statusList.Where(x => string.Equals(x.StatusName?.Trim(), "Completed", StringComparison.OrdinalIgnoreCase)).Select(x => x.StatusId).ToList();
            // Calculate stats using FILTERED data
            stats = new DashboardStats
            {
                TotalImportJobs = filteredJobs.Count(j => j.JobType?.ToUpper() == "IMPORT"),
                TotalExportJobs = filteredJobs.Count(j => j.JobType?.ToUpper() == "EXPORT"),
                PendingJobs = filteredJobs.Count(j => pendingIds.Contains(j.JobStatus ?? 0)),
                CompletedJobs = filteredJobs.Count(j => completeIds.Contains(j.JobStatus ?? 0)),
                CancelledJobs = filteredJobs.Count(j => cancelIds.Contains(j.JobStatus ?? 0)),
                TotalBills = filteredBills.Count,
                TotalRevenue = filteredBills.Sum(b => b.BillNetAmount)
            };

            var currentMonth = DateTime.Now.Month;
            stats.ImportJobsThisMonth = filteredJobs.Count(j => j.JobType?.ToUpper() == "IMPORT" && j.JobDate.Month == currentMonth);
            stats.ExportJobsThisMonth = filteredJobs.Count(j => j.JobType?.ToUpper() == "EXPORT" && j.JobDate.Month == currentMonth);
            stats.BillsThisMonth = filteredBills.Count(b => b.BillDate.Month == currentMonth);
            stats.RevenueThisMonth = filteredBills.Where(b => b.BillDate.Month == currentMonth).Sum(b => b.BillNetAmount);

            stats.CompletionRate = filteredJobs.Count > 0 ? (int)((stats.CompletedJobs * 100.0) / filteredJobs.Count) : 0;
            stats.CancellationRate = filteredJobs.Count > 0 ? (int)((stats.CancelledJobs * 100.0) / filteredJobs.Count) : 0;

            // Prepare charts using FILTERED data for Slide 1
            // PrepareJobStatusData(filteredJobs);
            PrepareJobStatusData(filteredJobs, pendingIds, completeIds, cancelIds);
            PrepareJobTypeData(filteredJobs);

            // ✅ Prepare revenue chart using FULL YEAR data (NOT filtered) for Slide 2
            PrepareRevenueDataForYear(yearBills);
        }
        catch (Exception ex)
        {
            ToastService.Error($"Error loading data: {ex.Message}");
        }
        finally
        {
            StateHasChanged();
        }
    }

