                </div>
            </div>
            
        </div>
            <div class="touch-indicator">
                <i class="bi bi-chevron-compact-right"></i>
            </div>
        

       
        <!-- Pagination Dots -->
       @*  <div class="swiper-pagination">
            <button class="swiper-dot @(currentSlide == 0 ? "active" : "")" @onclick="@(() => GoToSlide(0))" aria-label="Go to slide 1"></button>
            <button class="swiper-dot @(currentSlide == 1 ? "active" : "")" @onclick="@(() => GoToSlide(1))" aria-label="Go to slide 2"></button>
