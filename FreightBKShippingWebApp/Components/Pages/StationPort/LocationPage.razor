@page "/location"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using FreightBKShippingWebApp.Model
@using FreightBKShippingWebApp.Services
@using FreightBKShippingWebApp.Components.Pages
@inject LocationService LocationService
@inject ToasteService ToastService
@inject LoadingService LoadingService
@inject ConfirmationDialogService ConfirmDialogService
@inject GridLayoutService GridLayoutService
@inject AuditLogService AuditLogService
<style>
    .grid-size {
        max-height: 600px;
    }


    /* ComboBox Styling */
    .layout-combobox {
        border-radius: 6px;
        width: 185px;
    }
</style>
<DxGrid TItem="Location" Data="@locationList" @ref="MyGrid"
        KeyFieldName="LocationId"
        ShowSearchBox="true"
        PageSize="10"
        PageSizeSelectorVisible="true"
        ShowGroupPanel="true"
        FilterMenuButtonDisplayMode="GridFilterMenuButtonDisplayMode.Always"
        FocusedRowEnabled="true"
        SelectionMode="GridSelectionMode.Multiple"
        SelectedDataItems="@SelectedLocations"
        SelectedDataItemsChanged="OnSelectedLocationsChanged"
        ColumnResizeMode="GridColumnResizeMode.NextColumn"
        CssClass="grid-size"
        AllowSelectRowByClick="true">

    <ToolbarTemplate>
        <DxToolbar>
            <TitleTemplate Context="tl">
                <div class="d-flex align-items-center">
                    <i class="bi bi-geo-alt-fill"></i>
                    <span class="fs-5 ms-2">Locations</span>
                </div>
            </TitleTemplate>
            <Items>
                <DxToolbarItem Text="Add" IconCssClass="bi bi-plus-circle" Click="OnCreateNew" />
                <DxToolbarItem Text="Edit" IconCssClass="bi bi-pencil-square" Click="OnEdit" />
                <DxToolbarItem Text="Delete" IconCssClass="bi bi-trash" Click="OnDelete" />
                <DxToolbarItem Text="Refresh" IconCssClass="bi bi-arrow-clockwise" Click="@(async (_) => await LoadLocationsAsync())" />
                <DxToolbarItem Alignment="ToolbarItemAlignment.Right"
                               RenderStyle="ButtonRenderStyle.Secondary"
                               IconCssClass="bi bi-gear-wide-connected"
                               Click="ShowLayoutPopup" />
            </Items>
        </DxToolbar>
    </ToolbarTemplate>


    <Columns>

        <DxGridSelectionColumn Width="30" FixedPosition="GridColumnFixedPosition.Left" />

        <DxGridDataColumn FieldName="LocationId" Caption="ID"
                          Width="@(layoutManager?.GetColumnWidth("LocationId") ?? "80px")"
                          Visible="@(layoutManager?.GetColumnVisibility("LocationId") ?? false)" />

        <DxGridDataColumn FieldName="LocationName" Caption="Location Name"
                          Width="@(layoutManager?.GetColumnWidth("LocationName") ?? "450px")"
                          Visible="@(layoutManager?.GetColumnVisibility("LocationName") ?? true)" />

        <DxGridDataColumn FieldName="LocationCode" Caption="Code"
                          Width="@(layoutManager?.GetColumnWidth("LocationCode") ?? "120px")"
                          Visible="@(layoutManager?.GetColumnVisibility("LocationCode") ?? true)" />

        <DxGridDataColumn FieldName="LocationType" Caption="Type"
                          Width="@(layoutManager?.GetColumnWidth("LocationType") ?? "150px")"
                          Visible="@(layoutManager?.GetColumnVisibility("LocationType") ?? true)" />

        <DxGridDataColumn FieldName="LocationState" Caption="State"
                          Width="@(layoutManager?.GetColumnWidth("LocationState") ?? "170px")"
                          Visible="@(layoutManager?.GetColumnVisibility("LocationState") ?? true)" />

        <DxGridDataColumn FieldName="LocationDistrict" Caption="District"
                          Width="@(layoutManager?.GetColumnWidth("LocationDistrict") ?? "150px")"
                          Visible="@(layoutManager?.GetColumnVisibility("LocationDistrict") ?? true)" />

        <DxGridDataColumn FieldName="LocationPincode" Caption="Pincode"
                          Width="@(layoutManager?.GetColumnWidth("LocationPincode") ?? "120px")"
                          Visible="@(layoutManager?.GetColumnVisibility("LocationPincode") ?? true)" />

        <DxGridDataColumn FieldName="LocationCreated" Caption="Created On"
                          DisplayFormat="dd/MM/yyyy"
                          Width="@(layoutManager?.GetColumnWidth("LocationCreated") ?? "150px")"
                          Visible="@(layoutManager?.GetColumnVisibility("LocationCreated") ?? true)" />

        <DxGridDataColumn FieldName="LocationUpdated" Caption="Updated On"
                          DisplayFormat="dd/MM/yyyy"
                          Width="@(layoutManager?.GetColumnWidth("LocationUpdated") ?? "150px")"
                          Visible="@(layoutManager?.GetColumnVisibility("LocationUpdated") ?? true)" />

        <DxGridDataColumn FieldName="LocationStatus" Caption="Active"
                          Width="@(layoutManager?.GetColumnWidth("LocationStatus") ?? "120px")"
                          Visible="@(layoutManager?.GetColumnVisibility("LocationStatus") ?? true)" />

    </Columns>
</DxGrid>

<LocationAddEditPage @ref="popup" OnSaved="LoadLocationsAsync" />
<ConfirmationDialog />
<GridLayoutpPopup @ref="layoutManager"
                  VoucherType="location"
                  Columns="@allColumns"
                  OnLayoutChanged="HandleLayoutChanged" />
@code {
    DxGrid MyGrid;
    private List<Location> locationList = new();
    // private List<Location> SelectedLocations = new();
    private IReadOnlyList<object> SelectedLocations { get; set; } = new List<object>();

    private LocationAddEditPage popup;

    // All possible columns
    private GridLayoutpPopup? layoutManager;
    private List<GridColumnLayout> allColumns = [];
    private async void ShowLayoutPopup()
    {
        await InvokeAsync(() =>
        {
            layoutManager?.ShowPopup();
        });
    }
    private async Task HandleLayoutChanged(List<GridColumnLayout> updatedLayout)
    {
        allColumns = updatedLayout;
        // Force the grid to re-render with new layout
        await InvokeAsync(StateHasChanged);
    }
    protected override async Task OnInitializedAsync()
    {
        InitializeColumns();
        await LoadLocationsAsync();


    }
    private void InitializeColumns()
    {
        allColumns = new List<GridColumnLayout>
        {
        new() { FieldName = "LocationId", Caption = "ID",Visible = false, Width = 80, DisplayIndex = 0 },

    new() { FieldName = "LocationName", Caption = "Location Name",Visible = true, Width = 450, DisplayIndex = 1 },

    new() { FieldName = "LocationCode", Caption = "Code",Visible = false, Width = 120, DisplayIndex = 2 },

    new() { FieldName = "LocationType", Caption = "Type",Visible = true, Width = 150, DisplayIndex = 3 },

    new() { FieldName = "LocationState", Caption = "State",Visible = true, Width = 170, DisplayIndex = 4 },

    new() { FieldName = "LocationDistrict", Caption = "District",Visible = true, Width = 150, DisplayIndex = 5 },

    new() { FieldName = "LocationPincode", Caption = "Pincode",Visible = true, Width = 120, DisplayIndex = 6 },

     new() { FieldName = "LocationStatus", Caption = "Active",Visible = true, Width = 120, DisplayIndex = 7 },

    new() { FieldName = "LocationCreated", Caption = "Created On",Visible = true, Width = 150, DisplayIndex = 8 },

    new() { FieldName = "LocationUpdated", Caption = "Updated On",Visible = true, Width = 150, DisplayIndex = 9 } 
};
    }


    private async Task LoadLocationsAsync()
    {
        LoadingService.Show();
        try
        {
            locationList = await LocationService.GetAllAsync();
        }
        finally
        {
            LoadingService.Hide();
        }
    }

    private async Task OnSelectedLocationsChanged(IReadOnlyList<object> locations)
    {
        SelectedLocations = locations ?? new List<object>();
        await InvokeAsync(StateHasChanged);
    }
    // ✅ FIXED: Reliable clear selection method
    private async Task ClearSelectionManual()
    {
        try
        {
            if (MyGrid != null)
            {
                MyGrid.ClearSelection(); // ✅ Synchronous method
            }
            SelectedLocations = new List<Location>();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Clear selection error: {ex.Message}");
        }
    }

    // ✅ FIXED: Auto-clear after operations
    private async Task ClearSelection()
    {
        await Task.Delay(100); // Small delay for UI update
        await ClearSelectionManual();
    }

    private void OnCreateNew(ToolbarItemClickEventArgs e)
    {
        popup.Show(new Location()
        {
            LocationStatus = true,
            LocationType = "STATION",
            LocationCreated = DateTime.Now
        });
    }

    private async Task OnEdit(ToolbarItemClickEventArgs e)
    {
        var location = MyGrid.GetFocusedDataItem() as Location;
        if (location != null)
        {
            var freshData = locationList
            .FirstOrDefault(x => x.LocationId == location.LocationId);

            if (freshData != null)
                popup.Show(freshData);
        }

        else
            ToastService.Warning("Please select a location to edit.");
        await ClearSelection();
    }

    private async Task OnDelete(ToolbarItemClickEventArgs e)
    {
        if (SelectedLocations == null || SelectedLocations.Count == 0)
        {
            ToastService.Warning("Please select at least one location to delete.");
            return;
        }
        var selectedList = SelectedLocations.Cast<Location>().ToList();

        var confirm = await ConfirmDialogService.ShowAsync(
            $"Are you sure you want to delete {SelectedLocations.Count} selected location(s)?");

        if (!confirm)
        {
            await ClearSelection(); // ✅ Clear on cancel
            return;
        }
        try
        {
            LoadingService.Show("Deleting...");
            int successCount = 0, failCount = 0;

            foreach (var location in selectedList)
            {
                var result = await LocationService.DeleteAsync(location.LocationId);
                if (result)
                {
                    successCount++;
                    AuditLogService.NotifyAuditChanged();

                }

                else failCount++;
            }

        if (successCount > 0)
            ToastService.Success($"{successCount} Location(s) Deleted Successfully.");
        if (failCount > 0)
            ToastService.Error($"{failCount} Location(s) Failed To Delete.");

        await LoadLocationsAsync();
        }
        finally
        {
            LoadingService.Hide();
            await ClearSelection(); // ✅ Clear after delete (success or fail)
        }
    }
}
