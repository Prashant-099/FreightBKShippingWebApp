                            <ValidationMessage For="@(() => user.UserPassword)" />
                        </div>

                        <div class="forgot-row">
                            <a href="/forgot" class="forgot-a">Forgot password?</a>
                        </div>

                        <div class="fsep"></div>

                        <button type="submit" class="sbtn" disabled="@isloading">
