                            {
                                <svg width="16" height="16" viewBox="0 0 16 16" fill="white" xmlns="http://www.w3.org/2000/svg" style="flex-shrink:0">
                                    <path fill-rule="evenodd" d="M10 12.5a.5.5 0 0 1-.5.5h-8a.5.5 0 0 1-.5-.5v-9a.5.5 0 0 1 .5-.5h8a.5.5 0 0 1 .5.5v2a.5.5 0 0 0 1 0v-2A1.5 1.5 0 0 0 9.5 2h-8A1.5 1.5 0 0 0 0 3.5v9A1.5 1.5 0 0 0 1.5 14h8a1.5 1.5 0 0 0 1.5-1.5v-2a.5.5 0 0 0-1 0z" />
                                    <path fill-rule="evenodd" d="M15.854 8.354a.5.5 0 0 0 0-.708l-3-3a.5.5 0 0 0-.708.708L14.293 7.5H5.5a.5.5 0 0 0 0 1h8.793l-2.147 2.146a.5.5 0 0 0 .708.708z" />
                                </svg>
                                <span>Sign In to FreightBook</span>
                            }
                        </button>

                    </EditForm>

                    <div class="ffoot">FreightBook &copy; @DateTime.Now.Year</div>
                </div>

            </div>
        </div>

    </main>

    <!-- FOOTER -->
    <footer class="ls-footer">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="#8099b5" xmlns="http://www.w3.org/2000/svg">
            <path d="M3.654 1.328a.678.678 0 0 0-1.015-.063L1.605 2.3c-.483.484-.661 1.169-.45 1.77a17.6 17.6 0 0 0 4.168 6.608 17.6 17.6 0 0 0 6.608 4.168c.601.211 1.286.033 1.77-.45l1.034-1.034a.678.678 0 0 0-.063-1.015l-2.307-1.794a.68.68 0 0 0-.58-.122l-2.19.547a1.75 1.75 0 0 1-1.657-.459L5.482 8.062a1.75 1.75 0 0 1-.46-1.657l.548-2.19a.68.68 0 0 0-.122-.58z" />
        </svg>
        <span>Support: 9409309616</span>
        <span style="color:#dce5f2">·</span>
        <span>FreightBook Shipping Management</span>
    </footer>

</div>

@code {
    private bool isloading = false;
    private LoginModel user = new LoginModel();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
            Navigation.NavigateTo("/dashboard", forceLoad: false);
    }

    private async Task HandleLogin()
    {
        isloading = true;
        try
        {
            var result = await AuthService.LoginAsync(new LoginModel
            {
                UserEmail = user.UserEmail,
                UserPassword = user.UserPassword
            });
            if (result?.Token != null)
            {
                await ((CustomAuthStateProvider)AuthStateProvider).MarkUserAsAuthenticated(result);
                Navigation.NavigateTo("/dashboard", forceLoad: false);
            }
            else
            {
                ToastService.Error("Login failed", "Please check your credentials and try again.");
            }
        }
        catch (Exception ex)
        {
            ToastService.Error($"🛑 Error: {ex.Message}", "Login Failed");
        }
        finally { isloading = false; }
    }
}
