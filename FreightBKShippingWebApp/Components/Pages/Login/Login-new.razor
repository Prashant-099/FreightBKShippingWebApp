                                    </svg>
                                </span>
                                <DxTextBox @bind-Text="user.UserEmail"
                                           CssClass="w-100"
                                           NullText="you@company.com" />
                            </div>
                            <ValidationMessage For="@(() => user.UserEmail)" />
