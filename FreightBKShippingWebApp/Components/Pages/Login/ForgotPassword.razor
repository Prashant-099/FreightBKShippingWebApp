@layout EmptyLayout
@page "/forgot"
@using System.ComponentModel.DataAnnotations
@using FreightBKShippingWebApp.Model
@using FreightBKShippingWebApp.Services
@inject AuthService AuthService
@inject ToasteService ToastService
@rendermode InteractiveServer

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />

<style>
    /* ── RESET ── */
    html, body {
        margin: 0 !important;
        padding: 0 !important;
        overflow-x: hidden !important;
        overflow-y: auto !important;
        height: auto !important;
        min-height: 100% !important;
    }

    *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    /* ── VARIABLES ── */
    :root {
        --h: #1557b0;
        --hm: #1a73e8;
        --blue-mid: #2563eb;
        --blue-light: #3b82f6;
        --blue-pale: #eff6ff;
        --teal: #0ea5e9;
        --border: #e2e8f0;
        --ink: #0f172a;
        --muted: #64748b;
        --white: #ffffff;
        --danger: #ef4444;
        --success: #16a34a;
        --radius: 16px;
        --radius-sm: 10px;
        --font: 'Sora', sans-serif;
        --mono: 'JetBrains Mono', monospace;
    }

    /* ══════════════════════════════════════
           UNIFIED NAVBAR
        ══════════════════════════════════════ */
    .fb-nav {
        position: sticky;
        top: 0;
        z-index: 200;
        height: 62px;
        background: linear-gradient(90deg, #1a73e8 0%, #1557b0 100%);
        box-shadow: 0 3px 16px rgba(21,87,176,.38);
        display: flex;
        align-items: center;
        padding: 0 1.5rem;
        gap: .8rem;
        font-family: var(--font);
    }

    .fb-nav-logo {
        height: 38px;
        width: 38px;
        border-radius: 9px;
        border: 2px solid rgba(255,255,255,.28);
        object-fit: cover;
        flex-shrink: 0;
    }

    .fb-nav-brand {
        flex-shrink: 0;
        line-height: 1.2;
    }

    .fb-nav-brand-name {
        display: block;
        font-size: 1rem;
        font-weight: 800;
        color: #fff;
        letter-spacing: -.3px;
    }

    .fb-nav-brand-sub {
        display: block;
        font-size: .6rem;
        color: rgba(255,255,255,.7);
        letter-spacing: .4px;
        font-family: var(--mono);
    }

    .fb-nav-ticker {
        flex: 1;
        overflow: hidden;
        mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
        min-width: 0;
    }

    .fb-nav-ticker-inner {
        display: inline-flex;
        gap: 3rem;
        white-space: nowrap;
        animation: fb-tick 24s linear infinite;
        font-family: var(--mono);
        font-size: .73rem;
        color: rgba(255,255,255,.8);
    }

    @@keyframes fb-tick {
        from {
            transform: translateX(0);
        }

        to {
            transform: translateX(-50%);
        }
    }

    .fb-nav-links {
        display: flex;
        align-items: center;
        gap: .4rem;
        flex-shrink: 0;
    }

    .fb-nav-link {
        display: flex;
        align-items: center;
        gap: .35rem;
        font-size: .78rem;
        color: rgba(255,255,255,.85);
        text-decoration: none;
        padding: .3rem .7rem;
        border-radius: 7px;
        transition: .15s;
        white-space: nowrap;
    }

        .fb-nav-link:hover {
            color: #fff;
            background: rgba(255,255,255,.14);
        }

    .fb-nav-ghost {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        padding: .38rem 1rem;
        background: rgba(255,255,255,.13);
        color: #fff;
        font-family: var(--font);
        font-size: .78rem;
        font-weight: 600;
        border: 1.5px solid rgba(255,255,255,.3);
        border-radius: 9px;
        cursor: pointer;
        text-decoration: none;
        transition: background .15s;
        white-space: nowrap;
    }

        .fb-nav-ghost:hover {
            background: rgba(255,255,255,.22);
        }

    .fb-nav-burger {
        display: none;
        flex-direction: column;
        gap: 5px;
        background: none;
        border: none;
        cursor: pointer;
        padding: .3rem;
        margin-left: auto;
    }

        .fb-nav-burger span {
            display: block;
            width: 22px;
            height: 2px;
            background: #fff;
            border-radius: 2px;
        }

    .fb-drawer {
        display: none;
        flex-direction: column;
        background: linear-gradient(180deg, #1151a8 0%, #0b3580 100%);
        padding: .65rem 1.1rem 1rem;
        gap: .35rem;
        box-shadow: 0 8px 24px rgba(21,87,176,.35);
        position: sticky;
        top: 62px;
        z-index: 199;
    }

        .fb-drawer.open {
            display: flex;
        }

    .fb-drawer-link {
        color: rgba(255,255,255,.88);
        text-decoration: none;
        font-size: .88rem;
        padding: .6rem .8rem;
        border-radius: 9px;
        display: flex;
        align-items: center;
        gap: .6rem;
        transition: .15s;
    }

        .fb-drawer-link:hover {
            background: rgba(255,255,255,.12);
        }

    .fb-drawer-cta {
        background: #fff;
        color: var(--h);
        font-weight: 700;
        margin-top: .25rem;
        justify-content: center;
        box-shadow: 0 3px 12px rgba(0,0,0,.2);
    }

    /* ══════════════════════════════════════
           UNIFIED FOOTER
        ══════════════════════════════════════ */
    .fb-footer {
        background: #fff;
        border-top: 1px solid var(--border);
        padding: .75rem 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: .5rem;
        font-size: .72rem;
        color: var(--muted);
        font-family: var(--mono);
    }

    .fb-footer-left {
        display: flex;
        align-items: center;
        gap: .4rem;
    }

    .fb-footer-right {
        display: flex;
        align-items: center;
        gap: .5rem;
    }

    /* ── PAGE SHELL ── */
    .fp-page {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        background: #e8eef8;
        font-family: var(--font);
    }

    /* ── MAIN ── */
    .fp-main {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
    }

    .fp-container {
        display: flex;
        width: 100%;
        max-width: 860px;
        border-radius: var(--radius);
        overflow: hidden;
        box-shadow: 0 20px 60px rgba(37,99,235,.18), 0 4px 20px rgba(0,0,0,.10);
    }

    /* ── LEFT PANEL ── */
    .fp-left {
        flex: 1.1;
        background: linear-gradient(145deg, #1e4fd8 0%, #1a3fa8 40%, #0e2d82 100%);
        padding: 40px 36px;
        display: flex;
        flex-direction: column;
        gap: 28px;
        position: relative;
        overflow: hidden;
        color: #fff;
    }

        .fp-left::before {
            content: '';
            position: absolute;
            width: 280px;
            height: 280px;
            border-radius: 50%;
            background: rgba(255,255,255,.06);
            top: -80px;
            right: -80px;
        }

        .fp-left::after {
            content: '';
            position: absolute;
            width: 180px;
            height: 180px;
            border-radius: 50%;
            background: rgba(255,255,255,.05);
            bottom: 40px;
            left: -60px;
        }

    .fp-left-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(255,255,255,.12);
        border: 1px solid rgba(255,255,255,.2);
        border-radius: 20px;
        padding: 4px 12px;
        font-size: .7rem;
        font-weight: 600;
        letter-spacing: .07em;
        width: fit-content;
    }

    .fp-left-heading {
        font-size: 1.7rem;
        font-weight: 800;
        line-height: 1.25;
        letter-spacing: -.02em;
    }

        .fp-left-heading span {
            color: #93c5fd;
        }

    .fp-left-desc {
        font-size: .8rem;
        line-height: 1.65;
        color: rgba(255,255,255,.72);
        max-width: 270px;
    }

    .fp-stats {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
        margin-top: auto;
        position: relative;
        z-index: 1;
    }

    .fp-stat {
        background: rgba(255,255,255,.10);
        border: 1px solid rgba(255,255,255,.14);
        border-radius: var(--radius-sm);
        padding: 12px 14px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .fp-stat-icon {
        width: 34px;
        height: 34px;
        border-radius: 9px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .fp-stat-icon.blue {
            background: #2563eb;
        }

        .fp-stat-icon.green {
            background: #059669;
        }

        .fp-stat-icon.teal {
            background: #0284c7;
        }

        .fp-stat-icon.purple {
            background: #7c3aed;
        }

    .fp-stat-label {
        font-size: .62rem;
        font-weight: 600;
        letter-spacing: .06em;
        color: rgba(255,255,255,.55);
        text-transform: uppercase;
    }

    .fp-stat-value {
        font-size: .88rem;
        font-weight: 700;
        color: #fff;
    }

    /* ── RIGHT PANEL ── */
    .fp-right {
        flex: 1;
        background: var(--white);
        display: flex;
        flex-direction: column;
    }

    .fp-right-top {
        height: 4px;
        background: linear-gradient(90deg, var(--blue-mid) 0%, var(--teal) 100%);
    }

    .fp-right-inner {
        padding: 32px 36px;
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    .fp-right-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        margin-bottom: 28px;
    }

    .fp-right-header-text h2 {
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--ink);
        display: flex;
        align-items: center;
        gap: 8px;
        letter-spacing: -.01em;
    }

    .fp-right-header-text p {
        font-size: .75rem;
        color: var(--muted);
        margin-top: 3px;
    }

    .fp-secure-badge {
        display: flex;
        align-items: center;
        gap: 5px;
        background: var(--blue-pale);
        border: 1px solid #bfdbfe;
        color: var(--blue-mid);
        font-size: .68rem;
        font-weight: 700;
        letter-spacing: .05em;
        padding: 4px 10px;
        border-radius: 20px;
        flex-shrink: 0;
    }

    /* ── FORM FIELDS ── */
    .fp-field {
        display: flex;
        flex-direction: column;
        gap: 5px;
        margin-bottom: 16px;
    }

        .fp-field label {
            font-size: .68rem;
            font-weight: 700;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: .07em;
        }

    .fp-input-wrap {
        position: relative;
    }

    .fp-input-icon {
        position: absolute;
        left: 13px;
        top: 50%;
        transform: translateY(-50%);
        color: #94a3b8;
        pointer-events: none;
        display: flex;
    }

    .fp-input {
        width: 100%;
        height: 44px;
        padding: 0 14px 0 40px;
        border: 1.5px solid var(--border);
        border-radius: var(--radius-sm);
        background: #f8faff;
        font-family: var(--font);
        font-size: .85rem;
        color: var(--ink);
        outline: none;
        transition: border-color .15s, box-shadow .15s, background .15s;
    }

        .fp-input::placeholder {
            color: #b0bec5;
            font-size: .82rem;
        }

        .fp-input:focus {
            border-color: var(--blue-mid);
            background: #fff;
            box-shadow: 0 0 0 3px rgba(37,99,235,.10);
        }

    /* ── ALERT ── */
    .fp-alert {
        display: flex;
        align-items: flex-start;
        gap: 9px;
        padding: 10px 13px;
        border-radius: var(--radius-sm);
        font-size: .78rem;
        line-height: 1.5;
        border: 1px solid;
        margin-bottom: 16px;
    }

        .fp-alert.success {
            background: #f0fdf4;
            border-color: #bbf7d0;
            color: var(--success);
        }

        .fp-alert.danger {
            background: #fff5f5;
            border-color: #fca5a5;
            color: var(--danger);
        }

    /* ── SUBMIT BUTTON ── */
    .fp-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        width: 100%;
        height: 44px;
        background: linear-gradient(135deg, var(--blue-mid) 0%, var(--teal) 100%);
        color: #fff;
        border: none;
        border-radius: var(--radius-sm);
        font-family: var(--font);
        font-size: .88rem;
        font-weight: 700;
        cursor: pointer;
        transition: opacity .15s, transform .1s, box-shadow .15s;
        box-shadow: 0 4px 14px rgba(37,99,235,.35);
    }

        .fp-btn:hover {
            opacity: .92;
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(37,99,235,.4);
        }

        .fp-btn:active {
            transform: translateY(0);
        }

    .validation-message {
        font-size: .7rem;
        color: var(--danger);
        margin-top: 2px;
    }

    /* ── CARD FOOTER ── */
    .fp-right-footer {
        padding: 14px 36px 20px;
        text-align: center;
        border-top: 1px solid var(--border);
        background: #fafbff;
        font-size: .75rem;
        color: var(--muted);
    }

        .fp-right-footer a {
            color: var(--blue-mid);
            font-weight: 600;
            text-decoration: none;
        }

            .fp-right-footer a:hover {
                text-decoration: underline;
            }

    /* ── RESPONSIVE ── */
    @@media (max-width: 640px) {
        .fb-nav {
            padding: 0 .9rem;
            gap: .55rem;
        }

        .fb-nav-ticker {
            display: none;
        }

        .fb-nav-links {
            display: none;
        }

        .fb-nav-burger {
            display: flex;
        }

        .fp-left {
            display: none;
        }

        .fp-right-inner {
            padding: 24px 20px;
        }

        .fp-right-footer {
            padding: 12px 20px 16px;
        }

        .fb-footer {
            flex-direction: column;
            text-align: center;
            justify-content: center;
            padding: .75rem 1rem;
        }
    }
</style>

