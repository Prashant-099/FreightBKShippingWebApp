                                </span>
                                <input id="forgot-email" type="email" class="fp-input" placeholder="you@company.com" @bind="forgotPasswordModel.Email" />
                            </div>
                            <ValidationMessage For="@(() => forgotPasswordModel.Email)" />
                        </div>

                        @if (!string.IsNullOrEmpty(message))
                        {
                            <div class="fp-alert @alertType">
                                @if (alertType == "success")
                                {
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;margin-top:1px"><polyline points="20 6 9 17 4 12" /></svg>
                                }
                                else
                                {
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;margin-top:1px"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>
                                }
                                <span>@message</span>
                            </div>
                        }

                        <button type="submit" class="fp-btn">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13" /><polygon points="22 2 15 22 11 13 2 9 22 2" /></svg>
                            Send Reset Link
                        </button>
                    </EditForm>
                </div>

                <div class="fp-right-footer">
                    Remember your password? <a href="/login">Back to Login</a>
                    &nbsp;&nbsp;·&nbsp;&nbsp; FreightBook © 2026
                </div>
            </div>

        </div>
    </div>

    <!-- ── UNIFIED FOOTER ── -->
    <footer class="fb-footer">
        <div class="fb-footer-left">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" /></svg>
            Support: 9409309616
        </div>
        <div class="fb-footer-right">
            FreightBook &copy; @DateTime.Now.Year &nbsp;·&nbsp; Shipping Management
        </div>
    </footer>

</div>

@code {
    private EmailOnlyDto forgotPasswordModel = new();
    private string? message;
    private string alertType = "info";

    private async Task OnSubmitForgotPassword()
    {
        try
        {
            var response = await AuthService.ForgotPasswordAsync(forgotPasswordModel.Email);
            if (response.IsSuccess)
            {
                message = "If this email is registered, a reset link has been sent.";
                alertType = "success";
                ToastService.Success(message);
            }
            else
            {
                message = response.ErrorMessage ?? "Failed to send reset link.";
                alertType = "danger";
                ToastService.Error(message);
            }
        }
        catch (Exception ex)
        {
            message = $"Something went wrong: {ex.Message}";
            alertType = "danger";
        }
    }
}
