@page "/cargo"
  
@using FreightBKShippingWebApp.Model
@using FreightBKShippingWebApp.Services
@using FreightBKShippingWebApp.Components.Pages
@inject CargoService CargoService
@inject ToasteService ToastService
@inject LoadingService LoadingService
@inject ConfirmationDialogService ConfirmDialogService
@inject GridLayoutService GridLayoutService
<style>
    .grid-size {
        max-height: 600px;
    }


    /* ComboBox Styling */
    .layout-combobox {
        border-radius: 6px;
        width: 185px;
    }
</style>
<DxGrid TItem="Cargo"
        Data="@cargoList"
        @ref="MyGrid"
        KeyFieldName="CargoId"
        ShowSearchBox="true"
        PageSize="10"
        PageSizeSelectorVisible="true"
        ShowGroupPanel="true"
        FilterMenuButtonDisplayMode="GridFilterMenuButtonDisplayMode.Always"
        FocusedRowEnabled="true"
        SelectionMode="GridSelectionMode.Multiple"
        SelectedDataItems="@SelectedCargos"
        SelectedDataItemsChanged="OnSelectedCargosChanged"
        ColumnResizeMode="GridColumnResizeMode.NextColumn"
        CssClass="grid-size"
        AllowSelectRowByClick="true">

    <ToolbarTemplate Context="toolbarContext">
        <DxToolbar>
            <TitleTemplate Context="tl">
                <div class="d-flex align-items-center">
                    <i class="bi bi-box-seam me-2"></i>
                    <span class="fs-5">Cargo List</span>
                </div>
            </TitleTemplate>
            <Items>
                <DxToolbarItem Text="Add" IconCssClass="bi bi-plus-circle" Click="OnCreateNew" />
                <DxToolbarItem Text="Edit" IconCssClass="bi bi-pencil-square" Click="OnEdit" />
                <DxToolbarItem Text="Delete" IconCssClass="bi bi-trash" Click="OnDelete" />
                <DxToolbarItem Text="Refresh" IconCssClass="bi bi-arrow-clockwise" Click="@(async (_) => await LoadCargosAsync())" />

                <DxToolbarItem Alignment="ToolbarItemAlignment.Right"
                               RenderStyle="ButtonRenderStyle.Secondary"
                               IconCssClass="bi bi-gear-wide-connected"
                               Click="ShowLayoutPopup" />

            </Items>
        </DxToolbar>
    </ToolbarTemplate>

    <Columns>
        <DxGridSelectionColumn Width="30" FixedPosition="GridColumnFixedPosition.Left" />

        <DxGridDataColumn FieldName="CargoId" Caption="ID"
                          Width="@(layoutManager?.GetColumnWidth("CargoId") ?? "80px")"
                          Visible="@(layoutManager?.GetColumnVisibility("CargoId") ?? false)" />

        <DxGridDataColumn FieldName="CargoName" Caption="Cargo Name"
                          Width="@(layoutManager?.GetColumnWidth("CargoName") ?? "370px")"
                          Visible="@(layoutManager?.GetColumnVisibility("CargoName") ?? true)" />

        <DxGridDataColumn FieldName="CargoType" Caption="Type"
                          Width="@(layoutManager?.GetColumnWidth("CargoType") ?? "110px")"
                          Visible="@(layoutManager?.GetColumnVisibility("CargoType") ?? true)" />

        <DxGridDataColumn FieldName="cargohsnname" Caption="HSN Code"
                          Width="@(layoutManager?.GetColumnWidth("cargohsnname") ?? "150px")"
                          Visible="@(layoutManager?.GetColumnVisibility("cargohsnname") ?? true)" />

        <DxGridDataColumn FieldName="CargoGstPer" Caption="GST (%)"
                          DisplayFormat="N2"
                          Width="@(layoutManager?.GetColumnWidth("CargoGstPer") ?? "100px")"
                          Visible="@(layoutManager?.GetColumnVisibility("CargoGstPer") ?? true)" />

        <DxGridDataColumn FieldName="CargoCess" Caption="Cess (%)"
                          DisplayFormat="N2"
                          Width="@(layoutManager?.GetColumnWidth("CargoCess") ?? "120px")"
                          Visible="@(layoutManager?.GetColumnVisibility("CargoCess") ?? true)" />

        <DxGridDataColumn FieldName="CargoRemarks" Caption="Remarks"
                          Width="@(layoutManager?.GetColumnWidth("CargoRemarks") ?? "350px")"
                          Visible="@(layoutManager?.GetColumnVisibility("CargoRemarks") ?? true)" />

        <DxGridDataColumn FieldName="CargoCreated" Caption="Created"
                          DisplayFormat="dd/MM/yyyy"
                          Width="@(layoutManager?.GetColumnWidth("CargoCreated") ?? "140px")"
                          Visible="@(layoutManager?.GetColumnVisibility("CargoCreated") ?? true)" />


        <DxGridDataColumn FieldName="CargoStatus" Caption="Active"
                          Width="@(layoutManager?.GetColumnWidth("CargoStatus") ?? "120px")"
                          Visible="@(layoutManager?.GetColumnVisibility("CargoStatus") ?? true)" />
    </Columns>

</DxGrid>

<CargoAddEditPage @ref="popup" OnSaved="LoadCargosAsync" />

<ConfirmationDialog />
<GridLayoutpPopup @ref="layoutManager"
                  VoucherType="Cargo"
                  Columns="@allColumns"
                  OnLayoutChanged="HandleLayoutChanged" />

@code {
    DxGrid MyGrid;
    private List<Cargo> cargoList = [];
    // private List<Cargo> SelectedCargos = new();
    private IReadOnlyList<object> SelectedCargos { get; set; } = new List<object>();
    private CargoAddEditPage popup;
 
    // All possible columns
    private GridLayoutpPopup? layoutManager;
    private List<GridColumnLayout> allColumns = [];
    private async void ShowLayoutPopup()
    {
        await InvokeAsync(() =>
        {
            layoutManager?.ShowPopup();
        });
    }
    private async Task HandleLayoutChanged(List<GridColumnLayout> updatedLayout)
    {
        allColumns = updatedLayout;
        // Force the grid to re-render with new layout
        await InvokeAsync(StateHasChanged);
    }
    protected override async Task OnInitializedAsync()
    {
        InitializeColumns();
        await LoadCargosAsync();
       
       
    }

    private void InitializeColumns()
    {
        allColumns = new List<GridColumnLayout>
        {
            new() { FieldName = "CargoId", Caption = "ID", Visible = false, Width = 80, DisplayIndex = 0 },
        new() { FieldName = "CargoName", Caption = "Cargo Name", Visible = true, Width = 370, DisplayIndex = 1 },
        new() { FieldName = "CargoType", Caption = "Type", Visible = true, Width = 110, DisplayIndex = 2 },
        new() { FieldName = "cargohsnname", Caption = "HSN Code", Visible = true, Width = 150, DisplayIndex = 3 },
        new() { FieldName = "CargoGstPer", Caption = "GST (%)", Visible = true, Width = 100, DisplayIndex = 4 },
        new() { FieldName = "CargoCess", Caption = "Cess (%)", Visible = true, Width = 120, DisplayIndex = 5 },
        new() { FieldName = "CargoRemarks", Caption = "Remarks", Visible = true, Width = 350, DisplayIndex = 6 },
        new() { FieldName = "CargoStatus", Caption = "Active", Visible = true, Width = 120, DisplayIndex = 7 },
        new() { FieldName = "CargoCreated", Caption = "Created", Visible = true, Width = 140, DisplayIndex = 8 }
      
    };
       
    }

    private async Task LoadCargosAsync()
    {
        LoadingService.Show();
        try
        {
            cargoList = await CargoService.GetAllAsync();
        }
        finally
        {
            LoadingService.Hide();
        }
    }

    private async Task OnSelectedCargosChanged(IReadOnlyList<object> cargos)
    {
        SelectedCargos = cargos ?? new List<object>();
        await InvokeAsync(StateHasChanged);
    }
    // ✅ FIXED: Reliable clear selection method
    private async Task ClearSelectionManual()
    {
        try
        {
            if (MyGrid != null)
            {
                MyGrid.ClearSelection(); // ✅ Synchronous method
            }
            SelectedCargos = new List<Cargo>();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Clear selection error: {ex.Message}");
        }
    }

    // ✅ FIXED: Auto-clear after operations
    private async Task ClearSelection()
    {
        await Task.Delay(100); // Small delay for UI update
        await ClearSelectionManual();
    }

    private void OnCreateNew(ToolbarItemClickEventArgs e)
    {
        popup.Show(new Cargo
        {
            CargoStatus = true,
            CargoGstPer = 0,
            CargoCess = 0,
            CargoCreated = DateTime.Now
        });
    }

    private async Task OnEdit(ToolbarItemClickEventArgs e)
    {
        var cargo = MyGrid.GetFocusedDataItem() as Cargo;
        if (cargo != null)
            popup.Show(cargo);
        else
            ToastService.Warning("Please select a cargo to edit.");
        await ClearSelection();
    }

    private async Task OnDelete(ToolbarItemClickEventArgs e)
    {
        if (SelectedCargos == null || SelectedCargos.Count == 0)
        {
            ToastService.Warning("Please select at least one cargo to delete.");
            return;
        }
        var selectedList = SelectedCargos.Cast<Cargo>().ToList();

        var confirm = await ConfirmDialogService.ShowAsync(
            $"Are you sure you want to delete {SelectedCargos.Count} selected cargo item(s)?");

        if (!confirm)
        {
            await ClearSelection(); // ✅ Clear on cancel
            return;
        }
        try
        {
            LoadingService.Show("Deleting...");
            int successCount = 0, failCount = 0;
            List<string> errorMessages = new();
        foreach (var cargo in selectedList)
        {
            var result = await CargoService.DeleteAsync(cargo.CargoId);

            if (result.Success)
                successCount++;
            else
                failCount++;
                errorMessages.Add(result.Error);
        }

        if (successCount > 0)
            ToastService.Success($"{successCount} Cargo(s) Deleted Successfully.");

         if (failCount > 0)
                ToastService.Error($"{failCount} Cargo(s) failed.\nDetails: {string.Join("\n", errorMessages.Distinct())}");

        await LoadCargosAsync();
        }
        finally
        {
            LoadingService.Hide();
            await ClearSelection(); // ✅ Clear after delete (success or fail)
        }
    }
}
