@page "/country"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using FreightBKShippingWebApp.Model
@using FreightBKShippingWebApp.Services
@using FreightBKShippingWebApp.Components.Pages
@inject CountryService CountryService
@inject ToasteService ToastService
@inject LoadingService LoadingService
@inject ConfirmationDialogService ConfirmDialogService
@inject GridLayoutService GridLayoutService
@inject AuditLogService AuditLogService
<style>
    .grid-size {
        max-height: 600px;
    }


    /* ComboBox Styling */
    .layout-combobox {
        border-radius: 6px;
        width: 185px;
    }
</style>
<DxGrid TItem="Country"
        Data="@countryList"
        @ref="MyGrid"
        KeyFieldName="CountryId"
        ShowSearchBox="true"
        PageSize="10"
        PageSizeSelectorVisible="true"
        ShowGroupPanel="true"
        FilterMenuButtonDisplayMode="GridFilterMenuButtonDisplayMode.Always"
        FocusedRowEnabled="true"
        SelectionMode="GridSelectionMode.Multiple"
        SelectedDataItems="@SelectedCountries"
        SelectedDataItemsChanged="OnSelectedCountriesChanged"
        ColumnResizeMode="GridColumnResizeMode.NextColumn"
        CssClass="grid-size"
        AllowSelectRowByClick="true">

    <ToolbarTemplate Context="toolbarContext">
        <DxToolbar>
            <TitleTemplate Context="tl">
                <div class="d-flex align-items-center">
                    <i class="bi bi-globe me-2"></i>
                    <span class="fs-5">Country</span>
                </div>
            </TitleTemplate>
            <Items>
                <DxToolbarItem Text="Add" IconCssClass="bi bi-plus-circle" Click="OnCreateNew" />
                <DxToolbarItem Text="Edit" IconCssClass="bi bi-pencil-square" Click="OnEdit" />
                <DxToolbarItem Text="Delete" IconCssClass="bi bi-trash" Click="OnDelete" />
                <DxToolbarItem Text="Refresh" IconCssClass="bi bi-arrow-clockwise" Click="@(async (_) => await LoadCountriesAsync())" />


                <DxToolbarItem Alignment="ToolbarItemAlignment.Right"
                               RenderStyle="ButtonRenderStyle.Secondary"
                               IconCssClass="bi bi-gear-wide-connected"
                               Click="ShowLayoutPopup" />

            </Items>
        </DxToolbar>
    </ToolbarTemplate>

    <Columns>

        <DxGridSelectionColumn Width="30" />

        <DxGridDataColumn FieldName="CountryId" Caption="ID"
                          Width="@(layoutManager?.GetColumnWidth("CountryId") ?? "80px")"
                          Visible="@(layoutManager?.GetColumnVisibility("CountryId") ?? false)" />

        <DxGridDataColumn FieldName="CountryName" Caption="Name"
                          Width="@(layoutManager?.GetColumnWidth("CountryName") ?? "500px")"
                          Visible="@(layoutManager?.GetColumnVisibility("CountryName") ?? true)" />

        <DxGridDataColumn FieldName="CountryCode" Caption="Code"
                          Width="@(layoutManager?.GetColumnWidth("CountryCode") ?? "120px")"
                          Visible="@(layoutManager?.GetColumnVisibility("CountryCode") ?? true)" />

        <DxGridDataColumn FieldName="CountryCurrency" Caption="Currency"
                          Width="@(layoutManager?.GetColumnWidth("CountryCurrency") ?? "150px")"
                          Visible="@(layoutManager?.GetColumnVisibility("CountryCurrency") ?? true)" />

        <DxGridDataColumn FieldName="CountryRemarks" Caption="Remarks"
                          Width="@(layoutManager?.GetColumnWidth("CountryRemarks") ?? "370px")"
                          Visible="@(layoutManager?.GetColumnVisibility("CountryRemarks") ?? true)" />

        <DxGridDataColumn FieldName="CountryCreated" Caption="Created At"
                          DisplayFormat="dd/MM/yyyy"
                          Width="@(layoutManager?.GetColumnWidth("CountryCreated") ?? "160px")"
                          Visible="@(layoutManager?.GetColumnVisibility("CountryCreated") ?? true)" />

        <DxGridDataColumn FieldName="CountryUpdated" Caption="Update At"
                          DisplayFormat="dd/MM/yyyy"
                          Width="@(layoutManager?.GetColumnWidth("CountryUpdated") ?? "160px")"
                          Visible="@(layoutManager?.GetColumnVisibility("CountryUpdated") ?? true)" />

        <DxGridDataColumn FieldName="CountryStatus" Caption="Active"
                          Width="@(layoutManager?.GetColumnWidth("CountryStatus") ?? "120px")"
                          Visible="@(layoutManager?.GetColumnVisibility("CountryStatus") ?? true)" />

    </Columns>
</DxGrid>

<CountryAddEditPage @ref="popup" OnSaved="LoadCountriesAsync" />

<ConfirmationDialog />
<GridLayoutpPopup @ref="layoutManager"
                  VoucherType="Country"
                  Columns="@allColumns"
                  OnLayoutChanged="HandleLayoutChanged" />

@code {
    DxGrid MyGrid;
    private List<Country> countryList = [];
    // private List<Country> SelectedCountries = new();
    private IReadOnlyList<object> SelectedCountries { get; set; } = new List<object>();

    private CountryAddEditPage popup;

    // All possible columns
    private GridLayoutpPopup? layoutManager;
    private List<GridColumnLayout> allColumns = [];
    private async void ShowLayoutPopup()
    {
        await InvokeAsync(() =>
        {
            layoutManager?.ShowPopup();
        });
    }
    private async Task HandleLayoutChanged(List<GridColumnLayout> updatedLayout)
    {
        allColumns = updatedLayout;
        // Force the grid to re-render with new layout
        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnInitializedAsync()
    {
        InitializeColumns();
        await LoadCountriesAsync();

    }
    private void InitializeColumns()
    {
        allColumns = new List<GridColumnLayout>
        {
          new() { FieldName = "CountryId", Caption = "ID", Visible = false, Width = 80, DisplayIndex = 0 },
        new() { FieldName = "CountryName", Caption = "Name", Visible = true, Width = 500, DisplayIndex = 1 },
        new() { FieldName = "CountryCode", Caption = "Code", Visible = false, Width = 120, DisplayIndex = 2 },
        new() { FieldName = "CountryCurrency", Caption = "Currency", Visible = true, Width = 150, DisplayIndex = 3 },
        new() { FieldName = "CountryRemarks", Caption = "Remarks", Visible = true, Width = 370, DisplayIndex = 4 },
        new() { FieldName = "CountryStatus", Caption = "Active", Visible = true, Width = 120, DisplayIndex = 5 },
        new() { FieldName = "CountryCreated", Caption = "Created At", Visible = true, Width = 160, DisplayIndex = 6 },
        new() { FieldName = "CountryUpdated", Caption = "Updated At", Visible = true, Width = 160, DisplayIndex = 7}
   };

    }

    private async Task LoadCountriesAsync()
    {
        LoadingService.Show();
        try
        {
            countryList = await CountryService.GetAllAsync();
        }
        finally
        {
            LoadingService.Hide();
        }
    }
    private async Task OnSelectedCountriesChanged(IReadOnlyList<object> countries)
    {
        SelectedCountries = countries ?? new List<object>();
        await InvokeAsync(StateHasChanged);
    }
    // ✅ FIXED: Reliable clear selection method
    private async Task ClearSelectionManual()
    {
        try
        {
            if (MyGrid != null)
            {
                MyGrid.ClearSelection(); // ✅ Synchronous method
            }
            SelectedCountries = new List<Country>();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Clear selection error: {ex.Message}");
        }
    }

    // ✅ FIXED: Auto-clear after operations
    private async Task ClearSelection()
    {
        await Task.Delay(100); // Small delay for UI update
        await ClearSelectionManual();
    }

    private void OnCreateNew(ToolbarItemClickEventArgs e)
    {
        popup.Show(new Country());
    }

    private async Task OnEdit(ToolbarItemClickEventArgs e)
    {
        var country = MyGrid.GetFocusedDataItem() as Country;
        if (country != null)
        {
            var freshData = countryList
             .FirstOrDefault(x => x.CountryId == country.CountryId);

            if (freshData != null)
                popup.Show(freshData);
        }
        else
            ToastService.Warning("Please select a country to edit.");
        await ClearSelection();
    }

    private async Task OnDelete(ToolbarItemClickEventArgs e)
    {
        if (SelectedCountries == null || SelectedCountries.Count == 0)
        {
            ToastService.Warning("Please select at least one country to delete.");
            return;
        }
        var selectedList = SelectedCountries.Cast<Country>().ToList();

        var confirm = await ConfirmDialogService.ShowAsync(
            $"Are you sure you want to delete {SelectedCountries.Count} selected country(ies)?");

        if (!confirm)
        {
            await ClearSelection(); // ✅ Clear on cancel
            return;
        }
        try
        {
            LoadingService.Show("Deleting...");
            int successCount = 0, failCount = 0;
            List<string> errorMessages = new();
            foreach (var country in selectedList)
            {
                var result = await CountryService.DeleteAsync(country.CountryId);
                if (result.Success)
                {
                    successCount++;
                    AuditLogService.NotifyAuditChanged();

                }

                else {
                    failCount++; 
                    errorMessages.Add(result.Error);
                }

            }
            if (successCount > 0) ToastService.Success($"{successCount} country(ies) Deleted Successfully.");
            if (failCount > 0)
            ToastService.Error($"{failCount} country(ies) Failed To Delete.\nDetails: {string.Join("\n", errorMessages.Distinct())}");
            await LoadCountriesAsync();
        }
        finally
        {
            LoadingService.Hide();
            await ClearSelection(); // ✅ Clear after delete (success or fail)
        }
    }
}
