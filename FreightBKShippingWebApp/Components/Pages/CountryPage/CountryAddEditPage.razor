@using FreightBKShippingWebApp.Model
@using FreightBKShippingWebApp.Services
@using System.Text.Json
@inject CountryService CountryService
@inject ToasteService ToastService
@inject LoadingService LoadingService
@inject CurrencyService CurrencyService
<DxPopup @bind-Visible="Visible" ShowCloseButton="true" HeaderText="@Title" MaxWidth="450" CloseOnOutsideClick="false" horizontalAlignment="HorizontalAlignment.Center"
         verticalAlignment="VerticalAlignment.Center" BodyCssClass="my-popup-body" ShowFooter="true" scrollable="true">
            <BodyContentTemplate Context="bdy">
    <EditForm EditContext="@editContext" OnValidSubmit="HandleValidSubmit" id="countryForm">
        <DataAnnotationsValidator />
        @* <ValidationSummary /> *@
        <DxFormLayout>
            <DxFormLayoutItem Caption="Name" ColSpanMd="12">
                <ChildContent Context="itemContext">
                    <DxTextBox @bind-Text="EditModel.CountryName" ShowValidationIcon="true" ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                </ChildContent>
            </DxFormLayoutItem>
           @*  <DxFormLayoutItem Caption="Code">
                <ChildContent Context="itemContext">
                    <DxTextBox @bind-Text="EditModel.CountryCode" />
                </ChildContent>
            </DxFormLayoutItem> *@
            <DxFormLayoutItem Caption="Currency" ColSpanMd="12">
                <ChildContent Context="itemContext">
                    <DxComboBox TData="Currency" TValue="String"
                                Data="@CurrencyList"
                                TextFieldName="CurrencyName"
                                ValueFieldName="CurrencyName"
                                ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto"
                                AllowUserInput="false"
                                NullText="-- Select Currency --"
                                @bind-Value="EditModel.CountryCurrency"
                                SearchMode="ListSearchMode.AutoSearch"
                                SearchFilterCondition="ListSearchFilterCondition.Contains" />
                </ChildContent>
            </DxFormLayoutItem>
        </DxFormLayout>
    </EditForm>
    </BodyContentTemplate>
    <FooterContentTemplate Context="ft">
        <div class="mt-3 text-end">
            <DxButton Text="Save" RenderStyle="ButtonRenderStyle.Primary" SubmitFormOnClick="true" Form="countryForm" />
            <DxButton Text="Cancel" RenderStyle="ButtonRenderStyle.Secondary" Click="Hide" />
        </div>
    </FooterContentTemplate>
</DxPopup>

@code {
    [Parameter] public EventCallback OnSaved { get; set; }
    private EditContext? editContext;
    private bool Visible { get; set; }
    private string Title { get; set; } = "Add/Edit Country";
    private Country EditModel { get; set; } = new();
    private List<Currency> CurrencyList = new();
    public void Show(Country country)
    {
       
        if (country.CountryId > 0)
        {
            // Edit mode – bind directly to the selected object
            EditModel = country;
            var json = JsonSerializer.Serialize(country);
            EditModel = JsonSerializer.Deserialize<Country>(json) ?? new Country();
            Title = "Edit Country";
        }
        else
        {
            // Add mode – create new object
            EditModel = new Country { CountryStatus = true };
            Title = "Add Country";
        }
        // Create EditContext when showing the form
        editContext = new EditContext(EditModel);
        Visible = true;
    }

    private void Hide()
    {
        Visible = false;
    }
    protected override async Task OnInitializedAsync()
    {
        CurrencyList = await CurrencyService.GetAllAsync();
    }
    private async Task HandleValidSubmit()
    {
        LoadingService.Show();
        try
        {
            if (EditModel.CountryId == 0)
            {
                await CountryService.CreateAsync(EditModel);
                ToastService.Success("Country created successfully!");
            }
            else
            {
                await CountryService.UpdateAsync(EditModel);
                ToastService.Success("Country updated successfully!");
            }

            Visible = false;
            await OnSaved.InvokeAsync();
        }
        catch (Exception ex)
        {
            ToastService.Error($"Error saving country: {ex.Message}");
        }
       finally
        {
            LoadingService.Hide();
        }
    }
}
